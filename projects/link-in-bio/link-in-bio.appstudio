{
  "schema": "app-studio/canvas@1",
  "id": "example-link-in-bio",
  "name": "link-in-bio.html",
  "code": "<!DOCTYPE html>\n<!--\n  Link in Bio — Halison App Studio example\n\n  Build a Linktree-style bio page: profile, accent theme, and reorderable link\n  buttons, with an edit/preview toggle. Saves to your browser.\n\n  From the Halison App Studio public library:\n  https://github.com/halisonworks/public-app-studio\n\n  Permitted use: personal, educational, and other non-commercial use. You may\n  modify it, but keep this header and the source link intact, and do not sell,\n  commercialize, or republish it. Released under the Halison App Studio Examples\n  License — see the LICENSE file in the repository above.\n-->\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Link in Bio Builder</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    /* Custom scrollbar for link list */\n    .link-list::-webkit-scrollbar { width: 6px; }\n    .link-list::-webkit-scrollbar-track { background: transparent; }\n    .link-list::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 9999px; }\n\n    /* Smooth transition for preview page */\n    #preview-page { transition: background 0.4s ease; }\n\n    /* Emoji picker grid */\n    .emoji-grid { display: grid; grid-template-columns: repeat(8, 1fr); gap: 4px; }\n    .emoji-btn { font-size: 1.25rem; cursor: pointer; padding: 4px; border-radius: 4px; text-align: center; }\n    .emoji-btn:hover { background: #f1f5f9; }\n\n    /* Drag handle cursor */\n    .drag-handle { cursor: grab; }\n    .drag-handle:active { cursor: grabbing; }\n\n    /* Link button hover effect in preview */\n    .preview-link-btn { transition: transform 0.15s ease, box-shadow 0.15s ease; }\n    .preview-link-btn:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0,0,0,0.15); }\n\n    /* Avatar shimmer for initials */\n    .avatar-initials { user-select: none; }\n  </style>\n</head>\n<body class=\"bg-slate-100 min-h-screen font-sans\">\n\n<!-- ========== TOP NAV ========== -->\n<nav class=\"bg-white border-b border-slate-200 sticky top-0 z-50 shadow-sm\">\n  <div class=\"max-w-5xl mx-auto px-4 h-14 flex items-center justify-between\">\n    <div class=\"flex items-center gap-2\">\n      <span class=\"text-xl\">🔗</span>\n      <span class=\"font-bold text-slate-800 text-sm tracking-wide\">Link in Bio Builder</span>\n    </div>\n    <div class=\"flex items-center gap-1 bg-slate-100 p-1 rounded-xl\">\n      <button id=\"btn-edit-mode\"\n        class=\"px-4 py-1.5 rounded-lg text-sm font-medium transition-all\"\n        onclick=\"setMode('edit')\">\n        ✏️ Edit\n      </button>\n      <button id=\"btn-preview-mode\"\n        class=\"px-4 py-1.5 rounded-lg text-sm font-medium transition-all\"\n        onclick=\"setMode('preview')\">\n        👁 Preview\n      </button>\n    </div>\n  </div>\n</nav>\n\n<!-- ========== EDIT MODE ========== -->\n<div id=\"edit-page\" class=\"max-w-5xl mx-auto px-4 py-8 hidden\">\n  <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-6\">\n\n    <!-- LEFT: Profile editor -->\n    <div class=\"bg-white rounded-2xl shadow-sm border border-slate-200 p-6 space-y-5\">\n      <h2 class=\"font-bold text-slate-700 text-base uppercase tracking-widest text-xs\">Profile</h2>\n\n      <!-- Avatar section -->\n      <div class=\"flex items-center gap-4\">\n        <div id=\"edit-avatar-display\"\n          class=\"w-20 h-20 rounded-full flex items-center justify-center text-3xl font-bold avatar-initials select-none cursor-pointer border-4 border-white shadow-md\"\n          title=\"Click to change avatar\"\n          onclick=\"openAvatarPicker()\">\n        </div>\n        <div class=\"flex-1\">\n          <p class=\"text-xs text-slate-500 mb-1\">Avatar (initials or emoji)</p>\n          <button onclick=\"openAvatarPicker()\"\n            class=\"text-sm px-3 py-1.5 rounded-lg border border-slate-300 hover:bg-slate-50 text-slate-600 transition-colors\">\n            Change Avatar\n          </button>\n        </div>\n      </div>\n\n      <!-- Display name -->\n      <div>\n        <label class=\"block text-xs font-medium text-slate-500 mb-1\">Display Name</label>\n        <input id=\"field-name\" type=\"text\" maxlength=\"50\"\n          class=\"w-full border border-slate-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-300 transition\"\n          oninput=\"onProfileChange()\" />\n      </div>\n\n      <!-- Handle -->\n      <div>\n        <label class=\"block text-xs font-medium text-slate-500 mb-1\">Handle / Username</label>\n        <div class=\"flex items-center border border-slate-200 rounded-xl overflow-hidden focus-within:ring-2 focus-within:ring-indigo-300 transition\">\n          <span class=\"px-3 text-slate-400 text-sm bg-slate-50 self-stretch flex items-center border-r border-slate-200\">@</span>\n          <input id=\"field-handle\" type=\"text\" maxlength=\"40\"\n            class=\"flex-1 px-3 py-2 text-sm focus:outline-none bg-white\"\n            oninput=\"onProfileChange()\" />\n        </div>\n      </div>\n\n      <!-- Bio -->\n      <div>\n        <label class=\"block text-xs font-medium text-slate-500 mb-1\">Short Bio</label>\n        <textarea id=\"field-bio\" rows=\"3\" maxlength=\"160\"\n          class=\"w-full border border-slate-200 rounded-xl px-3 py-2 text-sm resize-none focus:outline-none focus:ring-2 focus:ring-indigo-300 transition\"\n          oninput=\"onProfileChange()\"></textarea>\n        <p class=\"text-xs text-slate-400 text-right mt-0.5\"><span id=\"bio-char-count\">0</span>/160</p>\n      </div>\n\n      <!-- Accent color -->\n      <div>\n        <label class=\"block text-xs font-medium text-slate-500 mb-2\">Accent Color</label>\n        <div class=\"flex flex-wrap gap-2\" id=\"color-swatches\"></div>\n      </div>\n\n      <!-- Background theme -->\n      <div>\n        <label class=\"block text-xs font-medium text-slate-500 mb-2\">Background Theme</label>\n        <div class=\"flex flex-wrap gap-2\" id=\"bg-swatches\"></div>\n      </div>\n    </div>\n\n    <!-- RIGHT: Links editor -->\n    <div class=\"bg-white rounded-2xl shadow-sm border border-slate-200 p-6 flex flex-col gap-4\">\n      <div class=\"flex items-center justify-between\">\n        <h2 class=\"font-bold text-slate-700 text-base uppercase tracking-widest text-xs\">Links</h2>\n        <button onclick=\"addLink()\"\n          class=\"flex items-center gap-1.5 text-sm px-3 py-1.5 rounded-lg bg-indigo-600 text-white hover:bg-indigo-700 transition-colors font-medium shadow-sm\">\n          <span class=\"text-base leading-none\">+</span> Add Link\n        </button>\n      </div>\n\n      <div id=\"link-list\" class=\"space-y-3 overflow-y-auto link-list max-h-[520px] pr-1\">\n        <!-- Links rendered here -->\n      </div>\n\n      <p id=\"no-links-msg\" class=\"text-center text-slate-400 text-sm py-6 hidden\">No links yet. Add one above!</p>\n    </div>\n  </div>\n</div>\n\n<!-- ========== PREVIEW MODE ========== -->\n<div id=\"preview-page\" class=\"min-h-screen hidden\">\n  <div class=\"max-w-sm mx-auto px-4 py-12 flex flex-col items-center gap-5\">\n    <!-- Avatar -->\n    <div id=\"preview-avatar\"\n      class=\"w-24 h-24 rounded-full flex items-center justify-center text-4xl font-bold avatar-initials border-4 border-white shadow-lg\">\n    </div>\n\n    <!-- Name + handle + bio -->\n    <div class=\"text-center\">\n      <h1 id=\"preview-name\" class=\"text-2xl font-bold text-white drop-shadow\"></h1>\n      <p id=\"preview-handle\" class=\"text-sm font-medium opacity-80 text-white mt-0.5\"></p>\n      <p id=\"preview-bio\" class=\"text-sm text-white opacity-90 mt-2 leading-relaxed max-w-xs\"></p>\n    </div>\n\n    <!-- Links -->\n    <div id=\"preview-links\" class=\"w-full space-y-3 mt-2\"></div>\n  </div>\n</div>\n\n<!-- ========== AVATAR PICKER MODAL ========== -->\n<div id=\"avatar-modal\" class=\"fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 hidden\" onclick=\"closeAvatarModal(event)\">\n  <div class=\"bg-white rounded-2xl shadow-2xl w-full max-w-sm p-5\" onclick=\"event.stopPropagation()\">\n    <div class=\"flex items-center justify-between mb-4\">\n      <h3 class=\"font-bold text-slate-700\">Choose Avatar</h3>\n      <button onclick=\"closeAvatarModal()\" class=\"text-slate-400 hover:text-slate-600 text-xl leading-none\">&times;</button>\n    </div>\n\n    <!-- Initials option -->\n    <div class=\"mb-4\">\n      <label class=\"block text-xs font-medium text-slate-500 mb-1\">Use initials (auto-generated from name)</label>\n      <button onclick=\"selectInitialsAvatar()\"\n        id=\"btn-use-initials\"\n        class=\"w-full text-sm py-2 rounded-xl border border-slate-300 hover:bg-slate-50 text-slate-600 transition-colors\">\n        Use Initials\n      </button>\n    </div>\n\n    <div class=\"text-xs font-medium text-slate-500 mb-2\">Or pick an emoji</div>\n    <div class=\"emoji-grid mb-4 max-h-48 overflow-y-auto\">\n      <!-- Emoji buttons rendered by JS -->\n    </div>\n  </div>\n</div>\n\n<!-- ========== LINK EMOJI PICKER MODAL ========== -->\n<div id=\"link-emoji-modal\" class=\"fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4 hidden\" onclick=\"closeLinkEmojiModal(event)\">\n  <div class=\"bg-white rounded-2xl shadow-2xl w-full max-w-sm p-5\" onclick=\"event.stopPropagation()\">\n    <div class=\"flex items-center justify-between mb-4\">\n      <h3 class=\"font-bold text-slate-700\">Pick Link Icon</h3>\n      <button onclick=\"closeLinkEmojiModal()\" class=\"text-slate-400 hover:text-slate-600 text-xl leading-none\">&times;</button>\n    </div>\n    <div class=\"mb-3\">\n      <button id=\"btn-no-icon\" onclick=\"selectLinkEmoji(null)\"\n        class=\"text-sm px-3 py-1.5 rounded-lg border border-slate-300 hover:bg-slate-50 text-slate-500 transition-colors\">\n        No icon\n      </button>\n    </div>\n    <div class=\"emoji-grid max-h-56 overflow-y-auto\" id=\"link-emoji-grid\">\n      <!-- Rendered by JS -->\n    </div>\n  </div>\n</div>\n\n<script>\n// ============================================================\n// DATA & DEFAULTS\n// ============================================================\nconst STORAGE_KEY = 'lib_linkinbio_v1';\n\nconst ACCENT_COLORS = [\n  { name: 'Indigo',  value: '#6366f1', text: '#ffffff' },\n  { name: 'Violet',  value: '#8b5cf6', text: '#ffffff' },\n  { name: 'Rose',    value: '#f43f5e', text: '#ffffff' },\n  { name: 'Amber',   value: '#f59e0b', text: '#ffffff' },\n  { name: 'Emerald', value: '#10b981', text: '#ffffff' },\n  { name: 'Sky',     value: '#0ea5e9', text: '#ffffff' },\n  { name: 'Fuchsia', value: '#d946ef', text: '#ffffff' },\n  { name: 'Slate',   value: '#475569', text: '#ffffff' },\n];\n\nconst BG_THEMES = [\n  { name: 'Deep Violet', value: 'linear-gradient(135deg, #1e1b4b 0%, #4c1d95 100%)', preview: '#3b0764' },\n  { name: 'Sunset',      value: 'linear-gradient(135deg, #f97316 0%, #db2777 100%)', preview: '#be185d' },\n  { name: 'Ocean',       value: 'linear-gradient(135deg, #0369a1 0%, #0f766e 100%)', preview: '#065f46' },\n  { name: 'Midnight',    value: 'linear-gradient(135deg, #0f172a 0%, #1e293b 100%)', preview: '#0f172a' },\n  { name: 'Forest',      value: 'linear-gradient(135deg, #14532d 0%, #166534 100%)', preview: '#14532d' },\n  { name: 'Rose Gold',   value: 'linear-gradient(135deg, #9d174d 0%, #c2410c 100%)', preview: '#9d174d' },\n  { name: 'Sky Bright',  value: 'linear-gradient(135deg, #0284c7 0%, #7c3aed 100%)', preview: '#0284c7' },\n  { name: 'Charcoal',    value: 'linear-gradient(135deg, #374151 0%, #111827 100%)', preview: '#374151' },\n];\n\nconst AVATAR_EMOJIS = [\n  '😊','😎','🤩','🥳','🎨','🎤','📸','✍️','🎧','🎮','🌸','🌊',\n  '🦋','🦁','🐺','🦊','🐙','🌙','⭐','🔥','💎','👑','🎭','🎬',\n  '🌈','🍀','🌺','🧠','💻','📱','🎸','🎵','🎺','🥁','🎻','🪗',\n  '🏄','🧗','🤸','🏋️','⚽','🎾','🏆','🎯','🎲','🃏','🪄','✨',\n];\n\nconst LINK_EMOJIS = [\n  '🔗','🌐','📺','📸','🎵','🎥','📝','💼','🛒','📧','💬','📱',\n  '🎮','📚','🎨','✍️','🎤','🎧','🏠','📍','🌟','💡','🔔','📣',\n  '🎁','💰','🤝','📊','🗓️','🔖','🏷️','🪄','⚡','🔥','💎','👑',\n  '🌈','🍕','☕','🍷','🎂','🧁','🎯','🚀','✈️','🗺️','📷','🎬',\n];\n\nconst DEFAULT_DATA = {\n  name: 'Mia Hartwell',\n  handle: 'miahartwell',\n  bio: 'Lifestyle & travel creator ✈️ | Sharing my adventures, honest reviews, and daily vibes. DMs open for collabs!',\n  avatarType: 'emoji',\n  avatarEmoji: '🌸',\n  accentColor: ACCENT_COLORS[0].value,\n  accentText: ACCENT_COLORS[0].text,\n  bgTheme: BG_THEMES[0].value,\n  links: [\n    { id: 'l1', title: 'My YouTube Channel', url: 'https://youtube.com', emoji: '🎥' },\n    { id: 'l2', title: 'Instagram', url: 'https://instagram.com', emoji: '📸' },\n    { id: 'l3', title: 'Latest Blog Post: Tokyo on a Budget', url: 'https://example.com/blog', emoji: '✍️' },\n    { id: 'l4', title: 'Shop My Favourites', url: 'https://example.com/shop', emoji: '🛒' },\n    { id: 'l5', title: 'Newsletter — Weekly Wanderlust', url: 'https://example.com/newsletter', emoji: '📧' },\n    { id: 'l6', title: 'TikTok', url: 'https://tiktok.com', emoji: '🎵' },\n  ]\n};\n\n// ============================================================\n// STATE\n// ============================================================\nlet state = null;\nlet currentMode = 'edit';\nlet linkEmojiTargetId = null;\n\n// ============================================================\n// STORAGE\n// ============================================================\nfunction loadState() {\n  try {\n    const raw = localStorage.getItem(STORAGE_KEY);\n    if (raw) {\n      state = JSON.parse(raw);\n      // Ensure required fields exist (migration safety)\n      state.links = state.links || [];\n      state.accentColor = state.accentColor || ACCENT_COLORS[0].value;\n      state.accentText = state.accentText || ACCENT_COLORS[0].text;\n      state.bgTheme = state.bgTheme || BG_THEMES[0].value;\n    } else {\n      state = JSON.parse(JSON.stringify(DEFAULT_DATA));\n    }\n  } catch (e) {\n    state = JSON.parse(JSON.stringify(DEFAULT_DATA));\n  }\n}\n\nfunction saveState() {\n  try {\n    localStorage.setItem(STORAGE_KEY, JSON.stringify(state));\n  } catch (e) { /* storage full or private mode */ }\n}\n\n// ============================================================\n// UTILS\n// ============================================================\nfunction generateId() {\n  return 'l' + Math.random().toString(36).slice(2, 9);\n}\n\nfunction getInitials(name) {\n  if (!name || !name.trim()) return '?';\n  const parts = name.trim().split(/\\s+/);\n  if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();\n  return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();\n}\n\nfunction getAvatarContent() {\n  if (state.avatarType === 'emoji' && state.avatarEmoji) return state.avatarEmoji;\n  return getInitials(state.name);\n}\n\nfunction lightenHex(hex, amount) {\n  // Simple lightening for avatar bg when using initials\n  const num = parseInt(hex.replace('#', ''), 16);\n  const r = Math.min(255, (num >> 16) + amount);\n  const g = Math.min(255, ((num >> 8) & 0xff) + amount);\n  const b = Math.min(255, (num & 0xff) + amount);\n  return '#' + [r, g, b].map(v => v.toString(16).padStart(2, '0')).join('');\n}\n\nfunction sanitizeUrl(url) {\n  if (!url) return '#';\n  const trimmed = url.trim();\n  if (trimmed.startsWith('http://') || trimmed.startsWith('https://')) return trimmed;\n  return 'https://' + trimmed;\n}\n\n// ============================================================\n// RENDER: COLOR / THEME SWATCHES\n// ============================================================\nfunction renderSwatches() {\n  const container = document.getElementById('color-swatches');\n  container.innerHTML = '';\n  ACCENT_COLORS.forEach(c => {\n    const btn = document.createElement('button');\n    btn.title = c.name;\n    btn.className = 'w-8 h-8 rounded-full border-2 transition-all hover:scale-110 focus:outline-none';\n    btn.style.backgroundColor = c.value;\n    btn.style.borderColor = state.accentColor === c.value ? '#1e293b' : 'transparent';\n    if (state.accentColor === c.value) btn.classList.add('ring-2', 'ring-offset-1', 'ring-slate-700');\n    btn.onclick = () => {\n      state.accentColor = c.value;\n      state.accentText = c.text;\n      saveState();\n      renderSwatches();\n      renderPreviewLinks();\n      updateEditAvatar();\n    };\n    container.appendChild(btn);\n  });\n\n  const bgContainer = document.getElementById('bg-swatches');\n  bgContainer.innerHTML = '';\n  BG_THEMES.forEach(t => {\n    const btn = document.createElement('button');\n    btn.title = t.name;\n    btn.className = 'w-8 h-8 rounded-full border-2 transition-all hover:scale-110 focus:outline-none';\n    btn.style.backgroundColor = t.preview;\n    btn.style.borderColor = state.bgTheme === t.value ? '#1e293b' : 'transparent';\n    if (state.bgTheme === t.value) btn.classList.add('ring-2', 'ring-offset-1', 'ring-slate-700');\n    btn.onclick = () => {\n      state.bgTheme = t.value;\n      saveState();\n      renderSwatches();\n      renderPreviewPage();\n    };\n    bgContainer.appendChild(btn);\n  });\n}\n\n// ============================================================\n// RENDER: EDIT AVATAR\n// ============================================================\nfunction updateEditAvatar() {\n  const el = document.getElementById('edit-avatar-display');\n  el.textContent = getAvatarContent();\n  el.style.backgroundColor = lightenHex(state.accentColor, 120);\n  el.style.color = state.accentColor;\n}\n\n// ============================================================\n// RENDER: LINKS LIST (EDIT)\n// ============================================================\nfunction renderLinkList() {\n  const container = document.getElementById('link-list');\n  const noMsg = document.getElementById('no-links-msg');\n  container.innerHTML = '';\n\n  if (state.links.length === 0) {\n    noMsg.classList.remove('hidden');\n    return;\n  }\n  noMsg.classList.add('hidden');\n\n  state.links.forEach((link, idx) => {\n    const div = document.createElement('div');\n    div.className = 'flex items-center gap-2 bg-slate-50 border border-slate-200 rounded-xl p-3';\n    div.dataset.id = link.id;\n\n    // Up/down buttons\n    const moveDiv = document.createElement('div');\n    moveDiv.className = 'flex flex-col gap-0.5';\n    const upBtn = document.createElement('button');\n    upBtn.textContent = '▲';\n    upBtn.className = 'text-slate-400 hover:text-slate-700 text-xs w-5 h-5 flex items-center justify-center rounded transition-colors disabled:opacity-20';\n    upBtn.disabled = idx === 0;\n    upBtn.title = 'Move up';\n    upBtn.onclick = () => moveLink(link.id, -1);\n    const downBtn = document.createElement('button');\n    downBtn.textContent = '▼';\n    downBtn.className = 'text-slate-400 hover:text-slate-700 text-xs w-5 h-5 flex items-center justify-center rounded transition-colors disabled:opacity-20';\n    downBtn.disabled = idx === state.links.length - 1;\n    downBtn.title = 'Move down';\n    downBtn.onclick = () => moveLink(link.id, 1);\n    moveDiv.appendChild(upBtn);\n    moveDiv.appendChild(downBtn);\n\n    // Emoji button\n    const emojiBtn = document.createElement('button');\n    emojiBtn.className = 'w-8 h-8 text-lg flex items-center justify-center rounded-lg border border-slate-200 bg-white hover:bg-slate-100 transition-colors flex-shrink-0';\n    emojiBtn.textContent = link.emoji || '🔗';\n    emojiBtn.title = 'Change icon';\n    emojiBtn.onclick = () => openLinkEmojiPicker(link.id);\n\n    // Fields container\n    const fieldsDiv = document.createElement('div');\n    fieldsDiv.className = 'flex-1 flex flex-col gap-1.5 min-w-0';\n\n    const titleInput = document.createElement('input');\n    titleInput.type = 'text';\n    titleInput.value = link.title;\n    titleInput.placeholder = 'Link title';\n    titleInput.maxLength = 80;\n    titleInput.className = 'w-full text-sm border border-slate-200 rounded-lg px-2.5 py-1.5 focus:outline-none focus:ring-2 focus:ring-indigo-300 transition bg-white';\n    titleInput.oninput = (e) => { link.title = e.target.value; saveState(); };\n\n    const urlInput = document.createElement('input');\n    urlInput.type = 'url';\n    urlInput.value = link.url;\n    urlInput.placeholder = 'https://example.com';\n    urlInput.maxLength = 500;\n    urlInput.className = 'w-full text-xs border border-slate-200 rounded-lg px-2.5 py-1.5 focus:outline-none focus:ring-2 focus:ring-indigo-300 transition bg-white text-slate-500';\n    urlInput.oninput = (e) => { link.url = e.target.value; saveState(); };\n\n    fieldsDiv.appendChild(titleInput);\n    fieldsDiv.appendChild(urlInput);\n\n    // Delete button\n    const delBtn = document.createElement('button');\n    delBtn.innerHTML = '&times;';\n    delBtn.className = 'w-7 h-7 flex items-center justify-center text-slate-400 hover:text-red-500 hover:bg-red-50 rounded-lg text-lg transition-colors flex-shrink-0';\n    delBtn.title = 'Remove link';\n    delBtn.onclick = () => removeLink(link.id);\n\n    div.appendChild(moveDiv);\n    div.appendChild(emojiBtn);\n    div.appendChild(fieldsDiv);\n    div.appendChild(delBtn);\n    container.appendChild(div);\n  });\n}\n\n// ============================================================\n// LINK ACTIONS\n// ============================================================\nfunction addLink() {\n  const newLink = { id: generateId(), title: 'New Link', url: 'https://', emoji: '🔗' };\n  state.links.push(newLink);\n  saveState();\n  renderLinkList();\n  // Scroll to bottom of list\n  const container = document.getElementById('link-list');\n  container.scrollTop = container.scrollHeight;\n}\n\nfunction removeLink(id) {\n  state.links = state.links.filter(l => l.id !== id);\n  saveState();\n  renderLinkList();\n}\n\nfunction moveLink(id, direction) {\n  const idx = state.links.findIndex(l => l.id === id);\n  if (idx < 0) return;\n  const newIdx = idx + direction;\n  if (newIdx < 0 || newIdx >= state.links.length) return;\n  const temp = state.links[idx];\n  state.links[idx] = state.links[newIdx];\n  state.links[newIdx] = temp;\n  saveState();\n  renderLinkList();\n}\n\n// ============================================================\n// PROFILE CHANGE\n// ============================================================\nfunction onProfileChange() {\n  state.name = document.getElementById('field-name').value;\n  state.handle = document.getElementById('field-handle').value;\n  state.bio = document.getElementById('field-bio').value;\n  document.getElementById('bio-char-count').textContent = state.bio.length;\n  updateEditAvatar();\n  saveState();\n}\n\nfunction populateEditFields() {\n  document.getElementById('field-name').value = state.name;\n  document.getElementById('field-handle').value = state.handle;\n  document.getElementById('field-bio').value = state.bio;\n  document.getElementById('bio-char-count').textContent = state.bio.length;\n}\n\n// ============================================================\n// RENDER: PREVIEW PAGE\n// ============================================================\nfunction renderPreviewPage() {\n  const page = document.getElementById('preview-page');\n  page.style.background = state.bgTheme;\n\n  document.getElementById('preview-avatar').textContent = getAvatarContent();\n  document.getElementById('preview-avatar').style.backgroundColor = lightenHex(state.accentColor, 80);\n  document.getElementById('preview-avatar').style.color = state.accentColor;\n\n  document.getElementById('preview-name').textContent = state.name || 'Your Name';\n  document.getElementById('preview-handle').textContent = state.handle ? '@' + state.handle : '';\n  document.getElementById('preview-bio').textContent = state.bio;\n\n  renderPreviewLinks();\n}\n\nfunction renderPreviewLinks() {\n  const container = document.getElementById('preview-links');\n  container.innerHTML = '';\n\n  state.links.forEach(link => {\n    const a = document.createElement('a');\n    a.href = sanitizeUrl(link.url);\n    a.target = '_blank';\n    a.rel = 'noopener noreferrer';\n    a.className = 'preview-link-btn flex items-center gap-3 w-full px-5 py-3.5 rounded-2xl font-semibold text-sm text-center shadow-md cursor-pointer select-none';\n    a.style.backgroundColor = state.accentColor;\n    a.style.color = state.accentText || '#ffffff';\n\n    if (link.emoji) {\n      const span = document.createElement('span');\n      span.textContent = link.emoji;\n      span.className = 'text-lg flex-shrink-0';\n      a.appendChild(span);\n    }\n\n    const titleSpan = document.createElement('span');\n    titleSpan.textContent = link.title || 'Untitled Link';\n    titleSpan.className = 'flex-1 text-center';\n    a.appendChild(titleSpan);\n\n    if (link.emoji) {\n      // Spacer to keep title centered\n      const spacer = document.createElement('span');\n      spacer.className = 'text-lg opacity-0 flex-shrink-0';\n      spacer.textContent = link.emoji;\n      a.appendChild(spacer);\n    }\n\n    container.appendChild(a);\n  });\n\n  if (state.links.length === 0) {\n    const p = document.createElement('p');\n    p.className = 'text-white/60 text-sm text-center';\n    p.textContent = 'No links added yet.';\n    container.appendChild(p);\n  }\n}\n\n// ============================================================\n// AVATAR PICKER MODAL\n// ============================================================\nfunction openAvatarPicker() {\n  const grid = document.querySelector('#avatar-modal .emoji-grid');\n  grid.innerHTML = '';\n  AVATAR_EMOJIS.forEach(em => {\n    const btn = document.createElement('button');\n    btn.className = 'emoji-btn';\n    btn.textContent = em;\n    btn.onclick = () => selectEmojiAvatar(em);\n    grid.appendChild(btn);\n  });\n  document.getElementById('avatar-modal').classList.remove('hidden');\n}\n\nfunction closeAvatarModal(event) {\n  if (!event || event.target === document.getElementById('avatar-modal')) {\n    document.getElementById('avatar-modal').classList.add('hidden');\n  }\n}\n\nfunction selectEmojiAvatar(emoji) {\n  state.avatarType = 'emoji';\n  state.avatarEmoji = emoji;\n  saveState();\n  updateEditAvatar();\n  document.getElementById('avatar-modal').classList.add('hidden');\n}\n\nfunction selectInitialsAvatar() {\n  state.avatarType = 'initials';\n  state.avatarEmoji = null;\n  saveState();\n  updateEditAvatar();\n  document.getElementById('avatar-modal').classList.add('hidden');\n}\n\n// ============================================================\n// LINK EMOJI PICKER MODAL\n// ============================================================\nfunction openLinkEmojiPicker(linkId) {\n  linkEmojiTargetId = linkId;\n  const grid = document.getElementById('link-emoji-grid');\n  grid.innerHTML = '';\n  LINK_EMOJIS.forEach(em => {\n    const btn = document.createElement('button');\n    btn.className = 'emoji-btn';\n    btn.textContent = em;\n    btn.onclick = () => selectLinkEmoji(em);\n    grid.appendChild(btn);\n  });\n  document.getElementById('link-emoji-modal').classList.remove('hidden');\n}\n\nfunction closeLinkEmojiModal(event) {\n  if (!event || event.target === document.getElementById('link-emoji-modal')) {\n    document.getElementById('link-emoji-modal').classList.add('hidden');\n    linkEmojiTargetId = null;\n  }\n}\n\nfunction selectLinkEmoji(emoji) {\n  if (linkEmojiTargetId) {\n    const link = state.links.find(l => l.id === linkEmojiTargetId);\n    if (link) {\n      link.emoji = emoji;\n      saveState();\n      renderLinkList();\n    }\n  }\n  document.getElementById('link-emoji-modal').classList.add('hidden');\n  linkEmojiTargetId = null;\n}\n\n// ============================================================\n// MODE TOGGLE\n// ============================================================\nfunction setMode(mode) {\n  currentMode = mode;\n  const editPage = document.getElementById('edit-page');\n  const previewPage = document.getElementById('preview-page');\n  const btnEdit = document.getElementById('btn-edit-mode');\n  const btnPreview = document.getElementById('btn-preview-mode');\n\n  if (mode === 'edit') {\n    editPage.classList.remove('hidden');\n    previewPage.classList.add('hidden');\n    btnEdit.className = 'px-4 py-1.5 rounded-lg text-sm font-medium transition-all bg-white text-slate-800 shadow-sm';\n    btnPreview.className = 'px-4 py-1.5 rounded-lg text-sm font-medium transition-all text-slate-500 hover:text-slate-700';\n  } else {\n    editPage.classList.add('hidden');\n    previewPage.classList.remove('hidden');\n    renderPreviewPage();\n    btnPreview.className = 'px-4 py-1.5 rounded-lg text-sm font-medium transition-all bg-white text-slate-800 shadow-sm';\n    btnEdit.className = 'px-4 py-1.5 rounded-lg text-sm font-medium transition-all text-slate-500 hover:text-slate-700';\n  }\n}\n\n// ============================================================\n// INIT\n// ============================================================\nfunction init() {\n  loadState();\n  populateEditFields();\n  renderSwatches();\n  updateEditAvatar();\n  renderLinkList();\n  setMode('edit');\n}\n\ndocument.addEventListener('DOMContentLoaded', init);\n</script>\n</body>\n</html>\n",
