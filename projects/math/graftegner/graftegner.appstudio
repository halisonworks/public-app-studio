{
  "schema": "app-studio/canvas@1",
  "id": "example-math-graftegner",
  "name": "graftegner.html",
  "code": "<!DOCTYPE html>\n<!--\n  Digital graftegner — Halison App Studio-eksempel\n\n  Interaktivt verktøy for matematikk 1P/2P (LK20): plott funksjoner, finn\n  nullpunkt og skjæringspunkt, og les av verditabell.\n\n  Fra Halison App Studio sitt offentlige bibliotek:\n  https://github.com/halisonworks/public-app-studio\n\n  Tillatt bruk: personlig, pedagogisk og annen ikke-kommersiell bruk. Behold denne\n  headeren og kildelenken; ikke-kommersiell bruk. Utgitt under Halison App Studio\n  Examples License — se LICENSE-filen i repoet over.\n-->\n<html lang=\"no\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Graftegner — Matematikk 1P/2P</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Segoe UI', system-ui, sans-serif; }\n    .func-row { display: flex; align-items: center; gap: 6px; margin-bottom: 6px; }\n    .color-dot { width: 14px; height: 14px; border-radius: 50%; flex-shrink: 0; }\n    input[type=number]::-webkit-inner-spin-button { opacity: 0.6; }\n    .panel-label { font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: #6b7280; }\n    #graphSvg { display: block; width: 100%; height: 100%; }\n    .tick-label { font-size: 11px; fill: #374151; }\n    .axis-line { stroke: #374151; stroke-width: 1.5; }\n    .grid-line { stroke: #e5e7eb; stroke-width: 1; }\n    .zero-line { stroke: #9ca3af; stroke-width: 1; stroke-dasharray: 4 3; }\n    .trace-line { stroke: #7c3aed; stroke-width: 1.2; stroke-dasharray: 5 3; }\n    .point-dot { r: 5; fill: white; stroke-width: 2; }\n    .legend-box { background: rgba(255,255,255,0.92); border: 1px solid #e5e7eb; border-radius: 6px; padding: 6px 10px; font-size: 12px; }\n    #resultList li { padding: 2px 0; font-size: 0.82rem; }\n    .tab-btn { cursor: pointer; padding: 4px 12px; border-radius: 4px; font-size: 0.82rem; font-weight: 600; transition: background 0.15s; }\n    .tab-btn.active { background: #2563eb; color: white; }\n    .tab-btn:not(.active) { background: #f3f4f6; color: #374151; }\n    .tab-btn:not(.active):hover { background: #e5e7eb; }\n    table.verditabell { border-collapse: collapse; width: 100%; font-size: 0.8rem; }\n    table.verditabell th, table.verditabell td { border: 1px solid #d1d5db; padding: 3px 8px; text-align: right; }\n    table.verditabell th { background: #f3f4f6; font-weight: 600; }\n    .error-msg { color: #dc2626; font-size: 0.78rem; }\n  </style>\n</head>\n<body class=\"bg-gray-50 min-h-screen\">\n\n<div class=\"max-w-7xl mx-auto px-2 py-3\">\n  <!-- Header -->\n  <div class=\"mb-3 flex items-center gap-3\">\n    <div>\n      <h1 class=\"text-xl font-bold text-gray-800 leading-tight\">Graftegner</h1>\n      <p class=\"text-xs text-gray-500\">Matematikk 1P/2P (LK20) · Interaktivt verktøy</p>\n    </div>\n  </div>\n\n  <div class=\"flex flex-col lg:flex-row gap-3\">\n\n    <!-- LEFT PANEL -->\n    <div class=\"w-full lg:w-72 flex-shrink-0 flex flex-col gap-3\">\n\n      <!-- Funksjoner -->\n      <div class=\"bg-white rounded-xl shadow-sm border border-gray-200 p-3\">\n        <div class=\"panel-label mb-2\">Funksjoner</div>\n        <div id=\"funcList\"></div>\n        <button id=\"addFuncBtn\" class=\"mt-1 text-xs text-blue-600 hover:text-blue-800 font-semibold\">+ Legg til funksjon</button>\n        <div class=\"mt-2\">\n          <button id=\"plotBtn\" class=\"w-full bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold py-1.5 rounded-lg transition\">Tegn graf</button>\n        </div>\n        <div id=\"parseError\" class=\"error-msg mt-1\"></div>\n      </div>\n\n      <!-- Visningsvindu -->\n      <div class=\"bg-white rounded-xl shadow-sm border border-gray-200 p-3\">\n        <div class=\"panel-label mb-2\">Visningsvindu</div>\n        <div class=\"grid grid-cols-2 gap-2 text-sm\">\n          <label class=\"flex flex-col gap-0.5\">\n            <span class=\"text-xs text-gray-500\">x min</span>\n            <input id=\"xmin\" type=\"number\" value=\"-10\" class=\"border border-gray-300 rounded px-2 py-1 w-full text-sm\" />\n          </label>\n          <label class=\"flex flex-col gap-0.5\">\n            <span class=\"text-xs text-gray-500\">x maks</span>\n            <input id=\"xmax\" type=\"number\" value=\"10\" class=\"border border-gray-300 rounded px-2 py-1 w-full text-sm\" />\n          </label>\n          <label class=\"flex flex-col gap-0.5\">\n            <span class=\"text-xs text-gray-500\">y min</span>\n            <input id=\"ymin\" type=\"number\" value=\"-10\" class=\"border border-gray-300 rounded px-2 py-1 w-full text-sm\" />\n          </label>\n          <label class=\"flex flex-col gap-0.5\">\n            <span class=\"text-xs text-gray-500\">y maks</span>\n            <input id=\"ymax\" type=\"number\" value=\"10\" class=\"border border-gray-300 rounded px-2 py-1 w-full text-sm\" />\n          </label>\n        </div>\n        <div class=\"flex gap-2 mt-2\">\n          <button id=\"zoomInBtn\" class=\"flex-1 text-xs bg-gray-100 hover:bg-gray-200 rounded py-1 font-semibold\">Zoom inn</button>\n          <button id=\"zoomOutBtn\" class=\"flex-1 text-xs bg-gray-100 hover:bg-gray-200 rounded py-1 font-semibold\">Zoom ut</button>\n          <button id=\"resetBtn\" class=\"flex-1 text-xs bg-gray-100 hover:bg-gray-200 rounded py-1 font-semibold\">Nullstill</button>\n        </div>\n      </div>\n\n      <!-- Analyse -->\n      <div class=\"bg-white rounded-xl shadow-sm border border-gray-200 p-3\">\n        <div class=\"panel-label mb-2\">Analyse</div>\n        <div class=\"flex gap-1 mb-2\">\n          <button class=\"tab-btn active\" data-tab=\"nullpunkt\">Nullpunkt</button>\n          <button class=\"tab-btn\" data-tab=\"skjaering\">Skjæring</button>\n        </div>\n\n        <!-- Nullpunkt tab -->\n        <div id=\"tab-nullpunkt\">\n          <label class=\"text-xs text-gray-500 block mb-1\">Velg funksjon</label>\n          <select id=\"nullpktFunc\" class=\"border border-gray-300 rounded px-2 py-1 w-full text-sm mb-2\"></select>\n          <button id=\"findNullpktBtn\" class=\"w-full bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold py-1.5 rounded-lg transition\">Finn nullpunkt</button>\n        </div>\n\n        <!-- Skjæring tab -->\n        <div id=\"tab-skjaering\" class=\"hidden\">\n          <label class=\"text-xs text-gray-500 block mb-1\">Funksjon 1</label>\n          <select id=\"skjFunc1\" class=\"border border-gray-300 rounded px-2 py-1 w-full text-sm mb-1\"></select>\n          <label class=\"text-xs text-gray-500 block mb-1\">Funksjon 2</label>\n          <select id=\"skjFunc2\" class=\"border border-gray-300 rounded px-2 py-1 w-full text-sm mb-2\"></select>\n          <button id=\"findSkjBtn\" class=\"w-full bg-orange-500 hover:bg-orange-600 text-white text-xs font-semibold py-1.5 rounded-lg transition\">Finn skjæringspunkt</button>\n        </div>\n\n        <ul id=\"resultList\" class=\"mt-2 text-gray-700 space-y-0.5\"></ul>\n      </div>\n\n      <!-- Avlesning -->\n      <div class=\"bg-white rounded-xl shadow-sm border border-gray-200 p-3\">\n        <div class=\"panel-label mb-2\">Avlesning (spor)</div>\n        <label class=\"text-xs text-gray-500 block mb-1\">x-verdi</label>\n        <div class=\"flex gap-2\">\n          <input id=\"traceX\" type=\"number\" placeholder=\"f.eks. 2\" class=\"border border-gray-300 rounded px-2 py-1 flex-1 text-sm\" />\n          <button id=\"traceBtn\" class=\"bg-violet-600 hover:bg-violet-700 text-white text-xs font-semibold px-3 rounded-lg\">Vis</button>\n        </div>\n        <ul id=\"traceResult\" class=\"mt-2 text-gray-700 space-y-0.5 text-sm\"></ul>\n      </div>\n\n      <!-- Verditabell -->\n      <div class=\"bg-white rounded-xl shadow-sm border border-gray-200 p-3\">\n        <div class=\"panel-label mb-2\">Verditabell</div>\n        <label class=\"text-xs text-gray-500 block mb-1\">Velg funksjon</label>\n        <select id=\"tabFunc\" class=\"border border-gray-300 rounded px-2 py-1 w-full text-sm mb-2\"></select>\n        <div class=\"grid grid-cols-3 gap-1 text-xs mb-2\">\n          <label class=\"flex flex-col gap-0.5\">\n            <span class=\"text-gray-500\">Fra x</span>\n            <input id=\"tabXfra\" type=\"number\" value=\"-5\" class=\"border border-gray-300 rounded px-1 py-1 w-full\" />\n          </label>\n          <label class=\"flex flex-col gap-0.5\">\n            <span class=\"text-gray-500\">Til x</span>\n            <input id=\"tabXtil\" type=\"number\" value=\"5\" class=\"border border-gray-300 rounded px-1 py-1 w-full\" />\n          </label>\n          <label class=\"flex flex-col gap-0.5\">\n            <span class=\"text-gray-500\">Steg</span>\n            <input id=\"tabSteg\" type=\"number\" value=\"1\" step=\"0.5\" class=\"border border-gray-300 rounded px-1 py-1 w-full\" />\n          </label>\n        </div>\n        <button id=\"buildTabBtn\" class=\"w-full bg-teal-600 hover:bg-teal-700 text-white text-xs font-semibold py-1.5 rounded-lg transition mb-2\">Lag tabell</button>\n        <div id=\"verditabellWrap\" class=\"overflow-x-auto max-h-48 overflow-y-auto\"></div>\n      </div>\n\n    </div>\n\n    <!-- GRAPH AREA -->\n    <div class=\"flex-1 bg-white rounded-xl shadow-sm border border-gray-200 relative overflow-hidden\" style=\"min-height:480px;\">\n      <svg id=\"graphSvg\" xmlns=\"http://www.w3.org/2000/svg\" style=\"touch-action:none;\"></svg>\n      <!-- legend -->\n      <div id=\"legend\" class=\"legend-box absolute top-3 right-3 hidden\"></div>\n    </div>\n\n  </div>\n</div>\n\n<script>\n/* =========================================================\n   EXPRESSION PARSER / EVALUATOR\n   Supports: numbers, x, +, -, *, /, ^, parentheses,\n             implicit multiplication (2x, 3(x+1), (x+1)(x-1)),\n             functions: sin, cos, tan, sqrt, abs, ln, log\n   No eval() is used.\n   ========================================================= */\n(function(){\n\"use strict\";\n\n// ---- Tokeniser ----\nfunction tokenise(src){\n  const tokens=[];\n  let i=0;\n  src=src.trim().toLowerCase();\n  while(i<src.length){\n    const c=src[i];\n    if(c===' '||c==='\\t'){i++;continue;}\n    if('0123456789.'.includes(c)){\n      let num='';\n      while(i<src.length&&'0123456789.'.includes(src[i])) num+=src[i++];\n      tokens.push({t:'num',v:parseFloat(num)});\n    } else if(c==='x'){\n      tokens.push({t:'var'});i++;\n    } else if('+-*/^()'.includes(c)){\n      tokens.push({t:'op',v:c});i++;\n    } else if(/[a-z]/.test(c)){\n      let name='';\n      while(i<src.length&&/[a-z]/.test(src[i])) name+=src[i++];\n      tokens.push({t:'fn',v:name});\n    } else {\n      throw new Error('Ukjent tegn: '+c);\n    }\n  }\n  return tokens;\n}\n\n// Insert implicit multiplication tokens where needed:\n// num/var/close_paren followed by num/var/open_paren/fn\nfunction insertImplicit(tokens){\n  const out=[];\n  for(let i=0;i<tokens.length;i++){\n    out.push(tokens[i]);\n    if(i+1<tokens.length){\n      const a=tokens[i], b=tokens[i+1];\n      const aRight=(a.t==='num'||a.t==='var'||(a.t==='op'&&a.v===')'));\n      const bLeft=(b.t==='num'||b.t==='var'||(b.t==='op'&&b.v==='(')||b.t==='fn');\n      if(aRight&&bLeft) out.push({t:'op',v:'*'});\n    }\n  }\n  return out;\n}\n\n// ---- Recursive-descent parser → AST ----\nfunction parse(tokens){\n  let pos=0;\n  function peek(){ return tokens[pos]; }\n  function consume(){ return tokens[pos++]; }\n  function expect(type,val){\n    const t=consume();\n    if(t.t!==type||(val!==undefined&&t.v!==val)) throw new Error('Parse-feil');\n    return t;\n  }\n\n  function parseExpr(){ return parseAddSub(); }\n\n  function parseAddSub(){\n    let left=parseMulDiv();\n    while(peek()&&peek().t==='op'&&(peek().v==='+'||peek().v==='-')){\n      const op=consume().v;\n      const right=parseMulDiv();\n      left={t:'binop',op,left,right};\n    }\n    return left;\n  }\n\n  function parseMulDiv(){\n    let left=parseUnary();\n    while(peek()&&peek().t==='op'&&(peek().v==='*'||peek().v==='/')){\n      const op=consume().v;\n      const right=parseUnary();\n      left={t:'binop',op,left,right};\n    }\n    return left;\n  }\n\n  function parseUnary(){\n    if(peek()&&peek().t==='op'&&peek().v==='-'){\n      consume();\n      const arg=parsePower();\n      return{t:'neg',arg};\n    }\n    if(peek()&&peek().t==='op'&&peek().v==='+'){\n      consume();\n      return parsePower();\n    }\n    return parsePower();\n  }\n\n  function parsePower(){\n    let base=parseAtom();\n    if(peek()&&peek().t==='op'&&peek().v==='^'){\n      consume();\n      const exp=parseUnary();\n      return{t:'binop',op:'^',left:base,right:exp};\n    }\n    return base;\n  }\n\n  function parseAtom(){\n    const t=peek();\n    if(!t) throw new Error('Uventet slutt på uttrykk');\n    if(t.t==='num'){ consume(); return{t:'num',v:t.v}; }\n    if(t.t==='var'){ consume(); return{t:'var'}; }\n    if(t.t==='fn'){\n      consume();\n      expect('op','(');\n      const arg=parseExpr();\n      expect('op',')');\n      return{t:'fn',name:t.v,arg};\n    }\n    if(t.t==='op'&&t.v==='('){\n      consume();\n      const inner=parseExpr();\n      expect('op',')');\n      return inner;\n    }\n    throw new Error('Uventet token: '+JSON.stringify(t));\n  }\n\n  const ast=parseExpr();\n  if(pos<tokens.length) throw new Error('Uventet innhold etter uttrykket');\n  return ast;\n}\n\n// ---- AST evaluator ----\nfunction evalAST(node,x){\n  switch(node.t){\n    case 'num': return node.v;\n    case 'var': return x;\n    case 'neg': return -evalAST(node.arg,x);\n    case 'fn':{\n      const a=evalAST(node.arg,x);\n      switch(node.name){\n        case 'sin': return Math.sin(a);\n        case 'cos': return Math.cos(a);\n        case 'tan': return Math.tan(a);\n        case 'sqrt': return Math.sqrt(a);\n        case 'abs': return Math.abs(a);\n        case 'ln': return Math.log(a);\n        case 'log': return Math.log10(a);\n        default: throw new Error('Ukjent funksjon: '+node.name);\n      }\n    }\n    case 'binop':{\n      const l=evalAST(node.left,x), r=evalAST(node.right,x);\n      switch(node.op){\n        case '+': return l+r;\n        case '-': return l-r;\n        case '*': return l*r;\n        case '/': return l/r;\n        case '^': return Math.pow(l,r);\n      }\n    }\n    default: throw new Error('Ukjent node');\n  }\n}\n\n// ---- Public API ----\nfunction compileFn(expr){\n  if(!expr||!expr.trim()) throw new Error('Tom funksjon');\n  const tokens=insertImplicit(tokenise(expr));\n  const ast=parse(tokens);\n  return function(x){ return evalAST(ast,x); };\n}\n\nwindow._graftegner_compile=compileFn;\n})();\n\n/* =========================================================\n   COLOURS\n   ========================================================= */\nconst COLORS=['#2563eb','#dc2626','#16a34a','#9333ea','#ea580c','#0891b2','#be185d','#ca8a04'];\n\n/* =========================================================\n   STATE\n   ========================================================= */\nlet functions=[\n  {expr:'2*x+3',   color:COLORS[0], fn:null, error:null},\n  {expr:'x^2-4',   color:COLORS[1], fn:null, error:null},\n];\nlet viewport={xmin:-10,xmax:10,ymin:-10,ymax:10};\nlet traceX=null;\nlet analysisPoints=[]; // {x,y,type,label,color}\n\n/* =========================================================\n   DOM HELPERS\n   ========================================================= */\nconst $ = id => document.getElementById(id);\nconst FUNC_LIST=$('funcList');\nconst GRAPH_SVG=$('graphSvg');\nconst LEGEND=$('legend');\n\n/* =========================================================\n   FUNCTION LIST UI\n   ========================================================= */\nfunction rebuildFuncList(){\n  FUNC_LIST.innerHTML='';\n  functions.forEach((f,i)=>{\n    const row=document.createElement('div');\n    row.className='func-row';\n    row.innerHTML=`\n      <div class=\"color-dot\" style=\"background:${f.color};border:2px solid #fff;box-shadow:0 0 0 1.5px ${f.color};\"></div>\n      <input type=\"text\" class=\"border border-gray-300 rounded px-2 py-1 flex-1 text-sm font-mono\"\n             placeholder=\"f.eks. 2x+3\" value=\"${f.expr}\" data-idx=\"${i}\" />\n      ${functions.length>1?`<button class=\"text-gray-400 hover:text-red-500 text-lg leading-none font-bold\" data-del=\"${i}\">×</button>`:''}\n    `;\n    FUNC_LIST.appendChild(row);\n    if(f.error){\n      const err=document.createElement('div');\n      err.className='error-msg pl-5';\n      err.textContent=f.error;\n      FUNC_LIST.appendChild(err);\n    }\n  });\n\n  // events\n  FUNC_LIST.querySelectorAll('input[data-idx]').forEach(inp=>{\n    inp.addEventListener('input',e=>{\n      functions[+e.target.dataset.idx].expr=e.target.value.trim();\n      functions[+e.target.dataset.idx].error=null;\n    });\n    inp.addEventListener('keydown',e=>{ if(e.key==='Enter') compileAndPlot(); });\n  });\n  FUNC_LIST.querySelectorAll('button[data-del]').forEach(btn=>{\n    btn.addEventListener('click',e=>{\n      functions.splice(+e.target.dataset.del,1);\n      rebuildFuncList();\n      rebuildSelects();\n    });\n  });\n}\n\n$('addFuncBtn').addEventListener('click',()=>{\n  if(functions.length>=8) return;\n  functions.push({expr:'',color:COLORS[functions.length%COLORS.length],fn:null,error:null});\n  rebuildFuncList();\n  rebuildSelects();\n});\n\n/* =========================================================\n   COMPILE FUNCTIONS\n   ========================================================= */\nfunction compileAll(){\n  let ok=true;\n  functions.forEach(f=>{\n    f.error=null;\n    if(!f.expr){f.fn=null;return;}\n    try{\n      f.fn=window._graftegner_compile(f.expr);\n    } catch(e){\n      f.fn=null; f.error=e.message; ok=false;\n    }\n  });\n  rebuildFuncList();\n  $('parseError').textContent='';\n  return ok;\n}\n\n/* =========================================================\n   SELECTS (analysis + verditabell)\n   ========================================================= */\nfunction rebuildSelects(){\n  const ids=['nullpktFunc','skjFunc1','skjFunc2','tabFunc'];\n  ids.forEach(id=>{\n    const sel=$(id);\n    const prev=sel.value;\n    sel.innerHTML='';\n    functions.forEach((f,i)=>{\n      const label=f.expr||`f${i+1}`;\n      sel.innerHTML+=`<option value=\"${i}\">${label}</option>`;\n    });\n    if(prev!==''&&$(id).querySelector(`option[value=\"${prev}\"]`)) sel.value=prev;\n  });\n}\n\n/* =========================================================\n   VIEWPORT helpers\n   ========================================================= */\nfunction readViewport(){\n  const xmin=parseFloat($('xmin').value)||viewport.xmin;\n  const xmax=parseFloat($('xmax').value)||viewport.xmax;\n  const ymin=parseFloat($('ymin').value)||viewport.ymin;\n  const ymax=parseFloat($('ymax').value)||viewport.ymax;\n  if(xmin<xmax&&ymin<ymax){\n    viewport={xmin,xmax,ymin,ymax};\n  }\n}\n\nfunction writeViewport(){\n  $('xmin').value=viewport.xmin;\n  $('xmax').value=viewport.xmax;\n  $('ymin').value=viewport.ymin;\n  $('ymax').value=viewport.ymax;\n}\n\n$('zoomInBtn').addEventListener('click',()=>{\n  readViewport();\n  const cx=(viewport.xmin+viewport.xmax)/2, cy=(viewport.ymin+viewport.ymax)/2;\n  const hw=(viewport.xmax-viewport.xmin)*0.35, hh=(viewport.ymax-viewport.ymin)*0.35;\n  viewport={xmin:cx-hw,xmax:cx+hw,ymin:cy-hh,ymax:cy+hh};\n  writeViewport(); compileAndPlot();\n});\n$('zoomOutBtn').addEventListener('click',()=>{\n  readViewport();\n  const cx=(viewport.xmin+viewport.xmax)/2, cy=(viewport.ymin+viewport.ymax)/2;\n  const hw=(viewport.xmax-viewport.xmin)*0.7, hh=(viewport.ymax-viewport.ymin)*0.7;\n  viewport={xmin:cx-hw,xmax:cx+hw,ymin:cy-hh,ymax:cy+hh};\n  writeViewport(); compileAndPlot();\n});\n$('resetBtn').addEventListener('click',()=>{\n  viewport={xmin:-10,xmax:10,ymin:-10,ymax:10};\n  writeViewport(); analysisPoints=[]; traceX=null; compileAndPlot();\n});\n\n/* =========================================================\n   PLOT\n   ========================================================= */\nfunction compileAndPlot(){\n  readViewport();\n  compileAll();\n  rebuildSelects();\n  drawGraph();\n}\n\n$('plotBtn').addEventListener('click', compileAndPlot);\n\n/* =========================================================\n   NUMERICAL HELPERS\n   ========================================================= */\n// Find roots of f in [a,b] with bisection, collecting sign changes\nfunction findRoots(fn, xmin, xmax, steps){\n  const roots=[];\n  const dx=(xmax-xmin)/steps;\n  let x0=xmin, y0;\n  try{ y0=fn(x0); } catch(e){ y0=NaN; }\n  for(let i=1;i<=steps;i++){\n    const x1=xmin+i*dx;\n    let y1;\n    try{ y1=fn(x1); } catch(e){ y1=NaN; }\n    if(!isFinite(y0)||!isFinite(y1)){x0=x1;y0=y1;continue;}\n    if(Math.abs(y0)<1e-10){ roots.push(x0); x0=x1;y0=y1;continue; }\n    if(y0*y1<0){\n      // bisect\n      let lo=x0,hi=x1,flo=y0;\n      for(let k=0;k<52;k++){\n        const mid=(lo+hi)/2;\n        let fm;\n        try{ fm=fn(mid); } catch(e){ break; }\n        if(!isFinite(fm)) break;\n        if(Math.abs(fm)<1e-12){lo=mid;break;}\n        if(flo*fm<0){hi=mid;}else{lo=mid;flo=fm;}\n      }\n      roots.push((lo+hi)/2);\n    }\n    x0=x1; y0=y1;\n  }\n  // deduplicate\n  const unique=[];\n  roots.forEach(r=>{\n    if(unique.every(u=>Math.abs(u-r)>1e-6)) unique.push(r);\n  });\n  return unique;\n}\n\nfunction findIntersections(fn1,fn2,xmin,xmax){\n  const diff=x=>fn1(x)-fn2(x);\n  return findRoots(diff,xmin,xmax,2000);\n}\n\n/* =========================================================\n   ANALYSIS ACTIONS\n   ========================================================= */\n// Tabs\ndocument.querySelectorAll('.tab-btn').forEach(btn=>{\n  btn.addEventListener('click',function(){\n    document.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));\n    this.classList.add('active');\n    const tab=this.dataset.tab;\n    $('tab-nullpunkt').classList.add('hidden');\n    $('tab-skjaering').classList.add('hidden');\n    $('tab-'+tab).classList.remove('hidden');\n    $('resultList').innerHTML='';\n  });\n});\n\n$('findNullpktBtn').addEventListener('click',()=>{\n  compileAll();\n  readViewport();\n  const idx=+$('nullpktFunc').value;\n  const f=functions[idx];\n  if(!f||!f.fn){ showResults([],[],'Ingen gyldig funksjon valgt.'); return; }\n  const roots=findRoots(f.fn,viewport.xmin,viewport.xmax,4000);\n  const pts=roots.map(rx=>({x:rx,y:0,type:'nullpunkt',label:`Nullpunkt`,color:f.color}));\n  analysisPoints=pts;\n  const lines=roots.length===0\n    ?['Ingen nullpunkt funnet i visningsvinduet.']\n    :roots.map(rx=>`x = ${fmt(rx)}  →  (${fmt(rx)}, 0)`);\n  showResults(lines, pts.length===0?[{text:'Ingen nullpunkt',color:f.color}]:null);\n  drawGraph();\n});\n\n$('findSkjBtn').addEventListener('click',()=>{\n  compileAll();\n  readViewport();\n  const i1=+$('skjFunc1').value, i2=+$('skjFunc2').value;\n  if(i1===i2){ showResults(['Velg to ulike funksjoner.'],null); return; }\n  const f1=functions[i1],f2=functions[i2];\n  if(!f1||!f1.fn||!f2||!f2.fn){ showResults(['En eller begge funksjoner er ugyldige.'],null); return; }\n  const xs=findIntersections(f1.fn,f2.fn,viewport.xmin,viewport.xmax);\n  const pts=xs.map(rx=>{\n    let ry;\n    try{ ry=f1.fn(rx); } catch(e){ ry=NaN; }\n    return {x:rx,y:ry,type:'skjaering',label:'Skjæringspunkt',color:'#f59e0b'};\n  });\n  analysisPoints=pts;\n  const lines=pts.length===0\n    ?['Ingen skjæringspunkt funnet i visningsvinduet.']\n    :pts.map(p=>`(${fmt(p.x)}, ${fmt(p.y)})`);\n  showResults(lines,null);\n  drawGraph();\n});\n\nfunction showResults(lines,_unused){\n  const ul=$('resultList');\n  ul.innerHTML='';\n  lines.forEach(l=>{\n    const li=document.createElement('li');\n    li.textContent=l;\n    ul.appendChild(li);\n  });\n}\n\n/* =========================================================\n   TRACE\n   ========================================================= */\n$('traceBtn').addEventListener('click',()=>{\n  compileAll();\n  const xv=parseFloat($('traceX').value);\n  if(!isFinite(xv)){ $('traceResult').innerHTML='<li class=\"error-msg\">Ugyldig x-verdi.</li>'; traceX=null; drawGraph(); return; }\n  traceX=xv;\n  const ul=$('traceResult');\n  ul.innerHTML='';\n  functions.forEach((f,i)=>{\n    if(!f.fn||!f.expr) return;\n    let y;\n    try{ y=f.fn(xv); } catch(e){ y=NaN; }\n    const li=document.createElement('li');\n    li.innerHTML=`<span style=\"color:${f.color};font-weight:700;\">f${i+1}(${fmt(xv)})</span> = ${isFinite(y)?fmt(y):'udefinert'}`;\n    ul.appendChild(li);\n  });\n  drawGraph();\n});\n\n/* =========================================================\n   VERDITABELL\n   ========================================================= */\n$('buildTabBtn').addEventListener('click',()=>{\n  compileAll();\n  const idx=+$('tabFunc').value;\n  const f=functions[idx];\n  if(!f||!f.fn){ $('verditabellWrap').innerHTML='<span class=\"error-msg\">Ingen gyldig funksjon.</span>'; return; }\n  const fra=parseFloat($('tabXfra').value);\n  const til=parseFloat($('tabXtil').value);\n  let steg=parseFloat($('tabSteg').value);\n  if(!isFinite(fra)||!isFinite(til)||!isFinite(steg)||steg<=0||fra>=til){\n    $('verditabellWrap').innerHTML='<span class=\"error-msg\">Ugyldig område eller steg.</span>'; return;\n  }\n  // clamp max rows\n  const n=Math.round((til-fra)/steg)+1;\n  if(n>200){ $('verditabellWrap').innerHTML='<span class=\"error-msg\">For mange rader (maks 200). Øk steget.</span>'; return; }\n  let html='<table class=\"verditabell\"><thead><tr><th>x</th><th>f(x)</th></tr></thead><tbody>';\n  for(let k=0;k<n;k++){\n    const x=fra+k*steg;\n    let y;\n    try{ y=f.fn(x); } catch(e){ y=NaN; }\n    html+=`<tr><td>${fmt(x)}</td><td>${isFinite(y)?fmt(y):'udefinert'}</td></tr>`;\n  }\n  html+='</tbody></table>';\n  $('verditabellWrap').innerHTML=html;\n});\n\n/* =========================================================\n   FORMAT number\n   ========================================================= */\nfunction fmt(v){ return Math.abs(v)<1e-10?'0':parseFloat(v.toPrecision(6)).toString(); }\n\n/* =========================================================\n   DRAW\n   ========================================================= */\nfunction drawGraph(){\n  const svgEl=GRAPH_SVG;\n  const W=svgEl.clientWidth||600;\n  const H=svgEl.clientHeight||480;\n  const PAD={top:20,right:20,bottom:36,left:44};\n  const gW=W-PAD.left-PAD.right;\n  const gH=H-PAD.top-PAD.bottom;\n\n  const {xmin,xmax,ymin,ymax}=viewport;\n  const xRange=xmax-xmin, yRange=ymax-ymin;\n\n  function sx(x){ return PAD.left+(x-xmin)/xRange*gW; }\n  function sy(y){ return PAD.top+(ymax-y)/yRange*gH; }\n  function worldX(px){ return xmin+(px-PAD.left)/gW*xRange; }\n  function worldY(py){ return ymax-(py-PAD.top)/gH*yRange; }\n\n  // nice tick spacing\n  function niceTick(range, pixels){\n    const ideal=pixels/60;\n    const raw=range/ideal;\n    const pow=Math.pow(10,Math.floor(Math.log10(raw)));\n    for(const f of [1,2,2.5,5,10]){\n      if(raw<=f*pow) return f*pow;\n    }\n    return 10*pow;\n  }\n  const xTick=niceTick(xRange,gW);\n  const yTick=niceTick(yRange,gH);\n\n  let svg=`<defs></defs>`;\n\n  // Background\n  svg+=`<rect x=\"0\" y=\"0\" width=\"${W}\" height=\"${H}\" fill=\"#f9fafb\"/>`;\n  svg+=`<rect x=\"${PAD.left}\" y=\"${PAD.top}\" width=\"${gW}\" height=\"${gH}\" fill=\"white\" stroke=\"#e5e7eb\" stroke-width=\"1\"/>`;\n\n  // Grid & ticks\n  const xStart=Math.ceil(xmin/xTick)*xTick;\n  const yStart=Math.ceil(ymin/yTick)*yTick;\n\n  for(let x=xStart;x<=xmax+1e-9;x+=xTick){\n    const px=sx(x);\n    if(px<PAD.left||px>PAD.left+gW) continue;\n    svg+=`<line x1=\"${px}\" y1=\"${PAD.top}\" x2=\"${px}\" y2=\"${PAD.top+gH}\" class=\"grid-line\"/>`;\n    const label=fmt(x);\n    if(Math.abs(x)>1e-9)\n      svg+=`<text x=\"${px}\" y=\"${PAD.top+gH+14}\" text-anchor=\"middle\" class=\"tick-label\">${label}</text>`;\n  }\n  for(let y=yStart;y<=ymax+1e-9;y+=yTick){\n    const py=sy(y);\n    if(py<PAD.top||py>PAD.top+gH) continue;\n    svg+=`<line x1=\"${PAD.left}\" y1=\"${py}\" x2=\"${PAD.left+gW}\" y2=\"${py}\" class=\"grid-line\"/>`;\n    const label=fmt(y);\n    if(Math.abs(y)>1e-9)\n      svg+=`<text x=\"${PAD.left-4}\" y=\"${py+4}\" text-anchor=\"end\" class=\"tick-label\">${label}</text>`;\n  }\n\n  // Axes\n  if(ymin<=0&&ymax>=0){\n    const py=sy(0);\n    svg+=`<line x1=\"${PAD.left}\" y1=\"${py}\" x2=\"${PAD.left+gW}\" y2=\"${py}\" class=\"axis-line\"/>`;\n    svg+=`<text x=\"${PAD.left+gW+4}\" y=\"${py+4}\" class=\"tick-label\" font-weight=\"bold\">x</text>`;\n  }\n  if(xmin<=0&&xmax>=0){\n    const px=sx(0);\n    svg+=`<line x1=\"${px}\" y1=\"${PAD.top}\" x2=\"${px}\" y2=\"${PAD.top+gH}\" class=\"axis-line\"/>`;\n    svg+=`<text x=\"${px}\" y=\"${PAD.top-6}\" text-anchor=\"middle\" class=\"tick-label\" font-weight=\"bold\">y</text>`;\n  }\n  // Origin label\n  if(xmin<=0&&xmax>=0&&ymin<=0&&ymax>=0){\n    svg+=`<text x=\"${sx(0)-5}\" y=\"${sy(0)+13}\" class=\"tick-label\">0</text>`;\n  }\n\n  // Clip path\n  svg+=`<clipPath id=\"graphClip\"><rect x=\"${PAD.left}\" y=\"${PAD.top}\" width=\"${gW}\" height=\"${gH}\"/></clipPath>`;\n\n  // Function curves\n  const STEPS=Math.min(Math.ceil(gW*2),2000);\n  const activeFns=functions.filter(f=>f.fn&&f.expr);\n\n  activeFns.forEach((f,fi)=>{\n    const pts=[];\n    for(let k=0;k<=STEPS;k++){\n      const x=xmin+k/STEPS*xRange;\n      let y;\n      try{ y=f.fn(x); } catch(e){ y=NaN; }\n      pts.push([x,y]);\n    }\n    // Build SVG path segments, breaking on discontinuities\n    let d='';\n    let inSeg=false;\n    for(let k=0;k<pts.length;k++){\n      const [x,y]=pts[k];\n      if(!isFinite(y)){inSeg=false;continue;}\n      // Check large jump (possible asymptote)\n      if(inSeg&&k>0&&isFinite(pts[k-1][1])){\n        const dy=Math.abs(y-pts[k-1][1]);\n        if(dy>yRange*3){ inSeg=false; }\n      }\n      const px=sx(x), py=sy(y);\n      if(!inSeg){ d+=`M${px.toFixed(2)},${py.toFixed(2)}`; inSeg=true; }\n      else { d+=`L${px.toFixed(2)},${py.toFixed(2)}`; }\n    }\n    if(d){\n      svg+=`<path d=\"${d}\" fill=\"none\" stroke=\"${f.color}\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" clip-path=\"url(#graphClip)\"/>`;\n    }\n  });\n\n  // Trace line\n  if(traceX!==null&&isFinite(traceX)&&traceX>=xmin&&traceX<=xmax){\n    const px=sx(traceX);\n    svg+=`<line x1=\"${px}\" y1=\"${PAD.top}\" x2=\"${px}\" y2=\"${PAD.top+gH}\" class=\"trace-line\" clip-path=\"url(#graphClip)\"/>`;\n    activeFns.forEach(f=>{\n      let y;\n      try{ y=f.fn(traceX); } catch(e){ y=NaN; }\n      if(isFinite(y)&&y>=ymin&&y<=ymax){\n        const py=sy(y);\n        svg+=`<circle cx=\"${px}\" cy=\"${py}\" r=\"5\" fill=\"${f.color}\" stroke=\"white\" stroke-width=\"2\" clip-path=\"url(#graphClip)\"/>`;\n        const lx=px+8, ly=py-4;\n        svg+=`<text x=\"${lx}\" y=\"${ly}\" fill=\"${f.color}\" font-size=\"11\" font-weight=\"600\">(${fmt(traceX)}, ${fmt(y)})</text>`;\n      }\n    });\n  }\n\n  // Analysis points\n  analysisPoints.forEach(p=>{\n    if(!isFinite(p.x)||!isFinite(p.y)) return;\n    if(p.x<xmin||p.x>xmax||p.y<ymin||p.y>ymax) return;\n    const px=sx(p.x), py=sy(p.y);\n    svg+=`<circle cx=\"${px}\" cy=\"${py}\" r=\"6\" fill=\"white\" stroke=\"${p.color}\" stroke-width=\"2.5\" clip-path=\"url(#graphClip)\"/>`;\n    svg+=`<circle cx=\"${px}\" cy=\"${py}\" r=\"2.5\" fill=\"${p.color}\" clip-path=\"url(#graphClip)\"/>`;\n    const lx=px+8, ly=py-8;\n    svg+=`<text x=\"${lx}\" y=\"${ly}\" fill=\"${p.color}\" font-size=\"11\" font-weight=\"600\">(${fmt(p.x)}, ${fmt(p.y)})</text>`;\n  });\n\n  svgEl.innerHTML=svg;\n\n  // Legend\n  if(activeFns.length>0){\n    LEGEND.classList.remove('hidden');\n    LEGEND.innerHTML=activeFns.map((f,i)=>`\n      <div style=\"display:flex;align-items:center;gap:6px;\">\n        <svg width=\"22\" height=\"8\"><line x1=\"0\" y1=\"4\" x2=\"22\" y2=\"4\" stroke=\"${f.color}\" stroke-width=\"2.2\" stroke-linecap=\"round\"/></svg>\n        <span style=\"color:${f.color};font-weight:700;\">f${i+1}(x)</span>\n        <span style=\"color:#374151;font-family:monospace;font-size:11px;\"> = ${f.expr}</span>\n      </div>\n    `).join('');\n  } else {\n    LEGEND.classList.add('hidden');\n  }\n}\n\n/* =========================================================\n   MOUSE / TOUCH: drag to pan\n   ========================================================= */\n(function(){\n  let dragging=false, startPx=0, startPy=0, startVP=null;\n  GRAPH_SVG.addEventListener('mousedown',e=>{\n    dragging=true;\n    startPx=e.clientX; startPy=e.clientY;\n    startVP={...viewport};\n    e.preventDefault();\n  });\n  window.addEventListener('mousemove',e=>{\n    if(!dragging) return;\n    const W=GRAPH_SVG.clientWidth||600;\n    const H=GRAPH_SVG.clientHeight||480;\n    const PAD={top:20,right:20,bottom:36,left:44};\n    const gW=W-PAD.left-PAD.right;\n    const gH=H-PAD.top-PAD.bottom;\n    const dx=(e.clientX-startPx)/gW*(startVP.xmax-startVP.xmin);\n    const dy=(e.clientY-startPy)/gH*(startVP.ymax-startVP.ymin);\n    viewport.xmin=startVP.xmin-dx;\n    viewport.xmax=startVP.xmax-dx;\n    viewport.ymin=startVP.ymin+dy;\n    viewport.ymax=startVP.ymax+dy;\n    writeViewport();\n    drawGraph();\n  });\n  window.addEventListener('mouseup',()=>{ dragging=false; });\n\n  // Wheel zoom\n  GRAPH_SVG.addEventListener('wheel',e=>{\n    e.preventDefault();\n    readViewport();\n    const rect=GRAPH_SVG.getBoundingClientRect();\n    const W=GRAPH_SVG.clientWidth||600;\n    const H=GRAPH_SVG.clientHeight||480;\n    const PAD={top:20,right:20,bottom:36,left:44};\n    const gW=W-PAD.left-PAD.right;\n    const gH=H-PAD.top-PAD.bottom;\n    const mx=(e.clientX-rect.left-PAD.left)/gW*(viewport.xmax-viewport.xmin)+viewport.xmin;\n    const my=viewport.ymax-(e.clientY-rect.top-PAD.top)/gH*(viewport.ymax-viewport.ymin);\n    const factor=e.deltaY>0?1.15:0.87;\n    viewport.xmin=mx+(viewport.xmin-mx)*factor;\n    viewport.xmax=mx+(viewport.xmax-mx)*factor;\n    viewport.ymin=my+(viewport.ymin-my)*factor;\n    viewport.ymax=my+(viewport.ymax-my)*factor;\n    writeViewport();\n    drawGraph();\n  },{passive:false});\n})();\n\n/* =========================================================\n   RESIZE observer\n   ========================================================= */\nif(window.ResizeObserver){\n  new ResizeObserver(()=>{ drawGraph(); }).observe(GRAPH_SVG.parentElement);\n}\n\n/* =========================================================\n   INIT\n   ========================================================= */\nrebuildFuncList();\nwriteViewport();\ncompileAndPlot();\n</script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Digital graftegner",
    "windowTitle": "Digital graftegner",
    "bundleId": "com.halisonworks.graftegner",
    "iconPath": null
  },
  "categoryId": null,
  "source": "import",
  "createdAt": "2026-06-02T12:00:00.000Z",
  "updatedAt": "2026-06-02T12:00:00.000Z",
  "sharedAt": "2026-06-02T12:00:00.000Z"
}
