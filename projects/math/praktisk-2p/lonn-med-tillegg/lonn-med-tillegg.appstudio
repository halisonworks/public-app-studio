{
  "schema": "app-studio/canvas@1",
  "id": "example-prak-lonn-med-tillegg",
  "name": "lonn-med-tillegg.html",
  "code": "<!DOCTYPE html>\n<!--\n  Lønn med tillegg — Halison App Studio-eksempel\n\n  Praktisk matematikk for 2P (LK20): regn ut lønn med overtid og kvelds-/\n  helgetillegg — fra timelønn til bruttolønn (og evt. nettolønn).\n\n  Fra Halison App Studio sitt offentlige bibliotek:\n  https://github.com/halisonworks/public-app-studio\n\n  Tillatt bruk: personlig, pedagogisk og annen ikke-kommersiell bruk. Behold denne\n  headeren og kildelenken; ikke-kommersiell bruk. Utgitt under Halison App Studio\n  Examples License — se LICENSE-filen i repoet over.\n-->\n<html lang=\"no\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Lønn med tillegg – 2P praktisk matematikk</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    .calc-box {\n      background: #f8fafc;\n      border-left: 4px solid #3b82f6;\n      font-family: 'Courier New', monospace;\n    }\n    .result-row {\n      border-bottom: 1px solid #e2e8f0;\n    }\n    .result-row:last-child {\n      border-bottom: none;\n    }\n    input[type=number]::-webkit-inner-spin-button,\n    input[type=number]::-webkit-outer-spin-button {\n      opacity: 1;\n    }\n    .tooltip {\n      position: relative;\n      cursor: help;\n    }\n    .tooltip:hover::after {\n      content: attr(data-tip);\n      position: absolute;\n      bottom: 125%;\n      left: 50%;\n      transform: translateX(-50%);\n      background: #1e293b;\n      color: #f1f5f9;\n      padding: 0.4rem 0.7rem;\n      border-radius: 6px;\n      font-size: 0.78rem;\n      white-space: nowrap;\n      z-index: 10;\n      pointer-events: none;\n    }\n  </style>\n</head>\n<body class=\"bg-gradient-to-br from-slate-100 to-blue-50 min-h-screen py-8 px-4\">\n\n  <div class=\"max-w-2xl mx-auto\">\n\n    <!-- Header -->\n    <div class=\"mb-6 text-center\">\n      <span class=\"inline-block bg-blue-100 text-blue-800 text-xs font-semibold px-3 py-1 rounded-full mb-2 tracking-wide uppercase\">2P · Praktisk matematikk · LK20</span>\n      <h1 class=\"text-3xl font-bold text-slate-800 mb-1\">Lønn med tillegg</h1>\n      <p class=\"text-slate-500 text-sm\">Regn ut bruttolønn og nettolønn med overtid og kvelds-/helgetillegg</p>\n    </div>\n\n    <!-- Form card -->\n    <div class=\"bg-white rounded-2xl shadow-md p-6 mb-6\">\n\n      <!-- Grunnlønn -->\n      <h2 class=\"text-base font-semibold text-slate-700 mb-4 border-b pb-2\">Grunnlønn</h2>\n      <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6\">\n\n        <div>\n          <label class=\"block text-sm font-medium text-slate-600 mb-1\" for=\"timelonn\">\n            Timelønn <span class=\"text-slate-400 font-normal\">(kr/time)</span>\n          </label>\n          <input\n            id=\"timelonn\"\n            type=\"number\"\n            min=\"0\"\n            step=\"0.01\"\n            placeholder=\"f.eks. 195,00\"\n            class=\"w-full border border-slate-300 rounded-lg px-3 py-2 text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-400 text-sm\"\n          />\n          <p class=\"text-xs text-slate-400 mt-1\">Tariff minstesats handel: ~210 kr (2024)</p>\n        </div>\n\n        <div>\n          <label class=\"block text-sm font-medium text-slate-600 mb-1\" for=\"vanligeTimer\">\n            Antall vanlige timer\n          </label>\n          <input\n            id=\"vanligeTimer\"\n            type=\"number\"\n            min=\"0\"\n            step=\"0.5\"\n            placeholder=\"f.eks. 37,5\"\n            class=\"w-full border border-slate-300 rounded-lg px-3 py-2 text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-400 text-sm\"\n          />\n          <p class=\"text-xs text-slate-400 mt-1\">Full uke = 37,5 timer (LO-standard)</p>\n        </div>\n      </div>\n\n      <!-- Overtid -->\n      <h2 class=\"text-base font-semibold text-slate-700 mb-4 border-b pb-2\">Overtid</h2>\n      <div class=\"grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6\">\n\n        <div>\n          <label class=\"block text-sm font-medium text-slate-600 mb-1\" for=\"overtidTimer\">\n            Overtidstimer\n          </label>\n          <input\n            id=\"overtidTimer\"\n            type=\"number\"\n            min=\"0\"\n            step=\"0.5\"\n            placeholder=\"f.eks. 4\"\n            class=\"w-full border border-slate-300 rounded-lg px-3 py-2 text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-400 text-sm\"\n          />\n        </div>\n\n        <div>\n          <label class=\"block text-sm font-medium text-slate-600 mb-1 tooltip\" data-tip=\"Tillegg i prosent oppå timelønnen\">\n            Overtidssats <span class=\"text-slate-400 font-normal\">(%)</span> ℹ\n          </label>\n          <input\n            id=\"overtidSats\"\n            type=\"number\"\n            min=\"0\"\n            step=\"5\"\n            placeholder=\"f.eks. 50\"\n            class=\"w-full border border-slate-300 rounded-lg px-3 py-2 text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-400 text-sm\"\n          />\n          <p class=\"text-xs text-slate-400 mt-1\">Vanlig 50 %, noen steder 100 %</p>\n        </div>\n\n        <div class=\"flex items-end\">\n          <div class=\"bg-amber-50 border border-amber-200 rounded-lg p-3 w-full text-xs text-amber-800 leading-snug\">\n            <strong>Formel:</strong><br />\n            timelønn × (1 + sats/100) × overtidstimer\n          </div>\n        </div>\n      </div>\n\n      <!-- Kvelds-/helgetillegg -->\n      <h2 class=\"text-base font-semibold text-slate-700 mb-1 border-b pb-2\">\n        Kvelds-/helgetillegg\n        <span class=\"text-slate-400 font-normal text-sm\">(valgfritt)</span>\n      </h2>\n      <p class=\"text-xs text-slate-400 mb-4\">Legg inn enten kr/time <em>eller</em> prosent — ikke begge.</p>\n\n      <div class=\"grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6\">\n\n        <div>\n          <label class=\"block text-sm font-medium text-slate-600 mb-1\" for=\"tilleggTimer\">\n            Timer med tillegg\n          </label>\n          <input\n            id=\"tilleggTimer\"\n            type=\"number\"\n            min=\"0\"\n            step=\"0.5\"\n            placeholder=\"f.eks. 8\"\n            class=\"w-full border border-slate-300 rounded-lg px-3 py-2 text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-400 text-sm\"\n          />\n        </div>\n\n        <div>\n          <label class=\"block text-sm font-medium text-slate-600 mb-1\" for=\"tilleggKr\">\n            Tillegg i kr/time\n          </label>\n          <input\n            id=\"tilleggKr\"\n            type=\"number\"\n            min=\"0\"\n            step=\"0.5\"\n            placeholder=\"f.eks. 26\"\n            class=\"w-full border border-slate-300 rounded-lg px-3 py-2 text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-400 text-sm\"\n          />\n          <p class=\"text-xs text-slate-400 mt-1\">Typisk kveldstillegg handel: ~26 kr</p>\n        </div>\n\n        <div>\n          <label class=\"block text-sm font-medium text-slate-600 mb-1 tooltip\" data-tip=\"Prosent av timelønnen som ekstra tillegg\">\n            Tillegg i % av timelønn ℹ\n          </label>\n          <input\n            id=\"tilleggProsent\"\n            type=\"number\"\n            min=\"0\"\n            step=\"1\"\n            placeholder=\"f.eks. 20\"\n            class=\"w-full border border-slate-300 rounded-lg px-3 py-2 text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-400 text-sm\"\n          />\n          <p class=\"text-xs text-slate-400 mt-1\">Helgetillegg typisk 20–40 %</p>\n        </div>\n      </div>\n\n      <!-- Skatt (valgfritt) -->\n      <h2 class=\"text-base font-semibold text-slate-700 mb-4 border-b pb-2\">\n        Skattetrekk\n        <span class=\"text-slate-400 font-normal text-sm\">(valgfritt)</span>\n      </h2>\n      <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6\">\n\n        <div>\n          <label class=\"block text-sm font-medium text-slate-600 mb-1 tooltip\" data-tip=\"Trekkprosenten fra skattekortet ditt\">\n            Trekkprosent (%) ℹ\n          </label>\n          <input\n            id=\"trekkprosent\"\n            type=\"number\"\n            min=\"0\"\n            max=\"100\"\n            step=\"0.5\"\n            placeholder=\"f.eks. 25\"\n            class=\"w-full border border-slate-300 rounded-lg px-3 py-2 text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-400 text-sm\"\n          />\n          <p class=\"text-xs text-slate-400 mt-1\">Unge/deltid: ofte 15–25 % (skattekortet)</p>\n        </div>\n\n        <div class=\"flex items-end\">\n          <div class=\"bg-green-50 border border-green-200 rounded-lg p-3 w-full text-xs text-green-800 leading-snug\">\n            <strong>Nettolønn:</strong><br />\n            bruttolønn × (1 − trekk/100)\n          </div>\n        </div>\n      </div>\n\n      <!-- Beregn-knapp -->\n      <button\n        id=\"beregnBtn\"\n        onclick=\"beregn()\"\n        class=\"w-full bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white font-semibold py-3 rounded-xl transition-colors text-base shadow\"\n      >\n        Beregn lønn\n      </button>\n\n      <!-- Feilmelding -->\n      <p id=\"feilmelding\" class=\"text-red-600 text-sm mt-3 hidden\"></p>\n    </div>\n\n    <!-- Resultat-kort -->\n    <div id=\"resultatKort\" class=\"hidden bg-white rounded-2xl shadow-md p-6 mb-6\">\n\n      <h2 class=\"text-lg font-bold text-slate-800 mb-4\">Lønnsberegning</h2>\n\n      <!-- Utregning steg for steg -->\n      <div id=\"utregning\" class=\"calc-box rounded-xl p-4 mb-5 text-sm leading-7 text-slate-700 space-y-1\"></div>\n\n      <!-- Oppsummering -->\n      <div id=\"oppsummering\" class=\"divide-y divide-slate-100 text-sm\"></div>\n\n      <!-- Nettolønn (vises kun om trekkprosent er fylt inn) -->\n      <div id=\"nettoSeksjon\" class=\"hidden mt-4 bg-green-50 border border-green-200 rounded-xl p-4\">\n        <div class=\"flex justify-between items-center\">\n          <span class=\"text-green-800 font-semibold text-base\">Nettolønn (etter skatt)</span>\n          <span id=\"nettoLonn\" class=\"text-green-800 font-bold text-xl\"></span>\n        </div>\n        <p id=\"nettoForklaring\" class=\"text-xs text-green-700 mt-1\"></p>\n      </div>\n\n      <!-- Fordeling visuell -->\n      <div id=\"fordelingContainer\" class=\"mt-5\">\n        <p class=\"text-xs font-semibold text-slate-500 uppercase tracking-wide mb-2\">Fordeling av bruttolønn</p>\n        <div id=\"fordelingBar\" class=\"flex rounded-full overflow-hidden h-6 w-full\"></div>\n        <div id=\"fordelingLegend\" class=\"flex flex-wrap gap-x-4 gap-y-1 mt-2 text-xs text-slate-600\"></div>\n      </div>\n\n      <!-- Nullstill-knapp -->\n      <button\n        onclick=\"nullstill()\"\n        class=\"mt-5 w-full border border-slate-300 hover:border-slate-400 text-slate-600 hover:text-slate-800 font-medium py-2 rounded-xl transition-colors text-sm\"\n      >\n        Nullstill og start på nytt\n      </button>\n    </div>\n\n    <!-- Fagstoff-boks -->\n    <div class=\"bg-white rounded-2xl shadow-sm p-5 mb-6 text-sm text-slate-600\">\n      <h3 class=\"font-semibold text-slate-700 mb-2\">Fagstoff – 2P</h3>\n      <ul class=\"list-disc list-inside space-y-1 leading-relaxed\">\n        <li><strong>Grunnlønn</strong> = timelønn × antall vanlige timer</li>\n        <li><strong>Overtidsbetaling</strong> = timelønn × (1 + overtidssats/100) × overtidstimer</li>\n        <li><strong>Kvelds-/helgetillegg</strong> (kr/time) = tillegg × timer <em>eller</em> (timelønn × tillegg%/100) × timer</li>\n        <li><strong>Bruttolønn</strong> = grunnlønn + overtidsbetaling + tilleggsbetaling</li>\n        <li><strong>Nettolønn</strong> = bruttolønn × (1 − trekkprosent/100)</li>\n      </ul>\n      <p class=\"mt-3 text-xs text-slate-400\">Kilde: Arbeidsmiljøloven § 10-6 (overtid min. 40 % tillegg), tariffavtaler (NHO/LO 2024).</p>\n    </div>\n\n    <footer class=\"text-center text-xs text-slate-400 pb-4\">\n      Halison App Studio · Praktisk matematikk 2P · Kun til pedagogisk bruk\n    </footer>\n\n  </div>\n\n  <script>\n    (function () {\n      'use strict';\n\n      var LS_KEY = 'lonn_med_tillegg_v1';\n\n      // ---------- Hjelpe-funksjoner ----------\n\n      function krFormat(v) {\n        return v.toLocaleString('nb-NO', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' kr';\n      }\n\n      function prosFormat(v) {\n        return v.toLocaleString('nb-NO', { minimumFractionDigits: 0, maximumFractionDigits: 2 }) + ' %';\n      }\n\n      function timerFormat(v) {\n        return v.toLocaleString('nb-NO', { minimumFractionDigits: 0, maximumFractionDigits: 1 }) + ' t';\n      }\n\n      function getVal(id) {\n        var el = document.getElementById(id);\n        var v = parseFloat(el.value.replace(',', '.'));\n        return isNaN(v) ? 0 : v;\n      }\n\n      function getRaw(id) {\n        var el = document.getElementById(id);\n        return el.value.trim();\n      }\n\n      // ---------- Lagre / gjenopprett ----------\n\n      function lagreInputs() {\n        var ids = ['timelonn', 'vanligeTimer', 'overtidTimer', 'overtidSats',\n                   'tilleggTimer', 'tilleggKr', 'tilleggProsent', 'trekkprosent'];\n        var data = {};\n        ids.forEach(function (id) { data[id] = document.getElementById(id).value; });\n        try { localStorage.setItem(LS_KEY, JSON.stringify(data)); } catch (e) {}\n      }\n\n      function gjenopprettInputs() {\n        try {\n          var raw = localStorage.getItem(LS_KEY);\n          if (!raw) return;\n          var data = JSON.parse(raw);\n          Object.keys(data).forEach(function (id) {\n            var el = document.getElementById(id);\n            if (el && data[id]) el.value = data[id];\n          });\n        } catch (e) {}\n      }\n\n      // Bind lagring til alle input-felter\n      ['timelonn', 'vanligeTimer', 'overtidTimer', 'overtidSats',\n       'tilleggTimer', 'tilleggKr', 'tilleggProsent', 'trekkprosent'].forEach(function (id) {\n        var el = document.getElementById(id);\n        if (el) el.addEventListener('input', lagreInputs);\n      });\n\n      gjenopprettInputs();\n\n      // ---------- Beregning ----------\n\n      window.beregn = function () {\n        var feil = document.getElementById('feilmelding');\n        feil.classList.add('hidden');\n        feil.textContent = '';\n\n        var timelonn     = getVal('timelonn');\n        var vanligeTimer = getVal('vanligeTimer');\n        var overtidTimer = getVal('overtidTimer');\n        var overtidSats  = getVal('overtidSats');\n        var tilleggTimer = getVal('tilleggTimer');\n        var tilleggKrRaw = getRaw('tilleggKr');\n        var tilleggProRaw = getRaw('tilleggProsent');\n        var trekkRaw     = getRaw('trekkprosent');\n\n        // Valider\n        if (timelonn <= 0) {\n          feil.textContent = 'Fyll inn timelønn (større enn 0).';\n          feil.classList.remove('hidden');\n          return;\n        }\n        if (vanligeTimer < 0) {\n          feil.textContent = 'Antall vanlige timer kan ikke være negativt.';\n          feil.classList.remove('hidden');\n          return;\n        }\n        if (tilleggKrRaw !== '' && tilleggProRaw !== '') {\n          feil.textContent = 'Fyll inn enten kr/time eller prosent for tillegg — ikke begge.';\n          feil.classList.remove('hidden');\n          return;\n        }\n\n        var tilleggKr  = tilleggKrRaw  !== '' ? parseFloat(tilleggKrRaw.replace(',', '.'))  : 0;\n        var tilleggPro = tilleggProRaw !== '' ? parseFloat(tilleggProRaw.replace(',', '.')) : 0;\n        var trekk      = trekkRaw      !== '' ? parseFloat(trekkRaw.replace(',', '.'))      : NaN;\n\n        if (tilleggKrRaw !== '' && isNaN(tilleggKr))   { feil.textContent = 'Ugyldig verdi i «tillegg kr/time».'; feil.classList.remove('hidden'); return; }\n        if (tilleggProRaw !== '' && isNaN(tilleggPro)) { feil.textContent = 'Ugyldig verdi i «tillegg %».';      feil.classList.remove('hidden'); return; }\n        if (trekkRaw !== '' && (isNaN(trekk) || trekk < 0 || trekk > 100)) {\n          feil.textContent = 'Trekkprosent må være mellom 0 og 100.';\n          feil.classList.remove('hidden');\n          return;\n        }\n\n        // Beregninger\n        var grunnlonn     = timelonn * vanligeTimer;\n        var overtidFaktor = 1 + overtidSats / 100;\n        var overtidBetal  = timelonn * overtidFaktor * overtidTimer;\n\n        var tilleggBetal = 0;\n        var tilleggType  = '';\n        if (tilleggTimer > 0) {\n          if (tilleggKrRaw !== '') {\n            tilleggBetal = tilleggKr * tilleggTimer;\n            tilleggType  = 'kr';\n          } else if (tilleggProRaw !== '') {\n            tilleggBetal = (timelonn * tilleggPro / 100) * tilleggTimer;\n            tilleggType  = 'prosent';\n          }\n        }\n\n        var bruttolonn = grunnlonn + overtidBetal + tilleggBetal;\n        var nettolonn  = isNaN(trekk) ? NaN : bruttolonn * (1 - trekk / 100);\n\n        // ---------- Vis utregning ----------\n\n        var utregningEl = document.getElementById('utregning');\n        var linjer = [];\n\n        linjer.push('<span class=\"text-slate-400\">// Grunnlønn</span>');\n        linjer.push(\n          'Grunnlønn = ' + krFormat(timelonn) + ' × ' + timerFormat(vanligeTimer) +\n          ' = <strong>' + krFormat(grunnlonn) + '</strong>'\n        );\n\n        if (overtidTimer > 0) {\n          linjer.push('');\n          linjer.push('<span class=\"text-slate-400\">// Overtidsbetaling</span>');\n          linjer.push(\n            'Overtidsfaktor = 1 + ' + prosFormat(overtidSats) + '/100 = ' + overtidFaktor.toLocaleString('nb-NO', {maximumFractionDigits: 4})\n          );\n          linjer.push(\n            'Overtidsbetaling = ' + krFormat(timelonn) + ' × ' + overtidFaktor.toLocaleString('nb-NO', {maximumFractionDigits: 4}) +\n            ' × ' + timerFormat(overtidTimer) +\n            ' = <strong>' + krFormat(overtidBetal) + '</strong>'\n          );\n        }\n\n        if (tilleggTimer > 0 && tilleggBetal > 0) {\n          linjer.push('');\n          linjer.push('<span class=\"text-slate-400\">// Kvelds-/helgetillegg</span>');\n          if (tilleggType === 'kr') {\n            linjer.push(\n              'Tilleggsbetaling = ' + krFormat(tilleggKr) + '/t × ' + timerFormat(tilleggTimer) +\n              ' = <strong>' + krFormat(tilleggBetal) + '</strong>'\n            );\n          } else {\n            linjer.push(\n              'Tillegg pr. time = ' + krFormat(timelonn) + ' × ' + prosFormat(tilleggPro) + '/100 = ' + krFormat(timelonn * tilleggPro / 100)\n            );\n            linjer.push(\n              'Tilleggsbetaling = ' + krFormat(timelonn * tilleggPro / 100) + ' × ' + timerFormat(tilleggTimer) +\n              ' = <strong>' + krFormat(tilleggBetal) + '</strong>'\n            );\n          }\n        }\n\n        linjer.push('');\n        linjer.push('<span class=\"text-slate-400\">// Bruttolønn</span>');\n        var bruttoLedd = [krFormat(grunnlonn)];\n        if (overtidBetal > 0) bruttoLedd.push(krFormat(overtidBetal));\n        if (tilleggBetal > 0) bruttoLedd.push(krFormat(tilleggBetal));\n        linjer.push('Bruttolønn = ' + bruttoLedd.join(' + ') + ' = <strong class=\"text-blue-700\">' + krFormat(bruttolonn) + '</strong>');\n\n        if (!isNaN(nettolonn)) {\n          linjer.push('');\n          linjer.push('<span class=\"text-slate-400\">// Nettolønn etter skatt</span>');\n          linjer.push(\n            'Nettolønn = ' + krFormat(bruttolonn) + ' × (1 − ' + prosFormat(trekk) + '/100)' +\n            ' = <strong class=\"text-green-700\">' + krFormat(nettolonn) + '</strong>'\n          );\n        }\n\n        utregningEl.innerHTML = linjer.join('<br />');\n\n        // ---------- Oppsummering ----------\n\n        var opps = document.getElementById('oppsummering');\n        var rader = [\n          { label: 'Grunnlønn (' + timerFormat(vanligeTimer) + ' × ' + krFormat(timelonn) + ')',\n            verdi: grunnlonn, farge: 'text-slate-700' }\n        ];\n        if (overtidTimer > 0) {\n          rader.push({\n            label: 'Overtidsbetaling (' + timerFormat(overtidTimer) + ', ' + prosFormat(overtidSats) + ' tillegg)',\n            verdi: overtidBetal, farge: 'text-orange-600'\n          });\n        }\n        if (tilleggBetal > 0) {\n          var tLabel = tilleggType === 'kr'\n            ? 'Kvelds-/helgetillegg (' + timerFormat(tilleggTimer) + ' × ' + krFormat(tilleggKr) + ')'\n            : 'Kvelds-/helgetillegg (' + timerFormat(tilleggTimer) + ', ' + prosFormat(tilleggPro) + ')';\n          rader.push({ label: tLabel, verdi: tilleggBetal, farge: 'text-purple-600' });\n        }\n        rader.push({ label: 'Bruttolønn', verdi: bruttolonn, farge: 'text-blue-700 font-bold', stor: true });\n\n        opps.innerHTML = rader.map(function (r) {\n          return '<div class=\"result-row flex justify-between py-2 ' + (r.stor ? 'pt-3' : '') + '\">' +\n            '<span class=\"' + r.farge + (r.stor ? ' text-base' : '') + '\">' + r.label + '</span>' +\n            '<span class=\"' + r.farge + (r.stor ? ' text-base' : '') + '\">' + krFormat(r.verdi) + '</span>' +\n            '</div>';\n        }).join('');\n\n        // ---------- Nettolønn ----------\n\n        var nettoSek  = document.getElementById('nettoSeksjon');\n        var nettoEl   = document.getElementById('nettoLonn');\n        var nettoFork = document.getElementById('nettoForklaring');\n        if (!isNaN(nettolonn)) {\n          nettoEl.textContent  = krFormat(nettolonn);\n          nettoFork.textContent = krFormat(bruttolonn) + ' × (1 − ' + trekk + '/100) = ' + krFormat(nettolonn);\n          nettoSek.classList.remove('hidden');\n        } else {\n          nettoSek.classList.add('hidden');\n        }\n\n        // ---------- Fordeling ----------\n\n        var del = document.getElementById('fordelingBar');\n        var leg = document.getElementById('fordelingLegend');\n\n        var segmenter = [\n          { label: 'Grunnlønn', verdi: grunnlonn, farge: 'bg-blue-500' },\n        ];\n        if (overtidBetal > 0) segmenter.push({ label: 'Overtid', verdi: overtidBetal, farge: 'bg-orange-400' });\n        if (tilleggBetal > 0) segmenter.push({ label: 'Tillegg', verdi: tilleggBetal, farge: 'bg-purple-400' });\n\n        del.innerHTML = segmenter.map(function (s) {\n          var pct = bruttolonn > 0 ? (s.verdi / bruttolonn * 100).toFixed(1) : 0;\n          return '<div class=\"' + s.farge + ' h-full\" style=\"width:' + pct + '%\" title=\"' + s.label + ': ' + krFormat(s.verdi) + '\"></div>';\n        }).join('');\n\n        leg.innerHTML = segmenter.map(function (s) {\n          var pct = bruttolonn > 0 ? (s.verdi / bruttolonn * 100).toFixed(1) : 0;\n          var dot = s.farge.replace('bg-', 'background:').replace('-500', '').replace('-400', '');\n          // fallback: use a colored span via class\n          return '<span class=\"flex items-center gap-1\">' +\n            '<span class=\"inline-block w-3 h-3 rounded-sm ' + s.farge + '\"></span>' +\n            s.label + ' (' + pct + '%)</span>';\n        }).join('');\n\n        // Vis kortet\n        document.getElementById('resultatKort').classList.remove('hidden');\n        document.getElementById('resultatKort').scrollIntoView({ behavior: 'smooth', block: 'start' });\n      };\n\n      // ---------- Nullstill ----------\n\n      window.nullstill = function () {\n        ['timelonn', 'vanligeTimer', 'overtidTimer', 'overtidSats',\n         'tilleggTimer', 'tilleggKr', 'tilleggProsent', 'trekkprosent'].forEach(function (id) {\n          var el = document.getElementById(id);\n          if (el) el.value = '';\n        });\n        document.getElementById('resultatKort').classList.add('hidden');\n        document.getElementById('feilmelding').classList.add('hidden');\n        try { localStorage.removeItem(LS_KEY); } catch (e) {}\n        window.scrollTo({ top: 0, behavior: 'smooth' });\n      };\n\n      // Enter-tast trigger beregning\n      document.addEventListener('keydown', function (e) {\n        if (e.key === 'Enter') { window.beregn(); }\n      });\n\n    }());\n  </script>\n\n</body>\n</html>\n",
