{
  "schema": "app-studio/canvas@1",
  "id": "example-prak-rabatt-og-tilbud",
  "name": "rabatt-og-tilbud.html",
  "code": "<!DOCTYPE html>\n<!--\n  Rabatt og tilbud — Halison App Studio-eksempel\n\n  Praktisk matematikk for 2P (LK20): regn ut rabatt og ny pris, sammenlikn\n  mengdetilbud, og se hvorfor flere rabatter ikke bare legges sammen.\n\n  Fra Halison App Studio sitt offentlige bibliotek:\n  https://github.com/halisonworks/public-app-studio\n\n  Tillatt bruk: personlig, pedagogisk og annen ikke-kommersiell bruk. Behold denne\n  headeren og kildelenken; ikke-kommersiell bruk. Utgitt under Halison App Studio\n  Examples License — se LICENSE-filen i repoet over.\n-->\n<html lang=\"no\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Rabatt og tilbud — Matematikk 2P</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    /* Custom styles */\n    .tab-btn.active {\n      background-color: #1d4ed8;\n      color: #ffffff;\n    }\n    .result-box {\n      transition: all 0.2s ease;\n    }\n    .fade-in {\n      animation: fadeIn 0.3s ease-in;\n    }\n    @keyframes fadeIn {\n      from { opacity: 0; transform: translateY(6px); }\n      to   { opacity: 1; transform: translateY(0); }\n    }\n    .step-line {\n      border-left: 3px solid #93c5fd;\n      padding-left: 0.75rem;\n      margin-left: 0.25rem;\n    }\n    input[type=\"number\"]::-webkit-inner-spin-button,\n    input[type=\"number\"]::-webkit-outer-spin-button {\n      opacity: 1;\n    }\n  </style>\n</head>\n<body class=\"bg-gray-50 min-h-screen font-sans text-gray-800\">\n\n  <!-- Header -->\n  <header class=\"bg-blue-700 text-white shadow-md\">\n    <div class=\"max-w-3xl mx-auto px-4 py-5\">\n      <p class=\"text-xs font-semibold uppercase tracking-widest text-blue-200 mb-1\">Matematikk 2P · LK20</p>\n      <h1 class=\"text-2xl font-bold leading-tight\">Rabatt og tilbud</h1>\n      <p class=\"text-sm text-blue-100 mt-1\">Er det egentlig et godt tilbud?</p>\n    </div>\n  </header>\n\n  <!-- Tab navigation -->\n  <nav class=\"bg-white border-b border-gray-200 sticky top-0 z-10 shadow-sm\">\n    <div class=\"max-w-3xl mx-auto px-4 flex gap-1 py-2 overflow-x-auto\">\n      <button class=\"tab-btn active whitespace-nowrap px-4 py-2 rounded-md text-sm font-medium text-gray-600 hover:bg-blue-50 transition\" onclick=\"showTab('prosent')\">1 · Prosentavslag</button>\n      <button class=\"tab-btn whitespace-nowrap px-4 py-2 rounded-md text-sm font-medium text-gray-600 hover:bg-blue-50 transition\" onclick=\"showTab('mengde')\">2 · Mengdetilbud</button>\n      <button class=\"tab-btn whitespace-nowrap px-4 py-2 rounded-md text-sm font-medium text-gray-600 hover:bg-blue-50 transition\" onclick=\"showTab('kjede')\">3 · Flere rabatter etter hverandre</button>\n    </div>\n  </nav>\n\n  <main class=\"max-w-3xl mx-auto px-4 py-8 space-y-8\">\n\n    <!-- ============================================================\n         TAB 1: Prosentavslag\n    ============================================================ -->\n    <section id=\"tab-prosent\" class=\"tab-content space-y-6\">\n\n      <div class=\"bg-white rounded-xl shadow-sm border border-gray-100 p-6\">\n        <h2 class=\"text-lg font-semibold text-blue-800 mb-1\">Prosentavslag</h2>\n        <p class=\"text-sm text-gray-500 mb-4\">Oppgi ordinær pris og rabatt — eller fyll inn før- og etterpris for å finne prosenten.</p>\n\n        <!-- Mode toggle -->\n        <div class=\"flex gap-2 mb-5\">\n          <button id=\"mode-btn-a\" onclick=\"setProsentMode('a')\"\n            class=\"px-3 py-1.5 rounded-full text-xs font-semibold border border-blue-300 bg-blue-600 text-white transition\">\n            Pris + prosent → ny pris\n          </button>\n          <button id=\"mode-btn-b\" onclick=\"setProsentMode('b')\"\n            class=\"px-3 py-1.5 rounded-full text-xs font-semibold border border-gray-300 bg-white text-gray-600 hover:bg-gray-50 transition\">\n            Før- og etterpris → prosent\n          </button>\n        </div>\n\n        <!-- Mode A -->\n        <div id=\"prosent-mode-a\" class=\"space-y-4\">\n          <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n            <div>\n              <label class=\"block text-sm font-medium text-gray-700 mb-1\">Ordinær pris (kr)</label>\n              <input id=\"p-pris\" type=\"number\" min=\"0\" step=\"1\" value=\"499\"\n                class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n            </div>\n            <div>\n              <label class=\"block text-sm font-medium text-gray-700 mb-1\">Rabatt (%)</label>\n              <input id=\"p-prosent\" type=\"number\" min=\"0\" max=\"100\" step=\"1\" value=\"20\"\n                class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n            </div>\n          </div>\n          <button onclick=\"beregnProsent()\" class=\"w-full sm:w-auto bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-6 py-2.5 rounded-lg transition\">Beregn</button>\n          <div id=\"prosent-result-a\" class=\"result-box\"></div>\n        </div>\n\n        <!-- Mode B -->\n        <div id=\"prosent-mode-b\" class=\"hidden space-y-4\">\n          <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n            <div>\n              <label class=\"block text-sm font-medium text-gray-700 mb-1\">Ordinær pris / førpris (kr)</label>\n              <input id=\"p-for\" type=\"number\" min=\"0\" step=\"1\" value=\"499\"\n                class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n            </div>\n            <div>\n              <label class=\"block text-sm font-medium text-gray-700 mb-1\">Tilbudspris / etterpris (kr)</label>\n              <input id=\"p-etter\" type=\"number\" min=\"0\" step=\"1\" value=\"399\"\n                class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n            </div>\n          </div>\n          <button onclick=\"beregnProsentB()\" class=\"w-full sm:w-auto bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-6 py-2.5 rounded-lg transition\">Beregn</button>\n          <div id=\"prosent-result-b\" class=\"result-box\"></div>\n        </div>\n      </div>\n\n      <!-- Eksempler -->\n      <div class=\"bg-blue-50 rounded-xl border border-blue-100 p-5\">\n        <h3 class=\"text-sm font-semibold text-blue-800 mb-3\">Prøv et kjent eksempel</h3>\n        <div class=\"flex flex-wrap gap-2\">\n          <button onclick=\"loadExample('sportsgenser')\" class=\"example-chip px-3 py-1.5 bg-white border border-blue-200 rounded-full text-xs text-blue-700 hover:bg-blue-100 transition\">Sportsgenser 699 kr, −30 %</button>\n          <button onclick=\"loadExample('joggesko')\" class=\"example-chip px-3 py-1.5 bg-white border border-blue-200 rounded-full text-xs text-blue-700 hover:bg-blue-100 transition\">Joggesko 1 299 kr, −40 %</button>\n          <button onclick=\"loadExample('mobil')\" class=\"example-chip px-3 py-1.5 bg-white border border-blue-200 rounded-full text-xs text-blue-700 hover:bg-blue-100 transition\">Mobil 8 490 kr → 6 990 kr</button>\n        </div>\n      </div>\n\n    </section>\n\n    <!-- ============================================================\n         TAB 2: Mengdetilbud\n    ============================================================ -->\n    <section id=\"tab-mengde\" class=\"tab-content hidden space-y-6\">\n\n      <div class=\"bg-white rounded-xl shadow-sm border border-gray-100 p-6\">\n        <h2 class=\"text-lg font-semibold text-blue-800 mb-1\">Sammenlikn mengdetilbud</h2>\n        <p class=\"text-sm text-gray-500 mb-4\">Legg inn opptil tre tilbud. Kalkulatoren regner ut effektiv enhetspris og kårer vinneren.</p>\n\n        <div class=\"space-y-4\">\n\n          <!-- Tilbud 1 -->\n          <div class=\"border border-gray-200 rounded-lg p-4 space-y-3\">\n            <div class=\"flex items-center gap-2\">\n              <span class=\"w-5 h-5 rounded-full bg-blue-600 text-white text-xs flex items-center justify-center font-bold\">A</span>\n              <span class=\"text-sm font-medium text-gray-700\">Tilbud A</span>\n            </div>\n            <div class=\"grid grid-cols-1 sm:grid-cols-3 gap-3\">\n              <div>\n                <label class=\"block text-xs text-gray-500 mb-1\">Type tilbud</label>\n                <select id=\"m-type-a\" onchange=\"updateMengdeType('a')\" class=\"w-full border border-gray-300 rounded-lg px-2 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\">\n                  <option value=\"stykk\">Stykkpris (kr / stk)</option>\n                  <option value=\"pakke\">Pakketilbud (X stk for Y kr)</option>\n                  <option value=\"prosent\">Prosentrabatt (−X %)</option>\n                  <option value=\"3for2\">Ta 3, betal for 2</option>\n                </select>\n              </div>\n              <div id=\"m-input-a\" class=\"sm:col-span-2 grid grid-cols-2 gap-2\"></div>\n            </div>\n          </div>\n\n          <!-- Tilbud 2 -->\n          <div class=\"border border-gray-200 rounded-lg p-4 space-y-3\">\n            <div class=\"flex items-center gap-2\">\n              <span class=\"w-5 h-5 rounded-full bg-emerald-600 text-white text-xs flex items-center justify-center font-bold\">B</span>\n              <span class=\"text-sm font-medium text-gray-700\">Tilbud B</span>\n            </div>\n            <div class=\"grid grid-cols-1 sm:grid-cols-3 gap-3\">\n              <div>\n                <label class=\"block text-xs text-gray-500 mb-1\">Type tilbud</label>\n                <select id=\"m-type-b\" onchange=\"updateMengdeType('b')\" class=\"w-full border border-gray-300 rounded-lg px-2 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\">\n                  <option value=\"stykk\">Stykkpris (kr / stk)</option>\n                  <option value=\"pakke\">Pakketilbud (X stk for Y kr)</option>\n                  <option value=\"prosent\" selected>Prosentrabatt (−X %)</option>\n                  <option value=\"3for2\">Ta 3, betal for 2</option>\n                </select>\n              </div>\n              <div id=\"m-input-b\" class=\"sm:col-span-2 grid grid-cols-2 gap-2\"></div>\n            </div>\n          </div>\n\n          <!-- Tilbud 3 (optional) -->\n          <div id=\"tilbud-c-wrapper\" class=\"border border-dashed border-gray-200 rounded-lg p-4 space-y-3\">\n            <div class=\"flex items-center justify-between\">\n              <div class=\"flex items-center gap-2\">\n                <span class=\"w-5 h-5 rounded-full bg-amber-500 text-white text-xs flex items-center justify-center font-bold\">C</span>\n                <span class=\"text-sm font-medium text-gray-700\">Tilbud C (valgfritt)</span>\n              </div>\n              <button id=\"toggle-c-btn\" onclick=\"toggleTilbudC()\" class=\"text-xs text-blue-600 hover:underline\">+ Legg til</button>\n            </div>\n            <div id=\"tilbud-c-content\" class=\"hidden grid grid-cols-1 sm:grid-cols-3 gap-3\">\n              <div>\n                <label class=\"block text-xs text-gray-500 mb-1\">Type tilbud</label>\n                <select id=\"m-type-c\" onchange=\"updateMengdeType('c')\" class=\"w-full border border-gray-300 rounded-lg px-2 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\">\n                  <option value=\"stykk\">Stykkpris (kr / stk)</option>\n                  <option value=\"pakke\" selected>Pakketilbud (X stk for Y kr)</option>\n                  <option value=\"prosent\">Prosentrabatt (−X %)</option>\n                  <option value=\"3for2\">Ta 3, betal for 2</option>\n                </select>\n              </div>\n              <div id=\"m-input-c\" class=\"sm:col-span-2 grid grid-cols-2 gap-2\"></div>\n            </div>\n          </div>\n\n          <button onclick=\"beregnMengde()\" class=\"w-full sm:w-auto bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-6 py-2.5 rounded-lg transition\">Sammenlikn tilbud</button>\n        </div>\n\n        <div id=\"mengde-result\" class=\"result-box mt-4\"></div>\n      </div>\n\n      <!-- Ferdiglagde eksempler -->\n      <div class=\"bg-blue-50 rounded-xl border border-blue-100 p-5\">\n        <h3 class=\"text-sm font-semibold text-blue-800 mb-3\">Prøv et ferdig eksempel</h3>\n        <div class=\"flex flex-wrap gap-2\">\n          <button onclick=\"loadMengdeExample('cola')\" class=\"px-3 py-1.5 bg-white border border-blue-200 rounded-full text-xs text-blue-700 hover:bg-blue-100 transition\">Brus: 3 for 2 vs. −25 % vs. 18,90 kr/stk</button>\n          <button onclick=\"loadMengdeExample('shampo')\" class=\"px-3 py-1.5 bg-white border border-blue-200 rounded-full text-xs text-blue-700 hover:bg-blue-100 transition\">Shampo: 3-pak 89 kr vs. 32 kr/stk</button>\n        </div>\n      </div>\n\n    </section>\n\n    <!-- ============================================================\n         TAB 3: Kjederabatter\n    ============================================================ -->\n    <section id=\"tab-kjede\" class=\"tab-content hidden space-y-6\">\n\n      <div class=\"bg-white rounded-xl shadow-sm border border-gray-100 p-6\">\n        <h2 class=\"text-lg font-semibold text-blue-800 mb-1\">Flere rabatter etter hverandre</h2>\n        <p class=\"text-sm text-gray-500 mb-4\">Mange tror −20 % og deretter −10 % gir −30 %. Det er feil! Vi bruker <strong>vekstfaktorer</strong> og viser hva den virkelige rabatten blir.</p>\n\n        <div class=\"space-y-4\">\n          <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n            <div>\n              <label class=\"block text-sm font-medium text-gray-700 mb-1\">Utgangspris (kr)</label>\n              <input id=\"k-pris\" type=\"number\" min=\"1\" step=\"1\" value=\"1000\"\n                class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n            </div>\n          </div>\n\n          <div id=\"kjede-rabatter\" class=\"space-y-3\">\n            <!-- Rabatter genereres dynamisk -->\n          </div>\n\n          <div class=\"flex flex-wrap gap-2\">\n            <button onclick=\"addRabatt()\" class=\"text-sm text-blue-600 border border-blue-300 hover:bg-blue-50 px-4 py-2 rounded-lg transition\">+ Legg til en rabatt til</button>\n            <button onclick=\"removeRabatt()\" id=\"remove-rabatt-btn\" class=\"text-sm text-red-500 border border-red-200 hover:bg-red-50 px-4 py-2 rounded-lg transition hidden\">− Fjern siste rabatt</button>\n          </div>\n\n          <button onclick=\"beregnKjede()\" class=\"w-full sm:w-auto bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-6 py-2.5 rounded-lg transition\">Beregn</button>\n          <div id=\"kjede-result\" class=\"result-box\"></div>\n        </div>\n      </div>\n\n      <!-- Ferdiglagde eksempler -->\n      <div class=\"bg-blue-50 rounded-xl border border-blue-100 p-5\">\n        <h3 class=\"text-sm font-semibold text-blue-800 mb-3\">Prøv et ferdig eksempel</h3>\n        <div class=\"flex flex-wrap gap-2\">\n          <button onclick=\"loadKjedeExample('klassiker')\" class=\"px-3 py-1.5 bg-white border border-blue-200 rounded-full text-xs text-blue-700 hover:bg-blue-100 transition\">Sesongrabatt −20 %, deretter lojalitetsrabatt −10 %</button>\n          <button onclick=\"loadKjedeExample('trippel')\" class=\"px-3 py-1.5 bg-white border border-blue-200 rounded-full text-xs text-blue-700 hover:bg-blue-100 transition\">Black Friday: −15 %, −15 %, −15 % (tre ganger)</button>\n          <button onclick=\"loadKjedeExample('retur')\" class=\"px-3 py-1.5 bg-white border border-blue-200 rounded-full text-xs text-blue-700 hover:bg-blue-100 transition\">Elektronikk: −25 % og deretter ekstra −5 %</button>\n        </div>\n      </div>\n\n    </section>\n\n  </main>\n\n  <footer class=\"mt-12 py-6 border-t border-gray-200 bg-white\">\n    <div class=\"max-w-3xl mx-auto px-4 text-xs text-gray-400 text-center space-y-1\">\n      <p>Matematikk 2P (LK20) · Halison App Studio-eksempel</p>\n      <p><a href=\"https://github.com/halisonworks/public-app-studio\" class=\"hover:underline text-blue-400\">github.com/halisonworks/public-app-studio</a></p>\n    </div>\n  </footer>\n\n<script>\n// ================================================================\n// UTILS\n// ================================================================\nfunction fmt(n) {\n  // Format number to Norwegian style: comma as decimal, space as thousands\n  if (isNaN(n)) return '–';\n  return n.toLocaleString('nb-NO', { minimumFractionDigits: 2, maximumFractionDigits: 2 });\n}\n\nfunction fmtPct(n) {\n  if (isNaN(n)) return '–';\n  return n.toLocaleString('nb-NO', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' %';\n}\n\nfunction round2(n) {\n  return Math.round(n * 100) / 100;\n}\n\nfunction resultHtml(content) {\n  return `<div class=\"fade-in mt-4 bg-gray-50 border border-gray-200 rounded-lg p-5 text-sm leading-relaxed space-y-3\">${content}</div>`;\n}\n\nfunction errorHtml(msg) {\n  return `<div class=\"fade-in mt-4 bg-red-50 border border-red-200 rounded-lg p-4 text-sm text-red-700\">${msg}</div>`;\n}\n\n// ================================================================\n// TABS\n// ================================================================\nfunction showTab(name) {\n  document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));\n  document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));\n  document.getElementById('tab-' + name).classList.remove('hidden');\n  event.target.classList.add('active');\n}\n\n// ================================================================\n// TAB 1: PROSENTAVSLAG\n// ================================================================\nlet prosentMode = 'a';\n\nfunction setProsentMode(mode) {\n  prosentMode = mode;\n  document.getElementById('prosent-mode-a').classList.toggle('hidden', mode !== 'a');\n  document.getElementById('prosent-mode-b').classList.toggle('hidden', mode !== 'b');\n\n  const btnA = document.getElementById('mode-btn-a');\n  const btnB = document.getElementById('mode-btn-b');\n  if (mode === 'a') {\n    btnA.classList.remove('bg-white', 'text-gray-600', 'border-gray-300');\n    btnA.classList.add('bg-blue-600', 'text-white', 'border-blue-300');\n    btnB.classList.remove('bg-blue-600', 'text-white', 'border-blue-300');\n    btnB.classList.add('bg-white', 'text-gray-600', 'border-gray-300');\n  } else {\n    btnB.classList.remove('bg-white', 'text-gray-600', 'border-gray-300');\n    btnB.classList.add('bg-blue-600', 'text-white', 'border-blue-300');\n    btnA.classList.remove('bg-blue-600', 'text-white', 'border-blue-300');\n    btnA.classList.add('bg-white', 'text-gray-600', 'border-gray-300');\n  }\n  document.getElementById('prosent-result-a').innerHTML = '';\n  document.getElementById('prosent-result-b').innerHTML = '';\n}\n\nfunction beregnProsent() {\n  const pris = parseFloat(document.getElementById('p-pris').value);\n  const prosent = parseFloat(document.getElementById('p-prosent').value);\n\n  if (isNaN(pris) || pris <= 0) {\n    document.getElementById('prosent-result-a').innerHTML = errorHtml('Oppgi en gyldig positiv pris.');\n    return;\n  }\n  if (isNaN(prosent) || prosent < 0 || prosent > 100) {\n    document.getElementById('prosent-result-a').innerHTML = errorHtml('Rabatt må være mellom 0 og 100 %.');\n    return;\n  }\n\n  const vekstfaktor = 1 - prosent / 100;\n  const nyPris = round2(pris * vekstfaktor);\n  const spart = round2(pris - nyPris);\n\n  const html = `\n    <div class=\"grid grid-cols-2 gap-x-4 gap-y-2\">\n      <span class=\"text-gray-500\">Ordinær pris:</span>\n      <span class=\"font-semibold\">${fmt(pris)} kr</span>\n      <span class=\"text-gray-500\">Rabatt:</span>\n      <span class=\"font-semibold text-red-600\">− ${fmtPct(prosent)}</span>\n      <span class=\"text-gray-500\">Spart beløp:</span>\n      <span class=\"font-semibold text-red-600\">− ${fmt(spart)} kr</span>\n      <span class=\"text-gray-500\">Tilbudspris:</span>\n      <span class=\"font-bold text-green-700 text-base\">${fmt(nyPris)} kr</span>\n    </div>\n    <div class=\"step-line text-xs text-gray-500 mt-2 space-y-1\">\n      <p><span class=\"font-mono font-semibold text-gray-700\">Vekstfaktor</span> = 1 − ${prosent}/100 = ${vekstfaktor.toFixed(4)}</p>\n      <p><span class=\"font-mono font-semibold text-gray-700\">Ny pris</span> = ${fmt(pris)} × ${vekstfaktor.toFixed(4)} = <strong>${fmt(nyPris)} kr</strong></p>\n      <p><span class=\"font-mono font-semibold text-gray-700\">Spart</span> = ${fmt(pris)} − ${fmt(nyPris)} = <strong>${fmt(spart)} kr</strong></p>\n    </div>\n  `;\n  document.getElementById('prosent-result-a').innerHTML = resultHtml(html);\n}\n\nfunction beregnProsentB() {\n  const forPris = parseFloat(document.getElementById('p-for').value);\n  const etterPris = parseFloat(document.getElementById('p-etter').value);\n\n  if (isNaN(forPris) || forPris <= 0) {\n    document.getElementById('prosent-result-b').innerHTML = errorHtml('Oppgi en gyldig positiv førpris.');\n    return;\n  }\n  if (isNaN(etterPris) || etterPris < 0) {\n    document.getElementById('prosent-result-b').innerHTML = errorHtml('Oppgi en gyldig etterpris.');\n    return;\n  }\n  if (etterPris >= forPris) {\n    document.getElementById('prosent-result-b').innerHTML = errorHtml('Etterpris må være lavere enn førpris for at det skal være et avslag.');\n    return;\n  }\n\n  const spart = round2(forPris - etterPris);\n  const prosent = round2((spart / forPris) * 100);\n  const vekstfaktor = round2(etterPris / forPris * 10000) / 10000;\n\n  const html = `\n    <div class=\"grid grid-cols-2 gap-x-4 gap-y-2\">\n      <span class=\"text-gray-500\">Førpris:</span>\n      <span class=\"font-semibold\">${fmt(forPris)} kr</span>\n      <span class=\"text-gray-500\">Etterpris:</span>\n      <span class=\"font-semibold\">${fmt(etterPris)} kr</span>\n      <span class=\"text-gray-500\">Spart beløp:</span>\n      <span class=\"font-semibold text-red-600\">− ${fmt(spart)} kr</span>\n      <span class=\"text-gray-500\">Prosentavslag:</span>\n      <span class=\"font-bold text-green-700 text-base\">− ${fmtPct(prosent)}</span>\n    </div>\n    <div class=\"step-line text-xs text-gray-500 mt-2 space-y-1\">\n      <p><span class=\"font-mono font-semibold text-gray-700\">Spart</span> = ${fmt(forPris)} − ${fmt(etterPris)} = ${fmt(spart)} kr</p>\n      <p><span class=\"font-mono font-semibold text-gray-700\">Prosent</span> = (${fmt(spart)} / ${fmt(forPris)}) × 100 = <strong>${fmtPct(prosent)}</strong></p>\n      <p><span class=\"font-mono font-semibold text-gray-700\">Vekstfaktor</span> = ${fmt(etterPris)} / ${fmt(forPris)} = ${vekstfaktor.toFixed(4)}</p>\n    </div>\n  `;\n  document.getElementById('prosent-result-b').innerHTML = resultHtml(html);\n}\n\nfunction loadExample(ex) {\n  if (ex === 'sportsgenser') {\n    setProsentMode('a');\n    document.getElementById('p-pris').value = 699;\n    document.getElementById('p-prosent').value = 30;\n    beregnProsent();\n  } else if (ex === 'joggesko') {\n    setProsentMode('a');\n    document.getElementById('p-pris').value = 1299;\n    document.getElementById('p-prosent').value = 40;\n    beregnProsent();\n  } else if (ex === 'mobil') {\n    setProsentMode('b');\n    document.getElementById('p-for').value = 8490;\n    document.getElementById('p-etter').value = 6990;\n    beregnProsentB();\n  }\n}\n\n// ================================================================\n// TAB 2: MENGDETILBUD\n// ================================================================\nlet tilbudCVisible = false;\n\nconst mengdeDefaults = {\n  a: { type: 'stykk', stykk: 25.90 },\n  b: { type: 'prosent', stykk: 25.90, prosent: 25 },\n  c: { type: 'pakke', antall: 3, pakke_pris: 59.90 }\n};\n\nfunction updateMengdeType(id) {\n  const type = document.getElementById('m-type-' + id).value;\n  const container = document.getElementById('m-input-' + id);\n  container.innerHTML = '';\n\n  if (type === 'stykk') {\n    container.innerHTML = `\n      <div class=\"col-span-2\">\n        <label class=\"block text-xs text-gray-500 mb-1\">Stykkpris (kr)</label>\n        <input id=\"m-stykk-${id}\" type=\"number\" min=\"0\" step=\"0.01\" value=\"${mengdeDefaults[id] ? (mengdeDefaults[id].stykk || 25.90) : 25.90}\"\n          class=\"w-full border border-gray-300 rounded-lg px-2 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n      </div>`;\n  } else if (type === 'pakke') {\n    const ant = mengdeDefaults[id] ? (mengdeDefaults[id].antall || 3) : 3;\n    const pp = mengdeDefaults[id] ? (mengdeDefaults[id].pakke_pris || 59.90) : 59.90;\n    container.innerHTML = `\n      <div>\n        <label class=\"block text-xs text-gray-500 mb-1\">Antall i pakken</label>\n        <input id=\"m-antall-${id}\" type=\"number\" min=\"1\" step=\"1\" value=\"${ant}\"\n          class=\"w-full border border-gray-300 rounded-lg px-2 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n      </div>\n      <div>\n        <label class=\"block text-xs text-gray-500 mb-1\">Pris for pakken (kr)</label>\n        <input id=\"m-pakkepris-${id}\" type=\"number\" min=\"0\" step=\"0.01\" value=\"${pp}\"\n          class=\"w-full border border-gray-300 rounded-lg px-2 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n      </div>`;\n  } else if (type === 'prosent') {\n    const sp = mengdeDefaults[id] ? (mengdeDefaults[id].stykk || 25.90) : 25.90;\n    const pr = mengdeDefaults[id] ? (mengdeDefaults[id].prosent || 25) : 25;\n    container.innerHTML = `\n      <div>\n        <label class=\"block text-xs text-gray-500 mb-1\">Ordinær stykkpris (kr)</label>\n        <input id=\"m-stykk-${id}\" type=\"number\" min=\"0\" step=\"0.01\" value=\"${sp}\"\n          class=\"w-full border border-gray-300 rounded-lg px-2 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n      </div>\n      <div>\n        <label class=\"block text-xs text-gray-500 mb-1\">Rabatt (%)</label>\n        <input id=\"m-prosent-${id}\" type=\"number\" min=\"0\" max=\"100\" step=\"1\" value=\"${pr}\"\n          class=\"w-full border border-gray-300 rounded-lg px-2 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n      </div>`;\n  } else if (type === '3for2') {\n    const sp = mengdeDefaults[id] ? (mengdeDefaults[id].stykk || 25.90) : 25.90;\n    container.innerHTML = `\n      <div class=\"col-span-2\">\n        <label class=\"block text-xs text-gray-500 mb-1\">Ordinær stykkpris (kr)</label>\n        <input id=\"m-stykk-${id}\" type=\"number\" min=\"0\" step=\"0.01\" value=\"${sp}\"\n          class=\"w-full border border-gray-300 rounded-lg px-2 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n        <p class=\"text-xs text-gray-400 mt-1\">«Ta 3, betal for 2» — du får 3 stk, men betaler for 2.</p>\n      </div>`;\n  }\n}\n\nfunction getMengdeEnhetspris(id) {\n  // Returns { enhetspris, label } or null if invalid\n  const type = document.getElementById('m-type-' + id).value;\n  let ep, label;\n\n  if (type === 'stykk') {\n    const p = parseFloat(document.getElementById('m-stykk-' + id).value);\n    if (isNaN(p) || p < 0) return null;\n    ep = p;\n    label = `Stykkpris: ${fmt(p)} kr/stk`;\n  } else if (type === 'pakke') {\n    const ant = parseFloat(document.getElementById('m-antall-' + id).value);\n    const pp = parseFloat(document.getElementById('m-pakkepris-' + id).value);\n    if (isNaN(ant) || ant <= 0 || isNaN(pp) || pp < 0) return null;\n    ep = pp / ant;\n    label = `${ant} stk for ${fmt(pp)} kr → ${fmt(ep)} kr/stk`;\n  } else if (type === 'prosent') {\n    const p = parseFloat(document.getElementById('m-stykk-' + id).value);\n    const pr = parseFloat(document.getElementById('m-prosent-' + id).value);\n    if (isNaN(p) || p < 0 || isNaN(pr) || pr < 0 || pr > 100) return null;\n    ep = p * (1 - pr / 100);\n    label = `${fmt(p)} kr − ${pr} % = ${fmt(ep)} kr/stk`;\n  } else if (type === '3for2') {\n    const p = parseFloat(document.getElementById('m-stykk-' + id).value);\n    if (isNaN(p) || p < 0) return null;\n    ep = (2 * p) / 3;\n    label = `Ta 3, betal for 2: (2 × ${fmt(p)}) / 3 = ${fmt(ep)} kr/stk`;\n  }\n  return { enhetspris: ep, label };\n}\n\nfunction beregnMengde() {\n  const resultEl = document.getElementById('mengde-result');\n  const ids = tilbudCVisible ? ['a', 'b', 'c'] : ['a', 'b'];\n  const letters = { a: 'A', b: 'B', c: 'C' };\n  const colors = { a: 'text-blue-700', b: 'text-emerald-700', c: 'text-amber-700' };\n\n  const tilbud = [];\n  for (const id of ids) {\n    const res = getMengdeEnhetspris(id);\n    if (!res) {\n      resultEl.innerHTML = errorHtml(`Sjekk inndataene for tilbud ${letters[id].toUpperCase()}.`);\n      return;\n    }\n    tilbud.push({ id, ...res });\n  }\n\n  // Sort ascending by enhetspris\n  const sorted = [...tilbud].sort((a, b) => a.enhetspris - b.enhetspris);\n  const winner = sorted[0];\n\n  let rows = tilbud.map(t => {\n    const isBest = t.id === winner.id;\n    const bg = isBest ? 'bg-green-50 border-green-200' : 'bg-white border-gray-100';\n    const badge = isBest ? '<span class=\"ml-2 text-xs bg-green-100 text-green-700 border border-green-200 rounded-full px-2 py-0.5 font-semibold\">Billigst</span>' : '';\n    return `\n      <div class=\"border rounded-lg p-3 ${bg} flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1\">\n        <div>\n          <span class=\"font-semibold ${colors[t.id]}\">Tilbud ${letters[t.id]}</span>${badge}\n          <p class=\"text-xs text-gray-500 mt-0.5\">${t.label}</p>\n        </div>\n        <span class=\"font-bold text-base ${isBest ? 'text-green-700' : 'text-gray-700'}\">${fmt(t.enhetspris)} kr/stk</span>\n      </div>`;\n  }).join('');\n\n  // Savings vs most expensive\n  const mostExpensive = sorted[sorted.length - 1];\n  const savings = round2(mostExpensive.enhetspris - winner.enhetspris);\n  const savingsPct = round2((savings / mostExpensive.enhetspris) * 100);\n\n  const summary = `\n    <div class=\"mt-1 p-3 bg-green-50 border border-green-200 rounded-lg text-sm\">\n      <p class=\"font-semibold text-green-800\">Tilbud ${letters[winner.id]} er billigst</p>\n      <p class=\"text-green-700 text-xs mt-0.5\">\n        Du sparer <strong>${fmt(savings)} kr/stk</strong> (${fmtPct(savingsPct)}) sammenliknet med dyreste alternativ.\n      </p>\n    </div>`;\n\n  resultEl.innerHTML = resultHtml(rows + (tilbud.length > 1 ? summary : ''));\n}\n\nfunction toggleTilbudC() {\n  tilbudCVisible = !tilbudCVisible;\n  const content = document.getElementById('tilbud-c-content');\n  const btn = document.getElementById('toggle-c-btn');\n  content.classList.toggle('hidden', !tilbudCVisible);\n  btn.textContent = tilbudCVisible ? '− Fjern' : '+ Legg til';\n  if (tilbudCVisible) {\n    updateMengdeType('c');\n  }\n  document.getElementById('mengde-result').innerHTML = '';\n}\n\nfunction loadMengdeExample(ex) {\n  if (ex === 'cola') {\n    // A: stykkpris 18.90 / B: -25% av 18.90 / C: ta 3 betal for 2 av 18.90\n    document.getElementById('m-type-a').value = 'stykk';\n    mengdeDefaults.a = { type: 'stykk', stykk: 18.90 };\n    updateMengdeType('a');\n\n    document.getElementById('m-type-b').value = 'prosent';\n    mengdeDefaults.b = { type: 'prosent', stykk: 18.90, prosent: 25 };\n    updateMengdeType('b');\n\n    if (!tilbudCVisible) toggleTilbudC();\n    document.getElementById('m-type-c').value = '3for2';\n    mengdeDefaults.c = { type: '3for2', stykk: 18.90 };\n    updateMengdeType('c');\n\n    setTimeout(beregnMengde, 50);\n  } else if (ex === 'shampo') {\n    document.getElementById('m-type-a').value = 'stykk';\n    mengdeDefaults.a = { type: 'stykk', stykk: 32 };\n    updateMengdeType('a');\n\n    document.getElementById('m-type-b').value = 'pakke';\n    mengdeDefaults.b = { type: 'pakke', antall: 3, pakke_pris: 89 };\n    updateMengdeType('b');\n\n    if (tilbudCVisible) toggleTilbudC();\n    setTimeout(beregnMengde, 50);\n  }\n}\n\n// ================================================================\n// TAB 3: KJEDERABATTER\n// ================================================================\nlet kjedeRabatter = [20, 10];\n\nfunction renderKjedeInputs() {\n  const container = document.getElementById('kjede-rabatter');\n  container.innerHTML = '';\n  kjedeRabatter.forEach((val, i) => {\n    const label = i === 0 ? 'Første rabatt (%)' : `Neste rabatt ${i + 1} (%)`;\n    container.innerHTML += `\n      <div class=\"flex items-center gap-3\">\n        <span class=\"text-gray-400 text-sm w-5\">${i + 1}.</span>\n        <div class=\"flex-1\">\n          <label class=\"block text-sm font-medium text-gray-700 mb-1\">${label}</label>\n          <input id=\"k-r-${i}\" type=\"number\" min=\"0\" max=\"100\" step=\"1\" value=\"${val}\"\n            class=\"w-full max-w-xs border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n        </div>\n      </div>`;\n  });\n  document.getElementById('remove-rabatt-btn').classList.toggle('hidden', kjedeRabatter.length <= 1);\n}\n\nfunction addRabatt() {\n  kjedeRabatter.push(5);\n  renderKjedeInputs();\n  document.getElementById('kjede-result').innerHTML = '';\n}\n\nfunction removeRabatt() {\n  if (kjedeRabatter.length > 1) {\n    kjedeRabatter.pop();\n    renderKjedeInputs();\n    document.getElementById('kjede-result').innerHTML = '';\n  }\n}\n\nfunction readKjedeRabatter() {\n  const vals = [];\n  for (let i = 0; i < kjedeRabatter.length; i++) {\n    const v = parseFloat(document.getElementById('k-r-' + i).value);\n    vals.push(v);\n  }\n  return vals;\n}\n\nfunction beregnKjede() {\n  const pris = parseFloat(document.getElementById('k-pris').value);\n  if (isNaN(pris) || pris <= 0) {\n    document.getElementById('kjede-result').innerHTML = errorHtml('Oppgi en gyldig positiv utgangspris.');\n    return;\n  }\n\n  const rabatter = readKjedeRabatter();\n  for (const r of rabatter) {\n    if (isNaN(r) || r < 0 || r > 100) {\n      document.getElementById('kjede-result').innerHTML = errorHtml('Alle rabatter må være mellom 0 og 100 %.');\n      return;\n    }\n  }\n\n  // Compute actual chained discount\n  let vekstProdukt = 1;\n  let stegHtml = '';\n  let lopendePris = pris;\n\n  rabatter.forEach((r, i) => {\n    const vf = 1 - r / 100;\n    const forrige = lopendePris;\n    lopendePris = round2(lopendePris * vf);\n    const spart = round2(forrige - lopendePris);\n    vekstProdukt *= vf;\n    stegHtml += `\n      <div class=\"step-line text-xs text-gray-500 space-y-0.5\">\n        <p class=\"font-semibold text-gray-700\">Trinn ${i + 1}: − ${r} %</p>\n        <p>Vekstfaktor = 1 − ${r}/100 = ${vf.toFixed(4)}</p>\n        <p>${fmt(forrige)} kr × ${vf.toFixed(4)} = ${fmt(lopendePris)} kr &nbsp;(spart: ${fmt(spart)} kr)</p>\n      </div>`;\n  });\n\n  const nyPris = lopendePris;\n  const totaltSpart = round2(pris - nyPris);\n  const virkeligProsent = round2((totaltSpart / pris) * 100);\n  const sumRabatter = rabatter.reduce((a, b) => a + b, 0);\n  const feilPris = round2(pris * (1 - sumRabatter / 100));\n\n  const erForskjell = Math.abs(sumRabatter - virkeligProsent) > 0.005;\n\n  const merknadHtml = erForskjell ? `\n    <div class=\"p-3 bg-amber-50 border border-amber-200 rounded-lg text-sm\">\n      <p class=\"font-semibold text-amber-800\">Mange tror feil!</p>\n      <p class=\"text-amber-700 text-xs mt-1\">\n        Mange legger bare sammen: ${rabatter.join(' + ')} = <strong>${sumRabatter} %</strong>, og tror prisen blir <strong>${fmt(feilPris)} kr</strong>.\n        Men det er <em>feil</em>. Den faktiske rabatten er <strong>${fmtPct(virkeligProsent)}</strong> — og prisen er <strong>${fmt(nyPris)} kr</strong>.\n        Differansen: <strong>${fmt(round2(feilPris - nyPris))} kr</strong>.\n      </p>\n    </div>` : `\n    <div class=\"p-3 bg-gray-50 border border-gray-200 rounded-lg text-xs text-gray-500\">\n      Med bare én rabatt er resultatet det samme enten du legger sammen eller bruker vekstfaktor.\n    </div>`;\n\n  const totalVfHtml = `\n    <div class=\"step-line text-xs text-gray-500 space-y-0.5\">\n      <p class=\"font-semibold text-gray-700\">Samlet vekstfaktor</p>\n      <p>${rabatter.map((r, i) => `(1 − ${r}/100)`).join(' × ')} = ${vekstProdukt.toFixed(6)}</p>\n      <p>${fmt(pris)} × ${vekstProdukt.toFixed(6)} = <strong>${fmt(nyPris)} kr</strong></p>\n      <p>Samlet rabatt = (1 − ${vekstProdukt.toFixed(6)}) × 100 = <strong>${fmtPct(virkeligProsent)}</strong></p>\n    </div>`;\n\n  const html = `\n    <div class=\"grid grid-cols-2 gap-x-4 gap-y-2 mb-3\">\n      <span class=\"text-gray-500\">Utgangspris:</span>\n      <span class=\"font-semibold\">${fmt(pris)} kr</span>\n      <span class=\"text-gray-500\">Rabatter:</span>\n      <span class=\"font-semibold\">${rabatter.map(r => '− ' + r + ' %').join(' og deretter ')}</span>\n      <span class=\"text-gray-500\">Endelig pris:</span>\n      <span class=\"font-bold text-green-700 text-base\">${fmt(nyPris)} kr</span>\n      <span class=\"text-gray-500\">Totalt spart:</span>\n      <span class=\"font-semibold text-red-600\">− ${fmt(totaltSpart)} kr (${fmtPct(virkeligProsent)})</span>\n    </div>\n    <p class=\"text-xs font-semibold text-gray-600 mb-2\">Steg for steg:</p>\n    ${stegHtml}\n    ${totalVfHtml}\n    <div class=\"mt-3\">${merknadHtml}</div>\n  `;\n  document.getElementById('kjede-result').innerHTML = resultHtml(html);\n}\n\nfunction loadKjedeExample(ex) {\n  if (ex === 'klassiker') {\n    document.getElementById('k-pris').value = 1000;\n    kjedeRabatter = [20, 10];\n  } else if (ex === 'trippel') {\n    document.getElementById('k-pris').value = 2490;\n    kjedeRabatter = [15, 15, 15];\n  } else if (ex === 'retur') {\n    document.getElementById('k-pris').value = 3990;\n    kjedeRabatter = [25, 5];\n  }\n  renderKjedeInputs();\n  beregnKjede();\n}\n\n// ================================================================\n// INIT\n// ================================================================\nfunction init() {\n  // Tab 2: initialize A and B inputs\n  updateMengdeType('a');\n  updateMengdeType('b');\n\n  // Tab 3: initialize rabatt inputs\n  renderKjedeInputs();\n}\n\ninit();\n</script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Rabatt og tilbud",
    "windowTitle": "Rabatt og tilbud",
    "bundleId": "com.halisonworks.prakrabattogtilbud",
    "iconPath": null
  },
  "categoryId": null,
  "source": "import",
  "createdAt": "2026-06-02T12:00:00.000Z",
  "updatedAt": "2026-06-02T12:00:00.000Z",
  "sharedAt": "2026-06-02T12:00:00.000Z"
}
