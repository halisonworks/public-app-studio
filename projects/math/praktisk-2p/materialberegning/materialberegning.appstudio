{
  "schema": "app-studio/canvas@1",
  "id": "example-prak-materialberegning",
  "name": "materialberegning.html",
  "code": "<!DOCTYPE html>\n<!--\n  Materialberegning — Halison App Studio-eksempel\n\n  Praktisk matematikk for 2P (LK20): regn ut hvor mye maling, fliser/gulv eller\n  betong du trenger ut fra areal/volum — og hva det koster.\n\n  Fra Halison App Studio sitt offentlige bibliotek:\n  https://github.com/halisonworks/public-app-studio\n\n  Tillatt bruk: personlig, pedagogisk og annen ikke-kommersiell bruk. Behold denne\n  headeren og kildelenken; ikke-kommersiell bruk. Utgitt under Halison App Studio\n  Examples License — se LICENSE-filen i repoet over.\n-->\n<html lang=\"no\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Materialberegning – Matematikk 2P</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    /* Custom tab underline animation */\n    .tab-btn {\n      position: relative;\n      transition: color 0.2s;\n    }\n    .tab-btn::after {\n      content: '';\n      position: absolute;\n      bottom: -2px;\n      left: 0;\n      width: 100%;\n      height: 3px;\n      background: #2563eb;\n      border-radius: 2px;\n      transform: scaleX(0);\n      transition: transform 0.2s;\n    }\n    .tab-btn.active {\n      color: #2563eb;\n      font-weight: 600;\n    }\n    .tab-btn.active::after {\n      transform: scaleX(1);\n    }\n    .tab-panel { display: none; }\n    .tab-panel.active { display: block; }\n\n    /* Calc box */\n    .calc-box {\n      background: #f0f9ff;\n      border-left: 4px solid #2563eb;\n      font-family: 'Courier New', monospace;\n      font-size: 0.875rem;\n      line-height: 1.6;\n    }\n    .result-box {\n      background: #f0fdf4;\n      border-left: 4px solid #16a34a;\n    }\n\n    /* Input focus */\n    input[type=\"number\"], input[type=\"text\"] {\n      -moz-appearance: textfield;\n    }\n    input::-webkit-outer-spin-button,\n    input::-webkit-inner-spin-button {\n      -webkit-appearance: none;\n      margin: 0;\n    }\n  </style>\n</head>\n<body class=\"bg-gray-50 min-h-screen\">\n\n  <!-- Header -->\n  <header class=\"bg-blue-700 text-white shadow-md\">\n    <div class=\"max-w-3xl mx-auto px-4 py-5\">\n      <p class=\"text-xs font-semibold uppercase tracking-widest text-blue-200 mb-1\">Matematikk 2P · LK20 · Praktisk regning</p>\n      <h1 class=\"text-2xl sm:text-3xl font-bold\">Materialberegning</h1>\n      <p class=\"text-blue-100 mt-1 text-sm\">Regn ut hvor mye materiale du trenger – og hva det koster.</p>\n    </div>\n  </header>\n\n  <!-- Main -->\n  <main class=\"max-w-3xl mx-auto px-4 py-6\">\n\n    <!-- Tab bar -->\n    <div class=\"flex gap-6 border-b border-gray-300 mb-6\">\n      <button class=\"tab-btn active text-gray-700 py-2 text-base\" data-tab=\"maling\">🎨 Maling</button>\n      <button class=\"tab-btn text-gray-700 py-2 text-base\" data-tab=\"fliser\">🏠 Fliser / gulv</button>\n      <button class=\"tab-btn text-gray-700 py-2 text-base\" data-tab=\"betong\">🧱 Betong</button>\n    </div>\n\n    <!-- ═══════════════════════════════════════════\n         TAB 1 — MALING\n    ═══════════════════════════════════════════ -->\n    <section id=\"tab-maling\" class=\"tab-panel active\" aria-label=\"Malingskalkulator\">\n\n      <h2 class=\"text-lg font-semibold text-gray-800 mb-4\">Malingskalkulator</h2>\n\n      <!-- Arealmetode valg -->\n      <div class=\"mb-4\">\n        <label class=\"block text-sm font-medium text-gray-700 mb-1\">Hvordan vil du oppgi arealet?</label>\n        <div class=\"flex gap-4\">\n          <label class=\"flex items-center gap-2 cursor-pointer\">\n            <input type=\"radio\" name=\"maling-areal-mode\" value=\"direkte\" checked\n              class=\"accent-blue-600\" id=\"maling-mode-direkte\" />\n            <span class=\"text-sm\">Skriv inn areal direkte</span>\n          </label>\n          <label class=\"flex items-center gap-2 cursor-pointer\">\n            <input type=\"radio\" name=\"maling-areal-mode\" value=\"rom\"\n              class=\"accent-blue-600\" id=\"maling-mode-rom\" />\n            <span class=\"text-sm\">Beregn fra romdimensjoner</span>\n          </label>\n        </div>\n      </div>\n\n      <!-- Direkte areal -->\n      <div id=\"maling-direkte\" class=\"mb-4\">\n        <label class=\"block text-sm font-medium text-gray-700 mb-1\" for=\"maling-areal\">\n          Veggenes areal (m²)\n        </label>\n        <input type=\"number\" id=\"maling-areal\" min=\"0\" step=\"0.1\" placeholder=\"f.eks. 48\"\n          class=\"w-full sm:w-48 border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n      </div>\n\n      <!-- Romdimensjoner -->\n      <div id=\"maling-rom\" class=\"hidden mb-4 p-4 bg-gray-100 rounded-lg\">\n        <p class=\"text-xs text-gray-500 mb-3\">\n          Arealet beregnes som: 2 × (lengde + bredde) × høyde, minus dører og vinduer.\n        </p>\n        <div class=\"grid grid-cols-2 sm:grid-cols-3 gap-3\">\n          <div>\n            <label class=\"block text-xs font-medium text-gray-600 mb-1\" for=\"rom-lengde\">Lengde (m)</label>\n            <input type=\"number\" id=\"rom-lengde\" min=\"0\" step=\"0.1\" placeholder=\"5.0\"\n              class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n          </div>\n          <div>\n            <label class=\"block text-xs font-medium text-gray-600 mb-1\" for=\"rom-bredde\">Bredde (m)</label>\n            <input type=\"number\" id=\"rom-bredde\" min=\"0\" step=\"0.1\" placeholder=\"4.0\"\n              class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n          </div>\n          <div>\n            <label class=\"block text-xs font-medium text-gray-600 mb-1\" for=\"rom-hoyde\">Høyde (m)</label>\n            <input type=\"number\" id=\"rom-hoyde\" min=\"0\" step=\"0.1\" placeholder=\"2.4\"\n              class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n          </div>\n          <div>\n            <label class=\"block text-xs font-medium text-gray-600 mb-1\" for=\"rom-dorer\">\n              Dører + vinduer (m²)\n              <span class=\"font-normal text-gray-400\">(trekkes fra)</span>\n            </label>\n            <input type=\"number\" id=\"rom-dorer\" min=\"0\" step=\"0.1\" placeholder=\"4.5\"\n              class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n          </div>\n        </div>\n        <p class=\"text-sm text-blue-700 mt-2 font-medium\" id=\"maling-rom-areal-vis\"></p>\n      </div>\n\n      <!-- Malingparametre -->\n      <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4\">\n        <div>\n          <label class=\"block text-sm font-medium text-gray-700 mb-1\" for=\"maling-dekkevne\">\n            Dekkevne (m² per liter)\n            <span class=\"text-xs text-gray-400 font-normal\">typisk 8–12</span>\n          </label>\n          <input type=\"number\" id=\"maling-dekkevne\" min=\"0.1\" step=\"0.1\" placeholder=\"10\"\n            class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n        </div>\n        <div>\n          <label class=\"block text-sm font-medium text-gray-700 mb-1\" for=\"maling-strok\">\n            Antall strøk\n          </label>\n          <input type=\"number\" id=\"maling-strok\" min=\"1\" step=\"1\" placeholder=\"2\"\n            class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n        </div>\n        <div>\n          <label class=\"block text-sm font-medium text-gray-700 mb-1\" for=\"maling-boksstorrelse\">\n            Boksestørrelse (liter per boks)\n            <span class=\"text-xs text-gray-400 font-normal\">f.eks. 2,7 eller 10</span>\n          </label>\n          <input type=\"number\" id=\"maling-boksstorrelse\" min=\"0.1\" step=\"0.1\" placeholder=\"2.7\"\n            class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n        </div>\n        <div>\n          <label class=\"block text-sm font-medium text-gray-700 mb-1\" for=\"maling-prisboks\">\n            Pris per boks (kr)\n          </label>\n          <input type=\"number\" id=\"maling-prisboks\" min=\"0\" step=\"1\" placeholder=\"349\"\n            class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n        </div>\n      </div>\n\n      <button onclick=\"beregnMaling()\"\n        class=\"bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-2.5 rounded-lg transition-colors text-sm\">\n        Beregn\n      </button>\n\n      <div id=\"maling-resultat\" class=\"mt-6 hidden\">\n        <h3 class=\"font-semibold text-gray-800 mb-2\">Utregning</h3>\n        <div id=\"maling-calc\" class=\"calc-box rounded-lg p-4 mb-3 whitespace-pre-wrap\"></div>\n        <div id=\"maling-svar\" class=\"result-box rounded-lg p-4 text-sm font-medium text-green-800\"></div>\n      </div>\n    </section>\n\n    <!-- ═══════════════════════════════════════════\n         TAB 2 — FLISER / GULV\n    ═══════════════════════════════════════════ -->\n    <section id=\"tab-fliser\" class=\"tab-panel\" aria-label=\"Fliser og gulvkalkulator\">\n\n      <h2 class=\"text-lg font-semibold text-gray-800 mb-4\">Fliser / gulvkalkulator</h2>\n\n      <!-- Arealmetode -->\n      <div class=\"mb-4\">\n        <label class=\"block text-sm font-medium text-gray-700 mb-1\">Oppgi areal som</label>\n        <div class=\"flex gap-4\">\n          <label class=\"flex items-center gap-2 cursor-pointer\">\n            <input type=\"radio\" name=\"fliser-areal-mode\" value=\"direkte\" checked\n              class=\"accent-blue-600\" id=\"fliser-mode-direkte\" />\n            <span class=\"text-sm\">Direkte areal (m²)</span>\n          </label>\n          <label class=\"flex items-center gap-2 cursor-pointer\">\n            <input type=\"radio\" name=\"fliser-areal-mode\" value=\"mal\"\n              class=\"accent-blue-600\" id=\"fliser-mode-mal\" />\n            <span class=\"text-sm\">Mål rommet (m × m)</span>\n          </label>\n        </div>\n      </div>\n\n      <div id=\"fliser-direkte\" class=\"mb-4\">\n        <label class=\"block text-sm font-medium text-gray-700 mb-1\" for=\"fliser-areal\">\n          Gulvareal (m²)\n        </label>\n        <input type=\"number\" id=\"fliser-areal\" min=\"0\" step=\"0.1\" placeholder=\"f.eks. 18\"\n          class=\"w-full sm:w-48 border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n      </div>\n\n      <div id=\"fliser-mal\" class=\"hidden mb-4 p-4 bg-gray-100 rounded-lg\">\n        <div class=\"grid grid-cols-2 gap-3\">\n          <div>\n            <label class=\"block text-xs font-medium text-gray-600 mb-1\" for=\"fliser-lengde\">Lengde (m)</label>\n            <input type=\"number\" id=\"fliser-lengde\" min=\"0\" step=\"0.1\" placeholder=\"4.5\"\n              class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n          </div>\n          <div>\n            <label class=\"block text-xs font-medium text-gray-600 mb-1\" for=\"fliser-bredde\">Bredde (m)</label>\n            <input type=\"number\" id=\"fliser-bredde\" min=\"0\" step=\"0.1\" placeholder=\"4.0\"\n              class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n          </div>\n        </div>\n        <p class=\"text-sm text-blue-700 mt-2 font-medium\" id=\"fliser-mal-areal-vis\"></p>\n      </div>\n\n      <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4\">\n        <div>\n          <label class=\"block text-sm font-medium text-gray-700 mb-1\" for=\"fliser-dekning\">\n            Dekning per pakke (m²)\n            <span class=\"text-xs text-gray-400 font-normal\">f.eks. 1,44 for 60×60</span>\n          </label>\n          <input type=\"number\" id=\"fliser-dekning\" min=\"0.01\" step=\"0.01\" placeholder=\"1.44\"\n            class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n        </div>\n        <div>\n          <label class=\"block text-sm font-medium text-gray-700 mb-1\" for=\"fliser-svinn\">\n            Svinn-tillegg (%)\n            <span class=\"text-xs text-gray-400 font-normal\">anbefalt 10 %</span>\n          </label>\n          <input type=\"number\" id=\"fliser-svinn\" min=\"0\" max=\"50\" step=\"1\" placeholder=\"10\"\n            class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n        </div>\n        <div>\n          <label class=\"block text-sm font-medium text-gray-700 mb-1\" for=\"fliser-prispakke\">\n            Pris per pakke (kr)\n          </label>\n          <input type=\"number\" id=\"fliser-prispakke\" min=\"0\" step=\"1\" placeholder=\"279\"\n            class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n        </div>\n      </div>\n\n      <button onclick=\"beregnFliser()\"\n        class=\"bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-2.5 rounded-lg transition-colors text-sm\">\n        Beregn\n      </button>\n\n      <div id=\"fliser-resultat\" class=\"mt-6 hidden\">\n        <h3 class=\"font-semibold text-gray-800 mb-2\">Utregning</h3>\n        <div id=\"fliser-calc\" class=\"calc-box rounded-lg p-4 mb-3 whitespace-pre-wrap\"></div>\n        <div id=\"fliser-svar\" class=\"result-box rounded-lg p-4 text-sm font-medium text-green-800\"></div>\n      </div>\n    </section>\n\n    <!-- ═══════════════════════════════════════════\n         TAB 3 — BETONG\n    ═══════════════════════════════════════════ -->\n    <section id=\"tab-betong\" class=\"tab-panel\" aria-label=\"Betongkalkulator\">\n\n      <h2 class=\"text-lg font-semibold text-gray-800 mb-4\">Betongkalkulator</h2>\n      <p class=\"text-sm text-gray-500 mb-4\">\n        Beregn antall sekker tørrbetong ut fra lengde, bredde og tykkelse/høyde.\n        Én sekk (25 kg) gir vanligvis ca. 12 liter ferdig betong.\n      </p>\n\n      <div class=\"grid grid-cols-1 sm:grid-cols-3 gap-4 mb-4\">\n        <div>\n          <label class=\"block text-sm font-medium text-gray-700 mb-1\" for=\"betong-lengde\">\n            Lengde (m)\n          </label>\n          <input type=\"number\" id=\"betong-lengde\" min=\"0\" step=\"0.01\" placeholder=\"3.0\"\n            class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n        </div>\n        <div>\n          <label class=\"block text-sm font-medium text-gray-700 mb-1\" for=\"betong-bredde\">\n            Bredde (m)\n          </label>\n          <input type=\"number\" id=\"betong-bredde\" min=\"0\" step=\"0.01\" placeholder=\"2.0\"\n            class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n        </div>\n        <div>\n          <label class=\"block text-sm font-medium text-gray-700 mb-1\" for=\"betong-hoyde\">\n            Tykkelse / høyde (m)\n            <span class=\"text-xs text-gray-400 font-normal\">f.eks. 0,10 = 10 cm</span>\n          </label>\n          <input type=\"number\" id=\"betong-hoyde\" min=\"0\" step=\"0.001\" placeholder=\"0.10\"\n            class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n        </div>\n      </div>\n\n      <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4\">\n        <div>\n          <label class=\"block text-sm font-medium text-gray-700 mb-1\" for=\"betong-liter-sekk\">\n            Liter ferdig betong per sekk\n            <span class=\"text-xs text-gray-400 font-normal\">typisk 12 l/sekk (25 kg)</span>\n          </label>\n          <input type=\"number\" id=\"betong-liter-sekk\" min=\"1\" step=\"0.5\" placeholder=\"12\"\n            class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n        </div>\n        <div>\n          <label class=\"block text-sm font-medium text-gray-700 mb-1\" for=\"betong-prissekk\">\n            Pris per sekk (kr)\n          </label>\n          <input type=\"number\" id=\"betong-prissekk\" min=\"0\" step=\"1\" placeholder=\"85\"\n            class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n        </div>\n      </div>\n\n      <button onclick=\"beregnBetong()\"\n        class=\"bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-2.5 rounded-lg transition-colors text-sm\">\n        Beregn\n      </button>\n\n      <div id=\"betong-resultat\" class=\"mt-6 hidden\">\n        <h3 class=\"font-semibold text-gray-800 mb-2\">Utregning</h3>\n        <div id=\"betong-calc\" class=\"calc-box rounded-lg p-4 mb-3 whitespace-pre-wrap\"></div>\n        <div id=\"betong-svar\" class=\"result-box rounded-lg p-4 text-sm font-medium text-green-800\"></div>\n      </div>\n    </section>\n\n    <!-- Info / pedagogisk boks -->\n    <aside class=\"mt-10 p-4 bg-yellow-50 border border-yellow-200 rounded-lg text-sm text-yellow-900\">\n      <p class=\"font-semibold mb-1\">Matematikk 2P – hva trener vi her?</p>\n      <ul class=\"list-disc list-inside space-y-1 text-yellow-800\">\n        <li>Beregne areal og volum med formler</li>\n        <li>Divisjon og runding oppover (⌈x⌉ – takfunksjonen)</li>\n        <li>Prosentregning (svinn-tillegg)</li>\n        <li>Kostnadsvurdering og enhetspriser</li>\n      </ul>\n    </aside>\n\n  </main>\n\n  <footer class=\"text-center text-xs text-gray-400 py-6 mt-4\">\n    Halison App Studio · Matematikk 2P-eksempel · Kun til pedagogisk og ikke-kommersiell bruk\n  </footer>\n\n  <script>\n    /* =========================================================\n       TABS\n    ========================================================= */\n    (function () {\n      var btns = document.querySelectorAll('.tab-btn');\n      btns.forEach(function (btn) {\n        btn.addEventListener('click', function () {\n          var tab = btn.getAttribute('data-tab');\n          btns.forEach(function (b) { b.classList.remove('active'); });\n          btn.classList.add('active');\n          document.querySelectorAll('.tab-panel').forEach(function (p) {\n            p.classList.remove('active');\n          });\n          document.getElementById('tab-' + tab).classList.add('active');\n        });\n      });\n    })();\n\n    /* =========================================================\n       HELPERS\n    ========================================================= */\n    function norNum(val, decimals) {\n      // Format number Norwegian style (. as thousand sep, , as decimal)\n      if (decimals === undefined) decimals = 2;\n      return val.toLocaleString('nb-NO', {\n        minimumFractionDigits: decimals,\n        maximumFractionDigits: decimals\n      });\n    }\n\n    function getNum(id) {\n      var v = parseFloat(document.getElementById(id).value);\n      return isNaN(v) ? null : v;\n    }\n\n    function showError(resultId, msg) {\n      var box = document.getElementById(resultId);\n      box.classList.remove('hidden');\n      box.querySelector('[id$=\"-calc\"]') && (box.querySelector('[id$=\"-calc\"]').textContent = '');\n      // Find the svar element inside resultId's parent section\n      var svar = box.parentElement ? box.parentElement.querySelector('[id$=\"-svar\"]') : null;\n      if (!svar) return;\n      svar.textContent = '⚠️ ' + msg;\n      svar.className = 'rounded-lg p-4 text-sm font-medium text-red-700 bg-red-50 border-l-4 border-red-500';\n    }\n\n    /* =========================================================\n       TAB 1 — MALING\n    ========================================================= */\n    // Toggle areal-mode\n    document.querySelectorAll('input[name=\"maling-areal-mode\"]').forEach(function (r) {\n      r.addEventListener('change', function () {\n        var v = document.querySelector('input[name=\"maling-areal-mode\"]:checked').value;\n        document.getElementById('maling-direkte').classList.toggle('hidden', v !== 'direkte');\n        document.getElementById('maling-rom').classList.toggle('hidden', v !== 'rom');\n        oppdaterRomAreal();\n      });\n    });\n\n    ['rom-lengde', 'rom-bredde', 'rom-hoyde', 'rom-dorer'].forEach(function (id) {\n      var el = document.getElementById(id);\n      if (el) el.addEventListener('input', oppdaterRomAreal);\n    });\n\n    function oppdaterRomAreal() {\n      var l = getNum('rom-lengde'), b = getNum('rom-bredde'),\n          h = getNum('rom-hoyde'), d = getNum('rom-dorer') || 0;\n      var vis = document.getElementById('maling-rom-areal-vis');\n      if (l && b && h) {\n        var a = 2 * (l + b) * h - d;\n        if (a < 0) a = 0;\n        vis.textContent = 'Beregnet veggareal: ' + norNum(a) + ' m²';\n      } else {\n        vis.textContent = '';\n      }\n    }\n\n    function getMalingAreal() {\n      var mode = document.querySelector('input[name=\"maling-areal-mode\"]:checked').value;\n      if (mode === 'direkte') {\n        return { areal: getNum('maling-areal'), utregning: null };\n      } else {\n        var l = getNum('rom-lengde'), b = getNum('rom-bredde'),\n            h = getNum('rom-hoyde'), d = getNum('rom-dorer') || 0;\n        if (!l || !b || !h) return { areal: null, utregning: null };\n        var a = 2 * (l + b) * h - d;\n        if (a < 0) a = 0;\n        var utregning = 'Veggareal = 2 × (lengde + bredde) × høyde − dører/vinduer\\n' +\n          '          = 2 × (' + norNum(l) + ' + ' + norNum(b) + ') × ' + norNum(h) + ' − ' + norNum(d) + '\\n' +\n          '          = 2 × ' + norNum(l + b) + ' × ' + norNum(h) + ' − ' + norNum(d) + '\\n' +\n          '          = ' + norNum(2 * (l + b) * h) + ' − ' + norNum(d) + '\\n' +\n          '          = ' + norNum(a) + ' m²';\n        return { areal: a, utregning: utregning };\n      }\n    }\n\n    function beregnMaling() {\n      var arealRes = getMalingAreal();\n      var A = arealRes.areal;\n      var dekkevne = getNum('maling-dekkevne');\n      var strok = getNum('maling-strok');\n      var boksstorrelse = getNum('maling-boksstorrelse');\n      var prisboks = getNum('maling-prisboks');\n\n      // Validate\n      if (!A || A <= 0) { visMailingFeil('Oppgi et gyldig areal (større enn 0).'); return; }\n      if (!dekkevne || dekkevne <= 0) { visMailingFeil('Oppgi dekkevne (m² per liter).'); return; }\n      if (!strok || strok < 1) { visMailingFeil('Antall strøk må være minst 1.'); return; }\n      if (!boksstorrelse || boksstorrelse <= 0) { visMailingFeil('Oppgi boksestørrelse i liter.'); return; }\n\n      var totaltLiter = (A / dekkevne) * strok;\n      var antallBokser = Math.ceil(totaltLiter / boksstorrelse);\n\n      var lines = [];\n      if (arealRes.utregning) {\n        lines.push('— Arealberegning —');\n        lines.push(arealRes.utregning);\n        lines.push('');\n      }\n      lines.push('— Malingsbehov —');\n      lines.push('Totalt areal (A)   = ' + norNum(A) + ' m²');\n      lines.push('Dekkevne           = ' + norNum(dekkevne) + ' m²/liter');\n      lines.push('Antall strøk       = ' + strok);\n      lines.push('');\n      lines.push('Liter per strøk    = A ÷ dekkevne');\n      lines.push('                   = ' + norNum(A) + ' ÷ ' + norNum(dekkevne));\n      lines.push('                   = ' + norNum(A / dekkevne) + ' liter');\n      lines.push('');\n      lines.push('Totalt liter       = liter per strøk × antall strøk');\n      lines.push('                   = ' + norNum(A / dekkevne) + ' × ' + strok);\n      lines.push('                   = ' + norNum(totaltLiter) + ' liter');\n      lines.push('');\n      lines.push('Bokser (rund opp)  = ⌈' + norNum(totaltLiter) + ' ÷ ' + norNum(boksstorrelse) + '⌉');\n      lines.push('                   = ⌈' + norNum(totaltLiter / boksstorrelse) + '⌉');\n      lines.push('                   = ' + antallBokser + ' bokser');\n\n      var svarTekst = 'Du trenger ' + antallBokser + ' boks' + (antallBokser !== 1 ? 'er' : '') +\n        ' à ' + norNum(boksstorrelse) + ' liter (' + norNum(antallBokser * boksstorrelse) + ' liter totalt, ' +\n        strok + ' strøk over ' + norNum(A) + ' m²).';\n\n      if (prisboks && prisboks > 0) {\n        var kostnad = antallBokser * prisboks;\n        lines.push('');\n        lines.push('— Kostnad —');\n        lines.push('Kostnad = antall bokser × pris per boks');\n        lines.push('        = ' + antallBokser + ' × ' + norNum(prisboks, 0) + ' kr');\n        lines.push('        = ' + norNum(kostnad, 0) + ' kr');\n        svarTekst += ' Estimert kostnad: ' + norNum(kostnad, 0) + ' kr.';\n      }\n\n      document.getElementById('maling-calc').textContent = lines.join('\\n');\n      var svarEl = document.getElementById('maling-svar');\n      svarEl.textContent = svarTekst;\n      svarEl.className = 'result-box rounded-lg p-4 text-sm font-medium text-green-800';\n      document.getElementById('maling-resultat').classList.remove('hidden');\n    }\n\n    function visMailingFeil(msg) {\n      document.getElementById('maling-resultat').classList.remove('hidden');\n      document.getElementById('maling-calc').textContent = '';\n      var el = document.getElementById('maling-svar');\n      el.textContent = '⚠️ ' + msg;\n      el.className = 'rounded-lg p-4 text-sm font-medium text-red-700 bg-red-50 border-l-4 border-red-500';\n    }\n\n    /* =========================================================\n       TAB 2 — FLISER\n    ========================================================= */\n    document.querySelectorAll('input[name=\"fliser-areal-mode\"]').forEach(function (r) {\n      r.addEventListener('change', function () {\n        var v = document.querySelector('input[name=\"fliser-areal-mode\"]:checked').value;\n        document.getElementById('fliser-direkte').classList.toggle('hidden', v !== 'direkte');\n        document.getElementById('fliser-mal').classList.toggle('hidden', v !== 'mal');\n        oppdaterFliserAreal();\n      });\n    });\n\n    ['fliser-lengde', 'fliser-bredde'].forEach(function (id) {\n      var el = document.getElementById(id);\n      if (el) el.addEventListener('input', oppdaterFliserAreal);\n    });\n\n    function oppdaterFliserAreal() {\n      var l = getNum('fliser-lengde'), b = getNum('fliser-bredde');\n      var vis = document.getElementById('fliser-mal-areal-vis');\n      if (l && b) {\n        vis.textContent = 'Beregnet gulvareal: ' + norNum(l * b) + ' m²';\n      } else {\n        vis.textContent = '';\n      }\n    }\n\n    function getFliserAreal() {\n      var mode = document.querySelector('input[name=\"fliser-areal-mode\"]:checked').value;\n      if (mode === 'direkte') {\n        return { areal: getNum('fliser-areal'), utregning: null };\n      } else {\n        var l = getNum('fliser-lengde'), b = getNum('fliser-bredde');\n        if (!l || !b) return { areal: null, utregning: null };\n        var a = l * b;\n        var utregning = 'Gulvareal = lengde × bredde\\n' +\n          '          = ' + norNum(l) + ' × ' + norNum(b) + '\\n' +\n          '          = ' + norNum(a) + ' m²';\n        return { areal: a, utregning: utregning };\n      }\n    }\n\n    function beregnFliser() {\n      var arealRes = getFliserAreal();\n      var A = arealRes.areal;\n      var dekning = getNum('fliser-dekning');\n      var svinnProsent = getNum('fliser-svinn');\n      var prispakke = getNum('fliser-prispakke');\n\n      if (!A || A <= 0) { visFliserFeil('Oppgi et gyldig gulvareal (større enn 0).'); return; }\n      if (!dekning || dekning <= 0) { visFliserFeil('Oppgi dekning per pakke (m²).'); return; }\n      if (svinnProsent === null || svinnProsent < 0) { visFliserFeil('Oppgi svinn-tillegg i prosent (minst 0).'); return; }\n\n      var svinnFaktor = 1 + svinnProsent / 100;\n      var arealMedSvinn = A * svinnFaktor;\n      var antallPakker = Math.ceil(arealMedSvinn / dekning);\n\n      var lines = [];\n      if (arealRes.utregning) {\n        lines.push('— Arealberegning —');\n        lines.push(arealRes.utregning);\n        lines.push('');\n      }\n      lines.push('— Fliser/gulvberegning —');\n      lines.push('Netto gulvareal (A)     = ' + norNum(A) + ' m²');\n      lines.push('Svinn-tillegg           = ' + norNum(svinnProsent, 1) + ' %');\n      lines.push('Svinnfaktor             = 1 + ' + norNum(svinnProsent, 1) + ' / 100 = ' + norNum(svinnFaktor, 4));\n      lines.push('');\n      lines.push('Areal inkl. svinn       = A × svinnfaktor');\n      lines.push('                        = ' + norNum(A) + ' × ' + norNum(svinnFaktor, 4));\n      lines.push('                        = ' + norNum(arealMedSvinn) + ' m²');\n      lines.push('');\n      lines.push('Pakker (rund opp)       = ⌈' + norNum(arealMedSvinn) + ' ÷ ' + norNum(dekning) + '⌉');\n      lines.push('                        = ⌈' + norNum(arealMedSvinn / dekning) + '⌉');\n      lines.push('                        = ' + antallPakker + ' pakker');\n\n      var svarTekst = 'Du trenger ' + antallPakker + ' pakke' + (antallPakker !== 1 ? 'r' : '') +\n        ' (à ' + norNum(dekning) + ' m²) for et gulv på ' + norNum(A) + ' m² med ' +\n        norNum(svinnProsent, 0) + ' % svinn-tillegg.';\n\n      if (prispakke && prispakke > 0) {\n        var kostnad = antallPakker * prispakke;\n        lines.push('');\n        lines.push('— Kostnad —');\n        lines.push('Kostnad = antall pakker × pris per pakke');\n        lines.push('        = ' + antallPakker + ' × ' + norNum(prispakke, 0) + ' kr');\n        lines.push('        = ' + norNum(kostnad, 0) + ' kr');\n        svarTekst += ' Estimert kostnad: ' + norNum(kostnad, 0) + ' kr.';\n      }\n\n      document.getElementById('fliser-calc').textContent = lines.join('\\n');\n      var svarEl = document.getElementById('fliser-svar');\n      svarEl.textContent = svarTekst;\n      svarEl.className = 'result-box rounded-lg p-4 text-sm font-medium text-green-800';\n      document.getElementById('fliser-resultat').classList.remove('hidden');\n    }\n\n    function visFliserFeil(msg) {\n      document.getElementById('fliser-resultat').classList.remove('hidden');\n      document.getElementById('fliser-calc').textContent = '';\n      var el = document.getElementById('fliser-svar');\n      el.textContent = '⚠️ ' + msg;\n      el.className = 'rounded-lg p-4 text-sm font-medium text-red-700 bg-red-50 border-l-4 border-red-500';\n    }\n\n    /* =========================================================\n       TAB 3 — BETONG\n    ========================================================= */\n    function beregnBetong() {\n      var l = getNum('betong-lengde');\n      var b = getNum('betong-bredde');\n      var h = getNum('betong-hoyde');\n      var literPerSekk = getNum('betong-liter-sekk');\n      var prissekk = getNum('betong-prissekk');\n\n      if (!l || l <= 0) { visBetongFeil('Oppgi lengde (m).'); return; }\n      if (!b || b <= 0) { visBetongFeil('Oppgi bredde (m).'); return; }\n      if (!h || h <= 0) { visBetongFeil('Oppgi tykkelse/høyde (m).'); return; }\n      if (!literPerSekk || literPerSekk <= 0) { visBetongFeil('Oppgi liter ferdig betong per sekk.'); return; }\n\n      var volum_m3 = l * b * h;\n      var volum_liter = volum_m3 * 1000;\n      var antallSekker = Math.ceil(volum_liter / literPerSekk);\n\n      var lines = [];\n      lines.push('— Volumberegning —');\n      lines.push('Volum (m³) = lengde × bredde × tykkelse');\n      lines.push('           = ' + norNum(l) + ' × ' + norNum(b) + ' × ' + norNum(h, 3));\n      lines.push('           = ' + norNum(volum_m3, 4) + ' m³');\n      lines.push('');\n      lines.push('Omregning til liter:');\n      lines.push('           1 m³ = 1 000 liter');\n      lines.push('Volum (l)  = ' + norNum(volum_m3, 4) + ' × 1 000');\n      lines.push('           = ' + norNum(volum_liter, 1) + ' liter');\n      lines.push('');\n      lines.push('— Beregning av sekker —');\n      lines.push('Liter per sekk     = ' + norNum(literPerSekk, 1) + ' l');\n      lines.push('Sekker (rund opp)  = ⌈' + norNum(volum_liter, 1) + ' ÷ ' + norNum(literPerSekk, 1) + '⌉');\n      lines.push('                   = ⌈' + norNum(volum_liter / literPerSekk) + '⌉');\n      lines.push('                   = ' + antallSekker + ' sekker');\n\n      var svarTekst = 'Volumet er ' + norNum(volum_m3, 4) + ' m³ (' + norNum(volum_liter, 1) + ' liter). ' +\n        'Du trenger ' + antallSekker + ' sekk' + (antallSekker !== 1 ? 'er' : '') +\n        ' tørrbetong (à ' + norNum(literPerSekk, 1) + ' liter).';\n\n      if (prissekk && prissekk > 0) {\n        var kostnad = antallSekker * prissekk;\n        lines.push('');\n        lines.push('— Kostnad —');\n        lines.push('Kostnad = antall sekker × pris per sekk');\n        lines.push('        = ' + antallSekker + ' × ' + norNum(prissekk, 0) + ' kr');\n        lines.push('        = ' + norNum(kostnad, 0) + ' kr');\n        svarTekst += ' Estimert kostnad: ' + norNum(kostnad, 0) + ' kr.';\n      }\n\n      document.getElementById('betong-calc').textContent = lines.join('\\n');\n      var svarEl = document.getElementById('betong-svar');\n      svarEl.textContent = svarTekst;\n      svarEl.className = 'result-box rounded-lg p-4 text-sm font-medium text-green-800';\n      document.getElementById('betong-resultat').classList.remove('hidden');\n    }\n\n    function visBetongFeil(msg) {\n      document.getElementById('betong-resultat').classList.remove('hidden');\n      document.getElementById('betong-calc').textContent = '';\n      var el = document.getElementById('betong-svar');\n      el.textContent = '⚠️ ' + msg;\n      el.className = 'rounded-lg p-4 text-sm font-medium text-red-700 bg-red-50 border-l-4 border-red-500';\n    }\n  </script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Materialberegning",
    "windowTitle": "Materialberegning",
    "bundleId": "com.halisonworks.prakmaterialberegning",
    "iconPath": null
  },
  "categoryId": null,
  "source": "import",
  "createdAt": "2026-06-02T12:00:00.000Z",
  "updatedAt": "2026-06-02T12:00:00.000Z",
  "sharedAt": "2026-06-02T12:00:00.000Z"
}
