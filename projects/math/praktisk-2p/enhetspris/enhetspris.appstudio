{
  "schema": "app-studio/canvas@1",
  "id": "example-prak-enhetspris",
  "name": "enhetspris.html",
  "code": "<!DOCTYPE html>\n<!--\n  Enhetspris — Halison App Studio-eksempel\n\n  Praktisk matematikk for 2P (LK20): regn ut pris per kg/liter/stk og finn beste\n  kjøp når pakningene har ulik størrelse — nyttig på handletur.\n\n  Fra Halison App Studio sitt offentlige bibliotek:\n  https://github.com/halisonworks/public-app-studio\n\n  Tillatt bruk: personlig, pedagogisk og annen ikke-kommersiell bruk. Behold denne\n  headeren og kildelenken; ikke-kommersiell bruk. Utgitt under Halison App Studio\n  Examples License — se LICENSE-filen i repoet over.\n-->\n<html lang=\"no\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Enhetspris — Finn beste kjøp</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Segoe UI', system-ui, sans-serif; }\n    .winner-glow {\n      box-shadow: 0 0 0 3px #16a34a, 0 4px 16px rgba(22,163,74,0.18);\n    }\n    .row-transition {\n      transition: background 0.25s, box-shadow 0.25s;\n    }\n    .unit-badge {\n      min-width: 3.5rem;\n    }\n    input[type=number]::-webkit-inner-spin-button,\n    input[type=number]::-webkit-outer-spin-button { opacity: 1; }\n  </style>\n</head>\n<body class=\"bg-gray-50 min-h-screen\">\n\n  <!-- Header -->\n  <header class=\"bg-white border-b border-gray-200 shadow-sm\">\n    <div class=\"max-w-3xl mx-auto px-4 py-5\">\n      <div class=\"flex items-center gap-3\">\n        <span class=\"text-3xl\" aria-hidden=\"true\">🛒</span>\n        <div>\n          <h1 class=\"text-2xl font-bold text-gray-900 leading-tight\">Enhetspris</h1>\n          <p class=\"text-sm text-gray-500\">Matematikk 2P · Finn beste kjøp</p>\n        </div>\n      </div>\n    </div>\n  </header>\n\n  <main class=\"max-w-3xl mx-auto px-4 py-6 space-y-6\">\n\n    <!-- Forklaring -->\n    <section class=\"bg-blue-50 border border-blue-200 rounded-xl p-4 text-sm text-blue-900 leading-relaxed\">\n      <h2 class=\"font-semibold text-base mb-1\">Hva er enhetspris?</h2>\n      <p>\n        Enhetspris er prisen per enhet — for eksempel <strong>kr per kg</strong> eller <strong>kr per liter</strong>.\n        Når to produkter har ulik pakningsstørrelse, er det umulig å sammenligne dem direkte ved å se på totalprisen.\n        Ved å regne ut enhetsprisen kan du alltid finne det <em>billigste alternativet per mengde</em>,\n        uansett hvor store eller små pakkene er. Dette er en nyttig regneferdighet på handletur.\n      </p>\n      <p class=\"mt-2\">\n        <span class=\"font-semibold\">Formel:</span>\n        Enhetspris = Pris (kr) ÷ Mengde (omregnet til standardenhet)\n      </p>\n    </section>\n\n    <!-- Produkttabell -->\n    <section>\n      <div class=\"flex items-center justify-between mb-3\">\n        <h2 class=\"text-lg font-semibold text-gray-800\">Produkter</h2>\n        <button\n          id=\"addRowBtn\"\n          class=\"flex items-center gap-1.5 bg-green-600 hover:bg-green-700 text-white text-sm font-medium px-3 py-1.5 rounded-lg transition-colors\"\n        >\n          <span class=\"text-lg leading-none\">+</span> Legg til produkt\n        </button>\n      </div>\n\n      <div id=\"rowsContainer\" class=\"space-y-3\"></div>\n    </section>\n\n    <!-- Resultat -->\n    <section id=\"resultSection\" class=\"hidden\">\n      <h2 class=\"text-lg font-semibold text-gray-800 mb-3\">Resultat</h2>\n      <div id=\"resultCards\" class=\"space-y-3\"></div>\n\n      <!-- Spareindikator -->\n      <div id=\"savingsBox\" class=\"hidden mt-4 bg-green-50 border border-green-300 rounded-xl p-4\">\n        <p class=\"text-green-800 font-semibold text-sm\" id=\"savingsText\"></p>\n      </div>\n    </section>\n\n    <!-- Eksempler -->\n    <section class=\"bg-amber-50 border border-amber-200 rounded-xl p-4\">\n      <h2 class=\"font-semibold text-base text-amber-900 mb-2\">💡 Eksempler å prøve</h2>\n      <div class=\"grid sm:grid-cols-2 gap-2\" id=\"examplesContainer\"></div>\n    </section>\n\n  </main>\n\n  <footer class=\"text-center text-xs text-gray-400 py-6 mt-2\">\n    Halison App Studio · Matematikk 2P (LK20) · Enhetspris\n  </footer>\n\n<script>\n(function () {\n  'use strict';\n\n  // ── Unit normalisation ──────────────────────────────────────────────────────\n  // Returns { canonical, factor } where value_in_standard_unit = input_value * factor\n  const UNIT_INFO = {\n    // Mass → kg\n    'g':   { kind: 'mass', label: 'g',   factor: 0.001,  canonical: 'kg' },\n    'kg':  { kind: 'mass', label: 'kg',  factor: 1,      canonical: 'kg' },\n    // Volume → L\n    'mL':  { kind: 'volume', label: 'mL', factor: 0.001, canonical: 'L' },\n    'dL':  { kind: 'volume', label: 'dL', factor: 0.1,   canonical: 'L' },\n    'L':   { kind: 'volume', label: 'L',  factor: 1,     canonical: 'L' },\n    // Count\n    'stk': { kind: 'count', label: 'stk', factor: 1,     canonical: 'stk' },\n  };\n  const ALL_UNITS = Object.keys(UNIT_INFO);\n\n  function toStandard(value, unit) {\n    const info = UNIT_INFO[unit];\n    if (!info) return null;\n    return { std: value * info.factor, canonical: info.canonical, kind: info.kind };\n  }\n\n  // ── State ───────────────────────────────────────────────────────────────────\n  let rows = [];\n  let nextId = 1;\n\n  function makeRow(navn, pris, mengde, unit) {\n    return { id: nextId++, navn: navn || '', pris: pris || '', mengde: mengde || '', unit: unit || 'kg' };\n  }\n\n  // ── Persistence ─────────────────────────────────────────────────────────────\n  const LS_KEY = 'enhetspris_rows_v1';\n\n  function saveState() {\n    try { localStorage.setItem(LS_KEY, JSON.stringify(rows)); } catch (e) {}\n  }\n\n  function loadState() {\n    try {\n      const raw = localStorage.getItem(LS_KEY);\n      if (raw) {\n        const parsed = JSON.parse(raw);\n        if (Array.isArray(parsed) && parsed.length >= 2) {\n          rows = parsed;\n          // Ensure ids are consistent\n          nextId = Math.max(...rows.map(r => r.id)) + 1;\n          return true;\n        }\n      }\n    } catch (e) {}\n    return false;\n  }\n\n  // ── Default data ─────────────────────────────────────────────────────────────\n  function loadDefaults() {\n    rows = [\n      makeRow('Norvegia ost 400 g', '49.90', '400', 'g'),\n      makeRow('Norvegia ost 1 kg', '109.00', '1', 'kg'),\n      makeRow('Norvegia ost 500 g', '59.00', '500', 'g'),\n    ];\n  }\n\n  // ── Render rows ──────────────────────────────────────────────────────────────\n  function renderRows() {\n    const container = document.getElementById('rowsContainer');\n    container.innerHTML = '';\n\n    rows.forEach(function (row) {\n      const div = document.createElement('div');\n      div.className = 'row-transition bg-white rounded-xl border border-gray-200 shadow-sm p-3 flex flex-wrap gap-2 items-end';\n      div.dataset.id = row.id;\n\n      // Unit options\n      const unitOptions = ALL_UNITS.map(function (u) {\n        return '<option value=\"' + u + '\"' + (row.unit === u ? ' selected' : '') + '>' + u + '</option>';\n      }).join('');\n\n      div.innerHTML = `\n        <div class=\"flex-1 min-w-[10rem]\">\n          <label class=\"block text-xs text-gray-500 mb-1 font-medium\">Produktnavn</label>\n          <input\n            type=\"text\"\n            class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\"\n            placeholder=\"f.eks. Lettmelk 1 L\"\n            value=\"${escHtml(row.navn)}\"\n            data-field=\"navn\"\n          />\n        </div>\n        <div class=\"w-28\">\n          <label class=\"block text-xs text-gray-500 mb-1 font-medium\">Pris (kr)</label>\n          <input\n            type=\"number\"\n            min=\"0\"\n            step=\"0.01\"\n            class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\"\n            placeholder=\"f.eks. 24.90\"\n            value=\"${escHtml(row.pris)}\"\n            data-field=\"pris\"\n          />\n        </div>\n        <div class=\"w-24\">\n          <label class=\"block text-xs text-gray-500 mb-1 font-medium\">Mengde</label>\n          <input\n            type=\"number\"\n            min=\"0\"\n            step=\"any\"\n            class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\"\n            placeholder=\"f.eks. 1\"\n            value=\"${escHtml(row.mengde)}\"\n            data-field=\"mengde\"\n          />\n        </div>\n        <div class=\"w-20\">\n          <label class=\"block text-xs text-gray-500 mb-1 font-medium\">Enhet</label>\n          <select\n            class=\"unit-badge w-full border border-gray-300 rounded-lg px-2 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400 bg-white\"\n            data-field=\"unit\"\n          >${unitOptions}</select>\n        </div>\n        <div class=\"flex items-end pb-0.5\">\n          <button\n            class=\"remove-btn text-red-400 hover:text-red-600 hover:bg-red-50 rounded-lg p-2 transition-colors\"\n            title=\"Fjern produkt\"\n            ${rows.length <= 2 ? 'disabled' : ''}\n          >\n            <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M6 18L18 6M6 6l12 12\" />\n            </svg>\n          </button>\n        </div>\n      `;\n\n      // Input listeners\n      div.querySelectorAll('[data-field]').forEach(function (el) {\n        el.addEventListener('input', function () {\n          const id = parseInt(div.dataset.id);\n          const field = el.dataset.field;\n          const r = rows.find(function (x) { return x.id === id; });\n          if (r) {\n            r[field] = el.value;\n            saveState();\n            computeAndRender();\n          }\n        });\n        // Also for select\n        el.addEventListener('change', function () {\n          const id = parseInt(div.dataset.id);\n          const field = el.dataset.field;\n          const r = rows.find(function (x) { return x.id === id; });\n          if (r) {\n            r[field] = el.value;\n            saveState();\n            computeAndRender();\n          }\n        });\n      });\n\n      // Remove button\n      div.querySelector('.remove-btn').addEventListener('click', function () {\n        if (rows.length <= 2) return;\n        rows = rows.filter(function (x) { return x.id !== parseInt(div.dataset.id); });\n        saveState();\n        renderRows();\n        computeAndRender();\n      });\n\n      container.appendChild(div);\n    });\n  }\n\n  // ── Compute and render results ───────────────────────────────────────────────\n  function computeAndRender() {\n    const resultSection = document.getElementById('resultSection');\n    const resultCards = document.getElementById('resultCards');\n    const savingsBox = document.getElementById('savingsBox');\n    const savingsText = document.getElementById('savingsText');\n\n    // Compute enhetspris for each row\n    const computed = rows.map(function (row) {\n      const pris = parseFloat(row.pris);\n      const mengde = parseFloat(row.mengde);\n\n      if (!row.navn.trim() || isNaN(pris) || isNaN(mengde) || mengde <= 0 || pris < 0) {\n        return { row: row, valid: false };\n      }\n\n      const std = toStandard(mengde, row.unit);\n      if (!std) return { row: row, valid: false };\n\n      const enhetspris = pris / std.std;\n      return {\n        row: row,\n        valid: true,\n        pris: pris,\n        mengde: mengde,\n        unit: row.unit,\n        kind: std.kind,\n        canonical: std.canonical,\n        enhetspris: enhetspris,\n      };\n    });\n\n    const valid = computed.filter(function (c) { return c.valid; });\n\n    if (valid.length < 2) {\n      resultSection.classList.add('hidden');\n      return;\n    }\n\n    // Check that all valid rows share the same kind\n    const kinds = [...new Set(valid.map(function (c) { return c.kind; }))];\n    if (kinds.length > 1) {\n      // Mixed kinds — show warning\n      resultCards.innerHTML = `\n        <div class=\"bg-yellow-50 border border-yellow-300 rounded-xl p-4 text-yellow-800 text-sm\">\n          <strong>Merk:</strong> Du blander ulike enhetstyper (f.eks. vekt og volum).\n          Enhetspris kan bare sammenlignes innen samme type (alle i kg, alle i L, osv.).\n          Grupper produktene etter type for å sammenligne.\n        </div>`;\n      savingsBox.classList.add('hidden');\n      resultSection.classList.remove('hidden');\n      return;\n    }\n\n    // Sort by enhetspris ascending\n    const sorted = valid.slice().sort(function (a, b) { return a.enhetspris - b.enhetspris; });\n    const best = sorted[0];\n    const worst = sorted[sorted.length - 1];\n\n    // Render result cards in original order\n    resultCards.innerHTML = '';\n    valid.forEach(function (c) {\n      const isBest = c.enhetspris === best.enhetspris;\n      const card = document.createElement('div');\n      card.className = 'row-transition rounded-xl border p-4 flex flex-wrap gap-3 items-center justify-between ' +\n        (isBest\n          ? 'bg-green-50 border-green-400 winner-glow'\n          : 'bg-white border-gray-200');\n\n      const enhetsprisFormatted = formatKr(c.enhetspris);\n      const label = 'kr/' + c.canonical;\n\n      card.innerHTML = `\n        <div class=\"flex items-center gap-2 flex-1 min-w-0\">\n          ${isBest\n            ? '<span class=\"shrink-0 text-green-600 text-xl\" title=\"Beste kjøp\">✓</span>'\n            : '<span class=\"shrink-0 text-gray-300 text-xl\">○</span>'}\n          <span class=\"font-medium text-gray-900 truncate\">${escHtml(c.row.navn)}</span>\n        </div>\n        <div class=\"text-right shrink-0\">\n          <div class=\"text-lg font-bold ${isBest ? 'text-green-700' : 'text-gray-700'}\">\n            ${enhetsprisFormatted} <span class=\"text-sm font-normal\">${escHtml(label)}</span>\n          </div>\n          <div class=\"text-xs text-gray-400\">${formatKr(c.pris)} kr for ${c.mengde} ${escHtml(c.unit)}</div>\n        </div>\n        ${isBest\n          ? '<div class=\"w-full\"><span class=\"inline-block bg-green-100 text-green-800 text-xs font-semibold px-2 py-0.5 rounded-full\">Beste kjøp</span></div>'\n          : ''}\n      `;\n\n      resultCards.appendChild(card);\n    });\n\n    // Savings calculation: compare best to worst (by enhetspris)\n    if (valid.length >= 2 && best.enhetspris !== worst.enhetspris) {\n      const savingsPct = ((worst.enhetspris - best.enhetspris) / worst.enhetspris) * 100;\n      // How much you save per standard unit\n      const diffPerUnit = worst.enhetspris - best.enhetspris;\n      savingsText.innerHTML =\n        'Velger du <strong>' + escHtml(best.row.navn) + '</strong> fremfor <strong>' + escHtml(worst.row.navn) + '</strong> ' +\n        'sparer du <strong>' + formatKr(diffPerUnit) + ' kr/' + escHtml(best.canonical) + '</strong> ' +\n        '— det er <strong>' + savingsPct.toFixed(1) + ' %</strong> billigere per ' + escHtml(best.canonical) + '.';\n      savingsBox.classList.remove('hidden');\n    } else {\n      savingsBox.classList.add('hidden');\n    }\n\n    resultSection.classList.remove('hidden');\n  }\n\n  // ── Helpers ──────────────────────────────────────────────────────────────────\n  function escHtml(str) {\n    return String(str)\n      .replace(/&/g, '&amp;')\n      .replace(/</g, '&lt;')\n      .replace(/>/g, '&gt;')\n      .replace(/\"/g, '&quot;');\n  }\n\n  function formatKr(n) {\n    // Show up to 2 decimal places, but trim trailing zeros\n    if (n >= 100) return n.toFixed(2).replace(/\\.?0+$/, '');\n    if (n >= 10) return n.toFixed(2);\n    if (n >= 1) return n.toFixed(2);\n    return n.toFixed(4).replace(/0+$/, '').replace(/\\.$/, '');\n  }\n\n  // ── Example sets ─────────────────────────────────────────────────────────────\n  const EXAMPLES = [\n    {\n      label: 'Melk – ulike størrelser',\n      rows: [\n        { navn: 'Q-meieriene lettmelk 1 L', pris: '21.90', mengde: '1', unit: 'L' },\n        { navn: 'Q-meieriene lettmelk 1,5 L', pris: '28.90', mengde: '1.5', unit: 'L' },\n        { navn: 'Q-meieriene lettmelk 2 L', pris: '35.90', mengde: '2', unit: 'L' },\n      ]\n    },\n    {\n      label: 'Ost – g vs kg',\n      rows: [\n        { navn: 'Norvegia 400 g', pris: '49.90', mengde: '400', unit: 'g' },\n        { navn: 'Norvegia 1 kg', pris: '109.00', mengde: '1', unit: 'kg' },\n        { navn: 'Norvegia 500 g', pris: '59.00', mengde: '500', unit: 'g' },\n      ]\n    },\n    {\n      label: 'Juice – mL vs dL vs L',\n      rows: [\n        { navn: 'Appelsinjuice 200 mL', pris: '5.90', mengde: '200', unit: 'mL' },\n        { navn: 'Appelsinjuice 5 dL', pris: '12.90', mengde: '5', unit: 'dL' },\n        { navn: 'Appelsinjuice 1,5 L', pris: '28.90', mengde: '1.5', unit: 'L' },\n      ]\n    },\n    {\n      label: 'Egg – ulike antall',\n      rows: [\n        { navn: 'Egg 6 stk', pris: '24.90', mengde: '6', unit: 'stk' },\n        { navn: 'Egg 10 stk', pris: '37.90', mengde: '10', unit: 'stk' },\n        { navn: 'Egg 18 stk', pris: '59.90', mengde: '18', unit: 'stk' },\n      ]\n    },\n    {\n      label: 'Havregryn – g vs kg',\n      rows: [\n        { navn: 'Havregryn 500 g', pris: '15.90', mengde: '500', unit: 'g' },\n        { navn: 'Havregryn 1 kg', pris: '24.90', mengde: '1', unit: 'kg' },\n        { navn: 'Havregryn 2 kg', pris: '44.90', mengde: '2', unit: 'kg' },\n      ]\n    },\n    {\n      label: 'Yoghurt – ulike størrelser',\n      rows: [\n        { navn: 'Biola naturell 150 g', pris: '8.90', mengde: '150', unit: 'g' },\n        { navn: 'Biola naturell 500 g', pris: '21.90', mengde: '500', unit: 'g' },\n        { navn: 'Biola naturell 1 kg', pris: '37.90', mengde: '1', unit: 'kg' },\n      ]\n    },\n  ];\n\n  function renderExamples() {\n    const container = document.getElementById('examplesContainer');\n    EXAMPLES.forEach(function (ex) {\n      const btn = document.createElement('button');\n      btn.className =\n        'text-left px-3 py-2 bg-white border border-amber-200 rounded-lg text-sm text-amber-800 ' +\n        'hover:bg-amber-100 hover:border-amber-400 transition-colors font-medium shadow-sm';\n      btn.textContent = ex.label;\n      btn.addEventListener('click', function () {\n        nextId = 1;\n        rows = ex.rows.map(function (r) {\n          return makeRow(r.navn, r.pris, r.mengde, r.unit);\n        });\n        saveState();\n        renderRows();\n        computeAndRender();\n        document.getElementById('rowsContainer').scrollIntoView({ behavior: 'smooth', block: 'start' });\n      });\n      container.appendChild(btn);\n    });\n  }\n\n  // ── Add row button ────────────────────────────────────────────────────────────\n  document.getElementById('addRowBtn').addEventListener('click', function () {\n    rows.push(makeRow('', '', '', 'kg'));\n    saveState();\n    renderRows();\n    computeAndRender();\n    // Focus the new row's navn input\n    const allRows = document.querySelectorAll('#rowsContainer > div');\n    if (allRows.length) {\n      const lastInput = allRows[allRows.length - 1].querySelector('input[data-field=\"navn\"]');\n      if (lastInput) lastInput.focus();\n    }\n  });\n\n  // ── Init ──────────────────────────────────────────────────────────────────────\n  if (!loadState()) {\n    loadDefaults();\n  }\n  renderExamples();\n  renderRows();\n  computeAndRender();\n\n})();\n</script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Enhetspris",
    "windowTitle": "Enhetspris",
    "bundleId": "com.halisonworks.prakenhetspris",
    "iconPath": null
  },
  "categoryId": null,
  "source": "import",
  "createdAt": "2026-06-02T12:00:00.000Z",
  "updatedAt": "2026-06-02T12:00:00.000Z",
  "sharedAt": "2026-06-02T12:00:00.000Z"
}
