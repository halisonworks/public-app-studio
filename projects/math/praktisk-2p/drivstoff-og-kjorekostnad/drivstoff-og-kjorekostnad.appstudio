{
  "schema": "app-studio/canvas@1",
  "id": "example-prak-drivstoff-og-kjorekostnad",
  "name": "drivstoff-og-kjorekostnad.html",
  "code": "<!DOCTYPE html>\n<!--\n  Drivstoff og kjørekostnad — Halison App Studio-eksempel\n\n  Praktisk matematikk for 2P (LK20): regn ut drivstofforbruk og hva en kjøretur\n  koster, og sammenlikn alternativer.\n\n  Fra Halison App Studio sitt offentlige bibliotek:\n  https://github.com/halisonworks/public-app-studio\n\n  Tillatt bruk: personlig, pedagogisk og annen ikke-kommersiell bruk. Behold denne\n  headeren og kildelenken; ikke-kommersiell bruk. Utgitt under Halison App Studio\n  Examples License — se LICENSE-filen i repoet over.\n-->\n<html lang=\"no\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Drivstoff og kjørekostnad – Matematikk 2P</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    .fade-in { animation: fadeIn 0.3s ease-in; }\n    @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }\n    .step-box { border-left: 3px solid #3b82f6; }\n    .step-box-green { border-left: 3px solid #22c55e; }\n    .step-box-amber { border-left: 3px solid #f59e0b; }\n    input[type=number]::-webkit-inner-spin-button,\n    input[type=number]::-webkit-outer-spin-button { opacity: 1; }\n  </style>\n</head>\n<body class=\"bg-slate-50 min-h-screen font-sans text-slate-800\">\n\n  <!-- Header -->\n  <header class=\"bg-white border-b border-slate-200 shadow-sm\">\n    <div class=\"max-w-3xl mx-auto px-4 py-4\">\n      <div class=\"flex items-start gap-3\">\n        <div class=\"text-3xl mt-0.5\">⛽</div>\n        <div>\n          <h1 class=\"text-xl font-bold text-slate-900 leading-tight\">Drivstoff og kjørekostnad</h1>\n          <p class=\"text-sm text-slate-500 mt-0.5\">Matematikk 2P · LK20 · Praktisk bruk</p>\n        </div>\n      </div>\n    </div>\n  </header>\n\n  <main class=\"max-w-3xl mx-auto px-4 py-6 space-y-6\">\n\n    <!-- ────────────────────────────────────────────────\n         DEL 1 – Beregn én tur\n    ──────────────────────────────────────────────── -->\n    <section class=\"bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden\">\n      <div class=\"bg-blue-600 px-5 py-3\">\n        <h2 class=\"text-white font-semibold text-base\">Del 1 – Beregn kostnad for én tur</h2>\n      </div>\n\n      <div class=\"px-5 py-5 space-y-4\">\n\n        <!-- Forbruk -->\n        <div>\n          <label class=\"block text-sm font-medium text-slate-700 mb-1\" for=\"forbruk\">\n            Forbruk (liter per 100 km)\n          </label>\n          <div class=\"flex items-center gap-2\">\n            <input\n              id=\"forbruk\"\n              type=\"number\"\n              min=\"1\" max=\"30\" step=\"0.1\"\n              value=\"6.5\"\n              class=\"w-32 rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500\"\n            />\n            <span class=\"text-sm text-slate-500\">L/100 km</span>\n          </div>\n          <p class=\"text-xs text-slate-400 mt-1\">Typisk personbil: 5–8 L/100 km · SUV: 8–12 L/100 km · Hybrid: 3–5 L/100 km</p>\n        </div>\n\n        <!-- Distanse + tur/retur -->\n        <div>\n          <label class=\"block text-sm font-medium text-slate-700 mb-1\" for=\"distanse\">\n            Distanse (km)\n          </label>\n          <div class=\"flex flex-wrap items-center gap-3\">\n            <input\n              id=\"distanse\"\n              type=\"number\"\n              min=\"1\" max=\"10000\" step=\"1\"\n              value=\"150\"\n              class=\"w-32 rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500\"\n            />\n            <label class=\"flex items-center gap-2 text-sm text-slate-700 cursor-pointer select-none\">\n              <input id=\"turRetur\" type=\"checkbox\" class=\"w-4 h-4 accent-blue-600\" />\n              Tur/retur (dobbel distanse)\n            </label>\n          </div>\n          <p class=\"text-xs text-slate-400 mt-1\" id=\"distanseHint\">Faktisk kjørelengde: <span id=\"faktiskDistanse\" class=\"font-medium text-slate-600\">150 km</span></p>\n        </div>\n\n        <!-- Drivstoffpris -->\n        <div>\n          <label class=\"block text-sm font-medium text-slate-700 mb-1\" for=\"drivstoffpris\">\n            Drivstoffpris (kr/liter)\n          </label>\n          <div class=\"flex items-center gap-2\">\n            <input\n              id=\"drivstoffpris\"\n              type=\"number\"\n              min=\"5\" max=\"50\" step=\"0.10\"\n              value=\"20.50\"\n              class=\"w-32 rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500\"\n            />\n            <span class=\"text-sm text-slate-500\">kr/L</span>\n          </div>\n          <p class=\"text-xs text-slate-400 mt-1\">Bensin/diesel i Norge: typisk 18–23 kr/L</p>\n        </div>\n\n        <!-- Beregn-knapp -->\n        <button\n          id=\"btnBeregn\"\n          onclick=\"beregnTur()\"\n          class=\"w-full sm:w-auto bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white font-semibold px-6 py-2.5 rounded-xl text-sm transition-colors\"\n        >\n          Beregn kjørekostnad\n        </button>\n\n        <!-- Resultat Del 1 -->\n        <div id=\"resultatTur\" class=\"hidden fade-in space-y-3 pt-2\">\n\n          <!-- Utregning -->\n          <div class=\"bg-blue-50 rounded-xl p-4 space-y-2\">\n            <h3 class=\"font-semibold text-blue-800 text-sm mb-2\">📐 Utregning steg for steg</h3>\n\n            <div class=\"step-box bg-white rounded-lg px-4 py-2 text-sm space-y-1\">\n              <p class=\"font-medium text-slate-700\">Steg 1 – Antall liter brukt</p>\n              <p class=\"text-slate-600 font-mono text-xs\" id=\"steg1Formel\"></p>\n              <p class=\"text-slate-800 font-semibold\" id=\"steg1Svar\"></p>\n            </div>\n\n            <div class=\"step-box bg-white rounded-lg px-4 py-2 text-sm space-y-1\">\n              <p class=\"font-medium text-slate-700\">Steg 2 – Total kostnad</p>\n              <p class=\"text-slate-600 font-mono text-xs\" id=\"steg2Formel\"></p>\n              <p class=\"text-slate-800 font-semibold\" id=\"steg2Svar\"></p>\n            </div>\n\n            <div class=\"step-box bg-white rounded-lg px-4 py-2 text-sm space-y-1\">\n              <p class=\"font-medium text-slate-700\">Steg 3 – Kostnad per km</p>\n              <p class=\"text-slate-600 font-mono text-xs\" id=\"steg3Formel\"></p>\n              <p class=\"text-slate-800 font-semibold\" id=\"steg3Svar\"></p>\n            </div>\n          </div>\n\n          <!-- Oppsummering -->\n          <div class=\"grid grid-cols-3 gap-3\">\n            <div class=\"bg-slate-100 rounded-xl p-3 text-center\">\n              <p class=\"text-xs text-slate-500 mb-1\">Drivstoff brukt</p>\n              <p class=\"text-lg font-bold text-slate-800\" id=\"kortLiter\"></p>\n              <p class=\"text-xs text-slate-500\">liter</p>\n            </div>\n            <div class=\"bg-blue-100 rounded-xl p-3 text-center\">\n              <p class=\"text-xs text-blue-600 mb-1\">Total kostnad</p>\n              <p class=\"text-lg font-bold text-blue-800\" id=\"kortKostnad\"></p>\n              <p class=\"text-xs text-blue-500\">kroner</p>\n            </div>\n            <div class=\"bg-slate-100 rounded-xl p-3 text-center\">\n              <p class=\"text-xs text-slate-500 mb-1\">Kr per km</p>\n              <p class=\"text-lg font-bold text-slate-800\" id=\"kortPerKm\"></p>\n              <p class=\"text-xs text-slate-500\">kr/km</p>\n            </div>\n          </div>\n\n        </div>\n      </div>\n    </section>\n\n    <!-- ────────────────────────────────────────────────\n         DEL 2 – Sammenligning\n    ──────────────────────────────────────────────── -->\n    <section class=\"bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden\">\n      <div class=\"bg-emerald-600 px-5 py-3\">\n        <h2 class=\"text-white font-semibold text-base\">Del 2 – Sammenlign to alternativer</h2>\n      </div>\n\n      <div class=\"px-5 py-5 space-y-5\">\n\n        <p class=\"text-sm text-slate-600\">\n          Sammenlign to kjøremåter over samme distanse — f.eks. to biler med ulikt forbruk, bil mot kollektivt, eller bensin mot diesel.\n        </p>\n\n        <!-- Felles distanse -->\n        <div>\n          <label class=\"block text-sm font-medium text-slate-700 mb-1\" for=\"sammDistanse\">\n            Distanse (km)\n          </label>\n          <div class=\"flex flex-wrap items-center gap-3\">\n            <input\n              id=\"sammDistanse\"\n              type=\"number\"\n              min=\"1\" max=\"10000\" step=\"1\"\n              value=\"250\"\n              class=\"w-32 rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500\"\n            />\n            <label class=\"flex items-center gap-2 text-sm text-slate-700 cursor-pointer select-none\">\n              <input id=\"sammTurRetur\" type=\"checkbox\" class=\"w-4 h-4 accent-emerald-600\" />\n              Tur/retur\n            </label>\n          </div>\n          <p class=\"text-xs text-slate-400 mt-1\">Faktisk kjørelengde: <span id=\"sammFaktisk\" class=\"font-medium text-slate-600\">250 km</span></p>\n        </div>\n\n        <!-- Grid: Alternativ A og B -->\n        <div class=\"grid sm:grid-cols-2 gap-4\">\n\n          <!-- Alternativ A -->\n          <div class=\"border border-slate-200 rounded-xl p-4 space-y-3\">\n            <div class=\"flex items-center gap-2 mb-1\">\n              <span class=\"w-6 h-6 bg-blue-600 text-white text-xs font-bold rounded-full flex items-center justify-center\">A</span>\n              <input\n                id=\"navnA\"\n                type=\"text\"\n                value=\"Bil A – bensin\"\n                maxlength=\"40\"\n                class=\"flex-1 text-sm font-semibold border-0 border-b border-slate-200 focus:outline-none focus:border-blue-400 text-slate-800 bg-transparent py-0.5\"\n              />\n            </div>\n\n            <!-- Type A -->\n            <div>\n              <label class=\"block text-xs text-slate-500 mb-1\">Type</label>\n              <select id=\"typeA\" onchange=\"toggleTypeA()\" class=\"w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500\">\n                <option value=\"bil\">Bil (forbruk L/100 km)</option>\n                <option value=\"fast\">Fast pris (kr)</option>\n              </select>\n            </div>\n\n            <div id=\"bilFieldsA\" class=\"space-y-2\">\n              <div class=\"flex items-center gap-2\">\n                <div class=\"flex-1\">\n                  <label class=\"block text-xs text-slate-500 mb-1\">Forbruk (L/100 km)</label>\n                  <input id=\"forbrukA\" type=\"number\" min=\"1\" max=\"30\" step=\"0.1\" value=\"7.0\"\n                    class=\"w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500\" />\n                </div>\n                <div class=\"flex-1\">\n                  <label class=\"block text-xs text-slate-500 mb-1\">Pris (kr/L)</label>\n                  <input id=\"prisA\" type=\"number\" min=\"5\" max=\"50\" step=\"0.10\" value=\"20.50\"\n                    class=\"w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500\" />\n                </div>\n              </div>\n            </div>\n\n            <div id=\"fastFieldsA\" class=\"hidden\">\n              <label class=\"block text-xs text-slate-500 mb-1\">Total pris (kr)</label>\n              <input id=\"fastPrisA\" type=\"number\" min=\"0\" max=\"99999\" step=\"1\" value=\"500\"\n                class=\"w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500\" />\n              <p class=\"text-xs text-slate-400 mt-1\">F.eks. kollektivbillett, taxi, osv.</p>\n            </div>\n          </div>\n\n          <!-- Alternativ B -->\n          <div class=\"border border-slate-200 rounded-xl p-4 space-y-3\">\n            <div class=\"flex items-center gap-2 mb-1\">\n              <span class=\"w-6 h-6 bg-emerald-600 text-white text-xs font-bold rounded-full flex items-center justify-center\">B</span>\n              <input\n                id=\"navnB\"\n                type=\"text\"\n                value=\"Bil B – diesel\"\n                maxlength=\"40\"\n                class=\"flex-1 text-sm font-semibold border-0 border-b border-slate-200 focus:outline-none focus:border-emerald-400 text-slate-800 bg-transparent py-0.5\"\n              />\n            </div>\n\n            <!-- Type B -->\n            <div>\n              <label class=\"block text-xs text-slate-500 mb-1\">Type</label>\n              <select id=\"typeB\" onchange=\"toggleTypeB()\" class=\"w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500\">\n                <option value=\"bil\">Bil (forbruk L/100 km)</option>\n                <option value=\"fast\">Fast pris (kr)</option>\n              </select>\n            </div>\n\n            <div id=\"bilFieldsB\" class=\"space-y-2\">\n              <div class=\"flex items-center gap-2\">\n                <div class=\"flex-1\">\n                  <label class=\"block text-xs text-slate-500 mb-1\">Forbruk (L/100 km)</label>\n                  <input id=\"forbrukB\" type=\"number\" min=\"1\" max=\"30\" step=\"0.1\" value=\"5.5\"\n                    class=\"w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500\" />\n                </div>\n                <div class=\"flex-1\">\n                  <label class=\"block text-xs text-slate-500 mb-1\">Pris (kr/L)</label>\n                  <input id=\"prisB\" type=\"number\" min=\"5\" max=\"50\" step=\"0.10\" value=\"21.00\"\n                    class=\"w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500\" />\n                </div>\n              </div>\n            </div>\n\n            <div id=\"fastFieldsB\" class=\"hidden\">\n              <label class=\"block text-xs text-slate-500 mb-1\">Total pris (kr)</label>\n              <input id=\"fastPrisB\" type=\"number\" min=\"0\" max=\"99999\" step=\"1\" value=\"400\"\n                class=\"w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500\" />\n              <p class=\"text-xs text-slate-400 mt-1\">F.eks. kollektivbillett, taxi, osv.</p>\n            </div>\n          </div>\n\n        </div>\n\n        <!-- Sammenlign-knapp -->\n        <button\n          id=\"btnSammenlign\"\n          onclick=\"beregnSammenlikning()\"\n          class=\"w-full sm:w-auto bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white font-semibold px-6 py-2.5 rounded-xl text-sm transition-colors\"\n        >\n          Sammenlign alternativer\n        </button>\n\n        <!-- Resultat Del 2 -->\n        <div id=\"resultatSamm\" class=\"hidden fade-in space-y-3 pt-2\">\n\n          <!-- Utregning -->\n          <div class=\"bg-emerald-50 rounded-xl p-4 space-y-2\">\n            <h3 class=\"font-semibold text-emerald-800 text-sm mb-2\">📐 Utregning steg for steg</h3>\n            <div id=\"sammSteg\" class=\"space-y-2\"></div>\n          </div>\n\n          <!-- Sammenligning tabell -->\n          <div class=\"rounded-xl border border-slate-200 overflow-hidden\">\n            <table class=\"w-full text-sm\">\n              <thead class=\"bg-slate-100\">\n                <tr>\n                  <th class=\"text-left px-4 py-2 font-semibold text-slate-600\">Alternativ</th>\n                  <th class=\"text-right px-4 py-2 font-semibold text-slate-600\">Liter brukt</th>\n                  <th class=\"text-right px-4 py-2 font-semibold text-slate-600\">Totalkostnad</th>\n                  <th class=\"text-right px-4 py-2 font-semibold text-slate-600\">Kr/km</th>\n                </tr>\n              </thead>\n              <tbody id=\"sammTabell\"></tbody>\n            </table>\n          </div>\n\n          <!-- Konklusjon -->\n          <div id=\"sammKonklusjon\" class=\"rounded-xl p-4 text-sm font-medium\"></div>\n\n        </div>\n      </div>\n    </section>\n\n    <!-- ────────────────────────────────────────────────\n         Formelkort\n    ──────────────────────────────────────────────── -->\n    <section class=\"bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden\">\n      <button\n        onclick=\"toggleFormelkort()\"\n        class=\"w-full flex items-center justify-between px-5 py-3 text-left hover:bg-slate-50 transition-colors\"\n        aria-expanded=\"false\"\n        id=\"formelkortBtn\"\n      >\n        <span class=\"font-semibold text-slate-800 text-sm\">📋 Formelkort – viktige formler</span>\n        <span id=\"formelkortPil\" class=\"text-slate-400 text-lg transition-transform\">▼</span>\n      </button>\n      <div id=\"formelkortInnhold\" class=\"hidden px-5 pb-5 pt-1\">\n        <div class=\"grid sm:grid-cols-2 gap-3 text-sm\">\n\n          <div class=\"bg-blue-50 rounded-xl p-4\">\n            <p class=\"font-semibold text-blue-800 mb-2\">Antall liter</p>\n            <p class=\"font-mono text-blue-700 text-base\">liter = (forbruk / 100) × distanse</p>\n            <p class=\"text-blue-600 text-xs mt-2\">Forbruk er oppgitt i L/100 km. Del på 100 for å finne forbruk per km, gang deretter med antall km.</p>\n          </div>\n\n          <div class=\"bg-purple-50 rounded-xl p-4\">\n            <p class=\"font-semibold text-purple-800 mb-2\">Total kostnad</p>\n            <p class=\"font-mono text-purple-700 text-base\">kostnad = liter × pris per liter</p>\n            <p class=\"text-purple-600 text-xs mt-2\">Antall liter brukt multiplisert med prisen du betaler per liter drivstoff.</p>\n          </div>\n\n          <div class=\"bg-amber-50 rounded-xl p-4\">\n            <p class=\"font-semibold text-amber-800 mb-2\">Kostnad per km</p>\n            <p class=\"font-mono text-amber-700 text-base\">kr/km = kostnad / distanse</p>\n            <p class=\"text-amber-600 text-xs mt-2\">Nyttig for å sammenligne ulike kjøretøy eller reisemåter på lik basis.</p>\n          </div>\n\n          <div class=\"bg-emerald-50 rounded-xl p-4\">\n            <p class=\"font-semibold text-emerald-800 mb-2\">Besparelse</p>\n            <p class=\"font-mono text-emerald-700 text-base\">besparelse = kostnad_A − kostnad_B</p>\n            <p class=\"text-emerald-600 text-xs mt-2\">Positiv verdi betyr at alternativ B er billigst. Beregn gjerne for en hel måned eller år.</p>\n          </div>\n\n        </div>\n\n        <div class=\"mt-4 bg-slate-50 rounded-xl p-4 text-sm text-slate-600\">\n          <p class=\"font-semibold text-slate-700 mb-1\">Eksempel: Til jobb og hjem i én uke</p>\n          <p>Avstand hjemmefra til jobb: 25 km. Bil med forbruk 7,0 L/100 km. Bensinpris: 21 kr/L.</p>\n          <p class=\"mt-1\">Tur/retur per dag: 50 km · 5 dager = <strong>250 km per uke</strong></p>\n          <p class=\"mt-1\">Liter: (7,0 / 100) × 250 = <strong>17,5 L</strong></p>\n          <p class=\"mt-1\">Kostnad: 17,5 × 21 = <strong>367,50 kr</strong></p>\n          <p class=\"mt-1\">Kr/km: 367,50 / 250 ≈ <strong>1,47 kr/km</strong></p>\n        </div>\n      </div>\n    </section>\n\n    <!-- Footer -->\n    <footer class=\"text-center text-xs text-slate-400 pb-4 space-y-1\">\n      <p>Matematikk 2P · LK20 · Praktisk bruk av prosentregning og enhetsomregning</p>\n      <p>Halison App Studio · <a href=\"https://github.com/halisonworks/public-app-studio\" class=\"underline hover:text-slate-600\">github.com/halisonworks/public-app-studio</a></p>\n    </footer>\n\n  </main>\n\n  <script>\n    // ── Hjelpefunksjoner ──────────────────────────────────────────────────────\n\n    function avrund(tall, desimaler) {\n      return Math.round(tall * Math.pow(10, desimaler)) / Math.pow(10, desimaler);\n    }\n\n    function krFormat(tall) {\n      return tall.toLocaleString('nb-NO', { minimumFractionDigits: 2, maximumFractionDigits: 2 });\n    }\n\n    function litreFormat(tall) {\n      return tall.toLocaleString('nb-NO', { minimumFractionDigits: 2, maximumFractionDigits: 2 });\n    }\n\n    function hentTall(id) {\n      var val = parseFloat(document.getElementById(id).value);\n      return isNaN(val) ? 0 : val;\n    }\n\n    function hentTekst(id) {\n      return document.getElementById(id).value.trim();\n    }\n\n    // ── Del 1: Oppdater hint om faktisk distanse ──────────────────────────────\n\n    function oppdaterDistanseHint() {\n      var dist = hentTall('distanse');\n      var tr = document.getElementById('turRetur').checked;\n      var faktisk = tr ? dist * 2 : dist;\n      document.getElementById('faktiskDistanse').textContent = faktisk.toLocaleString('nb-NO') + ' km';\n    }\n\n    document.getElementById('distanse').addEventListener('input', oppdaterDistanseHint);\n    document.getElementById('turRetur').addEventListener('change', oppdaterDistanseHint);\n\n    // ── Del 1: Beregn tur ────────────────────────────────────────────────────\n\n    function beregnTur() {\n      var forbruk = hentTall('forbruk');\n      var dist = hentTall('distanse');\n      var pris = hentTall('drivstoffpris');\n      var turRetur = document.getElementById('turRetur').checked;\n\n      if (forbruk <= 0 || dist <= 0 || pris <= 0) {\n        alert('Fyll inn gyldige verdier (større enn 0) for alle feltene.');\n        return;\n      }\n\n      var faktiskDist = turRetur ? dist * 2 : dist;\n      var liter = (forbruk / 100) * faktiskDist;\n      var kostnad = liter * pris;\n      var perKm = kostnad / faktiskDist;\n\n      var turReturtekst = turRetur\n        ? '(tur/retur: ' + dist.toLocaleString('nb-NO') + ' km × 2 = ' + faktiskDist.toLocaleString('nb-NO') + ' km)'\n        : '';\n\n      // Steg 1\n      document.getElementById('steg1Formel').textContent =\n        'liter = (forbruk ÷ 100) × distanse = (' + forbruk.toLocaleString('nb-NO') + ' ÷ 100) × ' + faktiskDist.toLocaleString('nb-NO') + ' km ' + turReturtekst;\n      document.getElementById('steg1Svar').textContent =\n        '= ' + avrund(forbruk / 100, 4).toLocaleString('nb-NO', {maximumFractionDigits: 4}) + ' L/km × ' + faktiskDist.toLocaleString('nb-NO') + ' km = ' + litreFormat(liter) + ' liter';\n\n      // Steg 2\n      document.getElementById('steg2Formel').textContent =\n        'kostnad = liter × pris per liter = ' + litreFormat(liter) + ' L × ' + krFormat(pris) + ' kr/L';\n      document.getElementById('steg2Svar').textContent =\n        '= ' + krFormat(kostnad) + ' kr';\n\n      // Steg 3\n      document.getElementById('steg3Formel').textContent =\n        'kr/km = kostnad ÷ distanse = ' + krFormat(kostnad) + ' kr ÷ ' + faktiskDist.toLocaleString('nb-NO') + ' km';\n      document.getElementById('steg3Svar').textContent =\n        '= ' + krFormat(perKm) + ' kr/km';\n\n      // Kort\n      document.getElementById('kortLiter').textContent = litreFormat(liter);\n      document.getElementById('kortKostnad').textContent = krFormat(kostnad);\n      document.getElementById('kortPerKm').textContent = krFormat(perKm);\n\n      document.getElementById('resultatTur').classList.remove('hidden');\n      document.getElementById('resultatTur').classList.add('fade-in');\n    }\n\n    // ── Del 2: Oppdater hint om faktisk distanse (sammenlikning) ──────────────\n\n    function oppdaterSammDistanse() {\n      var dist = hentTall('sammDistanse');\n      var tr = document.getElementById('sammTurRetur').checked;\n      var faktisk = tr ? dist * 2 : dist;\n      document.getElementById('sammFaktisk').textContent = faktisk.toLocaleString('nb-NO') + ' km';\n    }\n\n    document.getElementById('sammDistanse').addEventListener('input', oppdaterSammDistanse);\n    document.getElementById('sammTurRetur').addEventListener('change', oppdaterSammDistanse);\n\n    // ── Del 2: Toggle type A / B ──────────────────────────────────────────────\n\n    function toggleTypeA() {\n      var type = document.getElementById('typeA').value;\n      document.getElementById('bilFieldsA').classList.toggle('hidden', type !== 'bil');\n      document.getElementById('fastFieldsA').classList.toggle('hidden', type !== 'fast');\n    }\n\n    function toggleTypeB() {\n      var type = document.getElementById('typeB').value;\n      document.getElementById('bilFieldsB').classList.toggle('hidden', type !== 'bil');\n      document.getElementById('fastFieldsB').classList.toggle('hidden', type !== 'fast');\n    }\n\n    // ── Del 2: Beregn sammenlikning ───────────────────────────────────────────\n\n    function beregnSammenlikning() {\n      var dist = hentTall('sammDistanse');\n      var tr = document.getElementById('sammTurRetur').checked;\n      var faktiskDist = tr ? dist * 2 : dist;\n\n      if (dist <= 0) {\n        alert('Fyll inn en gyldig distanse (større enn 0).');\n        return;\n      }\n\n      var navnA = hentTekst('navnA') || 'Alternativ A';\n      var navnB = hentTekst('navnB') || 'Alternativ B';\n\n      var typeA = document.getElementById('typeA').value;\n      var typeB = document.getElementById('typeB').value;\n\n      var kostnA, kostnB, literA, literB;\n\n      // --- Alternativ A ---\n      if (typeA === 'bil') {\n        var fA = hentTall('forbrukA');\n        var pA = hentTall('prisA');\n        if (fA <= 0 || pA <= 0) { alert('Fyll inn gyldige verdier for ' + navnA); return; }\n        literA = (fA / 100) * faktiskDist;\n        kostnA = literA * pA;\n      } else {\n        literA = null;\n        kostnA = hentTall('fastPrisA');\n        if (kostnA < 0) { alert('Fyll inn gyldig pris for ' + navnA); return; }\n      }\n\n      // --- Alternativ B ---\n      if (typeB === 'bil') {\n        var fB = hentTall('forbrukB');\n        var pB = hentTall('prisB');\n        if (fB <= 0 || pB <= 0) { alert('Fyll inn gyldige verdier for ' + navnB); return; }\n        literB = (fB / 100) * faktiskDist;\n        kostnB = literB * pB;\n      } else {\n        literB = null;\n        kostnB = hentTall('fastPrisB');\n        if (kostnB < 0) { alert('Fyll inn gyldig pris for ' + navnB); return; }\n      }\n\n      var perKmA = kostnA / faktiskDist;\n      var perKmB = kostnB / faktiskDist;\n\n      // --- Utregningssteg ---\n      var stegHtml = '';\n\n      var turReturtekst = tr ? ' (tur/retur: ' + dist.toLocaleString('nb-NO') + ' × 2 = ' + faktiskDist.toLocaleString('nb-NO') + ' km)' : '';\n\n      // Steg A\n      stegHtml += '<div class=\"step-box-green bg-white rounded-lg px-4 py-2 text-sm space-y-1\">';\n      stegHtml += '<p class=\"font-medium text-slate-700\">Steg 1 – Kostnad for <span class=\"text-blue-700\">' + navnA + '</span></p>';\n      if (typeA === 'bil') {\n        var fA2 = hentTall('forbrukA'), pA2 = hentTall('prisA');\n        stegHtml += '<p class=\"font-mono text-xs text-slate-500\">liter = (' + fA2.toLocaleString('nb-NO') + ' ÷ 100) × ' + faktiskDist.toLocaleString('nb-NO') + ' km' + turReturtekst + ' = ' + litreFormat(literA) + ' L</p>';\n        stegHtml += '<p class=\"font-mono text-xs text-slate-500\">kostnad = ' + litreFormat(literA) + ' L × ' + krFormat(pA2) + ' kr/L = <strong>' + krFormat(kostnA) + ' kr</strong></p>';\n      } else {\n        stegHtml += '<p class=\"font-mono text-xs text-slate-500\">Fast pris: <strong>' + krFormat(kostnA) + ' kr</strong></p>';\n      }\n      stegHtml += '</div>';\n\n      // Steg B\n      stegHtml += '<div class=\"step-box-green bg-white rounded-lg px-4 py-2 text-sm space-y-1\">';\n      stegHtml += '<p class=\"font-medium text-slate-700\">Steg 2 – Kostnad for <span class=\"text-emerald-700\">' + navnB + '</span></p>';\n      if (typeB === 'bil') {\n        var fB2 = hentTall('forbrukB'), pB2 = hentTall('prisB');\n        stegHtml += '<p class=\"font-mono text-xs text-slate-500\">liter = (' + fB2.toLocaleString('nb-NO') + ' ÷ 100) × ' + faktiskDist.toLocaleString('nb-NO') + ' km' + turReturtekst + ' = ' + litreFormat(literB) + ' L</p>';\n        stegHtml += '<p class=\"font-mono text-xs text-slate-500\">kostnad = ' + litreFormat(literB) + ' L × ' + krFormat(pB2) + ' kr/L = <strong>' + krFormat(kostnB) + ' kr</strong></p>';\n      } else {\n        stegHtml += '<p class=\"font-mono text-xs text-slate-500\">Fast pris: <strong>' + krFormat(kostnB) + ' kr</strong></p>';\n      }\n      stegHtml += '</div>';\n\n      // Steg differanse\n      var diff = Math.abs(kostnA - kostnB);\n      var billigst = kostnA < kostnB ? navnA : (kostnB < kostnA ? navnB : null);\n      stegHtml += '<div class=\"step-box-green bg-white rounded-lg px-4 py-2 text-sm space-y-1\">';\n      stegHtml += '<p class=\"font-medium text-slate-700\">Steg 3 – Differanse (besparelse)</p>';\n      stegHtml += '<p class=\"font-mono text-xs text-slate-500\">besparelse = |' + krFormat(kostnA) + ' − ' + krFormat(kostnB) + '| = <strong>' + krFormat(diff) + ' kr</strong></p>';\n      if (billigst) {\n        stegHtml += '<p class=\"font-mono text-xs text-slate-500\">→ ' + billigst + ' er billigst med ' + krFormat(diff) + ' kr i besparelse</p>';\n      } else {\n        stegHtml += '<p class=\"font-mono text-xs text-slate-500\">→ Alternativene koster like mye</p>';\n      }\n      stegHtml += '</div>';\n\n      document.getElementById('sammSteg').innerHTML = stegHtml;\n\n      // --- Tabell ---\n      var tabellHtml = '';\n      var radA = typeA === 'bil' ? litreFormat(literA) : '–';\n      var radB = typeB === 'bil' ? litreFormat(literB) : '–';\n      var erBilligstA = kostnA < kostnB;\n      var erBilligstB = kostnB < kostnA;\n\n      tabellHtml += '<tr class=\"border-t border-slate-100 ' + (erBilligstA ? 'bg-blue-50' : '') + '\">';\n      tabellHtml += '<td class=\"px-4 py-3 font-medium\">';\n      if (erBilligstA) tabellHtml += '<span class=\"inline-block mr-1 text-green-600 font-bold\">✓</span>';\n      tabellHtml += '<span class=\"inline-flex items-center gap-1\"><span class=\"w-5 h-5 bg-blue-600 text-white text-xs font-bold rounded-full flex items-center justify-center\">A</span> ' + navnA + '</span></td>';\n      tabellHtml += '<td class=\"px-4 py-3 text-right text-slate-600\">' + radA + '</td>';\n      tabellHtml += '<td class=\"px-4 py-3 text-right font-semibold ' + (erBilligstA ? 'text-green-700' : 'text-slate-800') + '\">' + krFormat(kostnA) + ' kr</td>';\n      tabellHtml += '<td class=\"px-4 py-3 text-right text-slate-600\">' + krFormat(perKmA) + ' kr</td>';\n      tabellHtml += '</tr>';\n\n      tabellHtml += '<tr class=\"border-t border-slate-100 ' + (erBilligstB ? 'bg-emerald-50' : '') + '\">';\n      tabellHtml += '<td class=\"px-4 py-3 font-medium\">';\n      if (erBilligstB) tabellHtml += '<span class=\"inline-block mr-1 text-green-600 font-bold\">✓</span>';\n      tabellHtml += '<span class=\"inline-flex items-center gap-1\"><span class=\"w-5 h-5 bg-emerald-600 text-white text-xs font-bold rounded-full flex items-center justify-center\">B</span> ' + navnB + '</span></td>';\n      tabellHtml += '<td class=\"px-4 py-3 text-right text-slate-600\">' + radB + '</td>';\n      tabellHtml += '<td class=\"px-4 py-3 text-right font-semibold ' + (erBilligstB ? 'text-green-700' : 'text-slate-800') + '\">' + krFormat(kostnB) + ' kr</td>';\n      tabellHtml += '<td class=\"px-4 py-3 text-right text-slate-600\">' + krFormat(perKmB) + ' kr</td>';\n      tabellHtml += '</tr>';\n\n      document.getElementById('sammTabell').innerHTML = tabellHtml;\n\n      // --- Konklusjon ---\n      var konklDiv = document.getElementById('sammKonklusjon');\n      if (!billigst) {\n        konklDiv.className = 'rounded-xl p-4 text-sm font-medium bg-slate-100 text-slate-700';\n        konklDiv.textContent = '⚖️ Alternativene har nøyaktig samme kostnad på ' + faktiskDist.toLocaleString('nb-NO') + ' km.';\n      } else {\n        var vinner = kostnA < kostnB ? navnA : navnB;\n        var taper = kostnA < kostnB ? navnB : navnA;\n        var prosent = avrund((diff / Math.max(kostnA, kostnB)) * 100, 1);\n        konklDiv.className = 'rounded-xl p-4 text-sm font-medium bg-green-50 text-green-800 border border-green-200';\n        konklDiv.innerHTML =\n          '✅ <strong>' + vinner + '</strong> er billigst med <strong>' + krFormat(diff) + ' kr</strong> (' +\n          prosent.toLocaleString('nb-NO') + '&nbsp;%) i besparelse over ' + faktiskDist.toLocaleString('nb-NO') + ' km sammenlignet med ' + taper + '.';\n      }\n\n      document.getElementById('resultatSamm').classList.remove('hidden');\n      document.getElementById('resultatSamm').classList.add('fade-in');\n    }\n\n    // ── Formelkort toggle ─────────────────────────────────────────────────────\n\n    function toggleFormelkort() {\n      var innhold = document.getElementById('formelkortInnhold');\n      var pil = document.getElementById('formelkortPil');\n      var btn = document.getElementById('formelkortBtn');\n      var skjult = innhold.classList.contains('hidden');\n      innhold.classList.toggle('hidden', !skjult);\n      pil.style.transform = skjult ? 'rotate(180deg)' : '';\n      btn.setAttribute('aria-expanded', skjult ? 'true' : 'false');\n    }\n  </script>\n\n</body>\n</html>\n",
  "packaging": {
    "appName": "Drivstoff og kjørekostnad",
    "windowTitle": "Drivstoff og kjørekostnad",
    "bundleId": "com.halisonworks.prakdrivstoffkjorekostnad",
    "iconPath": null
  },
  "categoryId": null,
  "source": "import",
  "createdAt": "2026-06-02T12:00:00.000Z",
  "updatedAt": "2026-06-02T12:00:00.000Z",
  "sharedAt": "2026-06-02T12:00:00.000Z"
}
