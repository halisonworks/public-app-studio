{
  "schema": "app-studio/canvas@1",
  "id": "example-prak-stromkostnad",
  "name": "stromkostnad.html",
  "code": "<!DOCTYPE html>\n<!--\n  Strømkostnad — Halison App Studio-eksempel\n\n  Praktisk matematikk for 2P (LK20): regn ut strømforbruk (kWh) og kostnad — fra\n  pris og forbruk, eller fra et apparats effekt og brukstid.\n\n  Fra Halison App Studio sitt offentlige bibliotek:\n  https://github.com/halisonworks/public-app-studio\n\n  Tillatt bruk: personlig, pedagogisk og annen ikke-kommersiell bruk. Behold denne\n  headeren og kildelenken; ikke-kommersiell bruk. Utgitt under Halison App Studio\n  Examples License — se LICENSE-filen i repoet over.\n-->\n<html lang=\"no\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Strømkostnad — 2P Matematikk</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Segoe UI', system-ui, sans-serif; }\n    .tab-active { border-bottom: 3px solid #2563eb; color: #2563eb; font-weight: 600; }\n    .tab-inactive { border-bottom: 3px solid transparent; color: #6b7280; }\n    .utregning { background: #f0f9ff; border-left: 4px solid #3b82f6; }\n    .forklaring { background: #f0fdf4; border-left: 4px solid #22c55e; }\n    input[type=number]::-webkit-inner-spin-button,\n    input[type=number]::-webkit-outer-spin-button { opacity: 0.5; }\n    .apparat-rad { transition: background 0.15s; }\n    .apparat-rad:hover { background: #f8fafc; }\n    .rad-sum { background: #eff6ff; }\n  </style>\n</head>\n<body class=\"bg-gray-50 min-h-screen\">\n\n  <!-- HEADER -->\n  <header class=\"bg-blue-700 text-white py-5 px-4 shadow-md\">\n    <div class=\"max-w-3xl mx-auto\">\n      <h1 class=\"text-2xl font-bold tracking-tight\">Strømforbruk og strømkostnad</h1>\n      <p class=\"text-blue-200 text-sm mt-1\">Matematikk 2P · LK20 · Praktisk regning</p>\n    </div>\n  </header>\n\n  <!-- FANER -->\n  <div class=\"max-w-3xl mx-auto mt-6 px-4\">\n    <div class=\"flex gap-0 border-b border-gray-200 bg-white rounded-t-lg shadow-sm overflow-hidden\">\n      <button id=\"tab-forbruk\" onclick=\"byttFane('forbruk')\"\n        class=\"flex-1 py-3 px-2 text-sm sm:text-base tab-active focus:outline-none\">\n        Modus 1 — Fra forbruk (kWh)\n      </button>\n      <button id=\"tab-apparat\" onclick=\"byttFane('apparat')\"\n        class=\"flex-1 py-3 px-2 text-sm sm:text-base tab-inactive focus:outline-none\">\n        Modus 2 — Fra apparat (W)\n      </button>\n      <button id=\"tab-forklaring\" onclick=\"byttFane('forklaring')\"\n        class=\"flex-1 py-3 px-2 text-sm sm:text-base tab-inactive focus:outline-none\">\n        Forklaring\n      </button>\n    </div>\n\n    <!-- ===== MODUS 1: FRA FORBRUK ===== -->\n    <div id=\"panel-forbruk\" class=\"bg-white rounded-b-lg shadow-sm p-5 mb-6\">\n      <h2 class=\"text-lg font-semibold text-gray-800 mb-1\">Beregn kostnad fra kjent forbruk</h2>\n      <p class=\"text-sm text-gray-500 mb-5\">\n        Skriv inn forbruket ditt (fra strømmåleren eller fakturaen) og prisen per kWh.\n      </p>\n\n      <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n        <div>\n          <label class=\"block text-sm font-medium text-gray-700 mb-1\">Forbruk (kWh)</label>\n          <input id=\"f1-forbruk\" type=\"number\" min=\"0\" step=\"0.1\" value=\"250\"\n            class=\"w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400\"\n            oninput=\"regnModus1()\" />\n        </div>\n        <div>\n          <label class=\"block text-sm font-medium text-gray-700 mb-1\">Strømpris (kr/kWh)</label>\n          <input id=\"f1-pris\" type=\"number\" min=\"0\" step=\"0.01\" value=\"1.00\"\n            class=\"w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400\"\n            oninput=\"regnModus1()\" />\n        </div>\n        <div>\n          <label class=\"block text-sm font-medium text-gray-700 mb-1\">Nettleie / påslag (øre/kWh)</label>\n          <input id=\"f1-paslag\" type=\"number\" min=\"0\" step=\"1\" value=\"45\"\n            class=\"w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400\"\n            oninput=\"regnModus1()\" />\n          <p class=\"text-xs text-gray-400 mt-1\">Typisk nettleie i Norge er 40–60 øre/kWh</p>\n        </div>\n      </div>\n\n      <div id=\"f1-resultat\" class=\"mt-5\"></div>\n    </div>\n\n    <!-- ===== MODUS 2: FRA APPARAT ===== -->\n    <div id=\"panel-apparat\" class=\"hidden bg-white rounded-b-lg shadow-sm p-5 mb-6\">\n      <h2 class=\"text-lg font-semibold text-gray-800 mb-1\">Beregn forbruk og kostnad fra apparat</h2>\n      <p class=\"text-sm text-gray-500 mb-4\">\n        Legg til ett eller flere apparater. Effekten (W) finner du ofte på typeskiltet eller i bruksanvisningen.\n      </p>\n\n      <!-- Strømpris-innstilling for modus 2 -->\n      <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4 mb-5 p-3 bg-gray-50 rounded-lg border border-gray-200\">\n        <div>\n          <label class=\"block text-sm font-medium text-gray-700 mb-1\">Strømpris (kr/kWh)</label>\n          <input id=\"f2-pris\" type=\"number\" min=\"0\" step=\"0.01\" value=\"1.00\"\n            class=\"w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400\"\n            oninput=\"regnModus2()\" />\n        </div>\n        <div>\n          <label class=\"block text-sm font-medium text-gray-700 mb-1\">Nettleie / påslag (øre/kWh)</label>\n          <input id=\"f2-paslag\" type=\"number\" min=\"0\" step=\"1\" value=\"45\"\n            class=\"w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400\"\n            oninput=\"regnModus2()\" />\n        </div>\n      </div>\n\n      <!-- Legg til apparat-skjema -->\n      <div class=\"p-4 border border-dashed border-blue-300 rounded-lg bg-blue-50 mb-5\">\n        <h3 class=\"text-sm font-semibold text-blue-800 mb-3\">Legg til apparat</h3>\n        <div class=\"grid grid-cols-1 sm:grid-cols-3 gap-3\">\n          <div class=\"sm:col-span-1\">\n            <label class=\"block text-xs font-medium text-gray-600 mb-1\">Navn på apparat</label>\n            <input id=\"ny-navn\" type=\"text\" placeholder=\"f.eks. Vaskemaskin\"\n              class=\"w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n          </div>\n          <div>\n            <label class=\"block text-xs font-medium text-gray-600 mb-1\">Effekt (W)</label>\n            <input id=\"ny-effekt\" type=\"number\" min=\"1\" step=\"1\" placeholder=\"f.eks. 2000\"\n              class=\"w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n          </div>\n          <div>\n            <label class=\"block text-xs font-medium text-gray-600 mb-1\">Bruk (timer/dag)</label>\n            <input id=\"ny-timer\" type=\"number\" min=\"0.1\" step=\"0.1\" placeholder=\"f.eks. 1.5\"\n              class=\"w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n          </div>\n        </div>\n        <button onclick=\"leggTilApparat()\"\n          class=\"mt-3 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-5 py-2 rounded-md transition-colors\">\n          + Legg til\n        </button>\n        <p id=\"ny-feil\" class=\"text-red-500 text-xs mt-2 hidden\">Fyll ut alle felt med gyldige verdier.</p>\n      </div>\n\n      <!-- Apparatliste -->\n      <div id=\"apparat-liste-wrapper\" class=\"hidden\">\n        <div class=\"overflow-x-auto rounded-lg border border-gray-200\">\n          <table class=\"w-full text-sm\">\n            <thead>\n              <tr class=\"bg-gray-100 text-gray-600 text-xs uppercase\">\n                <th class=\"text-left px-3 py-2\">Apparat</th>\n                <th class=\"text-right px-3 py-2\">Effekt (W)</th>\n                <th class=\"text-right px-3 py-2\">t/dag</th>\n                <th class=\"text-right px-3 py-2\">kWh/dag</th>\n                <th class=\"text-right px-3 py-2\">kWh/mnd</th>\n                <th class=\"text-right px-3 py-2\">kWh/år</th>\n                <th class=\"text-right px-3 py-2\">Kr/mnd</th>\n                <th class=\"px-2 py-2\"></th>\n              </tr>\n            </thead>\n            <tbody id=\"apparat-tbody\"></tbody>\n            <tfoot id=\"apparat-tfoot\"></tfoot>\n          </table>\n        </div>\n        <div id=\"f2-utregning\" class=\"mt-4\"></div>\n      </div>\n\n      <p id=\"apparat-tom-melding\" class=\"text-gray-400 text-sm text-center py-6\">\n        Ingen apparater lagt til ennå. Bruk skjemaet over.\n      </p>\n    </div>\n\n    <!-- ===== FORKLARING ===== -->\n    <div id=\"panel-forklaring\" class=\"hidden bg-white rounded-b-lg shadow-sm p-5 mb-6\">\n      <h2 class=\"text-lg font-semibold text-gray-800 mb-4\">Hva er kWh, og hva påvirker strømregninga?</h2>\n\n      <div class=\"forklaring rounded-lg p-4 mb-5\">\n        <h3 class=\"font-semibold text-green-800 mb-2\">Hva er kilowattime (kWh)?</h3>\n        <p class=\"text-gray-700 text-sm mb-2\">\n          Kilowattime er enheten vi bruker for å måle <strong>energi</strong> — altså mengden strøm som faktisk er brukt.\n        </p>\n        <p class=\"text-gray-700 text-sm mb-3\">\n          <strong>1 kWh = 1 000 watt brukt i 1 time</strong>\n        </p>\n        <div class=\"bg-white rounded p-3 text-sm font-mono text-blue-900 border border-green-200\">\n          kWh = (Effekt i watt ÷ 1 000) × antall timer\n        </div>\n        <p class=\"text-gray-600 text-sm mt-3\">\n          <strong>Eksempel:</strong> En vaskemaskin på 2 000 W (= 2 kW) som kjører i 1,5 timer bruker:\n          <br />2 kW × 1,5 timer = <strong>3 kWh</strong>\n        </p>\n      </div>\n\n      <div class=\"forklaring rounded-lg p-4 mb-5\">\n        <h3 class=\"font-semibold text-green-800 mb-2\">Hva koster strømmen?</h3>\n        <p class=\"text-gray-700 text-sm mb-2\">\n          Strømregninga din består av to hoveddeler:\n        </p>\n        <ul class=\"list-disc list-inside text-sm text-gray-700 space-y-1 mb-3\">\n          <li><strong>Strømpris (spotpris):</strong> Prisen på selve strømmen, varierer daglig. Typisk 0,50–2,00 kr/kWh.</li>\n          <li><strong>Nettleie:</strong> Betaling for å leie strømnettet (linjene frem til hjemmet ditt). Typisk 40–60 øre/kWh + et fastledd.</li>\n        </ul>\n        <p class=\"text-gray-700 text-sm\">\n          <strong>Total kostnad = Forbruk (kWh) × (strømpris + nettleie) kr/kWh</strong>\n        </p>\n      </div>\n\n      <div class=\"forklaring rounded-lg p-4 mb-5\">\n        <h3 class=\"font-semibold text-green-800 mb-2\">Hva påvirker strømregninga?</h3>\n        <ul class=\"list-disc list-inside text-sm text-gray-700 space-y-1\">\n          <li><strong>Oppvarming</strong> utgjør ofte 50–70 % av forbruket i norske hjem.</li>\n          <li><strong>Varmtvann</strong> (varmtvannsbereder) er gjerne den nest største posten.</li>\n          <li>Isolasjon og bygningens alder påvirker varmetap og dermed strømforbruket.</li>\n          <li>Hvitevarer (vaskemaskin, oppvaskmaskin, kjøleskap) bidrar merkbart.</li>\n          <li>Lading av elbil kan doble eller tredoble forbruket.</li>\n          <li>Strømpris varierer etter sesong — vinteren er dyrere enn sommeren i Norge.</li>\n        </ul>\n      </div>\n\n      <div class=\"bg-yellow-50 border border-yellow-200 rounded-lg p-4 text-sm\">\n        <h3 class=\"font-semibold text-yellow-800 mb-1\">Typiske forbrukstall for norske hjem</h3>\n        <div class=\"overflow-x-auto\">\n          <table class=\"w-full text-xs mt-2\">\n            <thead>\n              <tr class=\"text-left text-gray-600 border-b border-yellow-200\">\n                <th class=\"py-1 pr-3\">Boligtype</th>\n                <th class=\"py-1 pr-3 text-right\">Årsforbruk (kWh)</th>\n                <th class=\"py-1 text-right\">Ca. kostnad/år*</th>\n              </tr>\n            </thead>\n            <tbody class=\"text-gray-700\">\n              <tr class=\"border-b border-yellow-100\">\n                <td class=\"py-1 pr-3\">Liten leilighet (50 m²)</td>\n                <td class=\"py-1 pr-3 text-right\">5 000</td>\n                <td class=\"py-1 text-right\">7 500 kr</td>\n              </tr>\n              <tr class=\"border-b border-yellow-100\">\n                <td class=\"py-1 pr-3\">Mellomstor leilighet (80 m²)</td>\n                <td class=\"py-1 pr-3 text-right\">10 000</td>\n                <td class=\"py-1 text-right\">15 000 kr</td>\n              </tr>\n              <tr class=\"border-b border-yellow-100\">\n                <td class=\"py-1 pr-3\">Enebolig (150 m²)</td>\n                <td class=\"py-1 pr-3 text-right\">20 000</td>\n                <td class=\"py-1 text-right\">30 000 kr</td>\n              </tr>\n              <tr>\n                <td class=\"py-1 pr-3\">Stor enebolig (250 m²)</td>\n                <td class=\"py-1 pr-3 text-right\">30 000</td>\n                <td class=\"py-1 text-right\">45 000 kr</td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n        <p class=\"text-xs text-gray-500 mt-2\">* Beregnet med 1,50 kr/kWh (strømpris + nettleie)</p>\n      </div>\n    </div>\n\n  </div><!-- /max-w-3xl -->\n\n  <footer class=\"text-center text-xs text-gray-400 pb-8 mt-2\">\n    Halison App Studio · Matematikk 2P · Kun til pedagogisk bruk\n  </footer>\n\n<script>\n  // ===== HJELPEFUNKSJONER =====\n\n  function nr(val, desimaler) {\n    return Number(val).toLocaleString('nb-NO', {\n      minimumFractionDigits: desimaler,\n      maximumFractionDigits: desimaler\n    });\n  }\n\n  function valNum(id) {\n    var v = parseFloat(document.getElementById(id).value);\n    return isNaN(v) ? 0 : v;\n  }\n\n  // ===== FANER =====\n\n  function byttFane(fane) {\n    var faner = ['forbruk', 'apparat', 'forklaring'];\n    faner.forEach(function(f) {\n      var tab = document.getElementById('tab-' + f);\n      var panel = document.getElementById('panel-' + f);\n      if (f === fane) {\n        tab.className = tab.className.replace('tab-inactive', 'tab-active');\n        panel.classList.remove('hidden');\n      } else {\n        tab.className = tab.className.replace('tab-active', 'tab-inactive');\n        panel.classList.add('hidden');\n      }\n    });\n  }\n\n  // ===== MODUS 1: FRA FORBRUK =====\n\n  function regnModus1() {\n    var forbruk = valNum('f1-forbruk');\n    var pris = valNum('f1-pris');\n    var paslag = valNum('f1-paslag');\n    var paslagKr = paslag / 100;\n    var totalPris = pris + paslagKr;\n    var kostnad = forbruk * totalPris;\n    var div = document.getElementById('f1-resultat');\n\n    if (forbruk <= 0 || pris <= 0) {\n      div.innerHTML = '';\n      return;\n    }\n\n    var paslagLinje = '';\n    if (paslag > 0) {\n      paslagLinje = '<tr><td class=\"py-1 text-gray-600\">+ Nettleie/påslag</td>'\n        + '<td class=\"py-1 text-right font-mono\">' + nr(paslag, 0) + ' øre/kWh</td>'\n        + '<td class=\"py-1 text-right font-mono\">= ' + nr(paslagKr, 2) + ' kr/kWh</td></tr>';\n    }\n\n    div.innerHTML = '<div class=\"utregning rounded-lg p-4 mb-3\">'\n      + '<h3 class=\"font-semibold text-blue-800 mb-3\">Utregning</h3>'\n      + '<div class=\"overflow-x-auto\">'\n      + '<table class=\"w-full text-sm mb-3\">'\n      + '<tbody>'\n      + '<tr><td class=\"py-1 text-gray-600\">Forbruk</td>'\n      + '    <td class=\"py-1 text-right font-mono\" colspan=\"2\">' + nr(forbruk, 2) + ' kWh</td></tr>'\n      + '<tr><td class=\"py-1 text-gray-600\">Strømpris</td>'\n      + '    <td class=\"py-1 text-right font-mono\" colspan=\"2\">' + nr(pris, 2) + ' kr/kWh</td></tr>'\n      + paslagLinje\n      + '<tr class=\"border-t border-blue-200\"><td class=\"py-1 font-medium\">Total pris per kWh</td>'\n      + '    <td class=\"py-1 text-right font-mono\" colspan=\"2\">' + nr(totalPris, 4) + ' kr/kWh</td></tr>'\n      + '</tbody>'\n      + '</table>'\n      + '<div class=\"bg-white rounded p-3 font-mono text-sm text-blue-900 border border-blue-200 mb-2\">'\n      + 'Kostnad = ' + nr(forbruk, 2) + ' kWh × ' + nr(totalPris, 4) + ' kr/kWh'\n      + '<br/>Kostnad = <strong>' + nr(kostnad, 2) + ' kr</strong>'\n      + '</div>'\n      + '</div>'\n      + '</div>'\n      + '<div class=\"grid grid-cols-1 sm:grid-cols-3 gap-3\">'\n      + lagResultatKort('Strømpris alene', nr(forbruk * pris, 2) + ' kr', 'bg-blue-50 border-blue-200')\n      + (paslag > 0 ? lagResultatKort('Nettleie/påslag', nr(forbruk * paslagKr, 2) + ' kr', 'bg-purple-50 border-purple-200') : '')\n      + lagResultatKort('Total kostnad', nr(kostnad, 2) + ' kr', 'bg-green-50 border-green-300 font-bold')\n      + '</div>';\n  }\n\n  function lagResultatKort(tittel, verdi, klasser) {\n    return '<div class=\"rounded-lg border p-3 text-center ' + klasser + '\">'\n      + '<div class=\"text-xs text-gray-500 mb-1\">' + tittel + '</div>'\n      + '<div class=\"text-lg font-bold text-gray-800\">' + verdi + '</div>'\n      + '</div>';\n  }\n\n  // ===== MODUS 2: FRA APPARAT =====\n\n  var apparater = [];\n\n  function lastFraStorage() {\n    try {\n      var data = localStorage.getItem('stromkostnad-apparater');\n      if (data) apparater = JSON.parse(data);\n    } catch(e) { apparater = []; }\n  }\n\n  function lagreTilStorage() {\n    try {\n      localStorage.setItem('stromkostnad-apparater', JSON.stringify(apparater));\n    } catch(e) {}\n  }\n\n  function leggTilApparat() {\n    var navn = document.getElementById('ny-navn').value.trim();\n    var effekt = parseFloat(document.getElementById('ny-effekt').value);\n    var timer = parseFloat(document.getElementById('ny-timer').value);\n    var feil = document.getElementById('ny-feil');\n\n    if (!navn || isNaN(effekt) || effekt <= 0 || isNaN(timer) || timer <= 0) {\n      feil.classList.remove('hidden');\n      return;\n    }\n    feil.classList.add('hidden');\n\n    apparater.push({ navn: navn, effekt: effekt, timer: timer });\n    lagreTilStorage();\n\n    document.getElementById('ny-navn').value = '';\n    document.getElementById('ny-effekt').value = '';\n    document.getElementById('ny-timer').value = '';\n\n    regnModus2();\n  }\n\n  function fjernApparat(idx) {\n    apparater.splice(idx, 1);\n    lagreTilStorage();\n    regnModus2();\n  }\n\n  function regnModus2() {\n    var pris = valNum('f2-pris');\n    var paslag = valNum('f2-paslag');\n    var paslagKr = paslag / 100;\n    var totalPris = pris + paslagKr;\n\n    var tbody = document.getElementById('apparat-tbody');\n    var tfoot = document.getElementById('apparat-tfoot');\n    var wrapper = document.getElementById('apparat-liste-wrapper');\n    var tomMelding = document.getElementById('apparat-tom-melding');\n    var utregningDiv = document.getElementById('f2-utregning');\n\n    if (apparater.length === 0) {\n      wrapper.classList.add('hidden');\n      tomMelding.classList.remove('hidden');\n      utregningDiv.innerHTML = '';\n      return;\n    }\n\n    wrapper.classList.remove('hidden');\n    tomMelding.classList.add('hidden');\n\n    var sumKwhDag = 0, sumKwhMnd = 0, sumKwhAar = 0, sumKrMnd = 0;\n\n    var rader = '';\n    apparater.forEach(function(a, i) {\n      var kwhDag = (a.effekt / 1000) * a.timer;\n      var kwhMnd = kwhDag * 30;\n      var kwhAar = kwhDag * 365;\n      var krMnd = kwhMnd * totalPris;\n      sumKwhDag += kwhDag;\n      sumKwhMnd += kwhMnd;\n      sumKwhAar += kwhAar;\n      sumKrMnd += krMnd;\n\n      rader += '<tr class=\"apparat-rad border-b border-gray-100\">'\n        + '<td class=\"px-3 py-2 text-gray-800\">' + escHtml(a.navn) + '</td>'\n        + '<td class=\"px-3 py-2 text-right font-mono text-gray-700\">' + nr(a.effekt, 0) + '</td>'\n        + '<td class=\"px-3 py-2 text-right font-mono text-gray-700\">' + nr(a.timer, 1) + '</td>'\n        + '<td class=\"px-3 py-2 text-right font-mono text-gray-700\">' + nr(kwhDag, 3) + '</td>'\n        + '<td class=\"px-3 py-2 text-right font-mono text-gray-700\">' + nr(kwhMnd, 2) + '</td>'\n        + '<td class=\"px-3 py-2 text-right font-mono text-gray-700\">' + nr(kwhAar, 1) + '</td>'\n        + '<td class=\"px-3 py-2 text-right font-mono font-medium text-blue-700\">' + nr(krMnd, 2) + '</td>'\n        + '<td class=\"px-2 py-2 text-center\">'\n        + '<button onclick=\"fjernApparat(' + i + ')\" title=\"Fjern\" '\n        + 'class=\"text-red-400 hover:text-red-600 text-lg leading-none focus:outline-none\">×</button>'\n        + '</td>'\n        + '</tr>';\n    });\n\n    tbody.innerHTML = rader;\n\n    tfoot.innerHTML = '<tr class=\"rad-sum font-semibold\">'\n      + '<td class=\"px-3 py-2 text-gray-800\">Totalt</td>'\n      + '<td class=\"px-3 py-2\"></td>'\n      + '<td class=\"px-3 py-2\"></td>'\n      + '<td class=\"px-3 py-2 text-right font-mono\">' + nr(sumKwhDag, 3) + '</td>'\n      + '<td class=\"px-3 py-2 text-right font-mono\">' + nr(sumKwhMnd, 2) + '</td>'\n      + '<td class=\"px-3 py-2 text-right font-mono\">' + nr(sumKwhAar, 1) + '</td>'\n      + '<td class=\"px-3 py-2 text-right font-mono text-blue-800\">' + nr(sumKrMnd, 2) + '</td>'\n      + '<td></td>'\n      + '</tr>';\n\n    // Vis utregning for det første apparatet som eksempel\n    var a0 = apparater[0];\n    var kwhDag0 = (a0.effekt / 1000) * a0.timer;\n    var kwhMnd0 = kwhDag0 * 30;\n    var krMnd0 = kwhMnd0 * totalPris;\n\n    utregningDiv.innerHTML = '<div class=\"utregning rounded-lg p-4 mt-4\">'\n      + '<h3 class=\"font-semibold text-blue-800 mb-2\">Utregning — eksempel: ' + escHtml(a0.navn) + '</h3>'\n      + '<div class=\"font-mono text-sm text-blue-900 bg-white rounded p-3 border border-blue-200 space-y-1\">'\n      + '<div>kWh/dag = (' + nr(a0.effekt, 0) + ' W ÷ 1 000) × ' + nr(a0.timer, 1) + ' t = <strong>' + nr(kwhDag0, 3) + ' kWh/dag</strong></div>'\n      + '<div>kWh/mnd = ' + nr(kwhDag0, 3) + ' × 30 dager = <strong>' + nr(kwhMnd0, 2) + ' kWh/mnd</strong></div>'\n      + '<div>Kostnad/mnd = ' + nr(kwhMnd0, 2) + ' kWh × ' + nr(totalPris, 4) + ' kr/kWh = <strong>' + nr(krMnd0, 2) + ' kr/mnd</strong></div>'\n      + '</div>'\n      + '</div>'\n      + '<div class=\"grid grid-cols-1 sm:grid-cols-3 gap-3 mt-4\">'\n      + lagResultatKort('Totalt kWh/mnd', nr(sumKwhMnd, 1) + ' kWh', 'bg-blue-50 border-blue-200')\n      + lagResultatKort('Totalt kWh/år', nr(sumKwhAar, 0) + ' kWh', 'bg-purple-50 border-purple-200')\n      + lagResultatKort('Totalt kr/mnd', nr(sumKrMnd, 2) + ' kr', 'bg-green-50 border-green-300 font-bold')\n      + '</div>';\n  }\n\n  function escHtml(s) {\n    return String(s)\n      .replace(/&/g, '&amp;')\n      .replace(/</g, '&lt;')\n      .replace(/>/g, '&gt;')\n      .replace(/\"/g, '&quot;');\n  }\n\n  // ===== INIT =====\n\n  lastFraStorage();\n  regnModus1();\n  regnModus2();\n</script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Strømkostnad",
    "windowTitle": "Strømkostnad",
    "bundleId": "com.halisonworks.prakstromkostnad",
    "iconPath": null
  },
  "categoryId": null,
  "source": "import",
  "createdAt": "2026-06-02T12:00:00.000Z",
  "updatedAt": "2026-06-02T12:00:00.000Z",
  "sharedAt": "2026-06-02T12:00:00.000Z"
}
