{
  "schema": "app-studio/canvas@1",
  "id": "example-math-eksamenstrening2p",
  "name": "eksamenstrening-2p.html",
  "code": "<!DOCTYPE html>\n<!--\n  Eksamenstrening 2P — Halison App Studio-eksempel\n\n  Interaktivt øvings- og eksamensverktøy for matematikk 2P (LK20): tilfeldige\n  oppgaver med hint og fasit, i Del 1- (uten hjelpemidler) og Del 2-format.\n\n  Fra Halison App Studio sitt offentlige bibliotek:\n  https://github.com/halisonworks/public-app-studio\n\n  Tillatt bruk: personlig, pedagogisk og annen ikke-kommersiell bruk. Behold denne\n  headeren og kildelenken; ikke-kommersiell bruk. Utgitt under Halison App Studio\n  Examples License — se LICENSE-filen i repoet over.\n-->\n<html lang=\"no\">\n<head>\n<meta charset=\"UTF-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n<title>Eksamenstrening 2P</title>\n<script src=\"https://cdn.tailwindcss.com\"></script>\n<style>\n  body { font-family: 'Segoe UI', system-ui, sans-serif; }\n  .fade-in { animation: fadeIn 0.3s ease-in; }\n  @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }\n  .topic-btn.active { background-color: #1d4ed8; color: white; }\n  .topic-btn { transition: all 0.15s; }\n  input[type=number]::-webkit-inner-spin-button { opacity: 1; }\n  .correct-flash { animation: correctPulse 0.4s ease; }\n  @keyframes correctPulse { 0%,100% { background-color: inherit; } 50% { background-color: #d1fae5; } }\n  .wrong-flash { animation: wrongPulse 0.4s ease; }\n  @keyframes wrongPulse { 0%,100% { background-color: inherit; } 50% { background-color: #fee2e2; } }\n  .math-display { font-family: 'Courier New', monospace; background: #f8fafc; border-left: 3px solid #3b82f6; padding: 0.5rem 0.75rem; border-radius: 0 6px 6px 0; margin: 0.25rem 0; }\n  .fasit-step { counter-increment: step; }\n  .fasit-step::before { content: counter(step) \". \"; font-weight: bold; color: #1d4ed8; }\n  .steps-list { counter-reset: step; }\n</style>\n</head>\n<body class=\"bg-gray-50 min-h-screen\">\n\n<!-- Header -->\n<header class=\"bg-blue-700 text-white shadow-lg\">\n  <div class=\"max-w-3xl mx-auto px-4 py-4 flex items-center justify-between\">\n    <div>\n      <h1 class=\"text-xl font-bold tracking-tight\">Eksamenstrening 2P</h1>\n      <p class=\"text-blue-200 text-sm\">Matematikk · LK20</p>\n    </div>\n    <div class=\"text-right\">\n      <div id=\"score-display\" class=\"text-lg font-semibold\">0 / 0</div>\n      <div class=\"text-blue-200 text-xs\">riktige svar</div>\n    </div>\n  </div>\n</header>\n\n<!-- Del-toggle + topic filter -->\n<div class=\"max-w-3xl mx-auto px-4 pt-4\">\n  <div class=\"flex gap-2 mb-4 flex-wrap items-center\">\n    <span class=\"text-sm font-semibold text-gray-600 mr-1\">Del:</span>\n    <button id=\"btn-del1\" onclick=\"setDel(1)\"\n      class=\"px-4 py-1.5 rounded-full text-sm font-medium border-2 border-blue-600 text-blue-700 hover:bg-blue-600 hover:text-white transition-all\">\n      Del 1 – uten hjelpemidler\n    </button>\n    <button id=\"btn-del2\" onclick=\"setDel(2)\"\n      class=\"px-4 py-1.5 rounded-full text-sm font-medium border-2 border-gray-300 text-gray-600 hover:bg-gray-200 transition-all\">\n      Del 2 – med hjelpemidler\n    </button>\n  </div>\n\n  <div class=\"flex gap-2 flex-wrap mb-4\">\n    <span class=\"text-sm font-semibold text-gray-600 self-center mr-1\">Emne:</span>\n    <button class=\"topic-btn active px-3 py-1 rounded-full text-sm border border-blue-300 bg-blue-100 text-blue-800\" data-topic=\"alle\" onclick=\"setTopic('alle', this)\">Alle emner</button>\n    <button class=\"topic-btn px-3 py-1 rounded-full text-sm border border-gray-200 bg-white text-gray-700\" data-topic=\"prosent\" onclick=\"setTopic('prosent', this)\">Prosent</button>\n    <button class=\"topic-btn px-3 py-1 rounded-full text-sm border border-gray-200 bg-white text-gray-700\" data-topic=\"vekst\" onclick=\"setTopic('vekst', this)\">Vekstfaktor</button>\n    <button class=\"topic-btn px-3 py-1 rounded-full text-sm border border-gray-200 bg-white text-gray-700\" data-topic=\"potenser\" onclick=\"setTopic('potenser', this)\">Potenser</button>\n    <button class=\"topic-btn px-3 py-1 rounded-full text-sm border border-gray-200 bg-white text-gray-700\" data-topic=\"statistikk\" onclick=\"setTopic('statistikk', this)\">Statistikk</button>\n    <button class=\"topic-btn px-3 py-1 rounded-full text-sm border border-gray-200 bg-white text-gray-700\" data-topic=\"funksjoner\" onclick=\"setTopic('funksjoner', this)\">Funksjoner</button>\n    <button class=\"topic-btn px-3 py-1 rounded-full text-sm border border-gray-200 bg-white text-gray-700\" data-topic=\"tid\" onclick=\"setTopic('tid', this)\">Tid</button>\n  </div>\n</div>\n\n<!-- Task card -->\n<main class=\"max-w-3xl mx-auto px-4 pb-16\">\n  <div id=\"task-card\" class=\"bg-white rounded-xl shadow-md p-6 fade-in\">\n\n    <!-- Topic badge + del badge -->\n    <div class=\"flex items-center gap-2 mb-3 flex-wrap\">\n      <span id=\"badge-topic\" class=\"px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-100 text-blue-800\"></span>\n      <span id=\"badge-del\" class=\"px-2.5 py-0.5 rounded-full text-xs font-semibold bg-gray-100 text-gray-600\"></span>\n      <span id=\"badge-num\" class=\"ml-auto text-xs text-gray-400\">Oppgave <span id=\"task-counter\">1</span></span>\n    </div>\n\n    <!-- Task text -->\n    <div id=\"task-text\" class=\"text-gray-800 text-base leading-relaxed mb-4\"></div>\n\n    <!-- Answer input -->\n    <div id=\"answer-area\" class=\"mb-4\">\n      <label class=\"block text-sm font-medium text-gray-700 mb-1\">Ditt svar:</label>\n      <div class=\"flex gap-2\">\n        <input id=\"answer-input\" type=\"text\" inputmode=\"decimal\"\n          class=\"flex-1 border border-gray-300 rounded-lg px-3 py-2 text-base focus:outline-none focus:ring-2 focus:ring-blue-400\"\n          placeholder=\"Skriv svaret her...\" onkeydown=\"if(event.key==='Enter')checkAnswer()\" />\n        <button onclick=\"checkAnswer()\"\n          class=\"px-4 py-2 bg-blue-600 text-white rounded-lg font-medium hover:bg-blue-700 active:scale-95 transition-all text-sm\">\n          Sjekk\n        </button>\n      </div>\n      <div id=\"answer-unit\" class=\"text-xs text-gray-500 mt-1\"></div>\n    </div>\n\n    <!-- Feedback -->\n    <div id=\"feedback\" class=\"hidden mb-4 rounded-lg px-4 py-3 text-sm font-medium\"></div>\n\n    <!-- Action buttons -->\n    <div class=\"flex gap-2 flex-wrap\">\n      <button id=\"btn-hint\" onclick=\"showHint()\"\n        class=\"px-4 py-2 rounded-lg border border-yellow-400 text-yellow-700 bg-yellow-50 hover:bg-yellow-100 text-sm font-medium transition-all\">\n        💡 Hint\n      </button>\n      <button id=\"btn-fasit\" onclick=\"showFasit()\"\n        class=\"px-4 py-2 rounded-lg border border-green-400 text-green-700 bg-green-50 hover:bg-green-100 text-sm font-medium transition-all\">\n        Vis fasit\n      </button>\n      <button onclick=\"newTask()\"\n        class=\"ml-auto px-4 py-2 rounded-lg bg-blue-600 text-white hover:bg-blue-700 text-sm font-medium transition-all active:scale-95\">\n        Ny oppgave →\n      </button>\n    </div>\n\n    <!-- Hint box -->\n    <div id=\"hint-box\" class=\"hidden mt-4 bg-yellow-50 border border-yellow-200 rounded-lg px-4 py-3 text-sm text-gray-700\"></div>\n\n    <!-- Fasit box -->\n    <div id=\"fasit-box\" class=\"hidden mt-4 bg-green-50 border border-green-300 rounded-lg px-4 py-3\">\n      <div class=\"font-semibold text-green-800 mb-2 text-sm\">Fasit – fullstendig løsning</div>\n      <div id=\"fasit-content\" class=\"text-sm text-gray-700 steps-list space-y-1\"></div>\n    </div>\n\n  </div>\n\n  <!-- Stats bar -->\n  <div class=\"mt-4 bg-white rounded-xl shadow-sm px-6 py-4 flex gap-6 text-center flex-wrap justify-center\">\n    <div>\n      <div id=\"stat-done\" class=\"text-2xl font-bold text-blue-700\">0</div>\n      <div class=\"text-xs text-gray-500\">Oppgaver gjort</div>\n    </div>\n    <div>\n      <div id=\"stat-correct\" class=\"text-2xl font-bold text-green-600\">0</div>\n      <div class=\"text-xs text-gray-500\">Riktige</div>\n    </div>\n    <div>\n      <div id=\"stat-pct\" class=\"text-2xl font-bold text-gray-700\">–</div>\n      <div class=\"text-xs text-gray-500\">Prosent riktig</div>\n    </div>\n    <div class=\"ml-auto flex items-center\">\n      <button onclick=\"resetStats()\" class=\"text-xs text-red-400 hover:text-red-600 underline\">Nullstill statistikk</button>\n    </div>\n  </div>\n</main>\n\n<script>\n// ─── State ────────────────────────────────────────────────────────────────────\nvar state = {\n  del: 1,\n  topic: 'alle',\n  tasksDone: 0,\n  correct: 0,\n  currentTask: null,\n  hintShown: false,\n  fasitShown: false,\n  answeredCorrectly: false\n};\n\n// ─── localStorage ─────────────────────────────────────────────────────────────\nfunction loadStats() {\n  try {\n    var s = JSON.parse(localStorage.getItem('2p-stats') || '{}');\n    state.tasksDone = s.tasksDone || 0;\n    state.correct = s.correct || 0;\n  } catch(e) {}\n}\nfunction saveStats() {\n  try {\n    localStorage.setItem('2p-stats', JSON.stringify({tasksDone: state.tasksDone, correct: state.correct}));\n  } catch(e) {}\n}\nfunction resetStats() {\n  state.tasksDone = 0;\n  state.correct = 0;\n  saveStats();\n  updateStatsUI();\n}\n\n// ─── Random helpers ───────────────────────────────────────────────────────────\nfunction rInt(min, max) { return Math.floor(Math.random() * (max - min + 1)) + min; }\nfunction rChoice(arr) { return arr[Math.floor(Math.random() * arr.length)]; }\nfunction round2(x) { return Math.round(x * 100) / 100; }\nfunction round1(x) { return Math.round(x * 10) / 10; }\nfunction fmtNum(x) {\n  if (Math.abs(x - Math.round(x)) < 0.001) return Math.round(x).toString();\n  return round2(x).toString().replace('.', ',');\n}\nfunction fmtMoney(x) {\n  var rounded = Math.round(x);\n  return rounded.toLocaleString('nb-NO') + ' kr';\n}\n\n// ─── Numeric comparison (tolerant) ────────────────────────────────────────────\nfunction parseAnswer(s) {\n  if (s === null || s === undefined) return NaN;\n  return parseFloat(s.toString().trim().replace(',', '.').replace(/\\s/g, '').replace(/[^\\d.\\-]/g, ''));\n}\nfunction numClose(userStr, correct, tol) {\n  tol = tol || 0.011;\n  var user = parseAnswer(userStr);\n  if (isNaN(user)) return false;\n  if (Math.abs(correct) < 0.001) return Math.abs(user) < tol;\n  return Math.abs(user - correct) / (Math.abs(correct) + 0.001) < tol || Math.abs(user - correct) < tol;\n}\n\n// ─── Task generators ──────────────────────────────────────────────────────────\n// Each generator returns: { topic, text, hint, answer, answerDisplay, unit, fasit }\n\nvar generators = {\n\n  // ── PROSENT ──────────────────────────────────────────────────────────────────\n  prosent_grunnverdi: function(del) {\n    var pct = del===1 ? rChoice([10,20,25,50]) : rChoice([15,18,22,35,45]);\n    var result = del===1 ? rInt(2,20)*10 : rInt(10,200)*5;\n    var base = round2(result / (pct/100));\n    var text = 'En vare koster ' + fmtMoney(result) + ' etter at prisen ble satt ned med ' + pct + ' %. Hva var den opprinnelige prisen?';\n    var fasit = [\n      'La opprinnelig pris = x.',\n      'Etter ' + pct + ' % rabatt: x · (1 − ' + pct + '/100) = x · ' + fmtNum(1 - pct/100),\n      'x · ' + fmtNum(1 - pct/100) + ' = ' + fmtMoney(result),\n      'x = ' + fmtMoney(result) + ' ÷ ' + fmtNum(1 - pct/100) + ' = ' + fmtMoney(base)\n    ];\n    return { topic:'Prosent', text:text, hint:'Sett opp: x · (1 − p/100) = kjent verdi', answer:base, answerDisplay:fmtMoney(base), unit:'kr', fasit:fasit };\n  },\n\n  prosent_prosentdel: function(del) {\n    var base = del===1 ? rInt(2,20)*50 : rInt(10,400)*25;\n    var del_val = rInt(1,9)*10 + rInt(0,4)*5;\n    while(del_val >= base) del_val = rInt(5, Math.floor(base*0.8));\n    var pct = round2(del_val / base * 100);\n    var text = 'I en klasse er det ' + base + ' elever. ' + del_val + ' av dem er jenter. Hvor mange prosent av elevene er jenter?';\n    var fasit = [\n      'Prosentdel = (del / helhet) · 100',\n      'Prosentdel = (' + del_val + ' / ' + base + ') · 100',\n      '= ' + fmtNum(del_val/base) + ' · 100 = ' + fmtNum(pct) + ' %'\n    ];\n    return { topic:'Prosent', text:text, hint:'Bruk formelen: prosentdel = (del/helhet) · 100', answer:pct, answerDisplay:fmtNum(pct) + ' %', unit:'%', fasit:fasit };\n  },\n\n  prosent_poeng: function(del) {\n    var oldPct = rInt(20,55);\n    var change = rInt(3,15);\n    var newPct = oldPct + change;\n    var text = 'Velgeroppslutningen til et parti økte fra ' + oldPct + ' % til ' + newPct + ' %. ' +\n      'Hvor mange prosentpoeng økte oppslutningen? Hvor mange prosent økte den (prosentvis endring)?';\n    var poeng = newPct - oldPct;\n    var prosentvis = round2((newPct - oldPct) / oldPct * 100);\n    var hint = 'Prosentpoeng = differansen mellom to prosenttall. Prosentvis endring = (endring/gammel verdi)·100.';\n    var fasit = [\n      'Prosentpoeng: ' + newPct + ' − ' + oldPct + ' = ' + poeng + ' prosentpoeng',\n      'Prosentvis endring: (' + poeng + ' / ' + oldPct + ') · 100 = ' + fmtNum(prosentvis) + ' %',\n      'Svar: ' + poeng + ' prosentpoeng; ' + fmtNum(prosentvis) + ' % prosentvis økning'\n    ];\n    // Two-part answer — check prosentpoeng\n    var ansText = 'Prosentpoeng: ' + poeng + ', prosentvis endring: ' + fmtNum(prosentvis) + ' %';\n    return { topic:'Prosent', text:text, hint:hint, answer:poeng, answerDisplay:ansText, unit:'prosentpoeng (skriv bare prosentpoeng-tallet)', fasit:fasit };\n  },\n\n  prosent_mva: function(del) {\n    var pris_eks = del===1 ? rInt(5,30)*100 : rInt(20,500)*50;\n    var mva_sats = rChoice([15, 25]);\n    var mva_bel = round2(pris_eks * mva_sats / 100);\n    var pris_ink = round2(pris_eks + mva_bel);\n    var text = 'En vare koster ' + fmtMoney(pris_eks) + ' ekskl. mva. MVA-satsen er ' + mva_sats + ' %. ' +\n      'Hva er prisen inkl. mva?';\n    var fasit = [\n      'MVA-beløp = ' + fmtMoney(pris_eks) + ' · ' + mva_sats + '/100 = ' + fmtMoney(mva_bel),\n      'Pris inkl. mva = ' + fmtMoney(pris_eks) + ' + ' + fmtMoney(mva_bel) + ' = ' + fmtMoney(pris_ink),\n      'Alternativt: ' + fmtMoney(pris_eks) + ' · ' + fmtNum(1 + mva_sats/100) + ' = ' + fmtMoney(pris_ink)\n    ];\n    return { topic:'Prosent', text:text, hint:'Pris inkl. mva = pris ekskl. · (1 + mva-sats/100)', answer:pris_ink, answerDisplay:fmtMoney(pris_ink), unit:'kr', fasit:fasit };\n  },\n\n  // ── VEKSTFAKTOR ──────────────────────────────────────────────────────────────\n  vekst_beregn: function(del) {\n    var startVal = del===1 ? rInt(5,30)*1000 : rInt(20,500)*1000;\n    var pctChange = del===1 ? rChoice([5,10,20,25,50]) : rChoice([3,7,12,18,24,35]);\n    var years = del===1 ? rInt(1,3) : rInt(2,6);\n    var increase = rChoice([true, true, false]);\n    var vekst = round2(1 + (increase ? pctChange : -pctChange)/100);\n    var endVal = round2(startVal * Math.pow(vekst, years));\n    var changeWord = increase ? 'økt' : 'sunket';\n    var text = 'En bolig er verdt ' + fmtMoney(startVal) + ' i dag. Boligprisene har ' + changeWord + ' med ' + pctChange +\n      ' % per år de siste ' + years + ' år' + (years===1?'':'ene') + '. Hva var boligen verdt for ' + years + ' år siden?';\n    var startReal = round2(startVal / Math.pow(vekst, years));\n    var fasit = [\n      'Vekstfaktor per år: v = 1 ' + (increase ? '+ ' : '− ') + pctChange + '/100 = ' + fmtNum(vekst),\n      'La startverdi = x.',\n      'x · v^' + years + ' = ' + fmtMoney(startVal),\n      'x = ' + fmtMoney(startVal) + ' / ' + fmtNum(vekst) + '^' + years + ' = ' + fmtMoney(startReal)\n    ];\n    return { topic:'Vekstfaktor', text:text, hint:'Bruk: startverdi · vekstfaktor^n = sluttverdi. Løs for startverdi.', answer:startReal, answerDisplay:fmtMoney(startReal), unit:'kr', fasit:fasit };\n  },\n\n  vekst_framover: function(del) {\n    var startVal = del===1 ? rInt(10,40)*1000 : rInt(50,500)*1000;\n    var pct = del===1 ? rChoice([5,10,15,20]) : rChoice([3,6,8,12,15,22]);\n    var years = del===1 ? rInt(1,4) : rInt(3,8);\n    var vekst = round2(1 + pct/100);\n    var endVal = Math.round(startVal * Math.pow(vekst, years));\n    var text = 'Et firma hadde ' + fmtMoney(startVal) + ' i omsetning. Omsetningen øker med ' + pct +\n      ' % per år. Hva er omsetningen etter ' + years + ' år?';\n    var fasit = [\n      'Vekstfaktor: v = 1 + ' + pct + '/100 = ' + fmtNum(vekst),\n      'Sluttverdi = startverdi · v^n',\n      '= ' + fmtMoney(startVal) + ' · ' + fmtNum(vekst) + '^' + years,\n      '= ' + fmtMoney(startVal) + ' · ' + fmtNum(round2(Math.pow(vekst, years))),\n      '≈ ' + fmtMoney(endVal)\n    ];\n    return { topic:'Vekstfaktor', text:text, hint:'Sluttverdi = startverdi · vekstfaktor^antall år', answer:endVal, answerDisplay:fmtMoney(endVal), unit:'kr', fasit:fasit };\n  },\n\n  vekst_finn_pct: function(del) {\n    var start = del===1 ? rInt(10,40)*100 : rInt(50,500)*100;\n    var pct = del===1 ? rChoice([10,20,25,50]) : rChoice([5,8,15,30,40]);\n    var end_val = Math.round(start * (1 + pct/100));\n    var text = 'Prisen på en mobiltelefon steg fra ' + fmtMoney(start) + ' til ' + fmtMoney(end_val) +\n      '. Hvor mange prosent steg prisen?';\n    var fasit = [\n      'Prosentvis endring = (ny − gammel) / gammel · 100',\n      '= (' + fmtMoney(end_val) + ' − ' + fmtMoney(start) + ') / ' + fmtMoney(start) + ' · 100',\n      '= ' + fmtMoney(end_val - start) + ' / ' + fmtMoney(start) + ' · 100',\n      '= ' + fmtNum(round2((end_val - start)/start*100)) + ' %'\n    ];\n    return { topic:'Vekstfaktor', text:text, hint:'Prosentvis endring = (ny − gammel) / gammel · 100', answer:pct, answerDisplay:fmtNum(pct) + ' %', unit:'%', fasit:fasit };\n  },\n\n  // ── POTENSER & STANDARDFORM ───────────────────────────────────────────────────\n  potenser_regler: function(del) {\n    var base = rInt(2,5);\n    var e1 = rInt(2,5), e2 = rInt(2,4);\n    var type = rChoice(['mul','div','pow']);\n    var text, ans, fasit;\n    if(type==='mul') {\n      ans = e1+e2;\n      text = 'Forenkle: ' + base + '^' + e1 + ' · ' + base + '^' + e2;\n      fasit = ['Potensregel: a^m · a^n = a^(m+n)', base + '^' + e1 + ' · ' + base + '^' + e2 + ' = ' + base + '^(' + e1 + '+' + e2 + ') = ' + base + '^' + ans];\n      return { topic:'Potenser', text:text, hint:'Potensregel: a^m · a^n = a^(m+n)', answer:ans, answerDisplay:base+'^'+ans+' = '+Math.pow(base,ans), unit:'Skriv eksponenten (f.eks. ' + ans + ')', fasit:fasit };\n    } else if(type==='div') {\n      var big = Math.max(e1,e2), small = Math.min(e1,e2);\n      ans = big - small;\n      text = 'Forenkle: ' + base + '^' + big + ' / ' + base + '^' + small;\n      fasit = ['Potensregel: a^m / a^n = a^(m−n)', base + '^' + big + ' / ' + base + '^' + small + ' = ' + base + '^(' + big + '−' + small + ') = ' + base + '^' + ans];\n      return { topic:'Potenser', text:text, hint:'Potensregel: a^m / a^n = a^(m−n)', answer:ans, answerDisplay:base+'^'+ans+' = '+Math.pow(base,ans), unit:'Skriv eksponenten', fasit:fasit };\n    } else {\n      ans = e1*e2;\n      text = 'Forenkle: (' + base + '^' + e1 + ')^' + e2;\n      fasit = ['Potensregel: (a^m)^n = a^(m·n)', '(' + base + '^' + e1 + ')^' + e2 + ' = ' + base + '^(' + e1 + '·' + e2 + ') = ' + base + '^' + ans];\n      return { topic:'Potenser', text:text, hint:'Potensregel: (a^m)^n = a^(m·n)', answer:ans, answerDisplay:base+'^'+ans+' = '+Math.pow(base,ans), unit:'Skriv eksponenten', fasit:fasit };\n    }\n  },\n\n  potenser_standardform: function(del) {\n    var mantissa = round2(rInt(10,99)/10);\n    var exp = del===1 ? rInt(3,6) : rInt(-3,9);\n    var realVal = mantissa * Math.pow(10, exp);\n    // ask to write in standardform\n    var text = 'Skriv tallet ' + realVal.toExponential().replace('e+','·10^').replace('e-','·10^−').replace('e','·10^') + ' i standardform (a · 10^n, der 1 ≤ a < 10). Hva er eksponenten n?';\n    // Compute real mantissa and exp\n    var expReal = Math.floor(Math.log10(Math.abs(realVal)));\n    var mReal = round2(realVal / Math.pow(10, expReal));\n    var fasit = [\n      'Standardform: a · 10^n der 1 ≤ a < 10',\n      'Flytt komma slik at a = ' + fmtNum(mReal),\n      'Vi måtte flytte komma ' + Math.abs(expReal) + ' plasser ' + (expReal>=0?'til venstre':'til høyre'),\n      'Svar: ' + fmtNum(mReal) + ' · 10^' + expReal\n    ];\n    return { topic:'Potenser', text:'Skriv tallet ' + realVal.toLocaleString('nb-NO') + ' på standardform (a · 10ⁿ, 1 ≤ a < 10). Hva er eksponenten n?', hint:'Flytt komma til det er ett siffer foran. Tell antall plasser.', answer:expReal, answerDisplay:fmtNum(mReal) + ' · 10^' + expReal, unit:'Skriv eksponenten n', fasit:fasit };\n  },\n\n  potenser_negativ: function(del) {\n    var base = rInt(2,5);\n    var neg = rInt(1,4);\n    var ans = round2(1/Math.pow(base,neg));\n    var text = 'Beregn: ' + base + '^(−' + neg + ')';\n    var fasit = [\n      'Regel: a^(−n) = 1 / a^n',\n      base + '^(−' + neg + ') = 1 / ' + base + '^' + neg,\n      '= 1 / ' + Math.pow(base,neg),\n      '= ' + ans\n    ];\n    return { topic:'Potenser', text:text, hint:'a^(−n) = 1 / a^n', answer:ans, answerDisplay:fmtNum(ans), unit:'', fasit:fasit };\n  },\n\n  // ── STATISTIKK ────────────────────────────────────────────────────────────────\n  stat_gjennomsnitt: function(del) {\n    var n = del===1 ? rInt(4,7) : rInt(5,10);\n    var data = [];\n    for(var i=0;i<n;i++) data.push(del===1 ? rInt(1,20)*5 : rInt(10,200));\n    var sum = data.reduce(function(a,b){return a+b;},0);\n    var mean = round2(sum/n);\n    var text = 'Her er karakterer fra en prøve: ' + data.join(', ') + '. Beregn gjennomsnittet.';\n    var fasit = [\n      'Gjennomsnitt = sum / antall',\n      'Sum = ' + data.join(' + ') + ' = ' + sum,\n      'Antall = ' + n,\n      'Gjennomsnitt = ' + sum + ' / ' + n + ' = ' + fmtNum(mean)\n    ];\n    return { topic:'Statistikk', text:text, hint:'Legg sammen alle verdiene og del på antallet.', answer:mean, answerDisplay:fmtNum(mean), unit:'', fasit:fasit };\n  },\n\n  stat_median: function(del) {\n    var n = del===1 ? rChoice([5,7]) : rChoice([6,8,10]);\n    var data = [];\n    for(var i=0;i<n;i++) data.push(rInt(10,100));\n    var sorted = data.slice().sort(function(a,b){return a-b;});\n    var med;\n    if(n%2===1) med = sorted[Math.floor(n/2)];\n    else med = (sorted[n/2-1]+sorted[n/2])/2;\n    var text = 'Tallrekken er: ' + data.join(', ') + '. Finn medianen.';\n    var fasit = [\n      'Sorter tallrekken: ' + sorted.join(', '),\n      n%2===1\n        ? 'n = ' + n + ' (odde). Midterste element (plass ' + (Math.floor(n/2)+1) + '): ' + med\n        : 'n = ' + n + ' (like). Medianen = gjennomsnittet av de to midterste: (' + sorted[n/2-1] + ' + ' + sorted[n/2] + ') / 2 = ' + med\n    ];\n    return { topic:'Statistikk', text:text, hint:'Sorter tallene. Ved odde antall: midterste. Ved like: gjennomsnitt av de to midterste.', answer:med, answerDisplay:fmtNum(med), unit:'', fasit:fasit };\n  },\n\n  stat_standardavvik: function(del) {\n    // Kept small for del1 manual-ish calc\n    var n = del===1 ? 4 : rInt(5,7);\n    var data = [];\n    for(var i=0;i<n;i++) data.push(del===1 ? rInt(2,8)*5 : rInt(10,100));\n    var mean = data.reduce(function(a,b){return a+b;})/n;\n    var variance = data.reduce(function(acc,x){return acc+Math.pow(x-mean,2);},0)/n;\n    var sd = round2(Math.sqrt(variance));\n    var text = 'Datasett: ' + data.join(', ') + '. Beregn standardavviket (populasjonsformelen, σ).';\n    var diffs = data.map(function(x){return round2(x-mean);});\n    var sq = diffs.map(function(d){return round2(d*d);});\n    var fasit = [\n      'Gjennomsnitt μ = (' + data.join('+') + ') / ' + n + ' = ' + fmtNum(mean),\n      'Avvik fra gjennomsnitt: ' + diffs.join(', '),\n      'Avvik²: ' + sq.join(', '),\n      'Varians σ² = (' + sq.join('+') + ') / ' + n + ' = ' + fmtNum(round2(variance)),\n      'Standardavvik σ = √' + fmtNum(round2(variance)) + ' ≈ ' + fmtNum(sd)\n    ];\n    return { topic:'Statistikk', text:text, hint:'σ = √(Σ(xᵢ−μ)² / n). Start med gjennomsnittet.', answer:sd, answerDisplay:fmtNum(sd), unit:'', fasit:fasit };\n  },\n\n  stat_boks: function(del) {\n    var n = rChoice([7,9,11]);\n    var data = [];\n    for(var i=0;i<n;i++) data.push(rInt(5,30)*2);\n    var sorted = data.slice().sort(function(a,b){return a-b;});\n    var min = sorted[0], max = sorted[n-1];\n    var med = sorted[Math.floor(n/2)];\n    // Q1 = median of lower half, Q3 = median of upper half\n    var lower = sorted.slice(0, Math.floor(n/2));\n    var upper = sorted.slice(Math.ceil(n/2));\n    var q1 = lower[Math.floor(lower.length/2)];\n    var q3 = upper[Math.floor(upper.length/2)];\n    var iqr = q3 - q1;\n    var text = 'Datasett: ' + data.join(', ') + '. Finn kvartil 1 (Q1) og kvartil 3 (Q3), og beregn den interkvartile bredden (IQB = Q3 − Q1).';\n    var fasit = [\n      'Sorter: ' + sorted.join(', '),\n      'Median (Q2) = ' + med,\n      'Nedre halvdel: ' + lower.join(', ') + ' → Q1 = ' + q1,\n      'Øvre halvdel: ' + upper.join(', ') + ' → Q3 = ' + q3,\n      'IQB = Q3 − Q1 = ' + q3 + ' − ' + q1 + ' = ' + iqr\n    ];\n    return { topic:'Statistikk', text:text, hint:'Del sortert datasett i to halvdeler. Q1 er medianen av den nedre halvdelen.', answer:iqr, answerDisplay:'Q1='+q1+', Q3='+q3+', IQB='+iqr, unit:'Skriv IQB-verdien', fasit:fasit };\n  },\n\n  // ── LINEÆRE FUNKSJONER ────────────────────────────────────────────────────────\n  funk_verdi: function(del) {\n    var a = del===1 ? rInt(1,5) : rInt(-8,8)||1;\n    var b = del===1 ? rInt(-10,20) : rInt(-50,50);\n    var x = del===1 ? rInt(1,10) : rInt(-10,20);\n    var y = a*x + b;\n    var text = 'Gitt funksjonen f(x) = ' + a + 'x ' + (b>=0?'+ ':'') + b + '. Beregn f(' + x + ').';\n    var fasit = [\n      'Sett inn x = ' + x + ' i funksjonsuttrykket:',\n      'f(' + x + ') = ' + a + ' · ' + x + ' ' + (b>=0?'+ ':'') + b,\n      '= ' + a*x + ' ' + (b>=0?'+ ':'') + b,\n      '= ' + y\n    ];\n    return { topic:'Funksjoner', text:text, hint:'Sett inn x-verdien i f(x) = ax + b og regn ut.', answer:y, answerDisplay:fmtNum(y), unit:'', fasit:fasit };\n  },\n\n  funk_stigning: function(del) {\n    var x1 = rInt(-5,5), y1 = rInt(-10,10);\n    var x2 = x1 + rInt(1,6), y2 = rInt(-10,20);\n    while(x2===x1) x2 = x1 + rInt(1,5);\n    var a = round2((y2-y1)/(x2-x1));\n    var text = 'To punkter på en rett linje er A(' + x1 + ', ' + y1 + ') og B(' + x2 + ', ' + y2 + '). Finn stigningstallet a.';\n    var fasit = [\n      'Stigningstall a = (y₂ − y₁) / (x₂ − x₁)',\n      'a = (' + y2 + ' − ' + y1 + ') / (' + x2 + ' − ' + x1 + ')',\n      '= ' + (y2-y1) + ' / ' + (x2-x1),\n      '= ' + fmtNum(a)\n    ];\n    return { topic:'Funksjoner', text:text, hint:'Stigningstall a = (y₂ − y₁) / (x₂ − x₁)', answer:a, answerDisplay:fmtNum(a), unit:'', fasit:fasit };\n  },\n\n  funk_likning: function(del) {\n    var a = del===1 ? rInt(1,4) : rInt(-5,6)||1;\n    var b = del===1 ? rInt(-10,10) : rInt(-30,30);\n    var y = del===1 ? rInt(-20,30) : rInt(-100,100);\n    var x = round2((y-b)/a);\n    var text = 'Løs likningen: ' + a + 'x ' + (b>=0?'+ ':'') + b + ' = ' + y;\n    var fasit = [\n      a + 'x ' + (b>=0?'+ ':'') + b + ' = ' + y,\n      a + 'x = ' + y + ' − (' + b + ') = ' + (y-b),\n      'x = ' + (y-b) + ' / ' + a + ' = ' + fmtNum(x)\n    ];\n    return { topic:'Funksjoner', text:text, hint:'Flytt konstanten til høyre side og del på koeffisienten til x.', answer:x, answerDisplay:fmtNum(x), unit:'x =', fasit:fasit };\n  },\n\n  funk_finnuttrykk: function(del) {\n    var a = del===1 ? rInt(1,4) : rInt(-4,5)||1;\n    var b = del===1 ? rInt(-10,10) : rInt(-30,30);\n    var x1=rInt(0,5), y1=a*x1+b;\n    var x2=x1+rInt(2,5), y2=a*x2+b;\n    var text = 'En lineær funksjon går gjennom punktene (' + x1 + ', ' + y1 + ') og (' + x2 + ', ' + y2 + '). Finn funksjonsuttrykket f(x) = ax + b. Hva er b (konstantleddet)?';\n    var aCalc = round2((y2-y1)/(x2-x1));\n    var bCalc = round2(y1 - aCalc*x1);\n    var fasit = [\n      'a = (y₂ − y₁)/(x₂ − x₁) = (' + y2 + '−' + y1 + ')/(' + x2 + '−' + x1 + ') = ' + fmtNum(aCalc),\n      'Sett inn punkt (' + x1 + ', ' + y1 + '): ' + y1 + ' = ' + fmtNum(aCalc) + ' · ' + x1 + ' + b',\n      'b = ' + y1 + ' − ' + fmtNum(aCalc*x1) + ' = ' + fmtNum(bCalc),\n      'f(x) = ' + fmtNum(aCalc) + 'x ' + (bCalc>=0?'+ ':'') + fmtNum(bCalc)\n    ];\n    return { topic:'Funksjoner', text:text, hint:'Finn a først med stigningstallsformelen, deretter b ved å sette inn et punkt.', answer:bCalc, answerDisplay:'f(x) = ' + fmtNum(aCalc) + 'x ' + (bCalc>=0?'+ ':'') + fmtNum(bCalc), unit:'Skriv b-verdien', fasit:fasit };\n  },\n\n  // ── TID ───────────────────────────────────────────────────────────────────────\n  tid_omregning: function(del) {\n    var type = rChoice(['hm2min','min2hm','hms','speed']);\n    if(type==='hm2min') {\n      var h = rInt(1,5), m = rInt(5,55);\n      var tot = h*60+m;\n      var text = 'Gjør om ' + h + ' timer og ' + m + ' minutter til minutter.';\n      var fasit = [h + ' timer = ' + h + ' · 60 = ' + h*60 + ' min', h*60 + ' + ' + m + ' = ' + tot + ' min'];\n      return { topic:'Tid', text:text, hint:'1 time = 60 min', answer:tot, answerDisplay:tot + ' min', unit:'minutter', fasit:fasit };\n    } else if(type==='min2hm') {\n      var tot = rInt(70,300);\n      var h = Math.floor(tot/60), m = tot%60;\n      var text = 'Gjør om ' + tot + ' minutter til timer og minutter.';\n      var fasit = [tot + ' ÷ 60 = ' + h + ' rest ' + m, 'Svar: ' + h + ' t ' + m + ' min'];\n      return { topic:'Tid', text:text, hint:'Del på 60. Resten er minuttene.', answer:h + (m/100), answerDisplay:h + ' timer og ' + m + ' min', unit:'Skriv antall timer (heltall)', fasit:fasit, checkFn: function(u) { return parseAnswer(u)===h; } };\n    } else if(type==='hms') {\n      var h = rInt(1,4), m = rInt(10,55), s = rInt(10,55);\n      var tot = h*3600+m*60+s;\n      var text = 'Gjør om ' + h + ' t ' + m + ' min ' + s + ' sek til sekunder.';\n      var fasit = [h + ' t = ' + h*3600 + ' s', m + ' min = ' + m*60 + ' s', h*3600 + ' + ' + m*60 + ' + ' + s + ' = ' + tot + ' s'];\n      return { topic:'Tid', text:text, hint:'1 t = 3600 s, 1 min = 60 s', answer:tot, answerDisplay:tot + ' s', unit:'sekunder', fasit:fasit };\n    } else {\n      var dist = del===1 ? rInt(2,20)*5 : rInt(50,500);\n      var h = del===1 ? rInt(1,3) : rInt(1,5);\n      var m = del===1 ? rChoice([0,15,30,45]) : rInt(0,59);\n      var timeH = round2(h + m/60);\n      var speed = round2(dist/timeH);\n      var text = 'En bil kjører ' + dist + ' km på ' + h + ' time' + (h>1?'r':'') + (m>0?' og '+m+' min':'') + '. Hva er gjennomsnittsfarten i km/t?';\n      var fasit = [\n        'Tid = ' + h + (m>0?' + '+m+'/60 = '+fmtNum(timeH):'') + ' t',\n        'Fart = distanse / tid',\n        '= ' + dist + ' / ' + fmtNum(timeH),\n        '≈ ' + fmtNum(speed) + ' km/t'\n      ];\n      return { topic:'Tid', text:text, hint:'Fart = distanse / tid. Husk å gjøre om min til desimaltimer.', answer:speed, answerDisplay:fmtNum(speed) + ' km/t', unit:'km/t', fasit:fasit };\n    }\n  },\n\n  tid_arbeid: function(del) {\n    var lonnPerH = del===1 ? rInt(5,15)*20 : rInt(150,600);\n    var h = del===1 ? rInt(2,8) : rInt(10,40);\n    var m = del===1 ? rChoice([0,30]) : rChoice([0,15,30,45]);\n    var timeH = h + m/60;\n    var lon = Math.round(lonnPerH * timeH);\n    var text = 'Timeslønnen er ' + fmtMoney(lonnPerH) + '. Du jobber ' + h + ' timer' + (m>0?' og '+m+' min':'') + '. Hva er lønnen?';\n    var fasit = [\n      'Tid = ' + h + (m>0?' + '+m+'/60 = '+fmtNum(timeH)+' t':'') + ' t',\n      'Lønn = ' + fmtMoney(lonnPerH) + ' · ' + fmtNum(timeH) + ' t',\n      '= ' + fmtMoney(lon)\n    ];\n    return { topic:'Tid', text:text, hint:'Gjør om til desimaltimer. Lønn = timeslønn · timer.', answer:lon, answerDisplay:fmtMoney(lon), unit:'kr', fasit:fasit };\n  }\n\n};\n\n// ─── Topic → generator mapping ────────────────────────────────────────────────\nvar topicGenerators = {\n  alle: null, // special\n  prosent: ['prosent_grunnverdi','prosent_prosentdel','prosent_poeng','prosent_mva'],\n  vekst: ['vekst_beregn','vekst_framover','vekst_finn_pct'],\n  potenser: ['potenser_regler','potenser_standardform','potenser_negativ'],\n  statistikk: ['stat_gjennomsnitt','stat_median','stat_standardavvik','stat_boks'],\n  funksjoner: ['funk_verdi','funk_stigning','funk_likning','funk_finnuttrykk'],\n  tid: ['tid_omregning','tid_arbeid']\n};\nvar alleGenerators = Object.keys(generators);\n\nfunction pickGenerator() {\n  if(state.topic === 'alle') return rChoice(alleGenerators);\n  var pool = topicGenerators[state.topic];\n  return rChoice(pool);\n}\n\n// ─── UI helpers ───────────────────────────────────────────────────────────────\nfunction setDel(d) {\n  state.del = d;\n  document.getElementById('btn-del1').className = d===1\n    ? 'px-4 py-1.5 rounded-full text-sm font-medium border-2 border-blue-600 bg-blue-600 text-white transition-all'\n    : 'px-4 py-1.5 rounded-full text-sm font-medium border-2 border-blue-600 text-blue-700 hover:bg-blue-600 hover:text-white transition-all';\n  document.getElementById('btn-del2').className = d===2\n    ? 'px-4 py-1.5 rounded-full text-sm font-medium border-2 border-indigo-600 bg-indigo-600 text-white transition-all'\n    : 'px-4 py-1.5 rounded-full text-sm font-medium border-2 border-gray-300 text-gray-600 hover:bg-gray-200 transition-all';\n  newTask();\n}\n\nfunction setTopic(t, btn) {\n  state.topic = t;\n  document.querySelectorAll('.topic-btn').forEach(function(b) {\n    b.classList.remove('active','bg-blue-100','text-blue-800','border-blue-300');\n    b.classList.add('bg-white','text-gray-700','border-gray-200');\n  });\n  btn.classList.add('active','bg-blue-100','text-blue-800','border-blue-300');\n  btn.classList.remove('bg-white','text-gray-700','border-gray-200');\n  newTask();\n}\n\nfunction updateStatsUI() {\n  var done = state.tasksDone, cor = state.correct;\n  document.getElementById('score-display').textContent = cor + ' / ' + done;\n  document.getElementById('stat-done').textContent = done;\n  document.getElementById('stat-correct').textContent = cor;\n  document.getElementById('stat-pct').textContent = done>0 ? Math.round(cor/done*100) + ' %' : '–';\n}\n\n// ─── New task ─────────────────────────────────────────────────────────────────\nvar taskCount = 0;\nfunction newTask() {\n  var genKey = pickGenerator();\n  var task;\n  try {\n    task = generators[genKey](state.del);\n  } catch(e) {\n    // fallback\n    task = generators['prosent_prosentdel'](state.del);\n  }\n  task.genKey = genKey;\n  state.currentTask = task;\n  state.hintShown = false;\n  state.fasitShown = false;\n  state.answeredCorrectly = false;\n  taskCount++;\n\n  document.getElementById('badge-topic').textContent = task.topic;\n  document.getElementById('badge-del').textContent = state.del===1 ? 'Del 1 – uten hjelpemidler' : 'Del 2 – med hjelpemidler';\n  document.getElementById('task-counter').textContent = taskCount;\n  document.getElementById('task-text').textContent = task.text;\n  document.getElementById('answer-unit').textContent = task.unit ? '(' + task.unit + ')' : '';\n  document.getElementById('answer-input').value = '';\n  document.getElementById('answer-input').disabled = false;\n  document.getElementById('feedback').className = 'hidden mb-4 rounded-lg px-4 py-3 text-sm font-medium';\n  document.getElementById('hint-box').className = 'hidden mt-4 bg-yellow-50 border border-yellow-200 rounded-lg px-4 py-3 text-sm text-gray-700';\n  document.getElementById('fasit-box').className = 'hidden mt-4 bg-green-50 border border-green-300 rounded-lg px-4 py-3';\n  document.getElementById('btn-hint').disabled = false;\n  document.getElementById('btn-fasit').disabled = false;\n\n  // Animate card\n  var card = document.getElementById('task-card');\n  card.classList.remove('fade-in');\n  void card.offsetWidth;\n  card.classList.add('fade-in');\n\n  document.getElementById('answer-input').focus();\n  updateStatsUI();\n}\n\n// ─── Hint ─────────────────────────────────────────────────────────────────────\nfunction showHint() {\n  if(!state.currentTask) return;\n  state.hintShown = true;\n  var box = document.getElementById('hint-box');\n  box.textContent = state.currentTask.hint;\n  box.className = 'mt-4 bg-yellow-50 border border-yellow-200 rounded-lg px-4 py-3 text-sm text-gray-700 fade-in';\n}\n\n// ─── Fasit ────────────────────────────────────────────────────────────────────\nfunction showFasit() {\n  if(!state.currentTask) return;\n  state.fasitShown = true;\n  var box = document.getElementById('fasit-box');\n  var content = document.getElementById('fasit-content');\n  content.innerHTML = '';\n  state.currentTask.fasit.forEach(function(line) {\n    var div = document.createElement('div');\n    div.className = 'fasit-step py-0.5';\n    div.textContent = line;\n    content.appendChild(div);\n  });\n  // Show correct answer prominently\n  var ans = document.createElement('div');\n  ans.className = 'mt-2 font-semibold text-green-800 text-sm border-t border-green-200 pt-2';\n  ans.textContent = '✓ Svar: ' + state.currentTask.answerDisplay;\n  content.appendChild(ans);\n  box.className = 'mt-4 bg-green-50 border border-green-300 rounded-lg px-4 py-3 fade-in';\n  document.getElementById('answer-input').disabled = true;\n}\n\n// ─── Check answer ─────────────────────────────────────────────────────────────\nfunction checkAnswer() {\n  if(!state.currentTask || state.answeredCorrectly) return;\n  var task = state.currentTask;\n  var userVal = document.getElementById('answer-input').value.trim();\n  if(!userVal) return;\n\n  var correct;\n  if(task.checkFn) {\n    correct = task.checkFn(userVal);\n  } else {\n    correct = numClose(userVal, task.answer);\n  }\n\n  var fb = document.getElementById('feedback');\n  var input = document.getElementById('answer-input');\n\n  state.tasksDone++;\n  if(correct) {\n    state.correct++;\n    fb.textContent = '✓ Riktig! ' + (state.hintShown ? '(med hint)' : '');\n    fb.className = 'mb-4 rounded-lg px-4 py-3 text-sm font-medium bg-green-100 text-green-800 fade-in';\n    input.classList.add('correct-flash');\n    setTimeout(function(){ input.classList.remove('correct-flash'); }, 500);\n    state.answeredCorrectly = true;\n    input.disabled = true;\n  } else {\n    fb.textContent = '✗ Ikke riktig. Prøv igjen, eller se hint/fasit.';\n    fb.className = 'mb-4 rounded-lg px-4 py-3 text-sm font-medium bg-red-100 text-red-800 fade-in';\n    input.classList.add('wrong-flash');\n    setTimeout(function(){ input.classList.remove('wrong-flash'); }, 500);\n    input.select();\n  }\n  saveStats();\n  updateStatsUI();\n}\n\n// ─── Init ─────────────────────────────────────────────────────────────────────\nloadStats();\nupdateStatsUI();\nnewTask();\n</script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Eksamenstrening 2P",
    "windowTitle": "Eksamenstrening 2P",
