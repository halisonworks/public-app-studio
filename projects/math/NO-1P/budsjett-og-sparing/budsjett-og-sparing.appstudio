{
  "schema": "app-studio/canvas@1",
  "id": "example-no1p-budsjett-og-sparing",
  "name": "budsjett-og-sparing.html",
  "code": "<!DOCTYPE html>\n<!--\n  Budsjett og sparing — Halison App Studio-eksempel\n\n  Interaktivt læremiddel for matematikk 1P (LK20): sett opp et budsjett, og regn\n  ut sparing med renters rente over tid.\n\n  Fra Halison App Studio sitt offentlige bibliotek:\n  https://github.com/halisonworks/public-app-studio\n\n  Tillatt bruk: personlig, pedagogisk og annen ikke-kommersiell bruk. Behold denne\n  headeren og kildelenken; ikke-kommersiell bruk. Utgitt under Halison App Studio\n  Examples License — se LICENSE-filen i repoet over.\n-->\n<html lang=\"no\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Budsjett og sparing – Matematikk 1P</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Segoe UI', system-ui, sans-serif; }\n    .tab-active { border-bottom: 3px solid #2563eb; color: #2563eb; font-weight: 600; }\n    .tab-inactive { border-bottom: 3px solid transparent; color: #6b7280; }\n    input[type=\"number\"]::-webkit-inner-spin-button,\n    input[type=\"number\"]::-webkit-outer-spin-button { opacity: 1; }\n    .row-enter { animation: fadeIn 0.2s ease; }\n    @keyframes fadeIn { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: translateY(0); } }\n    .bar-label { font-size: 10px; }\n    .chart-tooltip { pointer-events: none; }\n    svg text { font-family: inherit; }\n  </style>\n</head>\n<body class=\"bg-gray-50 min-h-screen\">\n\n  <!-- Header -->\n  <header class=\"bg-white border-b border-gray-200 shadow-sm\">\n    <div class=\"max-w-4xl mx-auto px-4 py-4 flex items-center gap-3\">\n      <div class=\"w-10 h-10 rounded-lg bg-blue-600 flex items-center justify-center text-white text-xl font-bold select-none\">1P</div>\n      <div>\n        <h1 class=\"text-xl font-bold text-gray-900 leading-tight\">Budsjett og sparing</h1>\n        <p class=\"text-xs text-gray-500\">Matematikk 1P · LK20 · Kap. 5.4–5.5</p>\n      </div>\n    </div>\n  </header>\n\n  <!-- Tabs -->\n  <div class=\"bg-white border-b border-gray-200\">\n    <div class=\"max-w-4xl mx-auto px-4 flex gap-0\">\n      <button id=\"tab-budsjett\" onclick=\"switchTab('budsjett')\"\n        class=\"px-6 py-3 text-sm transition-colors tab-active\" aria-selected=\"true\" role=\"tab\">\n        📋 Budsjett\n      </button>\n      <button id=\"tab-sparing\" onclick=\"switchTab('sparing')\"\n        class=\"px-6 py-3 text-sm transition-colors tab-inactive\" aria-selected=\"false\" role=\"tab\">\n        💰 Sparing med renters rente\n      </button>\n    </div>\n  </div>\n\n  <main class=\"max-w-4xl mx-auto px-4 py-6 space-y-6\">\n\n    <!-- ======================== BUDSJETT TAB ======================== -->\n    <section id=\"panel-budsjett\" role=\"tabpanel\">\n\n      <div class=\"grid md:grid-cols-2 gap-6\">\n\n        <!-- Inntekter -->\n        <div class=\"bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden\">\n          <div class=\"bg-green-50 border-b border-green-100 px-5 py-3 flex items-center justify-between\">\n            <h2 class=\"font-semibold text-green-800\">Inntekter</h2>\n            <button onclick=\"addRow('inntekter')\"\n              class=\"text-xs bg-green-600 hover:bg-green-700 text-white px-3 py-1 rounded-full transition-colors\">\n              + Legg til\n            </button>\n          </div>\n          <div class=\"p-4 space-y-2\" id=\"inntekter-list\"></div>\n          <div class=\"border-t border-green-100 px-5 py-3 flex justify-between items-center bg-green-50\">\n            <span class=\"text-sm font-medium text-green-800\">Sum inntekter</span>\n            <span class=\"font-bold text-green-700 text-base\" id=\"sum-inntekter\">0 kr</span>\n          </div>\n        </div>\n\n        <!-- Utgifter -->\n        <div class=\"bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden\">\n          <div class=\"bg-red-50 border-b border-red-100 px-5 py-3 flex items-center justify-between\">\n            <h2 class=\"font-semibold text-red-800\">Utgifter</h2>\n            <button onclick=\"addRow('utgifter')\"\n              class=\"text-xs bg-red-500 hover:bg-red-600 text-white px-3 py-1 rounded-full transition-colors\">\n              + Legg til\n            </button>\n          </div>\n          <div class=\"p-4 space-y-2\" id=\"utgifter-list\"></div>\n          <div class=\"border-t border-red-100 px-5 py-3 flex justify-between items-center bg-red-50\">\n            <span class=\"text-sm font-medium text-red-800\">Sum utgifter</span>\n            <span class=\"font-bold text-red-600 text-base\" id=\"sum-utgifter\">0 kr</span>\n          </div>\n        </div>\n      </div>\n\n      <!-- Resultat -->\n      <div id=\"resultat-box\"\n        class=\"bg-white rounded-2xl shadow-sm border border-gray-100 p-5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4\">\n        <div>\n          <p class=\"text-sm text-gray-500 mb-1\">Resultat (inntekter − utgifter)</p>\n          <p id=\"resultat-label\" class=\"text-2xl font-bold text-gray-800\">0 kr</p>\n          <p id=\"resultat-status\" class=\"text-sm mt-1 text-gray-500\">Fyll inn inntekter og utgifter</p>\n        </div>\n        <div class=\"w-full sm:w-auto\">\n          <svg id=\"budsjett-chart\" width=\"260\" height=\"110\" viewBox=\"0 0 260 110\" class=\"block mx-auto\"></svg>\n        </div>\n      </div>\n\n      <!-- Forklaringsboks -->\n      <div class=\"bg-blue-50 border border-blue-100 rounded-xl px-5 py-4 text-sm text-blue-900 space-y-1\">\n        <p class=\"font-semibold\">Hva er et budsjett?</p>\n        <p>Et budsjett er en plan over forventede <span class=\"font-medium\">inntekter</span> (penger inn) og <span class=\"font-medium\">utgifter</span> (penger ut) i en periode.</p>\n        <p class=\"mt-1\">\n          <span class=\"font-mono bg-blue-100 px-1 rounded\">Resultat = Sum inntekter − Sum utgifter</span>\n        </p>\n        <p class=\"mt-1\">Et positivt resultat kalles <strong>overskudd</strong>; et negativt resultat kalles <strong>underskudd</strong>.</p>\n      </div>\n    </section>\n\n    <!-- ======================== SPARING TAB ======================== -->\n    <section id=\"panel-sparing\" role=\"tabpanel\" class=\"hidden space-y-6\">\n\n      <!-- Formel-info -->\n      <div class=\"bg-blue-50 border border-blue-100 rounded-xl px-5 py-4 text-sm text-blue-900 space-y-2\">\n        <p class=\"font-semibold\">Renters rente – formel</p>\n        <p>\n          Startbeløp <em>K₀</em>, fast innskudd <em>d</em> per periode, rente <em>r</em> per periode:\n        </p>\n        <p class=\"font-mono bg-blue-100 px-2 py-1 rounded text-xs\">\n          Kₙ = K₀ · (1 + r)ⁿ + d · [(1 + r)ⁿ − 1] / r\n        </p>\n        <p class=\"text-xs text-blue-700\">\n          Rente tilskrives én gang per år. Det månedlige innskuddet akkumuleres og tilskrives rente ved årets slutt\n          (annuitetsbetraktning forenklet til årsmodell; se kap. 5.5).\n        </p>\n      </div>\n\n      <!-- Input-panel -->\n      <div class=\"bg-white rounded-2xl shadow-sm border border-gray-100 p-5\">\n        <h2 class=\"font-semibold text-gray-800 mb-4\">Spareparametere</h2>\n        <div class=\"grid sm:grid-cols-2 gap-4\">\n          <div>\n            <label class=\"block text-sm font-medium text-gray-700 mb-1\" for=\"s-start\">Startbeløp (kr)</label>\n            <input id=\"s-start\" type=\"number\" min=\"0\" step=\"100\" value=\"5000\"\n              class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\"\n              oninput=\"computeSparing()\" />\n          </div>\n          <div>\n            <label class=\"block text-sm font-medium text-gray-700 mb-1\" for=\"s-deposit\">\n              Fast innskudd per\n              <select id=\"s-period\" onchange=\"computeSparing()\"\n                class=\"border border-gray-300 rounded px-1 py-0.5 text-xs focus:outline-none focus:ring-1 focus:ring-blue-400 ml-1\">\n                <option value=\"month\">måned</option>\n                <option value=\"year\">år</option>\n              </select>\n              (kr)\n            </label>\n            <input id=\"s-deposit\" type=\"number\" min=\"0\" step=\"100\" value=\"500\"\n              class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\"\n              oninput=\"computeSparing()\" />\n          </div>\n          <div>\n            <label class=\"block text-sm font-medium text-gray-700 mb-1\" for=\"s-rate\">Nominell rente (% per år)</label>\n            <input id=\"s-rate\" type=\"number\" min=\"0.1\" max=\"30\" step=\"0.1\" value=\"4.0\"\n              class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\"\n              oninput=\"computeSparing()\" />\n          </div>\n          <div>\n            <label class=\"block text-sm font-medium text-gray-700 mb-1\" for=\"s-years\">Antall år</label>\n            <input id=\"s-years\" type=\"number\" min=\"1\" max=\"50\" step=\"1\" value=\"10\"\n              class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\"\n              oninput=\"computeSparing()\" />\n          </div>\n        </div>\n      </div>\n\n      <!-- Resultat-kort -->\n      <div class=\"grid sm:grid-cols-3 gap-4\">\n        <div class=\"bg-white rounded-2xl border border-gray-100 shadow-sm p-4 text-center\">\n          <p class=\"text-xs text-gray-500 uppercase tracking-wide mb-1\">Sluttbeløp</p>\n          <p id=\"s-slutt\" class=\"text-2xl font-bold text-blue-700\">–</p>\n        </div>\n        <div class=\"bg-white rounded-2xl border border-gray-100 shadow-sm p-4 text-center\">\n          <p class=\"text-xs text-gray-500 uppercase tracking-wide mb-1\">Totalt innskutt</p>\n          <p id=\"s-innsk\" class=\"text-2xl font-bold text-gray-700\">–</p>\n        </div>\n        <div class=\"bg-white rounded-2xl border border-gray-100 shadow-sm p-4 text-center\">\n          <p class=\"text-xs text-gray-500 uppercase tracking-wide mb-1\">Herav renter</p>\n          <p id=\"s-renter\" class=\"text-2xl font-bold text-green-600\">–</p>\n        </div>\n      </div>\n\n      <!-- Vekst-diagram -->\n      <div class=\"bg-white rounded-2xl shadow-sm border border-gray-100 p-5\">\n        <h3 class=\"font-semibold text-gray-700 mb-3 text-sm\">Saldoutvikling over tid</h3>\n        <div class=\"overflow-x-auto\">\n          <svg id=\"sparing-chart\" width=\"100%\" height=\"280\" viewBox=\"0 0 700 280\" preserveAspectRatio=\"xMidYMid meet\" class=\"block\"></svg>\n        </div>\n        <div class=\"flex gap-6 mt-3 text-xs text-gray-500 justify-center\">\n          <span class=\"flex items-center gap-1\"><span class=\"inline-block w-4 h-3 rounded\" style=\"background:#2563eb\"></span>Totalt (med renter)</span>\n          <span class=\"flex items-center gap-1\"><span class=\"inline-block w-4 h-3 rounded\" style=\"background:#d1fae5;border:1px solid #34d399\"></span>Totalt innskutt</span>\n        </div>\n      </div>\n\n      <!-- Tabell -->\n      <div class=\"bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden\">\n        <div class=\"border-b border-gray-100 px-5 py-3\">\n          <h3 class=\"font-semibold text-gray-700 text-sm\">År-for-år tabell</h3>\n        </div>\n        <div class=\"overflow-x-auto\">\n          <table class=\"w-full text-sm\">\n            <thead class=\"bg-gray-50 text-gray-500 text-xs uppercase\">\n              <tr>\n                <th class=\"px-4 py-2 text-left\">År</th>\n                <th class=\"px-4 py-2 text-right\">Innskutt dette år</th>\n                <th class=\"px-4 py-2 text-right\">Renter dette år</th>\n                <th class=\"px-4 py-2 text-right\">Saldo</th>\n              </tr>\n            </thead>\n            <tbody id=\"sparing-table\" class=\"divide-y divide-gray-50\"></tbody>\n          </table>\n        </div>\n      </div>\n    </section>\n\n  </main>\n\n  <footer class=\"max-w-4xl mx-auto px-4 py-6 text-center text-xs text-gray-400\">\n    Matematikk 1P · LK20 · Sinus 1P kap. 5.4–5.5 ·\n    <a href=\"https://github.com/halisonworks/public-app-studio\" class=\"underline hover:text-gray-600\" target=\"_blank\" rel=\"noopener\">Halison App Studio</a>\n  </footer>\n\n<script>\n/* ─── TAB SWITCHING ─────────────────────────────────────────── */\nfunction switchTab(tab) {\n  ['budsjett', 'sparing'].forEach(t => {\n    document.getElementById('panel-' + t).classList.toggle('hidden', t !== tab);\n    const btn = document.getElementById('tab-' + t);\n    btn.classList.toggle('tab-active', t === tab);\n    btn.classList.toggle('tab-inactive', t !== tab);\n    btn.setAttribute('aria-selected', t === tab ? 'true' : 'false');\n  });\n}\n\n/* ─── FORMATERING ───────────────────────────────────────────── */\nfunction fmtKr(n) {\n  return new Intl.NumberFormat('nb-NO', { maximumFractionDigits: 0 }).format(Math.round(n)) + ' kr';\n}\n\n/* ─── BUDSJETT ──────────────────────────────────────────────── */\nconst DEFAULT_DATA = {\n  inntekter: [\n    { label: 'Lønn (deltidsjobb)', amount: 4800 },\n    { label: 'Lommepenger fra foreldre', amount: 1000 },\n    { label: 'Barnebidrag / støtte', amount: 500 }\n  ],\n  utgifter: [\n    { label: 'Mat og dagligvarer', amount: 1800 },\n    { label: 'Kollektivtransport', amount: 600 },\n    { label: 'Mobil og abonnementer', amount: 399 },\n    { label: 'Klær og fritid', amount: 800 },\n    { label: 'Sparing (overføring)', amount: 700 }\n  ]\n};\n\nfunction loadBudsjettData() {\n  try {\n    const raw = localStorage.getItem('budsjett_1p');\n    if (raw) return JSON.parse(raw);\n  } catch (_) {}\n  return JSON.parse(JSON.stringify(DEFAULT_DATA));\n}\n\nfunction saveBudsjettData() {\n  try { localStorage.setItem('budsjett_1p', JSON.stringify(budsjettData)); } catch (_) {}\n}\n\nlet budsjettData = loadBudsjettData();\n\nfunction renderBudsjett() {\n  ['inntekter', 'utgifter'].forEach(type => {\n    const list = document.getElementById(type + '-list');\n    list.innerHTML = '';\n    budsjettData[type].forEach((row, idx) => {\n      const isInntekt = type === 'inntekter';\n      const div = document.createElement('div');\n      div.className = 'flex items-center gap-2 row-enter';\n      div.innerHTML = `\n        <input type=\"text\" value=\"${escHtml(row.label)}\"\n          class=\"flex-1 border border-gray-200 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-${isInntekt ? 'green' : 'red'}-300\"\n          oninput=\"updateLabel('${type}', ${idx}, this.value)\" placeholder=\"Beskrivelse\" />\n        <input type=\"number\" value=\"${row.amount}\" min=\"0\" step=\"50\"\n          class=\"w-28 border border-gray-200 rounded-lg px-3 py-1.5 text-sm text-right focus:outline-none focus:ring-2 focus:ring-${isInntekt ? 'green' : 'red'}-300\"\n          oninput=\"updateAmount('${type}', ${idx}, this.value)\" />\n        <span class=\"text-xs text-gray-400 w-4\">kr</span>\n        <button onclick=\"removeRow('${type}', ${idx})\"\n          class=\"text-gray-300 hover:text-red-400 transition-colors text-lg leading-none\" title=\"Slett rad\">×</button>\n      `;\n      list.appendChild(div);\n    });\n  });\n  updateBudsjettTotals();\n}\n\nfunction escHtml(s) {\n  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;');\n}\n\nfunction addRow(type) {\n  budsjettData[type].push({ label: '', amount: 0 });\n  saveBudsjettData();\n  renderBudsjett();\n  // Focus the new label input\n  const list = document.getElementById(type + '-list');\n  const inputs = list.querySelectorAll('input[type=\"text\"]');\n  if (inputs.length) inputs[inputs.length - 1].focus();\n}\n\nfunction removeRow(type, idx) {\n  budsjettData[type].splice(idx, 1);\n  saveBudsjettData();\n  renderBudsjett();\n}\n\nfunction updateLabel(type, idx, val) {\n  budsjettData[type][idx].label = val;\n  saveBudsjettData();\n  updateBudsjettTotals();\n}\n\nfunction updateAmount(type, idx, val) {\n  budsjettData[type][idx].amount = parseFloat(val) || 0;\n  saveBudsjettData();\n  updateBudsjettTotals();\n}\n\nfunction updateBudsjettTotals() {\n  const sumI = budsjettData.inntekter.reduce((s, r) => s + (parseFloat(r.amount) || 0), 0);\n  const sumU = budsjettData.utgifter.reduce((s, r) => s + (parseFloat(r.amount) || 0), 0);\n  const res = sumI - sumU;\n\n  document.getElementById('sum-inntekter').textContent = fmtKr(sumI);\n  document.getElementById('sum-utgifter').textContent = fmtKr(sumU);\n  document.getElementById('resultat-label').textContent = fmtKr(res);\n\n  const box = document.getElementById('resultat-box');\n  const lbl = document.getElementById('resultat-label');\n  const status = document.getElementById('resultat-status');\n\n  if (res > 0) {\n    lbl.className = 'text-2xl font-bold text-green-700';\n    status.textContent = '✔ Overskudd – du har penger til overs!';\n    status.className = 'text-sm mt-1 text-green-600';\n  } else if (res < 0) {\n    lbl.className = 'text-2xl font-bold text-red-600';\n    status.textContent = '⚠ Underskudd – utgiftene er større enn inntektene.';\n    status.className = 'text-sm mt-1 text-red-500';\n  } else {\n    lbl.className = 'text-2xl font-bold text-gray-700';\n    status.textContent = 'Balanse – inntekter og utgifter er like store.';\n    status.className = 'text-sm mt-1 text-gray-500';\n  }\n\n  drawBudsjettChart(sumI, sumU);\n}\n\nfunction drawBudsjettChart(sumI, sumU) {\n  const svg = document.getElementById('budsjett-chart');\n  const W = 260, H = 110, PAD = 30, BAR_W = 60, GAP = 30;\n  const maxVal = Math.max(sumI, sumU, 1);\n  const avail = H - PAD - 10;\n\n  const hI = Math.round((sumI / maxVal) * avail);\n  const hU = Math.round((sumU / maxVal) * avail);\n\n  const xI = (W / 2) - BAR_W - GAP / 2;\n  const xU = (W / 2) + GAP / 2;\n  const base = H - PAD;\n\n  svg.innerHTML = `\n    <rect x=\"${xI}\" y=\"${base - hI}\" width=\"${BAR_W}\" height=\"${hI}\" rx=\"4\" fill=\"#4ade80\"/>\n    <rect x=\"${xU}\" y=\"${base - hU}\" width=\"${BAR_W}\" height=\"${hU}\" rx=\"4\" fill=\"${sumU > sumI ? '#f87171' : '#fca5a5'}\"/>\n    <line x1=\"${PAD - 10}\" y1=\"${base}\" x2=\"${W - PAD + 10}\" y2=\"${base}\" stroke=\"#e5e7eb\" stroke-width=\"1\"/>\n    <text x=\"${xI + BAR_W / 2}\" y=\"${H}\" text-anchor=\"middle\" fill=\"#16a34a\" font-size=\"11\" font-weight=\"600\">Inntekter</text>\n    <text x=\"${xU + BAR_W / 2}\" y=\"${H}\" text-anchor=\"middle\" fill=\"#dc2626\" font-size=\"11\" font-weight=\"600\">Utgifter</text>\n    <text x=\"${xI + BAR_W / 2}\" y=\"${base - hI - 4}\" text-anchor=\"middle\" fill=\"#166534\" font-size=\"9\">${sumI > 0 ? fmtKr(sumI) : ''}</text>\n    <text x=\"${xU + BAR_W / 2}\" y=\"${base - hU - 4}\" text-anchor=\"middle\" fill=\"#991b1b\" font-size=\"9\">${sumU > 0 ? fmtKr(sumU) : ''}</text>\n  `;\n}\n\n/* ─── SPARING ───────────────────────────────────────────────── */\nfunction computeSparing() {\n  const K0 = parseFloat(document.getElementById('s-start').value) || 0;\n  const depositRaw = parseFloat(document.getElementById('s-deposit').value) || 0;\n  const period = document.getElementById('s-period').value;\n  const rPct = parseFloat(document.getElementById('s-rate').value) || 0;\n  const N = Math.min(Math.max(Math.round(parseFloat(document.getElementById('s-years').value) || 1), 1), 50);\n  const r = rPct / 100;\n\n  // Annual deposit: if monthly, sum 12 months → d_year = deposit * 12\n  const dYear = period === 'month' ? depositRaw * 12 : depositRaw;\n\n  // Build year-by-year arrays\n  // Model: at end of year n, deposit dYear is added, then interest applied.\n  // Kn = K(n-1) * (1+r) + dYear * (1+r)\n  // (deposits made at start of year, earn full year of interest)\n  // This matches: Kn = K0*(1+r)^n + dYear * (1+r) * [(1+r)^n - 1] / r  when r>0\n  // For r=0: Kn = K0 + dYear*n  (handled separately)\n\n  const years = [];\n  const balances = [];\n  const deposited = [];\n  let bal = K0;\n  let totalDeposited = K0;\n\n  for (let n = 1; n <= N; n++) {\n    const interestThisYear = (bal + dYear) * r;\n    bal = bal * (1 + r) + dYear * (1 + r); // deposit at start of year\n    totalDeposited += dYear;\n    years.push(n);\n    balances.push(bal);\n    deposited.push(totalDeposited);\n  }\n\n  const sluttbeløp = N > 0 ? balances[N - 1] : K0;\n  const totInnsk = totalDeposited;\n  const totRenter = sluttbeløp - totInnsk;\n\n  document.getElementById('s-slutt').textContent = fmtKr(sluttbeløp);\n  document.getElementById('s-innsk').textContent = fmtKr(totInnsk);\n  document.getElementById('s-renter').textContent = fmtKr(Math.max(0, totRenter));\n\n  drawSparingChart(years, balances, deposited, K0);\n  fillSparingTable(years, balances, deposited, dYear, r, K0);\n\n  // Persist inputs\n  try {\n    localStorage.setItem('sparing_1p', JSON.stringify({ K0, depositRaw, period, rPct, N }));\n  } catch (_) {}\n}\n\nfunction drawSparingChart(years, balances, deposited, K0) {\n  const svg = document.getElementById('sparing-chart');\n  const W = 700, H = 280;\n  const PAD = { top: 20, right: 20, bottom: 40, left: 80 };\n  const chartW = W - PAD.left - PAD.right;\n  const chartH = H - PAD.top - PAD.bottom;\n\n  const maxBal = Math.max(...balances, 1);\n  const n = years.length;\n\n  function xOf(i) { return PAD.left + (i / n) * chartW; }\n  function yOf(v) { return PAD.top + chartH - (v / maxBal) * chartH; }\n\n  // Grid lines\n  let grid = '';\n  const ticks = 5;\n  for (let i = 0; i <= ticks; i++) {\n    const v = (maxBal / ticks) * i;\n    const y = yOf(v);\n    grid += `<line x1=\"${PAD.left}\" y1=\"${y}\" x2=\"${W - PAD.right}\" y2=\"${y}\" stroke=\"#f3f4f6\" stroke-width=\"1\"/>`;\n    grid += `<text x=\"${PAD.left - 8}\" y=\"${y + 4}\" text-anchor=\"end\" fill=\"#9ca3af\" font-size=\"11\">${fmtKrShort(v)}</text>`;\n  }\n\n  // X-axis labels (max 10 labels)\n  let xlabels = '';\n  const step = Math.max(1, Math.ceil(n / 10));\n  for (let i = 0; i < n; i += step) {\n    const x = xOf(i + 1);\n    xlabels += `<text x=\"${x}\" y=\"${H - PAD.bottom + 18}\" text-anchor=\"middle\" fill=\"#9ca3af\" font-size=\"11\">År ${years[i]}</text>`;\n  }\n  // Always show last\n  {\n    const x = xOf(n);\n    xlabels += `<text x=\"${x}\" y=\"${H - PAD.bottom + 18}\" text-anchor=\"middle\" fill=\"#6b7280\" font-size=\"11\" font-weight=\"600\">År ${years[n-1]}</text>`;\n  }\n\n  // Area for deposited (stacked)\n  let areaDeposited = `M ${xOf(0)} ${yOf(0)}`;\n  // start at 0 x, y=K0 actually; first point is after year 0\n  // point before year 1 is K0\n  areaDeposited = `M ${xOf(0)} ${yOf(K0)}`;\n  for (let i = 0; i < n; i++) {\n    areaDeposited += ` L ${xOf(i + 1)} ${yOf(deposited[i])}`;\n  }\n  areaDeposited += ` L ${xOf(n)} ${yOf(0)} L ${xOf(0)} ${yOf(0)} Z`;\n\n  // Area for total balance\n  let areaBalance = `M ${xOf(0)} ${yOf(K0)}`;\n  for (let i = 0; i < n; i++) {\n    areaBalance += ` L ${xOf(i + 1)} ${yOf(balances[i])}`;\n  }\n  areaBalance += ` L ${xOf(n)} ${yOf(0)} L ${xOf(0)} ${yOf(0)} Z`;\n\n  // Line for balance\n  let lineBal = `M ${xOf(0)} ${yOf(K0)}`;\n  for (let i = 0; i < n; i++) {\n    lineBal += ` L ${xOf(i + 1)} ${yOf(balances[i])}`;\n  }\n\n  svg.innerHTML = `\n    <defs>\n      <linearGradient id=\"gradBal\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n        <stop offset=\"0%\" stop-color=\"#2563eb\" stop-opacity=\"0.25\"/>\n        <stop offset=\"100%\" stop-color=\"#2563eb\" stop-opacity=\"0.05\"/>\n      </linearGradient>\n    </defs>\n    ${grid}\n    <line x1=\"${PAD.left}\" y1=\"${PAD.top}\" x2=\"${PAD.left}\" y2=\"${H - PAD.bottom}\" stroke=\"#e5e7eb\" stroke-width=\"1\"/>\n    <line x1=\"${PAD.left}\" y1=\"${H - PAD.bottom}\" x2=\"${W - PAD.right}\" y2=\"${H - PAD.bottom}\" stroke=\"#e5e7eb\" stroke-width=\"1\"/>\n    <path d=\"${areaBalance}\" fill=\"url(#gradBal)\"/>\n    <path d=\"${areaDeposited}\" fill=\"#d1fae5\" opacity=\"0.8\"/>\n    <path d=\"${lineBal}\" fill=\"none\" stroke=\"#2563eb\" stroke-width=\"2.5\" stroke-linejoin=\"round\" stroke-linecap=\"round\"/>\n    ${xlabels}\n  `;\n}\n\nfunction fmtKrShort(v) {\n  if (v >= 1000000) return (v / 1000000).toFixed(1).replace('.', ',') + ' M';\n  if (v >= 1000) return Math.round(v / 1000) + ' k';\n  return Math.round(v) + '';\n}\n\nfunction fillSparingTable(years, balances, deposited, dYear, r, K0) {\n  const tbody = document.getElementById('sparing-table');\n  tbody.innerHTML = '';\n  let prevBal = K0;\n  years.forEach((yr, i) => {\n    const bal = balances[i];\n    const dep = deposited[i];\n    const interestYear = bal - prevBal - dYear;\n    prevBal = bal;\n    const tr = document.createElement('tr');\n    tr.className = i % 2 === 0 ? 'bg-white' : 'bg-gray-50';\n    tr.innerHTML = `\n      <td class=\"px-4 py-2 text-gray-700 font-medium\">${yr}</td>\n      <td class=\"px-4 py-2 text-right text-gray-600\">${fmtKr(dYear)}</td>\n      <td class=\"px-4 py-2 text-right text-green-600 font-medium\">${fmtKr(Math.max(0, interestYear))}</td>\n      <td class=\"px-4 py-2 text-right font-bold text-blue-700\">${fmtKr(bal)}</td>\n    `;\n    tbody.appendChild(tr);\n  });\n}\n\nfunction loadSparingDefaults() {\n  try {\n    const raw = localStorage.getItem('sparing_1p');\n    if (raw) {\n      const d = JSON.parse(raw);\n      if (d.K0 !== undefined) document.getElementById('s-start').value = d.K0;\n      if (d.depositRaw !== undefined) document.getElementById('s-deposit').value = d.depositRaw;\n      if (d.period) document.getElementById('s-period').value = d.period;\n      if (d.rPct !== undefined) document.getElementById('s-rate').value = d.rPct;\n      if (d.N !== undefined) document.getElementById('s-years').value = d.N;\n    }\n  } catch (_) {}\n}\n\n/* ─── INIT ──────────────────────────────────────────────────── */\nloadSparingDefaults();\nrenderBudsjett();\ncomputeSparing();\n</script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Budsjett og sparing",
    "windowTitle": "Budsjett og sparing",
    "bundleId": "com.halisonworks.budsjettsparing",
    "iconPath": null
  },
