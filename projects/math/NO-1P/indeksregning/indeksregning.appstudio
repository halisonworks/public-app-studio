{
  "schema": "app-studio/canvas@1",
  "id": "example-no1p-indeksregning",
  "name": "indeksregning.html",
  "code": "<!DOCTYPE html>\n<!--\n  Indeksregning — Halison App Studio-eksempel\n\n  Interaktivt læremiddel for matematikk 1P (LK20): indekser, konsumprisindeksen,\n  reallønn og kroneverdi.\n\n  Fra Halison App Studio sitt offentlige bibliotek:\n  https://github.com/halisonworks/public-app-studio\n\n  Tillatt bruk: personlig, pedagogisk og annen ikke-kommersiell bruk. Behold denne\n  headeren og kildelenken; ikke-kommersiell bruk. Utgitt under Halison App Studio\n  Examples License — se LICENSE-filen i repoet over.\n-->\n<html lang=\"no\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Indeksregning – Matematikk 1P</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    /* Custom scrollbar */\n    ::-webkit-scrollbar { width: 6px; height: 6px; }\n    ::-webkit-scrollbar-track { background: #f1f5f9; }\n    ::-webkit-scrollbar-thumb { background: #94a3b8; border-radius: 3px; }\n\n    /* Tab underline animation */\n    .tab-btn.active { border-bottom: 3px solid #3b82f6; color: #1d4ed8; font-weight: 700; }\n    .tab-btn { transition: color 0.2s, border-color 0.2s; }\n\n    /* SVG chart lines */\n    .chart-line { stroke: #3b82f6; stroke-width: 2.5; fill: none; }\n    .chart-line-red { stroke: #ef4444; stroke-width: 2.5; fill: none; }\n    .chart-area { fill: rgba(59,130,246,0.08); stroke: none; }\n\n    /* Formula box */\n    .formula-box {\n      background: #eff6ff;\n      border-left: 4px solid #3b82f6;\n      border-radius: 0 8px 8px 0;\n    }\n\n    /* Highlight row */\n    tr.basis-row { background: #dbeafe; font-weight: 700; }\n\n    /* Number inputs */\n    input[type=\"number\"] { -moz-appearance: textfield; }\n    input[type=\"number\"]::-webkit-outer-spin-button,\n    input[type=\"number\"]::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }\n  </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans min-h-screen\">\n\n<!-- =========================================================\n     HEADER\n========================================================= -->\n<header class=\"bg-blue-700 text-white shadow-md\">\n  <div class=\"max-w-5xl mx-auto px-4 py-5 flex items-center gap-3\">\n    <div class=\"text-3xl select-none\">📊</div>\n    <div>\n      <h1 class=\"text-2xl font-bold leading-tight\">Indeksregning</h1>\n      <p class=\"text-blue-200 text-sm\">Matematikk 1P (LK20) · Sinus 1P kap. 6</p>\n    </div>\n  </div>\n</header>\n\n<!-- =========================================================\n     TABS\n========================================================= -->\n<div class=\"max-w-5xl mx-auto px-4 mt-6\">\n  <div class=\"flex gap-0 border-b border-slate-200 mb-6 overflow-x-auto\">\n    <button class=\"tab-btn active px-5 py-3 text-sm whitespace-nowrap border-b-2\" data-tab=\"indeks\" onclick=\"switchTab('indeks', this)\">\n      1 · Indeks\n    </button>\n    <button class=\"tab-btn px-5 py-3 text-sm whitespace-nowrap border-b-2 border-transparent\" data-tab=\"kpi\" onclick=\"switchTab('kpi', this)\">\n      2 · Konsumprisindeksen (KPI)\n    </button>\n    <button class=\"tab-btn px-5 py-3 text-sm whitespace-nowrap border-b-2 border-transparent\" data-tab=\"reallohn\" onclick=\"switchTab('reallohn', this)\">\n      3 · Reallønn og kroneverdi\n    </button>\n  </div>\n\n  <!-- =====================================================\n       TAB 1 – INDEKS\n  ===================================================== -->\n  <div id=\"tab-indeks\" class=\"tab-content\">\n\n    <div class=\"formula-box p-4 mb-6\">\n      <p class=\"text-sm font-semibold text-blue-800 mb-1\">Formel — indeks</p>\n      <p class=\"text-blue-900 font-mono text-base\">\n        Indeks = (verdi / basisverdi) × 100\n      </p>\n      <p class=\"text-xs text-blue-700 mt-1\">\n        Basisåret får alltid indeks = 100. Andre år sammenlignes relativt til dette.\n      </p>\n    </div>\n\n    <!-- Controls -->\n    <div class=\"bg-white rounded-xl shadow-sm border border-slate-200 p-5 mb-6\">\n      <h2 class=\"font-semibold text-slate-700 mb-4\">Legg inn verdier for hvert år</h2>\n\n      <div class=\"flex flex-wrap gap-4 mb-4 items-end\">\n        <div>\n          <label class=\"block text-xs text-slate-500 mb-1\">Velg basisår</label>\n          <select id=\"basisYearSelect\" class=\"border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" onchange=\"recalcIndex()\"></select>\n        </div>\n        <div>\n          <label class=\"block text-xs text-slate-500 mb-1\">Enhet (valgfri)</label>\n          <input id=\"unitLabel\" type=\"text\" value=\"kr\" maxlength=\"12\"\n            class=\"border border-slate-300 rounded-lg px-3 py-2 text-sm w-24 focus:outline-none focus:ring-2 focus:ring-blue-400\"\n            oninput=\"recalcIndex()\" />\n        </div>\n      </div>\n\n      <!-- Year rows -->\n      <div id=\"yearRowsContainer\" class=\"space-y-2 mb-4\"></div>\n\n      <button onclick=\"addYearRow()\"\n        class=\"mt-1 text-sm text-blue-600 hover:text-blue-800 border border-blue-300 hover:border-blue-500 rounded-lg px-4 py-2 transition\">\n        + Legg til år\n      </button>\n    </div>\n\n    <!-- Results table -->\n    <div class=\"bg-white rounded-xl shadow-sm border border-slate-200 p-5 mb-6\">\n      <h2 class=\"font-semibold text-slate-700 mb-3\">Resultater</h2>\n      <div class=\"overflow-x-auto\">\n        <table class=\"w-full text-sm border-collapse\" id=\"indexTable\">\n          <thead>\n            <tr class=\"bg-slate-100\">\n              <th class=\"text-left px-3 py-2 rounded-tl-lg\">År</th>\n              <th class=\"text-right px-3 py-2\" id=\"valueColHeader\">Verdi (kr)</th>\n              <th class=\"text-right px-3 py-2 rounded-tr-lg\">Indeks</th>\n            </tr>\n          </thead>\n          <tbody id=\"indexTableBody\">\n          </tbody>\n        </table>\n      </div>\n      <p class=\"text-xs text-slate-400 mt-2\">Blå rad = basisår (indeks = 100)</p>\n    </div>\n\n    <!-- SVG chart -->\n    <div class=\"bg-white rounded-xl shadow-sm border border-slate-200 p-5 mb-8\">\n      <h2 class=\"font-semibold text-slate-700 mb-3\">Diagram</h2>\n      <div id=\"indexChartContainer\" class=\"w-full overflow-x-auto\">\n        <svg id=\"indexChart\" width=\"700\" height=\"320\" viewBox=\"0 0 700 320\"\n          class=\"block mx-auto\" style=\"max-width:100%\"></svg>\n      </div>\n    </div>\n\n  </div><!-- /tab-indeks -->\n\n\n  <!-- =====================================================\n       TAB 2 – KPI\n  ===================================================== -->\n  <div id=\"tab-kpi\" class=\"tab-content hidden\">\n\n    <div class=\"formula-box p-4 mb-6\">\n      <p class=\"text-sm font-semibold text-blue-800 mb-1\">Formel — KPI-omregning</p>\n      <p class=\"text-blue-900 font-mono text-base\">\n        Beløp i år Y = Beløp i år X × (KPI<sub>Y</sub> / KPI<sub>X</sub>)\n      </p>\n      <p class=\"text-xs text-blue-700 mt-1\">\n        Konsumprisindeksen (KPI) er utgitt av Statistisk sentralbyrå (SSB).\n        Basisår er 2015 = 100 i denne tabellen (offisielle tall, avrundet).\n      </p>\n    </div>\n\n    <!-- Static KPI table -->\n    <div class=\"bg-white rounded-xl shadow-sm border border-slate-200 p-5 mb-6\">\n      <h2 class=\"font-semibold text-slate-700 mb-3\">KPI-tabell (SSB, basis 2015=100)</h2>\n      <div class=\"overflow-x-auto\">\n        <table class=\"text-sm border-collapse w-full\">\n          <thead>\n            <tr class=\"bg-slate-100\">\n              <th class=\"text-left px-3 py-2 rounded-tl-lg\">År</th>\n              <th class=\"text-right px-3 py-2 rounded-tr-lg\">KPI</th>\n            </tr>\n          </thead>\n          <tbody id=\"kpiStaticBody\"></tbody>\n        </table>\n      </div>\n      <p class=\"text-xs text-slate-400 mt-2\">\n        Kilde: SSB (Statistisk sentralbyrå), tabell 03013. Tall er approksimerte årsgjennomsnitt.\n      </p>\n    </div>\n\n    <!-- Interactive calculator -->\n    <div class=\"bg-white rounded-xl shadow-sm border border-slate-200 p-5 mb-6\">\n      <h2 class=\"font-semibold text-slate-700 mb-4\">Kalkulator — hva tilsvarer X kr fra ett år i et annet?</h2>\n\n      <div class=\"grid grid-cols-1 sm:grid-cols-3 gap-4 mb-4\">\n        <div>\n          <label class=\"block text-xs text-slate-500 mb-1\">Beløp (kr)</label>\n          <input id=\"kpiAmount\" type=\"number\" value=\"1000\" min=\"0\"\n            class=\"border border-slate-300 rounded-lg px-3 py-2 text-sm w-full focus:outline-none focus:ring-2 focus:ring-blue-400\"\n            oninput=\"calcKPI()\" />\n        </div>\n        <div>\n          <label class=\"block text-xs text-slate-500 mb-1\">Fra år</label>\n          <select id=\"kpiFromYear\" class=\"border border-slate-300 rounded-lg px-3 py-2 text-sm w-full focus:outline-none focus:ring-2 focus:ring-blue-400\" onchange=\"calcKPI()\"></select>\n        </div>\n        <div>\n          <label class=\"block text-xs text-slate-500 mb-1\">Til år</label>\n          <select id=\"kpiToYear\" class=\"border border-slate-300 rounded-lg px-3 py-2 text-sm w-full focus:outline-none focus:ring-2 focus:ring-blue-400\" onchange=\"calcKPI()\"></select>\n        </div>\n      </div>\n\n      <div id=\"kpiResult\" class=\"formula-box p-4 text-sm text-blue-900\"></div>\n    </div>\n\n    <!-- Worked example -->\n    <div class=\"bg-amber-50 border border-amber-200 rounded-xl p-5 mb-8\">\n      <h2 class=\"font-semibold text-amber-800 mb-3\">📝 Regneeksempel</h2>\n      <div id=\"kpiExample\" class=\"text-sm text-amber-900 leading-relaxed space-y-2\"></div>\n    </div>\n\n    <!-- KPI chart -->\n    <div class=\"bg-white rounded-xl shadow-sm border border-slate-200 p-5 mb-8\">\n      <h2 class=\"font-semibold text-slate-700 mb-3\">KPI-utvikling (diagram)</h2>\n      <svg id=\"kpiChart\" width=\"700\" height=\"300\" viewBox=\"0 0 700 300\"\n        class=\"block mx-auto\" style=\"max-width:100%\"></svg>\n    </div>\n\n  </div><!-- /tab-kpi -->\n\n\n  <!-- =====================================================\n       TAB 3 – REALLØNN OG KRONEVERDI\n  ===================================================== -->\n  <div id=\"tab-reallohn\" class=\"tab-content hidden\">\n\n    <div class=\"formula-box p-4 mb-6\">\n      <p class=\"text-sm font-semibold text-blue-800 mb-2\">Formler</p>\n      <p class=\"text-blue-900 font-mono text-sm mb-1\">\n        Reallønn = Nominell lønn × (KPI<sub>basisår</sub> / KPI<sub>år</sub>)\n      </p>\n      <p class=\"text-blue-900 font-mono text-sm mb-1\">\n        Kroneverdi (indeks) = (KPI<sub>basisår</sub> / KPI<sub>år</sub>) × 100\n      </p>\n      <p class=\"text-xs text-blue-700 mt-2\">\n        <strong>Nominell lønn</strong> er den lønnen du faktisk mottar (i kroner).\n        <strong>Reallønn</strong> er hva lønnen er verdt i faste priser — altså kjøpekraften.\n        <strong>Kroneverdi</strong> viser hvor mye en krone fra basisåret er verdt i et gitt år.\n      </p>\n    </div>\n\n    <!-- Reallønn kalkulator -->\n    <div class=\"bg-white rounded-xl shadow-sm border border-slate-200 p-5 mb-6\">\n      <h2 class=\"font-semibold text-slate-700 mb-4\">Kalkulator — reallønn</h2>\n\n      <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4\">\n        <div>\n          <label class=\"block text-xs text-slate-500 mb-1\">Nominell lønn (kr/år)</label>\n          <input id=\"rlNomLon\" type=\"number\" value=\"520000\" min=\"0\"\n            class=\"border border-slate-300 rounded-lg px-3 py-2 text-sm w-full focus:outline-none focus:ring-2 focus:ring-blue-400\"\n            oninput=\"calcReallon()\" />\n        </div>\n        <div>\n          <label class=\"block text-xs text-slate-500 mb-1\">Lønnens år</label>\n          <select id=\"rlLonYear\" class=\"border border-slate-300 rounded-lg px-3 py-2 text-sm w-full focus:outline-none focus:ring-2 focus:ring-blue-400\" onchange=\"calcReallon()\"></select>\n        </div>\n        <div>\n          <label class=\"block text-xs text-slate-500 mb-1\">Sammenlign med basisår</label>\n          <select id=\"rlBaseYear\" class=\"border border-slate-300 rounded-lg px-3 py-2 text-sm w-full focus:outline-none focus:ring-2 focus:ring-blue-400\" onchange=\"calcReallon()\"></select>\n        </div>\n      </div>\n\n      <div id=\"rlResult\" class=\"formula-box p-4 text-sm text-blue-900 mb-4\"></div>\n    </div>\n\n    <!-- Scenario tabell – lønnsutvikling -->\n    <div class=\"bg-white rounded-xl shadow-sm border border-slate-200 p-5 mb-6\">\n      <h2 class=\"font-semibold text-slate-700 mb-3\">Eksempel — lønnsutvikling med og uten prisjustering</h2>\n      <p class=\"text-xs text-slate-500 mb-3\">\n        En arbeidstaker hadde lønn 400 000 kr i 2015. Tabellen viser nominell lønn etter gjennomsnitlig lønnsvekst ≈ 3 % per år,\n        og hva dette tilsvarer i 2015-kroner (reallønn).\n      </p>\n      <div class=\"overflow-x-auto\">\n        <table class=\"w-full text-sm border-collapse\">\n          <thead>\n            <tr class=\"bg-slate-100\">\n              <th class=\"text-left px-3 py-2\">År</th>\n              <th class=\"text-right px-3 py-2\">Nominell lønn (kr)</th>\n              <th class=\"text-right px-3 py-2\">KPI</th>\n              <th class=\"text-right px-3 py-2\">Reallønn (2015-kr)</th>\n              <th class=\"text-right px-3 py-2 rounded-tr-lg\">Kroneverdi (2015=100)</th>\n            </tr>\n          </thead>\n          <tbody id=\"rlScenarioBody\"></tbody>\n        </table>\n      </div>\n    </div>\n\n    <!-- Chart -->\n    <div class=\"bg-white rounded-xl shadow-sm border border-slate-200 p-5 mb-8\">\n      <h2 class=\"font-semibold text-slate-700 mb-3\">Diagram — nominell vs. reallønn</h2>\n      <div class=\"flex gap-4 text-xs text-slate-500 mb-2\">\n        <span class=\"flex items-center gap-1\"><span class=\"inline-block w-6 h-1 bg-blue-500 rounded\"></span> Nominell lønn</span>\n        <span class=\"flex items-center gap-1\"><span class=\"inline-block w-6 h-1 bg-red-500 rounded\"></span> Reallønn (2015-kr)</span>\n      </div>\n      <svg id=\"rlChart\" width=\"700\" height=\"300\" viewBox=\"0 0 700 300\"\n        class=\"block mx-auto\" style=\"max-width:100%\"></svg>\n    </div>\n\n    <!-- Forklaring -->\n    <div class=\"bg-green-50 border border-green-200 rounded-xl p-5 mb-8\">\n      <h2 class=\"font-semibold text-green-800 mb-2\">Forklaring — kroneverdi</h2>\n      <p class=\"text-sm text-green-900 leading-relaxed\">\n        <strong>Kroneverdi</strong> forteller oss hva én krone fra basisåret er verdt i et annet år, målt i kjøpekraft.\n        Hvis KPI stiger fra 100 til 120, har prisene økt med 20 %. Én krone fra basisåret tilsvarer da\n        <span class=\"font-mono\">100/120 × 100 ≈ 83,3</span> øre i kjøpekraft.\n        Det betyr at pengene har mistet ca. 17 % av verdien sin.\n      </p>\n      <p class=\"text-sm text-green-900 leading-relaxed mt-2\">\n        <strong>Reallønn</strong> er viktig fordi en lønnsvekst på 3 % ikke betyr noe hvis prisene stiger 5 %. Da er\n        reallønnen faktisk <em>redusert</em> — du har fått mer kroner, men kan kjøpe mindre.\n      </p>\n    </div>\n\n  </div><!-- /tab-reallohn -->\n\n</div><!-- /max-w-5xl -->\n\n<!-- =========================================================\n     FOOTER\n========================================================= -->\n<footer class=\"text-center text-xs text-slate-400 py-6 mt-4 border-t border-slate-200\">\n  Matematikk 1P (LK20) · Indeksregning · Halison App Studio — pedagogisk bruk\n</footer>\n\n<!-- =========================================================\n     JAVASCRIPT\n========================================================= -->\n<script>\n  \"use strict\";\n\n  // -------------------------------------------------------\n  // KPI DATA (SSB tabell 03013, årsgjennomsnitt, basis 2015=100)\n  // -------------------------------------------------------\n  const KPI_DATA = {\n    2000: 74.3,\n    2001: 76.8,\n    2002: 78.5,\n    2003: 80.1,\n    2004: 80.4,\n    2005: 81.6,\n    2006: 83.7,\n    2007: 85.0,\n    2008: 88.5,\n    2009: 90.5,\n    2010: 92.0,\n    2011: 94.2,\n    2012: 96.1,\n    2013: 97.8,\n    2014: 99.1,\n    2015: 100.0,\n    2016: 103.6,\n    2017: 105.5,\n    2018: 107.6,\n    2019: 109.7,\n    2020: 110.6,\n    2021: 113.0,\n    2022: 122.3,\n    2023: 130.1,\n    2024: 134.5,\n  };\n  const KPI_YEARS = Object.keys(KPI_DATA).map(Number).sort((a, b) => a - b);\n\n  // -------------------------------------------------------\n  // TAB SWITCHING\n  // -------------------------------------------------------\n  function switchTab(tabId, btn) {\n    document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));\n    document.querySelectorAll('.tab-btn').forEach(el => {\n      el.classList.remove('active');\n      el.classList.add('border-transparent');\n    });\n    document.getElementById('tab-' + tabId).classList.remove('hidden');\n    btn.classList.add('active');\n    btn.classList.remove('border-transparent');\n  }\n\n  // -------------------------------------------------------\n  // HELPERS\n  // -------------------------------------------------------\n  function fmt(n, decimals = 1) {\n    return n.toLocaleString('nb-NO', { minimumFractionDigits: decimals, maximumFractionDigits: decimals });\n  }\n\n  function fmtInt(n) {\n    return Math.round(n).toLocaleString('nb-NO');\n  }\n\n  // -------------------------------------------------------\n  // TAB 1 – INDEKS\n  // -------------------------------------------------------\n\n  // Default data: boligprisindeks (illustrativt, realistiske tall)\n  let indexData = [\n    { year: 2018, value: 3250000 },\n    { year: 2019, value: 3380000 },\n    { year: 2020, value: 3600000 },\n    { year: 2021, value: 4100000 },\n    { year: 2022, value: 4350000 },\n    { year: 2023, value: 4280000 },\n    { year: 2024, value: 4510000 },\n  ];\n  let basisYear = 2018;\n\n  function initIndexTab() {\n    renderYearRows();\n    updateBasisSelect();\n    recalcIndex();\n  }\n\n  function renderYearRows() {\n    const container = document.getElementById('yearRowsContainer');\n    container.innerHTML = '';\n    indexData.forEach((row, i) => {\n      const div = document.createElement('div');\n      div.className = 'flex flex-wrap gap-2 items-center';\n      div.innerHTML = `\n        <input type=\"number\" value=\"${row.year}\" min=\"1900\" max=\"2100\"\n          class=\"border border-slate-300 rounded-lg px-2 py-1.5 text-sm w-24 focus:outline-none focus:ring-2 focus:ring-blue-400\"\n          onchange=\"updateIndexRow(${i}, 'year', this.value)\" placeholder=\"År\" />\n        <input type=\"number\" value=\"${row.value}\" min=\"0\"\n          class=\"border border-slate-300 rounded-lg px-2 py-1.5 text-sm w-36 focus:outline-none focus:ring-2 focus:ring-blue-400\"\n          onchange=\"updateIndexRow(${i}, 'value', this.value)\" placeholder=\"Verdi\" />\n        <button onclick=\"removeIndexRow(${i})\"\n          class=\"text-slate-400 hover:text-red-500 text-lg leading-none px-1 transition\" title=\"Fjern rad\">×</button>\n      `;\n      container.appendChild(div);\n    });\n    updateBasisSelect();\n  }\n\n  function updateIndexRow(i, field, val) {\n    if (field === 'year') indexData[i].year = parseInt(val) || 0;\n    else indexData[i].value = parseFloat(val) || 0;\n    indexData.sort((a, b) => a.year - b.year);\n    renderYearRows();\n    recalcIndex();\n  }\n\n  function removeIndexRow(i) {\n    if (indexData.length <= 2) { alert('Du trenger minst 2 rader.'); return; }\n    indexData.splice(i, 1);\n    renderYearRows();\n    recalcIndex();\n  }\n\n  function addYearRow() {\n    const lastYear = indexData.length > 0 ? Math.max(...indexData.map(r => r.year)) : 2024;\n    indexData.push({ year: lastYear + 1, value: 0 });\n    indexData.sort((a, b) => a.year - b.year);\n    renderYearRows();\n    recalcIndex();\n  }\n\n  function updateBasisSelect() {\n    const sel = document.getElementById('basisYearSelect');\n    const currentBasis = basisYear;\n    sel.innerHTML = '';\n    indexData.forEach(row => {\n      const opt = document.createElement('option');\n      opt.value = row.year;\n      opt.textContent = row.year;\n      if (row.year === currentBasis) opt.selected = true;\n      sel.appendChild(opt);\n    });\n    if (!indexData.find(r => r.year === currentBasis)) {\n      basisYear = indexData[0] ? indexData[0].year : 2018;\n    }\n  }\n\n  function recalcIndex() {\n    basisYear = parseInt(document.getElementById('basisYearSelect').value) || basisYear;\n    const unit = document.getElementById('unitLabel').value || 'kr';\n\n    // Update header\n    document.getElementById('valueColHeader').textContent = 'Verdi (' + unit + ')';\n\n    const basisRow = indexData.find(r => r.year === basisYear);\n    if (!basisRow || basisRow.value === 0) {\n      document.getElementById('indexTableBody').innerHTML =\n        '<tr><td colspan=\"3\" class=\"text-center py-3 text-slate-400\">Basisverdien kan ikke være 0.</td></tr>';\n      return;\n    }\n\n    const basisVal = basisRow.value;\n    const rows = indexData.map(r => ({\n      year: r.year,\n      value: r.value,\n      index: (r.value / basisVal) * 100\n    }));\n\n    // Table\n    const tbody = document.getElementById('indexTableBody');\n    tbody.innerHTML = '';\n    rows.forEach(r => {\n      const tr = document.createElement('tr');\n      tr.className = (r.year === basisYear) ? 'basis-row' : 'hover:bg-slate-50';\n      tr.innerHTML = `\n        <td class=\"px-3 py-2\">${r.year}${r.year === basisYear ? ' <span class=\"text-xs text-blue-600\">(basisår)</span>' : ''}</td>\n        <td class=\"px-3 py-2 text-right font-mono\">${fmtInt(r.value)}</td>\n        <td class=\"px-3 py-2 text-right font-mono\">${fmt(r.index)}</td>\n      `;\n      tbody.appendChild(tr);\n    });\n\n    drawIndexChart(rows);\n  }\n\n  function drawIndexChart(rows) {\n    const svg = document.getElementById('indexChart');\n    const W = 700, H = 320;\n    const padL = 60, padR = 30, padT = 20, padB = 50;\n    const cW = W - padL - padR;\n    const cH = H - padT - padB;\n\n    if (rows.length < 2) { svg.innerHTML = ''; return; }\n\n    const indices = rows.map(r => r.index);\n    const minIdx = Math.min(...indices);\n    const maxIdx = Math.max(...indices);\n    const span = maxIdx - minIdx || 1;\n    const yMin = Math.max(0, minIdx - span * 0.1);\n    const yMax = maxIdx + span * 0.1;\n\n    const xScale = i => padL + (i / (rows.length - 1)) * cW;\n    const yScale = v => padT + cH - ((v - yMin) / (yMax - yMin)) * cH;\n\n    let html = '';\n\n    // Grid lines\n    const ticks = 5;\n    for (let t = 0; t <= ticks; t++) {\n      const v = yMin + (yMax - yMin) * (t / ticks);\n      const y = yScale(v);\n      html += `<line x1=\"${padL}\" y1=\"${y}\" x2=\"${W - padR}\" y2=\"${y}\"\n        stroke=\"#e2e8f0\" stroke-width=\"1\" stroke-dasharray=\"4,3\"/>`;\n      html += `<text x=\"${padL - 6}\" y=\"${y + 4}\" text-anchor=\"end\" font-size=\"11\" fill=\"#94a3b8\">${fmt(v, 0)}</text>`;\n    }\n\n    // Reference line at 100\n    if (yMin <= 100 && yMax >= 100) {\n      const y100 = yScale(100);\n      html += `<line x1=\"${padL}\" y1=\"${y100}\" x2=\"${W - padR}\" y2=\"${y100}\"\n        stroke=\"#3b82f6\" stroke-width=\"1\" stroke-dasharray=\"6,4\" opacity=\"0.5\"/>`;\n      html += `<text x=\"${padL + 4}\" y=\"${y100 - 4}\" font-size=\"10\" fill=\"#3b82f6\">100</text>`;\n    }\n\n    // Area\n    let areaPoints = `${xScale(0)},${padT + cH}`;\n    rows.forEach((r, i) => { areaPoints += ` ${xScale(i)},${yScale(r.index)}`; });\n    areaPoints += ` ${xScale(rows.length - 1)},${padT + cH}`;\n    html += `<polygon points=\"${areaPoints}\" class=\"chart-area\"/>`;\n\n    // Line\n    let linePath = `M ${xScale(0)},${yScale(rows[0].index)}`;\n    rows.forEach((r, i) => { if (i > 0) linePath += ` L ${xScale(i)},${yScale(r.index)}`; });\n    html += `<path d=\"${linePath}\" class=\"chart-line\"/>`;\n\n    // Points and labels\n    rows.forEach((r, i) => {\n      const x = xScale(i), y = yScale(r.index);\n      const isBasis = r.year === basisYear;\n      html += `<circle cx=\"${x}\" cy=\"${y}\" r=\"${isBasis ? 6 : 4}\"\n        fill=\"${isBasis ? '#1d4ed8' : '#3b82f6'}\" stroke=\"white\" stroke-width=\"1.5\"/>`;\n      html += `<text x=\"${x}\" y=\"${y - 10}\" text-anchor=\"middle\" font-size=\"11\"\n        fill=\"${isBasis ? '#1d4ed8' : '#475569'}\" font-weight=\"${isBasis ? 'bold' : 'normal'}\">${fmt(r.index, 1)}</text>`;\n      // X axis label\n      html += `<text x=\"${x}\" y=\"${H - padB + 18}\" text-anchor=\"middle\" font-size=\"11\" fill=\"#64748b\">${r.year}</text>`;\n    });\n\n    // Axes\n    html += `<line x1=\"${padL}\" y1=\"${padT}\" x2=\"${padL}\" y2=\"${padT + cH}\" stroke=\"#94a3b8\" stroke-width=\"1\"/>`;\n    html += `<line x1=\"${padL}\" y1=\"${padT + cH}\" x2=\"${W - padR}\" y2=\"${padT + cH}\" stroke=\"#94a3b8\" stroke-width=\"1\"/>`;\n\n    // Y axis label\n    html += `<text x=\"14\" y=\"${padT + cH / 2}\" text-anchor=\"middle\" font-size=\"12\" fill=\"#64748b\"\n      transform=\"rotate(-90, 14, ${padT + cH / 2})\">Indeks</text>`;\n\n    svg.innerHTML = html;\n  }\n\n  // -------------------------------------------------------\n  // TAB 2 – KPI\n  // -------------------------------------------------------\n\n  function initKpiTab() {\n    // Static table\n    const tbody = document.getElementById('kpiStaticBody');\n    KPI_YEARS.forEach(y => {\n      const tr = document.createElement('tr');\n      tr.className = (y === 2015) ? 'basis-row' : 'hover:bg-slate-50';\n      tr.innerHTML = `<td class=\"px-3 py-2\">${y}${y === 2015 ? ' <span class=\"text-xs text-blue-600\">(basisår)</span>' : ''}</td>\n        <td class=\"px-3 py-2 text-right font-mono\">${fmt(KPI_DATA[y])}</td>`;\n      tbody.appendChild(tr);\n    });\n\n    // Dropdowns\n    ['kpiFromYear', 'kpiToYear'].forEach(id => {\n      const sel = document.getElementById(id);\n      KPI_YEARS.forEach(y => {\n        const opt = document.createElement('option');\n        opt.value = y;\n        opt.textContent = y;\n        sel.appendChild(opt);\n      });\n    });\n    document.getElementById('kpiFromYear').value = '2010';\n    document.getElementById('kpiToYear').value = '2024';\n\n    calcKPI();\n    drawKpiChart();\n  }\n\n  function calcKPI() {\n    const amount = parseFloat(document.getElementById('kpiAmount').value) || 0;\n    const fromY = parseInt(document.getElementById('kpiFromYear').value);\n    const toY = parseInt(document.getElementById('kpiToYear').value);\n\n    const kpiFrom = KPI_DATA[fromY];\n    const kpiTo = KPI_DATA[toY];\n    const result = amount * (kpiTo / kpiFrom);\n    const change = ((result - amount) / amount) * 100;\n    const changeStr = change >= 0 ? '+' + fmt(change) + ' %' : fmt(change) + ' %';\n\n    const div = document.getElementById('kpiResult');\n    div.innerHTML = `\n      <p class=\"font-mono text-base mb-1\">\n        ${fmtInt(amount)} kr i ${fromY} ≈ <strong class=\"text-blue-700\">${fmtInt(result)} kr</strong> i ${toY}\n      </p>\n      <p class=\"text-xs mt-1 text-slate-600\">\n        Prisendring: ${changeStr} &nbsp;|&nbsp; KPI ${fromY}: ${fmt(kpiFrom)} &nbsp;→&nbsp; KPI ${toY}: ${fmt(kpiTo)}\n      </p>\n      <p class=\"text-xs mt-1 text-slate-500 font-mono\">\n        Utregning: ${fmtInt(amount)} × (${fmt(kpiTo)} / ${fmt(kpiFrom)}) = ${fmtInt(result)}\n      </p>\n    `;\n\n    updateKpiExample(amount, fromY, toY, kpiFrom, kpiTo, result);\n  }\n\n  function updateKpiExample(amount, fromY, toY, kpiFrom, kpiTo, result) {\n    const div = document.getElementById('kpiExample');\n    const earlier = fromY < toY ? fromY : toY;\n    const later = fromY < toY ? toY : fromY;\n    const amtEarlier = fromY < toY ? amount : result;\n    const amtLater = fromY < toY ? result : amount;\n\n    div.innerHTML = `\n      <p><strong>Oppgave:</strong> En bruktbil kostet ${fmtInt(amount)} kr i ${fromY}. Hva tilsvarer det i ${toY}?</p>\n      <p><strong>Steg 1 – finn KPI-verdiene:</strong></p>\n      <p class=\"font-mono pl-4\">KPI<sub>${fromY}</sub> = ${fmt(kpiFrom)}, &nbsp; KPI<sub>${toY}</sub> = ${fmt(kpiTo)}</p>\n      <p><strong>Steg 2 – bruk formelen:</strong></p>\n      <p class=\"font-mono pl-4\">\n        Beløp i ${toY} = ${fmtInt(amount)} × (${fmt(kpiTo)} / ${fmt(kpiFrom)})\n      </p>\n      <p class=\"font-mono pl-4\">\n        = ${fmtInt(amount)} × ${fmt(kpiTo / kpiFrom, 4)} ≈ <strong>${fmtInt(result)} kr</strong>\n      </p>\n      <p><strong>Svar:</strong> ${fmtInt(amount)} kr i ${fromY} tilsvarer omtrent ${fmtInt(result)} kr i ${toY}\n        i faste priser (kjøpekraft).</p>\n    `;\n  }\n\n  function drawKpiChart() {\n    const svg = document.getElementById('kpiChart');\n    const W = 700, H = 300;\n    const padL = 60, padR = 30, padT = 20, padB = 50;\n    const cW = W - padL - padR;\n    const cH = H - padT - padB;\n\n    const vals = KPI_YEARS.map(y => KPI_DATA[y]);\n    const yMin = 60;\n    const yMax = 145;\n    const n = KPI_YEARS.length;\n\n    const xScale = i => padL + (i / (n - 1)) * cW;\n    const yScale = v => padT + cH - ((v - yMin) / (yMax - yMin)) * cH;\n\n    let html = '';\n\n    // Grid\n    [70, 80, 90, 100, 110, 120, 130, 140].forEach(v => {\n      if (v < yMin || v > yMax) return;\n      const y = yScale(v);\n      html += `<line x1=\"${padL}\" y1=\"${y}\" x2=\"${W - padR}\" y2=\"${y}\"\n        stroke=\"${v === 100 ? '#3b82f6' : '#e2e8f0'}\" stroke-width=\"${v === 100 ? 1.5 : 1}\"\n        stroke-dasharray=\"${v === 100 ? '6,4' : '4,3'}\" opacity=\"${v === 100 ? '0.6' : '1'}\"/>`;\n      html += `<text x=\"${padL - 6}\" y=\"${y + 4}\" text-anchor=\"end\" font-size=\"11\" fill=\"#94a3b8\">${v}</text>`;\n    });\n\n    // Area\n    let area = `${xScale(0)},${padT + cH}`;\n    KPI_YEARS.forEach((y, i) => { area += ` ${xScale(i)},${yScale(KPI_DATA[y])}`; });\n    area += ` ${xScale(n - 1)},${padT + cH}`;\n    html += `<polygon points=\"${area}\" fill=\"rgba(59,130,246,0.07)\"/>`;\n\n    // Line\n    let path = `M ${xScale(0)},${yScale(vals[0])}`;\n    KPI_YEARS.forEach((y, i) => { if (i > 0) path += ` L ${xScale(i)},${yScale(KPI_DATA[y])}`; });\n    html += `<path d=\"${path}\" class=\"chart-line\"/>`;\n\n    // X labels — every 5 years\n    KPI_YEARS.forEach((y, i) => {\n      if (y % 5 === 0) {\n        html += `<text x=\"${xScale(i)}\" y=\"${H - padB + 18}\" text-anchor=\"middle\" font-size=\"11\" fill=\"#64748b\">${y}</text>`;\n        html += `<line x1=\"${xScale(i)}\" y1=\"${padT + cH}\" x2=\"${xScale(i)}\" y2=\"${padT + cH + 4}\" stroke=\"#94a3b8\" stroke-width=\"1\"/>`;\n      }\n    });\n\n    // Axes\n    html += `<line x1=\"${padL}\" y1=\"${padT}\" x2=\"${padL}\" y2=\"${padT + cH}\" stroke=\"#94a3b8\" stroke-width=\"1\"/>`;\n    html += `<line x1=\"${padL}\" y1=\"${padT + cH}\" x2=\"${W - padR}\" y2=\"${padT + cH}\" stroke=\"#94a3b8\" stroke-width=\"1\"/>`;\n    html += `<text x=\"14\" y=\"${padT + cH / 2}\" text-anchor=\"middle\" font-size=\"12\" fill=\"#64748b\"\n      transform=\"rotate(-90, 14, ${padT + cH / 2})\">KPI</text>`;\n\n    svg.innerHTML = html;\n  }\n\n  // -------------------------------------------------------\n  // TAB 3 – REALLØNN\n  // -------------------------------------------------------\n\n  function initReallonnTab() {\n    // Populate dropdowns\n    ['rlLonYear', 'rlBaseYear'].forEach(id => {\n      const sel = document.getElementById(id);\n      KPI_YEARS.forEach(y => {\n        const opt = document.createElement('option');\n        opt.value = y;\n        opt.textContent = y;\n        sel.appendChild(opt);\n      });\n    });\n    document.getElementById('rlLonYear').value = '2024';\n    document.getElementById('rlBaseYear').value = '2015';\n\n    buildScenarioTable();\n    calcReallon();\n  }\n\n  function calcReallon() {\n    const nomLon = parseFloat(document.getElementById('rlNomLon').value) || 0;\n    const lonYear = parseInt(document.getElementById('rlLonYear').value);\n    const baseYear = parseInt(document.getElementById('rlBaseYear').value);\n\n    const kpiLon = KPI_DATA[lonYear];\n    const kpiBase = KPI_DATA[baseYear];\n    if (!kpiLon || !kpiBase) return;\n\n    const realLon = nomLon * (kpiBase / kpiLon);\n    const kroneverdi = (kpiBase / kpiLon) * 100;\n    const diff = realLon - nomLon;\n    const diffStr = diff >= 0 ? '+' + fmtInt(Math.abs(diff)) : '−' + fmtInt(Math.abs(diff));\n\n    document.getElementById('rlResult').innerHTML = `\n      <p class=\"font-mono text-base mb-1\">\n        Reallønn (${baseYear}-kroner): <strong class=\"text-blue-700\">${fmtInt(realLon)} kr/år</strong>\n      </p>\n      <p class=\"text-xs text-slate-600 mt-1\">\n        Nominell lønn ${lonYear}: ${fmtInt(nomLon)} kr &nbsp;|&nbsp;\n        Reallønn: ${fmtInt(realLon)} kr &nbsp;(${diffStr} kr justert for prisvekst siden ${baseYear})\n      </p>\n      <p class=\"text-xs text-slate-500 font-mono mt-1\">\n        Kroneverdi (${baseYear}=100): ${fmt(kroneverdi)} &nbsp;|&nbsp;\n        Utregning: ${fmtInt(nomLon)} × (${fmt(kpiBase)} / ${fmt(kpiLon)}) = ${fmtInt(realLon)}\n      </p>\n    `;\n  }\n\n  function buildScenarioTable() {\n    // Worker started 2015 with 400 000 kr, ~3% nominal raise per year\n    const startYear = 2015;\n    const startLon = 400000;\n    const nomGrowth = 0.03;\n    const baseKpi = KPI_DATA[2015];\n\n    const scenarioYears = [2015, 2016, 2017, 2018, 2019, 2020, 2021, 2022, 2023, 2024];\n    const tbody = document.getElementById('rlScenarioBody');\n    tbody.innerHTML = '';\n\n    const nomData = [];\n    const realData = [];\n\n    scenarioYears.forEach(y => {\n      const yearsSince = y - startYear;\n      const nomLon = startLon * Math.pow(1 + nomGrowth, yearsSince);\n      const kpi = KPI_DATA[y];\n      const realLon = nomLon * (baseKpi / kpi);\n      const kroneverdi = (baseKpi / kpi) * 100;\n\n      nomData.push(nomLon);\n      realData.push(realLon);\n\n      const tr = document.createElement('tr');\n      tr.className = (y === startYear) ? 'basis-row' : 'hover:bg-slate-50';\n      tr.innerHTML = `\n        <td class=\"px-3 py-2\">${y}${y === startYear ? ' <span class=\"text-xs text-blue-600\">(basis)</span>' : ''}</td>\n        <td class=\"px-3 py-2 text-right font-mono\">${fmtInt(nomLon)}</td>\n        <td class=\"px-3 py-2 text-right font-mono\">${fmt(kpi)}</td>\n        <td class=\"px-3 py-2 text-right font-mono ${realLon >= nomLon ? 'text-green-700' : 'text-red-700'}\">${fmtInt(realLon)}</td>\n        <td class=\"px-3 py-2 text-right font-mono\">${fmt(kroneverdi)}</td>\n      `;\n      tbody.appendChild(tr);\n    });\n\n    drawRlChart(scenarioYears, nomData, realData);\n  }\n\n  function drawRlChart(years, nomData, realData) {\n    const svg = document.getElementById('rlChart');\n    const W = 700, H = 300;\n    const padL = 75, padR = 30, padT = 20, padB = 50;\n    const cW = W - padL - padR;\n    const cH = H - padT - padB;\n    const n = years.length;\n\n    const allVals = [...nomData, ...realData];\n    const yMin = Math.min(...allVals) * 0.95;\n    const yMax = Math.max(...allVals) * 1.05;\n\n    const xScale = i => padL + (i / (n - 1)) * cW;\n    const yScale = v => padT + cH - ((v - yMin) / (yMax - yMin)) * cH;\n\n    let html = '';\n\n    // Grid\n    const ticks = 5;\n    for (let t = 0; t <= ticks; t++) {\n      const v = yMin + (yMax - yMin) * (t / ticks);\n      const y = yScale(v);\n      html += `<line x1=\"${padL}\" y1=\"${y}\" x2=\"${W - padR}\" y2=\"${y}\"\n        stroke=\"#e2e8f0\" stroke-width=\"1\" stroke-dasharray=\"4,3\"/>`;\n      html += `<text x=\"${padL - 6}\" y=\"${y + 4}\" text-anchor=\"end\" font-size=\"10\" fill=\"#94a3b8\">${fmtInt(v)}</text>`;\n    }\n\n    // Nominal area + line\n    let nomArea = `${xScale(0)},${padT + cH}`;\n    nomData.forEach((v, i) => { nomArea += ` ${xScale(i)},${yScale(v)}`; });\n    nomArea += ` ${xScale(n - 1)},${padT + cH}`;\n    html += `<polygon points=\"${nomArea}\" fill=\"rgba(59,130,246,0.06)\"/>`;\n\n    let nomPath = `M ${xScale(0)},${yScale(nomData[0])}`;\n    nomData.forEach((v, i) => { if (i > 0) nomPath += ` L ${xScale(i)},${yScale(v)}`; });\n    html += `<path d=\"${nomPath}\" class=\"chart-line\"/>`;\n\n    // Real line\n    let realPath = `M ${xScale(0)},${yScale(realData[0])}`;\n    realData.forEach((v, i) => { if (i > 0) realPath += ` L ${xScale(i)},${yScale(v)}`; });\n    html += `<path d=\"${realPath}\" class=\"chart-line-red\"/>`;\n\n    // Points\n    nomData.forEach((v, i) => {\n      html += `<circle cx=\"${xScale(i)}\" cy=\"${yScale(v)}\" r=\"3.5\" fill=\"#3b82f6\" stroke=\"white\" stroke-width=\"1.5\"/>`;\n    });\n    realData.forEach((v, i) => {\n      html += `<circle cx=\"${xScale(i)}\" cy=\"${yScale(v)}\" r=\"3.5\" fill=\"#ef4444\" stroke=\"white\" stroke-width=\"1.5\"/>`;\n    });\n\n    // X labels\n    years.forEach((y, i) => {\n      html += `<text x=\"${xScale(i)}\" y=\"${H - padB + 18}\" text-anchor=\"middle\" font-size=\"11\" fill=\"#64748b\">${y}</text>`;\n    });\n\n    // Axes\n    html += `<line x1=\"${padL}\" y1=\"${padT}\" x2=\"${padL}\" y2=\"${padT + cH}\" stroke=\"#94a3b8\" stroke-width=\"1\"/>`;\n    html += `<line x1=\"${padL}\" y1=\"${padT + cH}\" x2=\"${W - padR}\" y2=\"${padT + cH}\" stroke=\"#94a3b8\" stroke-width=\"1\"/>`;\n    html += `<text x=\"14\" y=\"${padT + cH / 2}\" text-anchor=\"middle\" font-size=\"11\" fill=\"#64748b\"\n      transform=\"rotate(-90, 14, ${padT + cH / 2})\">Lønn (kr)</text>`;\n\n    svg.innerHTML = html;\n  }\n\n  // -------------------------------------------------------\n  // INIT\n  // -------------------------------------------------------\n  (function init() {\n    initIndexTab();\n    initKpiTab();\n    initReallonnTab();\n  })();\n</script>\n\n</body>\n</html>\n",
  "packaging": {
    "appName": "Indeksregning",
    "windowTitle": "Indeksregning",
    "bundleId": "com.halisonworks.indeksregning",
    "iconPath": null
  },
  "categoryId": null,
  "source": "import",
  "createdAt": "2026-06-02T12:00:00.000Z",
  "updatedAt": "2026-06-02T12:00:00.000Z",
  "sharedAt": "2026-06-02T12:00:00.000Z"
}
