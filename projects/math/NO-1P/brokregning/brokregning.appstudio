{
  "schema": "app-studio/canvas@1",
  "id": "example-no1p-brokregning",
  "name": "brokregning.html",
  "code": "<!DOCTYPE html>\n<!--\n  Brøkregning — Halison App Studio-eksempel\n\n  Interaktivt læremiddel for matematikk 1P (LK20): forkorting og utviding av\n  brøker, de fire regneartene med brøk, og brøkdelen av et tall.\n\n  Fra Halison App Studio sitt offentlige bibliotek:\n  https://github.com/halisonworks/public-app-studio\n\n  Tillatt bruk: personlig, pedagogisk og annen ikke-kommersiell bruk. Behold denne\n  headeren og kildelenken; ikke-kommersiell bruk. Utgitt under Halison App Studio\n  Examples License — se LICENSE-filen i repoet over.\n-->\n<html lang=\"no\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Brøkregning — Matematikk 1P</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Segoe UI', system-ui, sans-serif; }\n    .fraction { display: inline-flex; flex-direction: column; align-items: center; vertical-align: middle; margin: 0 4px; }\n    .fraction .num { border-bottom: 2px solid currentColor; padding: 0 4px; line-height: 1.2; }\n    .fraction .den { padding: 0 4px; line-height: 1.2; }\n    .tab-active { background-color: #1d4ed8; color: white; }\n    .tab-inactive { background-color: #e5e7eb; color: #374151; }\n    .step-box { background: #f0f9ff; border-left: 4px solid #0ea5e9; padding: 12px 16px; border-radius: 6px; margin: 8px 0; }\n    .answer-box { background: #f0fdf4; border-left: 4px solid #22c55e; padding: 12px 16px; border-radius: 6px; margin: 8px 0; }\n    .error-box { background: #fef2f2; border-left: 4px solid #ef4444; padding: 10px 14px; border-radius: 6px; margin: 8px 0; }\n    .pie-container { width: 120px; height: 120px; position: relative; }\n    input[type=number]::-webkit-inner-spin-button,\n    input[type=number]::-webkit-outer-spin-button { opacity: 1; }\n    .input-frac { width: 60px; text-align: center; border: 2px solid #cbd5e1; border-radius: 6px; padding: 4px 6px; font-size: 1.1rem; }\n    .input-frac:focus { outline: none; border-color: #3b82f6; }\n  </style>\n</head>\n<body class=\"bg-slate-50 min-h-screen\">\n\n  <!-- Header -->\n  <header class=\"bg-blue-700 text-white shadow-md\">\n    <div class=\"max-w-3xl mx-auto px-4 py-4\">\n      <h1 class=\"text-2xl font-bold tracking-tight\">Brøkregning</h1>\n      <p class=\"text-blue-200 text-sm mt-0.5\">Matematikk 1P · LK20 · Sinus 1P kap. 1.3–1.5</p>\n    </div>\n  </header>\n\n  <!-- Tab navigation -->\n  <nav class=\"max-w-3xl mx-auto px-4 mt-4\">\n    <div class=\"flex flex-wrap gap-2\">\n      <button onclick=\"showTab('forkorting')\" id=\"tab-forkorting\" class=\"tab-active px-4 py-2 rounded-lg font-medium text-sm transition-colors\">Forkorting og utviding</button>\n      <button onclick=\"showTab('regnearter')\" id=\"tab-regnearter\" class=\"tab-inactive px-4 py-2 rounded-lg font-medium text-sm transition-colors\">De fire regneartene</button>\n      <button onclick=\"showTab('del')\" id=\"tab-del\" class=\"tab-inactive px-4 py-2 rounded-lg font-medium text-sm transition-colors\">Brøkdelen av et tall</button>\n    </div>\n  </nav>\n\n  <main class=\"max-w-3xl mx-auto px-4 py-6 space-y-6\">\n\n    <!-- ===== TAB 1: Forkorting og utviding ===== -->\n    <section id=\"tab-forkorting-content\">\n      <div class=\"bg-white rounded-2xl shadow p-6\">\n        <h2 class=\"text-lg font-semibold text-blue-800 mb-1\">Forkorting og utviding av brøk</h2>\n        <p class=\"text-slate-500 text-sm mb-4\">Skriv inn en brøk. Velg om du vil forkorte til laveste termer eller utvide med et tall.</p>\n\n        <!-- Input -->\n        <div class=\"flex items-center gap-4 flex-wrap\">\n          <div class=\"flex flex-col items-center gap-1\">\n            <label class=\"text-xs text-slate-500 uppercase tracking-wide\">Teller</label>\n            <input type=\"number\" id=\"fk-num\" class=\"input-frac\" value=\"12\" min=\"-999\" max=\"999\" />\n          </div>\n          <span class=\"text-2xl text-slate-400 mt-4\">/</span>\n          <div class=\"flex flex-col items-center gap-1\">\n            <label class=\"text-xs text-slate-500 uppercase tracking-wide\">Nevner</label>\n            <input type=\"number\" id=\"fk-den\" class=\"input-frac\" value=\"18\" min=\"-999\" max=\"999\" />\n          </div>\n        </div>\n\n        <!-- Mode selector -->\n        <div class=\"mt-4 flex gap-3 flex-wrap\">\n          <label class=\"flex items-center gap-2 cursor-pointer\">\n            <input type=\"radio\" name=\"fk-mode\" value=\"forkorte\" checked class=\"accent-blue-600\" />\n            <span class=\"text-sm font-medium\">Forkorte (laveste termer)</span>\n          </label>\n          <label class=\"flex items-center gap-2 cursor-pointer\">\n            <input type=\"radio\" name=\"fk-mode\" value=\"utvide\" class=\"accent-blue-600\" />\n            <span class=\"text-sm font-medium\">Utvide</span>\n          </label>\n        </div>\n\n        <!-- Expand factor -->\n        <div id=\"fk-expand-row\" class=\"mt-3 hidden flex items-center gap-3\">\n          <label class=\"text-sm text-slate-600\">Utvid med faktoren:</label>\n          <input type=\"number\" id=\"fk-factor\" class=\"input-frac\" value=\"3\" min=\"2\" max=\"100\" />\n        </div>\n\n        <button onclick=\"doForkorting()\" class=\"mt-4 bg-blue-600 hover:bg-blue-700 text-white px-5 py-2 rounded-lg font-medium text-sm transition-colors\">Beregn</button>\n\n        <div id=\"fk-result\" class=\"mt-4\"></div>\n      </div>\n\n      <!-- Visual -->\n      <div class=\"bg-white rounded-2xl shadow p-6 mt-4\">\n        <h3 class=\"text-sm font-semibold text-slate-600 mb-3 uppercase tracking-wide\">Visuell representasjon</h3>\n        <div class=\"flex items-center gap-6 flex-wrap\">\n          <div>\n            <p class=\"text-xs text-slate-500 mb-1 text-center\">Opprinnelig</p>\n            <canvas id=\"fk-canvas-before\" width=\"120\" height=\"120\"></canvas>\n          </div>\n          <div id=\"fk-visual-arrow\" class=\"hidden\">\n            <span class=\"text-2xl text-slate-400\">→</span>\n          </div>\n          <div id=\"fk-canvas-after-wrap\" class=\"hidden\">\n            <p class=\"text-xs text-slate-500 mb-1 text-center\">Etter</p>\n            <canvas id=\"fk-canvas-after\" width=\"120\" height=\"120\"></canvas>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- ===== TAB 2: De fire regneartene ===== -->\n    <section id=\"tab-regnearter-content\" class=\"hidden\">\n      <div class=\"bg-white rounded-2xl shadow p-6\">\n        <h2 class=\"text-lg font-semibold text-blue-800 mb-1\">De fire regneartene med brøk</h2>\n        <p class=\"text-slate-500 text-sm mb-4\">Skriv inn to brøker og velg operasjon. Utregningen vises steg for steg.</p>\n\n        <!-- Two fractions + operator -->\n        <div class=\"flex items-end gap-3 flex-wrap\">\n          <!-- Fraction A -->\n          <div class=\"flex flex-col items-center gap-1\">\n            <span class=\"text-xs text-slate-500 uppercase tracking-wide\">Brøk 1</span>\n            <div class=\"flex flex-col items-center\">\n              <input type=\"number\" id=\"rg-a-num\" class=\"input-frac\" value=\"2\" />\n              <div class=\"w-full border-t-2 border-slate-400 my-0.5\"></div>\n              <input type=\"number\" id=\"rg-a-den\" class=\"input-frac\" value=\"3\" />\n            </div>\n          </div>\n\n          <!-- Operator -->\n          <div class=\"mb-2\">\n            <select id=\"rg-op\" class=\"border-2 border-slate-300 rounded-lg px-3 py-2 text-lg font-bold bg-white focus:outline-none focus:border-blue-500\">\n              <option value=\"add\">+</option>\n              <option value=\"sub\">−</option>\n              <option value=\"mul\">×</option>\n              <option value=\"div\">÷</option>\n            </select>\n          </div>\n\n          <!-- Fraction B -->\n          <div class=\"flex flex-col items-center gap-1\">\n            <span class=\"text-xs text-slate-500 uppercase tracking-wide\">Brøk 2</span>\n            <div class=\"flex flex-col items-center\">\n              <input type=\"number\" id=\"rg-b-num\" class=\"input-frac\" value=\"1\" />\n              <div class=\"w-full border-t-2 border-slate-400 my-0.5\"></div>\n              <input type=\"number\" id=\"rg-b-den\" class=\"input-frac\" value=\"4\" />\n            </div>\n          </div>\n        </div>\n\n        <button onclick=\"doRegnearter()\" class=\"mt-4 bg-blue-600 hover:bg-blue-700 text-white px-5 py-2 rounded-lg font-medium text-sm transition-colors\">Beregn</button>\n\n        <div id=\"rg-result\" class=\"mt-4\"></div>\n      </div>\n    </section>\n\n    <!-- ===== TAB 3: Brøkdelen av et tall ===== -->\n    <section id=\"tab-del-content\" class=\"hidden\">\n      <div class=\"bg-white rounded-2xl shadow p-6\">\n        <h2 class=\"text-lg font-semibold text-blue-800 mb-1\">Brøkdelen av et tall</h2>\n        <p class=\"text-slate-500 text-sm mb-4\">Finn for eksempel ¾ av 200. Resultatet forenkles og utregningen vises.</p>\n\n        <div class=\"flex items-end gap-3 flex-wrap\">\n          <div class=\"flex flex-col items-center gap-1\">\n            <span class=\"text-xs text-slate-500 uppercase tracking-wide\">Brøk</span>\n            <div class=\"flex flex-col items-center\">\n              <input type=\"number\" id=\"del-num\" class=\"input-frac\" value=\"3\" />\n              <div class=\"w-full border-t-2 border-slate-400 my-0.5\"></div>\n              <input type=\"number\" id=\"del-den\" class=\"input-frac\" value=\"4\" />\n            </div>\n          </div>\n          <div class=\"mb-2 text-lg font-semibold text-slate-600\">av</div>\n          <div class=\"flex flex-col items-center gap-1\">\n            <span class=\"text-xs text-slate-500 uppercase tracking-wide\">Tall</span>\n            <input type=\"number\" id=\"del-n\" class=\"input-frac w-24\" value=\"200\" />\n          </div>\n        </div>\n\n        <button onclick=\"doDel()\" class=\"mt-4 bg-blue-600 hover:bg-blue-700 text-white px-5 py-2 rounded-lg font-medium text-sm transition-colors\">Beregn</button>\n\n        <div id=\"del-result\" class=\"mt-4\"></div>\n      </div>\n\n      <!-- Visual bar -->\n      <div class=\"bg-white rounded-2xl shadow p-6 mt-4\">\n        <h3 class=\"text-sm font-semibold text-slate-600 mb-3 uppercase tracking-wide\">Brøkstav (visuell)</h3>\n        <canvas id=\"del-canvas\" width=\"400\" height=\"60\"></canvas>\n      </div>\n    </section>\n\n  </main>\n\n  <footer class=\"max-w-3xl mx-auto px-4 pb-8 text-center text-xs text-slate-400\">\n    Halison App Studio · Matematikk 1P · LK20 · Sinus 1P kap. 1.3–1.5\n  </footer>\n\n<script>\n  // ─── Utility math functions ────────────────────────────────────────────────\n\n  function gcd(a, b) {\n    a = Math.abs(a); b = Math.abs(b);\n    while (b) { let t = b; b = a % b; a = t; }\n    return a;\n  }\n\n  function lcm(a, b) {\n    return Math.abs(a * b) / gcd(a, b);\n  }\n\n  function simplify(num, den) {\n    if (den === 0) return { num: num, den: 0 };\n    const g = gcd(Math.abs(num), Math.abs(den));\n    let n = num / g, d = den / g;\n    if (d < 0) { n = -n; d = -d; }\n    return { num: n, den: d };\n  }\n\n  function fracHTML(num, den, cls = '') {\n    if (den === 1) return `<span class=\"font-semibold text-lg ${cls}\">${num}</span>`;\n    if (den === 0) return `<span class=\"font-semibold text-red-600\">udefinert</span>`;\n    return `<span class=\"fraction text-base font-semibold ${cls}\"><span class=\"num\">${num}</span><span class=\"den\">${den}</span></span>`;\n  }\n\n  // ─── Tab switching ─────────────────────────────────────────────────────────\n\n  function showTab(name) {\n    ['forkorting', 'regnearter', 'del'].forEach(t => {\n      document.getElementById('tab-' + t + '-content').classList.toggle('hidden', t !== name);\n      const btn = document.getElementById('tab-' + t);\n      btn.className = (t === name ? 'tab-active' : 'tab-inactive') + ' px-4 py-2 rounded-lg font-medium text-sm transition-colors';\n    });\n  }\n\n  // ─── Tab 1: Forkorting og utviding ────────────────────────────────────────\n\n  document.querySelectorAll('input[name=\"fk-mode\"]').forEach(r => {\n    r.addEventListener('change', () => {\n      document.getElementById('fk-expand-row').classList.toggle('hidden', r.value !== 'utvide' || !r.checked);\n    });\n  });\n\n  function doForkorting() {\n    const num = parseInt(document.getElementById('fk-num').value) || 0;\n    const den = parseInt(document.getElementById('fk-den').value) || 0;\n    const mode = document.querySelector('input[name=\"fk-mode\"]:checked').value;\n    const res = document.getElementById('fk-result');\n\n    if (den === 0) { res.innerHTML = '<div class=\"error-box\">Nevneren kan ikke være 0.</div>'; return; }\n    if (num === 0) { res.innerHTML = '<div class=\"step-box\">0 delt på hva som helst er 0.</div>'; return; }\n\n    let html = '';\n\n    if (mode === 'forkorte') {\n      const g = gcd(Math.abs(num), Math.abs(den));\n      const s = simplify(num, den);\n      if (g === 1) {\n        html += `<div class=\"step-box\">\n          <p class=\"font-semibold mb-1\">Brøken er allerede på laveste termer.</p>\n          <p>GCF(${Math.abs(num)}, ${Math.abs(den)}) = 1 — ingen felles faktor &gt; 1.</p>\n          <p class=\"mt-1\">Svar: ${fracHTML(s.num, s.den)}</p>\n        </div>`;\n      } else {\n        html += `<div class=\"step-box\">\n          <p class=\"font-semibold mb-1\">Steg 1 — Finn største felles faktor (GCF/SFF)</p>\n          <p>GCF(${Math.abs(num)}, ${Math.abs(den)}) = <strong>${g}</strong></p>\n        </div>\n        <div class=\"step-box\">\n          <p class=\"font-semibold mb-1\">Steg 2 — Del teller og nevner på GCF</p>\n          <p>${fracHTML(num, den)} = ${fracHTML(`${num}÷${g}`, `${den}÷${g}`)} = ${fracHTML(s.num, s.den)}</p>\n        </div>\n        <div class=\"answer-box\">\n          <p class=\"font-semibold text-green-800\">Svar (laveste termer): ${fracHTML(s.num, s.den, 'text-green-800')}</p>\n        </div>`;\n      }\n      drawPie('fk-canvas-before', num, den, '#3b82f6');\n      drawPie('fk-canvas-after', s.num, s.den, '#22c55e');\n      document.getElementById('fk-visual-arrow').classList.remove('hidden');\n      document.getElementById('fk-canvas-after-wrap').classList.remove('hidden');\n    } else {\n      const factor = parseInt(document.getElementById('fk-factor').value) || 2;\n      if (factor < 2) { res.innerHTML = '<div class=\"error-box\">Faktoren må være minst 2.</div>'; return; }\n      const newNum = num * factor;\n      const newDen = den * factor;\n      html += `<div class=\"step-box\">\n        <p class=\"font-semibold mb-1\">Utviding med faktoren <strong>${factor}</strong></p>\n        <p>Multipliser teller og nevner med ${factor}:</p>\n        <p class=\"mt-1\">${fracHTML(num, den)} = ${fracHTML(`${num}·${factor}`, `${den}·${factor}`)} = ${fracHTML(newNum, newDen)}</p>\n      </div>\n      <div class=\"answer-box\">\n        <p class=\"font-semibold text-green-800\">Svar: ${fracHTML(newNum, newDen, 'text-green-800')}</p>\n        <p class=\"text-sm text-slate-500 mt-1\">Merk: ${fracHTML(num, den)} og ${fracHTML(newNum, newDen)} er likeverdige brøker.</p>\n      </div>`;\n      drawPie('fk-canvas-before', num, den, '#3b82f6');\n      drawPie('fk-canvas-after', newNum, newDen, '#f59e0b');\n      document.getElementById('fk-visual-arrow').classList.remove('hidden');\n      document.getElementById('fk-canvas-after-wrap').classList.remove('hidden');\n    }\n\n    res.innerHTML = html;\n  }\n\n  // ─── Tab 2: De fire regneartene ───────────────────────────────────────────\n\n  function doRegnearter() {\n    const aN = parseInt(document.getElementById('rg-a-num').value);\n    const aD = parseInt(document.getElementById('rg-a-den').value);\n    const bN = parseInt(document.getElementById('rg-b-num').value);\n    const bD = parseInt(document.getElementById('rg-b-den').value);\n    const op = document.getElementById('rg-op').value;\n    const res = document.getElementById('rg-result');\n\n    if (isNaN(aN) || isNaN(aD) || isNaN(bN) || isNaN(bD)) {\n      res.innerHTML = '<div class=\"error-box\">Fyll inn gyldige tall i alle feltene.</div>'; return;\n    }\n    if (aD === 0 || bD === 0) {\n      res.innerHTML = '<div class=\"error-box\">Nevneren kan ikke være 0.</div>'; return;\n    }\n    if (op === 'div' && bN === 0) {\n      res.innerHTML = '<div class=\"error-box\">Kan ikke dele på 0 (telleren i brøk 2 er 0).</div>'; return;\n    }\n\n    const opSymbol = { add: '+', sub: '−', mul: '×', div: '÷' }[op];\n    let html = `<div class=\"step-box\"><p class=\"font-semibold mb-1\">Oppgave</p>\n      <p>${fracHTML(aN, aD)} ${opSymbol} ${fracHTML(bN, bD)}</p></div>`;\n\n    let resNum, resDen;\n\n    if (op === 'add' || op === 'sub') {\n      const l = lcm(aD, bD);\n      const factA = l / aD;\n      const factB = l / bD;\n      const newAN = aN * factA;\n      const newBN = bN * factB;\n      resNum = op === 'add' ? newAN + newBN : newAN - newBN;\n      resDen = l;\n      const s = simplify(resNum, resDen);\n\n      html += `<div class=\"step-box\">\n        <p class=\"font-semibold mb-1\">Steg 1 — Finn felles nevner (LCM)</p>\n        <p>LCM(${aD}, ${bD}) = <strong>${l}</strong></p>\n      </div>\n      <div class=\"step-box\">\n        <p class=\"font-semibold mb-1\">Steg 2 — Utvid brøkene</p>\n        <p>${fracHTML(aN, aD)} = ${fracHTML(newAN, l)} &nbsp;&nbsp; ${fracHTML(bN, bD)} = ${fracHTML(newBN, l)}</p>\n      </div>\n      <div class=\"step-box\">\n        <p class=\"font-semibold mb-1\">Steg 3 — ${op === 'add' ? 'Adder' : 'Subtraher'} tellerne</p>\n        <p>${fracHTML(newAN, l)} ${opSymbol} ${fracHTML(newBN, l)} = ${fracHTML(`${newAN}${op==='add'?'+':'−'}${newBN}`, l)} = ${fracHTML(resNum, resDen)}</p>\n      </div>`;\n      if (s.num !== resNum || s.den !== resDen) {\n        const g = gcd(Math.abs(resNum), resDen);\n        html += `<div class=\"step-box\">\n          <p class=\"font-semibold mb-1\">Steg 4 — Forkorting</p>\n          <p>GCF(${Math.abs(resNum)}, ${resDen}) = ${g}</p>\n          <p>${fracHTML(resNum, resDen)} = ${fracHTML(s.num, s.den)}</p>\n        </div>`;\n      }\n      html += `<div class=\"answer-box\"><p class=\"font-semibold text-green-800\">Svar: ${fracHTML(s.num, s.den, 'text-green-800')}</p></div>`;\n\n    } else if (op === 'mul') {\n      resNum = aN * bN;\n      resDen = aD * bD;\n      const s = simplify(resNum, resDen);\n      html += `<div class=\"step-box\">\n        <p class=\"font-semibold mb-1\">Regel: multipliser teller med teller, nevner med nevner</p>\n        <p>${fracHTML(aN, aD)} × ${fracHTML(bN, bD)} = ${fracHTML(`${aN}·${bN}`, `${aD}·${bD}`)} = ${fracHTML(resNum, resDen)}</p>\n      </div>`;\n      if (s.num !== resNum || s.den !== resDen) {\n        const g = gcd(Math.abs(resNum), Math.abs(resDen));\n        html += `<div class=\"step-box\">\n          <p class=\"font-semibold mb-1\">Forkorting</p>\n          <p>GCF(${Math.abs(resNum)}, ${Math.abs(resDen)}) = ${g}</p>\n          <p>${fracHTML(resNum, resDen)} = ${fracHTML(s.num, s.den)}</p>\n        </div>`;\n      }\n      html += `<div class=\"answer-box\"><p class=\"font-semibold text-green-800\">Svar: ${fracHTML(s.num, s.den, 'text-green-800')}</p></div>`;\n\n    } else if (op === 'div') {\n      // a/b ÷ c/d  =  a/b × d/c\n      const invN = bD, invD = bN;\n      resNum = aN * invN;\n      resDen = aD * invD;\n      const s = simplify(resNum, resDen);\n      html += `<div class=\"step-box\">\n        <p class=\"font-semibold mb-1\">Regel: gang med den omvendte (resiproke) brøken</p>\n        <p>${fracHTML(aN, aD)} ÷ ${fracHTML(bN, bD)} = ${fracHTML(aN, aD)} × ${fracHTML(invN, invD)}</p>\n      </div>\n      <div class=\"step-box\">\n        <p class=\"font-semibold mb-1\">Multipliser</p>\n        <p>${fracHTML(aN, aD)} × ${fracHTML(invN, invD)} = ${fracHTML(`${aN}·${invN}`, `${aD}·${invD}`)} = ${fracHTML(resNum, resDen)}</p>\n      </div>`;\n      if (s.num !== resNum || s.den !== resDen) {\n        const g = gcd(Math.abs(resNum), Math.abs(resDen));\n        html += `<div class=\"step-box\">\n          <p class=\"font-semibold mb-1\">Forkorting</p>\n          <p>GCF(${Math.abs(resNum)}, ${Math.abs(resDen)}) = ${g}</p>\n          <p>${fracHTML(resNum, resDen)} = ${fracHTML(s.num, s.den)}</p>\n        </div>`;\n      }\n      html += `<div class=\"answer-box\"><p class=\"font-semibold text-green-800\">Svar: ${fracHTML(s.num, s.den, 'text-green-800')}</p></div>`;\n    }\n\n    res.innerHTML = html;\n  }\n\n  // ─── Tab 3: Brøkdelen av et tall ──────────────────────────────────────────\n\n  function doDel() {\n    const num = parseInt(document.getElementById('del-num').value);\n    const den = parseInt(document.getElementById('del-den').value);\n    const n   = parseInt(document.getElementById('del-n').value);\n    const res = document.getElementById('del-result');\n\n    if (isNaN(num) || isNaN(den) || isNaN(n)) {\n      res.innerHTML = '<div class=\"error-box\">Fyll inn gyldige tall.</div>'; return;\n    }\n    if (den === 0) { res.innerHTML = '<div class=\"error-box\">Nevneren kan ikke være 0.</div>'; return; }\n\n    // result = num * n / den  — keep as exact fraction then simplify\n    const resNum = num * n;\n    const resDen = den;\n    const s = simplify(resNum, resDen);\n\n    let html = `<div class=\"step-box\">\n      <p class=\"font-semibold mb-1\">Regel: ${fracHTML(num, den)} av ${n} = ${fracHTML(num, den)} × ${n}</p>\n      <p>= ${fracHTML(`${num}·${n}`, den)} = ${fracHTML(resNum, resDen)}</p>\n    </div>`;\n\n    if (s.num !== resNum || s.den !== resDen) {\n      const g = gcd(Math.abs(resNum), Math.abs(resDen));\n      html += `<div class=\"step-box\">\n        <p class=\"font-semibold mb-1\">Forkorting</p>\n        <p>GCF(${Math.abs(resNum)}, ${Math.abs(resDen)}) = ${g}</p>\n        <p>${fracHTML(resNum, resDen)} = ${fracHTML(s.num, s.den)}</p>\n      </div>`;\n    }\n\n    const decimal = s.num / s.den;\n    const isExact = Number.isInteger(decimal);\n    html += `<div class=\"answer-box\">\n      <p class=\"font-semibold text-green-800\">Svar: ${fracHTML(s.num, s.den, 'text-green-800')}${isExact ? ` = ${decimal}` : ` ≈ ${decimal.toFixed(4)}`}</p>\n      <p class=\"text-sm text-slate-500 mt-1\">${fracHTML(num, den)} av ${n} = ${isExact ? decimal : fracHTML(s.num, s.den)}</p>\n    </div>`;\n\n    res.innerHTML = html;\n    drawBar('del-canvas', num, den, '#3b82f6');\n  }\n\n  // ─── Canvas helpers ────────────────────────────────────────────────────────\n\n  function drawPie(canvasId, num, den, fillColor) {\n    const canvas = document.getElementById(canvasId);\n    if (!canvas) return;\n    const ctx = canvas.getContext('2d');\n    const cx = 60, cy = 60, r = 50;\n    ctx.clearRect(0, 0, 120, 120);\n\n    const absDen = Math.abs(den);\n    const absNum = Math.abs(num);\n\n    // clamp for display\n    const displayNum = Math.min(absNum, absDen);\n    const slices = Math.min(absDen, 24); // cap slices for readability\n    const filledSlices = Math.min(displayNum, slices);\n\n    const sliceAngle = (2 * Math.PI) / slices;\n\n    for (let i = 0; i < slices; i++) {\n      const start = -Math.PI / 2 + i * sliceAngle;\n      const end   = start + sliceAngle;\n      ctx.beginPath();\n      ctx.moveTo(cx, cy);\n      ctx.arc(cx, cy, r, start, end);\n      ctx.closePath();\n      ctx.fillStyle = i < filledSlices ? fillColor : '#e2e8f0';\n      ctx.fill();\n      ctx.strokeStyle = '#fff';\n      ctx.lineWidth = 2;\n      ctx.stroke();\n    }\n\n    // Label\n    ctx.fillStyle = '#1e293b';\n    ctx.font = 'bold 13px sans-serif';\n    ctx.textAlign = 'center';\n    ctx.fillText(`${num}/${den}`, cx, cy + r + 16);\n  }\n\n  function drawBar(canvasId, num, den, fillColor) {\n    const canvas = document.getElementById(canvasId);\n    if (!canvas) return;\n    const ctx = canvas.getContext('2d');\n    ctx.clearRect(0, 0, 400, 60);\n\n    const absDen = Math.min(Math.abs(den), 40);\n    const absNum = Math.min(Math.abs(num), absDen);\n    const w = 360 / absDen;\n\n    for (let i = 0; i < absDen; i++) {\n      ctx.fillStyle = i < absNum ? fillColor : '#e2e8f0';\n      ctx.fillRect(20 + i * w, 10, w - 2, 36);\n      ctx.strokeStyle = '#fff';\n      ctx.strokeRect(20 + i * w, 10, w - 2, 36);\n    }\n\n    ctx.fillStyle = '#475569';\n    ctx.font = '12px sans-serif';\n    ctx.textAlign = 'left';\n    ctx.fillText(`${absNum} av ${absDen} deler er farget`, 20, 58);\n  }\n\n  // ─── Initial render ────────────────────────────────────────────────────────\n\n  drawPie('fk-canvas-before', 12, 18, '#3b82f6');\n</script>\n</body>\n</html>\n",
