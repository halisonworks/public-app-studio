{
  "schema": "app-studio/canvas@1",
  "id": "example-no1p-forhold-og-proporsjonalitet",
  "name": "forhold-og-proporsjonalitet.html",
  "code": "<!DOCTYPE html>\n<!--\n  Forhold og proporsjonalitet — Halison App Studio-eksempel\n\n  Interaktivt læremiddel for matematikk 1P (LK20): forhold, proporsjonale og\n  omvendt proporsjonale størrelser, og skalering (f.eks. en oppskrift).\n\n  Fra Halison App Studio sitt offentlige bibliotek:\n  https://github.com/halisonworks/public-app-studio\n\n  Tillatt bruk: personlig, pedagogisk og annen ikke-kommersiell bruk. Behold denne\n  headeren og kildelenken; ikke-kommersiell bruk. Utgitt under Halison App Studio\n  Examples License — se LICENSE-filen i repoet over.\n-->\n<html lang=\"no\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Forhold og proporsjonalitet – Matematikk 1P</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Segoe UI', system-ui, sans-serif; }\n    .tab-active { border-bottom: 3px solid #2563eb; color: #2563eb; font-weight: 700; }\n    .tab-inactive { border-bottom: 3px solid transparent; color: #6b7280; }\n    .tab-inactive:hover { color: #374151; border-bottom-color: #d1d5db; }\n    input[type=\"number\"], input[type=\"text\"] { outline: none; }\n    input[type=\"number\"]:focus, input[type=\"text\"]:focus { ring: 2px; }\n    .result-box { background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%); }\n    .formula-box { background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%); }\n    .warning-box { background: linear-gradient(135deg, #fefce8 0%, #fef9c3 100%); }\n    .ingredient-row:last-child .remove-btn { display: inline-flex; }\n    @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }\n    .fade-in { animation: fadeIn 0.25s ease; }\n    .pill { display: inline-block; padding: 2px 10px; border-radius: 9999px; font-size: 0.78rem; font-weight: 600; }\n  </style>\n</head>\n<body class=\"bg-gray-50 min-h-screen\">\n\n<!-- Header -->\n<header class=\"bg-blue-700 text-white shadow-md\">\n  <div class=\"max-w-3xl mx-auto px-4 py-5\">\n    <div class=\"flex items-center gap-3\">\n      <div class=\"bg-blue-500 rounded-xl p-2 text-2xl select-none\">📐</div>\n      <div>\n        <h1 class=\"text-xl font-bold leading-tight\">Forhold og proporsjonalitet</h1>\n        <p class=\"text-blue-200 text-sm\">Matematikk 1P · LK20</p>\n      </div>\n    </div>\n  </div>\n</header>\n\n<!-- Tab bar -->\n<nav class=\"bg-white border-b border-gray-200 sticky top-0 z-10 shadow-sm\">\n  <div class=\"max-w-3xl mx-auto px-4 flex gap-0\">\n    <button id=\"tab-teori\" onclick=\"showTab('teori')\"\n      class=\"px-5 py-3 text-sm transition-colors tab-active\" aria-selected=\"true\">\n      📖 Teori\n    </button>\n    <button id=\"tab-oppskrift\" onclick=\"showTab('oppskrift')\"\n      class=\"px-5 py-3 text-sm transition-colors tab-inactive\" aria-selected=\"false\">\n      🍲 Oppskrift\n    </button>\n    <button id=\"tab-proporsjonalitet\" onclick=\"showTab('proporsjonalitet')\"\n      class=\"px-5 py-3 text-sm transition-colors tab-inactive\" aria-selected=\"false\">\n      📊 Proporsjonalitet\n    </button>\n  </div>\n</nav>\n\n<main class=\"max-w-3xl mx-auto px-4 py-6 space-y-6\">\n\n  <!-- ======================== TAB: TEORI ======================== -->\n  <section id=\"tab-teori-content\" class=\"space-y-5\">\n\n    <!-- Begrep: Forhold -->\n    <div class=\"bg-white rounded-2xl shadow-sm border border-gray-100 p-6\">\n      <h2 class=\"text-lg font-bold text-blue-800 mb-3 flex items-center gap-2\">\n        <span class=\"text-2xl\">⚖️</span> Hva er et forhold?\n      </h2>\n      <p class=\"text-gray-700 mb-4\">\n        Et <strong>forhold</strong> viser hvor mange ganger en størrelse er av en annen. Forholdet mellom to tall <em>a</em> og <em>b</em> skrives <strong>a : b</strong> og er det samme som brøken <em>a/b</em>.\n      </p>\n      <div class=\"formula-box rounded-xl p-4 mb-4\">\n        <p class=\"font-mono text-green-800 text-center text-lg font-bold\">a : b = a / b</p>\n      </div>\n      <h3 class=\"font-semibold text-gray-800 mb-2\">Eksempler:</h3>\n      <ul class=\"space-y-2 text-gray-700 text-sm\">\n        <li class=\"flex items-start gap-2\">\n          <span class=\"text-blue-500 mt-0.5\">▸</span>\n          <span>I en klasse er det 14 jenter og 12 gutter. Forholdet jenter : gutter = <strong>14 : 12 = 7 : 6</strong> (forenklet ved å dele med 2).</span>\n        </li>\n        <li class=\"flex items-start gap-2\">\n          <span class=\"text-blue-500 mt-0.5\">▸</span>\n          <span>En bilblanding har bensin og olje i forholdet <strong>50 : 1</strong>. Det betyr 50 deler bensin per 1 del olje.</span>\n        </li>\n        <li class=\"flex items-start gap-2\">\n          <span class=\"text-blue-500 mt-0.5\">▸</span>\n          <span>Forholdet 3 : 4 er det samme som brøken 3/4 = 0,75.</span>\n        </li>\n      </ul>\n\n      <!-- Interaktiv forholdskalkulator -->\n      <div class=\"mt-5 bg-gray-50 rounded-xl p-4 border border-gray-200\">\n        <p class=\"font-semibold text-gray-800 mb-3\">Prøv selv: Forenkle et forhold</p>\n        <div class=\"flex flex-wrap items-center gap-3\">\n          <input id=\"ratio-a\" type=\"number\" min=\"1\" value=\"14\"\n            class=\"w-20 border border-gray-300 rounded-lg px-3 py-2 text-center text-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-100\"\n            oninput=\"calcRatio()\" />\n          <span class=\"text-gray-500 font-bold text-lg\">:</span>\n          <input id=\"ratio-b\" type=\"number\" min=\"1\" value=\"12\"\n            class=\"w-20 border border-gray-300 rounded-lg px-3 py-2 text-center text-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-100\"\n            oninput=\"calcRatio()\" />\n          <span class=\"text-gray-500\">=</span>\n          <span id=\"ratio-result\" class=\"font-bold text-blue-700 text-sm\"></span>\n        </div>\n        <p id=\"ratio-decimal\" class=\"text-xs text-gray-500 mt-2\"></p>\n      </div>\n    </div>\n\n    <!-- Begrep: Proporsjonal -->\n    <div class=\"bg-white rounded-2xl shadow-sm border border-gray-100 p-6\">\n      <h2 class=\"text-lg font-bold text-blue-800 mb-3 flex items-center gap-2\">\n        <span class=\"text-2xl\">📈</span> Proporsjonale størrelser\n      </h2>\n      <p class=\"text-gray-700 mb-4\">\n        To størrelser <em>x</em> og <em>y</em> er <strong>proporsjonale</strong> (rett proporsjonale) når forholdet <em>y/x</em> alltid er det samme. Konstanten <em>k</em> kalles <strong>forholdstallet</strong>.\n      </p>\n      <div class=\"formula-box rounded-xl p-4 mb-4\">\n        <p class=\"font-mono text-green-800 text-center text-lg font-bold\">y = k · x &nbsp;&nbsp;&nbsp; (k = y/x)</p>\n      </div>\n      <p class=\"text-gray-700 mb-3 text-sm\">Grafen er en rett linje gjennom origo.</p>\n      <h3 class=\"font-semibold text-gray-800 mb-2\">Eksempler:</h3>\n      <ul class=\"space-y-2 text-gray-700 text-sm\">\n        <li class=\"flex items-start gap-2\">\n          <span class=\"text-green-500 mt-0.5\">▸</span>\n          <span>Pris for appelsiner: 1 kg koster 25 kr. 2 kg koster 50 kr. 3 kg koster 75 kr. Forholdstallet k = 25 kr/kg.</span>\n        </li>\n        <li class=\"flex items-start gap-2\">\n          <span class=\"text-green-500 mt-0.5\">▸</span>\n          <span>Fart og strekning ved konstant hastighet: s = 80 · t, der t er tid i timer og k = 80 km/t.</span>\n        </li>\n      </ul>\n    </div>\n\n    <!-- Begrep: Omvendt proporsjonal -->\n    <div class=\"bg-white rounded-2xl shadow-sm border border-gray-100 p-6\">\n      <h2 class=\"text-lg font-bold text-blue-800 mb-3 flex items-center gap-2\">\n        <span class=\"text-2xl\">📉</span> Omvendt proporsjonale størrelser\n      </h2>\n      <p class=\"text-gray-700 mb-4\">\n        To størrelser <em>x</em> og <em>y</em> er <strong>omvendt proporsjonale</strong> når <em>produktet</em> x · y alltid er det samme konstante tallet <em>k</em>. Når den ene øker, minker den andre.\n      </p>\n      <div class=\"formula-box rounded-xl p-4 mb-4\">\n        <p class=\"font-mono text-green-800 text-center text-lg font-bold\">x · y = k &nbsp;&nbsp;&nbsp; (y = k/x)</p>\n      </div>\n      <h3 class=\"font-semibold text-gray-800 mb-2\">Eksempler:</h3>\n      <ul class=\"space-y-2 text-gray-700 text-sm\">\n        <li class=\"flex items-start gap-2\">\n          <span class=\"orange-500 mt-0.5 text-orange-500\">▸</span>\n          <span>Arbeidstempo: 4 arbeidere bruker 6 timer. 8 arbeidere bruker 3 timer. k = 4 × 6 = 24 personTimer.</span>\n        </li>\n        <li class=\"flex items-start gap-2\">\n          <span class=\"text-orange-500 mt-0.5\">▸</span>\n          <span>Fart og tid for samme strekning: v · t = 120 km. 60 km/t → 2 timer; 120 km/t → 1 time.</span>\n        </li>\n      </ul>\n    </div>\n\n  </section>\n\n  <!-- ======================== TAB: OPPSKRIFT ======================== -->\n  <section id=\"tab-oppskrift-content\" class=\"space-y-5 hidden\">\n\n    <div class=\"bg-white rounded-2xl shadow-sm border border-gray-100 p-6\">\n      <h2 class=\"text-lg font-bold text-blue-800 mb-1 flex items-center gap-2\">\n        <span class=\"text-2xl\">🍲</span> Oppskrift-skalering\n      </h2>\n      <p class=\"text-gray-500 text-sm mb-5\">\n        Ingrediensene skaleres proporsjonalt. Endre antall porsjoner og se nye mengder med én gang.\n      </p>\n\n      <!-- Kontroller: porsjoner -->\n      <div class=\"flex flex-wrap gap-6 mb-5\">\n        <div>\n          <label class=\"block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1\">Opprinnelig for</label>\n          <div class=\"flex items-center gap-2\">\n            <input id=\"base-persons\" type=\"number\" min=\"1\" max=\"100\" value=\"4\"\n              class=\"w-20 border border-gray-300 rounded-lg px-3 py-2 text-center font-bold text-gray-800 focus:border-blue-500 focus:ring-2 focus:ring-blue-100\"\n              oninput=\"scaleRecipe()\" />\n            <span class=\"text-gray-600 text-sm\">porsjoner</span>\n          </div>\n        </div>\n        <div>\n          <label class=\"block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1\">Skal lages for</label>\n          <div class=\"flex items-center gap-2\">\n            <input id=\"target-persons\" type=\"number\" min=\"1\" max=\"1000\" value=\"10\"\n              class=\"w-20 border border-gray-300 rounded-lg px-3 py-2 text-center font-bold text-blue-700 focus:border-blue-500 focus:ring-2 focus:ring-blue-100\"\n              oninput=\"scaleRecipe()\" />\n            <span class=\"text-gray-600 text-sm\">porsjoner</span>\n          </div>\n        </div>\n      </div>\n\n      <!-- Forholdstall info -->\n      <div id=\"scale-ratio-box\" class=\"result-box rounded-xl p-3 mb-5 text-sm flex items-center gap-3\">\n        <span class=\"text-blue-600 font-bold text-base\">Skaleringsfaktor:</span>\n        <span id=\"scale-ratio-val\" class=\"font-mono font-bold text-blue-800 text-base\"></span>\n        <span id=\"scale-ratio-formula\" class=\"text-blue-500 text-xs\"></span>\n      </div>\n\n      <!-- Oppskrift-tittel -->\n      <div class=\"mb-3\">\n        <label class=\"block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1\">Oppskrift</label>\n        <input id=\"recipe-title\" type=\"text\" maxlength=\"60\" value=\"Kjøttboller i tomatsaus\"\n          class=\"w-full border border-gray-200 rounded-lg px-3 py-2 text-base font-semibold text-gray-800 focus:border-blue-400 focus:ring-2 focus:ring-blue-100\"\n          oninput=\"saveRecipe()\" />\n      </div>\n\n      <!-- Ingredienstabell -->\n      <div class=\"overflow-x-auto rounded-xl border border-gray-200\">\n        <table class=\"w-full text-sm\">\n          <thead class=\"bg-gray-100 text-gray-500 text-xs uppercase tracking-wide\">\n            <tr>\n              <th class=\"text-left px-4 py-2\">Ingrediens</th>\n              <th class=\"text-right px-4 py-2\">Mengde</th>\n              <th class=\"text-left px-3 py-2\">Enhet</th>\n              <th class=\"text-right px-4 py-2 text-blue-600\">Ny mengde</th>\n              <th class=\"px-2 py-2\"></th>\n            </tr>\n          </thead>\n          <tbody id=\"ingredients-body\">\n            <!-- filled by JS -->\n          </tbody>\n        </table>\n      </div>\n\n      <!-- Legg til ingrediens -->\n      <button onclick=\"addIngredient()\"\n        class=\"mt-3 flex items-center gap-2 text-sm text-blue-600 hover:text-blue-800 font-semibold px-3 py-2 rounded-lg hover:bg-blue-50 transition-colors\">\n        <span class=\"text-lg\">＋</span> Legg til ingrediens\n      </button>\n\n      <!-- Forklaring -->\n      <div class=\"mt-4 bg-gray-50 rounded-xl p-4 border border-gray-100 text-sm text-gray-600\">\n        <p class=\"font-semibold text-gray-700 mb-1\">Hvordan fungerer det?</p>\n        <p>Ny mengde = opprinnelig mengde × (ønsket porsjoner ÷ opprinnelig porsjoner)</p>\n        <p class=\"font-mono text-green-700 mt-1\">y = k · x &nbsp; der k = M/N</p>\n      </div>\n    </div>\n\n  </section>\n\n  <!-- ======================== TAB: PROPORSJONALITET ======================== -->\n  <section id=\"tab-proporsjonalitet-content\" class=\"space-y-5 hidden\">\n\n    <div class=\"bg-white rounded-2xl shadow-sm border border-gray-100 p-6\">\n      <h2 class=\"text-lg font-bold text-blue-800 mb-1 flex items-center gap-2\">\n        <span class=\"text-2xl\">📊</span> Finn forholdstallet og beregn ny verdi\n      </h2>\n      <p class=\"text-gray-500 text-sm mb-5\">\n        Oppgi ett kjent par (x₁, y₁), velg type proporsjonalitet, og finn y for en ny x-verdi.\n      </p>\n\n      <!-- Toggle: type -->\n      <div class=\"flex rounded-xl overflow-hidden border border-blue-200 mb-6 w-full max-w-sm\">\n        <button id=\"btn-prop\" onclick=\"setPropType('prop')\"\n          class=\"flex-1 py-2.5 text-sm font-semibold transition-colors bg-blue-600 text-white\">\n          📈 Proporsjonal\n        </button>\n        <button id=\"btn-inv\" onclick=\"setPropType('inv')\"\n          class=\"flex-1 py-2.5 text-sm font-semibold transition-colors bg-white text-gray-500 hover:bg-gray-50\">\n          📉 Omvendt prop.\n        </button>\n      </div>\n\n      <!-- Kontekst-eksempel forslag -->\n      <div class=\"mb-5\">\n        <label class=\"block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2\">Velg eksempel</label>\n        <div class=\"flex flex-wrap gap-2\" id=\"example-buttons\">\n          <!-- filled by JS -->\n        </div>\n      </div>\n\n      <!-- Kontekst-labels -->\n      <div class=\"grid grid-cols-2 gap-4 mb-4\">\n        <div>\n          <label class=\"block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1\">x betyr</label>\n          <input id=\"label-x\" type=\"text\" maxlength=\"30\" placeholder=\"f.eks. antall kg\"\n            class=\"w-full border border-gray-200 rounded-lg px-3 py-2 text-sm text-gray-800 focus:border-blue-400 focus:ring-2 focus:ring-blue-100\"\n            oninput=\"calcProp()\" />\n        </div>\n        <div>\n          <label class=\"block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1\">y betyr</label>\n          <input id=\"label-y\" type=\"text\" maxlength=\"30\" placeholder=\"f.eks. pris (kr)\"\n            class=\"w-full border border-gray-200 rounded-lg px-3 py-2 text-sm text-gray-800 focus:border-blue-400 focus:ring-2 focus:ring-blue-100\"\n            oninput=\"calcProp()\" />\n        </div>\n      </div>\n\n      <!-- Kjent par -->\n      <div class=\"bg-gray-50 rounded-xl p-4 border border-gray-200 mb-4\">\n        <p class=\"font-semibold text-gray-700 text-sm mb-3\">Kjent par (x₁, y₁)</p>\n        <div class=\"flex flex-wrap gap-4 items-end\">\n          <div>\n            <label class=\"block text-xs text-gray-500 mb-1\">x₁</label>\n            <input id=\"x1\" type=\"number\" min=\"0.0001\" step=\"any\" value=\"3\"\n              class=\"w-24 border border-gray-300 rounded-lg px-3 py-2 text-center font-bold focus:border-blue-500 focus:ring-2 focus:ring-blue-100\"\n              oninput=\"calcProp()\" />\n          </div>\n          <div>\n            <label class=\"block text-xs text-gray-500 mb-1\">y₁</label>\n            <input id=\"y1\" type=\"number\" min=\"0.0001\" step=\"any\" value=\"75\"\n              class=\"w-24 border border-gray-300 rounded-lg px-3 py-2 text-center font-bold focus:border-blue-500 focus:ring-2 focus:ring-blue-100\"\n              oninput=\"calcProp()\" />\n          </div>\n        </div>\n      </div>\n\n      <!-- Beregn k -->\n      <div id=\"k-result-box\" class=\"formula-box rounded-xl p-4 mb-4 fade-in hidden\">\n        <p class=\"text-xs font-semibold text-green-700 uppercase tracking-wide mb-1\">Forholdstall k</p>\n        <p id=\"k-formula\" class=\"font-mono text-green-800 font-bold text-base\"></p>\n        <p id=\"k-value\" class=\"font-mono text-green-700 text-sm mt-1\"></p>\n      </div>\n\n      <!-- Ny x -->\n      <div class=\"bg-gray-50 rounded-xl p-4 border border-gray-200 mb-4\">\n        <p class=\"font-semibold text-gray-700 text-sm mb-3\">Finn y for ny x-verdi</p>\n        <div class=\"flex flex-wrap gap-4 items-end\">\n          <div>\n            <label class=\"block text-xs text-gray-500 mb-1\">x (ny)</label>\n            <input id=\"x-new\" type=\"number\" min=\"0.0001\" step=\"any\" value=\"7\"\n              class=\"w-24 border border-gray-300 rounded-lg px-3 py-2 text-center font-bold text-blue-700 focus:border-blue-500 focus:ring-2 focus:ring-blue-100\"\n              oninput=\"calcProp()\" />\n          </div>\n        </div>\n      </div>\n\n      <!-- Svar -->\n      <div id=\"prop-result-box\" class=\"result-box rounded-xl p-5 fade-in hidden\">\n        <p class=\"text-xs font-semibold text-blue-600 uppercase tracking-wide mb-2\">Resultat</p>\n        <p id=\"prop-formula-line\" class=\"font-mono text-blue-900 font-bold text-base mb-1\"></p>\n        <p id=\"prop-answer-line\" class=\"text-blue-800 text-sm\"></p>\n      </div>\n\n      <!-- Steg-for-steg -->\n      <div id=\"prop-steps\" class=\"mt-4 bg-yellow-50 rounded-xl p-4 border border-yellow-200 text-sm text-gray-700 hidden\">\n        <p class=\"font-semibold text-yellow-800 mb-2\">Fremgangsmåte:</p>\n        <ol id=\"steps-list\" class=\"list-decimal list-inside space-y-1 text-gray-700\"></ol>\n      </div>\n\n    </div>\n\n    <!-- Eksempel-tabell -->\n    <div class=\"bg-white rounded-2xl shadow-sm border border-gray-100 p-6\">\n      <h3 class=\"font-bold text-gray-700 mb-3 flex items-center gap-2 text-base\">\n        <span>🗒️</span> Verdatabell\n      </h3>\n      <p class=\"text-xs text-gray-500 mb-3\">Beregner y for x = 1, 2, 3, ... 8 basert på dine innstillinger.</p>\n      <div class=\"overflow-x-auto rounded-xl border border-gray-200\">\n        <table class=\"w-full text-sm text-center\">\n          <thead class=\"bg-gray-100 text-gray-500 text-xs uppercase tracking-wide\">\n            <tr>\n              <th class=\"px-3 py-2\" id=\"th-x\">x</th>\n              <th class=\"px-3 py-2\" id=\"th-y\">y</th>\n              <th class=\"px-3 py-2\" id=\"th-product\">x · y</th>\n            </tr>\n          </thead>\n          <tbody id=\"prop-table-body\" class=\"divide-y divide-gray-100\">\n          </tbody>\n        </table>\n      </div>\n      <p id=\"table-note\" class=\"text-xs text-gray-400 mt-2\"></p>\n    </div>\n\n  </section>\n\n</main>\n\n<footer class=\"max-w-3xl mx-auto px-4 py-6 text-center text-xs text-gray-400 border-t border-gray-100 mt-4\">\n  Matematikk 1P · LK20 · Halison App Studio ·\n  <a href=\"https://github.com/halisonworks/public-app-studio\" class=\"underline hover:text-gray-600\">github.com/halisonworks/public-app-studio</a>\n</footer>\n\n<script>\n// =====================================================================\n// UTILITIES\n// =====================================================================\nfunction gcd(a, b) {\n  a = Math.abs(Math.round(a)); b = Math.abs(Math.round(b));\n  while (b) { let t = b; b = a % b; a = t; }\n  return a;\n}\n\nfunction fmtNum(n, decimals) {\n  if (n === null || n === undefined || isNaN(n)) return '?';\n  if (Math.abs(n - Math.round(n)) < 0.0001) return String(Math.round(n));\n  return n.toFixed(decimals !== undefined ? decimals : 4).replace(/\\.?0+$/, '');\n}\n\n// =====================================================================\n// TAB NAVIGATION\n// =====================================================================\nfunction showTab(name) {\n  ['teori','oppskrift','proporsjonalitet'].forEach(t => {\n    document.getElementById('tab-' + t + '-content').classList.add('hidden');\n    const btn = document.getElementById('tab-' + t);\n    btn.classList.remove('tab-active');\n    btn.classList.add('tab-inactive');\n    btn.setAttribute('aria-selected', 'false');\n  });\n  document.getElementById('tab-' + name + '-content').classList.remove('hidden');\n  const active = document.getElementById('tab-' + name);\n  active.classList.add('tab-active');\n  active.classList.remove('tab-inactive');\n  active.setAttribute('aria-selected', 'true');\n  localStorage.setItem('mp1_tab', name);\n  if (name === 'oppskrift') scaleRecipe();\n  if (name === 'proporsjonalitet') { buildExampleButtons(); calcProp(); }\n}\n\n// =====================================================================\n// TEORI: Forholdskalkulator\n// =====================================================================\nfunction calcRatio() {\n  const a = parseFloat(document.getElementById('ratio-a').value);\n  const b = parseFloat(document.getElementById('ratio-b').value);\n  const res = document.getElementById('ratio-result');\n  const dec = document.getElementById('ratio-decimal');\n  if (!a || !b || a <= 0 || b <= 0) {\n    res.textContent = '—'; dec.textContent = ''; return;\n  }\n  const g = gcd(a, b);\n  const sa = Math.round(a/g), sb = Math.round(b/g);\n  if (sa === a && sb === b) {\n    res.textContent = a + ' : ' + b + ' (kan ikke forenkles)';\n  } else {\n    res.textContent = a + ' : ' + b + ' = ' + sa + ' : ' + sb;\n  }\n  const frac = a / b;\n  dec.textContent = 'Som desimaltall: ' + fmtNum(frac, 4) + '  |  ' + a + '/' + b + ' ≈ ' + frac.toFixed(4);\n}\ncalcRatio();\n\n// =====================================================================\n// OPPSKRIFT-SKALERING\n// =====================================================================\nconst DEFAULT_INGREDIENTS = [\n  { name: 'Kjøttdeig', amount: 600, unit: 'g' },\n  { name: 'Løk', amount: 1, unit: 'stk' },\n  { name: 'Egg', amount: 1, unit: 'stk' },\n  { name: 'Breadcrumbs', amount: 3, unit: 'ss' },\n  { name: 'Hermetiske tomater', amount: 400, unit: 'g' },\n  { name: 'Kremfløte', amount: 1.5, unit: 'dl' },\n  { name: 'Hvitløksfedd', amount: 2, unit: 'stk' },\n];\n\nfunction loadRecipe() {\n  try {\n    const stored = localStorage.getItem('mp1_recipe');\n    if (stored) return JSON.parse(stored);\n  } catch(e) {}\n  return JSON.parse(JSON.stringify(DEFAULT_INGREDIENTS));\n}\n\nfunction saveRecipe() {\n  const rows = getIngredientRows();\n  localStorage.setItem('mp1_recipe', JSON.stringify(rows));\n  localStorage.setItem('mp1_recipe_title', document.getElementById('recipe-title').value);\n}\n\nfunction getIngredientRows() {\n  const rows = [];\n  document.querySelectorAll('#ingredients-body tr').forEach(tr => {\n    const nameInput = tr.querySelector('.ing-name');\n    const amountInput = tr.querySelector('.ing-amount');\n    const unitInput = tr.querySelector('.ing-unit');\n    if (nameInput) rows.push({\n      name: nameInput.value,\n      amount: parseFloat(amountInput.value) || 0,\n      unit: unitInput.value\n    });\n  });\n  return rows;\n}\n\nfunction renderIngredients(ingredients, scaleFactor) {\n  const tbody = document.getElementById('ingredients-body');\n  tbody.innerHTML = '';\n  ingredients.forEach((ing, i) => {\n    const newAmount = ing.amount * scaleFactor;\n    const tr = document.createElement('tr');\n    tr.className = 'border-t border-gray-100 ingredient-row';\n    tr.innerHTML = `\n      <td class=\"px-4 py-2\">\n        <input type=\"text\" class=\"ing-name w-full border-0 bg-transparent text-gray-800 text-sm focus:outline-none focus:border-b focus:border-blue-300\"\n          value=\"${escHtml(ing.name)}\" maxlength=\"50\"\n          oninput=\"saveRecipe(); scaleRecipe()\" />\n      </td>\n      <td class=\"px-4 py-2 text-right\">\n        <input type=\"number\" class=\"ing-amount w-20 border border-gray-200 rounded px-2 py-1 text-right text-sm font-medium focus:border-blue-400 focus:ring-1 focus:ring-blue-100\"\n          value=\"${ing.amount}\" min=\"0\" step=\"any\"\n          oninput=\"saveRecipe(); scaleRecipe()\" />\n      </td>\n      <td class=\"px-3 py-2\">\n        <input type=\"text\" class=\"ing-unit w-14 border-0 bg-transparent text-gray-500 text-sm focus:outline-none\"\n          value=\"${escHtml(ing.unit)}\" maxlength=\"10\"\n          oninput=\"saveRecipe(); scaleRecipe()\" />\n      </td>\n      <td class=\"px-4 py-2 text-right font-bold text-blue-700 text-sm whitespace-nowrap scaled-amount\">\n        ${fmtNum(newAmount, 2)} <span class=\"text-blue-400 font-normal\">${escHtml(ing.unit)}</span>\n      </td>\n      <td class=\"px-2 py-2 text-center\">\n        <button onclick=\"removeIngredient(${i})\"\n          class=\"remove-btn text-gray-300 hover:text-red-400 transition-colors text-lg leading-none\"\n          title=\"Fjern\">×</button>\n      </td>\n    `;\n    tbody.appendChild(tr);\n  });\n}\n\nfunction escHtml(s) {\n  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;');\n}\n\nfunction scaleRecipe() {\n  const base = parseFloat(document.getElementById('base-persons').value) || 1;\n  const target = parseFloat(document.getElementById('target-persons').value) || 1;\n  const factor = target / base;\n  const g = gcd(Math.round(target*1000), Math.round(base*1000));\n  const sn = Math.round(target*1000/g), sd = Math.round(base*1000/g);\n  const ratioStr = sn === sd ? '1' : sn + ' / ' + sd;\n\n  document.getElementById('scale-ratio-val').textContent = fmtNum(factor, 6);\n  document.getElementById('scale-ratio-formula').textContent = '(' + fmtNum(target,4) + ' ÷ ' + fmtNum(base,4) + ' = ' + ratioStr + ')';\n\n  const ingredients = getIngredientRows().length > 0 ? getIngredientRows() : loadRecipe();\n  renderIngredients(ingredients, factor);\n  saveRecipe();\n}\n\nfunction addIngredient() {\n  const rows = getIngredientRows();\n  rows.push({ name: 'Ny ingrediens', amount: 100, unit: 'g' });\n  const base = parseFloat(document.getElementById('base-persons').value) || 1;\n  const target = parseFloat(document.getElementById('target-persons').value) || 1;\n  renderIngredients(rows, target / base);\n  saveRecipe();\n  // focus on the new name input\n  const allInputs = document.querySelectorAll('#ingredients-body .ing-name');\n  if (allInputs.length > 0) allInputs[allInputs.length - 1].focus();\n}\n\nfunction removeIngredient(index) {\n  const rows = getIngredientRows();\n  if (rows.length <= 1) return;\n  rows.splice(index, 1);\n  const base = parseFloat(document.getElementById('base-persons').value) || 1;\n  const target = parseFloat(document.getElementById('target-persons').value) || 1;\n  renderIngredients(rows, target / base);\n  saveRecipe();\n}\n\nfunction initRecipe() {\n  const stored = loadRecipe();\n  const storedTitle = localStorage.getItem('mp1_recipe_title');\n  if (storedTitle) document.getElementById('recipe-title').value = storedTitle;\n  const base = parseFloat(document.getElementById('base-persons').value) || 1;\n  const target = parseFloat(document.getElementById('target-persons').value) || 1;\n  renderIngredients(stored, target / base);\n  scaleRecipe();\n}\n\n// =====================================================================\n// PROPORSJONALITET\n// =====================================================================\nlet propType = 'prop'; // 'prop' | 'inv'\n\nconst PROP_EXAMPLES = [\n  { label: 'Appelsiner (pris)', x1: 3, y1: 75, lx: 'kg', ly: 'pris (kr)', type: 'prop' },\n  { label: 'Bensinforbruk', x1: 50, y1: 4.25, lx: 'km', ly: 'liter bensin', type: 'prop' },\n  { label: 'Arbeidsinntekt', x1: 8, y1: 1600, lx: 'timer', ly: 'lønn (kr)', type: 'prop' },\n  { label: 'Malere og tid', x1: 2, y1: 12, lx: 'malere', ly: 'timer', type: 'inv' },\n  { label: 'Fart og tid (120 km)', x1: 60, y1: 2, lx: 'km/t', ly: 'timer', type: 'inv' },\n  { label: 'Ruter per side', x1: 4, y1: 25, lx: 'kolonner', ly: 'rader', type: 'inv' },\n];\n\nfunction buildExampleButtons() {\n  const container = document.getElementById('example-buttons');\n  container.innerHTML = '';\n  PROP_EXAMPLES.forEach((ex, i) => {\n    const btn = document.createElement('button');\n    btn.className = 'px-3 py-1.5 text-xs rounded-lg border border-gray-200 bg-gray-50 hover:bg-blue-50 hover:border-blue-300 text-gray-700 font-medium transition-colors';\n    btn.textContent = ex.label + (ex.type === 'inv' ? ' 🔄' : ' 📈');\n    btn.onclick = () => loadExample(i);\n    container.appendChild(btn);\n  });\n}\n\nfunction loadExample(i) {\n  const ex = PROP_EXAMPLES[i];\n  setPropType(ex.type);\n  document.getElementById('x1').value = ex.x1;\n  document.getElementById('y1').value = ex.y1;\n  document.getElementById('label-x').value = ex.lx;\n  document.getElementById('label-y').value = ex.ly;\n  document.getElementById('x-new').value = '';\n  calcProp();\n}\n\nfunction setPropType(type) {\n  propType = type;\n  const btnP = document.getElementById('btn-prop');\n  const btnI = document.getElementById('btn-inv');\n  if (type === 'prop') {\n    btnP.className = 'flex-1 py-2.5 text-sm font-semibold transition-colors bg-blue-600 text-white';\n    btnI.className = 'flex-1 py-2.5 text-sm font-semibold transition-colors bg-white text-gray-500 hover:bg-gray-50';\n  } else {\n    btnI.className = 'flex-1 py-2.5 text-sm font-semibold transition-colors bg-orange-500 text-white';\n    btnP.className = 'flex-1 py-2.5 text-sm font-semibold transition-colors bg-white text-gray-500 hover:bg-gray-50';\n  }\n  calcProp();\n}\n\nfunction calcProp() {\n  const x1 = parseFloat(document.getElementById('x1').value);\n  const y1 = parseFloat(document.getElementById('y1').value);\n  const xNew = parseFloat(document.getElementById('x-new').value);\n  const lx = document.getElementById('label-x').value || 'x';\n  const ly = document.getElementById('label-y').value || 'y';\n\n  const kBox = document.getElementById('k-result-box');\n  const kFormula = document.getElementById('k-formula');\n  const kValue = document.getElementById('k-value');\n  const resultBox = document.getElementById('prop-result-box');\n  const formulaLine = document.getElementById('prop-formula-line');\n  const answerLine = document.getElementById('prop-answer-line');\n  const stepsDiv = document.getElementById('prop-steps');\n  const stepsList = document.getElementById('steps-list');\n\n  // Update table headers\n  document.getElementById('th-x').textContent = lx;\n  document.getElementById('th-y').textContent = ly;\n  document.getElementById('th-product').textContent = propType === 'prop' ? 'y / x (k)' : 'x · y (k)';\n\n  if (!x1 || !y1 || x1 <= 0 || y1 <= 0) {\n    kBox.classList.add('hidden');\n    resultBox.classList.add('hidden');\n    stepsDiv.classList.add('hidden');\n    renderPropTable(null, null);\n    return;\n  }\n\n  let k;\n  if (propType === 'prop') {\n    k = y1 / x1;\n    kFormula.textContent = 'k = y₁ / x₁ = ' + fmtNum(y1) + ' / ' + fmtNum(x1) + ' = ' + fmtNum(k, 6);\n    kValue.textContent = 'Formel: y = ' + fmtNum(k, 4) + ' · x';\n  } else {\n    k = x1 * y1;\n    kFormula.textContent = 'k = x₁ · y₁ = ' + fmtNum(x1) + ' · ' + fmtNum(y1) + ' = ' + fmtNum(k, 6);\n    kValue.textContent = 'Formel: y = ' + fmtNum(k, 4) + ' / x';\n  }\n\n  kBox.classList.remove('hidden');\n  kBox.classList.add('fade-in');\n\n  renderPropTable(k, lx, ly);\n\n  if (!xNew || xNew <= 0) {\n    resultBox.classList.add('hidden');\n    stepsDiv.classList.add('hidden');\n    return;\n  }\n\n  let yNew;\n  if (propType === 'prop') {\n    yNew = k * xNew;\n    formulaLine.textContent = ly + ' = ' + fmtNum(k, 4) + ' · ' + fmtNum(xNew) + ' = ' + fmtNum(yNew, 4);\n  } else {\n    yNew = k / xNew;\n    formulaLine.textContent = ly + ' = ' + fmtNum(k, 4) + ' / ' + fmtNum(xNew) + ' = ' + fmtNum(yNew, 4);\n  }\n  answerLine.textContent = 'Svar: Når ' + lx + ' = ' + fmtNum(xNew) + ', er ' + ly + ' = ' + fmtNum(yNew, 4);\n\n  resultBox.classList.remove('hidden');\n  resultBox.classList.add('fade-in');\n\n  // Steps\n  stepsList.innerHTML = '';\n  if (propType === 'prop') {\n    [\n      'Skriv opp at y og x er proporsjonale: y = k · x',\n      'Sett inn kjent par: ' + fmtNum(y1) + ' = k · ' + fmtNum(x1),\n      'Løs for k: k = ' + fmtNum(y1) + ' / ' + fmtNum(x1) + ' = ' + fmtNum(k, 6),\n      'Beregn ny y: y = ' + fmtNum(k, 4) + ' · ' + fmtNum(xNew) + ' = ' + fmtNum(yNew, 4),\n    ].forEach(s => { const li = document.createElement('li'); li.textContent = s; stepsList.appendChild(li); });\n  } else {\n    [\n      'Skriv opp at x og y er omvendt proporsjonale: x · y = k',\n      'Sett inn kjent par: ' + fmtNum(x1) + ' · ' + fmtNum(y1) + ' = k',\n      'Beregn k: k = ' + fmtNum(k, 6),\n      'For ny x: y = k / x = ' + fmtNum(k, 4) + ' / ' + fmtNum(xNew) + ' = ' + fmtNum(yNew, 4),\n    ].forEach(s => { const li = document.createElement('li'); li.textContent = s; stepsList.appendChild(li); });\n  }\n  stepsDiv.classList.remove('hidden');\n\n  savePropState();\n}\n\nfunction renderPropTable(k, lx, ly) {\n  const tbody = document.getElementById('prop-table-body');\n  const note = document.getElementById('table-note');\n  tbody.innerHTML = '';\n  if (k === null) {\n    note.textContent = 'Fyll inn et kjent par ovenfor for å se tabellen.';\n    return;\n  }\n  note.textContent = propType === 'prop'\n    ? 'k = y/x skal være konstant for alle rader.'\n    : 'k = x·y skal være konstant for alle rader.';\n\n  for (let x = 1; x <= 8; x++) {\n    const y = propType === 'prop' ? k * x : k / x;\n    const product = propType === 'prop' ? y / x : x * y;\n    const tr = document.createElement('tr');\n    tr.className = 'hover:bg-blue-50 transition-colors';\n    tr.innerHTML = `\n      <td class=\"px-3 py-2 font-mono text-gray-700\">${fmtNum(x)}</td>\n      <td class=\"px-3 py-2 font-mono font-semibold text-blue-700\">${fmtNum(y, 4)}</td>\n      <td class=\"px-3 py-2 font-mono text-green-700 text-xs\">${fmtNum(product, 4)}</td>\n    `;\n    tbody.appendChild(tr);\n  }\n}\n\nfunction savePropState() {\n  try {\n    localStorage.setItem('mp1_prop', JSON.stringify({\n      type: propType,\n      x1: document.getElementById('x1').value,\n      y1: document.getElementById('y1').value,\n      xNew: document.getElementById('x-new').value,\n      lx: document.getElementById('label-x').value,\n      ly: document.getElementById('label-y').value,\n    }));\n  } catch(e) {}\n}\n\nfunction loadPropState() {\n  try {\n    const s = localStorage.getItem('mp1_prop');\n    if (!s) return false;\n    const d = JSON.parse(s);\n    if (d.type) { propType = d.type; setPropType(propType); }\n    if (d.x1) document.getElementById('x1').value = d.x1;\n    if (d.y1) document.getElementById('y1').value = d.y1;\n    if (d.xNew) document.getElementById('x-new').value = d.xNew;\n    if (d.lx) document.getElementById('label-x').value = d.lx;\n    if (d.ly) document.getElementById('label-y').value = d.ly;\n    return true;\n  } catch(e) { return false; }\n}\n\n// =====================================================================\n// INIT\n// =====================================================================\n(function init() {\n  // Restore tab\n  const savedTab = localStorage.getItem('mp1_tab') || 'teori';\n  showTab(savedTab);\n\n  // Init recipe (always, so it's ready when tab is opened)\n  initRecipe();\n\n  // Init prop\n  buildExampleButtons();\n  if (!loadPropState()) {\n    // defaults already set in HTML\n    document.getElementById('label-x').value = 'kg';\n    document.getElementById('label-y').value = 'pris (kr)';\n  }\n  calcProp();\n})();\n</script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Forhold og proporsjonalitet",
    "windowTitle": "Forhold og proporsjonalitet",
    "bundleId": "com.halisonworks.forholdproporsjonalitet",
    "iconPath": null
  },
  "categoryId": null,
  "source": "import",
  "createdAt": "2026-06-02T12:00:00.000Z",
  "updatedAt": "2026-06-02T12:00:00.000Z",
  "sharedAt": "2026-06-02T12:00:00.000Z"
}
