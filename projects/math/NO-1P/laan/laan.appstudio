{
  "schema": "app-studio/canvas@1",
  "id": "example-no1p-laan",
  "name": "laan.html",
  "code": "<!DOCTYPE html>\n<!--\n  Serielån og annuitetslån — Halison App Studio-eksempel\n\n  Interaktivt læremiddel for matematikk 1P (LK20): sammenlikn serielån og\n  annuitetslån — nedbetalingsplan, renter og terminbeløp over tid.\n\n  Fra Halison App Studio sitt offentlige bibliotek:\n  https://github.com/halisonworks/public-app-studio\n\n  Tillatt bruk: personlig, pedagogisk og annen ikke-kommersiell bruk. Behold denne\n  headeren og kildelenken; ikke-kommersiell bruk. Utgitt under Halison App Studio\n  Examples License — se LICENSE-filen i repoet over.\n-->\n<html lang=\"no\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Serielån og annuitetslån — Matematikk 1P</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Segoe UI', system-ui, sans-serif; }\n    .table-scroll { overflow-x: auto; }\n    table { border-collapse: collapse; width: 100%; }\n    th, td { padding: 0.45rem 0.75rem; text-align: right; white-space: nowrap; }\n    th:first-child, td:first-child { text-align: center; }\n    thead th { background: #1e40af; color: white; position: sticky; top: 0; }\n    tbody tr:nth-child(even) { background: #eff6ff; }\n    tbody tr:hover { background: #dbeafe; }\n    .serie-thead th { background: #065f46; }\n    tbody tr:nth-child(even).serie { background: #ecfdf5; }\n    tbody tr:hover.serie { background: #d1fae5; }\n    input[type=number]::-webkit-inner-spin-button,\n    input[type=number]::-webkit-outer-spin-button { opacity: 1; }\n    .tooltip { position: relative; display: inline-block; }\n    .tooltip .tip {\n      visibility: hidden; opacity: 0; transition: opacity 0.2s;\n      background: #1e293b; color: #fff; font-size: 0.78rem;\n      border-radius: 6px; padding: 6px 10px;\n      position: absolute; bottom: 130%; left: 50%; transform: translateX(-50%);\n      width: 220px; text-align: left; z-index: 10; pointer-events: none;\n    }\n    .tooltip:hover .tip { visibility: visible; opacity: 1; }\n    .svg-chart { width: 100%; height: auto; display: block; }\n    @media (max-width: 640px) {\n      th, td { padding: 0.3rem 0.45rem; font-size: 0.82rem; }\n    }\n  </style>\n</head>\n<body class=\"bg-slate-50 min-h-screen\">\n\n<!-- Header -->\n<header class=\"bg-blue-900 text-white py-4 px-4 shadow-md\">\n  <div class=\"max-w-5xl mx-auto\">\n    <div class=\"flex items-center gap-3\">\n      <span class=\"text-3xl\">🏦</span>\n      <div>\n        <h1 class=\"text-xl sm:text-2xl font-bold leading-tight\">Serielån og annuitetslån</h1>\n        <p class=\"text-blue-200 text-sm mt-0.5\">Matematikk 1P · LK20 · Sinus kap. 5.6–5.7</p>\n      </div>\n    </div>\n  </div>\n</header>\n\n<!-- Main -->\n<main class=\"max-w-5xl mx-auto px-3 py-6 space-y-8\">\n\n  <!-- Forklaringsboks -->\n  <section class=\"bg-white rounded-xl shadow p-5 border border-blue-100\">\n    <h2 class=\"text-lg font-bold text-blue-900 mb-2\">📚 Hva er forskjellen?</h2>\n    <div class=\"grid sm:grid-cols-2 gap-4 text-sm text-slate-700\">\n      <div class=\"bg-emerald-50 rounded-lg p-4 border border-emerald-200\">\n        <h3 class=\"font-bold text-emerald-800 mb-1\">Serielån</h3>\n        <p>Du betaler <strong>like stort avdrag</strong> hver termin. Renten regnes av <em>restgjelden</em>, som synker for hver termin. Derfor er <strong>terminbeløpet størst i starten</strong> og minker gradvis. Totalt betaler du <em>mindre renter</em> enn ved annuitetslån.</p>\n      </div>\n      <div class=\"bg-blue-50 rounded-lg p-4 border border-blue-200\">\n        <h3 class=\"font-bold text-blue-800 mb-1\">Annuitetslån</h3>\n        <p>Du betaler <strong>like stort terminbeløp</strong> hver gang. I starten er renten stor og avdraget lite. Mot slutten er det omvendt. Terminbeløpet regnes med annuitetsformelen. Totalt betaler du <em>mer renter</em>, men det er lettere å budsjettere.</p>\n      </div>\n    </div>\n  </section>\n\n  <!-- Inndata -->\n  <section class=\"bg-white rounded-xl shadow p-5 border border-blue-100\">\n    <h2 class=\"text-lg font-bold text-blue-900 mb-4\">⚙️ Innstillinger</h2>\n    <div class=\"grid sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n\n      <div>\n        <label class=\"block text-sm font-medium text-slate-700 mb-1\">\n          Lånebeløp (kr)\n          <span class=\"tooltip ml-1 text-blue-400 cursor-help\">ℹ️<span class=\"tip\">Beløpet du låner, f.eks. 500 000 kr for et billån eller 2 000 000 kr for et boliglån.</span></span>\n        </label>\n        <input id=\"laan\" type=\"number\" min=\"1000\" max=\"100000000\" step=\"1000\" value=\"500000\"\n          class=\"w-full border border-slate-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400 text-right\" />\n      </div>\n\n      <div>\n        <label class=\"block text-sm font-medium text-slate-700 mb-1\">\n          Årlig rente (%)\n          <span class=\"tooltip ml-1 text-blue-400 cursor-help\">ℹ️<span class=\"tip\">Nominell årlig rente. Terminrenten beregnes som: årsrente ÷ antall terminer per år.</span></span>\n        </label>\n        <input id=\"rente\" type=\"number\" min=\"0.01\" max=\"50\" step=\"0.01\" value=\"5.5\"\n          class=\"w-full border border-slate-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400 text-right\" />\n      </div>\n\n      <div>\n        <label class=\"block text-sm font-medium text-slate-700 mb-1\">\n          Antall år\n          <span class=\"tooltip ml-1 text-blue-400 cursor-help\">ℹ️<span class=\"tip\">Løpetiden på lånet. F.eks. 20 år for et boliglån.</span></span>\n        </label>\n        <input id=\"aar\" type=\"number\" min=\"1\" max=\"50\" step=\"1\" value=\"5\"\n          class=\"w-full border border-slate-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400 text-right\" />\n      </div>\n\n      <div>\n        <label class=\"block text-sm font-medium text-slate-700 mb-1\">\n          Terminer per år\n          <span class=\"tooltip ml-1 text-blue-400 cursor-help\">ℹ️<span class=\"tip\">Månedlig = 12 terminer/år. Kvartalsvis = 4. Halvårlig = 2. Årlig = 1.</span></span>\n        </label>\n        <select id=\"termPerAar\"\n          class=\"w-full border border-slate-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400 bg-white\">\n          <option value=\"12\" selected>Månedlig (12/år)</option>\n          <option value=\"4\">Kvartalsvis (4/år)</option>\n          <option value=\"2\">Halvårlig (2/år)</option>\n          <option value=\"1\">Årlig (1/år)</option>\n        </select>\n      </div>\n\n    </div>\n\n    <div class=\"mt-5 flex flex-wrap gap-3 items-center\">\n      <button id=\"beregn\" onclick=\"beregn()\"\n        class=\"bg-blue-700 hover:bg-blue-800 active:bg-blue-900 text-white font-semibold px-6 py-2.5 rounded-lg shadow transition-colors\">\n        Beregn nedbetalingsplan\n      </button>\n      <button onclick=\"tilbakestill()\"\n        class=\"bg-slate-200 hover:bg-slate-300 text-slate-700 font-medium px-5 py-2.5 rounded-lg transition-colors\">\n        Tilbakestill\n      </button>\n      <span id=\"feilmelding\" class=\"text-red-600 text-sm font-medium hidden\"></span>\n    </div>\n  </section>\n\n  <!-- Resultatsammendrag -->\n  <section id=\"sammendrag\" class=\"hidden\">\n    <div class=\"grid sm:grid-cols-3 gap-4\">\n      <div class=\"bg-white rounded-xl shadow p-4 border border-blue-100 text-center\">\n        <div class=\"text-xs text-slate-500 uppercase tracking-wide mb-1\">Lånebeløp</div>\n        <div id=\"sum-laan\" class=\"text-2xl font-bold text-slate-800\"></div>\n      </div>\n      <div class=\"bg-emerald-50 rounded-xl shadow p-4 border border-emerald-200 text-center\">\n        <div class=\"text-xs text-emerald-700 uppercase tracking-wide mb-1\">Totale renter — Serielån</div>\n        <div id=\"sum-serie-renter\" class=\"text-2xl font-bold text-emerald-700\"></div>\n      </div>\n      <div class=\"bg-blue-50 rounded-xl shadow p-4 border border-blue-200 text-center\">\n        <div class=\"text-xs text-blue-700 uppercase tracking-wide mb-1\">Totale renter — Annuitetslån</div>\n        <div id=\"sum-ann-renter\" class=\"text-2xl font-bold text-blue-700\"></div>\n      </div>\n    </div>\n    <div id=\"rentediff-boks\" class=\"mt-3 bg-amber-50 border border-amber-200 rounded-xl p-4 text-sm text-amber-900\"></div>\n  </section>\n\n  <!-- Graf -->\n  <section id=\"graf-seksjon\" class=\"hidden bg-white rounded-xl shadow p-5 border border-blue-100\">\n    <h2 class=\"text-lg font-bold text-blue-900 mb-1\">📈 Terminbeløp over tid</h2>\n    <p class=\"text-sm text-slate-500 mb-3\">Grønn = serielån (synkende), blå = annuitetslån (konstant)</p>\n    <div id=\"graf-container\"></div>\n    <p class=\"text-xs text-slate-400 mt-2\">Merk: ved mange terminer vises hvert <span id=\"vis-steg-tekst\"></span> termin i grafen for bedre lesbarhet.</p>\n  </section>\n\n  <!-- Tabeller -->\n  <section id=\"tabeller\" class=\"hidden space-y-8\">\n\n    <!-- Serielån tabell -->\n    <div>\n      <h2 class=\"text-lg font-bold text-emerald-800 mb-2\">📋 Nedbetalingsplan — Serielån</h2>\n      <div class=\"table-scroll rounded-xl shadow border border-emerald-200\">\n        <table>\n          <thead class=\"serie-thead\">\n            <tr>\n              <th>Termin</th>\n              <th>Avdrag (kr)</th>\n              <th>Renter (kr)</th>\n              <th>Terminbeløp (kr)</th>\n              <th>Restgjeld (kr)</th>\n            </tr>\n          </thead>\n          <tbody id=\"serie-tbody\"></tbody>\n          <tfoot>\n            <tr class=\"bg-emerald-100 font-semibold\">\n              <td class=\"text-center\">Sum</td>\n              <td id=\"serie-sum-avdrag\" class=\"text-right\"></td>\n              <td id=\"serie-sum-renter\" class=\"text-right\"></td>\n              <td id=\"serie-sum-term\" class=\"text-right\"></td>\n              <td class=\"text-right\">—</td>\n            </tr>\n          </tfoot>\n        </table>\n      </div>\n    </div>\n\n    <!-- Annuitetslån tabell -->\n    <div>\n      <h2 class=\"text-lg font-bold text-blue-800 mb-2\">📋 Nedbetalingsplan — Annuitetslån</h2>\n      <div class=\"table-scroll rounded-xl shadow border border-blue-200\">\n        <table>\n          <thead>\n            <tr>\n              <th>Termin</th>\n              <th>Avdrag (kr)</th>\n              <th>Renter (kr)</th>\n              <th>Terminbeløp (kr)</th>\n              <th>Restgjeld (kr)</th>\n            </tr>\n          </thead>\n          <tbody id=\"ann-tbody\"></tbody>\n          <tfoot>\n            <tr class=\"bg-blue-100 font-semibold\">\n              <td class=\"text-center\">Sum</td>\n              <td id=\"ann-sum-avdrag\" class=\"text-right\"></td>\n              <td id=\"ann-sum-renter\" class=\"text-right\"></td>\n              <td id=\"ann-sum-term\" class=\"text-right\"></td>\n              <td class=\"text-right\">—</td>\n            </tr>\n          </tfoot>\n        </table>\n      </div>\n    </div>\n\n  </section>\n\n  <!-- Formelboks -->\n  <section class=\"bg-white rounded-xl shadow p-5 border border-slate-200\">\n    <h2 class=\"text-lg font-bold text-slate-800 mb-3\">🧮 Formler</h2>\n    <div class=\"grid sm:grid-cols-2 gap-5 text-sm text-slate-700\">\n      <div class=\"bg-emerald-50 rounded-lg p-4 border border-emerald-200\">\n        <h3 class=\"font-bold text-emerald-800 mb-2\">Serielån</h3>\n        <p class=\"mb-1\"><strong>Fast avdrag:</strong></p>\n        <p class=\"font-mono bg-white rounded px-2 py-1 mb-2 text-xs border border-emerald-100\">avdrag = lånebeløp ÷ antall terminer</p>\n        <p class=\"mb-1\"><strong>Rente i termin <em>t</em>:</strong></p>\n        <p class=\"font-mono bg-white rounded px-2 py-1 mb-2 text-xs border border-emerald-100\">rente_t = restgjeld_{t-1} × terminrente</p>\n        <p class=\"mb-1\"><strong>Terminbeløp:</strong></p>\n        <p class=\"font-mono bg-white rounded px-2 py-1 text-xs border border-emerald-100\">term_t = avdrag + rente_t</p>\n      </div>\n      <div class=\"bg-blue-50 rounded-lg p-4 border border-blue-200\">\n        <h3 class=\"font-bold text-blue-800 mb-2\">Annuitetslån</h3>\n        <p class=\"mb-1\"><strong>Fast terminbeløp (annuitetsformelen):</strong></p>\n        <p class=\"font-mono bg-white rounded px-2 py-1 mb-2 text-xs border border-blue-100\">A = G × r × (1+r)^n / ((1+r)^n − 1)</p>\n        <p class=\"text-xs text-slate-500 mb-2\">der G = lånebeløp, r = terminrente, n = antall terminer</p>\n        <p class=\"mb-1\"><strong>Rente i termin <em>t</em>:</strong></p>\n        <p class=\"font-mono bg-white rounded px-2 py-1 mb-2 text-xs border border-blue-100\">rente_t = restgjeld_{t-1} × r</p>\n        <p class=\"mb-1\"><strong>Avdrag:</strong></p>\n        <p class=\"font-mono bg-white rounded px-2 py-1 text-xs border border-blue-100\">avdrag_t = A − rente_t</p>\n      </div>\n    </div>\n  </section>\n\n</main>\n\n<footer class=\"text-center text-xs text-slate-400 py-6\">\n  Halison App Studio · Matematikk 1P · LK20 · Sinus kap. 5.6–5.7 ·\n  <a href=\"https://github.com/halisonworks/public-app-studio\" class=\"underline hover:text-slate-600\" target=\"_blank\" rel=\"noopener\">GitHub</a>\n</footer>\n\n<script>\n  // ── Hjelpefunksjoner ──────────────────────────────────────────────────────────\n\n  function kr(tall) {\n    // Formater som norske kroner med to desimaler\n    return tall.toLocaleString('nb-NO', { minimumFractionDigits: 2, maximumFractionDigits: 2 });\n  }\n\n  function vis(id) { document.getElementById(id).classList.remove('hidden'); }\n  function skjul(id) { document.getElementById(id).classList.add('hidden'); }\n\n  function tilbakestill() {\n    document.getElementById('laan').value = '500000';\n    document.getElementById('rente').value = '5.5';\n    document.getElementById('aar').value = '5';\n    document.getElementById('termPerAar').value = '12';\n    skjul('sammendrag');\n    skjul('graf-seksjon');\n    skjul('tabeller');\n    document.getElementById('feilmelding').classList.add('hidden');\n  }\n\n  // ── Serielån-beregning ────────────────────────────────────────────────────────\n\n  function beregnSerie(G, r, n) {\n    // G: lånebeløp, r: terminrente, n: antall terminer\n    const avdrag = G / n;\n    let restgjeld = G;\n    const plan = [];\n    for (let t = 1; t <= n; t++) {\n      const renter = restgjeld * r;\n      const terminbelop = avdrag + renter;\n      restgjeld -= avdrag;\n      // Unngå negativ restgjeld på grunn av flytall\n      if (Math.abs(restgjeld) < 0.005) restgjeld = 0;\n      plan.push({ t, avdrag, renter, terminbelop, restgjeld });\n    }\n    return plan;\n  }\n\n  // ── Annuitetslån-beregning ────────────────────────────────────────────────────\n\n  function beregnAnnuitet(G, r, n) {\n    // Annuitetsformelen: A = G * r * (1+r)^n / ((1+r)^n - 1)\n    const faktor = Math.pow(1 + r, n);\n    const A = G * r * faktor / (faktor - 1);\n    let restgjeld = G;\n    const plan = [];\n    for (let t = 1; t <= n; t++) {\n      const renter = restgjeld * r;\n      let avdrag = A - renter;\n      restgjeld -= avdrag;\n      if (Math.abs(restgjeld) < 0.005) restgjeld = 0;\n      plan.push({ t, avdrag, renter, terminbelop: A, restgjeld });\n    }\n    return plan;\n  }\n\n  // ── Fyll tabell ───────────────────────────────────────────────────────────────\n\n  function fyllTabell(tbodyId, plan, rowClass) {\n    const tbody = document.getElementById(tbodyId);\n    tbody.innerHTML = '';\n    for (const row of plan) {\n      const tr = document.createElement('tr');\n      if (rowClass) tr.classList.add(rowClass);\n      tr.innerHTML = `\n        <td>${row.t}</td>\n        <td>${kr(row.avdrag)}</td>\n        <td>${kr(row.renter)}</td>\n        <td>${kr(row.terminbelop)}</td>\n        <td>${kr(row.restgjeld)}</td>\n      `;\n      tbody.appendChild(tr);\n    }\n  }\n\n  function summertRad(plan, felt) {\n    return plan.reduce((s, r) => s + r[felt], 0);\n  }\n\n  // ── SVG-graf ──────────────────────────────────────────────────────────────────\n\n  function tegnGraf(seriePlan, annPlan) {\n    const n = seriePlan.length;\n\n    // Steg for lesbarhet\n    let steg = 1;\n    if (n > 360) steg = 12;\n    else if (n > 180) steg = 6;\n    else if (n > 60) steg = 3;\n    else if (n > 24) steg = 2;\n    document.getElementById('vis-steg-tekst').textContent =\n      steg === 1 ? 'enkelt' : steg + '.';\n\n    const punkterSerie = [];\n    const punkterAnn = [];\n    for (let i = 0; i < n; i += steg) {\n      punkterSerie.push(seriePlan[i].terminbelop);\n      punkterAnn.push(annPlan[i].terminbelop);\n    }\n\n    // Alle verdier for skalering\n    const alleVerdier = punkterSerie.concat(punkterAnn);\n    const maxV = Math.max(...alleVerdier);\n    const minV = Math.min(...alleVerdier) * 0.9;\n    const antP = punkterSerie.length;\n\n    // SVG dimensjoner\n    const W = 800; const H = 300;\n    const padL = 90; const padR = 20; const padT = 15; const padB = 45;\n    const grafW = W - padL - padR;\n    const grafH = H - padT - padB;\n\n    function xPos(i) { return padL + (i / Math.max(antP - 1, 1)) * grafW; }\n    function yPos(v) { return padT + grafH - ((v - minV) / (maxV - minV || 1)) * grafH; }\n\n    // Bygg SVG\n    let svg = `<svg viewBox=\"0 0 ${W} ${H}\" class=\"svg-chart\" role=\"img\" aria-label=\"Graf over terminbeløp\">`;\n\n    // Rutenett og y-akse etiketter\n    const yTicks = 5;\n    for (let i = 0; i <= yTicks; i++) {\n      const v = minV + (maxV - minV) * (i / yTicks);\n      const y = yPos(v);\n      svg += `<line x1=\"${padL}\" y1=\"${y}\" x2=\"${W - padR}\" y2=\"${y}\" stroke=\"#e2e8f0\" stroke-width=\"1\"/>`;\n      svg += `<text x=\"${padL - 6}\" y=\"${y + 4}\" text-anchor=\"end\" font-size=\"11\" fill=\"#64748b\">${kr(v)}</text>`;\n    }\n\n    // x-akse etiketter\n    const xTicks = Math.min(antP - 1, 10);\n    for (let i = 0; i <= xTicks; i++) {\n      const idx = Math.round((i / xTicks) * (antP - 1));\n      const termNr = idx * steg + 1;\n      const x = xPos(idx);\n      svg += `<line x1=\"${x}\" y1=\"${padT}\" x2=\"${x}\" y2=\"${padT + grafH}\" stroke=\"#f1f5f9\" stroke-width=\"1\"/>`;\n      svg += `<text x=\"${x}\" y=\"${padT + grafH + 16}\" text-anchor=\"middle\" font-size=\"11\" fill=\"#64748b\">${termNr}</text>`;\n    }\n\n    // Akse-linjer\n    svg += `<line x1=\"${padL}\" y1=\"${padT}\" x2=\"${padL}\" y2=\"${padT + grafH}\" stroke=\"#94a3b8\" stroke-width=\"1.5\"/>`;\n    svg += `<line x1=\"${padL}\" y1=\"${padT + grafH}\" x2=\"${W - padR}\" y2=\"${padT + grafH}\" stroke=\"#94a3b8\" stroke-width=\"1.5\"/>`;\n\n    // Akse-titler\n    svg += `<text x=\"${padL + grafW / 2}\" y=\"${H - 4}\" text-anchor=\"middle\" font-size=\"12\" fill=\"#475569\">Termin</text>`;\n    svg += `<text x=\"12\" y=\"${padT + grafH / 2}\" text-anchor=\"middle\" font-size=\"11\" fill=\"#475569\" transform=\"rotate(-90 12 ${padT + grafH / 2})\">Terminbeløp (kr)</text>`;\n\n    // Hjelpefunksjon for polyline\n    function lagPolyline(punkter, farge, dash) {\n      const pts = punkter.map((v, i) => `${xPos(i)},${yPos(v)}`).join(' ');\n      const dashAttr = dash ? `stroke-dasharray=\"${dash}\"` : '';\n      return `<polyline points=\"${pts}\" fill=\"none\" stroke=\"${farge}\" stroke-width=\"2.5\" stroke-linejoin=\"round\" stroke-linecap=\"round\" ${dashAttr}/>`;\n    }\n\n    // Serielån (grønn) og annuitetslån (blå)\n    svg += lagPolyline(punkterSerie, '#059669');\n    svg += lagPolyline(punkterAnn, '#2563eb', '6,4');\n\n    // Legende\n    svg += `<rect x=\"${padL + 10}\" y=\"${padT + 5}\" width=\"14\" height=\"4\" rx=\"2\" fill=\"#059669\"/>`;\n    svg += `<text x=\"${padL + 28}\" y=\"${padT + 12}\" font-size=\"12\" fill=\"#065f46\">Serielån</text>`;\n    svg += `<line x1=\"${padL + 130}\" y1=\"${padT + 7}\" x2=\"${padL + 144}\" y2=\"${padT + 7}\" stroke=\"#2563eb\" stroke-width=\"2.5\" stroke-dasharray=\"5,3\"/>`;\n    svg += `<text x=\"${padL + 148}\" y=\"${padT + 12}\" font-size=\"12\" fill=\"#1e40af\">Annuitetslån</text>`;\n\n    svg += '</svg>';\n    document.getElementById('graf-container').innerHTML = svg;\n  }\n\n  // ── Hoved-beregn funksjon ─────────────────────────────────────────────────────\n\n  function beregn() {\n    const feilEl = document.getElementById('feilmelding');\n    feilEl.classList.add('hidden');\n\n    const G = parseFloat(document.getElementById('laan').value);\n    const renteProsent = parseFloat(document.getElementById('rente').value);\n    const aar = parseInt(document.getElementById('aar').value);\n    const termPerAar = parseInt(document.getElementById('termPerAar').value);\n\n    // Validering\n    if (!G || G < 1000) {\n      feilEl.textContent = 'Lånebeløp må være minst 1 000 kr.';\n      feilEl.classList.remove('hidden'); return;\n    }\n    if (!renteProsent || renteProsent <= 0 || renteProsent > 50) {\n      feilEl.textContent = 'Renten må være mellom 0,01 % og 50 %.';\n      feilEl.classList.remove('hidden'); return;\n    }\n    if (!aar || aar < 1 || aar > 50) {\n      feilEl.textContent = 'Antall år må være mellom 1 og 50.';\n      feilEl.classList.remove('hidden'); return;\n    }\n\n    const n = aar * termPerAar;          // totalt antall terminer\n    const r = renteProsent / 100 / termPerAar;  // terminrente\n\n    const seriePlan = beregnSerie(G, r, n);\n    const annPlan = beregnAnnuitet(G, r, n);\n\n    // Fyll tabeller\n    fyllTabell('serie-tbody', seriePlan, 'serie');\n    fyllTabell('ann-tbody', annPlan, '');\n\n    // Summer\n    const serieAvdragSum = summertRad(seriePlan, 'avdrag');\n    const serieRenterSum = summertRad(seriePlan, 'renter');\n    const serieTermSum   = summertRad(seriePlan, 'terminbelop');\n    const annAvdragSum   = summertRad(annPlan, 'avdrag');\n    const annRenterSum   = summertRad(annPlan, 'renter');\n    const annTermSum     = summertRad(annPlan, 'terminbelop');\n\n    document.getElementById('serie-sum-avdrag').textContent = kr(serieAvdragSum);\n    document.getElementById('serie-sum-renter').textContent = kr(serieRenterSum);\n    document.getElementById('serie-sum-term').textContent   = kr(serieTermSum);\n    document.getElementById('ann-sum-avdrag').textContent   = kr(annAvdragSum);\n    document.getElementById('ann-sum-renter').textContent   = kr(annRenterSum);\n    document.getElementById('ann-sum-term').textContent     = kr(annTermSum);\n\n    // Sammendrag\n    const diff = annRenterSum - serieRenterSum;\n    document.getElementById('sum-laan').textContent = kr(G) + ' kr';\n    document.getElementById('sum-serie-renter').textContent = kr(serieRenterSum) + ' kr';\n    document.getElementById('sum-ann-renter').textContent   = kr(annRenterSum) + ' kr';\n\n    document.getElementById('rentediff-boks').innerHTML =\n      `<strong>💡 Sammenligning:</strong> Med serielån betaler du totalt <strong>${kr(serieRenterSum)} kr</strong> i renter, mot <strong>${kr(annRenterSum)} kr</strong> med annuitetslån. ` +\n      `Det er <strong>${kr(diff)} kr ${diff >= 0 ? 'mer' : 'mindre'}</strong> med annuitetslån. ` +\n      `Serielånet er rimeligere totalt, men terminbeløpet er <strong>${kr(seriePlan[0].terminbelop)} kr</strong> i starten mot et fast <strong>${kr(annPlan[0].terminbelop)} kr</strong> for annuitetslånet.`;\n\n    // Graf\n    tegnGraf(seriePlan, annPlan);\n\n    // Vis seksjoner\n    vis('sammendrag');\n    vis('graf-seksjon');\n    vis('tabeller');\n\n    // Scroll til sammendrag\n    document.getElementById('sammendrag').scrollIntoView({ behavior: 'smooth', block: 'start' });\n  }\n\n  // Kjør én gang ved innlasting for å vise eksempelresultat\n  window.addEventListener('DOMContentLoaded', beregn);\n</script>\n\n</body>\n</html>\n",
  "packaging": {
    "appName": "Serielån og annuitetslån",
    "windowTitle": "Serielån og annuitetslån",
    "bundleId": "com.halisonworks.laan1p",
    "iconPath": null
  },
  "categoryId": null,
