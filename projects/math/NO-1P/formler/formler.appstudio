{
  "schema": "app-studio/canvas@1",
  "id": "example-no1p-formler",
  "name": "formler.html",
  "code": "<!DOCTYPE html>\n<!--\n  Formler — Halison App Studio-eksempel\n\n  Interaktivt læremiddel for matematikk 1P (LK20): regn med formler og form om\n  formler til å løse for en annen variabel.\n\n  Fra Halison App Studio sitt offentlige bibliotek:\n  https://github.com/halisonworks/public-app-studio\n\n  Tillatt bruk: personlig, pedagogisk og annen ikke-kommersiell bruk. Behold denne\n  headeren og kildelenken; ikke-kommersiell bruk. Utgitt under Halison App Studio\n  Examples License — se LICENSE-filen i repoet over.\n-->\n<html lang=\"no\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Formler – Matematikk 1P</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    .tab-active { border-bottom: 3px solid #2563eb; color: #2563eb; font-weight: 700; }\n    .tab-inactive { border-bottom: 3px solid transparent; color: #6b7280; }\n    .result-box { background: #f0fdf4; border-left: 4px solid #16a34a; }\n    .error-box  { background: #fef2f2; border-left: 4px solid #dc2626; }\n    .step-line  { border-left: 3px solid #93c5fd; }\n    input[type=number]::-webkit-inner-spin-button,\n    input[type=number]::-webkit-outer-spin-button { opacity: 1; }\n    .katex-display { overflow-x: auto; }\n    .formula-card { cursor: pointer; transition: box-shadow .15s; }\n    .formula-card:hover { box-shadow: 0 4px 16px rgba(37,99,235,.15); }\n    .formula-card.selected { border-color: #2563eb; background: #eff6ff; }\n  </style>\n</head>\n<body class=\"bg-gray-50 min-h-screen font-sans\">\n\n<!-- HEADER -->\n<header class=\"bg-blue-700 text-white py-5 px-4 shadow-md\">\n  <div class=\"max-w-4xl mx-auto\">\n    <h1 class=\"text-2xl font-bold tracking-tight\">📐 Formler og omforming</h1>\n    <p class=\"text-blue-200 text-sm mt-1\">Matematikk 1P · LK20 · Sinus 1P kap. 7.1–7.3</p>\n  </div>\n</header>\n\n<!-- TABS -->\n<div class=\"max-w-4xl mx-auto mt-4 px-4\">\n  <div class=\"flex gap-0 border-b border-gray-200 bg-white rounded-t-lg shadow-sm\">\n    <button id=\"tab-forklaring\" onclick=\"visTab('forklaring')\"\n      class=\"tab-active px-5 py-3 text-sm transition focus:outline-none\">\n      📖 Teori\n    </button>\n    <button id=\"tab-regning\" onclick=\"visTab('regning')\"\n      class=\"tab-inactive px-5 py-3 text-sm transition focus:outline-none\">\n      🔢 Formelregning\n    </button>\n    <button id=\"tab-omforming\" onclick=\"visTab('omforming')\"\n      class=\"tab-inactive px-5 py-3 text-sm transition focus:outline-none\">\n      🔄 Omforming\n    </button>\n  </div>\n\n  <!-- ============================================================ -->\n  <!-- TAB 1 – TEORI                                                -->\n  <!-- ============================================================ -->\n  <div id=\"panel-forklaring\" class=\"bg-white rounded-b-lg shadow-sm p-6 space-y-6\">\n\n    <section>\n      <h2 class=\"text-xl font-bold text-blue-700 mb-2\">Hva er en variabel?</h2>\n      <p class=\"text-gray-700 leading-relaxed\">\n        En <strong>variabel</strong> er et symbol – vanligvis en bokstav – som representerer\n        en ukjent eller skiftende størrelse. Når vi skriver <em>v</em> for fart eller\n        <em>l</em> for lengde, er det variabler. Verdien kan variere fra oppgave til oppgave,\n        men symbolet er det samme.\n      </p>\n    </section>\n\n    <section>\n      <h2 class=\"text-xl font-bold text-blue-700 mb-2\">Hva er en formel?</h2>\n      <p class=\"text-gray-700 leading-relaxed\">\n        En <strong>formel</strong> er en matematisk sammenheng mellom to eller flere variabler.\n        Den forteller oss <em>hvordan</em> størrelsene henger sammen.\n      </p>\n      <div class=\"mt-3 grid grid-cols-1 sm:grid-cols-2 gap-3\">\n        <div class=\"bg-blue-50 rounded-lg p-3 border border-blue-100\">\n          <p class=\"font-mono text-blue-800 text-lg font-bold\">A = l · b</p>\n          <p class=\"text-sm text-gray-600 mt-1\">Areal av rektangel: areal er lik lengde ganger bredde</p>\n        </div>\n        <div class=\"bg-blue-50 rounded-lg p-3 border border-blue-100\">\n          <p class=\"font-mono text-blue-800 text-lg font-bold\">s = v · t</p>\n          <p class=\"text-sm text-gray-600 mt-1\">Strekning = fart ganger tid</p>\n        </div>\n        <div class=\"bg-blue-50 rounded-lg p-3 border border-blue-100\">\n          <p class=\"font-mono text-blue-800 text-lg font-bold\">U = R · I</p>\n          <p class=\"text-sm text-gray-600 mt-1\">Ohms lov: spenning = motstand × strøm</p>\n        </div>\n        <div class=\"bg-blue-50 rounded-lg p-3 border border-blue-100\">\n          <p class=\"font-mono text-blue-800 text-lg font-bold\">C = °F − 32) · 5/9</p>\n          <p class=\"text-sm text-gray-600 mt-1\">Fahrenheit til Celsius</p>\n        </div>\n      </div>\n    </section>\n\n    <section>\n      <h2 class=\"text-xl font-bold text-blue-700 mb-2\">Regelen: samme operasjon på begge sider</h2>\n      <p class=\"text-gray-700 leading-relaxed\">\n        Når vi løser en formel for en variabel, bruker vi regelen om at vi kan gjøre\n        <strong>samme operasjon på begge sider</strong> av likhetstegnet uten at likheten brytes.\n      </p>\n      <div class=\"mt-4 bg-yellow-50 border border-yellow-200 rounded-lg p-4\">\n        <p class=\"font-semibold text-yellow-800 mb-2\">Eksempel: Løs for <em>v</em> i formelen <code class=\"bg-yellow-100 px-1 rounded\">s = v · t</code></p>\n        <div class=\"space-y-2 text-gray-800\">\n          <div class=\"step-line pl-4 py-1\">\n            <span class=\"font-mono\">s = v · t</span>\n            <span class=\"text-gray-500 ml-2 text-sm\">– utgangspunkt</span>\n          </div>\n          <div class=\"step-line pl-4 py-1\">\n            <span class=\"font-mono\">s / t = v · t / t</span>\n            <span class=\"text-gray-500 ml-2 text-sm\">– del begge sider på <em>t</em></span>\n          </div>\n          <div class=\"step-line pl-4 py-1\">\n            <span class=\"font-mono\">v = s / t</span>\n            <span class=\"text-gray-500 ml-2 text-sm\">– ferdig!</span>\n          </div>\n        </div>\n      </div>\n      <p class=\"text-gray-700 mt-3 leading-relaxed\">\n        Nøkkelen er å <strong>isolere variabelen</strong> vi ønsker å finne på én side.\n        Vi bruker inverse operasjoner: addisjon motvirkes av subtraksjon, multiplikasjon\n        motvirkes av divisjon, og kvadrering motvirkes av kvadratrot.\n      </p>\n    </section>\n\n    <section>\n      <h2 class=\"text-xl font-bold text-blue-700 mb-2\">Tips til omforming</h2>\n      <ul class=\"list-disc list-inside space-y-2 text-gray-700\">\n        <li>Finn ut hvilken variabel du vil løse for.</li>\n        <li>Bruk inverse operasjoner for å flytte alt annet til den andre siden.</li>\n        <li>Utfør alltid <em>samme operasjon</em> på begge sider.</li>\n        <li>Sjekk svaret ditt ved å sette inn tall og se om formelen stemmer.</li>\n      </ul>\n    </section>\n\n  </div>\n\n  <!-- ============================================================ -->\n  <!-- TAB 2 – FORMELREGNING                                        -->\n  <!-- ============================================================ -->\n  <div id=\"panel-regning\" class=\"bg-white rounded-b-lg shadow-sm p-6 hidden\">\n\n    <h2 class=\"text-xl font-bold text-blue-700 mb-1\">Formelregning</h2>\n    <p class=\"text-gray-500 text-sm mb-4\">Velg en formel, fyll inn de kjente verdiene, og beregn den ukjente.</p>\n\n    <!-- FORMELKORT-GRID -->\n    <div id=\"formel-grid\" class=\"grid grid-cols-1 sm:grid-cols-2 gap-3 mb-6\">\n    </div>\n\n    <!-- KALKULATORPANEL -->\n    <div id=\"kalkulator-panel\" class=\"hidden\">\n      <hr class=\"my-4 border-blue-100\" />\n      <h3 id=\"kalk-tittel\" class=\"font-bold text-blue-800 text-lg mb-1\"></h3>\n      <p id=\"kalk-formel-vis\" class=\"font-mono text-blue-600 mb-3 text-base\"></p>\n      <p id=\"kalk-beskrivelse\" class=\"text-gray-600 text-sm mb-4\"></p>\n\n      <div id=\"kalk-inputs\" class=\"grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4\"></div>\n\n      <div class=\"mb-4\">\n        <label class=\"block text-sm font-medium text-gray-700 mb-1\">Variabel å beregne</label>\n        <select id=\"kalk-solve-for\" class=\"border border-gray-300 rounded-lg px-3 py-2 text-sm w-full sm:w-auto focus:outline-none focus:ring-2 focus:ring-blue-300\">\n        </select>\n      </div>\n\n      <button onclick=\"beregnFormel()\"\n        class=\"bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-2 rounded-lg shadow transition focus:outline-none focus:ring-2 focus:ring-blue-300\">\n        Beregn\n      </button>\n\n      <div id=\"kalk-resultat\" class=\"mt-4 hidden p-4 rounded-lg\"></div>\n    </div>\n  </div>\n\n  <!-- ============================================================ -->\n  <!-- TAB 3 – OMFORMING                                            -->\n  <!-- ============================================================ -->\n  <div id=\"panel-omforming\" class=\"bg-white rounded-b-lg shadow-sm p-6 hidden\">\n\n    <h2 class=\"text-xl font-bold text-blue-700 mb-1\">Omforming av formler</h2>\n    <p class=\"text-gray-500 text-sm mb-4\">Velg en formel og se hvordan den skrives om for å løse for en annen variabel.</p>\n\n    <!-- FORMELVELGER -->\n    <div class=\"mb-4\">\n      <label class=\"block text-sm font-medium text-gray-700 mb-1\">Velg formel</label>\n      <select id=\"omf-formel-select\" onchange=\"oppdaterOmforming()\"\n        class=\"border border-gray-300 rounded-lg px-3 py-2 text-sm w-full sm:w-auto focus:outline-none focus:ring-2 focus:ring-blue-300\">\n      </select>\n    </div>\n\n    <div id=\"omf-panel\" class=\"hidden\">\n      <p id=\"omf-original\" class=\"font-mono text-blue-700 text-base mb-3\"></p>\n\n      <div class=\"mb-4\">\n        <label class=\"block text-sm font-medium text-gray-700 mb-1\">Løs for variabel</label>\n        <div id=\"omf-var-buttons\" class=\"flex flex-wrap gap-2\"></div>\n      </div>\n\n      <div id=\"omf-resultat\" class=\"hidden\"></div>\n    </div>\n  </div>\n\n</div><!-- /max-w -->\n\n<!-- FOOTER -->\n<footer class=\"max-w-4xl mx-auto mt-8 px-4 pb-6 text-center text-xs text-gray-400\">\n  Matematikk 1P · LK20 · Sinus 1P kap. 7.1–7.3 ·\n  <a href=\"https://github.com/halisonworks/public-app-studio\" class=\"underline hover:text-gray-600\" target=\"_blank\" rel=\"noopener\">\n    Halison App Studio\n  </a>\n</footer>\n\n<script>\n/* ====================================================================\n   DATADEFINISJON – FORMLER\n   Hvert formel-objekt:\n     id, navn, kategori, formelTekst, beskrivelse, enheter\n     variabler: [{ id, label, enhet, beskrivelse }]\n     beregn: funksjon({ variabel: verdi, ... }, løsFor) → { verdi, uttrykk, steg[] }\n     omform: { varId: { rearranged, steg[] } }\n   ==================================================================== */\n\nconst FORMLER = [\n\n  /* ------------------------------------------------------------------ */\n  {\n    id: \"rektangel-areal\",\n    navn: \"Areal av rektangel\",\n    kategori: \"Geometri\",\n    formelTekst: \"A = l · b\",\n    beskrivelse: \"Arealet A av et rektangel er lik lengde l multiplisert med bredde b.\",\n    variabler: [\n      { id: \"A\", label: \"Areal (A)\", enhet: \"cm²\" },\n      { id: \"l\", label: \"Lengde (l)\", enhet: \"cm\" },\n      { id: \"b\", label: \"Bredde (b)\", enhet: \"cm\" },\n    ],\n    beregn(vals, løsFor) {\n      const { A, l, b } = vals;\n      if (løsFor === \"A\") {\n        const v = l * b;\n        return {\n          verdi: v,\n          uttrykk: `A = ${l} · ${b}`,\n          steg: [\n            `A = l · b`,\n            `A = ${l} · ${b}`,\n            `A = ${rund(v)} cm²`,\n          ],\n        };\n      }\n      if (løsFor === \"l\") {\n        const v = A / b;\n        return {\n          verdi: v,\n          uttrykk: `l = ${A} / ${b}`,\n          steg: [\n            `A = l · b   →   l = A / b`,\n            `l = ${A} / ${b}`,\n            `l = ${rund(v)} cm`,\n          ],\n        };\n      }\n      if (løsFor === \"b\") {\n        const v = A / l;\n        return {\n          verdi: v,\n          uttrykk: `b = ${A} / ${l}`,\n          steg: [\n            `A = l · b   →   b = A / l`,\n            `b = ${A} / ${l}`,\n            `b = ${rund(v)} cm`,\n          ],\n        };\n      }\n    },\n    omform: {\n      A: {\n        rearranged: \"A = l · b\",\n        steg: [\n          \"A = l · b  (utgangspunkt – allerede løst for A)\",\n        ],\n      },\n      l: {\n        rearranged: \"l = A / b\",\n        steg: [\n          \"A = l · b\",\n          \"Del begge sider på b:   A / b = l · b / b\",\n          \"l = A / b\",\n        ],\n      },\n      b: {\n        rearranged: \"b = A / l\",\n        steg: [\n          \"A = l · b\",\n          \"Del begge sider på l:   A / l = l · b / l\",\n          \"b = A / l\",\n        ],\n      },\n    },\n  },\n\n  /* ------------------------------------------------------------------ */\n  {\n    id: \"rektangel-omkrets\",\n    navn: \"Omkrets av rektangel\",\n    kategori: \"Geometri\",\n    formelTekst: \"O = 2·(l + b)\",\n    beskrivelse: \"Omkretsen O av et rektangel er summen av alle fire sider.\",\n    variabler: [\n      { id: \"O\", label: \"Omkrets (O)\", enhet: \"cm\" },\n      { id: \"l\", label: \"Lengde (l)\", enhet: \"cm\" },\n      { id: \"b\", label: \"Bredde (b)\", enhet: \"cm\" },\n    ],\n    beregn(vals, løsFor) {\n      const { O, l, b } = vals;\n      if (løsFor === \"O\") {\n        const v = 2 * (l + b);\n        return {\n          verdi: v,\n          uttrykk: `O = 2·(${l} + ${b})`,\n          steg: [\n            `O = 2·(l + b)`,\n            `O = 2·(${l} + ${b})`,\n            `O = 2·${l + b}`,\n            `O = ${rund(v)} cm`,\n          ],\n        };\n      }\n      if (løsFor === \"l\") {\n        const v = O / 2 - b;\n        return {\n          verdi: v,\n          uttrykk: `l = ${O}/2 − ${b}`,\n          steg: [\n            `O = 2·(l + b)   →   O/2 = l + b   →   l = O/2 − b`,\n            `l = ${O}/2 − ${b}`,\n            `l = ${O / 2} − ${b}`,\n            `l = ${rund(v)} cm`,\n          ],\n        };\n      }\n      if (løsFor === \"b\") {\n        const v = O / 2 - l;\n        return {\n          verdi: v,\n          uttrykk: `b = ${O}/2 − ${l}`,\n          steg: [\n            `O = 2·(l + b)   →   b = O/2 − l`,\n            `b = ${O}/2 − ${l}`,\n            `b = ${rund(v)} cm`,\n          ],\n        };\n      }\n    },\n    omform: {\n      O: {\n        rearranged: \"O = 2·(l + b)\",\n        steg: [\"O = 2·(l + b)  (utgangspunkt)\"],\n      },\n      l: {\n        rearranged: \"l = O/2 − b\",\n        steg: [\n          \"O = 2·(l + b)\",\n          \"Del begge sider på 2:   O/2 = l + b\",\n          \"Trekk fra b på begge sider:   O/2 − b = l\",\n          \"l = O/2 − b\",\n        ],\n      },\n      b: {\n        rearranged: \"b = O/2 − l\",\n        steg: [\n          \"O = 2·(l + b)\",\n          \"Del begge sider på 2:   O/2 = l + b\",\n          \"Trekk fra l på begge sider:   O/2 − l = b\",\n          \"b = O/2 − l\",\n        ],\n      },\n    },\n  },\n\n  /* ------------------------------------------------------------------ */\n  {\n    id: \"sirkel-areal\",\n    navn: \"Areal av sirkel\",\n    kategori: \"Geometri\",\n    formelTekst: \"A = π · r²\",\n    beskrivelse: \"Arealet A av en sirkel med radius r.\",\n    variabler: [\n      { id: \"A\", label: \"Areal (A)\", enhet: \"cm²\" },\n      { id: \"r\", label: \"Radius (r)\", enhet: \"cm\" },\n    ],\n    beregn(vals, løsFor) {\n      const { A, r } = vals;\n      if (løsFor === \"A\") {\n        const v = Math.PI * r * r;\n        return {\n          verdi: v,\n          uttrykk: `A = π · ${r}²`,\n          steg: [\n            `A = π · r²`,\n            `A = π · ${r}²`,\n            `A = π · ${r * r}`,\n            `A ≈ ${rund(v)} cm²`,\n          ],\n        };\n      }\n      if (løsFor === \"r\") {\n        const v = Math.sqrt(A / Math.PI);\n        return {\n          verdi: v,\n          uttrykk: `r = √(${A} / π)`,\n          steg: [\n            `A = π · r²   →   r² = A/π   →   r = √(A/π)`,\n            `r = √(${A} / π)`,\n            `r = √(${rund(A / Math.PI, 4)})`,\n            `r ≈ ${rund(v)} cm`,\n          ],\n        };\n      }\n    },\n    omform: {\n      A: {\n        rearranged: \"A = π · r²\",\n        steg: [\"A = π · r²  (utgangspunkt)\"],\n      },\n      r: {\n        rearranged: \"r = √(A / π)\",\n        steg: [\n          \"A = π · r²\",\n          \"Del begge sider på π:   A/π = r²\",\n          \"Ta kvadratroten av begge sider:   √(A/π) = r\",\n          \"r = √(A / π)\",\n        ],\n      },\n    },\n  },\n\n  /* ------------------------------------------------------------------ */\n  {\n    id: \"sirkel-omkrets\",\n    navn: \"Omkrets av sirkel\",\n    kategori: \"Geometri\",\n    formelTekst: \"O = 2 · π · r\",\n    beskrivelse: \"Omkretsen (periferien) av en sirkel med radius r.\",\n    variabler: [\n      { id: \"O\", label: \"Omkrets (O)\", enhet: \"cm\" },\n      { id: \"r\", label: \"Radius (r)\", enhet: \"cm\" },\n    ],\n    beregn(vals, løsFor) {\n      const { O, r } = vals;\n      if (løsFor === \"O\") {\n        const v = 2 * Math.PI * r;\n        return {\n          verdi: v,\n          uttrykk: `O = 2 · π · ${r}`,\n          steg: [\n            `O = 2 · π · r`,\n            `O = 2 · π · ${r}`,\n            `O ≈ ${rund(v)} cm`,\n          ],\n        };\n      }\n      if (løsFor === \"r\") {\n        const v = O / (2 * Math.PI);\n        return {\n          verdi: v,\n          uttrykk: `r = ${O} / (2π)`,\n          steg: [\n            `O = 2πr   →   r = O / (2π)`,\n            `r = ${O} / (2 · π)`,\n            `r ≈ ${rund(v)} cm`,\n          ],\n        };\n      }\n    },\n    omform: {\n      O: {\n        rearranged: \"O = 2 · π · r\",\n        steg: [\"O = 2πr  (utgangspunkt)\"],\n      },\n      r: {\n        rearranged: \"r = O / (2π)\",\n        steg: [\n          \"O = 2 · π · r\",\n          \"Del begge sider på 2π:   O / (2π) = r\",\n          \"r = O / (2π)\",\n        ],\n      },\n    },\n  },\n\n  /* ------------------------------------------------------------------ */\n  {\n    id: \"fart\",\n    navn: \"Strekning, fart og tid\",\n    kategori: \"Fysikk\",\n    formelTekst: \"s = v · t\",\n    beskrivelse: \"Tilbakelagt strekning s er lik fart v multiplisert med tid t.\",\n    variabler: [\n      { id: \"s\", label: \"Strekning (s)\", enhet: \"km\" },\n      { id: \"v\", label: \"Fart (v)\", enhet: \"km/t\" },\n      { id: \"t\", label: \"Tid (t)\", enhet: \"t\" },\n    ],\n    beregn(vals, løsFor) {\n      const { s, v, t } = vals;\n      if (løsFor === \"s\") {\n        const res = v * t;\n        return {\n          verdi: res,\n          uttrykk: `s = ${v} · ${t}`,\n          steg: [`s = v · t`, `s = ${v} · ${t}`, `s = ${rund(res)} km`],\n        };\n      }\n      if (løsFor === \"v\") {\n        const res = s / t;\n        return {\n          verdi: res,\n          uttrykk: `v = ${s} / ${t}`,\n          steg: [\n            `s = v · t   →   v = s / t`,\n            `v = ${s} / ${t}`,\n            `v = ${rund(res)} km/t`,\n          ],\n        };\n      }\n      if (løsFor === \"t\") {\n        const res = s / v;\n        return {\n          verdi: res,\n          uttrykk: `t = ${s} / ${v}`,\n          steg: [\n            `s = v · t   →   t = s / v`,\n            `t = ${s} / ${v}`,\n            `t = ${rund(res)} t`,\n          ],\n        };\n      }\n    },\n    omform: {\n      s: {\n        rearranged: \"s = v · t\",\n        steg: [\"s = v · t  (utgangspunkt)\"],\n      },\n      v: {\n        rearranged: \"v = s / t\",\n        steg: [\n          \"s = v · t\",\n          \"Del begge sider på t:   s/t = v\",\n          \"v = s / t\",\n        ],\n      },\n      t: {\n        rearranged: \"t = s / v\",\n        steg: [\n          \"s = v · t\",\n          \"Del begge sider på v:   s/v = t\",\n          \"t = s / v\",\n        ],\n      },\n    },\n  },\n\n  /* ------------------------------------------------------------------ */\n  {\n    id: \"ohm\",\n    navn: \"Ohms lov\",\n    kategori: \"Fysikk\",\n    formelTekst: \"U = R · I\",\n    beskrivelse: \"Spenning U (volt) er lik motstand R (ohm) multiplisert med strøm I (ampere).\",\n    variabler: [\n      { id: \"U\", label: \"Spenning (U)\", enhet: \"V\" },\n      { id: \"R\", label: \"Motstand (R)\", enhet: \"Ω\" },\n      { id: \"I\", label: \"Strøm (I)\", enhet: \"A\" },\n    ],\n    beregn(vals, løsFor) {\n      const { U, R, I } = vals;\n      if (løsFor === \"U\") {\n        const v = R * I;\n        return {\n          verdi: v,\n          uttrykk: `U = ${R} · ${I}`,\n          steg: [`U = R · I`, `U = ${R} · ${I}`, `U = ${rund(v)} V`],\n        };\n      }\n      if (løsFor === \"R\") {\n        const v = U / I;\n        return {\n          verdi: v,\n          uttrykk: `R = ${U} / ${I}`,\n          steg: [\n            `U = R · I   →   R = U / I`,\n            `R = ${U} / ${I}`,\n            `R = ${rund(v)} Ω`,\n          ],\n        };\n      }\n      if (løsFor === \"I\") {\n        const v = U / R;\n        return {\n          verdi: v,\n          uttrykk: `I = ${U} / ${R}`,\n          steg: [\n            `U = R · I   →   I = U / R`,\n            `I = ${U} / ${R}`,\n            `I = ${rund(v)} A`,\n          ],\n        };\n      }\n    },\n    omform: {\n      U: {\n        rearranged: \"U = R · I\",\n        steg: [\"U = R · I  (utgangspunkt)\"],\n      },\n      R: {\n        rearranged: \"R = U / I\",\n        steg: [\n          \"U = R · I\",\n          \"Del begge sider på I:   U/I = R\",\n          \"R = U / I\",\n        ],\n      },\n      I: {\n        rearranged: \"I = U / R\",\n        steg: [\n          \"U = R · I\",\n          \"Del begge sider på R:   U/R = I\",\n          \"I = U / R\",\n        ],\n      },\n    },\n  },\n\n  /* ------------------------------------------------------------------ */\n  {\n    id: \"effekt\",\n    navn: \"Effekt (elektrisitet)\",\n    kategori: \"Fysikk\",\n    formelTekst: \"P = U · I\",\n    beskrivelse: \"Elektrisk effekt P (watt) er spenning U (volt) ganget med strøm I (ampere).\",\n    variabler: [\n      { id: \"P\", label: \"Effekt (P)\", enhet: \"W\" },\n      { id: \"U\", label: \"Spenning (U)\", enhet: \"V\" },\n      { id: \"I\", label: \"Strøm (I)\", enhet: \"A\" },\n    ],\n    beregn(vals, løsFor) {\n      const { P, U, I } = vals;\n      if (løsFor === \"P\") {\n        const v = U * I;\n        return {\n          verdi: v,\n          uttrykk: `P = ${U} · ${I}`,\n          steg: [`P = U · I`, `P = ${U} · ${I}`, `P = ${rund(v)} W`],\n        };\n      }\n      if (løsFor === \"U\") {\n        const v = P / I;\n        return {\n          verdi: v,\n          uttrykk: `U = ${P} / ${I}`,\n          steg: [\n            `P = U · I   →   U = P / I`,\n            `U = ${P} / ${I}`,\n            `U = ${rund(v)} V`,\n          ],\n        };\n      }\n      if (løsFor === \"I\") {\n        const v = P / U;\n        return {\n          verdi: v,\n          uttrykk: `I = ${P} / ${U}`,\n          steg: [\n            `P = U · I   →   I = P / U`,\n            `I = ${P} / ${U}`,\n            `I = ${rund(v)} A`,\n          ],\n        };\n      }\n    },\n    omform: {\n      P: {\n        rearranged: \"P = U · I\",\n        steg: [\"P = U · I  (utgangspunkt)\"],\n      },\n      U: {\n        rearranged: \"U = P / I\",\n        steg: [\n          \"P = U · I\",\n          \"Del begge sider på I:   P/I = U\",\n          \"U = P / I\",\n        ],\n      },\n      I: {\n        rearranged: \"I = P / U\",\n        steg: [\n          \"P = U · I\",\n          \"Del begge sider på U:   P/U = I\",\n          \"I = P / U\",\n        ],\n      },\n    },\n  },\n\n  /* ------------------------------------------------------------------ */\n  {\n    id: \"temperatur\",\n    navn: \"Fahrenheit til Celsius\",\n    kategori: \"Hverdagsformler\",\n    formelTekst: \"C = (F − 32) · 5/9\",\n    beskrivelse: \"Omregning fra Fahrenheit F til Celsius C.\",\n    variabler: [\n      { id: \"C\", label: \"Celsius (C)\", enhet: \"°C\" },\n      { id: \"F\", label: \"Fahrenheit (F)\", enhet: \"°F\" },\n    ],\n    beregn(vals, løsFor) {\n      const { C, F } = vals;\n      if (løsFor === \"C\") {\n        const v = (F - 32) * 5 / 9;\n        return {\n          verdi: v,\n          uttrykk: `C = (${F} − 32) · 5/9`,\n          steg: [\n            `C = (F − 32) · 5/9`,\n            `C = (${F} − 32) · 5/9`,\n            `C = ${rund(F - 32)} · 5/9`,\n            `C = ${rund((F - 32) * 5 / 9)} °C`,\n          ],\n        };\n      }\n      if (løsFor === \"F\") {\n        const v = C * 9 / 5 + 32;\n        return {\n          verdi: v,\n          uttrykk: `F = ${C} · 9/5 + 32`,\n          steg: [\n            `C = (F − 32) · 5/9   →   F = C · 9/5 + 32`,\n            `F = ${C} · 9/5 + 32`,\n            `F = ${rund(C * 9 / 5)} + 32`,\n            `F = ${rund(v)} °F`,\n          ],\n        };\n      }\n    },\n    omform: {\n      C: {\n        rearranged: \"C = (F − 32) · 5/9\",\n        steg: [\"C = (F − 32) · 5/9  (utgangspunkt)\"],\n      },\n      F: {\n        rearranged: \"F = C · 9/5 + 32\",\n        steg: [\n          \"C = (F − 32) · 5/9\",\n          \"Gang begge sider med 9/5:   C · 9/5 = F − 32\",\n          \"Legg til 32 på begge sider:   C · 9/5 + 32 = F\",\n          \"F = C · 9/5 + 32\",\n        ],\n      },\n    },\n  },\n\n  /* ------------------------------------------------------------------ */\n  {\n    id: \"densitet\",\n    navn: \"Massetetthet (densitet)\",\n    kategori: \"Fysikk\",\n    formelTekst: \"ρ = m / V\",\n    beskrivelse: \"Massetetthet ρ (kg/m³) er masse m delt på volum V.\",\n    variabler: [\n      { id: \"rho\", label: \"Tetthet (ρ)\", enhet: \"kg/m³\" },\n      { id: \"m\", label: \"Masse (m)\", enhet: \"kg\" },\n      { id: \"V\", label: \"Volum (V)\", enhet: \"m³\" },\n    ],\n    beregn(vals, løsFor) {\n      const { rho, m, V } = vals;\n      if (løsFor === \"rho\") {\n        const v = m / V;\n        return {\n          verdi: v,\n          uttrykk: `ρ = ${m} / ${V}`,\n          steg: [`ρ = m / V`, `ρ = ${m} / ${V}`, `ρ = ${rund(v)} kg/m³`],\n        };\n      }\n      if (løsFor === \"m\") {\n        const v = rho * V;\n        return {\n          verdi: v,\n          uttrykk: `m = ${rho} · ${V}`,\n          steg: [\n            `ρ = m / V   →   m = ρ · V`,\n            `m = ${rho} · ${V}`,\n            `m = ${rund(v)} kg`,\n          ],\n        };\n      }\n      if (løsFor === \"V\") {\n        const v = m / rho;\n        return {\n          verdi: v,\n          uttrykk: `V = ${m} / ${rho}`,\n          steg: [\n            `ρ = m / V   →   V = m / ρ`,\n            `V = ${m} / ${rho}`,\n            `V = ${rund(v)} m³`,\n          ],\n        };\n      }\n    },\n    omform: {\n      rho: {\n        rearranged: \"ρ = m / V\",\n        steg: [\"ρ = m / V  (utgangspunkt)\"],\n      },\n      m: {\n        rearranged: \"m = ρ · V\",\n        steg: [\n          \"ρ = m / V\",\n          \"Gang begge sider med V:   ρ · V = m\",\n          \"m = ρ · V\",\n        ],\n      },\n      V: {\n        rearranged: \"V = m / ρ\",\n        steg: [\n          \"ρ = m / V\",\n          \"Gang begge sider med V:   ρ · V = m\",\n          \"Del begge sider på ρ:   V = m / ρ\",\n          \"V = m / ρ\",\n        ],\n      },\n    },\n  },\n\n  /* ------------------------------------------------------------------ */\n  {\n    id: \"prosentandel\",\n    navn: \"Prosentandel\",\n    kategori: \"Hverdagsformler\",\n    formelTekst: \"p = (D / H) · 100\",\n    beskrivelse: \"Prosentandelen p er lik delverdi D delt på helhet H, ganget med 100.\",\n    variabler: [\n      { id: \"p\", label: \"Prosent (p)\", enhet: \"%\" },\n      { id: \"D\", label: \"Delverdi (D)\", enhet: \"\" },\n      { id: \"H\", label: \"Helhet (H)\", enhet: \"\" },\n    ],\n    beregn(vals, løsFor) {\n      const { p, D, H } = vals;\n      if (løsFor === \"p\") {\n        const v = (D / H) * 100;\n        return {\n          verdi: v,\n          uttrykk: `p = (${D} / ${H}) · 100`,\n          steg: [\n            `p = (D / H) · 100`,\n            `p = (${D} / ${H}) · 100`,\n            `p = ${rund(D / H, 4)} · 100`,\n            `p = ${rund(v)} %`,\n          ],\n        };\n      }\n      if (løsFor === \"D\") {\n        const v = (p / 100) * H;\n        return {\n          verdi: v,\n          uttrykk: `D = (${p} / 100) · ${H}`,\n          steg: [\n            `p = (D / H) · 100   →   D = (p/100) · H`,\n            `D = (${p} / 100) · ${H}`,\n            `D = ${rund(p / 100, 4)} · ${H}`,\n            `D = ${rund(v)}`,\n          ],\n        };\n      }\n      if (løsFor === \"H\") {\n        const v = D / (p / 100);\n        return {\n          verdi: v,\n          uttrykk: `H = ${D} / (${p}/100)`,\n          steg: [\n            `p = (D / H) · 100   →   H = D / (p/100)`,\n            `H = ${D} / (${p}/100)`,\n            `H = ${D} / ${rund(p / 100, 4)}`,\n            `H = ${rund(v)}`,\n          ],\n        };\n      }\n    },\n    omform: {\n      p: {\n        rearranged: \"p = (D / H) · 100\",\n        steg: [\"p = (D / H) · 100  (utgangspunkt)\"],\n      },\n      D: {\n        rearranged: \"D = (p / 100) · H\",\n        steg: [\n          \"p = (D / H) · 100\",\n          \"Del begge sider på 100:   p/100 = D / H\",\n          \"Gang begge sider med H:   (p/100) · H = D\",\n          \"D = (p / 100) · H\",\n        ],\n      },\n      H: {\n        rearranged: \"H = D / (p / 100)\",\n        steg: [\n          \"p = (D / H) · 100\",\n          \"Del begge sider på 100:   p/100 = D / H\",\n          \"Gang begge sider med H:   (p/100) · H = D\",\n          \"Del begge sider på p/100:   H = D / (p/100)\",\n          \"H = D / (p / 100)\",\n        ],\n      },\n    },\n  },\n\n];\n\n/* ====================================================================\n   HJELPEFUNKSJONER\n   ==================================================================== */\n\nfunction rund(x, desimaler = 4) {\n  const faktor = Math.pow(10, desimaler);\n  return Math.round(x * faktor) / faktor;\n}\n\nfunction kategoriFarge(kat) {\n  const kart = {\n    \"Geometri\": \"bg-green-100 text-green-800\",\n    \"Fysikk\": \"bg-purple-100 text-purple-800\",\n    \"Hverdagsformler\": \"bg-orange-100 text-orange-800\",\n  };\n  return kart[kat] || \"bg-gray-100 text-gray-700\";\n}\n\n/* ====================================================================\n   TAB-NAVIGASJON\n   ==================================================================== */\n\nfunction visTab(navn) {\n  [\"forklaring\", \"regning\", \"omforming\"].forEach(t => {\n    document.getElementById(\"panel-\" + t).classList.add(\"hidden\");\n    document.getElementById(\"tab-\" + t).className = \"tab-inactive px-5 py-3 text-sm transition focus:outline-none\";\n  });\n  document.getElementById(\"panel-\" + navn).classList.remove(\"hidden\");\n  document.getElementById(\"tab-\" + navn).className = \"tab-active px-5 py-3 text-sm transition focus:outline-none\";\n}\n\n/* ====================================================================\n   FORMELREGNING – INITIALISERING\n   ==================================================================== */\n\nlet valgtFormelId = null;\n\nfunction byggFormelGrid() {\n  const grid = document.getElementById(\"formel-grid\");\n  grid.innerHTML = \"\";\n  FORMLER.forEach(f => {\n    const div = document.createElement(\"div\");\n    div.id = \"kort-\" + f.id;\n    div.className = \"formula-card border-2 border-gray-200 rounded-xl p-4 bg-white\";\n    div.onclick = () => velgFormel(f.id);\n    div.innerHTML = `\n      <span class=\"text-xs font-semibold px-2 py-0.5 rounded-full ${kategoriFarge(f.kategori)} mb-2 inline-block\">${f.kategori}</span>\n      <p class=\"font-bold text-gray-800 text-sm\">${f.navn}</p>\n      <p class=\"font-mono text-blue-600 text-base mt-1\">${f.formelTekst}</p>\n      <p class=\"text-gray-500 text-xs mt-1 leading-snug\">${f.beskrivelse}</p>\n    `;\n    grid.appendChild(div);\n  });\n}\n\nfunction velgFormel(id) {\n  // Fjern markering fra alle\n  FORMLER.forEach(f => {\n    const k = document.getElementById(\"kort-\" + f.id);\n    if (k) k.className = \"formula-card border-2 border-gray-200 rounded-xl p-4 bg-white\";\n  });\n\n  valgtFormelId = id;\n  const k = document.getElementById(\"kort-\" + id);\n  if (k) k.className = \"formula-card selected border-2 rounded-xl p-4\";\n\n  const f = FORMLER.find(x => x.id === id);\n  if (!f) return;\n\n  // Tittel og formel\n  document.getElementById(\"kalk-tittel\").textContent = f.navn;\n  document.getElementById(\"kalk-formel-vis\").textContent = f.formelTekst;\n  document.getElementById(\"kalk-beskrivelse\").textContent = f.beskrivelse;\n\n  // Inputs\n  const inputDiv = document.getElementById(\"kalk-inputs\");\n  inputDiv.innerHTML = \"\";\n  f.variabler.forEach(v => {\n    const wrap = document.createElement(\"div\");\n    wrap.innerHTML = `\n      <label class=\"block text-sm font-medium text-gray-700 mb-1\">${v.label}${v.enhet ? \" [\" + v.enhet + \"]\" : \"\"}</label>\n      <input type=\"number\" id=\"inp-${v.id}\" step=\"any\" placeholder=\"Skriv inn...\"\n        class=\"border border-gray-300 rounded-lg px-3 py-2 text-sm w-full focus:outline-none focus:ring-2 focus:ring-blue-300\" />\n    `;\n    inputDiv.appendChild(wrap);\n  });\n\n  // Løs-for-meny\n  const sel = document.getElementById(\"kalk-solve-for\");\n  sel.innerHTML = \"\";\n  f.variabler.forEach(v => {\n    const opt = document.createElement(\"option\");\n    opt.value = v.id;\n    opt.textContent = v.label;\n    sel.appendChild(opt);\n  });\n\n  // Skjul gammel resultat\n  const res = document.getElementById(\"kalk-resultat\");\n  res.classList.add(\"hidden\");\n  res.textContent = \"\";\n\n  document.getElementById(\"kalkulator-panel\").classList.remove(\"hidden\");\n  document.getElementById(\"kalk-resultat\").classList.add(\"hidden\");\n}\n\n/* ====================================================================\n   BEREGN-HANDLING\n   ==================================================================== */\n\nfunction beregnFormel() {\n  if (!valgtFormelId) return;\n  const f = FORMLER.find(x => x.id === valgtFormelId);\n  const løsFor = document.getElementById(\"kalk-solve-for\").value;\n  const resDiv = document.getElementById(\"kalk-resultat\");\n\n  // Les inn verdier\n  const vals = {};\n  let manglerInput = false;\n  f.variabler.forEach(v => {\n    const el = document.getElementById(\"inp-\" + v.id);\n    if (v.id === løsFor) {\n      vals[v.id] = null; // skal beregnes\n    } else {\n      const parsed = parseFloat(el.value.replace(\",\", \".\"));\n      if (isNaN(parsed)) {\n        manglerInput = true;\n      } else {\n        vals[v.id] = parsed;\n      }\n    }\n  });\n\n  if (manglerInput) {\n    resDiv.className = \"mt-4 p-4 rounded-lg error-box\";\n    resDiv.innerHTML = \"<strong>Feil:</strong> Fyll inn alle kjente verdier.\";\n    resDiv.classList.remove(\"hidden\");\n    return;\n  }\n\n  // Sjekk divisjon på null\n  try {\n    const svar = f.beregn(vals, løsFor);\n    if (svar === undefined || svar === null) throw new Error(\"Ugyldig beregning\");\n    if (!isFinite(svar.verdi)) throw new Error(\"Divisjon på null eller ugyldig operasjon.\");\n\n    const løsVar = f.variabler.find(v => v.id === løsFor);\n    resDiv.className = \"mt-4 p-4 rounded-lg result-box\";\n\n    const stegHtml = svar.steg.map(s =>\n      `<div class=\"step-line pl-3 py-1 my-1 font-mono text-sm text-gray-700\">${escHtml(s)}</div>`\n    ).join(\"\");\n\n    resDiv.innerHTML = `\n      <p class=\"font-semibold text-green-800 mb-2\">Løsning for ${løsVar.label}:</p>\n      ${stegHtml}\n      <p class=\"mt-3 text-lg font-bold text-green-900\">\n        ${løsVar.id} = ${rund(svar.verdi)} ${løsVar.enhet || \"\"}\n      </p>\n    `;\n    resDiv.classList.remove(\"hidden\");\n  } catch (e) {\n    resDiv.className = \"mt-4 p-4 rounded-lg error-box\";\n    resDiv.innerHTML = `<strong>Feil:</strong> ${escHtml(e.message)}`;\n    resDiv.classList.remove(\"hidden\");\n  }\n}\n\nfunction escHtml(str) {\n  return String(str)\n    .replace(/&/g, \"&amp;\")\n    .replace(/</g, \"&lt;\")\n    .replace(/>/g, \"&gt;\");\n}\n\n/* ====================================================================\n   OMFORMING – INITIALISERING OG INTERAKSJON\n   ==================================================================== */\n\nlet omfValgtVar = null;\nlet omfValgtFormelId = null;\n\nfunction byggOmformingSelect() {\n  const sel = document.getElementById(\"omf-formel-select\");\n  sel.innerHTML = \"\";\n  FORMLER.forEach(f => {\n    const opt = document.createElement(\"option\");\n    opt.value = f.id;\n    opt.textContent = `${f.navn}  (${f.formelTekst})`;\n    sel.appendChild(opt);\n  });\n}\n\nfunction oppdaterOmforming() {\n  const id = document.getElementById(\"omf-formel-select\").value;\n  omfValgtFormelId = id;\n  omfValgtVar = null;\n\n  const f = FORMLER.find(x => x.id === id);\n  if (!f) return;\n\n  document.getElementById(\"omf-original\").textContent = \"Originalformel: \" + f.formelTekst;\n\n  // Bygg variabelknapper\n  const btnDiv = document.getElementById(\"omf-var-buttons\");\n  btnDiv.innerHTML = \"\";\n  f.variabler.forEach(v => {\n    const btn = document.createElement(\"button\");\n    btn.id = \"omf-btn-\" + v.id;\n    btn.textContent = \"Løs for \" + v.id;\n    btn.title = v.label;\n    btn.onclick = () => velgOmformVar(v.id);\n    btn.className = \"px-4 py-2 rounded-lg text-sm font-semibold border-2 border-blue-300 text-blue-700 bg-white hover:bg-blue-50 transition focus:outline-none focus:ring-2 focus:ring-blue-300\";\n    btnDiv.appendChild(btn);\n  });\n\n  document.getElementById(\"omf-resultat\").classList.add(\"hidden\");\n  document.getElementById(\"omf-panel\").classList.remove(\"hidden\");\n}\n\nfunction velgOmformVar(varId) {\n  omfValgtVar = varId;\n  const f = FORMLER.find(x => x.id === omfValgtFormelId);\n  if (!f) return;\n\n  // Oppdater knappfarge\n  f.variabler.forEach(v => {\n    const btn = document.getElementById(\"omf-btn-\" + v.id);\n    if (!btn) return;\n    if (v.id === varId) {\n      btn.className = \"px-4 py-2 rounded-lg text-sm font-semibold border-2 border-blue-600 text-white bg-blue-600 transition focus:outline-none focus:ring-2 focus:ring-blue-400\";\n    } else {\n      btn.className = \"px-4 py-2 rounded-lg text-sm font-semibold border-2 border-blue-300 text-blue-700 bg-white hover:bg-blue-50 transition focus:outline-none focus:ring-2 focus:ring-blue-300\";\n    }\n  });\n\n  const omfData = f.omform[varId];\n  if (!omfData) return;\n\n  const stegHtml = omfData.steg.map((s, i) => `\n    <div class=\"flex items-start gap-2 mb-2\">\n      <span class=\"bg-blue-100 text-blue-700 rounded-full w-6 h-6 flex-shrink-0 flex items-center justify-center text-xs font-bold\">${i + 1}</span>\n      <span class=\"font-mono text-sm text-gray-800\">${escHtml(s)}</span>\n    </div>\n  `).join(\"\");\n\n  // Eksempelverdi-beregning\n  let eksempelHtml = \"\";\n  try {\n    const eksVerdier = {};\n    const eksEnheter = {};\n    const ersteVerdier = { A: 12, l: 4, b: 3, O: 20, r: 5, s: 150, v: 60, t: 2.5, U: 12, R: 4, I: 3, P: 60, rho: 1000, m: 8, V: 0.008, C: 37, F: 98.6, p: 25, D: 50, H: 200 };\n    f.variabler.forEach(v => {\n      eksEnheter[v.id] = v.enhet;\n      if (v.id !== varId) {\n        eksVerdier[v.id] = ersteVerdier[v.id] !== undefined ? ersteVerdier[v.id] : 10;\n      }\n    });\n    const svar = f.beregn(eksVerdier, varId);\n    if (svar && isFinite(svar.verdi)) {\n      const løsVar = f.variabler.find(v => v.id === varId);\n      const kjenteTekst = f.variabler\n        .filter(v => v.id !== varId)\n        .map(v => `${v.id} = ${eksVerdier[v.id]} ${v.enhet || \"\"}`)\n        .join(\", \");\n      eksempelHtml = `\n        <div class=\"mt-4 bg-yellow-50 border border-yellow-200 rounded-lg p-4\">\n          <p class=\"text-sm font-semibold text-yellow-800 mb-2\">Eksempel med tall</p>\n          <p class=\"text-xs text-gray-600 mb-2\">Gitt: ${escHtml(kjenteTekst)}</p>\n          ${svar.steg.map(s => `<div class=\"step-line pl-3 py-1 font-mono text-sm text-gray-700\">${escHtml(s)}</div>`).join(\"\")}\n          <p class=\"mt-2 font-bold text-yellow-900\">${løsVar.id} = ${rund(svar.verdi)} ${løsVar.enhet || \"\"}</p>\n        </div>\n      `;\n    }\n  } catch (_) { /* ignorer eksempelfeil */ }\n\n  const resDiv = document.getElementById(\"omf-resultat\");\n  resDiv.className = \"bg-blue-50 border border-blue-200 rounded-xl p-4 mt-2\";\n  resDiv.innerHTML = `\n    <p class=\"text-sm font-semibold text-blue-700 mb-1\">Omformet formel:</p>\n    <p class=\"font-mono text-blue-900 text-lg font-bold mb-3\">${escHtml(omfData.rearranged)}</p>\n    <p class=\"text-sm font-semibold text-gray-700 mb-2\">Fremgangsmåte (samme operasjon på begge sider):</p>\n    ${stegHtml}\n    ${eksempelHtml}\n  `;\n  resDiv.classList.remove(\"hidden\");\n}\n\n/* ====================================================================\n   INIT\n   ==================================================================== */\n\ndocument.addEventListener(\"DOMContentLoaded\", () => {\n  byggFormelGrid();\n  byggOmformingSelect();\n  // Vis første omforming automatisk\n  oppdaterOmforming();\n});\n</script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Formler",
    "windowTitle": "Formler",
    "bundleId": "com.halisonworks.formler1p",
    "iconPath": null
  },
  "categoryId": null,
  "source": "import",
  "createdAt": "2026-06-02T12:00:00.000Z",
  "updatedAt": "2026-06-02T12:00:00.000Z",
