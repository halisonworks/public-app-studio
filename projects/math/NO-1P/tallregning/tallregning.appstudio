{
  "schema": "app-studio/canvas@1",
  "id": "example-no1p-tallregning",
  "name": "tallregning.html",
  "code": "<!DOCTYPE html>\n<!--\n  Tallregning — Halison App Studio-eksempel\n\n  Interaktivt læremiddel for matematikk 1P (LK20): regnerekkefølge steg for steg\n  og overslagsregning.\n\n  Fra Halison App Studio sitt offentlige bibliotek:\n  https://github.com/halisonworks/public-app-studio\n\n  Tillatt bruk: personlig, pedagogisk og annen ikke-kommersiell bruk. Behold denne\n  headeren og kildelenken; ikke-kommersiell bruk. Utgitt under Halison App Studio\n  Examples License — se LICENSE-filen i repoet over.\n-->\n<html lang=\"no\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Tallregning – Matematikk 1P</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    .step-highlight { animation: pulse-bg 0.6s ease-in-out; }\n    @keyframes pulse-bg {\n      0%   { background-color: #fef9c3; }\n      50%  { background-color: #fde68a; }\n      100% { background-color: #fef9c3; }\n    }\n    .tab-active   { border-bottom: 3px solid #2563eb; color: #1d4ed8; font-weight: 700; }\n    .tab-inactive { border-bottom: 3px solid transparent; color: #6b7280; }\n    input[type=number]::-webkit-inner-spin-button,\n    input[type=number]::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }\n    input[type=number] { -moz-appearance: textfield; }\n  </style>\n</head>\n<body class=\"bg-gray-50 min-h-screen font-sans text-gray-800\">\n\n<!-- ===== TOPBAR ===== -->\n<header class=\"bg-blue-700 text-white shadow-md\">\n  <div class=\"max-w-3xl mx-auto px-4 py-4 flex items-center gap-3\">\n    <span class=\"text-3xl\">🔢</span>\n    <div>\n      <h1 class=\"text-xl font-bold leading-tight\">Tallregning</h1>\n      <p class=\"text-blue-200 text-sm\">Matematikk 1P · LK20 · Kap. 1.1–1.2</p>\n    </div>\n  </div>\n</header>\n\n<!-- ===== TABS ===== -->\n<div class=\"max-w-3xl mx-auto px-4 mt-4\">\n  <div class=\"flex border-b border-gray-200 gap-4\">\n    <button id=\"tab-btn-rekkefølge\"\n      class=\"py-2 px-3 text-sm tab-active transition-colors\"\n      onclick=\"switchTab('rekkefølge')\">\n      📐 Regnerekkefølge\n    </button>\n    <button id=\"tab-btn-overslag\"\n      class=\"py-2 px-3 text-sm tab-inactive transition-colors\"\n      onclick=\"switchTab('overslag')\">\n      📏 Overslagsregning\n    </button>\n  </div>\n</div>\n\n<!-- ===== TAB: REGNEREKKEFØLGE ===== -->\n<div id=\"tab-rekkefølge\" class=\"max-w-3xl mx-auto px-4 py-6 space-y-6\">\n\n  <!-- Teori-boks -->\n  <div class=\"bg-blue-50 border border-blue-200 rounded-xl p-5 space-y-3\">\n    <h2 class=\"font-bold text-blue-800 text-lg\">Hva er regnerekkefølge?</h2>\n    <p class=\"text-sm text-blue-900 leading-relaxed\">\n      Når et regnestykke inneholder flere operasjoner, bestemmer <strong>regnerekkefølgen</strong>\n      hvilken vi regner ut først. På norsk husker vi det slik:\n    </p>\n    <ol class=\"list-none space-y-2 text-sm\">\n      <li class=\"flex items-start gap-3\">\n        <span class=\"bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center font-bold shrink-0 text-xs\">1</span>\n        <span><strong>Parenteser</strong> — alltid først: <code class=\"bg-white px-1 rounded\">(2 + 3) × 4</code> → regn ut <code class=\"bg-white px-1 rounded\">2+3</code> first</span>\n      </li>\n      <li class=\"flex items-start gap-3\">\n        <span class=\"bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center font-bold shrink-0 text-xs\">2</span>\n        <span><strong>Potenser</strong> — deretter: <code class=\"bg-white px-1 rounded\">2^3</code> = 8</span>\n      </li>\n      <li class=\"flex items-start gap-3\">\n        <span class=\"bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center font-bold shrink-0 text-xs\">3</span>\n        <span><strong>Multiplikasjon og divisjon</strong> — fra venstre mot høyre</span>\n      </li>\n      <li class=\"flex items-start gap-3\">\n        <span class=\"bg-blue-600 text-white rounded-full w-6 h-6 flex items-center justify-center font-bold shrink-0 text-xs\">4</span>\n        <span><strong>Addisjon og subtraksjon</strong> — fra venstre mot høyre</span>\n      </li>\n    </ol>\n    <p class=\"text-xs text-blue-700 italic\">Huskeregel: <strong>P</strong>o<strong>P</strong>·<strong>M</strong>A — Parenteser, Potenser, Multiplikasjon/divisjon, Addisjon/subtraksjon</p>\n  </div>\n\n  <!-- Eksempel-knapper -->\n  <div>\n    <p class=\"text-sm font-semibold text-gray-600 mb-2\">Velg et eksempel:</p>\n    <div class=\"flex flex-wrap gap-2\">\n      <button onclick=\"loadExample('2 + 3 * 4')\"\n        class=\"bg-white border border-gray-300 rounded-lg px-3 py-1.5 text-sm hover:bg-blue-50 hover:border-blue-400 transition-colors\">\n        2 + 3 × 4\n      </button>\n      <button onclick=\"loadExample('(2 + 3) * 4')\"\n        class=\"bg-white border border-gray-300 rounded-lg px-3 py-1.5 text-sm hover:bg-blue-50 hover:border-blue-400 transition-colors\">\n        (2 + 3) × 4\n      </button>\n      <button onclick=\"loadExample('10 - 2^3 + 1')\"\n        class=\"bg-white border border-gray-300 rounded-lg px-3 py-1.5 text-sm hover:bg-blue-50 hover:border-blue-400 transition-colors\">\n        10 − 2³ + 1\n      </button>\n      <button onclick=\"loadExample('100 / 5 / 4')\"\n        class=\"bg-white border border-gray-300 rounded-lg px-3 py-1.5 text-sm hover:bg-blue-50 hover:border-blue-400 transition-colors\">\n        100 ÷ 5 ÷ 4\n      </button>\n      <button onclick=\"loadExample('3 + (2 * (4 - 1))^2')\"\n        class=\"bg-white border border-gray-300 rounded-lg px-3 py-1.5 text-sm hover:bg-blue-50 hover:border-blue-400 transition-colors\">\n        3 + (2 × (4−1))²\n      </button>\n      <button onclick=\"loadExample('8 / 2 * (2 + 2)')\"\n        class=\"bg-white border border-gray-300 rounded-lg px-3 py-1.5 text-sm hover:bg-blue-50 hover:border-blue-400 transition-colors\">\n        8 ÷ 2 × (2+2)\n      </button>\n    </div>\n  </div>\n\n  <!-- Input -->\n  <div class=\"bg-white border border-gray-200 rounded-xl p-5 space-y-4\">\n    <label class=\"block font-semibold text-gray-700\" for=\"expr-input\">\n      Skriv inn et regnestykke:\n    </label>\n    <p class=\"text-xs text-gray-500\">Bruk: <code>+</code> <code>-</code> <code>*</code> <code>/</code> <code>^</code> og parenteser. Eksempel: <code>3 + 2 * (4 - 1)^2</code></p>\n    <div class=\"flex gap-2\">\n      <input id=\"expr-input\" type=\"text\" placeholder=\"f.eks. 2 + 3 * 4\"\n        class=\"flex-1 border border-gray-300 rounded-lg px-3 py-2 text-base focus:outline-none focus:ring-2 focus:ring-blue-400\"\n        onkeydown=\"if(event.key==='Enter') solveExpression()\" />\n      <button onclick=\"solveExpression()\"\n        class=\"bg-blue-600 text-white px-5 py-2 rounded-lg hover:bg-blue-700 transition-colors font-semibold\">\n        Løs\n      </button>\n    </div>\n    <div id=\"expr-error\" class=\"text-red-600 text-sm hidden\"></div>\n  </div>\n\n  <!-- Steg-for-steg resultat -->\n  <div id=\"steps-container\" class=\"space-y-3 hidden\">\n    <h3 class=\"font-bold text-gray-700 text-base\">Steg-for-steg løsning:</h3>\n    <div id=\"steps-list\" class=\"space-y-2\"></div>\n    <div id=\"final-answer\" class=\"bg-green-50 border border-green-300 rounded-xl p-4 flex items-center gap-3\">\n      <span class=\"text-2xl\">✅</span>\n      <div>\n        <p class=\"text-xs text-green-700 font-semibold uppercase tracking-wide\">Svar</p>\n        <p id=\"final-value\" class=\"text-xl font-bold text-green-800\"></p>\n      </div>\n    </div>\n  </div>\n</div>\n\n<!-- ===== TAB: OVERSLAGSREGNING ===== -->\n<div id=\"tab-overslag\" class=\"max-w-3xl mx-auto px-4 py-6 space-y-6 hidden\">\n\n  <!-- Teori-boks -->\n  <div class=\"bg-amber-50 border border-amber-200 rounded-xl p-5 space-y-3\">\n    <h2 class=\"font-bold text-amber-800 text-lg\">Hva er overslagsregning?</h2>\n    <p class=\"text-sm text-amber-900 leading-relaxed\">\n      Et <strong>overslag</strong> er en rask, omtrentlig beregning. Vi runder av tallene\n      til nærmeste 10, 100 eller 1000 og regner deretter. Dette er nyttig for å sjekke\n      om svaret er fornuftig, eller for å beregne noe raskt i hodet.\n    </p>\n    <div class=\"bg-white rounded-lg p-3 space-y-1 text-sm\">\n      <p class=\"font-semibold text-amber-800\">Eksempel:</p>\n      <p>Nøyaktig: <strong>487 + 312 = 799</strong></p>\n      <p>Overslag: <strong>500 + 300 = 800</strong> (runder til nærmeste 100)</p>\n      <p class=\"text-xs text-amber-700\">Overslaget er 800 — svaret 799 er fornuftig!</p>\n    </div>\n    <div class=\"bg-white rounded-lg p-3 space-y-1 text-sm\">\n      <p class=\"font-semibold text-amber-800\">Avrundingsregler:</p>\n      <ul class=\"list-disc list-inside space-y-1 text-amber-900\">\n        <li>Siffer &lt; 5 → rund ned (behold)</li>\n        <li>Siffer ≥ 5 → rund opp</li>\n      </ul>\n    </div>\n  </div>\n\n  <!-- Interaktiv kalkulator -->\n  <div class=\"bg-white border border-gray-200 rounded-xl p-5 space-y-5\">\n    <h3 class=\"font-bold text-gray-700\">Lag ditt eget overslag</h3>\n\n    <!-- Tall 1 -->\n    <div class=\"grid grid-cols-2 gap-4\">\n      <div>\n        <label class=\"block text-sm font-medium text-gray-600 mb-1\">Tall 1</label>\n        <input id=\"ov-a\" type=\"number\" placeholder=\"f.eks. 487\"\n          class=\"w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-amber-400\"\n          oninput=\"updateOverslag()\" />\n      </div>\n      <div>\n        <label class=\"block text-sm font-medium text-gray-600 mb-1\">Tall 2</label>\n        <input id=\"ov-b\" type=\"number\" placeholder=\"f.eks. 312\"\n          class=\"w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-amber-400\"\n          oninput=\"updateOverslag()\" />\n      </div>\n    </div>\n\n    <!-- Operasjon -->\n    <div>\n      <label class=\"block text-sm font-medium text-gray-600 mb-2\">Operasjon</label>\n      <div class=\"flex gap-3 flex-wrap\">\n        <label class=\"flex items-center gap-1.5 cursor-pointer\">\n          <input type=\"radio\" name=\"ov-op\" value=\"+\" checked class=\"accent-amber-500\" onchange=\"updateOverslag()\" />\n          <span class=\"text-sm\">Addisjon (+)</span>\n        </label>\n        <label class=\"flex items-center gap-1.5 cursor-pointer\">\n          <input type=\"radio\" name=\"ov-op\" value=\"-\" class=\"accent-amber-500\" onchange=\"updateOverslag()\" />\n          <span class=\"text-sm\">Subtraksjon (−)</span>\n        </label>\n        <label class=\"flex items-center gap-1.5 cursor-pointer\">\n          <input type=\"radio\" name=\"ov-op\" value=\"*\" class=\"accent-amber-500\" onchange=\"updateOverslag()\" />\n          <span class=\"text-sm\">Multiplikasjon (×)</span>\n        </label>\n        <label class=\"flex items-center gap-1.5 cursor-pointer\">\n          <input type=\"radio\" name=\"ov-op\" value=\"/\" class=\"accent-amber-500\" onchange=\"updateOverslag()\" />\n          <span class=\"text-sm\">Divisjon (÷)</span>\n        </label>\n      </div>\n    </div>\n\n    <!-- Avrundingsnivå -->\n    <div>\n      <label class=\"block text-sm font-medium text-gray-600 mb-2\">Avrund til nærmeste:</label>\n      <div class=\"flex gap-3 flex-wrap\">\n        <label class=\"flex items-center gap-1.5 cursor-pointer\">\n          <input type=\"radio\" name=\"ov-round\" value=\"1\" class=\"accent-amber-500\" onchange=\"updateOverslag()\" />\n          <span class=\"text-sm\">1 (ingen avrunding)</span>\n        </label>\n        <label class=\"flex items-center gap-1.5 cursor-pointer\">\n          <input type=\"radio\" name=\"ov-round\" value=\"10\" checked class=\"accent-amber-500\" onchange=\"updateOverslag()\" />\n          <span class=\"text-sm\">10</span>\n        </label>\n        <label class=\"flex items-center gap-1.5 cursor-pointer\">\n          <input type=\"radio\" name=\"ov-round\" value=\"100\" class=\"accent-amber-500\" onchange=\"updateOverslag()\" />\n          <span class=\"text-sm\">100</span>\n        </label>\n        <label class=\"flex items-center gap-1.5 cursor-pointer\">\n          <input type=\"radio\" name=\"ov-round\" value=\"1000\" class=\"accent-amber-500\" onchange=\"updateOverslag()\" />\n          <span class=\"text-sm\">1000</span>\n        </label>\n      </div>\n    </div>\n\n    <!-- Resultat -->\n    <div id=\"ov-result\" class=\"hidden space-y-3\">\n      <div class=\"border-t border-gray-100 pt-4 space-y-3\">\n        <!-- Avrunding -->\n        <div class=\"bg-amber-50 rounded-lg p-4 space-y-2\">\n          <p class=\"text-sm font-semibold text-amber-800\">Steg 1: Avrund tallene</p>\n          <div class=\"flex items-center gap-2 flex-wrap text-sm\">\n            <span id=\"ov-a-val\" class=\"font-mono bg-white px-2 py-1 rounded border border-amber-200\"></span>\n            <span class=\"text-amber-600\">→ avrundet til nærmeste <span id=\"ov-round-label\"></span> →</span>\n            <span id=\"ov-a-rounded\" class=\"font-mono bg-amber-100 px-2 py-1 rounded border border-amber-300 font-bold\"></span>\n          </div>\n          <div class=\"flex items-center gap-2 flex-wrap text-sm\">\n            <span id=\"ov-b-val\" class=\"font-mono bg-white px-2 py-1 rounded border border-amber-200\"></span>\n            <span class=\"text-amber-600\">→ avrundet til nærmeste <span class=\"ov-round-label2\"></span> →</span>\n            <span id=\"ov-b-rounded\" class=\"font-mono bg-amber-100 px-2 py-1 rounded border border-amber-300 font-bold\"></span>\n          </div>\n        </div>\n        <!-- Overslag -->\n        <div class=\"bg-amber-100 rounded-lg p-4\">\n          <p class=\"text-sm font-semibold text-amber-800 mb-1\">Steg 2: Regn ut overslaget</p>\n          <p id=\"ov-estimate-calc\" class=\"text-base font-mono text-amber-900\"></p>\n          <p class=\"text-sm font-semibold text-amber-800 mt-2\">Overslag: <span id=\"ov-estimate-val\" class=\"text-lg font-bold\"></span></p>\n        </div>\n        <!-- Nøyaktig svar -->\n        <div class=\"bg-green-50 rounded-lg p-4 space-y-1\">\n          <p class=\"text-sm font-semibold text-green-800\">Nøyaktig svar:</p>\n          <p id=\"ov-exact-calc\" class=\"text-base font-mono text-green-900\"></p>\n          <p class=\"text-sm font-semibold text-green-800 mt-1\">Svar: <span id=\"ov-exact-val\" class=\"text-lg font-bold\"></span></p>\n        </div>\n        <!-- Sammenligning -->\n        <div id=\"ov-comparison\" class=\"bg-blue-50 border border-blue-200 rounded-lg p-4\">\n          <p class=\"text-sm font-semibold text-blue-800\">Sammenligning</p>\n          <p id=\"ov-comparison-text\" class=\"text-sm text-blue-700 mt-1\"></p>\n          <div class=\"mt-3 relative h-5 bg-gray-200 rounded-full overflow-hidden\">\n            <div id=\"ov-bar-exact\" class=\"absolute top-0 left-0 h-full bg-green-400 rounded-full transition-all duration-500\" style=\"width:0%\"></div>\n            <div id=\"ov-bar-overslag\" class=\"absolute top-0 left-0 h-full bg-amber-400 rounded-full opacity-70 transition-all duration-500\" style=\"width:0%\"></div>\n          </div>\n          <div class=\"flex justify-between text-xs text-gray-500 mt-1\">\n            <span class=\"flex items-center gap-1\"><span class=\"inline-block w-3 h-3 bg-green-400 rounded-full\"></span> Nøyaktig</span>\n            <span class=\"flex items-center gap-1\"><span class=\"inline-block w-3 h-3 bg-amber-400 rounded-full\"></span> Overslag</span>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Preset-eksempler -->\n    <div class=\"border-t border-gray-100 pt-4\">\n      <p class=\"text-xs font-semibold text-gray-500 mb-2 uppercase tracking-wide\">Prøv disse eksemplene:</p>\n      <div class=\"flex flex-wrap gap-2\">\n        <button onclick=\"loadOvExample(487, 312, '+', 100)\"\n          class=\"bg-gray-100 hover:bg-amber-100 border border-gray-200 hover:border-amber-300 text-xs px-3 py-1.5 rounded-lg transition-colors\">\n          487 + 312 (til 100)\n        </button>\n        <button onclick=\"loadOvExample(2360, 880, '-', 100)\"\n          class=\"bg-gray-100 hover:bg-amber-100 border border-gray-200 hover:border-amber-300 text-xs px-3 py-1.5 rounded-lg transition-colors\">\n          2360 − 880 (til 100)\n        </button>\n        <button onclick=\"loadOvExample(48, 21, '*', 10)\"\n          class=\"bg-gray-100 hover:bg-amber-100 border border-gray-200 hover:border-amber-300 text-xs px-3 py-1.5 rounded-lg transition-colors\">\n          48 × 21 (til 10)\n        </button>\n        <button onclick=\"loadOvExample(593, 29, '/', 10)\"\n          class=\"bg-gray-100 hover:bg-amber-100 border border-gray-200 hover:border-amber-300 text-xs px-3 py-1.5 rounded-lg transition-colors\">\n          593 ÷ 29 (til 10)\n        </button>\n        <button onclick=\"loadOvExample(7845, 3210, '+', 1000)\"\n          class=\"bg-gray-100 hover:bg-amber-100 border border-gray-200 hover:border-amber-300 text-xs px-3 py-1.5 rounded-lg transition-colors\">\n          7845 + 3210 (til 1000)\n        </button>\n      </div>\n    </div>\n  </div>\n</div>\n\n<!-- ===== FOOTER ===== -->\n<footer class=\"max-w-3xl mx-auto px-4 py-6 text-center text-xs text-gray-400 border-t border-gray-200 mt-8\">\n  Halison App Studio · Matematikk 1P LK20 ·\n  <a href=\"https://github.com/halisonworks/public-app-studio\" class=\"underline hover:text-blue-500\" target=\"_blank\">GitHub</a>\n</footer>\n\n<script>\n// =====================================================================\n// UTILITY: formatNumber (avoids floating point display issues)\n// =====================================================================\nfunction fmt(n) {\n  if (!isFinite(n)) return String(n);\n  // Round to 10 significant decimal places to suppress floating-point noise\n  let s = parseFloat(n.toPrecision(10));\n  // Display as integer if whole number\n  if (Number.isInteger(s)) return String(s);\n  // Otherwise show up to 6 decimals, trimming trailing zeros\n  return parseFloat(s.toFixed(6)).toString();\n}\n\nfunction opSymbol(op) {\n  return op === '*' ? '×' : op === '/' ? '÷' : op;\n}\n\n// =====================================================================\n// TABS\n// =====================================================================\nfunction switchTab(tab) {\n  document.getElementById('tab-rekkefølge').classList.toggle('hidden', tab !== 'rekkefølge');\n  document.getElementById('tab-overslag').classList.toggle('hidden', tab !== 'overslag');\n  document.getElementById('tab-btn-rekkefølge').className =\n    'py-2 px-3 text-sm transition-colors ' + (tab === 'rekkefølge' ? 'tab-active' : 'tab-inactive');\n  document.getElementById('tab-btn-overslag').className =\n    'py-2 px-3 text-sm transition-colors ' + (tab === 'overslag' ? 'tab-active' : 'tab-inactive');\n}\n\nfunction loadExample(expr) {\n  document.getElementById('expr-input').value = expr;\n  solveExpression();\n}\n\n// =====================================================================\n// SAFE EXPRESSION PARSER & EVALUATOR\n// Returns { value, steps }\n// steps: [{ before, opDesc, after, reason }]\n// =====================================================================\n\n// --- Tokenizer ---\nfunction tokenize(src) {\n  let tokens = [];\n  let i = 0;\n  const s = src.trim();\n  while (i < s.length) {\n    if (s[i] === ' ') { i++; continue; }\n    // Numbers (including decimals)\n    if (/[0-9.]/.test(s[i])) {\n      let num = '';\n      while (i < s.length && /[0-9.]/.test(s[i])) num += s[i++];\n      if (isNaN(parseFloat(num))) throw new Error('Ugyldig tall: ' + num);\n      tokens.push({ type: 'NUM', val: parseFloat(num) });\n      continue;\n    }\n    if ('+-*/^()'.includes(s[i])) {\n      tokens.push({ type: 'OP', val: s[i] });\n      i++;\n      continue;\n    }\n    throw new Error('Ukjent tegn: \"' + s[i] + '\"');\n  }\n  return tokens;\n}\n\n// --- Recursive Descent Parser -> AST ---\n// Grammar:\n//   expr   = term (('+' | '-') term)*\n//   term   = power (('*' | '/') power)*\n//   power  = unary ('^' unary)*      (right-associative)\n//   unary  = '-' unary | primary\n//   primary= NUM | '(' expr ')'\n\nfunction parse(tokens) {\n  let pos = 0;\n\n  function peek() { return tokens[pos]; }\n  function consume(expected) {\n    let t = tokens[pos++];\n    if (expected && (!t || t.val !== expected))\n      throw new Error('Forventet \"' + expected + '\"');\n    return t;\n  }\n\n  function parseExpr() {\n    let node = parseTerm();\n    while (peek() && (peek().val === '+' || peek().val === '-')) {\n      let op = tokens[pos++].val;\n      let right = parseTerm();\n      node = { type: 'BIN', op, left: node, right };\n    }\n    return node;\n  }\n\n  function parseTerm() {\n    let node = parsePower();\n    while (peek() && (peek().val === '*' || peek().val === '/')) {\n      let op = tokens[pos++].val;\n      let right = parsePower();\n      node = { type: 'BIN', op, left: node, right };\n    }\n    return node;\n  }\n\n  function parsePower() {\n    let base = parseUnary();\n    if (peek() && peek().val === '^') {\n      pos++;\n      let exp = parsePower(); // right-associative\n      return { type: 'BIN', op: '^', left: base, right: exp };\n    }\n    return base;\n  }\n\n  function parseUnary() {\n    if (peek() && peek().val === '-') {\n      pos++;\n      let operand = parseUnary();\n      return { type: 'NEG', operand };\n    }\n    return parsePrimary();\n  }\n\n  function parsePrimary() {\n    let t = peek();\n    if (!t) throw new Error('Uventet slutt på uttrykk');\n    if (t.type === 'NUM') { pos++; return { type: 'NUM', val: t.val }; }\n    if (t.val === '(') {\n      pos++;\n      let inner = parseExpr();\n      consume(')');\n      return { type: 'PAREN', inner };\n    }\n    throw new Error('Uventet tegn: \"' + t.val + '\"');\n  }\n\n  let ast = parseExpr();\n  if (pos < tokens.length) throw new Error('Uventet tegn: \"' + tokens[pos].val + '\"');\n  return ast;\n}\n\n// --- AST -> string representation ---\nfunction astToString(node, parentPrec) {\n  if (node.type === 'NUM') return fmt(node.val);\n  if (node.type === 'NEG') return '(-' + astToString(node.operand, 100) + ')';\n  if (node.type === 'PAREN') return '(' + astToString(node.inner, 0) + ')';\n  if (node.type === 'BIN') {\n    const prec = { '+': 1, '-': 1, '*': 2, '/': 2, '^': 3 };\n    let left = astToString(node.left, prec[node.op]);\n    let right = astToString(node.right, prec[node.op] + (node.op === '^' ? 0 : 1));\n    let sym = opSymbol(node.op);\n    // Add parens if needed for display\n    let str = left + ' ' + sym + ' ' + right;\n    if (parentPrec && prec[node.op] < parentPrec) str = '(' + str + ')';\n    return str;\n  }\n  return '?';\n}\n\n// --- Evaluate AST and collect steps ---\n// Returns { value, steps }\n// Each step has { expression (string), opDesc (string), result }\nfunction evalASTWithSteps(ast) {\n  let steps = [];\n\n  // We'll do a step-by-step approach: find leftmost-innermost reducible node,\n  // reduce it, record the step, repeat.\n  // Strategy: clone AST, repeatedly reduce one node at a time.\n\n  function cloneAST(node) {\n    if (!node) return node;\n    if (node.type === 'NUM') return { type: 'NUM', val: node.val };\n    if (node.type === 'NEG') return { type: 'NEG', operand: cloneAST(node.operand) };\n    if (node.type === 'PAREN') return { type: 'PAREN', inner: cloneAST(node.inner) };\n    if (node.type === 'BIN') return { type: 'BIN', op: node.op, left: cloneAST(node.left), right: cloneAST(node.right) };\n  }\n\n  // priority: PAREN > ^ > * / > + -\n  // Returns priority level of a node (for step ordering)\n  function opPriority(op) {\n    if (op === '^') return 3;\n    if (op === '*' || op === '/') return 2;\n    return 1; // + -\n  }\n\n  // Find the highest-priority reducible node\n  // \"Reducible\" = BIN or NEG where both children are NUM (or NEG of NUM)\n  // Also PAREN wrapping a NUM.\n  // Returns null if nothing to reduce.\n  function findReducible(node) {\n    // Deepest-first (innermost), highest-priority\n    if (!node) return null;\n\n    // First, recurse to find deeper reducible nodes\n    if (node.type === 'PAREN') {\n      // If inner is a simple number, this paren can be stripped\n      if (node.inner.type === 'NUM') return node;\n      // Otherwise reduce inside first\n      return findReducible(node.inner) || node;\n    }\n    if (node.type === 'NEG') {\n      if (node.operand.type === 'NUM') return node;\n      return findReducible(node.operand) || null;\n    }\n    if (node.type === 'BIN') {\n      // Try children first\n      let lr = findReducible(node.left);\n      let rr = findReducible(node.right);\n      if (lr || rr) {\n        // Return the one with higher op priority (deeper first among equals)\n        if (!lr) return rr;\n        if (!rr) return lr;\n        // Prefer left\n        return lr;\n      }\n      // Both children are NUM? Then this node is reducible.\n      if (isNumericLeaf(node.left) && isNumericLeaf(node.right)) return node;\n      return null;\n    }\n    return null;\n  }\n\n  function isNumericLeaf(node) {\n    return node.type === 'NUM';\n  }\n\n  // Find and reduce the highest-priority, innermost node in the full AST\n  // Uses a priority queue approach: collect all currently-reducible nodes,\n  // pick the one with highest priority (paren > ^ > *,/ > +,-)\n\n  function collectReducible(node, list) {\n    if (!node) return;\n    if (node.type === 'NUM') return;\n    if (node.type === 'PAREN') {\n      if (node.inner.type === 'NUM') { list.push(node); return; }\n      collectReducible(node.inner, list);\n      return;\n    }\n    if (node.type === 'NEG') {\n      if (node.operand.type === 'NUM') { list.push(node); return; }\n      collectReducible(node.operand, list);\n      return;\n    }\n    if (node.type === 'BIN') {\n      // Recurse into children first (innermost first)\n      let childFound = false;\n      let ll = []; collectReducible(node.left, ll);\n      let rl = []; collectReducible(node.right, rl);\n      if (ll.length || rl.length) {\n        ll.forEach(x => list.push(x));\n        rl.forEach(x => list.push(x));\n        return;\n      }\n      // No reducible children — are both children NUM?\n      if (node.left.type === 'NUM' && node.right.type === 'NUM') {\n        list.push(node);\n      }\n    }\n  }\n\n  function nodePriority(node) {\n    if (node.type === 'PAREN') return 10;\n    if (node.type === 'NEG') return 9;\n    if (node.type === 'BIN') return opPriority(node.op);\n    return 0;\n  }\n\n  // Replace a specific node (by reference) in the tree with a NUM node\n  function replaceNode(root, target, replacement) {\n    if (root === target) return replacement;\n    if (!root || root.type === 'NUM') return root;\n    if (root.type === 'PAREN') {\n      return Object.assign({}, root, { inner: replaceNode(root.inner, target, replacement) });\n    }\n    if (root.type === 'NEG') {\n      return Object.assign({}, root, { operand: replaceNode(root.operand, target, replacement) });\n    }\n    if (root.type === 'BIN') {\n      return Object.assign({}, root, {\n        left: replaceNode(root.left, target, replacement),\n        right: replaceNode(root.right, target, replacement)\n      });\n    }\n    return root;\n  }\n\n  function evalNode(node) {\n    if (node.type === 'NUM') return node.val;\n    if (node.type === 'PAREN') return evalNode(node.inner);\n    if (node.type === 'NEG') return -evalNode(node.operand);\n    if (node.type === 'BIN') {\n      let l = evalNode(node.left);\n      let r = evalNode(node.right);\n      if (node.op === '+') return l + r;\n      if (node.op === '-') return l - r;\n      if (node.op === '*') return l * r;\n      if (node.op === '/') {\n        if (r === 0) throw new Error('Divisjon med null er ikke tillatt');\n        return l / r;\n      }\n      if (node.op === '^') return Math.pow(l, r);\n    }\n    throw new Error('Ukjent nodetype');\n  }\n\n  function stepDescription(node) {\n    if (node.type === 'PAREN') return 'Fjern parentesene rundt ' + fmt(node.inner.val);\n    if (node.type === 'NEG') return 'Negasjon: −' + fmt(node.operand.val);\n    if (node.type === 'BIN') {\n      let l = fmt(node.left.val), r = fmt(node.right.val), sym = opSymbol(node.op);\n      let reasonMap = {\n        '+': 'Addisjon (lavest prioritet, venstre→høyre)',\n        '-': 'Subtraksjon (lavest prioritet, venstre→høyre)',\n        '*': 'Multiplikasjon (høyere prioritet enn + og −)',\n        '/': 'Divisjon (høyere prioritet enn + og −)',\n        '^': 'Potens (nest høyest prioritet)'\n      };\n      return `${l} ${sym} ${r} = ${fmt(evalNode(node))} — ${reasonMap[node.op]}`;\n    }\n    return '?';\n  }\n\n  let current = cloneAST(ast);\n  let maxSteps = 50;\n\n  while (maxSteps-- > 0) {\n    if (current.type === 'NUM') break;\n\n    let reducibles = [];\n    collectReducible(current, reducibles);\n    if (reducibles.length === 0) break;\n\n    // Pick highest priority\n    reducibles.sort((a, b) => nodePriority(b) - nodePriority(a));\n    let target = reducibles[0];\n\n    let before = astToString(current, 0);\n    let val = evalNode(target);\n    let desc = stepDescription(target);\n    let replacement = { type: 'NUM', val };\n\n    current = replaceNode(current, target, replacement);\n    let after = astToString(current, 0);\n\n    steps.push({ before, desc, after, result: val });\n  }\n\n  return { value: evalNode(ast), steps };\n}\n\n// =====================================================================\n// REGNEREKKEFØLGE — Solve button handler\n// =====================================================================\nfunction solveExpression() {\n  const input = document.getElementById('expr-input').value.trim();\n  const errorEl = document.getElementById('expr-error');\n  const container = document.getElementById('steps-container');\n  const stepsList = document.getElementById('steps-list');\n  const finalVal = document.getElementById('final-value');\n\n  errorEl.classList.add('hidden');\n  container.classList.add('hidden');\n  stepsList.innerHTML = '';\n\n  if (!input) {\n    errorEl.textContent = 'Skriv inn et regnestykke først.';\n    errorEl.classList.remove('hidden');\n    return;\n  }\n\n  try {\n    let tokens = tokenize(input);\n    let ast = parse(tokens);\n    let { value, steps } = evalASTWithSteps(ast);\n\n    if (steps.length === 0) {\n      // Already a single number\n      steps = [{ before: input, desc: 'Regnestykket er allerede et tall.', after: fmt(value), result: value }];\n    }\n\n    steps.forEach((step, idx) => {\n      let el = document.createElement('div');\n      el.className = 'bg-white border border-gray-200 rounded-lg p-3 space-y-1 step-highlight';\n      el.innerHTML = `\n        <div class=\"flex items-start gap-2\">\n          <span class=\"bg-blue-600 text-white text-xs font-bold rounded-full w-5 h-5 flex items-center justify-center shrink-0 mt-0.5\">${idx + 1}</span>\n          <div class=\"space-y-1 min-w-0\">\n            <p class=\"text-xs font-mono text-gray-500 break-all\">${escHtml(step.before)}</p>\n            <p class=\"text-xs text-blue-700 font-semibold\">${escHtml(step.desc)}</p>\n            <p class=\"text-sm font-mono font-bold text-gray-800 break-all\">= ${escHtml(step.after)}</p>\n          </div>\n        </div>\n      `;\n      stepsList.appendChild(el);\n    });\n\n    finalVal.textContent = fmt(value);\n    container.classList.remove('hidden');\n\n  } catch (e) {\n    errorEl.textContent = 'Feil: ' + e.message;\n    errorEl.classList.remove('hidden');\n  }\n}\n\nfunction escHtml(s) {\n  return String(s)\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .replace(/\"/g, '&quot;');\n}\n\n// =====================================================================\n// OVERSLAGSREGNING\n// =====================================================================\nfunction roundTo(n, step) {\n  if (step <= 1) return n;\n  return Math.round(n / step) * step;\n}\n\nfunction getOvOp() {\n  return document.querySelector('input[name=\"ov-op\"]:checked').value;\n}\n\nfunction getOvRound() {\n  return parseInt(document.querySelector('input[name=\"ov-round\"]:checked').value);\n}\n\nfunction applyOp(a, b, op) {\n  if (op === '+') return a + b;\n  if (op === '-') return a - b;\n  if (op === '*') return a * b;\n  if (op === '/') {\n    if (b === 0) return NaN;\n    return a / b;\n  }\n  return NaN;\n}\n\nfunction updateOverslag() {\n  const aStr = document.getElementById('ov-a').value;\n  const bStr = document.getElementById('ov-b').value;\n  const resultEl = document.getElementById('ov-result');\n\n  if (aStr === '' || bStr === '') { resultEl.classList.add('hidden'); return; }\n\n  const a = parseFloat(aStr);\n  const b = parseFloat(bStr);\n  if (isNaN(a) || isNaN(b)) { resultEl.classList.add('hidden'); return; }\n\n  const op = getOvOp();\n  const roundStep = getOvRound();\n\n  if (op === '/' && b === 0) { resultEl.classList.add('hidden'); return; }\n\n  const aR = roundTo(a, roundStep);\n  const bR = roundTo(b, roundStep);\n  const estimate = applyOp(aR, bR, op);\n  const exact = applyOp(a, b, op);\n\n  document.getElementById('ov-a-val').textContent = fmt(a);\n  document.getElementById('ov-b-val').textContent = fmt(b);\n  document.getElementById('ov-a-rounded').textContent = fmt(aR);\n  document.getElementById('ov-b-rounded').textContent = fmt(bR);\n  document.getElementById('ov-round-label').textContent = roundStep;\n  // Update all .ov-round-label2 spans\n  document.querySelectorAll('.ov-round-label2').forEach(el => el.textContent = roundStep);\n\n  const sym = opSymbol(op);\n  document.getElementById('ov-estimate-calc').textContent = `${fmt(aR)} ${sym} ${fmt(bR)} = ${fmt(estimate)}`;\n  document.getElementById('ov-estimate-val').textContent = fmt(estimate);\n  document.getElementById('ov-exact-calc').textContent = `${fmt(a)} ${sym} ${fmt(b)} = ${fmt(exact)}`;\n  document.getElementById('ov-exact-val').textContent = fmt(exact);\n\n  // Sammenligning\n  const diff = Math.abs(estimate - exact);\n  const pct = exact !== 0 ? (diff / Math.abs(exact) * 100) : 0;\n  let compText = '';\n  if (diff === 0) {\n    compText = 'Overslaget er nøyaktig likt det eksakte svaret! 🎯';\n  } else {\n    compText = `Overslaget (${fmt(estimate)}) avviker ${fmt(parseFloat(diff.toPrecision(4)))} fra det nøyaktige svaret (${fmt(exact)}) — det er ${parseFloat(pct.toPrecision(3))} % avvik.`;\n    if (pct < 5) compText += ' Veldig godt overslag!';\n    else if (pct < 15) compText += ' Greit overslag.';\n    else compText += ' Stort avvik — prøv å avrunde til et mindre tall.';\n  }\n  document.getElementById('ov-comparison-text').textContent = compText;\n\n  // Bar chart\n  const maxVal = Math.max(Math.abs(exact), Math.abs(estimate));\n  if (maxVal > 0) {\n    document.getElementById('ov-bar-exact').style.width = (Math.abs(exact) / maxVal * 100) + '%';\n    document.getElementById('ov-bar-overslag').style.width = (Math.abs(estimate) / maxVal * 100) + '%';\n  }\n\n  resultEl.classList.remove('hidden');\n}\n\nfunction loadOvExample(a, b, op, round) {\n  document.getElementById('ov-a').value = a;\n  document.getElementById('ov-b').value = b;\n  document.querySelector(`input[name=\"ov-op\"][value=\"${op}\"]`).checked = true;\n  document.querySelector(`input[name=\"ov-round\"][value=\"${round}\"]`).checked = true;\n  updateOverslag();\n}\n\n// =====================================================================\n// Init\n// =====================================================================\nwindow.addEventListener('DOMContentLoaded', function() {\n  // Load a default example on start\n  loadExample('2 + 3 * 4');\n});\n</script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Tallregning",
    "windowTitle": "Tallregning",
    "bundleId": "com.halisonworks.tallregning",
    "iconPath": null
  },
  "categoryId": null,
