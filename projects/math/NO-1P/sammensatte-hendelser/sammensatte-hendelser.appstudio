{
  "schema": "app-studio/canvas@1",
  "id": "example-no1p-sammensatte-hendelser",
  "name": "sammensatte-hendelser.html",
  "code": "<!DOCTYPE html>\n<!--\n  Sammensatte hendelser — Halison App Studio-eksempel\n\n  Interaktivt læremiddel for matematikk 1P (LK20): multiplikasjonsprinsippet,\n  uavhengige og avhengige hendinger, og sannsynlighetstre.\n\n  Fra Halison App Studio sitt offentlige bibliotek:\n  https://github.com/halisonworks/public-app-studio\n\n  Tillatt bruk: personlig, pedagogisk og annen ikke-kommersiell bruk. Behold denne\n  headeren og kildelenken; ikke-kommersiell bruk. Utgitt under Halison App Studio\n  Examples License — se LICENSE-filen i repoet over.\n-->\n<html lang=\"no\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Sammensatte hendelser – Matematikk 1P</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Segoe UI', system-ui, sans-serif; }\n    .tab-btn.active { background-color: #1d4ed8; color: white; }\n    .tab-btn { transition: background-color 0.2s, color 0.2s; }\n    .section { display: none; }\n    .section.active { display: block; }\n    .fraction { display: inline-flex; flex-direction: column; align-items: center; vertical-align: middle; margin: 0 2px; }\n    .fraction .num { border-bottom: 1.5px solid currentColor; padding: 0 3px; line-height: 1.2; }\n    .fraction .den { padding: 0 3px; line-height: 1.2; }\n    .tree-path { stroke: #64748b; stroke-width: 2; fill: none; }\n    .tree-path.highlight { stroke: #2563eb; stroke-width: 2.5; }\n    .tree-node { fill: #1d4ed8; }\n    .tree-leaf { fill: #16a34a; }\n    .tree-leaf.red { fill: #dc2626; }\n    .answer-box { min-height: 2.5rem; }\n    .step { border-left: 3px solid #3b82f6; padding-left: 0.75rem; margin-bottom: 0.5rem; }\n    .correct { background-color: #dcfce7; border-color: #16a34a; }\n    .wrong { background-color: #fee2e2; border-color: #dc2626; }\n    input[type=number]::-webkit-inner-spin-button,\n    input[type=number]::-webkit-outer-spin-button { opacity: 1; }\n    .quiz-feedback { min-height: 1.5rem; }\n  </style>\n</head>\n<body class=\"bg-gray-50 text-gray-800 min-h-screen\">\n\n<!-- Header -->\n<header class=\"bg-blue-800 text-white py-4 px-4 shadow-md\">\n  <div class=\"max-w-4xl mx-auto\">\n    <div class=\"flex flex-wrap items-center justify-between gap-2\">\n      <div>\n        <h1 class=\"text-2xl font-bold\">Sammensatte hendelser</h1>\n        <p class=\"text-blue-200 text-sm mt-0.5\">Matematikk 1P · LK20 · Sinus kap. 9.3–9.6</p>\n      </div>\n      <span class=\"bg-blue-600 text-xs font-semibold px-3 py-1 rounded-full\">Sannsynlighet</span>\n    </div>\n  </div>\n</header>\n\n<!-- Navigation tabs -->\n<nav class=\"bg-white shadow sticky top-0 z-10\">\n  <div class=\"max-w-4xl mx-auto px-4 flex overflow-x-auto gap-1 py-2\">\n    <button class=\"tab-btn active rounded px-4 py-2 text-sm font-medium whitespace-nowrap\" onclick=\"showTab('komplement')\">1 · Komplement</button>\n    <button class=\"tab-btn rounded px-4 py-2 text-sm font-medium whitespace-nowrap bg-gray-100 text-gray-700 hover:bg-gray-200\" onclick=\"showTab('multiprinsipp')\">2 · Multiplikasjonsprinsippet</button>\n    <button class=\"tab-btn rounded px-4 py-2 text-sm font-medium whitespace-nowrap bg-gray-100 text-gray-700 hover:bg-gray-200\" onclick=\"showTab('uavhengig')\">3 · Uavhengige hendinger</button>\n    <button class=\"tab-btn rounded px-4 py-2 text-sm font-medium whitespace-nowrap bg-gray-100 text-gray-700 hover:bg-gray-200\" onclick=\"showTab('tre')\">4 · Sannsynlighetstre</button>\n    <button class=\"tab-btn rounded px-4 py-2 text-sm font-medium whitespace-nowrap bg-gray-100 text-gray-700 hover:bg-gray-200\" onclick=\"showTab('quiz')\">5 · Øv deg</button>\n  </div>\n</nav>\n\n<main class=\"max-w-4xl mx-auto px-4 py-6 space-y-0\">\n\n<!-- ===== TAB 1: Komplement ===== -->\n<section id=\"tab-komplement\" class=\"section active space-y-5\">\n  <div class=\"bg-white rounded-xl shadow p-5\">\n    <h2 class=\"text-xl font-bold text-blue-800 mb-2\">1 · Komplement og sum av sannsynligheter</h2>\n    <p class=\"text-gray-600 mb-4\">To grunnregler du trenger for å jobbe med sammensatte hendinger:</p>\n\n    <div class=\"grid md:grid-cols-2 gap-4 mb-5\">\n      <div class=\"bg-blue-50 border border-blue-200 rounded-lg p-4\">\n        <h3 class=\"font-semibold text-blue-800 mb-2\">Komplement</h3>\n        <p class=\"text-sm mb-2\">Sannsynligheten for at <strong>A ikke</strong> skjer:</p>\n        <div class=\"bg-white rounded p-3 text-center font-mono text-lg font-bold text-blue-700\">\n          P(ikke A) = 1 − P(A)\n        </div>\n        <p class=\"text-xs text-gray-500 mt-2\">Alle utfall enten skjer i A eller <em>ikke</em> i A — de er utfyllende.</p>\n      </div>\n      <div class=\"bg-green-50 border border-green-200 rounded-lg p-4\">\n        <h3 class=\"font-semibold text-green-800 mb-2\">Sum for disjunkte hendinger</h3>\n        <p class=\"text-sm mb-2\">Hvis A og B <strong>ikke kan skje samtidig</strong> (disjunkte):</p>\n        <div class=\"bg-white rounded p-3 text-center font-mono text-lg font-bold text-green-700\">\n          P(A eller B) = P(A) + P(B)\n        </div>\n        <p class=\"text-xs text-gray-500 mt-2\">Summen av alle elementærhendingene er alltid 1.</p>\n      </div>\n    </div>\n\n    <!-- Interactive example -->\n    <div class=\"bg-gray-50 border border-gray-200 rounded-lg p-5\">\n      <h3 class=\"font-semibold mb-3\">🎲 Interaktivt eksempel: Kast en terning</h3>\n      <p class=\"text-sm text-gray-600 mb-4\">Velg en hendelse. Se sannsynligheten og komplementet steg for steg.</p>\n\n      <div class=\"flex flex-wrap gap-2 mb-4\">\n        <button class=\"px-3 py-1.5 rounded bg-blue-600 text-white text-sm font-medium hover:bg-blue-700\" onclick=\"diceExample('par')\">A: Partall {2,4,6}</button>\n        <button class=\"px-3 py-1.5 rounded bg-blue-600 text-white text-sm font-medium hover:bg-blue-700\" onclick=\"diceExample('tre')\">A: Mer enn 3 {4,5,6}</button>\n        <button class=\"px-3 py-1.5 rounded bg-blue-600 text-white text-sm font-medium hover:bg-blue-700\" onclick=\"diceExample('en')\">A: Øynene er 1 {1}</button>\n        <button class=\"px-3 py-1.5 rounded bg-blue-600 text-white text-sm font-medium hover:bg-blue-700\" onclick=\"diceExample('under4')\">A: Mindre enn 4 {1,2,3}</button>\n      </div>\n\n      <div id=\"dice-result\" class=\"space-y-2 hidden\">\n        <!-- filled by JS -->\n      </div>\n    </div>\n\n    <!-- Disjoint example -->\n    <div class=\"bg-gray-50 border border-gray-200 rounded-lg p-5 mt-4\">\n      <h3 class=\"font-semibold mb-3\">🃏 Eksempel: Kortspill (disjunkte hendinger)</h3>\n      <p class=\"text-sm text-gray-600 mb-2\">Du trekker ett kort fra en vanlig kortstokk (52 kort). La:</p>\n      <ul class=\"text-sm mb-4 space-y-1 list-disc ml-5\">\n        <li><strong>A</strong> = trekke et hjerte ♥ (13 av 52 kort)</li>\n        <li><strong>B</strong> = trekke et spar ♠ (13 av 52 kort)</li>\n      </ul>\n      <p class=\"text-sm text-gray-600 mb-3\">A og B er <em>disjunkte</em> (et kort kan ikke være både hjerte og spar). Regn ut P(A eller B):</p>\n\n      <div class=\"space-y-2\" id=\"disjoint-steps\" style=\"display:none\">\n        <div class=\"step\"><span class=\"font-mono text-sm\">P(A) = 13/52 = 1/4</span></div>\n        <div class=\"step\"><span class=\"font-mono text-sm\">P(B) = 13/52 = 1/4</span></div>\n        <div class=\"step font-semibold\"><span class=\"font-mono\">P(A eller B) = P(A) + P(B) = 1/4 + 1/4 = 2/4 = 1/2</span></div>\n        <p class=\"text-sm text-green-700 font-medium\">✓ Sannsynligheten for å trekke hjerte eller spar er 1/2 = 50 %.</p>\n      </div>\n      <button class=\"mt-2 px-4 py-2 bg-green-600 text-white text-sm rounded hover:bg-green-700\" onclick=\"toggleDisjoint()\">Vis utregning</button>\n    </div>\n  </div>\n</section>\n\n<!-- ===== TAB 2: Multiplikasjonsprinsippet ===== -->\n<section id=\"tab-multiprinsipp\" class=\"section space-y-5\">\n  <div class=\"bg-white rounded-xl shadow p-5\">\n    <h2 class=\"text-xl font-bold text-blue-800 mb-2\">2 · Multiplikasjonsprinsippet</h2>\n    <p class=\"text-gray-600 mb-4\">Når et valg skjer i <strong>flere trinn</strong>, og antall muligheter i hvert trinn er uavhengig av de andre, kan vi bruke:</p>\n\n    <div class=\"bg-blue-50 border border-blue-200 rounded-lg p-4 mb-5 text-center\">\n      <p class=\"font-semibold text-blue-800 mb-1\">Multiplikasjonsprinsippet</p>\n      <p class=\"font-mono text-blue-700 text-lg font-bold\">Totalt antall utfall = n₁ · n₂ · n₃ · …</p>\n      <p class=\"text-xs text-gray-500 mt-1\">der n₁ er antall muligheter i trinn 1, n₂ i trinn 2, osv.</p>\n    </div>\n\n    <!-- Antrekk eksempel -->\n    <div class=\"bg-gray-50 border border-gray-200 rounded-lg p-5 mb-5\">\n      <h3 class=\"font-semibold mb-2\">👕 Eksempel: Velge antrekk</h3>\n      <p class=\"text-sm text-gray-600 mb-4\">Kari har 3 gensere og 4 bukser. Hvor mange forskjellige antrekk kan hun velge?</p>\n\n      <div class=\"grid grid-cols-2 gap-3 mb-4\">\n        <div class=\"bg-white border rounded p-3 text-center\">\n          <div class=\"text-2xl mb-1\">👕</div>\n          <div id=\"sweater-count\" class=\"text-3xl font-bold text-blue-700\">3</div>\n          <div class=\"text-xs text-gray-500 mt-1\">gensere</div>\n          <div class=\"flex justify-center gap-2 mt-2\">\n            <button class=\"px-2 py-1 bg-gray-200 rounded text-sm font-bold hover:bg-gray-300\" onclick=\"changeCount('sweater',-1)\">−</button>\n            <button class=\"px-2 py-1 bg-gray-200 rounded text-sm font-bold hover:bg-gray-300\" onclick=\"changeCount('sweater',1)\">+</button>\n          </div>\n        </div>\n        <div class=\"bg-white border rounded p-3 text-center\">\n          <div class=\"text-2xl mb-1\">👖</div>\n          <div id=\"pants-count\" class=\"text-3xl font-bold text-blue-700\">4</div>\n          <div class=\"text-xs text-gray-500 mt-1\">bukser</div>\n          <div class=\"flex justify-center gap-2 mt-2\">\n            <button class=\"px-2 py-1 bg-gray-200 rounded text-sm font-bold hover:bg-gray-300\" onclick=\"changeCount('pants',-1)\">−</button>\n            <button class=\"px-2 py-1 bg-gray-200 rounded text-sm font-bold hover:bg-gray-300\" onclick=\"changeCount('pants',1)\">+</button>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"bg-white border border-blue-200 rounded p-4\">\n        <p class=\"text-sm font-medium mb-2\">Utregning:</p>\n        <p class=\"font-mono text-center text-lg\" id=\"outfit-calc\">\n          Antall antrekk = 3 · 4 = <strong class=\"text-blue-700\">12</strong>\n        </p>\n      </div>\n\n      <!-- Visual grid -->\n      <div class=\"mt-4\">\n        <p class=\"text-xs text-gray-500 mb-2\">Alle mulige kombinasjoner (G = genser, B = bukse):</p>\n        <div id=\"outfit-grid\" class=\"flex flex-wrap gap-1\"></div>\n      </div>\n    </div>\n\n    <!-- Probability from counting -->\n    <div class=\"bg-yellow-50 border border-yellow-200 rounded-lg p-5\">\n      <h3 class=\"font-semibold text-yellow-800 mb-2\">Fra telling til sannsynlighet</h3>\n      <p class=\"text-sm mb-3\">Kari velger et tilfeldig antrekk. Hva er sannsynligheten for at hun velger genser 2 (G2) og en bestemt bukse (B3)?</p>\n      <div class=\"space-y-2\" id=\"prob-from-count\" style=\"display:none\">\n        <div class=\"step text-sm\">Totalt antall like sannsynlige antrekk: 3 · 4 = 12</div>\n        <div class=\"step text-sm\">Antall gunstige utfall: 1 (kun G2 og B3)</div>\n        <div class=\"step text-sm font-semibold font-mono\">P(G2 og B3) = 1/12 ≈ 0,083 = 8,3 %</div>\n      </div>\n      <button class=\"mt-2 px-4 py-2 bg-yellow-600 text-white text-sm rounded hover:bg-yellow-700\" onclick=\"toggleProbCount()\">Vis utregning</button>\n    </div>\n  </div>\n</section>\n\n<!-- ===== TAB 3: Uavhengige vs avhengige hendinger ===== -->\n<section id=\"tab-uavhengig\" class=\"section space-y-5\">\n  <div class=\"bg-white rounded-xl shadow p-5\">\n    <h2 class=\"text-xl font-bold text-blue-800 mb-2\">3 · Uavhengige og avhengige hendinger</h2>\n    <p class=\"text-gray-600 mb-4\">Skiller du på <em>trekking med tilbakelegging</em> og <em>uten tilbakelegging</em>?</p>\n\n    <div class=\"grid md:grid-cols-2 gap-4 mb-5\">\n      <div class=\"bg-green-50 border border-green-200 rounded-lg p-4\">\n        <h3 class=\"font-semibold text-green-800 mb-1\">Uavhengige hendinger</h3>\n        <p class=\"text-sm text-gray-600 mb-2\">Det første utfallet <strong>påvirker ikke</strong> sannsynligheten for det neste.</p>\n        <div class=\"bg-white rounded p-3 text-center font-mono font-bold text-green-700\">\n          P(A og B) = P(A) · P(B)\n        </div>\n        <p class=\"text-xs text-gray-500 mt-2\">Eksempel: kaste terning to ganger. Hva du fikk første gang påvirker ikke andre kast.</p>\n      </div>\n      <div class=\"bg-orange-50 border border-orange-200 rounded-lg p-4\">\n        <h3 class=\"font-semibold text-orange-800 mb-1\">Avhengige hendinger</h3>\n        <p class=\"text-sm text-gray-600 mb-2\">Det første utfallet <strong>endrer</strong> mulighetene for det neste.</p>\n        <div class=\"bg-white rounded p-3 text-center font-mono font-bold text-orange-700\">\n          P(A og B) = P(A) · P(B|A)\n        </div>\n        <p class=\"text-xs text-gray-500 mt-2\">Eksempel: trekke kuler uten tilbakelegging. Etter første trekk er en kule borte.</p>\n      </div>\n    </div>\n\n    <!-- Interactive: Bag of balls -->\n    <div class=\"bg-gray-50 border border-gray-200 rounded-lg p-5\">\n      <h3 class=\"font-semibold mb-3\">🎱 Interaktivt eksempel: Pose med kuler</h3>\n      <p class=\"text-sm text-gray-600 mb-4\">En pose inneholder <strong>3 røde</strong> og <strong>2 blå</strong> kuler. Du trekker to kuler. Finn sannsynligheten for å trekke <strong>rød og deretter rød</strong>.</p>\n\n      <div class=\"flex gap-3 mb-4\">\n        <button id=\"btn-med\" class=\"px-4 py-2 text-sm font-medium rounded border-2 border-green-600 bg-green-600 text-white hover:bg-green-700\" onclick=\"setBagMode('med')\">Med tilbakelegging</button>\n        <button id=\"btn-uten\" class=\"px-4 py-2 text-sm font-medium rounded border-2 border-gray-300 bg-white text-gray-700 hover:bg-gray-100\" onclick=\"setBagMode('uten')\">Uten tilbakelegging</button>\n      </div>\n\n      <div id=\"bag-visual\" class=\"flex flex-wrap gap-2 mb-4 p-3 bg-white border rounded\">\n        <!-- filled by JS -->\n      </div>\n\n      <div id=\"bag-explanation\" class=\"space-y-2\">\n        <!-- filled by JS -->\n      </div>\n    </div>\n\n    <!-- Fixed worked example -->\n    <div class=\"bg-blue-50 border border-blue-200 rounded-lg p-5 mt-4\">\n      <h3 class=\"font-semibold text-blue-800 mb-2\">📌 Eksempel: Kaste to mynter</h3>\n      <p class=\"text-sm mb-3\">Du kaster to mynter. Hva er sannsynligheten for å få <em>krone på begge</em>?</p>\n      <div class=\"space-y-2\">\n        <div class=\"step text-sm\">De to kastene er <strong>uavhengige</strong> (hva du fikk på første mynt endrer ingenting for andre mynt).</div>\n        <div class=\"step text-sm font-mono\">P(krone) = 1/2 for hvert kast</div>\n        <div class=\"step text-sm font-mono\">P(krone og krone) = P(krone) · P(krone) = 1/2 · 1/2 = <strong>1/4</strong></div>\n        <p class=\"text-sm text-blue-700 font-medium mt-1\">✓ Sannsynligheten er 1/4 = 25 %.</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ===== TAB 4: Sannsynlighetstre ===== -->\n<section id=\"tab-tre\" class=\"section space-y-5\">\n  <div class=\"bg-white rounded-xl shadow p-5\">\n    <h2 class=\"text-xl font-bold text-blue-800 mb-2\">4 · Sannsynlighetstre</h2>\n    <p class=\"text-gray-600 mb-4\">Et sannsynlighetstre viser alle mulige utfall i et totrinnsforsøk. Multipliser sannsynlighetene langs grenene for å finne sannsynligheten for hvert utfall.</p>\n\n    <!-- Mode selector -->\n    <div class=\"flex flex-wrap gap-3 mb-5\">\n      <button id=\"tree-btn-mynt\" class=\"px-4 py-2 rounded text-sm font-medium bg-blue-600 text-white hover:bg-blue-700\" onclick=\"setTreeMode('mynt')\">To myntkast</button>\n      <button id=\"tree-btn-kule\" class=\"px-4 py-2 rounded text-sm font-medium bg-gray-100 text-gray-700 hover:bg-gray-200\" onclick=\"setTreeMode('kule')\">Pose med kuler (uten tilbakelegging)</button>\n      <button id=\"tree-btn-terning\" class=\"px-4 py-2 rounded text-sm font-medium bg-gray-100 text-gray-700 hover:bg-gray-200\" onclick=\"setTreeMode('terning')\">Terning + mynt</button>\n    </div>\n\n    <div id=\"tree-description\" class=\"bg-blue-50 border border-blue-100 rounded p-3 mb-4 text-sm text-gray-700\">\n      <!-- filled by JS -->\n    </div>\n\n    <div class=\"overflow-x-auto\">\n      <svg id=\"prob-tree\" width=\"680\" height=\"320\" viewBox=\"0 0 680 320\" class=\"block mx-auto max-w-full\">\n        <!-- filled by JS -->\n      </svg>\n    </div>\n\n    <div class=\"mt-5\">\n      <h3 class=\"font-semibold mb-2\">Utfall og sannsynligheter</h3>\n      <div id=\"tree-table\" class=\"space-y-2\">\n        <!-- filled by JS -->\n      </div>\n    </div>\n\n    <div class=\"mt-4 bg-yellow-50 border border-yellow-200 rounded p-4 text-sm\">\n      <strong class=\"text-yellow-800\">Huskeregel:</strong> Multipliser langs grenene, <strong>summer</strong> de separate utfallene. Summen av alle utfallssannsynligheter skal alltid bli <strong>1</strong>.\n    </div>\n  </div>\n</section>\n\n<!-- ===== TAB 5: Quiz ===== -->\n<section id=\"tab-quiz\" class=\"section space-y-5\">\n  <div class=\"bg-white rounded-xl shadow p-5\">\n    <h2 class=\"text-xl font-bold text-blue-800 mb-4\">5 · Øv deg</h2>\n    <p class=\"text-gray-600 mb-5\">Svar på oppgavene. Klikk «Sjekk svar» etter hvert.</p>\n\n    <!-- Q1 -->\n    <div class=\"border rounded-lg p-4 mb-4\" id=\"q1-box\">\n      <p class=\"font-medium mb-1\"><span class=\"bg-blue-100 text-blue-800 text-xs font-semibold px-2 py-0.5 rounded mr-2\">Oppg. 1</span>Komplement</p>\n      <p class=\"text-sm text-gray-700 mb-3\">Sannsynligheten for regn i morgen er P(R) = 0,35. Hva er sannsynligheten for at det <strong>ikke</strong> regner?</p>\n      <div class=\"flex items-center gap-3 mb-2\">\n        <label class=\"text-sm font-medium\">P(ikke R) =</label>\n        <input type=\"number\" step=\"0.01\" min=\"0\" max=\"1\" id=\"q1-input\" class=\"border rounded px-3 py-1.5 w-28 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" placeholder=\"0.xx\" />\n        <button class=\"px-4 py-1.5 bg-blue-600 text-white text-sm rounded hover:bg-blue-700\" onclick=\"checkQ(1)\">Sjekk svar</button>\n      </div>\n      <p class=\"quiz-feedback text-sm\" id=\"q1-feedback\"></p>\n    </div>\n\n    <!-- Q2 -->\n    <div class=\"border rounded-lg p-4 mb-4\" id=\"q2-box\">\n      <p class=\"font-medium mb-1\"><span class=\"bg-blue-100 text-blue-800 text-xs font-semibold px-2 py-0.5 rounded mr-2\">Oppg. 2</span>Sum (disjunkte)</p>\n      <p class=\"text-sm text-gray-700 mb-3\">En pose inneholder 10 kuler: 4 røde, 3 blå og 3 gule. Du trekker én kule. Hva er sannsynligheten for å trekke <strong>rød eller gul</strong>?</p>\n      <div class=\"flex items-center gap-3 mb-2\">\n        <label class=\"text-sm font-medium\">P(rød eller gul) =</label>\n        <input type=\"number\" step=\"0.01\" min=\"0\" max=\"1\" id=\"q2-input\" class=\"border rounded px-3 py-1.5 w-28 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" placeholder=\"0.xx\" />\n        <button class=\"px-4 py-1.5 bg-blue-600 text-white text-sm rounded hover:bg-blue-700\" onclick=\"checkQ(2)\">Sjekk svar</button>\n      </div>\n      <p class=\"quiz-feedback text-sm\" id=\"q2-feedback\"></p>\n    </div>\n\n    <!-- Q3 -->\n    <div class=\"border rounded-lg p-4 mb-4\" id=\"q3-box\">\n      <p class=\"font-medium mb-1\"><span class=\"bg-blue-100 text-blue-800 text-xs font-semibold px-2 py-0.5 rounded mr-2\">Oppg. 3</span>Multiplikasjonsprinsippet</p>\n      <p class=\"text-sm text-gray-700 mb-3\">En restaurant tilbyr 4 forretter, 5 hovedretter og 3 desserter. Hvor mange ulike trerettersmiddager kan du sette sammen?</p>\n      <div class=\"flex items-center gap-3 mb-2\">\n        <label class=\"text-sm font-medium\">Antall middager =</label>\n        <input type=\"number\" step=\"1\" min=\"1\" id=\"q3-input\" class=\"border rounded px-3 py-1.5 w-28 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" placeholder=\"?\" />\n        <button class=\"px-4 py-1.5 bg-blue-600 text-white text-sm rounded hover:bg-blue-700\" onclick=\"checkQ(3)\">Sjekk svar</button>\n      </div>\n      <p class=\"quiz-feedback text-sm\" id=\"q3-feedback\"></p>\n    </div>\n\n    <!-- Q4 -->\n    <div class=\"border rounded-lg p-4 mb-4\" id=\"q4-box\">\n      <p class=\"font-medium mb-1\"><span class=\"bg-blue-100 text-blue-800 text-xs font-semibold px-2 py-0.5 rounded mr-2\">Oppg. 4</span>Uavhengige hendinger</p>\n      <p class=\"text-sm text-gray-700 mb-3\">Du kaster en terning to ganger. Hva er sannsynligheten for å få <strong>6</strong> på begge kastene? Skriv svaret som en desimalbrøk (to desimaler).</p>\n      <div class=\"flex items-center gap-3 mb-2\">\n        <label class=\"text-sm font-medium\">P(6 og 6) ≈</label>\n        <input type=\"number\" step=\"0.001\" min=\"0\" max=\"1\" id=\"q4-input\" class=\"border rounded px-3 py-1.5 w-32 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" placeholder=\"0.xxx\" />\n        <button class=\"px-4 py-1.5 bg-blue-600 text-white text-sm rounded hover:bg-blue-700\" onclick=\"checkQ(4)\">Sjekk svar</button>\n      </div>\n      <p class=\"quiz-feedback text-sm\" id=\"q4-feedback\"></p>\n    </div>\n\n    <!-- Q5 -->\n    <div class=\"border rounded-lg p-4 mb-4\" id=\"q5-box\">\n      <p class=\"font-medium mb-1\"><span class=\"bg-blue-100 text-blue-800 text-xs font-semibold px-2 py-0.5 rounded mr-2\">Oppg. 5</span>Avhengige hendinger</p>\n      <p class=\"text-sm text-gray-700 mb-3\">En pose har 5 røde og 3 blå kuler. Du trekker to kuler <strong>uten tilbakelegging</strong>. Hva er sannsynligheten for at begge er røde? Skriv svaret som desimalbrøk (to desimaler).</p>\n      <div class=\"flex items-center gap-3 mb-2\">\n        <label class=\"text-sm font-medium\">P(rød, rød) ≈</label>\n        <input type=\"number\" step=\"0.01\" min=\"0\" max=\"1\" id=\"q5-input\" class=\"border rounded px-3 py-1.5 w-28 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" placeholder=\"0.xx\" />\n        <button class=\"px-4 py-1.5 bg-blue-600 text-white text-sm rounded hover:bg-blue-700\" onclick=\"checkQ(5)\">Sjekk svar</button>\n      </div>\n      <p class=\"quiz-feedback text-sm\" id=\"q5-feedback\"></p>\n    </div>\n\n    <!-- Score -->\n    <div id=\"score-area\" class=\"hidden bg-blue-50 border border-blue-200 rounded-lg p-4 text-center\">\n      <p class=\"font-semibold text-blue-800 text-lg\" id=\"score-text\"></p>\n      <button class=\"mt-3 px-5 py-2 bg-blue-600 text-white rounded hover:bg-blue-700\" onclick=\"resetQuiz()\">Start på nytt</button>\n    </div>\n  </div>\n</section>\n\n</main>\n\n<footer class=\"mt-10 bg-gray-100 border-t py-4 px-4 text-center text-xs text-gray-400\">\n  Matematikk 1P · LK20 · Sinus kap. 9.3–9.6 · Halison App Studio\n</footer>\n\n<script>\n// ===========================\n// TAB NAVIGATION\n// ===========================\nfunction showTab(name) {\n  document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));\n  document.querySelectorAll('.tab-btn').forEach(b => {\n    b.classList.remove('active');\n    b.classList.add('bg-gray-100', 'text-gray-700');\n    b.classList.remove('bg-blue-800', 'text-white');\n  });\n  document.getElementById('tab-' + name).classList.add('active');\n  const btns = document.querySelectorAll('.tab-btn');\n  btns.forEach(b => {\n    if (b.getAttribute('onclick') && b.getAttribute('onclick').includes(\"'\" + name + \"'\")) {\n      b.classList.add('active');\n      b.classList.remove('bg-gray-100', 'text-gray-700');\n    }\n  });\n  // Init sections on first show\n  if (name === 'tre') initTree('mynt');\n  if (name === 'uavhengig') initBag();\n  if (name === 'multiprinsipp') renderOutfitGrid();\n}\n\n// ===========================\n// TAB 1: KOMPLEMENT\n// ===========================\nconst diceEvents = {\n  par:   { label: 'Partall {2, 4, 6}', favorable: 3, total: 6 },\n  tre:   { label: 'Mer enn 3 {4, 5, 6}', favorable: 3, total: 6 },\n  en:    { label: 'Øynene er 1 {1}', favorable: 1, total: 6 },\n  under4:{ label: 'Mindre enn 4 {1, 2, 3}', favorable: 3, total: 6 }\n};\n\nfunction frac(a, b) {\n  return `<span class=\"fraction\"><span class=\"num\">${a}</span><span class=\"den\">${b}</span></span>`;\n}\n\nfunction diceExample(key) {\n  const ev = diceEvents[key];\n  const pA = ev.favorable / ev.total;\n  const pNotA = 1 - pA;\n  const pAFrac = `${ev.favorable}/${ev.total}`;\n  const pNotFrac = `${ev.total - ev.favorable}/${ev.total}`;\n\n  const html = `\n    <div class=\"step bg-white p-3 rounded border text-sm\">\n      <strong>Hendelse A:</strong> ${ev.label}\n      <br>Gunstige utfall: ${ev.favorable}  &nbsp;|&nbsp; Totalt antall utfall: ${ev.total}\n    </div>\n    <div class=\"step bg-white p-3 rounded border text-sm\">\n      <strong>P(A)</strong> = ${frac(ev.favorable, ev.total)} = <strong>${pA.toFixed(4).replace(/\\.?0+$/, '')}</strong> = <strong>${(pA*100).toFixed(1).replace(/\\.0$/,'')} %</strong>\n    </div>\n    <div class=\"step bg-white p-3 rounded border text-sm\">\n      <strong>P(ikke A)</strong> = 1 − P(A) = 1 − ${frac(ev.favorable, ev.total)} = ${frac(ev.total-ev.favorable, ev.total)} = <strong>${pNotA.toFixed(4).replace(/\\.?0+$/, '')}</strong> = <strong>${(pNotA*100).toFixed(1).replace(/\\.0$/,'')} %</strong>\n    </div>\n    <div class=\"step bg-green-50 border-green-400 p-3 rounded text-sm font-medium text-green-800\">\n      ✓ P(A) + P(ikke A) = ${pAFrac} + ${pNotFrac} = ${ev.total}/${ev.total} = 1 ✓\n    </div>`;\n\n  const el = document.getElementById('dice-result');\n  el.innerHTML = html;\n  el.classList.remove('hidden');\n}\n\nlet disjointShown = false;\nfunction toggleDisjoint() {\n  const el = document.getElementById('disjoint-steps');\n  const btn = el.nextElementSibling;\n  disjointShown = !disjointShown;\n  el.style.display = disjointShown ? 'block' : 'none';\n  btn.textContent = disjointShown ? 'Skjul utregning' : 'Vis utregning';\n}\n\n// ===========================\n// TAB 2: MULTIPLIKASJONSPRINSIPPET\n// ===========================\nlet sweaterN = 3, pantsN = 4;\n\nfunction changeCount(type, delta) {\n  if (type === 'sweater') {\n    sweaterN = Math.max(1, Math.min(6, sweaterN + delta));\n    document.getElementById('sweater-count').textContent = sweaterN;\n  } else {\n    pantsN = Math.max(1, Math.min(6, pantsN + delta));\n    document.getElementById('pants-count').textContent = pantsN;\n  }\n  const total = sweaterN * pantsN;\n  document.getElementById('outfit-calc').innerHTML =\n    `Antall antrekk = ${sweaterN} · ${pantsN} = <strong class=\"text-blue-700\">${total}</strong>`;\n  renderOutfitGrid();\n}\n\nfunction renderOutfitGrid() {\n  const grid = document.getElementById('outfit-grid');\n  grid.innerHTML = '';\n  const colors = ['bg-blue-100', 'bg-green-100', 'bg-yellow-100', 'bg-red-100', 'bg-purple-100', 'bg-orange-100'];\n  for (let g = 1; g <= sweaterN; g++) {\n    for (let b = 1; b <= pantsN; b++) {\n      const el = document.createElement('div');\n      el.className = `${colors[(g-1) % colors.length]} border rounded px-2 py-1 text-xs font-mono text-gray-700`;\n      el.textContent = `G${g}B${b}`;\n      grid.appendChild(el);\n    }\n  }\n}\n\nlet probCountShown = false;\nfunction toggleProbCount() {\n  const el = document.getElementById('prob-from-count');\n  const btn = el.nextElementSibling;\n  probCountShown = !probCountShown;\n  el.style.display = probCountShown ? 'block' : 'none';\n  btn.textContent = probCountShown ? 'Skjul utregning' : 'Vis utregning';\n}\n\n// ===========================\n// TAB 3: UAVHENGIGE / AVHENGIGE\n// ===========================\nlet bagMode = 'med';\n\nfunction initBag() {\n  setBagMode('med');\n}\n\nfunction setBagMode(mode) {\n  bagMode = mode;\n  const btnMed = document.getElementById('btn-med');\n  const btnUten = document.getElementById('btn-uten');\n  if (mode === 'med') {\n    btnMed.className = 'px-4 py-2 text-sm font-medium rounded border-2 border-green-600 bg-green-600 text-white hover:bg-green-700';\n    btnUten.className = 'px-4 py-2 text-sm font-medium rounded border-2 border-gray-300 bg-white text-gray-700 hover:bg-gray-100';\n  } else {\n    btnUten.className = 'px-4 py-2 text-sm font-medium rounded border-2 border-orange-600 bg-orange-600 text-white hover:bg-orange-700';\n    btnMed.className = 'px-4 py-2 text-sm font-medium rounded border-2 border-gray-300 bg-white text-gray-700 hover:bg-gray-100';\n  }\n  renderBag(mode);\n}\n\nfunction renderBag(mode) {\n  const visual = document.getElementById('bag-visual');\n  const exp = document.getElementById('bag-explanation');\n  // Draw balls: 3 red, 2 blue\n  let ballsHTML = '<span class=\"text-xs text-gray-500 mr-2 self-center\">Pose:</span>';\n  for (let i = 0; i < 3; i++) {\n    ballsHTML += '<div class=\"w-9 h-9 rounded-full bg-red-500 border-2 border-red-700 flex items-center justify-center text-white text-xs font-bold\">R</div>';\n  }\n  for (let i = 0; i < 2; i++) {\n    ballsHTML += '<div class=\"w-9 h-9 rounded-full bg-blue-500 border-2 border-blue-700 flex items-center justify-center text-white text-xs font-bold\">B</div>';\n  }\n  visual.innerHTML = ballsHTML;\n\n  if (mode === 'med') {\n    exp.innerHTML = `\n      <div class=\"bg-green-50 border border-green-200 rounded p-4 space-y-2\">\n        <p class=\"text-sm font-semibold text-green-800\">Med tilbakelegging — uavhengige hendinger</p>\n        <div class=\"step text-sm\">Hendelse A: første kule er rød. Pose: 3 røde + 2 blå = 5 kuler.<br>\n          <span class=\"font-mono\">P(A) = 3/5</span>\n        </div>\n        <div class=\"step text-sm\">Kulen legges <strong>tilbake</strong>. Pose er fortsatt 3 røde + 2 blå = 5 kuler.<br>\n          Hendelse B: andre kule er rød.<br>\n          <span class=\"font-mono\">P(B|A) = 3/5</span> (uendret — uavhengig)\n        </div>\n        <div class=\"step text-sm font-semibold font-mono\">P(A og B) = P(A) · P(B) = 3/5 · 3/5 = 9/25 = <strong>0,36 = 36 %</strong></div>\n      </div>`;\n  } else {\n    exp.innerHTML = `\n      <div class=\"bg-orange-50 border border-orange-200 rounded p-4 space-y-2\">\n        <p class=\"text-sm font-semibold text-orange-800\">Uten tilbakelegging — avhengige hendinger</p>\n        <div class=\"step text-sm\">Hendelse A: første kule er rød. Pose: 3 røde + 2 blå = 5 kuler.<br>\n          <span class=\"font-mono\">P(A) = 3/5</span>\n        </div>\n        <div class=\"step text-sm\">Kulen legges <strong>ikke</strong> tilbake. Nå er det <strong>2 røde + 2 blå = 4 kuler</strong> igjen.<br>\n          Hendelse B: andre kule er rød.<br>\n          <span class=\"font-mono\">P(B|A) = 2/4 = 1/2</span> (endret — avhengig)\n        </div>\n        <div class=\"step text-sm font-semibold font-mono\">P(A og B) = P(A) · P(B|A) = 3/5 · 2/4 = 6/20 = 3/10 = <strong>0,30 = 30 %</strong></div>\n        <p class=\"text-xs text-orange-700 mt-1\">Legg merke til: 30 % &lt; 36 %. Uten tilbakelegging er det <em>vanskeligere</em> å trekke rød to ganger på rad.</p>\n      </div>`;\n  }\n}\n\n// ===========================\n// TAB 4: SANNSYNLIGHETSTRE\n// ===========================\nconst treeModes = {\n  mynt: {\n    desc: 'Eksperiment: Kaste en mynt to ganger. K = krone, M = mynt.',\n    stage1: [\n      { label: 'K', p: '1/2', pNum: 0.5 },\n      { label: 'M', p: '1/2', pNum: 0.5 }\n    ],\n    stage2: {\n      K: [{ label: 'K', p: '1/2', pNum: 0.5 }, { label: 'M', p: '1/2', pNum: 0.5 }],\n      M: [{ label: 'K', p: '1/2', pNum: 0.5 }, { label: 'M', p: '1/2', pNum: 0.5 }]\n    },\n    outcomeFn: (a, b) => a + b,\n    outcomeLabelFn: (a, b) => a + ', ' + b\n  },\n  kule: {\n    desc: 'Pose med 3 røde (R) og 2 blå (B) kuler. Trekker to kuler uten tilbakelegging.',\n    stage1: [\n      { label: 'R', p: '3/5', pNum: 3/5 },\n      { label: 'B', p: '2/5', pNum: 2/5 }\n    ],\n    stage2: {\n      R: [{ label: 'R', p: '2/4', pNum: 2/4 }, { label: 'B', p: '2/4', pNum: 2/4 }],\n      B: [{ label: 'R', p: '3/4', pNum: 3/4 }, { label: 'B', p: '1/4', pNum: 1/4 }]\n    },\n    outcomeFn: (a, b) => a + b,\n    outcomeLabelFn: (a, b) => a + ', ' + b\n  },\n  terning: {\n    desc: 'Trinn 1: Kast en terning. Hendelse P = partall {2,4,6}, O = oddetall {1,3,5}. Trinn 2: Kast en mynt. K = krone, M = mynt.',\n    stage1: [\n      { label: 'P', p: '1/2', pNum: 0.5 },\n      { label: 'O', p: '1/2', pNum: 0.5 }\n    ],\n    stage2: {\n      P: [{ label: 'K', p: '1/2', pNum: 0.5 }, { label: 'M', p: '1/2', pNum: 0.5 }],\n      O: [{ label: 'K', p: '1/2', pNum: 0.5 }, { label: 'M', p: '1/2', pNum: 0.5 }]\n    },\n    outcomeFn: (a, b) => a + b,\n    outcomeLabelFn: (a, b) => a + ', ' + b\n  }\n};\n\nlet currentTreeMode = 'mynt';\n\nfunction setTreeMode(mode) {\n  currentTreeMode = mode;\n  ['mynt', 'kule', 'terning'].forEach(m => {\n    const btn = document.getElementById('tree-btn-' + m);\n    if (m === mode) {\n      btn.className = 'px-4 py-2 rounded text-sm font-medium bg-blue-600 text-white hover:bg-blue-700';\n    } else {\n      btn.className = 'px-4 py-2 rounded text-sm font-medium bg-gray-100 text-gray-700 hover:bg-gray-200';\n    }\n  });\n  initTree(mode);\n}\n\nfunction initTree(mode) {\n  const tm = treeModes[mode];\n  document.getElementById('tree-description').textContent = tm.desc;\n  drawTree(tm);\n  buildTreeTable(tm);\n}\n\nfunction drawTree(tm) {\n  const svg = document.getElementById('prob-tree');\n  svg.innerHTML = '';\n\n  const W = 680, H = 320;\n  const rootX = 60, rootY = H / 2;\n  const midX = 240;\n  const leafX = 560;\n\n  // Root node\n  drawCircle(svg, rootX, rootY, 16, '#1d4ed8', 'Start');\n\n  const s1 = tm.stage1;\n  const midYs = [];\n  if (s1.length === 2) {\n    midYs.push(H * 0.28, H * 0.72);\n  } else {\n    for (let i = 0; i < s1.length; i++) {\n      midYs.push(H * (i + 1) / (s1.length + 1));\n    }\n  }\n\n  s1.forEach((node, i) => {\n    const my = midYs[i];\n    // Line root -> mid\n    drawLine(svg, rootX, rootY, midX, my);\n    // Mid circle\n    drawCircle(svg, midX, my, 14, '#1d4ed8', node.label);\n    // Branch label (probability)\n    const mlx = (rootX + midX) / 2;\n    const mly = (rootY + my) / 2 - 10;\n    drawText(svg, mlx, mly, node.p, '#2563eb', 12, 'middle');\n\n    // Stage 2\n    const s2arr = tm.stage2[node.label];\n    const leafCount = s2arr.length;\n    const leafYs = [];\n    if (leafCount === 2) {\n      const span = 70;\n      leafYs.push(my - span, my + span);\n    } else {\n      for (let j = 0; j < leafCount; j++) {\n        leafYs.push(H * (j + 1) / (leafCount + 1));\n      }\n    }\n\n    s2arr.forEach((leaf, j) => {\n      const ly = leafYs[j];\n      // Line mid -> leaf\n      const isRed = leaf.label === 'R' || leaf.label === 'M' || leaf.label === 'O';\n      drawLine(svg, midX, my, leafX, ly);\n      // Leaf circle\n      const leafColor = leaf.label === 'R' ? '#dc2626' : leaf.label === 'B' ? '#2563eb' : '#16a34a';\n      drawCircle(svg, leafX, ly, 13, leafColor, leaf.label);\n      // Branch probability label\n      const blx = (midX + leafX) / 2;\n      const bly = (my + ly) / 2 - 9;\n      drawText(svg, blx, bly, leaf.p, '#374151', 11, 'middle');\n\n      // Outcome label\n      const product = (node.pNum * leaf.pNum);\n      const productStr = formatProb(product);\n      drawText(svg, leafX + 28, ly, tm.outcomeLabelFn(node.label, leaf.label), '#374151', 11, 'start');\n      drawText(svg, leafX + 28, ly + 14, '= ' + productStr, '#6b21a8', 10, 'start');\n    });\n  });\n}\n\nfunction formatProb(p) {\n  // Try to express as simple fraction if possible\n  const fracs = [\n    [1,2],[1,4],[3,4],[1,3],[2,3],[1,5],[2,5],[3,5],[4,5],[1,6],[5,6],\n    [1,8],[3,8],[5,8],[7,8],[1,9],[4,9],[2,9],[1,16],[9/25, '9/25'],\n    [3/10,'3/10'],[9/25,'9/25'],[3/20,'3/20'],[1/25,'1/25'],[6/25,'6/25']\n  ];\n  // Simple approach: round to 4 dec\n  const rounded = Math.round(p * 10000) / 10000;\n  // Check common fracs\n  const map = {\n    0.5:'1/2', 0.25:'1/4', 0.75:'3/4',\n    0.3333:'1/3', 0.6667:'2/3',\n    0.2:'1/5', 0.4:'2/5', 0.6:'3/5', 0.8:'4/5',\n    0.1667:'1/6', 0.8333:'5/6',\n    0.3:'3/10', 0.36:'9/25',\n    0.1250:'1/8', 0.3750:'3/8', 0.1:'1/10', 0.05:'1/20',\n    0.15:'3/20', 0.09:'9/100'\n  };\n  for (const [k,v] of Object.entries(map)) {\n    if (Math.abs(rounded - parseFloat(k)) < 0.00015) return v;\n  }\n  return rounded.toString();\n}\n\nfunction drawLine(svg, x1, y1, x2, y2) {\n  const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');\n  line.setAttribute('x1', x1); line.setAttribute('y1', y1);\n  line.setAttribute('x2', x2); line.setAttribute('y2', y2);\n  line.setAttribute('stroke', '#94a3b8'); line.setAttribute('stroke-width', '2');\n  svg.appendChild(line);\n}\n\nfunction drawCircle(svg, cx, cy, r, fill, label) {\n  const c = document.createElementNS('http://www.w3.org/2000/svg', 'circle');\n  c.setAttribute('cx', cx); c.setAttribute('cy', cy); c.setAttribute('r', r);\n  c.setAttribute('fill', fill); c.setAttribute('stroke', '#fff'); c.setAttribute('stroke-width', '2');\n  svg.appendChild(c);\n  const t = document.createElementNS('http://www.w3.org/2000/svg', 'text');\n  t.setAttribute('x', cx); t.setAttribute('y', cy + 4);\n  t.setAttribute('text-anchor', 'middle');\n  t.setAttribute('fill', 'white');\n  t.setAttribute('font-size', '11');\n  t.setAttribute('font-weight', 'bold');\n  t.textContent = label;\n  svg.appendChild(t);\n}\n\nfunction drawText(svg, x, y, text, fill, size, anchor) {\n  const t = document.createElementNS('http://www.w3.org/2000/svg', 'text');\n  t.setAttribute('x', x); t.setAttribute('y', y);\n  t.setAttribute('text-anchor', anchor || 'middle');\n  t.setAttribute('fill', fill || '#374151');\n  t.setAttribute('font-size', size || 12);\n  t.textContent = text;\n  svg.appendChild(t);\n}\n\nfunction buildTreeTable(tm) {\n  const div = document.getElementById('tree-table');\n  div.innerHTML = '';\n  let rows = '';\n  let total = 0;\n  tm.stage1.forEach(n1 => {\n    tm.stage2[n1.label].forEach(n2 => {\n      const p = n1.pNum * n2.pNum;\n      total += p;\n      const label = tm.outcomeLabelFn(n1.label, n2.label);\n      rows += `<tr class=\"border-t\"><td class=\"py-2 px-3 font-mono text-sm\">${label}</td>\n        <td class=\"py-2 px-3 text-sm\">${n1.p} · ${n2.p}</td>\n        <td class=\"py-2 px-3 font-mono font-semibold text-purple-700\">${formatProb(p)}</td></tr>`;\n    });\n  });\n  div.innerHTML = `<div class=\"overflow-x-auto\"><table class=\"w-full border border-gray-200 rounded text-sm\">\n    <thead class=\"bg-gray-50\"><tr>\n      <th class=\"py-2 px-3 text-left\">Utfall</th>\n      <th class=\"py-2 px-3 text-left\">Grenprodukter</th>\n      <th class=\"py-2 px-3 text-left\">Sannsynlighet</th>\n    </tr></thead>\n    <tbody>${rows}</tbody>\n    <tfoot class=\"bg-gray-50 font-semibold\"><tr>\n      <td class=\"py-2 px-3 text-sm\" colspan=\"2\">Sum</td>\n      <td class=\"py-2 px-3 font-mono text-green-700\">${Math.round(total * 10000) / 10000} ✓</td>\n    </tr></tfoot>\n  </table></div>`;\n}\n\n// ===========================\n// TAB 5: QUIZ\n// ===========================\nconst answers = {\n  1: { val: 0.65, tol: 0.005, solution: 'P(ikke R) = 1 − P(R) = 1 − 0,35 = 0,65 (65 %)' },\n  2: { val: 0.70, tol: 0.005, solution: 'P(rød) = 4/10 = 0,4, P(gul) = 3/10 = 0,3. P(rød eller gul) = 0,4 + 0,3 = 0,7 (70 %)' },\n  3: { val: 60, tol: 0.5, solution: '4 · 5 · 3 = 60 ulike trerettersmiddager' },\n  4: { val: 1/36, tol: 0.002, solution: 'P(6) = 1/6. P(6 og 6) = 1/6 · 1/6 = 1/36 ≈ 0,028 (2,8 %)' },\n  5: { val: 5/8 * 4/7, tol: 0.01, solution: 'P(1. rød) = 5/8. P(2. rød | 1. rød) = 4/7. P = 5/8 · 4/7 = 20/56 = 5/14 ≈ 0,357 (35,7 %)' }\n};\n\nlet answered = {};\n\nfunction checkQ(n) {\n  const input = document.getElementById('q' + n + '-input');\n  const feedback = document.getElementById('q' + n + '-feedback');\n  const box = document.getElementById('q' + n + '-box');\n  const val = parseFloat(input.value);\n  if (isNaN(val)) {\n    feedback.textContent = 'Skriv inn et tall.';\n    feedback.className = 'quiz-feedback text-sm text-orange-600';\n    return;\n  }\n  const ans = answers[n];\n  const correct = Math.abs(val - ans.val) <= ans.tol;\n  if (correct) {\n    feedback.innerHTML = '✓ Riktig! <span class=\"font-mono\">' + ans.solution + '</span>';\n    feedback.className = 'quiz-feedback text-sm text-green-700 font-medium';\n    box.classList.add('border-green-400', 'bg-green-50');\n    answered[n] = true;\n  } else {\n    feedback.innerHTML = '✗ Prøv igjen. Tips: ' + getHint(n);\n    feedback.className = 'quiz-feedback text-sm text-red-600';\n    box.classList.add('border-red-300', 'bg-red-50');\n    box.classList.remove('border-green-400', 'bg-green-50');\n    answered[n] = false;\n  }\n  checkAllAnswered();\n}\n\nfunction getHint(n) {\n  const hints = {\n    1: 'Bruk: P(ikke A) = 1 − P(A)',\n    2: 'Rød og gul er disjunkte hendinger. Summer sannsynlighetene.',\n    3: 'Multipliser antall valg i hvert trinn: 4 · 5 · 3',\n    4: 'P(6) = 1/6. De to kastene er uavhengige, bruk multiplikasjon.',\n    5: 'Uten tilbakelegging! Etter første trekk er det én kule mindre.'\n  };\n  return hints[n] || '';\n}\n\nfunction checkAllAnswered() {\n  const total = Object.keys(answers).length;\n  const correct = Object.values(answered).filter(Boolean).length;\n  if (Object.keys(answered).length === total) {\n    const scoreArea = document.getElementById('score-area');\n    const scoreText = document.getElementById('score-text');\n    scoreArea.classList.remove('hidden');\n    scoreText.textContent = `Du fikk ${correct} av ${total} riktig!`;\n  }\n}\n\nfunction resetQuiz() {\n  answered = {};\n  for (let i = 1; i <= 5; i++) {\n    const input = document.getElementById('q' + i + '-input');\n    const feedback = document.getElementById('q' + i + '-feedback');\n    const box = document.getElementById('q' + i + '-box');\n    input.value = '';\n    feedback.textContent = '';\n    feedback.className = 'quiz-feedback text-sm';\n    box.className = 'border rounded-lg p-4 mb-4';\n  }\n  document.getElementById('score-area').classList.add('hidden');\n}\n\n// ===========================\n// INIT\n// ===========================\n(function init() {\n  renderOutfitGrid();\n  // Bag init will happen when tab is shown\n})();\n</script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Sammensatte hendelser",
    "windowTitle": "Sammensatte hendelser",
    "bundleId": "com.halisonworks.sammensattehendelser",
