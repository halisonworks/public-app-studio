{
  "schema": "app-studio/canvas@1",
  "id": "example-no1p-prosentregning",
  "name": "prosentregning.html",
  "code": "<!DOCTYPE html>\n<!--\n  Prosentregning — Halison App Studio-eksempel\n\n  Interaktivt læremiddel for matematikk 1P (LK20): prosentfaktor, prosentvis\n  økning og nedgang, å finne opprinnelig verdi, og merverdiavgift (MVA).\n\n  Fra Halison App Studio sitt offentlige bibliotek:\n  https://github.com/halisonworks/public-app-studio\n\n  Tillatt bruk: personlig, pedagogisk og annen ikke-kommersiell bruk. Behold denne\n  headeren og kildelenken; ikke-kommersiell bruk. Utgitt under Halison App Studio\n  Examples License — se LICENSE-filen i repoet over.\n-->\n<html lang=\"no\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Prosentregning – Matematikk 1P</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Segoe UI', system-ui, sans-serif; }\n    .tab-active { background-color: #1d4ed8; color: white; }\n    .tab-inactive { background-color: #e2e8f0; color: #374151; }\n    .formula-box { background: #eff6ff; border-left: 4px solid #3b82f6; }\n    .step-box { background: #f0fdf4; border-left: 4px solid #22c55e; }\n    .error-box { background: #fef2f2; border-left: 4px solid #ef4444; }\n    .result-box { background: #fefce8; border-left: 4px solid #eab308; }\n    input[type=\"number\"]::-webkit-inner-spin-button,\n    input[type=\"number\"]::-webkit-outer-spin-button { opacity: 1; }\n  </style>\n</head>\n<body class=\"bg-gray-50 min-h-screen\">\n\n  <!-- Header -->\n  <header class=\"bg-blue-700 text-white shadow-lg\">\n    <div class=\"max-w-4xl mx-auto px-4 py-5\">\n      <h1 class=\"text-2xl font-bold\">Prosentregning</h1>\n      <p class=\"text-blue-200 text-sm mt-1\">Matematikk 1P · LK20 · Sinus kap. 2.1–2.5</p>\n    </div>\n  </header>\n\n  <!-- Tab navigation -->\n  <nav class=\"bg-white border-b shadow-sm sticky top-0 z-10\">\n    <div class=\"max-w-4xl mx-auto px-4 overflow-x-auto\">\n      <div class=\"flex gap-1 py-2 min-w-max\">\n        <button onclick=\"visTab('faktor')\" id=\"tab-faktor\"\n          class=\"tab-active px-4 py-2 rounded-lg text-sm font-semibold transition-colors whitespace-nowrap\">\n          Prosentfaktor\n        </button>\n        <button onclick=\"visTab('prosent-av')\" id=\"tab-prosent-av\"\n          class=\"tab-inactive px-4 py-2 rounded-lg text-sm font-semibold transition-colors whitespace-nowrap\">\n          Prosent av tall\n        </button>\n        <button onclick=\"visTab('ny-verdi')\" id=\"tab-ny-verdi\"\n          class=\"tab-inactive px-4 py-2 rounded-lg text-sm font-semibold transition-colors whitespace-nowrap\">\n          Ny verdi\n        </button>\n        <button onclick=\"visTab('original')\" id=\"tab-original\"\n          class=\"tab-inactive px-4 py-2 rounded-lg text-sm font-semibold transition-colors whitespace-nowrap\">\n          Opprinnelig verdi\n        </button>\n        <button onclick=\"visTab('mva')\" id=\"tab-mva\"\n          class=\"tab-inactive px-4 py-2 rounded-lg text-sm font-semibold transition-colors whitespace-nowrap\">\n          MVA\n        </button>\n      </div>\n    </div>\n  </nav>\n\n  <main class=\"max-w-4xl mx-auto px-4 py-8\">\n\n    <!-- ===== TAB: PROSENTFAKTOR ===== -->\n    <section id=\"seksjon-faktor\" class=\"space-y-6\">\n      <div class=\"bg-white rounded-xl shadow p-6\">\n        <h2 class=\"text-xl font-bold text-gray-800 mb-3\">Hva er prosentfaktor?</h2>\n        <p class=\"text-gray-600 mb-4\">\n          En <strong>prosentfaktor</strong> (vekstfaktor) lar deg gjøre en prosentvis endring med én enkelt\n          multiplikasjon. I stedet for å beregne endringen separat og så legge den til eller trekke den fra,\n          multipliserer du rett og slett med faktoren.\n        </p>\n        <div class=\"formula-box rounded-lg p-4 mb-4\">\n          <p class=\"font-mono text-sm text-blue-800\">\n            Økning på p %  →  faktor = 1 + p/100<br>\n            Nedgang på p %  →  faktor = 1 − p/100<br>\n            p % av noe  →  faktor = p/100\n          </p>\n        </div>\n\n        <div class=\"grid md:grid-cols-3 gap-4 mb-6\">\n          <div class=\"bg-green-50 border border-green-200 rounded-lg p-4 text-center\">\n            <div class=\"text-3xl font-bold text-green-700\">1,20</div>\n            <div class=\"text-sm text-green-600 mt-1\">Økning på 20 %</div>\n            <div class=\"text-xs text-gray-500 mt-1\">1 + 20/100 = 1,20</div>\n          </div>\n          <div class=\"bg-red-50 border border-red-200 rounded-lg p-4 text-center\">\n            <div class=\"text-3xl font-bold text-red-700\">0,80</div>\n            <div class=\"text-sm text-red-600 mt-1\">Nedgang på 20 %</div>\n            <div class=\"text-xs text-gray-500 mt-1\">1 − 20/100 = 0,80</div>\n          </div>\n          <div class=\"bg-blue-50 border border-blue-200 rounded-lg p-4 text-center\">\n            <div class=\"text-3xl font-bold text-blue-700\">0,25</div>\n            <div class=\"text-sm text-blue-600 mt-1\">25 % av et tall</div>\n            <div class=\"text-xs text-gray-500 mt-1\">25/100 = 0,25</div>\n          </div>\n        </div>\n\n        <h3 class=\"text-lg font-semibold text-gray-700 mb-3\">Finn prosentfaktoren selv</h3>\n        <div class=\"bg-gray-50 rounded-lg p-4 space-y-4\">\n          <div class=\"flex flex-wrap gap-3 items-end\">\n            <div>\n              <label class=\"block text-sm font-medium text-gray-600 mb-1\">Type</label>\n              <select id=\"faktor-type\" onchange=\"beregnFaktor()\"\n                class=\"border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\">\n                <option value=\"okning\">Økning på</option>\n                <option value=\"nedgang\">Nedgang på</option>\n                <option value=\"andel\">Andel (p % av)</option>\n              </select>\n            </div>\n            <div>\n              <label class=\"block text-sm font-medium text-gray-600 mb-1\">Prosent (%)</label>\n              <input type=\"number\" id=\"faktor-prosent\" value=\"25\" min=\"0\" max=\"1000\" step=\"0.01\"\n                oninput=\"beregnFaktor()\"\n                class=\"border border-gray-300 rounded-lg px-3 py-2 text-sm w-28 focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n            </div>\n          </div>\n          <div id=\"faktor-resultat\" class=\"result-box rounded-lg p-4 hidden\">\n            <p class=\"font-semibold text-yellow-800\" id=\"faktor-resultat-tekst\"></p>\n            <p class=\"text-sm text-yellow-700 mt-1\" id=\"faktor-forklaring\"></p>\n          </div>\n          <div id=\"faktor-feil\" class=\"error-box rounded-lg p-3 hidden\">\n            <p class=\"text-red-700 text-sm\" id=\"faktor-feil-tekst\"></p>\n          </div>\n        </div>\n\n        <h3 class=\"text-lg font-semibold text-gray-700 mt-6 mb-3\">Eksempler fra dagliglivet</h3>\n        <div class=\"space-y-3\">\n          <div class=\"bg-gray-50 rounded-lg p-4\">\n            <p class=\"font-medium text-gray-700\">Rabatt i butikk</p>\n            <p class=\"text-sm text-gray-500 mt-1\">\n              En jakke koster 1 200 kr. Den settes ned 30 %. Vekstfaktoren er 1 − 30/100 = <strong>0,70</strong>.\n              Ny pris: 1 200 × 0,70 = <strong>840 kr</strong>.\n            </p>\n          </div>\n          <div class=\"bg-gray-50 rounded-lg p-4\">\n            <p class=\"font-medium text-gray-700\">Lønnstillegg</p>\n            <p class=\"text-sm text-gray-500 mt-1\">\n              Du tjener 42 000 kr/mnd og får 3,5 % lønnstillegg. Vekstfaktoren er 1 + 3,5/100 = <strong>1,035</strong>.\n              Ny lønn: 42 000 × 1,035 = <strong>43 470 kr</strong>.\n            </p>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- ===== TAB: HVOR MANGE PROSENT ER A AV B ===== -->\n    <section id=\"seksjon-prosent-av\" class=\"space-y-6 hidden\">\n      <div class=\"bg-white rounded-xl shadow p-6\">\n        <h2 class=\"text-xl font-bold text-gray-800 mb-2\">Hvor mange prosent er A av B?</h2>\n        <p class=\"text-gray-600 mb-4\">\n          Du vil finne ut hvilken prosentandel ett tall utgjør av et annet. Typisk spørsmål:\n          «Hvor mange prosent er 45 kr av 180 kr?»\n        </p>\n        <div class=\"formula-box rounded-lg p-4 mb-6\">\n          <p class=\"text-blue-800 font-semibold text-sm mb-1\">Formel:</p>\n          <p class=\"font-mono text-blue-700\">p = (A / B) × 100</p>\n          <p class=\"text-xs text-blue-600 mt-1\">Der A er delverdi og B er helverdi (100 %)</p>\n        </div>\n\n        <div class=\"bg-gray-50 rounded-lg p-5 space-y-4\">\n          <div class=\"grid sm:grid-cols-2 gap-4\">\n            <div>\n              <label class=\"block text-sm font-medium text-gray-600 mb-1\">\n                A – delverdi (kr eller annet)\n              </label>\n              <input type=\"number\" id=\"pa-a\" placeholder=\"f.eks. 45\" min=\"0\" step=\"0.01\"\n                oninput=\"beregnProsentAv()\"\n                class=\"border border-gray-300 rounded-lg px-3 py-2 text-sm w-full focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n            </div>\n            <div>\n              <label class=\"block text-sm font-medium text-gray-600 mb-1\">\n                B – helverdi / 100 % (kr eller annet)\n              </label>\n              <input type=\"number\" id=\"pa-b\" placeholder=\"f.eks. 180\" min=\"0.01\" step=\"0.01\"\n                oninput=\"beregnProsentAv()\"\n                class=\"border border-gray-300 rounded-lg px-3 py-2 text-sm w-full focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n            </div>\n          </div>\n\n          <div id=\"pa-resultat\" class=\"hidden space-y-3\">\n            <div class=\"result-box rounded-lg p-4\">\n              <p class=\"font-bold text-yellow-800 text-lg\" id=\"pa-svar\"></p>\n            </div>\n            <div class=\"step-box rounded-lg p-4\">\n              <p class=\"font-semibold text-green-800 mb-2\">Utregning steg for steg:</p>\n              <ol class=\"text-sm text-green-700 space-y-1 list-decimal list-inside\" id=\"pa-steg\"></ol>\n            </div>\n          </div>\n          <div id=\"pa-feil\" class=\"error-box rounded-lg p-3 hidden\">\n            <p class=\"text-red-700 text-sm\" id=\"pa-feil-tekst\"></p>\n          </div>\n        </div>\n\n        <h3 class=\"text-lg font-semibold text-gray-700 mt-6 mb-3\">Prøv disse eksemplene</h3>\n        <div class=\"grid sm:grid-cols-2 gap-3\">\n          <button onclick=\"settEksempelPA(45, 180)\"\n            class=\"text-left bg-blue-50 hover:bg-blue-100 border border-blue-200 rounded-lg p-3 transition-colors\">\n            <p class=\"text-sm font-medium text-blue-800\">Rabatt i matbutikk</p>\n            <p class=\"text-xs text-blue-600\">A = 45 kr, B = 180 kr</p>\n          </button>\n          <button onclick=\"settEksempelPA(360, 1200)\"\n            class=\"text-left bg-blue-50 hover:bg-blue-100 border border-blue-200 rounded-lg p-3 transition-colors\">\n            <p class=\"text-sm font-medium text-blue-800\">Spart på jakkesalg</p>\n            <p class=\"text-xs text-blue-600\">A = 360 kr, B = 1 200 kr</p>\n          </button>\n          <button onclick=\"settEksempelPA(1470, 42000)\"\n            class=\"text-left bg-blue-50 hover:bg-blue-100 border border-blue-200 rounded-lg p-3 transition-colors\">\n            <p class=\"text-sm font-medium text-blue-800\">Lønnstillegg</p>\n            <p class=\"text-xs text-blue-600\">A = 1 470 kr, B = 42 000 kr</p>\n          </button>\n          <button onclick=\"settEksempelPA(85, 500)\"\n            class=\"text-left bg-blue-50 hover:bg-blue-100 border border-blue-200 rounded-lg p-3 transition-colors\">\n            <p class=\"text-sm font-medium text-blue-800\">Bensinforbruk</p>\n            <p class=\"text-xs text-blue-600\">A = 85 kr, B = 500 kr</p>\n          </button>\n        </div>\n      </div>\n    </section>\n\n    <!-- ===== TAB: NY VERDI ETTER ØKNING/NEDGANG ===== -->\n    <section id=\"seksjon-ny-verdi\" class=\"space-y-6 hidden\">\n      <div class=\"bg-white rounded-xl shadow p-6\">\n        <h2 class=\"text-xl font-bold text-gray-800 mb-2\">Finn ny verdi etter prosentvis endring</h2>\n        <p class=\"text-gray-600 mb-4\">\n          Bruk prosentfaktoren til å beregne ny pris eller verdi etter en økning eller nedgang.\n        </p>\n        <div class=\"formula-box rounded-lg p-4 mb-6 space-y-1\">\n          <p class=\"text-blue-800 font-semibold text-sm mb-1\">Formel:</p>\n          <p class=\"font-mono text-blue-700\">Ny verdi = Gammel verdi × vekstfaktor</p>\n          <p class=\"font-mono text-blue-600 text-sm\">Vekstfaktor (økning) = 1 + p/100</p>\n          <p class=\"font-mono text-blue-600 text-sm\">Vekstfaktor (nedgang) = 1 − p/100</p>\n        </div>\n\n        <div class=\"bg-gray-50 rounded-lg p-5 space-y-4\">\n          <div class=\"grid sm:grid-cols-3 gap-4\">\n            <div>\n              <label class=\"block text-sm font-medium text-gray-600 mb-1\">Gammel verdi (kr)</label>\n              <input type=\"number\" id=\"nv-gammel\" placeholder=\"f.eks. 1200\" min=\"0\" step=\"0.01\"\n                oninput=\"beregnNyVerdi()\"\n                class=\"border border-gray-300 rounded-lg px-3 py-2 text-sm w-full focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n            </div>\n            <div>\n              <label class=\"block text-sm font-medium text-gray-600 mb-1\">Prosent (%)</label>\n              <input type=\"number\" id=\"nv-prosent\" placeholder=\"f.eks. 20\" min=\"0\" max=\"1000\" step=\"0.01\"\n                oninput=\"beregnNyVerdi()\"\n                class=\"border border-gray-300 rounded-lg px-3 py-2 text-sm w-full focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n            </div>\n            <div>\n              <label class=\"block text-sm font-medium text-gray-600 mb-1\">Retning</label>\n              <select id=\"nv-retning\" onchange=\"beregnNyVerdi()\"\n                class=\"border border-gray-300 rounded-lg px-3 py-2 text-sm w-full focus:outline-none focus:ring-2 focus:ring-blue-400\">\n                <option value=\"okning\">Økning</option>\n                <option value=\"nedgang\">Nedgang</option>\n              </select>\n            </div>\n          </div>\n\n          <div id=\"nv-resultat\" class=\"hidden space-y-3\">\n            <div class=\"result-box rounded-lg p-4\">\n              <p class=\"font-bold text-yellow-800 text-lg\" id=\"nv-svar\"></p>\n            </div>\n            <div class=\"step-box rounded-lg p-4\">\n              <p class=\"font-semibold text-green-800 mb-2\">Utregning steg for steg:</p>\n              <ol class=\"text-sm text-green-700 space-y-1 list-decimal list-inside\" id=\"nv-steg\"></ol>\n            </div>\n          </div>\n          <div id=\"nv-feil\" class=\"error-box rounded-lg p-3 hidden\">\n            <p class=\"text-red-700 text-sm\" id=\"nv-feil-tekst\"></p>\n          </div>\n        </div>\n\n        <h3 class=\"text-lg font-semibold text-gray-700 mt-6 mb-3\">Prøv disse eksemplene</h3>\n        <div class=\"grid sm:grid-cols-2 gap-3\">\n          <button onclick=\"settEksempelNV(1200, 30, 'nedgang')\"\n            class=\"text-left bg-blue-50 hover:bg-blue-100 border border-blue-200 rounded-lg p-3 transition-colors\">\n            <p class=\"text-sm font-medium text-blue-800\">Salg på jakke</p>\n            <p class=\"text-xs text-blue-600\">1 200 kr, nedgang 30 %</p>\n          </button>\n          <button onclick=\"settEksempelNV(42000, 3.5, 'okning')\"\n            class=\"text-left bg-blue-50 hover:bg-blue-100 border border-blue-200 rounded-lg p-3 transition-colors\">\n            <p class=\"text-sm font-medium text-blue-800\">Lønnstillegg</p>\n            <p class=\"text-xs text-blue-600\">42 000 kr/mnd, økning 3,5 %</p>\n          </button>\n          <button onclick=\"settEksempelNV(350000, 12, 'okning')\"\n            class=\"text-left bg-blue-50 hover:bg-blue-100 border border-blue-200 rounded-lg p-3 transition-colors\">\n            <p class=\"text-sm font-medium text-blue-800\">Boligverdi stiger</p>\n            <p class=\"text-xs text-blue-600\">350 000 kr, økning 12 %</p>\n          </button>\n          <button onclick=\"settEksempelNV(25000, 15, 'nedgang')\"\n            class=\"text-left bg-blue-50 hover:bg-blue-100 border border-blue-200 rounded-lg p-3 transition-colors\">\n            <p class=\"text-sm font-medium text-blue-800\">Bruktbil synker i verdi</p>\n            <p class=\"text-xs text-blue-600\">25 000 kr, nedgang 15 %</p>\n          </button>\n        </div>\n      </div>\n    </section>\n\n    <!-- ===== TAB: OPPRINNELIG VERDI ===== -->\n    <section id=\"seksjon-original\" class=\"space-y-6 hidden\">\n      <div class=\"bg-white rounded-xl shadow p-6\">\n        <h2 class=\"text-xl font-bold text-gray-800 mb-2\">Finn opprinnelig verdi</h2>\n        <p class=\"text-gray-600 mb-4\">\n          Du kjenner verdien <em>etter</em> en prosentvis endring, og vil finne verdien <em>før</em> endringen.\n          Løsningen er å dele på prosentfaktoren.\n        </p>\n        <div class=\"formula-box rounded-lg p-4 mb-6 space-y-1\">\n          <p class=\"text-blue-800 font-semibold text-sm mb-1\">Formel:</p>\n          <p class=\"font-mono text-blue-700\">Opprinnelig verdi = Ny verdi ÷ vekstfaktor</p>\n          <p class=\"text-xs text-blue-600 mt-1\">\n            Vekstfaktor (økning p %) = 1 + p/100 &nbsp;|&nbsp; Vekstfaktor (nedgang p %) = 1 − p/100\n          </p>\n        </div>\n\n        <div class=\"bg-gray-50 rounded-lg p-5 space-y-4\">\n          <div class=\"grid sm:grid-cols-3 gap-4\">\n            <div>\n              <label class=\"block text-sm font-medium text-gray-600 mb-1\">Kjent (ny) verdi (kr)</label>\n              <input type=\"number\" id=\"ov-ny\" placeholder=\"f.eks. 840\" min=\"0\" step=\"0.01\"\n                oninput=\"beregnOriginalVerdi()\"\n                class=\"border border-gray-300 rounded-lg px-3 py-2 text-sm w-full focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n            </div>\n            <div>\n              <label class=\"block text-sm font-medium text-gray-600 mb-1\">Prosent (%)</label>\n              <input type=\"number\" id=\"ov-prosent\" placeholder=\"f.eks. 30\" min=\"0\" max=\"99.99\" step=\"0.01\"\n                oninput=\"beregnOriginalVerdi()\"\n                class=\"border border-gray-300 rounded-lg px-3 py-2 text-sm w-full focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n            </div>\n            <div>\n              <label class=\"block text-sm font-medium text-gray-600 mb-1\">Endringen var</label>\n              <select id=\"ov-retning\" onchange=\"beregnOriginalVerdi()\"\n                class=\"border border-gray-300 rounded-lg px-3 py-2 text-sm w-full focus:outline-none focus:ring-2 focus:ring-blue-400\">\n                <option value=\"okning\">En økning</option>\n                <option value=\"nedgang\">En nedgang</option>\n              </select>\n            </div>\n          </div>\n\n          <div id=\"ov-resultat\" class=\"hidden space-y-3\">\n            <div class=\"result-box rounded-lg p-4\">\n              <p class=\"font-bold text-yellow-800 text-lg\" id=\"ov-svar\"></p>\n            </div>\n            <div class=\"step-box rounded-lg p-4\">\n              <p class=\"font-semibold text-green-800 mb-2\">Utregning steg for steg:</p>\n              <ol class=\"text-sm text-green-700 space-y-1 list-decimal list-inside\" id=\"ov-steg\"></ol>\n            </div>\n          </div>\n          <div id=\"ov-feil\" class=\"error-box rounded-lg p-3 hidden\">\n            <p class=\"text-red-700 text-sm\" id=\"ov-feil-tekst\"></p>\n          </div>\n        </div>\n\n        <h3 class=\"text-lg font-semibold text-gray-700 mt-6 mb-3\">Prøv disse eksemplene</h3>\n        <div class=\"grid sm:grid-cols-2 gap-3\">\n          <button onclick=\"settEksempelOV(840, 30, 'nedgang')\"\n            class=\"text-left bg-blue-50 hover:bg-blue-100 border border-blue-200 rounded-lg p-3 transition-colors\">\n            <p class=\"text-sm font-medium text-blue-800\">Jakke etter 30 % rabatt</p>\n            <p class=\"text-xs text-blue-600\">Ny pris = 840 kr, nedgang 30 %</p>\n          </button>\n          <button onclick=\"settEksempelOV(43470, 3.5, 'okning')\"\n            class=\"text-left bg-blue-50 hover:bg-blue-100 border border-blue-200 rounded-lg p-3 transition-colors\">\n            <p class=\"text-sm font-medium text-blue-800\">Lønn etter 3,5 % tillegg</p>\n            <p class=\"text-xs text-blue-600\">Ny lønn = 43 470 kr, økning 3,5 %</p>\n          </button>\n          <button onclick=\"settEksempelOV(392000, 12, 'okning')\"\n            class=\"text-left bg-blue-50 hover:bg-blue-100 border border-blue-200 rounded-lg p-3 transition-colors\">\n            <p class=\"text-sm font-medium text-blue-800\">Bolig etter 12 % prisvekst</p>\n            <p class=\"text-xs text-blue-600\">Ny verdi = 392 000 kr, økning 12 %</p>\n          </button>\n          <button onclick=\"settEksempelOV(21250, 15, 'nedgang')\"\n            class=\"text-left bg-blue-50 hover:bg-blue-100 border border-blue-200 rounded-lg p-3 transition-colors\">\n            <p class=\"text-sm font-medium text-blue-800\">Bruktbil etter verdifall</p>\n            <p class=\"text-xs text-blue-600\">Ny verdi = 21 250 kr, nedgang 15 %</p>\n          </button>\n        </div>\n      </div>\n    </section>\n\n    <!-- ===== TAB: MVA ===== -->\n    <section id=\"seksjon-mva\" class=\"space-y-6 hidden\">\n      <div class=\"bg-white rounded-xl shadow p-6\">\n        <h2 class=\"text-xl font-bold text-gray-800 mb-2\">Merverdiavgift (MVA)</h2>\n        <p class=\"text-gray-600 mb-4\">\n          Merverdiavgift (moms) er en statlig avgift som legges på varer og tjenester.\n          Den ordinære satsen i Norge er <strong>25 %</strong>. Noen varer har reduserte satser\n          (matvarer 15 %, persontransport og kino 12 %), men her bruker vi standardsatsen 25 %.\n        </p>\n\n        <div class=\"grid md:grid-cols-2 gap-4 mb-6\">\n          <div class=\"formula-box rounded-lg p-4\">\n            <p class=\"text-blue-800 font-semibold text-sm mb-2\">Legge til MVA (25 %):</p>\n            <p class=\"font-mono text-blue-700 text-sm\">Pris med MVA = Pris uten MVA × 1,25</p>\n            <p class=\"text-xs text-blue-600 mt-1\">Vekstfaktor: 1 + 25/100 = 1,25</p>\n          </div>\n          <div class=\"formula-box rounded-lg p-4\">\n            <p class=\"text-blue-800 font-semibold text-sm mb-2\">Trekke fra MVA (25 %):</p>\n            <p class=\"font-mono text-blue-700 text-sm\">Pris uten MVA = Pris med MVA ÷ 1,25</p>\n            <p class=\"text-xs text-blue-600 mt-1\">NB: del på 1,25 — ikke trekk fra 25 %!</p>\n          </div>\n        </div>\n\n        <div class=\"bg-amber-50 border border-amber-200 rounded-lg p-4 mb-6\">\n          <p class=\"text-amber-800 text-sm font-medium\">Vanlig feil:</p>\n          <p class=\"text-amber-700 text-sm mt-1\">\n            Mange tror man finner prisen uten MVA ved å trekke 25 % fra prisen med MVA.\n            Det er <strong>feil</strong>! Eksempel: 250 kr inkl. MVA.\n            Feil metode: 250 − 25 % av 250 = 250 − 62,50 = 187,50 kr (galt).\n            Riktig metode: 250 ÷ 1,25 = <strong>200 kr</strong> (riktig).\n          </p>\n        </div>\n\n        <div class=\"bg-gray-50 rounded-lg p-5 space-y-4\">\n          <div class=\"flex flex-wrap gap-3 items-center mb-2\">\n            <span class=\"text-sm font-medium text-gray-700\">Jeg vil:</span>\n            <label class=\"flex items-center gap-2 cursor-pointer\">\n              <input type=\"radio\" name=\"mva-retning\" value=\"legg-til\" id=\"mva-legg-til\" checked\n                onchange=\"beregnMVA()\"\n                class=\"accent-blue-600\" />\n              <span class=\"text-sm text-gray-700\">Legge til MVA</span>\n            </label>\n            <label class=\"flex items-center gap-2 cursor-pointer\">\n              <input type=\"radio\" name=\"mva-retning\" value=\"trekk-fra\" id=\"mva-trekk-fra\"\n                onchange=\"beregnMVA()\"\n                class=\"accent-blue-600\" />\n              <span class=\"text-sm text-gray-700\">Trekke fra MVA</span>\n            </label>\n          </div>\n\n          <div class=\"grid sm:grid-cols-2 gap-4\">\n            <div>\n              <label class=\"block text-sm font-medium text-gray-600 mb-1\" id=\"mva-input-label\">\n                Pris uten MVA (kr)\n              </label>\n              <input type=\"number\" id=\"mva-pris\" placeholder=\"f.eks. 200\" min=\"0\" step=\"0.01\"\n                oninput=\"beregnMVA()\"\n                class=\"border border-gray-300 rounded-lg px-3 py-2 text-sm w-full focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n            </div>\n            <div>\n              <label class=\"block text-sm font-medium text-gray-600 mb-1\">MVA-sats (%)</label>\n              <select id=\"mva-sats\" onchange=\"beregnMVA()\"\n                class=\"border border-gray-300 rounded-lg px-3 py-2 text-sm w-full focus:outline-none focus:ring-2 focus:ring-blue-400\">\n                <option value=\"25\">25 % (standard)</option>\n                <option value=\"15\">15 % (matvarer)</option>\n                <option value=\"12\">12 % (transport, kino)</option>\n              </select>\n            </div>\n          </div>\n\n          <div id=\"mva-resultat\" class=\"hidden space-y-3\">\n            <div class=\"result-box rounded-lg p-4\">\n              <p class=\"font-bold text-yellow-800 text-lg\" id=\"mva-svar\"></p>\n            </div>\n            <div class=\"step-box rounded-lg p-4\">\n              <p class=\"font-semibold text-green-800 mb-2\">Utregning steg for steg:</p>\n              <ol class=\"text-sm text-green-700 space-y-1 list-decimal list-inside\" id=\"mva-steg\"></ol>\n            </div>\n          </div>\n          <div id=\"mva-feil\" class=\"error-box rounded-lg p-3 hidden\">\n            <p class=\"text-red-700 text-sm\" id=\"mva-feil-tekst\"></p>\n          </div>\n        </div>\n\n        <h3 class=\"text-lg font-semibold text-gray-700 mt-6 mb-3\">Prøv disse eksemplene</h3>\n        <div class=\"grid sm:grid-cols-2 gap-3\">\n          <button onclick=\"settEksempelMVA(200, 'legg-til', 25)\"\n            class=\"text-left bg-blue-50 hover:bg-blue-100 border border-blue-200 rounded-lg p-3 transition-colors\">\n            <p class=\"text-sm font-medium text-blue-800\">Tannbørste (legg til MVA)</p>\n            <p class=\"text-xs text-blue-600\">200 kr u/MVA, sats 25 %</p>\n          </button>\n          <button onclick=\"settEksempelMVA(250, 'trekk-fra', 25)\"\n            class=\"text-left bg-blue-50 hover:bg-blue-100 border border-blue-200 rounded-lg p-3 transition-colors\">\n            <p class=\"text-sm font-medium text-blue-800\">Tannbørste (trekk fra MVA)</p>\n            <p class=\"text-xs text-blue-600\">250 kr m/MVA, sats 25 %</p>\n          </button>\n          <button onclick=\"settEksempelMVA(80, 'legg-til', 15)\"\n            class=\"text-left bg-blue-50 hover:bg-blue-100 border border-blue-200 rounded-lg p-3 transition-colors\">\n            <p class=\"text-sm font-medium text-blue-800\">Matpakke (legg til MVA)</p>\n            <p class=\"text-xs text-blue-600\">80 kr u/MVA, sats 15 %</p>\n          </button>\n          <button onclick=\"settEksempelMVA(1380, 'trekk-fra', 25)\"\n            class=\"text-left bg-blue-50 hover:bg-blue-100 border border-blue-200 rounded-lg p-3 transition-colors\">\n            <p class=\"text-sm font-medium text-blue-800\">Reparasjon (trekk fra MVA)</p>\n            <p class=\"text-xs text-blue-600\">1 380 kr m/MVA, sats 25 %</p>\n          </button>\n        </div>\n      </div>\n    </section>\n\n  </main>\n\n  <footer class=\"max-w-4xl mx-auto px-4 py-6 text-center text-xs text-gray-400\">\n    Matematikk 1P · LK20 · Sinus kap. 2.1–2.5 · Halison App Studio\n  </footer>\n\n  <script>\n    // ---- Hjelpefunksjoner ----\n\n    function norskTall(n, desimaler) {\n      if (desimaler === undefined) {\n        // Automatisk: vis opp til 4 desimaler, men fjern unødvendige nuller\n        var s = parseFloat(n.toFixed(4)).toString();\n        return s.replace('.', ',');\n      }\n      return n.toFixed(desimaler).replace('.', ',');\n    }\n\n    function norskRund(n) {\n      // For kronebeløp: vis 2 desimaler hvis ikke heltall\n      if (n === Math.floor(n)) {\n        return norskTall(n, 0);\n      }\n      return norskTall(n, 2);\n    }\n\n    // ---- Tab-navigasjon ----\n\n    var faner = ['faktor', 'prosent-av', 'ny-verdi', 'original', 'mva'];\n\n    function visTab(navn) {\n      faner.forEach(function(f) {\n        document.getElementById('seksjon-' + f).classList.add('hidden');\n        var tab = document.getElementById('tab-' + f);\n        tab.className = tab.className.replace('tab-active', 'tab-inactive');\n      });\n      document.getElementById('seksjon-' + navn).classList.remove('hidden');\n      var aktiv = document.getElementById('tab-' + navn);\n      aktiv.className = aktiv.className.replace('tab-inactive', 'tab-active');\n    }\n\n    // ---- Prosentfaktor ----\n\n    function beregnFaktor() {\n      var type = document.getElementById('faktor-type').value;\n      var prosent = parseFloat(document.getElementById('faktor-prosent').value);\n      var resEl = document.getElementById('faktor-resultat');\n      var feilEl = document.getElementById('faktor-feil');\n\n      resEl.classList.add('hidden');\n      feilEl.classList.add('hidden');\n\n      if (isNaN(prosent) || prosent < 0) {\n        document.getElementById('faktor-feil-tekst').textContent = 'Skriv inn et gyldig prosenttall (0 eller høyere).';\n        feilEl.classList.remove('hidden');\n        return;\n      }\n      if (type === 'nedgang' && prosent >= 100) {\n        document.getElementById('faktor-feil-tekst').textContent = 'En nedgang kan ikke være 100 % eller mer (da ville verdien bli 0 eller negativ).';\n        feilEl.classList.remove('hidden');\n        return;\n      }\n\n      var faktor, tekst, forklaring;\n      if (type === 'okning') {\n        faktor = 1 + prosent / 100;\n        tekst = 'Vekstfaktor for økning på ' + norskTall(prosent) + ' %: ' + norskTall(faktor);\n        forklaring = '1 + ' + norskTall(prosent) + '/100 = 1 + ' + norskTall(prosent / 100) + ' = ' + norskTall(faktor);\n      } else if (type === 'nedgang') {\n        faktor = 1 - prosent / 100;\n        tekst = 'Vekstfaktor for nedgang på ' + norskTall(prosent) + ' %: ' + norskTall(faktor);\n        forklaring = '1 − ' + norskTall(prosent) + '/100 = 1 − ' + norskTall(prosent / 100) + ' = ' + norskTall(faktor);\n      } else {\n        faktor = prosent / 100;\n        tekst = norskTall(prosent) + ' % som faktor (andel): ' + norskTall(faktor);\n        forklaring = norskTall(prosent) + '/100 = ' + norskTall(faktor);\n      }\n\n      document.getElementById('faktor-resultat-tekst').textContent = tekst;\n      document.getElementById('faktor-forklaring').textContent = forklaring;\n      resEl.classList.remove('hidden');\n    }\n\n    // ---- Prosent av tall ----\n\n    function beregnProsentAv() {\n      var a = parseFloat(document.getElementById('pa-a').value);\n      var b = parseFloat(document.getElementById('pa-b').value);\n      var resEl = document.getElementById('pa-resultat');\n      var feilEl = document.getElementById('pa-feil');\n\n      resEl.classList.add('hidden');\n      feilEl.classList.add('hidden');\n\n      if (isNaN(a) || isNaN(b)) return;\n\n      if (a < 0 || b <= 0) {\n        document.getElementById('pa-feil-tekst').textContent = 'A må være 0 eller høyere, og B må være større enn 0.';\n        feilEl.classList.remove('hidden');\n        return;\n      }\n\n      var p = (a / b) * 100;\n\n      document.getElementById('pa-svar').textContent =\n        norskRund(a) + ' kr er ' + norskTall(p, 2) + ' % av ' + norskRund(b) + ' kr';\n\n      var stegHtml = [\n        'Sett opp formelen: p = (A / B) × 100',\n        'Sett inn verdiene: p = (' + norskRund(a) + ' / ' + norskRund(b) + ') × 100',\n        'Beregn brøken: ' + norskRund(a) + ' / ' + norskRund(b) + ' = ' + norskTall(a / b),\n        'Multipliser med 100: ' + norskTall(a / b) + ' × 100 = ' + norskTall(p, 2) + ' %'\n      ];\n      document.getElementById('pa-steg').innerHTML =\n        stegHtml.map(function(s) { return '<li>' + s + '</li>'; }).join('');\n\n      resEl.classList.remove('hidden');\n    }\n\n    function settEksempelPA(a, b) {\n      document.getElementById('pa-a').value = a;\n      document.getElementById('pa-b').value = b;\n      beregnProsentAv();\n    }\n\n    // ---- Ny verdi ----\n\n    function beregnNyVerdi() {\n      var gammel = parseFloat(document.getElementById('nv-gammel').value);\n      var prosent = parseFloat(document.getElementById('nv-prosent').value);\n      var retning = document.getElementById('nv-retning').value;\n      var resEl = document.getElementById('nv-resultat');\n      var feilEl = document.getElementById('nv-feil');\n\n      resEl.classList.add('hidden');\n      feilEl.classList.add('hidden');\n\n      if (isNaN(gammel) || isNaN(prosent)) return;\n\n      if (gammel < 0) {\n        document.getElementById('nv-feil-tekst').textContent = 'Gammel verdi må være 0 eller høyere.';\n        feilEl.classList.remove('hidden');\n        return;\n      }\n      if (prosent < 0) {\n        document.getElementById('nv-feil-tekst').textContent = 'Prosenten kan ikke være negativ. Velg retning og skriv positivt tall.';\n        feilEl.classList.remove('hidden');\n        return;\n      }\n      if (retning === 'nedgang' && prosent >= 100) {\n        document.getElementById('nv-feil-tekst').textContent = 'En nedgang kan ikke være 100 % eller mer.';\n        feilEl.classList.remove('hidden');\n        return;\n      }\n\n      var faktor = retning === 'okning' ? 1 + prosent / 100 : 1 - prosent / 100;\n      var ny = gammel * faktor;\n      var endring = Math.abs(ny - gammel);\n      var retningTekst = retning === 'okning' ? 'økning' : 'nedgang';\n      var faktorFormel = retning === 'okning'\n        ? '1 + ' + norskTall(prosent) + '/100 = ' + norskTall(faktor)\n        : '1 − ' + norskTall(prosent) + '/100 = ' + norskTall(faktor);\n\n      document.getElementById('nv-svar').textContent =\n        'Ny verdi: ' + norskRund(ny) + ' kr  (' + retningTekst + ' på ' +\n        norskRund(endring) + ' kr)';\n\n      var stegHtml = [\n        'Finn vekstfaktoren: ' + faktorFormel,\n        'Sett opp formelen: Ny verdi = Gammel verdi × vekstfaktor',\n        'Sett inn verdiene: Ny verdi = ' + norskRund(gammel) + ' × ' + norskTall(faktor),\n        'Beregn: ' + norskRund(gammel) + ' × ' + norskTall(faktor) + ' = ' + norskRund(ny) + ' kr'\n      ];\n      document.getElementById('nv-steg').innerHTML =\n        stegHtml.map(function(s) { return '<li>' + s + '</li>'; }).join('');\n\n      resEl.classList.remove('hidden');\n    }\n\n    function settEksempelNV(gammel, prosent, retning) {\n      document.getElementById('nv-gammel').value = gammel;\n      document.getElementById('nv-prosent').value = prosent;\n      document.getElementById('nv-retning').value = retning;\n      beregnNyVerdi();\n    }\n\n    // ---- Opprinnelig verdi ----\n\n    function beregnOriginalVerdi() {\n      var ny = parseFloat(document.getElementById('ov-ny').value);\n      var prosent = parseFloat(document.getElementById('ov-prosent').value);\n      var retning = document.getElementById('ov-retning').value;\n      var resEl = document.getElementById('ov-resultat');\n      var feilEl = document.getElementById('ov-feil');\n\n      resEl.classList.add('hidden');\n      feilEl.classList.add('hidden');\n\n      if (isNaN(ny) || isNaN(prosent)) return;\n\n      if (ny < 0) {\n        document.getElementById('ov-feil-tekst').textContent = 'Kjent verdi må være 0 eller høyere.';\n        feilEl.classList.remove('hidden');\n        return;\n      }\n      if (prosent < 0 || prosent >= 100) {\n        document.getElementById('ov-feil-tekst').textContent = 'Prosenten må være mellom 0 og 99,99.';\n        feilEl.classList.remove('hidden');\n        return;\n      }\n\n      var faktor = retning === 'okning' ? 1 + prosent / 100 : 1 - prosent / 100;\n      if (faktor === 0) {\n        document.getElementById('ov-feil-tekst').textContent = 'Ugyldig: faktoren kan ikke være null.';\n        feilEl.classList.remove('hidden');\n        return;\n      }\n      var oppr = ny / faktor;\n      var retningTekst = retning === 'okning' ? 'økning' : 'nedgang';\n      var faktorFormel = retning === 'okning'\n        ? '1 + ' + norskTall(prosent) + '/100 = ' + norskTall(faktor)\n        : '1 − ' + norskTall(prosent) + '/100 = ' + norskTall(faktor);\n\n      document.getElementById('ov-svar').textContent =\n        'Opprinnelig verdi: ' + norskRund(oppr) + ' kr';\n\n      var stegHtml = [\n        'Finn vekstfaktoren for ' + retningTekst + 'en: ' + faktorFormel,\n        'Sett opp formelen: Opprinnelig verdi = Kjent verdi ÷ vekstfaktor',\n        'Sett inn verdiene: Opprinnelig verdi = ' + norskRund(ny) + ' ÷ ' + norskTall(faktor),\n        'Beregn: ' + norskRund(ny) + ' ÷ ' + norskTall(faktor) + ' = ' + norskRund(oppr) + ' kr',\n        'Kontroll: ' + norskRund(oppr) + ' × ' + norskTall(faktor) + ' = ' + norskRund(oppr * faktor) + ' kr ✓'\n      ];\n      document.getElementById('ov-steg').innerHTML =\n        stegHtml.map(function(s) { return '<li>' + s + '</li>'; }).join('');\n\n      resEl.classList.remove('hidden');\n    }\n\n    function settEksempelOV(ny, prosent, retning) {\n      document.getElementById('ov-ny').value = ny;\n      document.getElementById('ov-prosent').value = prosent;\n      document.getElementById('ov-retning').value = retning;\n      beregnOriginalVerdi();\n    }\n\n    // ---- MVA ----\n\n    function oppdaterMVALabel() {\n      var retning = document.querySelector('input[name=\"mva-retning\"]:checked').value;\n      var label = document.getElementById('mva-input-label');\n      label.textContent = retning === 'legg-til' ? 'Pris uten MVA (kr)' : 'Pris med MVA (kr)';\n    }\n\n    function beregnMVA() {\n      oppdaterMVALabel();\n      var pris = parseFloat(document.getElementById('mva-pris').value);\n      var sats = parseFloat(document.getElementById('mva-sats').value);\n      var retning = document.querySelector('input[name=\"mva-retning\"]:checked').value;\n      var resEl = document.getElementById('mva-resultat');\n      var feilEl = document.getElementById('mva-feil');\n\n      resEl.classList.add('hidden');\n      feilEl.classList.add('hidden');\n\n      if (isNaN(pris)) return;\n\n      if (pris < 0) {\n        document.getElementById('mva-feil-tekst').textContent = 'Prisen kan ikke være negativ.';\n        feilEl.classList.remove('hidden');\n        return;\n      }\n\n      var faktor = 1 + sats / 100;\n\n      if (retning === 'legg-til') {\n        var medMVA = pris * faktor;\n        var mvaBeloep = medMVA - pris;\n\n        document.getElementById('mva-svar').textContent =\n          'Pris med MVA: ' + norskRund(medMVA) + ' kr  (MVA-beløp: ' + norskRund(mvaBeloep) + ' kr)';\n\n        var stegHtml = [\n          'MVA-satsen er ' + norskTall(sats, 0) + ' %, vekstfaktoren er 1 + ' +\n            norskTall(sats, 0) + '/100 = ' + norskTall(faktor),\n          'Formel: Pris med MVA = Pris uten MVA × vekstfaktor',\n          'Sett inn: ' + norskRund(pris) + ' × ' + norskTall(faktor) + ' = ' + norskRund(medMVA) + ' kr',\n          'MVA-beløpet alene: ' + norskRund(medMVA) + ' − ' + norskRund(pris) + ' = ' + norskRund(mvaBeloep) + ' kr'\n        ];\n        document.getElementById('mva-steg').innerHTML =\n          stegHtml.map(function(s) { return '<li>' + s + '</li>'; }).join('');\n      } else {\n        var utenMVA = pris / faktor;\n        var mvaBeloep2 = pris - utenMVA;\n\n        document.getElementById('mva-svar').textContent =\n          'Pris uten MVA: ' + norskRund(utenMVA) + ' kr  (MVA-beløp: ' + norskRund(mvaBeloep2) + ' kr)';\n\n        var stegHtml2 = [\n          'MVA-satsen er ' + norskTall(sats, 0) + ' %, vekstfaktoren er ' + norskTall(faktor),\n          'Formel: Pris uten MVA = Pris med MVA ÷ vekstfaktor',\n          'Sett inn: ' + norskRund(pris) + ' ÷ ' + norskTall(faktor) + ' = ' + norskRund(utenMVA) + ' kr',\n          'MVA-beløpet alene: ' + norskRund(pris) + ' − ' + norskRund(utenMVA) + ' = ' + norskRund(mvaBeloep2) + ' kr',\n          'Kontroll: ' + norskRund(utenMVA) + ' × ' + norskTall(faktor) + ' = ' + norskRund(utenMVA * faktor) + ' kr ✓'\n        ];\n        document.getElementById('mva-steg').innerHTML =\n          stegHtml2.map(function(s) { return '<li>' + s + '</li>'; }).join('');\n      }\n\n      resEl.classList.remove('hidden');\n    }\n\n    function settEksempelMVA(pris, retning, sats) {\n      document.getElementById(\n        retning === 'legg-til' ? 'mva-legg-til' : 'mva-trekk-fra'\n      ).checked = true;\n      document.getElementById('mva-pris').value = pris;\n      document.getElementById('mva-sats').value = sats;\n      beregnMVA();\n    }\n\n    // ---- Init ----\n    beregnFaktor();\n  </script>\n</body>\n</html>\n",
