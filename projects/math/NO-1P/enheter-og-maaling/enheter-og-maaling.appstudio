{
  "schema": "app-studio/canvas@1",
  "id": "example-no1p-enheter-og-maaling",
  "name": "enheter-og-maaling.html",
  "code": "<!DOCTYPE html>\n<!--\n  Enheter og måling — Halison App Studio-eksempel\n\n  Interaktivt læremiddel for matematikk 1P (LK20): gjør om mellom enheter for\n  lengde, masse, volum og tid, og regn med målestokk.\n\n  Fra Halison App Studio sitt offentlige bibliotek:\n  https://github.com/halisonworks/public-app-studio\n\n  Tillatt bruk: personlig, pedagogisk og annen ikke-kommersiell bruk. Behold denne\n  headeren og kildelenken; ikke-kommersiell bruk. Utgitt under Halison App Studio\n  Examples License — se LICENSE-filen i repoet over.\n-->\n<html lang=\"no\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Enheter og måling — Matematikk 1P</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Segoe UI', system-ui, sans-serif; }\n    .tab-btn.active { background-color: #1d4ed8; color: #fff; }\n    .tab-btn { transition: background-color 0.15s, color 0.15s; }\n    .result-row:nth-child(even) { background-color: #f0f4ff; }\n    .result-row.highlight { background-color: #dbeafe; font-weight: 600; }\n    input[type=number]::-webkit-inner-spin-button,\n    input[type=number]::-webkit-outer-spin-button { opacity: 1; }\n    .prefix-card { border-left: 4px solid; }\n    .ladder-step { position: relative; }\n    .ladder-step::after {\n      content: '÷ 10 →';\n      position: absolute;\n      right: -3.5rem;\n      top: 50%;\n      transform: translateY(-50%);\n      font-size: 0.7rem;\n      color: #6b7280;\n      white-space: nowrap;\n    }\n    .ladder-step:last-child::after { content: ''; }\n    .arrow-down {\n      display: flex; align-items: center; justify-content: center;\n      color: #6b7280; font-size: 0.75rem; line-height: 1;\n    }\n  </style>\n</head>\n<body class=\"bg-gray-50 min-h-screen\">\n\n  <!-- HEADER -->\n  <header class=\"bg-blue-700 text-white shadow-md\">\n    <div class=\"max-w-4xl mx-auto px-4 py-4\">\n      <p class=\"text-blue-200 text-sm font-medium tracking-wide uppercase mb-0.5\">Matematikk 1P · LK20</p>\n      <h1 class=\"text-2xl font-bold\">Enheter og måling</h1>\n      <p class=\"text-blue-100 text-sm mt-1\">Omgjøring av enheter, målestokk og metriske prefiks</p>\n    </div>\n  </header>\n\n  <!-- NAVIGATION TABS -->\n  <nav class=\"bg-white border-b border-gray-200 shadow-sm sticky top-0 z-10\">\n    <div class=\"max-w-4xl mx-auto px-4 flex gap-1 overflow-x-auto py-2\">\n      <button class=\"tab-btn active px-4 py-2 rounded-md text-sm font-medium text-gray-700 hover:bg-blue-100\"\n              onclick=\"showSection('omgjoring')\" id=\"tab-omgjoring\">\n        🔄 Enhetomgjøring\n      </button>\n      <button class=\"tab-btn px-4 py-2 rounded-md text-sm font-medium text-gray-700 hover:bg-blue-100\"\n              onclick=\"showSection('malestokk')\" id=\"tab-malestokk\">\n        🗺️ Målestokk\n      </button>\n      <button class=\"tab-btn px-4 py-2 rounded-md text-sm font-medium text-gray-700 hover:bg-blue-100\"\n              onclick=\"showSection('prefiks')\" id=\"tab-prefiks\">\n        📐 Metriske prefiks\n      </button>\n    </div>\n  </nav>\n\n  <main class=\"max-w-4xl mx-auto px-4 py-6 space-y-6\">\n\n    <!-- ============================\n         SECTION 1: ENHETOMGJØRING\n         ============================ -->\n    <section id=\"section-omgjoring\">\n\n      <div class=\"bg-white rounded-2xl shadow-sm border border-gray-100 p-5\">\n        <h2 class=\"text-lg font-bold text-gray-800 mb-1\">Omgjøring av enheter</h2>\n        <p class=\"text-gray-500 text-sm mb-4\">\n          Velg kategori, skriv inn en verdi og velg fra-enhet. Alle tilsvarende verdier vises automatisk.\n        </p>\n\n        <!-- Category selector -->\n        <div class=\"flex flex-wrap gap-2 mb-5\">\n          <button onclick=\"setCategory('lengde')\"   id=\"cat-lengde\"   class=\"cat-btn px-3 py-1.5 rounded-full border text-sm font-medium\">📏 Lengde</button>\n          <button onclick=\"setCategory('masse')\"    id=\"cat-masse\"    class=\"cat-btn px-3 py-1.5 rounded-full border text-sm font-medium\">⚖️ Masse</button>\n          <button onclick=\"setCategory('volum')\"    id=\"cat-volum\"    class=\"cat-btn px-3 py-1.5 rounded-full border text-sm font-medium\">🧪 Volum</button>\n          <button onclick=\"setCategory('tid')\"      id=\"cat-tid\"      class=\"cat-btn px-3 py-1.5 rounded-full border text-sm font-medium\">⏱️ Tid</button>\n        </div>\n\n        <!-- Input row -->\n        <div class=\"flex flex-col sm:flex-row gap-3 mb-5\">\n          <div class=\"flex-1\">\n            <label class=\"block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1\">Verdi</label>\n            <input id=\"conv-value\" type=\"number\" value=\"1\" step=\"any\"\n                   class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-lg focus:outline-none focus:ring-2 focus:ring-blue-400\"\n                   oninput=\"runConversion()\" />\n          </div>\n          <div class=\"flex-1\">\n            <label class=\"block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1\">Fra enhet</label>\n            <select id=\"conv-from\"\n                    class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-lg focus:outline-none focus:ring-2 focus:ring-blue-400\"\n                    onchange=\"runConversion()\">\n            </select>\n          </div>\n        </div>\n\n        <!-- Results table -->\n        <div id=\"conv-results\" class=\"rounded-xl overflow-hidden border border-gray-200\"></div>\n\n        <!-- Example hint -->\n        <div id=\"conv-example\" class=\"mt-4 bg-blue-50 border border-blue-100 rounded-lg px-4 py-3 text-sm text-blue-800\"></div>\n      </div>\n    </section>\n\n    <!-- ============================\n         SECTION 2: MÅLESTOKK\n         ============================ -->\n    <section id=\"section-malestokk\" class=\"hidden\">\n\n      <div class=\"bg-white rounded-2xl shadow-sm border border-gray-100 p-5\">\n        <h2 class=\"text-lg font-bold text-gray-800 mb-1\">Målestokk</h2>\n        <p class=\"text-gray-500 text-sm mb-4\">\n          Målestokk 1 : n betyr at 1 cm på kartet tilsvarer n cm i virkeligheten.\n          Fyll inn to av tre felt — det tredje regnes ut automatisk.\n        </p>\n\n        <!-- Målestokk input -->\n        <div class=\"bg-gray-50 rounded-xl p-4 mb-5 border border-gray-200\">\n          <label class=\"block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1\">Målestokk  1 :</label>\n          <div class=\"flex items-center gap-2\">\n            <span class=\"text-gray-500 font-mono text-lg\">1 :</span>\n            <input id=\"scale-n\" type=\"number\" min=\"1\" value=\"50000\" step=\"any\"\n                   class=\"w-40 border border-gray-300 rounded-lg px-3 py-2 text-lg font-mono focus:outline-none focus:ring-2 focus:ring-blue-400\"\n                   oninput=\"handleScaleInput('n')\" />\n          </div>\n          <p class=\"text-xs text-gray-400 mt-1\">Eks: 1 : 50 000 er vanlig for turkart (1 cm = 500 m)</p>\n        </div>\n\n        <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4 mb-5\">\n          <!-- Kartavstand -->\n          <div class=\"bg-indigo-50 rounded-xl p-4 border border-indigo-100\">\n            <label class=\"block text-xs font-semibold text-indigo-600 uppercase tracking-wide mb-1\">\n              Kartavstand\n            </label>\n            <div class=\"flex gap-2 items-center\">\n              <input id=\"scale-kart\" type=\"number\" min=\"0\" step=\"any\" placeholder=\"f.eks. 3\"\n                     class=\"flex-1 border border-indigo-200 rounded-lg px-3 py-2 text-lg focus:outline-none focus:ring-2 focus:ring-indigo-400 bg-white\"\n                     oninput=\"handleScaleInput('kart')\" />\n              <select id=\"scale-kart-unit\"\n                      class=\"border border-indigo-200 rounded-lg px-2 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 bg-white\"\n                      onchange=\"handleScaleInput('kart')\">\n                <option value=\"mm\">mm</option>\n                <option value=\"cm\" selected>cm</option>\n                <option value=\"m\">m</option>\n              </select>\n            </div>\n          </div>\n\n          <!-- Virkelig avstand -->\n          <div class=\"bg-green-50 rounded-xl p-4 border border-green-100\">\n            <label class=\"block text-xs font-semibold text-green-700 uppercase tracking-wide mb-1\">\n              Virkelig avstand\n            </label>\n            <div class=\"flex gap-2 items-center\">\n              <input id=\"scale-virkelig\" type=\"number\" min=\"0\" step=\"any\" placeholder=\"f.eks. 1500\"\n                     class=\"flex-1 border border-green-200 rounded-lg px-3 py-2 text-lg focus:outline-none focus:ring-2 focus:ring-green-400 bg-white\"\n                     oninput=\"handleScaleInput('virkelig')\" />\n              <select id=\"scale-virkelig-unit\"\n                      class=\"border border-green-200 rounded-lg px-2 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-green-400 bg-white\"\n                      onchange=\"handleScaleInput('virkelig')\">\n                <option value=\"mm\">mm</option>\n                <option value=\"cm\">cm</option>\n                <option value=\"m\" selected>m</option>\n                <option value=\"km\">km</option>\n              </select>\n            </div>\n          </div>\n        </div>\n\n        <!-- Result / Formula display -->\n        <div id=\"scale-result\" class=\"bg-white border border-gray-200 rounded-xl p-4 min-h-[80px]\">\n          <p class=\"text-gray-400 text-sm italic\">Fyll inn kartavstand eller virkelig avstand for å se resultatet.</p>\n        </div>\n\n        <!-- Formula explanation -->\n        <div class=\"mt-4 bg-yellow-50 border border-yellow-100 rounded-xl p-4 text-sm text-yellow-900\">\n          <p class=\"font-semibold mb-1\">Formel</p>\n          <p>Virkelig avstand = Kartavstand × n</p>\n          <p>Kartavstand = Virkelig avstand ÷ n</p>\n          <p class=\"mt-2 text-yellow-700\">\n            Husk å bruke <strong>samme enhet</strong> på begge sider, eller konverter først!\n          </p>\n        </div>\n\n        <!-- Preset examples -->\n        <div class=\"mt-4\">\n          <p class=\"text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2\">Vanlige målestokker</p>\n          <div class=\"flex flex-wrap gap-2\">\n            <button onclick=\"loadPreset(50000, 3, 'cm', 'm')\"\n                    class=\"preset-btn px-3 py-1.5 bg-gray-100 hover:bg-blue-100 rounded-full text-xs font-medium text-gray-700 border\">\n              1:50 000 · turkart\n            </button>\n            <button onclick=\"loadPreset(25000, 4, 'cm', 'm')\"\n                    class=\"preset-btn px-3 py-1.5 bg-gray-100 hover:bg-blue-100 rounded-full text-xs font-medium text-gray-700 border\">\n              1:25 000 · detaljkart\n            </button>\n            <button onclick=\"loadPreset(100, 10, 'cm', 'm')\"\n                    class=\"preset-btn px-3 py-1.5 bg-gray-100 hover:bg-blue-100 rounded-full text-xs font-medium text-gray-700 border\">\n              1:100 · plantegning\n            </button>\n            <button onclick=\"loadPreset(1000000, 5, 'cm', 'km')\"\n                    class=\"preset-btn px-3 py-1.5 bg-gray-100 hover:bg-blue-100 rounded-full text-xs font-medium text-gray-700 border\">\n              1:1 000 000 · atlas\n            </button>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- ============================\n         SECTION 3: PREFIKS\n         ============================ -->\n    <section id=\"section-prefiks\" class=\"hidden\">\n\n      <div class=\"bg-white rounded-2xl shadow-sm border border-gray-100 p-5\">\n        <h2 class=\"text-lg font-bold text-gray-800 mb-1\">Metriske prefiks</h2>\n        <p class=\"text-gray-500 text-sm mb-5\">\n          Det metriske systemet bruker prefiks (forstavelser) for å angi størrelsesorden.\n          Hvert steg opp i stigen ganger med 10 — hvert steg ned deler med 10.\n        </p>\n\n        <!-- Prefix cards -->\n        <div class=\"space-y-3 mb-6\">\n          <div class=\"prefix-card border-purple-400 bg-purple-50 rounded-lg p-4\">\n            <div class=\"flex items-center justify-between flex-wrap gap-2\">\n              <div>\n                <span class=\"text-lg font-bold text-purple-700\">kilo (k)</span>\n                <span class=\"ml-2 text-sm text-purple-500\">= 1 000</span>\n              </div>\n              <span class=\"text-xs font-mono bg-purple-100 text-purple-700 px-2 py-1 rounded\">× 10³</span>\n            </div>\n            <p class=\"text-sm text-purple-800 mt-1\">\n              1 km = 1 000 m &nbsp;·&nbsp; 1 kg = 1 000 g &nbsp;·&nbsp; 1 kWh = 1 000 Wh\n            </p>\n          </div>\n\n          <div class=\"prefix-card border-blue-400 bg-blue-50 rounded-lg p-4\">\n            <div class=\"flex items-center justify-between flex-wrap gap-2\">\n              <div>\n                <span class=\"text-lg font-bold text-blue-700\">hekto (h)</span>\n                <span class=\"ml-2 text-sm text-blue-500\">= 100</span>\n              </div>\n              <span class=\"text-xs font-mono bg-blue-100 text-blue-700 px-2 py-1 rounded\">× 10²</span>\n            </div>\n            <p class=\"text-sm text-blue-800 mt-1\">\n              1 hg = 100 g (brukes i mat/oppskrifter) &nbsp;·&nbsp; 1 hm = 100 m\n            </p>\n          </div>\n\n          <div class=\"prefix-card border-gray-400 bg-gray-50 rounded-lg p-4\">\n            <div class=\"flex items-center justify-between flex-wrap gap-2\">\n              <div>\n                <span class=\"text-lg font-bold text-gray-700\">(grunnenhet)</span>\n                <span class=\"ml-2 text-sm text-gray-500\">= 1</span>\n              </div>\n              <span class=\"text-xs font-mono bg-gray-200 text-gray-700 px-2 py-1 rounded\">× 10⁰</span>\n            </div>\n            <p class=\"text-sm text-gray-600 mt-1\">\n              meter (m) &nbsp;·&nbsp; gram (g) &nbsp;·&nbsp; liter (L) &nbsp;·&nbsp; sekund (s)\n            </p>\n          </div>\n\n          <div class=\"prefix-card border-orange-400 bg-orange-50 rounded-lg p-4\">\n            <div class=\"flex items-center justify-between flex-wrap gap-2\">\n              <div>\n                <span class=\"text-lg font-bold text-orange-700\">desi (d)</span>\n                <span class=\"ml-2 text-sm text-orange-500\">= 0,1</span>\n              </div>\n              <span class=\"text-xs font-mono bg-orange-100 text-orange-700 px-2 py-1 rounded\">× 10⁻¹</span>\n            </div>\n            <p class=\"text-sm text-orange-800 mt-1\">\n              1 dm = 0,1 m &nbsp;·&nbsp; 1 dL = 0,1 L (brukes på melk og juice)\n            </p>\n          </div>\n\n          <div class=\"prefix-card border-red-400 bg-red-50 rounded-lg p-4\">\n            <div class=\"flex items-center justify-between flex-wrap gap-2\">\n              <div>\n                <span class=\"text-lg font-bold text-red-700\">centi (c)</span>\n                <span class=\"ml-2 text-sm text-red-500\">= 0,01</span>\n              </div>\n              <span class=\"text-xs font-mono bg-red-100 text-red-700 px-2 py-1 rounded\">× 10⁻²</span>\n            </div>\n            <p class=\"text-sm text-red-800 mt-1\">\n              1 cm = 0,01 m &nbsp;·&nbsp; 1 cL = 0,01 L (brukes på sjokoladekartong)\n            </p>\n          </div>\n\n          <div class=\"prefix-card border-pink-400 bg-pink-50 rounded-lg p-4\">\n            <div class=\"flex items-center justify-between flex-wrap gap-2\">\n              <div>\n                <span class=\"text-lg font-bold text-pink-700\">milli (m)</span>\n                <span class=\"ml-2 text-sm text-pink-500\">= 0,001</span>\n              </div>\n              <span class=\"text-xs font-mono bg-pink-100 text-pink-700 px-2 py-1 rounded\">× 10⁻³</span>\n            </div>\n            <p class=\"text-sm text-pink-800 mt-1\">\n              1 mm = 0,001 m &nbsp;·&nbsp; 1 mg = 0,001 g (brukes i medisin)\n            </p>\n          </div>\n        </div>\n\n        <!-- The ladder visual -->\n        <div class=\"bg-gradient-to-b from-indigo-50 to-white rounded-xl border border-indigo-100 p-5\">\n          <p class=\"text-sm font-semibold text-indigo-800 mb-3 text-center\">Enhetsstigen for lengde</p>\n\n          <div class=\"flex flex-col items-center gap-0\">\n            <div class=\"bg-purple-100 border border-purple-300 rounded-lg px-6 py-2 text-center w-40 text-sm font-semibold text-purple-800\">km</div>\n            <div class=\"arrow-down py-1 text-gray-400\">\n              <span class=\"text-xs\">× 1 000 ↓ &nbsp; ÷ 1 000 ↑</span>\n            </div>\n            <div class=\"bg-blue-100 border border-blue-300 rounded-lg px-6 py-2 text-center w-40 text-sm font-semibold text-blue-800\">hm</div>\n            <div class=\"arrow-down py-1 text-gray-400\">\n              <span class=\"text-xs\">× 10 ↓ &nbsp; ÷ 10 ↑</span>\n            </div>\n            <div class=\"bg-teal-100 border border-teal-300 rounded-lg px-6 py-2 text-center w-40 text-sm font-semibold text-teal-800\">dam</div>\n            <div class=\"arrow-down py-1 text-gray-400\">\n              <span class=\"text-xs\">× 10 ↓ &nbsp; ÷ 10 ↑</span>\n            </div>\n            <div class=\"bg-gray-100 border border-gray-400 rounded-lg px-6 py-2 text-center w-40 text-sm font-bold text-gray-800\">m</div>\n            <div class=\"arrow-down py-1 text-gray-400\">\n              <span class=\"text-xs\">× 10 ↓ &nbsp; ÷ 10 ↑</span>\n            </div>\n            <div class=\"bg-orange-100 border border-orange-300 rounded-lg px-6 py-2 text-center w-40 text-sm font-semibold text-orange-800\">dm</div>\n            <div class=\"arrow-down py-1 text-gray-400\">\n              <span class=\"text-xs\">× 10 ↓ &nbsp; ÷ 10 ↑</span>\n            </div>\n            <div class=\"bg-red-100 border border-red-300 rounded-lg px-6 py-2 text-center w-40 text-sm font-semibold text-red-800\">cm</div>\n            <div class=\"arrow-down py-1 text-gray-400\">\n              <span class=\"text-xs\">× 10 ↓ &nbsp; ÷ 10 ↑</span>\n            </div>\n            <div class=\"bg-pink-100 border border-pink-300 rounded-lg px-6 py-2 text-center w-40 text-sm font-semibold text-pink-800\">mm</div>\n          </div>\n\n          <p class=\"text-xs text-gray-500 text-center mt-3\">\n            Går du <strong>ned</strong> ett steg → gang med 10. &nbsp; Går du <strong>opp</strong> ett steg → del med 10.\n          </p>\n        </div>\n\n        <!-- Tid forklaring -->\n        <div class=\"mt-5 bg-amber-50 border border-amber-100 rounded-xl p-4\">\n          <p class=\"font-semibold text-amber-900 mb-2\">Tid er annerledes!</p>\n          <p class=\"text-sm text-amber-800\">\n            Tid følger <strong>ikke</strong> det desimale (10-baserte) systemet:\n          </p>\n          <ul class=\"text-sm text-amber-800 mt-2 space-y-1 list-disc list-inside\">\n            <li>1 minutt = <strong>60</strong> sekunder</li>\n            <li>1 time = <strong>60</strong> minutter = 3 600 sekunder</li>\n            <li>1 døgn = <strong>24</strong> timer = 86 400 sekunder</li>\n          </ul>\n          <p class=\"text-xs text-amber-600 mt-2\">\n            Dette systemet stammer fra det babylonske 60-tallssystemet (sexagesimalsystemet), som er over 4 000 år gammelt.\n          </p>\n        </div>\n      </div>\n    </section>\n\n  </main>\n\n  <footer class=\"max-w-4xl mx-auto px-4 py-6 mt-4 text-center text-xs text-gray-400 border-t border-gray-200\">\n    Matematikk 1P · LK20 · Halison App Studio ·\n    <a href=\"https://github.com/halisonworks/public-app-studio\" class=\"underline hover:text-blue-500\" target=\"_blank\" rel=\"noopener\">\n      public-app-studio\n    </a>\n  </footer>\n\n  <script>\n    // =========================================================\n    //  DATA: categories, units, conversion factors to base unit\n    // =========================================================\n    const categories = {\n      lengde: {\n        label: 'Lengde',\n        units: [\n          { id: 'mm',  label: 'millimeter (mm)',  toBase: 0.001 },\n          { id: 'cm',  label: 'centimeter (cm)',  toBase: 0.01 },\n          { id: 'dm',  label: 'desimeter (dm)',   toBase: 0.1 },\n          { id: 'm',   label: 'meter (m)',         toBase: 1 },\n          { id: 'km',  label: 'kilometer (km)',    toBase: 1000 },\n        ],\n        base: 'm',\n        examples: {\n          mm: 'En knappenål er ca. 1 mm tykk.',\n          cm: 'En tommeltott er ca. 2 cm bred.',\n          dm: 'En linjal er typisk 3 dm (30 cm) lang.',\n          m:  'En dør er ca. 2 m høy.',\n          km: 'En gjennomsnittlig skoledag innebærer ca. 1–2 km gange.',\n        }\n      },\n      masse: {\n        label: 'Masse',\n        units: [\n          { id: 'mg',   label: 'milligram (mg)',  toBase: 0.000001 },\n          { id: 'g',    label: 'gram (g)',         toBase: 0.001 },\n          { id: 'hg',   label: 'hektogram (hg)',  toBase: 0.1 },\n          { id: 'kg',   label: 'kilogram (kg)',    toBase: 1 },\n          { id: 'tonn', label: 'tonn (t)',         toBase: 1000 },\n        ],\n        base: 'kg',\n        examples: {\n          mg:   'Et vanlig smertestillende tablett inneholder 500 mg virkestoff.',\n          g:    'En skive hvetebrød veier ca. 30 g.',\n          hg:   'Et eple veier typisk ca. 2 hg (200 g).',\n          kg:   'En voksen katt veier ca. 4 kg.',\n          tonn: 'En personbil veier ca. 1,5 tonn.',\n        }\n      },\n      volum: {\n        label: 'Volum',\n        units: [\n          { id: 'mL', label: 'milliliter (mL)', toBase: 0.001 },\n          { id: 'cL', label: 'centiliter (cL)', toBase: 0.01 },\n          { id: 'dL', label: 'desiliter (dL)',  toBase: 0.1 },\n          { id: 'L',  label: 'liter (L)',        toBase: 1 },\n        ],\n        base: 'L',\n        examples: {\n          mL: 'En teskje er ca. 5 mL.',\n          cL: 'En kopp espresso er typisk 3–4 cL.',\n          dL: 'En vanlig kaffekopp rommer ca. 2 dL.',\n          L:  'En flaske brus er 0,5 L eller 1,5 L.',\n        }\n      },\n      tid: {\n        label: 'Tid',\n        units: [\n          { id: 'sek',    label: 'sekund (s)',    toBase: 1 },\n          { id: 'min',    label: 'minutt (min)',  toBase: 60 },\n          { id: 'time',   label: 'time (t)',       toBase: 3600 },\n          { id: 'dogn',   label: 'døgn (d)',       toBase: 86400 },\n        ],\n        base: 'sek',\n        examples: {\n          sek:  'Det tar ca. 1 sekund å ta et skritt.',\n          min:  'En runde med skipping tar ca. 3 minutter.',\n          time: 'En skoletime varer 45–60 minutter, dvs. under 1 time.',\n          dogn: 'Et år er 365 døgn (366 i skuddår).',\n        }\n      }\n    };\n\n    // =========================================================\n    //  STATE\n    // =========================================================\n    let currentCategory = 'lengde';\n    let lastScaleInput = null; // 'kart' | 'virkelig'\n\n    // =========================================================\n    //  SECTION NAVIGATION\n    // =========================================================\n    function showSection(name) {\n      ['omgjoring', 'malestokk', 'prefiks'].forEach(s => {\n        document.getElementById('section-' + s).classList.add('hidden');\n        document.getElementById('tab-' + s).classList.remove('active');\n      });\n      document.getElementById('section-' + name).classList.remove('hidden');\n      document.getElementById('tab-' + name).classList.add('active');\n    }\n\n    // =========================================================\n    //  UNIT CONVERSION\n    // =========================================================\n    function setCategory(cat) {\n      currentCategory = cat;\n      // update category button styles\n      Object.keys(categories).forEach(k => {\n        const btn = document.getElementById('cat-' + k);\n        if (btn) {\n          if (k === cat) {\n            btn.className = 'cat-btn px-3 py-1.5 rounded-full border text-sm font-medium bg-blue-600 text-white border-blue-600';\n          } else {\n            btn.className = 'cat-btn px-3 py-1.5 rounded-full border text-sm font-medium bg-white text-gray-700 hover:bg-blue-50';\n          }\n        }\n      });\n      // rebuild unit dropdown\n      const sel = document.getElementById('conv-from');\n      sel.innerHTML = '';\n      categories[cat].units.forEach(u => {\n        const opt = document.createElement('option');\n        opt.value = u.id;\n        opt.textContent = u.label;\n        sel.appendChild(opt);\n      });\n      // default to base unit\n      sel.value = categories[cat].base;\n      runConversion();\n    }\n\n    function formatNumber(n) {\n      if (n === 0) return '0';\n      const abs = Math.abs(n);\n      // For very small or very large, use scientific notation\n      if (abs !== 0 && (abs < 0.0001 || abs >= 1e10)) {\n        return n.toExponential(4).replace('.', ',');\n      }\n      // Otherwise: up to 8 significant digits, trim trailing zeros\n      let str = parseFloat(n.toPrecision(8)).toString().replace('.', ',');\n      return str;\n    }\n\n    function runConversion() {\n      const cat = categories[currentCategory];\n      const raw = document.getElementById('conv-value').value;\n      const fromId = document.getElementById('conv-from').value;\n      const value = parseFloat(raw);\n\n      const resultsEl = document.getElementById('conv-results');\n      const exampleEl = document.getElementById('conv-example');\n\n      if (isNaN(value)) {\n        resultsEl.innerHTML = '<p class=\"text-gray-400 text-sm p-4 italic\">Skriv inn et tall i feltet over.</p>';\n        exampleEl.textContent = '';\n        return;\n      }\n\n      const fromUnit = cat.units.find(u => u.id === fromId);\n      // value in base unit\n      const baseValue = value * fromUnit.toBase;\n\n      // Build table\n      let html = '<table class=\"w-full text-sm\">';\n      html += '<thead><tr class=\"bg-gray-100 text-gray-600 text-xs uppercase\">';\n      html += '<th class=\"text-left px-4 py-2 font-semibold\">Enhet</th>';\n      html += '<th class=\"text-right px-4 py-2 font-semibold\">Verdi</th>';\n      html += '<th class=\"text-right px-4 py-2 font-semibold hidden sm:table-cell\">Faktor fra base</th>';\n      html += '</tr></thead><tbody>';\n\n      cat.units.forEach(u => {\n        const converted = baseValue / u.toBase;\n        const isFrom = u.id === fromId;\n        const rowClass = isFrom ? 'result-row highlight' : 'result-row';\n        html += `<tr class=\"${rowClass}\">`;\n        html += `<td class=\"px-4 py-2.5 font-medium text-gray-700\">${u.label}${isFrom ? ' <span class=\"text-blue-500 text-xs\">(valgt)</span>' : ''}</td>`;\n        html += `<td class=\"px-4 py-2.5 text-right font-mono text-gray-900\">${formatNumber(converted)}</td>`;\n        html += `<td class=\"px-4 py-2.5 text-right text-gray-400 text-xs hidden sm:table-cell\">1 ${cat.base} = ${formatNumber(1 / u.toBase)} ${u.id}</td>`;\n        html += `</tr>`;\n      });\n\n      html += '</tbody></table>';\n      resultsEl.innerHTML = html;\n\n      // Example\n      if (cat.examples && cat.examples[fromId]) {\n        exampleEl.innerHTML = '<strong>Eksempel:</strong> ' + cat.examples[fromId];\n      } else {\n        exampleEl.textContent = '';\n      }\n    }\n\n    // =========================================================\n    //  MÅLESTOKK\n    // =========================================================\n    // Convert to base unit (cm) for internal calculation\n    const lengthToCm = { mm: 0.1, cm: 1, m: 100, km: 100000 };\n\n    function handleScaleInput(changed) {\n      const n = parseFloat(document.getElementById('scale-n').value);\n      const kartVal = document.getElementById('scale-kart').value;\n      const kartUnit = document.getElementById('scale-kart-unit').value;\n      const virkeligVal = document.getElementById('scale-virkelig').value;\n      const virkeligUnit = document.getElementById('scale-virkelig-unit').value;\n\n      const resultEl = document.getElementById('scale-result');\n\n      if (isNaN(n) || n <= 0) {\n        resultEl.innerHTML = '<p class=\"text-red-500 text-sm\">Målestokk n må være et positivt tall.</p>';\n        return;\n      }\n\n      if (changed === 'kart' || changed === 'n') {\n        // Compute virkelig from kart\n        const kv = parseFloat(kartVal);\n        if (!isNaN(kv) && kv >= 0) {\n          const kartCm = kv * lengthToCm[kartUnit];\n          const virkeligCm = kartCm * n;\n          // Show in chosen output unit\n          const virkelig = virkeligCm / lengthToCm[virkeligUnit];\n          document.getElementById('scale-virkelig').value = parseFloat(virkelig.toPrecision(7));\n          showScaleResult(n, kv, kartUnit, virkelig, virkeligUnit, 'kart');\n        }\n      } else if (changed === 'virkelig') {\n        // Compute kart from virkelig\n        const vv = parseFloat(virkeligVal);\n        if (!isNaN(vv) && vv >= 0) {\n          const virkeligCm = vv * lengthToCm[virkeligUnit];\n          const kartCm = virkeligCm / n;\n          const kart = kartCm / lengthToCm[kartUnit];\n          document.getElementById('scale-kart').value = parseFloat(kart.toPrecision(7));\n          showScaleResult(n, kart, kartUnit, vv, virkeligUnit, 'virkelig');\n        }\n      }\n    }\n\n    function showScaleResult(n, kartVal, kartUnit, virkeligVal, virkeligUnit, source) {\n      const resultEl = document.getElementById('scale-result');\n      const kartFmt = formatNumber(kartVal);\n      const virkeligFmt = formatNumber(virkeligVal);\n\n      const sourceLbl = source === 'kart'\n        ? `Gitt <strong>${kartFmt} ${kartUnit}</strong> på kartet med målestokk 1 : ${n.toLocaleString('no')}`\n        : `Gitt <strong>${virkeligFmt} ${virkeligUnit}</strong> i virkeligheten med målestokk 1 : ${n.toLocaleString('no')}`;\n\n      resultEl.innerHTML = `\n        <p class=\"text-xs text-gray-400 mb-2\">${sourceLbl}</p>\n        <div class=\"flex flex-wrap gap-4\">\n          <div class=\"flex-1 min-w-[120px] bg-indigo-50 rounded-lg p-3 border border-indigo-100\">\n            <p class=\"text-xs text-indigo-500 font-semibold uppercase\">Kartavstand</p>\n            <p class=\"text-xl font-bold text-indigo-800\">${formatNumber(kartVal)} <span class=\"text-sm font-normal\">${kartUnit}</span></p>\n          </div>\n          <div class=\"flex items-center text-gray-400 font-bold text-xl\">↔</div>\n          <div class=\"flex-1 min-w-[120px] bg-green-50 rounded-lg p-3 border border-green-100\">\n            <p class=\"text-xs text-green-600 font-semibold uppercase\">Virkelig avstand</p>\n            <p class=\"text-xl font-bold text-green-800\">${formatNumber(virkeligVal)} <span class=\"text-sm font-normal\">${virkeligUnit}</span></p>\n          </div>\n        </div>\n        <p class=\"text-xs text-gray-400 mt-3\">\n          Utregning: ${formatNumber(kartVal)} ${kartUnit} × ${n.toLocaleString('no')} = ${formatNumber(virkeligVal * (lengthToCm[virkeligUnit] / lengthToCm[kartUnit] * 1))} ${kartUnit} = ${formatNumber(virkeligVal)} ${virkeligUnit}\n        </p>\n      `;\n    }\n\n    function loadPreset(n, kartVal, kartUnit, virkeligUnit) {\n      document.getElementById('scale-n').value = n;\n      document.getElementById('scale-kart').value = kartVal;\n      document.getElementById('scale-kart-unit').value = kartUnit;\n      document.getElementById('scale-virkelig-unit').value = virkeligUnit;\n      document.getElementById('scale-virkelig').value = '';\n      handleScaleInput('kart');\n    }\n\n    // =========================================================\n    //  INIT\n    // =========================================================\n    (function init() {\n      setCategory('lengde');\n      // Initialize scale preset\n      loadPreset(50000, 3, 'cm', 'm');\n    })();\n  </script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Enheter og måling",
    "windowTitle": "Enheter og måling",
    "bundleId": "com.halisonworks.enhetermaaling",
    "iconPath": null
  },
  "categoryId": null,
  "source": "import",
  "createdAt": "2026-06-02T12:00:00.000Z",
  "updatedAt": "2026-06-02T12:00:00.000Z",
  "sharedAt": "2026-06-02T12:00:00.000Z"
}
