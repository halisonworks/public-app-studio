{
  "schema": "app-studio/canvas@1",
  "id": "example-no1p-lonn-og-skatt",
  "name": "lonn-og-skatt.html",
  "code": "<!DOCTYPE html>\n<!--\n  Lønn og skatt — Halison App Studio-eksempel\n\n  Interaktivt læremiddel for matematikk 1P (LK20): fra bruttolønn til nettolønn\n  med trekkprosent og feriepenger, med formler og en visuell fordeling.\n\n  Fra Halison App Studio sitt offentlige bibliotek:\n  https://github.com/halisonworks/public-app-studio\n\n  Tillatt bruk: personlig, pedagogisk og annen ikke-kommersiell bruk. Behold denne\n  headeren og kildelenken; ikke-kommersiell bruk. Utgitt under Halison App Studio\n  Examples License — se LICENSE-filen i repoet over.\n-->\n<html lang=\"no\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Lønn og skatt — Matematikk 1P</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Segoe UI', system-ui, sans-serif; }\n    .bar-transition { transition: width 0.5s ease; }\n    input[type=range] { accent-color: #3b82f6; }\n    .formula-box {\n      font-family: 'Courier New', Courier, monospace;\n    }\n  </style>\n</head>\n<body class=\"bg-slate-50 min-h-screen\">\n\n  <div class=\"max-w-2xl mx-auto px-4 py-8\">\n\n    <!-- Header -->\n    <header class=\"mb-8\">\n      <p class=\"text-xs font-semibold uppercase tracking-widest text-blue-500 mb-1\">Matematikk 1P · LK20</p>\n      <h1 class=\"text-3xl font-bold text-slate-800\">Lønn og skatt</h1>\n      <p class=\"text-slate-500 mt-1 text-sm\">Beregn nettolønn fra bruttolønn, trekkprosent og feriepenger.</p>\n    </header>\n\n    <!-- Input card -->\n    <section class=\"bg-white rounded-2xl shadow-sm border border-slate-200 p-6 mb-6\">\n      <h2 class=\"text-lg font-semibold text-slate-700 mb-5\">Innstillinger</h2>\n\n      <!-- Periode -->\n      <div class=\"mb-5\">\n        <label class=\"block text-sm font-medium text-slate-600 mb-2\">Lønnsperiode</label>\n        <div class=\"flex gap-3\">\n          <button id=\"btn-maaned\"\n            class=\"flex-1 py-2 rounded-lg border-2 text-sm font-semibold transition-colors\"\n            onclick=\"setPeriode('maaned')\">\n            Per måned\n          </button>\n          <button id=\"btn-aar\"\n            class=\"flex-1 py-2 rounded-lg border-2 text-sm font-semibold transition-colors\"\n            onclick=\"setPeriode('aar')\">\n            Per år\n          </button>\n        </div>\n      </div>\n\n      <!-- Bruttolønn -->\n      <div class=\"mb-5\">\n        <label for=\"bruttolonn\" class=\"block text-sm font-medium text-slate-600 mb-1\">\n          Bruttolønn (<span id=\"periode-label\">per måned</span>)\n        </label>\n        <div class=\"flex items-center gap-3\">\n          <input\n            type=\"range\" id=\"bruttolonn-slider\"\n            min=\"10000\" max=\"150000\" step=\"500\"\n            class=\"flex-1\"\n            oninput=\"syncFromSlider()\"\n          />\n          <div class=\"relative\">\n            <input\n              type=\"number\" id=\"bruttolonn\"\n              min=\"0\" max=\"9999999\"\n              class=\"w-32 border border-slate-300 rounded-lg px-3 py-2 text-right text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\"\n              oninput=\"syncFromInput()\"\n            />\n            <span class=\"absolute right-2 top-2 text-slate-400 text-xs pointer-events-none\">kr</span>\n          </div>\n        </div>\n        <p class=\"text-xs text-slate-400 mt-1\">Typisk månedslønn i Norge: 35 000 – 65 000 kr</p>\n      </div>\n\n      <!-- Trekkprosent -->\n      <div class=\"mb-5\">\n        <label for=\"trekkprosent-slider\" class=\"block text-sm font-medium text-slate-600 mb-1\">\n          Trekkprosent (skatteprosent)\n        </label>\n        <div class=\"flex items-center gap-3\">\n          <input\n            type=\"range\" id=\"trekkprosent-slider\"\n            min=\"0\" max=\"60\" step=\"0.5\"\n            class=\"flex-1\"\n            oninput=\"syncTrekkFromSlider()\"\n          />\n          <div class=\"relative\">\n            <input\n              type=\"number\" id=\"trekkprosent\"\n              min=\"0\" max=\"100\" step=\"0.1\"\n              class=\"w-24 border border-slate-300 rounded-lg px-3 py-2 text-right text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\"\n              oninput=\"syncTrekkFromInput()\"\n            />\n            <span class=\"absolute right-2 top-2 text-slate-400 text-xs pointer-events-none\">%</span>\n          </div>\n        </div>\n        <p class=\"text-xs text-slate-400 mt-1\">Vanlig trekkprosent: 22 – 38 %</p>\n      </div>\n\n      <!-- Feriepenger -->\n      <div class=\"mb-2\">\n        <div class=\"flex items-center justify-between mb-2\">\n          <label class=\"text-sm font-medium text-slate-600\">Feriepenger</label>\n          <button\n            id=\"toggle-ferie\"\n            onclick=\"toggleFerie()\"\n            class=\"relative inline-flex h-6 w-11 items-center rounded-full transition-colors focus:outline-none\"\n            role=\"switch\" aria-checked=\"false\">\n            <span id=\"toggle-ferie-knob\" class=\"inline-block h-4 w-4 transform rounded-full bg-white shadow transition-transform\"></span>\n          </button>\n        </div>\n        <div id=\"ferie-inputs\" class=\"hidden\">\n          <div class=\"flex items-center gap-3 mt-2\">\n            <label class=\"text-sm text-slate-500 flex-1\">Feriepengersats</label>\n            <div class=\"relative\">\n              <input\n                type=\"number\" id=\"feriesats\"\n                min=\"0\" max=\"20\" step=\"0.1\" value=\"10.2\"\n                class=\"w-24 border border-slate-300 rounded-lg px-3 py-2 text-right text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\"\n                oninput=\"beregn()\"\n              />\n              <span class=\"absolute right-2 top-2 text-slate-400 text-xs pointer-events-none\">%</span>\n            </div>\n          </div>\n          <p class=\"text-xs text-slate-400 mt-1\">Lovpålagt minimum: 10,2 % (12 % for arbeidstakere over 60 år)</p>\n        </div>\n      </div>\n\n    </section>\n\n    <!-- Resultat card -->\n    <section id=\"resultat-kort\" class=\"bg-white rounded-2xl shadow-sm border border-slate-200 p-6 mb-6\">\n      <h2 class=\"text-lg font-semibold text-slate-700 mb-5\">Beregning</h2>\n\n      <!-- Visuell fordeling -->\n      <div class=\"mb-6\">\n        <div class=\"flex justify-between text-xs font-medium mb-1\">\n          <span class=\"text-green-600\">Nettolønn</span>\n          <span class=\"text-red-500\">Skatt</span>\n        </div>\n        <div class=\"flex rounded-full overflow-hidden h-8 bg-slate-100\">\n          <div id=\"bar-netto\" class=\"bar-transition bg-green-400 flex items-center justify-center text-xs font-bold text-white\" style=\"width:70%\">\n            <span id=\"bar-netto-label\"></span>\n          </div>\n          <div id=\"bar-skatt\" class=\"bar-transition bg-red-400 flex items-center justify-center text-xs font-bold text-white\" style=\"width:30%\">\n            <span id=\"bar-skatt-label\"></span>\n          </div>\n        </div>\n      </div>\n\n      <!-- Talloversikt -->\n      <div class=\"space-y-3 mb-6\">\n        <div class=\"flex justify-between items-center py-2 border-b border-slate-100\">\n          <span class=\"text-slate-600 text-sm\">Bruttolønn</span>\n          <span id=\"res-brutto\" class=\"font-semibold text-slate-800\">—</span>\n        </div>\n        <div class=\"flex justify-between items-center py-2 border-b border-slate-100\">\n          <span class=\"text-slate-600 text-sm\">Skatt (trekk)</span>\n          <span id=\"res-skatt\" class=\"font-semibold text-red-500\">—</span>\n        </div>\n        <div class=\"flex justify-between items-center py-2 border-b border-slate-100 bg-green-50 rounded-lg px-2\">\n          <span class=\"text-slate-700 text-sm font-semibold\">Nettolønn (utbetalt)</span>\n          <span id=\"res-netto\" class=\"font-bold text-green-600 text-lg\">—</span>\n        </div>\n        <div id=\"res-aarslonn-rad\" class=\"flex justify-between items-center py-2 border-b border-slate-100 hidden\">\n          <span class=\"text-slate-500 text-sm\">Årslønn (brutto)</span>\n          <span id=\"res-aarslonn\" class=\"font-semibold text-slate-600\">—</span>\n        </div>\n        <div id=\"res-ferie-rad\" class=\"flex justify-between items-center py-2 hidden\">\n          <span class=\"text-slate-500 text-sm\">Feriepenger</span>\n          <span id=\"res-ferie\" class=\"font-semibold text-blue-500\">—</span>\n        </div>\n      </div>\n\n      <!-- Formler -->\n      <div class=\"formula-box bg-slate-50 rounded-xl p-4 border border-slate-200\">\n        <p class=\"text-xs font-semibold uppercase text-slate-400 mb-3 tracking-wider\">Formler brukt</p>\n        <div class=\"space-y-2 text-sm text-slate-700\">\n          <div class=\"flex flex-col gap-0.5\">\n            <span class=\"text-slate-500 text-xs\">Skatt:</span>\n            <span>skatt = bruttolønn × trekkprosent / 100</span>\n            <span id=\"formel-skatt-tall\" class=\"text-slate-500 text-xs\"></span>\n          </div>\n          <div class=\"border-t border-slate-200 pt-2 flex flex-col gap-0.5\">\n            <span class=\"text-slate-500 text-xs\">Nettolønn:</span>\n            <span>nettolønn = bruttolønn − skatt</span>\n            <span id=\"formel-netto-tall\" class=\"text-slate-500 text-xs\"></span>\n          </div>\n          <div id=\"formel-ferie-blokk\" class=\"border-t border-slate-200 pt-2 hidden flex flex-col gap-0.5\">\n            <span class=\"text-slate-500 text-xs\">Feriepenger:</span>\n            <span>feriepenger = årslønn × feriesats / 100</span>\n            <span id=\"formel-ferie-tall\" class=\"text-slate-500 text-xs\"></span>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- Forklaring -->\n    <section class=\"bg-blue-50 border border-blue-200 rounded-2xl p-6 mb-8\">\n      <h2 class=\"text-base font-semibold text-blue-800 mb-3\">Hva betyr disse begrepene?</h2>\n      <dl class=\"space-y-3 text-sm text-slate-700\">\n        <div>\n          <dt class=\"font-semibold text-slate-800\">Bruttolønn</dt>\n          <dd>Den totale lønnen du tjener, <em>før</em> skatt og andre trekk. Dette er beløpet du avtaler med arbeidsgiver.</dd>\n        </div>\n        <div>\n          <dt class=\"font-semibold text-slate-800\">Trekkprosent (skatteprosent)</dt>\n          <dd>Andelen av bruttolønnen som trekkes i skatt. Her bruker vi en forenklet, fast sats. I virkeligheten beregnes norsk inntektsskatt med ulike trinn (trinnskatt), personfradrag og arbeidsgiveravgift — det er mer sammensatt enn én fast prosent.</dd>\n        </div>\n        <div>\n          <dt class=\"font-semibold text-slate-800\">Nettolønn</dt>\n          <dd>Det du faktisk får utbetalt på konto etter at skattetrekket er trukket fra. Nettolønn = bruttolønn − skatt.</dd>\n        </div>\n        <div>\n          <dt class=\"font-semibold text-slate-800\">Feriepenger</dt>\n          <dd>Feriepenger er opptjent lønn fra året <em>før</em>. Arbeidsgiver er lovpålagt å betale minst 10,2 % av feriepengegrunnlaget (årslønn). Feriepengene erstatter vanlig lønn under ferien. Beløpet over er en forenkling basert på brutto årslønn.</dd>\n        </div>\n      </dl>\n    </section>\n\n    <footer class=\"text-center text-xs text-slate-400 pb-4\">\n      Matematikk 1P · LK20 · Halison App Studio\n    </footer>\n\n  </div>\n\n  <script>\n    // ---- State ----\n    var state = {\n      periode: 'maaned',\n      brutto: 45000,\n      trekkprosent: 27,\n      ferieAktivert: false,\n      feriesats: 10.2\n    };\n\n    // ---- Init ----\n    function init() {\n      var saved = null;\n      try { saved = JSON.parse(localStorage.getItem('lonn-skatt-state')); } catch(e) {}\n      if (saved) {\n        if (saved.periode) state.periode = saved.periode;\n        if (typeof saved.brutto === 'number') state.brutto = saved.brutto;\n        if (typeof saved.trekkprosent === 'number') state.trekkprosent = saved.trekkprosent;\n        if (typeof saved.ferieAktivert === 'boolean') state.ferieAktivert = saved.ferieAktivert;\n        if (typeof saved.feriesats === 'number') state.feriesats = saved.feriesats;\n      }\n\n      // Apply to DOM\n      document.getElementById('bruttolonn').value = state.brutto;\n      document.getElementById('bruttolonn-slider').value = Math.min(Math.max(state.brutto, 10000), 150000);\n      document.getElementById('trekkprosent').value = state.trekkprosent;\n      document.getElementById('trekkprosent-slider').value = Math.min(Math.max(state.trekkprosent, 0), 60);\n      document.getElementById('feriesats').value = state.feriesats;\n\n      setPeriode(state.periode, true);\n      if (state.ferieAktivert) {\n        setFerie(true, true);\n      }\n      beregn();\n    }\n\n    // ---- Save ----\n    function saveState() {\n      try { localStorage.setItem('lonn-skatt-state', JSON.stringify(state)); } catch(e) {}\n    }\n\n    // ---- Periode ----\n    function setPeriode(p, skipSave) {\n      state.periode = p;\n      var btnM = document.getElementById('btn-maaned');\n      var btnA = document.getElementById('btn-aar');\n      var lbl = document.getElementById('periode-label');\n\n      if (p === 'maaned') {\n        btnM.className = 'flex-1 py-2 rounded-lg border-2 text-sm font-semibold transition-colors border-blue-500 bg-blue-500 text-white';\n        btnA.className = 'flex-1 py-2 rounded-lg border-2 text-sm font-semibold transition-colors border-slate-200 bg-white text-slate-600 hover:border-blue-300';\n        lbl.textContent = 'per måned';\n        // Update slider range for monthly\n        document.getElementById('bruttolonn-slider').min = 10000;\n        document.getElementById('bruttolonn-slider').max = 150000;\n        document.getElementById('bruttolonn-slider').step = 500;\n      } else {\n        btnA.className = 'flex-1 py-2 rounded-lg border-2 text-sm font-semibold transition-colors border-blue-500 bg-blue-500 text-white';\n        btnM.className = 'flex-1 py-2 rounded-lg border-2 text-sm font-semibold transition-colors border-slate-200 bg-white text-slate-600 hover:border-blue-300';\n        lbl.textContent = 'per år';\n        // Update slider range for yearly\n        document.getElementById('bruttolonn-slider').min = 120000;\n        document.getElementById('bruttolonn-slider').max = 1800000;\n        document.getElementById('bruttolonn-slider').step = 6000;\n      }\n\n      // Clamp slider value to new range\n      var sliderEl = document.getElementById('bruttolonn-slider');\n      var val = parseInt(sliderEl.value, 10);\n      sliderEl.value = Math.min(Math.max(val, parseInt(sliderEl.min, 10)), parseInt(sliderEl.max, 10));\n\n      if (!skipSave) saveState();\n      beregn();\n    }\n\n    // ---- Ferie toggle ----\n    function toggleFerie() {\n      setFerie(!state.ferieAktivert);\n    }\n\n    function setFerie(on, skipSave) {\n      state.ferieAktivert = on;\n      var btn = document.getElementById('toggle-ferie');\n      var knob = document.getElementById('toggle-ferie-knob');\n      var inputs = document.getElementById('ferie-inputs');\n\n      if (on) {\n        btn.className = 'relative inline-flex h-6 w-11 items-center rounded-full transition-colors focus:outline-none bg-blue-500';\n        btn.setAttribute('aria-checked', 'true');\n        knob.className = 'inline-block h-4 w-4 transform rounded-full bg-white shadow transition-transform translate-x-5';\n        inputs.classList.remove('hidden');\n      } else {\n        btn.className = 'relative inline-flex h-6 w-11 items-center rounded-full transition-colors focus:outline-none bg-slate-300';\n        btn.setAttribute('aria-checked', 'false');\n        knob.className = 'inline-block h-4 w-4 transform rounded-full bg-white shadow transition-transform translate-x-1';\n        inputs.classList.add('hidden');\n      }\n\n      if (!skipSave) saveState();\n      beregn();\n    }\n\n    // ---- Slider/Input sync ----\n    function syncFromSlider() {\n      var val = parseInt(document.getElementById('bruttolonn-slider').value, 10);\n      document.getElementById('bruttolonn').value = val;\n      state.brutto = val;\n      saveState();\n      beregn();\n    }\n\n    function syncFromInput() {\n      var val = parseFloat(document.getElementById('bruttolonn').value) || 0;\n      state.brutto = val;\n      var slider = document.getElementById('bruttolonn-slider');\n      slider.value = Math.min(Math.max(val, parseInt(slider.min, 10)), parseInt(slider.max, 10));\n      saveState();\n      beregn();\n    }\n\n    function syncTrekkFromSlider() {\n      var val = parseFloat(document.getElementById('trekkprosent-slider').value);\n      document.getElementById('trekkprosent').value = val;\n      state.trekkprosent = val;\n      saveState();\n      beregn();\n    }\n\n    function syncTrekkFromInput() {\n      var val = parseFloat(document.getElementById('trekkprosent').value) || 0;\n      state.trekkprosent = val;\n      var slider = document.getElementById('trekkprosent-slider');\n      slider.value = Math.min(Math.max(val, 0), 60);\n      saveState();\n      beregn();\n    }\n\n    // ---- Format ----\n    function kr(n) {\n      return n.toLocaleString('nb-NO', { minimumFractionDigits: 0, maximumFractionDigits: 0 }) + ' kr';\n    }\n\n    function pct(n, decimals) {\n      decimals = decimals !== undefined ? decimals : 1;\n      return n.toLocaleString('nb-NO', { minimumFractionDigits: decimals, maximumFractionDigits: decimals }) + ' %';\n    }\n\n    // ---- Beregn ----\n    function beregn() {\n      var brutto = parseFloat(document.getElementById('bruttolonn').value) || 0;\n      var trekkpst = parseFloat(document.getElementById('trekkprosent').value) || 0;\n      var feriesats = parseFloat(document.getElementById('feriesats').value) || 0;\n\n      state.brutto = brutto;\n      state.trekkprosent = trekkpst;\n      state.feriesats = feriesats;\n\n      // Beregn skatt og netto\n      var skatt = brutto * trekkpst / 100;\n      var netto = brutto - skatt;\n\n      // Årslønn (brukes alltid i feriepenger-beregning)\n      var aarslonn = state.periode === 'maaned' ? brutto * 12 : brutto;\n      var aarsskatt = state.periode === 'maaned' ? skatt * 12 : skatt;\n      var aarsnetto = state.periode === 'maaned' ? netto * 12 : netto;\n\n      // Feriepenger: beregnes alltid på årslønn (brutto)\n      var feriepenger = aarslonn * feriesats / 100;\n\n      // --- Oppdater visning ---\n\n      document.getElementById('res-brutto').textContent = kr(brutto);\n      document.getElementById('res-skatt').textContent = '− ' + kr(skatt);\n      document.getElementById('res-netto').textContent = kr(netto);\n\n      // Årslønn-rad: vis kun ved månedlig\n      var aarRad = document.getElementById('res-aarslonn-rad');\n      if (state.periode === 'maaned') {\n        aarRad.classList.remove('hidden');\n        document.getElementById('res-aarslonn').textContent = kr(aarslonn);\n      } else {\n        aarRad.classList.add('hidden');\n      }\n\n      // Feriepenger-rad\n      var ferieRad = document.getElementById('res-ferie-rad');\n      var ferieFormelBlokk = document.getElementById('formel-ferie-blokk');\n      if (state.ferieAktivert) {\n        ferieRad.classList.remove('hidden');\n        ferieFormelBlokk.classList.remove('hidden');\n        document.getElementById('res-ferie').textContent = kr(feriepenger);\n        document.getElementById('formel-ferie-tall').textContent =\n          '= ' + kr(aarslonn) + ' × ' + feriesats.toLocaleString('nb-NO') + ' / 100 = ' + kr(feriepenger);\n      } else {\n        ferieRad.classList.add('hidden');\n        ferieFormelBlokk.classList.add('hidden');\n      }\n\n      // Formel-tall\n      document.getElementById('formel-skatt-tall').textContent =\n        '= ' + kr(brutto) + ' × ' + trekkpst.toLocaleString('nb-NO') + ' / 100 = ' + kr(skatt);\n      document.getElementById('formel-netto-tall').textContent =\n        '= ' + kr(brutto) + ' − ' + kr(skatt) + ' = ' + kr(netto);\n\n      // Visuell fordeling\n      var nettoPct = brutto > 0 ? (netto / brutto) * 100 : 70;\n      var skattPct = 100 - nettoPct;\n      nettoPct = Math.max(0, Math.min(100, nettoPct));\n      skattPct = Math.max(0, Math.min(100, skattPct));\n\n      var barNetto = document.getElementById('bar-netto');\n      var barSkatt = document.getElementById('bar-skatt');\n      barNetto.style.width = nettoPct.toFixed(1) + '%';\n      barSkatt.style.width = skattPct.toFixed(1) + '%';\n\n      // Vis prosent i baren (bare om den er stor nok)\n      document.getElementById('bar-netto-label').textContent = nettoPct >= 15 ? pct(nettoPct, 0) : '';\n      document.getElementById('bar-skatt-label').textContent = skattPct >= 10 ? pct(skattPct, 0) : '';\n    }\n\n    // ---- Kjør ----\n    init();\n  </script>\n\n</body>\n</html>\n",
  "packaging": {
    "appName": "Lønn og skatt",
    "windowTitle": "Lønn og skatt",
    "bundleId": "com.halisonworks.lonnogskatt",
    "iconPath": null
  },
  "categoryId": null,
  "source": "import",
  "createdAt": "2026-06-02T12:00:00.000Z",
  "updatedAt": "2026-06-02T12:00:00.000Z",
  "sharedAt": "2026-06-02T12:00:00.000Z"
}
