{
  "schema": "app-studio/canvas@1",
  "id": "example-no1p-likninger",
  "name": "likninger.html",
  "code": "<!DOCTYPE html>\n<!--\n  Likninger — Halison App Studio-eksempel\n\n  Interaktivt læremiddel for matematikk 1P (LK20): løs førstegradslikninger steg\n  for steg, og potenslikninger.\n\n  Fra Halison App Studio sitt offentlige bibliotek:\n  https://github.com/halisonworks/public-app-studio\n\n  Tillatt bruk: personlig, pedagogisk og annen ikke-kommersiell bruk. Behold denne\n  headeren og kildelenken; ikke-kommersiell bruk. Utgitt under Halison App Studio\n  Examples License — se LICENSE-filen i repoet over.\n-->\n<html lang=\"no\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Likninger – Matematikk 1P</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Segoe UI', Arial, sans-serif; }\n    .step-box {\n      border-left: 4px solid #6366f1;\n      background: #f5f3ff;\n      padding: 0.5rem 1rem;\n      margin: 0.4rem 0;\n      border-radius: 0 6px 6px 0;\n    }\n    .step-box.check {\n      border-left-color: #22c55e;\n      background: #f0fdf4;\n    }\n    .step-box.result {\n      border-left-color: #f59e0b;\n      background: #fffbeb;\n      font-weight: bold;\n      font-size: 1.1rem;\n    }\n    .step-box.error {\n      border-left-color: #ef4444;\n      background: #fef2f2;\n    }\n    .tab-btn {\n      transition: background 0.15s, color 0.15s;\n    }\n    .tab-btn.active {\n      background: #6366f1;\n      color: white;\n    }\n    .input-num {\n      width: 70px;\n      text-align: center;\n      border: 1.5px solid #a5b4fc;\n      border-radius: 6px;\n      padding: 4px 6px;\n      font-size: 1.1rem;\n    }\n    .input-num:focus {\n      outline: none;\n      border-color: #6366f1;\n    }\n    .fraction {\n      display: inline-flex;\n      flex-direction: column;\n      align-items: center;\n      vertical-align: middle;\n      line-height: 1.1;\n      margin: 0 2px;\n    }\n    .fraction .num { border-bottom: 1.5px solid #374151; padding: 0 3px; }\n    .fraction .den { padding: 0 3px; }\n    .example-btn {\n      font-size: 0.8rem;\n      padding: 2px 10px;\n      border-radius: 999px;\n      border: 1.5px solid #a5b4fc;\n      color: #4f46e5;\n      background: white;\n      cursor: pointer;\n      transition: background 0.15s;\n    }\n    .example-btn:hover { background: #ede9fe; }\n  </style>\n</head>\n<body class=\"min-h-screen bg-gradient-to-br from-indigo-50 to-purple-50 p-4\">\n\n  <div class=\"max-w-2xl mx-auto\">\n\n    <!-- Header -->\n    <div class=\"text-center mb-6\">\n      <h1 class=\"text-3xl font-bold text-indigo-700\">Likninger</h1>\n      <p class=\"text-gray-500 mt-1 text-sm\">Matematikk 1P · Kap. 1.7–1.8 · LK20</p>\n    </div>\n\n    <!-- Tabs -->\n    <div class=\"flex gap-2 mb-6 justify-center\">\n      <button class=\"tab-btn active px-5 py-2 rounded-full font-semibold border border-indigo-300 text-sm\" id=\"tab-linear\" onclick=\"switchTab('linear')\">\n        Førstegradslikninger\n      </button>\n      <button class=\"tab-btn px-5 py-2 rounded-full font-semibold border border-indigo-300 text-sm text-indigo-600\" id=\"tab-power\" onclick=\"switchTab('power')\">\n        Potenslikninger\n      </button>\n    </div>\n\n    <!-- === FØRSTEGRADSLIKNINGER === -->\n    <div id=\"panel-linear\">\n      <div class=\"bg-white rounded-2xl shadow-md p-6 mb-4\">\n        <h2 class=\"text-lg font-bold text-indigo-700 mb-1\">Førstegradslikninger</h2>\n        <p class=\"text-gray-500 text-sm mb-4\">Skriv inn koeffisienter for <span class=\"font-mono font-semibold text-indigo-600\">ax + b = cx + d</span></p>\n\n        <!-- Examples -->\n        <div class=\"flex flex-wrap gap-2 mb-4 items-center\">\n          <span class=\"text-xs text-gray-400 font-semibold uppercase tracking-wide\">Eksempler:</span>\n          <button class=\"example-btn\" onclick=\"setLinear(3,5,1,13)\">3x + 5 = x + 13</button>\n          <button class=\"example-btn\" onclick=\"setLinear(2,-4,5,8)\">2x − 4 = 5x + 8</button>\n          <button class=\"example-btn\" onclick=\"setLinear(1,0,0,7)\">x = 7</button>\n          <button class=\"example-btn\" onclick=\"setLinear(4,3,-2,17)\">4x + 3 = −2x + 17</button>\n          <button class=\"example-btn\" onclick=\"setLinear(1,6,3,2)\">x + 6 = 3x + 2</button>\n        </div>\n\n        <!-- Equation builder -->\n        <div class=\"flex flex-wrap items-center gap-2 mb-5 justify-center text-xl font-mono\">\n          <input class=\"input-num\" id=\"la\" type=\"number\" value=\"3\" step=\"any\" />\n          <span class=\"text-gray-600\">x</span>\n          <span class=\"text-gray-400\">+</span>\n          <input class=\"input-num\" id=\"lb\" type=\"number\" value=\"5\" step=\"any\" />\n          <span class=\"text-gray-400\">=</span>\n          <input class=\"input-num\" id=\"lc\" type=\"number\" value=\"1\" step=\"any\" />\n          <span class=\"text-gray-600\">x</span>\n          <span class=\"text-gray-400\">+</span>\n          <input class=\"input-num\" id=\"ld\" type=\"number\" value=\"13\" step=\"any\" />\n        </div>\n\n        <div class=\"flex justify-center\">\n          <button onclick=\"solveLinear()\" class=\"bg-indigo-600 hover:bg-indigo-700 text-white font-bold px-8 py-2.5 rounded-xl text-base transition-colors shadow\">\n            Løs likningen\n          </button>\n        </div>\n      </div>\n\n      <!-- Linear solution output -->\n      <div id=\"linear-output\" class=\"hidden bg-white rounded-2xl shadow-md p-6\"></div>\n    </div>\n\n    <!-- === POTENSLIKNINGER === -->\n    <div id=\"panel-power\" class=\"hidden\">\n      <div class=\"bg-white rounded-2xl shadow-md p-6 mb-4\">\n        <h2 class=\"text-lg font-bold text-indigo-700 mb-1\">Potenslikninger</h2>\n        <p class=\"text-gray-500 text-sm mb-4\">Skriv inn eksponent og høyreside for <span class=\"font-mono font-semibold text-indigo-600\">xⁿ = k</span></p>\n\n        <!-- Examples -->\n        <div class=\"flex flex-wrap gap-2 mb-4 items-center\">\n          <span class=\"text-xs text-gray-400 font-semibold uppercase tracking-wide\">Eksempler:</span>\n          <button class=\"example-btn\" onclick=\"setPower(2,25)\">x² = 25</button>\n          <button class=\"example-btn\" onclick=\"setPower(3,8)\">x³ = 8</button>\n          <button class=\"example-btn\" onclick=\"setPower(2,-9)\">x² = −9</button>\n          <button class=\"example-btn\" onclick=\"setPower(4,81)\">x⁴ = 81</button>\n          <button class=\"example-btn\" onclick=\"setPower(3,-27)\">x³ = −27</button>\n          <button class=\"example-btn\" onclick=\"setPower(5,32)\">x⁵ = 32</button>\n        </div>\n\n        <!-- Power equation builder -->\n        <div class=\"flex flex-wrap items-center gap-3 mb-5 justify-center text-xl font-mono\">\n          <span class=\"text-gray-600\">x</span>\n          <span class=\"text-gray-400 text-base\">med eksponent</span>\n          <input class=\"input-num\" id=\"pn\" type=\"number\" value=\"2\" min=\"1\" max=\"20\" step=\"1\" />\n          <span class=\"text-gray-400\">=</span>\n          <input class=\"input-num\" id=\"pk\" type=\"number\" value=\"25\" step=\"any\" />\n        </div>\n\n        <div class=\"flex justify-center\">\n          <button onclick=\"solvePower()\" class=\"bg-indigo-600 hover:bg-indigo-700 text-white font-bold px-8 py-2.5 rounded-xl text-base transition-colors shadow\">\n            Løs likningen\n          </button>\n        </div>\n      </div>\n\n      <!-- Power solution output -->\n      <div id=\"power-output\" class=\"hidden bg-white rounded-2xl shadow-md p-6\"></div>\n    </div>\n\n    <p class=\"text-center text-xs text-gray-300 mt-8\">Halison App Studio · Matematikk 1P · LK20</p>\n  </div>\n\n  <script>\n    // ─── Utility ─────────────────────────────────────────────────────────────\n\n    function gcd(a, b) {\n      a = Math.abs(Math.round(a));\n      b = Math.abs(Math.round(b));\n      if (b === 0) return a;\n      return gcd(b, a % b);\n    }\n\n    // Return a simplified fraction as {num, den} or integer\n    function simplify(num, den) {\n      if (den === 0) return null; // division by zero\n      if (num === 0) return { num: 0, den: 1 };\n      const sign = (num < 0) !== (den < 0) ? -1 : 1;\n      num = Math.abs(num);\n      den = Math.abs(den);\n      const g = gcd(num, den);\n      return { num: sign * (num / g), den: den / g };\n    }\n\n    // Format a fraction as HTML – whole number if denominator == 1\n    function fracHTML(frac) {\n      if (!frac) return '<span class=\"text-red-500\">udefinert</span>';\n      if (frac.den === 1) return `<strong>${frac.num}</strong>`;\n      return `<span class=\"fraction\"><span class=\"num\">${frac.num}</span><span class=\"den\">${frac.den}</span></span>`;\n    }\n\n    // Format fraction as plain text\n    function fracText(frac) {\n      if (!frac) return 'udefinert';\n      if (frac.den === 1) return String(frac.num);\n      return `${frac.num}/${frac.den}`;\n    }\n\n    // Decimal value of fraction\n    function fracVal(frac) {\n      if (!frac) return NaN;\n      return frac.num / frac.den;\n    }\n\n    // Format a coefficient for display in an expression, e.g. -3x or +5\n    function coefStr(c, varName, first) {\n      if (c === 0) return '';\n      const sign = c < 0 ? '−' : (first ? '' : '+');\n      const abs = Math.abs(c);\n      if (varName) {\n        const coefPart = abs === 1 ? '' : abs;\n        return `${sign}${coefPart}${varName}`;\n      }\n      return `${sign}${abs}`;\n    }\n\n    // Render a whole expression ax + b\n    function exprHTML(a, b, varName) {\n      varName = varName || 'x';\n      let parts = [];\n      if (a !== 0) {\n        const absA = Math.abs(a);\n        const signA = a < 0 ? '−' : '';\n        const coefPart = absA === 1 ? '' : absA;\n        parts.push(`${signA}${coefPart}<em>${varName}</em>`);\n      }\n      if (b !== 0) {\n        if (parts.length === 0) {\n          parts.push(String(b));\n        } else {\n          parts.push(b < 0 ? ` − ${Math.abs(b)}` : ` + ${b}`);\n        }\n      }\n      if (parts.length === 0) return '0';\n      return parts.join('');\n    }\n\n    // ─── Tab switching ────────────────────────────────────────────────────────\n\n    function switchTab(name) {\n      ['linear', 'power'].forEach(t => {\n        document.getElementById('panel-' + t).classList.toggle('hidden', t !== name);\n        const btn = document.getElementById('tab-' + t);\n        btn.classList.toggle('active', t === name);\n        btn.classList.toggle('text-indigo-600', t !== name);\n      });\n    }\n\n    // ─── Linear equation helpers ──────────────────────────────────────────────\n\n    function setLinear(a, b, c, d) {\n      document.getElementById('la').value = a;\n      document.getElementById('lb').value = b;\n      document.getElementById('lc').value = c;\n      document.getElementById('ld').value = d;\n      document.getElementById('linear-output').classList.add('hidden');\n    }\n\n    function step(html, type) {\n      const cls = type === 'result' ? 'step-box result'\n                : type === 'check'  ? 'step-box check'\n                : type === 'error'  ? 'step-box error'\n                : 'step-box';\n      return `<div class=\"${cls}\">${html}</div>`;\n    }\n\n    function solveLinear() {\n      const a = parseFloat(document.getElementById('la').value);\n      const b = parseFloat(document.getElementById('lb').value);\n      const c = parseFloat(document.getElementById('lc').value);\n      const d = parseFloat(document.getElementById('ld').value);\n\n      const out = document.getElementById('linear-output');\n      out.classList.remove('hidden');\n\n      if ([a, b, c, d].some(isNaN)) {\n        out.innerHTML = step('Fyll inn gyldige tall for alle koeffisienter.', 'error');\n        return;\n      }\n\n      // ax + b = cx + d\n      let html = `<h3 class=\"font-bold text-indigo-700 text-lg mb-3\">Løsning steg for steg</h3>`;\n\n      // Step 0: write the equation\n      html += step(`<strong>Likningen:</strong> ${exprHTML(a, b)} = ${exprHTML(c, d)}`);\n\n      // Step 1: move x-terms to left (subtract cx from both sides)\n      const xCoefLeft = a - c; // coefficient of x after moving\n      if (c !== 0) {\n        const subExpr = c < 0\n          ? `Legg til ${Math.abs(c)}x på begge sider`\n          : `Trekk fra ${Math.abs(c)}x på begge sider`;\n        html += step(`<strong>Steg 1 – Samle <em>x</em>-leddene:</strong> ${subExpr}<br>\n          ${exprHTML(a, b)} ${c < 0 ? '+' : '−'} ${Math.abs(c)}x = ${exprHTML(c, d)} ${c < 0 ? '+' : '−'} ${Math.abs(c)}x<br>\n          ⟹ ${exprHTML(xCoefLeft, b)} = ${d}`);\n      } else {\n        html += step(`<strong>Steg 1 – Samle <em>x</em>-leddene:</strong> Ingen <em>x</em> på høyre side – allerede samlet.<br>\n          ${exprHTML(xCoefLeft, b)} = ${d}`);\n      }\n\n      // Step 2: move constant to right (subtract b from both sides)\n      const rhs = d - b;\n      if (b !== 0) {\n        const subExpr2 = b < 0\n          ? `Legg til ${Math.abs(b)} på begge sider`\n          : `Trekk fra ${Math.abs(b)} fra begge sider`;\n        html += step(`<strong>Steg 2 – Flytt tallene til høyre:</strong> ${subExpr2}<br>\n          ${exprHTML(xCoefLeft, b)} ${b < 0 ? '+' : '−'} ${Math.abs(b)} = ${d} ${b < 0 ? '+' : '−'} ${Math.abs(b)}<br>\n          ⟹ ${exprHTML(xCoefLeft, 0)} = ${rhs}`);\n      } else {\n        html += step(`<strong>Steg 2 – Flytt tallene til høyre:</strong> Ingen konstantledd på venstre side – ingenting å flytte.<br>\n          ${exprHTML(xCoefLeft, 0)} = ${rhs}`);\n      }\n\n      // Step 3: divide or handle special cases\n      if (xCoefLeft === 0) {\n        if (rhs === 0) {\n          html += step(`<strong>Steg 3:</strong> Vi får 0 = 0 &rarr; <em>alle reelle tall</em> er løsning (likningen er alltid sann).`, 'result');\n          out.innerHTML = html;\n          return;\n        } else {\n          html += step(`<strong>Steg 3:</strong> Vi får 0 = ${rhs} &rarr; <em>ingen løsning</em> (likningen er aldri sann).`, 'error');\n          out.innerHTML = html;\n          return;\n        }\n      }\n\n      const xFrac = simplify(rhs, xCoefLeft);\n      const xVal = fracVal(xFrac);\n\n      html += step(`<strong>Steg 3 – Del på koeffisienten til <em>x</em>:</strong> Del begge sider på ${xCoefLeft}<br>\n        x = ${rhs} ÷ ${xCoefLeft} = ${fracHTML(xFrac)}`);\n\n      // Result\n      html += step(`<strong>Svar:</strong> x = ${fracHTML(xFrac)}${xFrac.den !== 1 ? ` ≈ ${xVal.toFixed(4)}` : ''}`, 'result');\n\n      // Prøve (check)\n      const lhs_check = a * xVal + b;\n      const rhs_check = c * xVal + d;\n      const ok = Math.abs(lhs_check - rhs_check) < 1e-9;\n      const xDisp = xFrac.den === 1 ? xFrac.num : fracText(xFrac);\n      html += `<div class=\"mt-4\">\n        <h4 class=\"font-semibold text-green-700 mb-1\">Prøve (sett inn x = ${xDisp}):</h4>`;\n      html += step(`Venstre side: ${a} · ${xDisp} + ${b} = ${a * xVal + b}\n        <br>Høyre side: ${c} · ${xDisp} + ${d} = ${c * xVal + d}\n        <br>${ok ? '✔ Venstre side = høyre side. Svaret er riktig!' : '✗ Noe gikk galt – sjekk beregningene.'}`, 'check');\n      html += '</div>';\n\n      out.innerHTML = html;\n    }\n\n    // ─── Power equation helpers ───────────────────────────────────────────────\n\n    function setPower(n, k) {\n      document.getElementById('pn').value = n;\n      document.getElementById('pk').value = k;\n      document.getElementById('power-output').classList.add('hidden');\n    }\n\n    const SUPERSCRIPTS = ['⁰','¹','²','³','⁴','⁵','⁶','⁷','⁸','⁹'];\n    function toSuperscript(n) {\n      return String(n).split('').map(d => SUPERSCRIPTS[parseInt(d)] || d).join('');\n    }\n\n    function solvePower() {\n      const n = parseInt(document.getElementById('pn').value);\n      const k = parseFloat(document.getElementById('pk').value);\n\n      const out = document.getElementById('power-output');\n      out.classList.remove('hidden');\n\n      if (isNaN(n) || isNaN(k) || n < 1) {\n        out.innerHTML = step('Fyll inn gyldige tall. Eksponenten må være et positivt heltall.', 'error');\n        return;\n      }\n\n      let html = `<h3 class=\"font-bold text-indigo-700 text-lg mb-3\">Løsning steg for steg</h3>`;\n\n      // Show the equation\n      html += step(`<strong>Likningen:</strong> x${toSuperscript(n)} = ${k}`);\n\n      const isEven = n % 2 === 0;\n\n      if (isEven && k < 0) {\n        // No real solution\n        html += step(`<strong>Steg 1:</strong> Eksponenten ${n} er partall, og høyresiden k = ${k} < 0.`);\n        html += step(`Et partallspotens av et reelt tall er alltid ≥ 0.<br>\n          Derfor har likningen <strong>ingen reell løsning</strong>.`, 'error');\n        out.innerHTML = html;\n        return;\n      }\n\n      if (k === 0) {\n        html += step(`<strong>Steg 1:</strong> k = 0, så x${toSuperscript(n)} = 0<br>⟹ x = 0`);\n        html += step(`<strong>Svar:</strong> x = 0`, 'result');\n        html += `<div class=\"mt-4\"><h4 class=\"font-semibold text-green-700 mb-1\">Prøve:</h4>`;\n        html += step(`Venstre side: 0${toSuperscript(n)} = 0 = høyre side. ✔`, 'check');\n        html += '</div>';\n        out.innerHTML = html;\n        return;\n      }\n\n      // General case\n      html += step(`<strong>Steg 1 – Ta ${n}. roten av begge sider:</strong><br>\n        x${toSuperscript(n)} = ${k}<br>\n        ⟹ x = ${k < 0 ? '' : ''}${isEven ? '±' : ''}${n === 2 ? '√' : `${n}√`}(${k})`);\n\n      if (isEven) {\n        html += step(`Siden eksponenten er partall (${n}), gir vi <strong>to løsninger</strong>: én positiv og én negativ.`);\n      } else {\n        html += step(`Siden eksponenten er oddetall (${n}), er det <strong>én løsning</strong> (kan være negativ).`);\n      }\n\n      const root = Math.pow(Math.abs(k), 1 / n);\n      const rootSigned = k < 0 ? -root : root; // for odd n, negative k gives negative root\n\n      // Try to detect nice integer/fraction roots\n      function niceRoot(val, k, n) {\n        // Check integers up to 1000\n        for (let i = 0; i <= 1000; i++) {\n          if (Math.abs(Math.pow(i, n) - Math.abs(k)) < 1e-9) return i;\n        }\n        return null;\n      }\n\n      const niceVal = niceRoot(root, k, n);\n\n      if (isEven) {\n        // Two solutions: ±root\n        if (niceVal !== null) {\n          html += step(`<strong>Steg 2 – Nøyaktig verdi:</strong><br>\n            x₁ = +${niceVal}&nbsp;&nbsp;&nbsp;x₂ = −${niceVal}`, 'result');\n          // Check\n          html += `<div class=\"mt-4\"><h4 class=\"font-semibold text-green-700 mb-1\">Prøve:</h4>`;\n          html += step(`x₁ = ${niceVal}: (${niceVal})${toSuperscript(n)} = ${Math.pow(niceVal, n)} = ${k} ✔<br>\n            x₂ = −${niceVal}: (−${niceVal})${toSuperscript(n)} = ${Math.pow(-niceVal, n)} = ${k} ✔`, 'check');\n          html += '</div>';\n        } else {\n          const approx = root.toFixed(6);\n          html += step(`<strong>Steg 2 – Tilnærmet verdi (ingen eksakt heltallsrot):</strong><br>\n            x₁ = +${n === 2 ? '√' : `${n}√`}(${k}) ≈ +${approx}<br>\n            x₂ = −${n === 2 ? '√' : `${n}√`}(${k}) ≈ −${approx}`, 'result');\n          // Check\n          html += `<div class=\"mt-4\"><h4 class=\"font-semibold text-green-700 mb-1\">Prøve:</h4>`;\n          const check1 = Math.pow(root, n);\n          const check2 = Math.pow(-root, n);\n          html += step(`x₁ ≈ ${approx}: (${approx})${toSuperscript(n)} ≈ ${check1.toFixed(6)} ≈ ${k} ✔<br>\n            x₂ ≈ −${approx}: (−${approx})${toSuperscript(n)} ≈ ${check2.toFixed(6)} ≈ ${k} ✔`, 'check');\n          html += '</div>';\n        }\n      } else {\n        // Odd n – one solution\n        const actualRoot = k < 0 ? -Math.pow(-k, 1 / n) : Math.pow(k, 1 / n);\n        if (niceVal !== null) {\n          const signedNice = k < 0 ? -niceVal : niceVal;\n          html += step(`<strong>Steg 2 – Nøyaktig verdi:</strong><br>\n            x = ${signedNice}`, 'result');\n          html += `<div class=\"mt-4\"><h4 class=\"font-semibold text-green-700 mb-1\">Prøve:</h4>`;\n          const check = Math.pow(signedNice, n);\n          html += step(`(${signedNice})${toSuperscript(n)} = ${check} = ${k} ✔`, 'check');\n          html += '</div>';\n        } else {\n          const approx = actualRoot.toFixed(6);\n          html += step(`<strong>Steg 2 – Tilnærmet verdi:</strong><br>\n            x = ${n}√(${k}) ≈ ${approx}`, 'result');\n          html += `<div class=\"mt-4\"><h4 class=\"font-semibold text-green-700 mb-1\">Prøve:</h4>`;\n          const check = Math.pow(parseFloat(approx), n);\n          html += step(`(${approx})${toSuperscript(n)} ≈ ${check.toFixed(6)} ≈ ${k} ✔`, 'check');\n          html += '</div>';\n        }\n      }\n\n      out.innerHTML = html;\n    }\n\n    // ─── Init ─────────────────────────────────────────────────────────────────\n    document.getElementById('la').addEventListener('keydown', function(e){ if(e.key==='Enter') solveLinear(); });\n    document.getElementById('lb').addEventListener('keydown', function(e){ if(e.key==='Enter') solveLinear(); });\n    document.getElementById('lc').addEventListener('keydown', function(e){ if(e.key==='Enter') solveLinear(); });\n    document.getElementById('ld').addEventListener('keydown', function(e){ if(e.key==='Enter') solveLinear(); });\n    document.getElementById('pn').addEventListener('keydown', function(e){ if(e.key==='Enter') solvePower(); });\n    document.getElementById('pk').addEventListener('keydown', function(e){ if(e.key==='Enter') solvePower(); });\n  </script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Likninger",
    "windowTitle": "Likninger",
    "bundleId": "com.halisonworks.likninger1p",
    "iconPath": null
  },
  "categoryId": null,
  "source": "import",
  "createdAt": "2026-06-02T12:00:00.000Z",
  "updatedAt": "2026-06-02T12:00:00.000Z",
  "sharedAt": "2026-06-02T12:00:00.000Z"
}
