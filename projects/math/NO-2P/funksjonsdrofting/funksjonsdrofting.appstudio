{
  "schema": "app-studio/canvas@1",
  "id": "example-no2p-funksjonsdrofting",
  "name": "funksjonsdrofting.html",
  "code": "<!DOCTYPE html>\n<!--\n  Funksjonsdrøfting — Halison App Studio-eksempel\n\n  Interaktivt læremiddel for matematikk 2P (LK20): finn nullpunkt, topp- og\n  bunnpunkt, y-skjæring og vekstområder for en funksjon, med graf.\n\n  Fra Halison App Studio sitt offentlige bibliotek:\n  https://github.com/halisonworks/public-app-studio\n\n  Tillatt bruk: personlig, pedagogisk og annen ikke-kommersiell bruk. Behold denne\n  headeren og kildelenken; ikke-kommersiell bruk. Utgitt under Halison App Studio\n  Examples License — se LICENSE-filen i repoet over.\n-->\n<html lang=\"no\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Funksjonsdrøfting – Matematikk 2P</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Segoe UI', system-ui, sans-serif; }\n    .svg-container { width: 100%; aspect-ratio: 16/9; min-height: 320px; }\n    svg { width: 100%; height: 100%; display: block; }\n    .label-chip {\n      display: inline-flex; align-items: center; gap: 4px;\n      padding: 2px 8px; border-radius: 9999px; font-size: 0.75rem; font-weight: 600;\n    }\n    input[type=number]::-webkit-inner-spin-button,\n    input[type=number]::-webkit-outer-spin-button { opacity: 1; }\n    .marker-dot { transition: cx 0.15s, cy 0.15s; }\n    .tab-btn { transition: background 0.15s, color 0.15s; }\n    .tab-btn.active { background: #2563eb; color: white; }\n    details summary { cursor: pointer; }\n  </style>\n</head>\n<body class=\"bg-gray-50 min-h-screen\">\n\n<!-- ===== HEADER ===== -->\n<header class=\"bg-white border-b border-gray-200 px-4 py-3 flex items-center gap-3\">\n  <div class=\"w-8 h-8 rounded-lg bg-blue-600 flex items-center justify-center text-white font-bold text-sm\">f</div>\n  <div>\n    <h1 class=\"text-lg font-bold text-gray-900 leading-tight\">Funksjonsdrøfting</h1>\n    <p class=\"text-xs text-gray-500\">Matematikk 2P · LK20 · Sinus 2P kap. 5.7</p>\n  </div>\n</header>\n\n<main class=\"max-w-6xl mx-auto px-3 py-4 space-y-4\">\n\n  <!-- ===== FUNKSJONVALG ===== -->\n  <section class=\"bg-white rounded-2xl shadow-sm border border-gray-100 p-4\">\n    <h2 class=\"text-sm font-semibold text-gray-700 mb-3 uppercase tracking-wide\">Velg funksjon</h2>\n\n    <!-- Type-velger -->\n    <div class=\"flex gap-2 mb-4\" id=\"typeButtons\">\n      <button data-type=\"poly\" class=\"tab-btn active px-4 py-1.5 rounded-full text-sm font-medium border border-blue-600\">Polynom</button>\n      <button data-type=\"exp\"  class=\"tab-btn px-4 py-1.5 rounded-full text-sm font-medium border border-gray-300 text-gray-600\">Eksponentialfunksjon</button>\n    </div>\n\n    <!-- Polynom-innstillinger -->\n    <div id=\"polyPanel\">\n      <p class=\"text-xs text-gray-500 mb-2\">\n        f(x) = <span class=\"font-mono font-semibold text-blue-700\">a·x³ + b·x² + c·x + d</span>\n        &nbsp;(sett a = 0 for 2. grad, a = b = 0 for lineær)\n      </p>\n      <div class=\"grid grid-cols-2 sm:grid-cols-4 gap-3\">\n        <label class=\"block\">\n          <span class=\"text-xs font-semibold text-gray-600\">a (x³)</span>\n          <input id=\"pa\" type=\"number\" step=\"0.1\" value=\"1\"\n            class=\"mt-1 block w-full rounded-lg border border-gray-300 px-2 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n        </label>\n        <label class=\"block\">\n          <span class=\"text-xs font-semibold text-gray-600\">b (x²)</span>\n          <input id=\"pb\" type=\"number\" step=\"0.1\" value=\"-3\"\n            class=\"mt-1 block w-full rounded-lg border border-gray-300 px-2 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n        </label>\n        <label class=\"block\">\n          <span class=\"text-xs font-semibold text-gray-600\">c (x)</span>\n          <input id=\"pc\" type=\"number\" step=\"0.1\" value=\"-1\"\n            class=\"mt-1 block w-full rounded-lg border border-gray-300 px-2 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n        </label>\n        <label class=\"block\">\n          <span class=\"text-xs font-semibold text-gray-600\">d (konstant)</span>\n          <input id=\"pd\" type=\"number\" step=\"0.1\" value=\"3\"\n            class=\"mt-1 block w-full rounded-lg border border-gray-300 px-2 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n        </label>\n      </div>\n    </div>\n\n    <!-- Eksponential-innstillinger -->\n    <div id=\"expPanel\" class=\"hidden\">\n      <p class=\"text-xs text-gray-500 mb-2\">\n        f(x) = <span class=\"font-mono font-semibold text-blue-700\">a · b^x + c</span>\n        &nbsp;(b &gt; 0, b ≠ 1)\n      </p>\n      <div class=\"grid grid-cols-3 gap-3\">\n        <label class=\"block\">\n          <span class=\"text-xs font-semibold text-gray-600\">a</span>\n          <input id=\"ea\" type=\"number\" step=\"0.1\" value=\"2\"\n            class=\"mt-1 block w-full rounded-lg border border-gray-300 px-2 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n        </label>\n        <label class=\"block\">\n          <span class=\"text-xs font-semibold text-gray-600\">b (grunntall)</span>\n          <input id=\"eb\" type=\"number\" step=\"0.01\" value=\"2\" min=\"0.01\"\n            class=\"mt-1 block w-full rounded-lg border border-gray-300 px-2 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n        </label>\n        <label class=\"block\">\n          <span class=\"text-xs font-semibold text-gray-600\">c (vertikal forskyv.)</span>\n          <input id=\"ec\" type=\"number\" step=\"0.1\" value=\"0\"\n            class=\"mt-1 block w-full rounded-lg border border-gray-300 px-2 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n        </label>\n      </div>\n    </div>\n\n    <!-- x-vindu -->\n    <div class=\"mt-3 flex flex-wrap gap-3 items-end\">\n      <label class=\"block\">\n        <span class=\"text-xs font-semibold text-gray-600\">x fra</span>\n        <input id=\"xmin\" type=\"number\" step=\"1\" value=\"-4\"\n          class=\"mt-1 block w-20 rounded-lg border border-gray-300 px-2 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n      </label>\n      <label class=\"block\">\n        <span class=\"text-xs font-semibold text-gray-600\">x til</span>\n        <input id=\"xmax\" type=\"number\" step=\"1\" value=\"4\"\n          class=\"mt-1 block w-20 rounded-lg border border-gray-300 px-2 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n      </label>\n      <button id=\"drawBtn\"\n        class=\"px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold rounded-lg transition-colors\">\n        Tegn graf\n      </button>\n    </div>\n    <p id=\"inputError\" class=\"hidden mt-2 text-sm text-red-600 font-medium\"></p>\n  </section>\n\n  <!-- ===== GRAF ===== -->\n  <section class=\"bg-white rounded-2xl shadow-sm border border-gray-100 p-4\">\n    <h2 class=\"text-sm font-semibold text-gray-700 mb-2 uppercase tracking-wide\">Graf</h2>\n    <div id=\"funcLabel\" class=\"text-center text-base font-semibold text-blue-700 mb-2 font-mono\"></div>\n    <div class=\"svg-container border border-gray-200 rounded-xl bg-gray-50 overflow-hidden\">\n      <svg id=\"graphSvg\" viewBox=\"0 0 800 450\" preserveAspectRatio=\"xMidYMid meet\">\n        <text x=\"400\" y=\"225\" text-anchor=\"middle\" fill=\"#9ca3af\" font-size=\"16\">Trykk «Tegn graf» for å starte</text>\n      </svg>\n    </div>\n    <!-- Tegnforklaring -->\n    <div class=\"mt-2 flex flex-wrap gap-2 text-xs\">\n      <span class=\"label-chip bg-blue-100 text-blue-800\">— Funksjonskurve</span>\n      <span class=\"label-chip bg-green-100 text-green-800\">● Nullpunkt</span>\n      <span class=\"label-chip bg-red-100 text-red-800\">▲ Toppunkt</span>\n      <span class=\"label-chip bg-orange-100 text-orange-800\">▼ Bunnpunkt</span>\n      <span class=\"label-chip bg-purple-100 text-purple-800\">◆ y-skjæring</span>\n      <span class=\"label-chip bg-yellow-100 text-yellow-800\">✕ Punktleser</span>\n    </div>\n  </section>\n\n  <!-- ===== PUNKTLESER ===== -->\n  <section class=\"bg-white rounded-2xl shadow-sm border border-gray-100 p-4\">\n    <h2 class=\"text-sm font-semibold text-gray-700 mb-3 uppercase tracking-wide\">Punktleser</h2>\n    <div class=\"flex flex-wrap gap-3 items-end\">\n      <label class=\"block\">\n        <span class=\"text-xs font-semibold text-gray-600\">Skriv inn x-verdi</span>\n        <input id=\"ptX\" type=\"number\" step=\"0.1\" placeholder=\"f.eks. 2\"\n          class=\"mt-1 block w-32 rounded-lg border border-gray-300 px-2 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n      </label>\n      <button id=\"ptBtn\"\n        class=\"px-4 py-2 bg-yellow-500 hover:bg-yellow-600 text-white text-sm font-semibold rounded-lg transition-colors\">\n        Vis punkt\n      </button>\n      <button id=\"ptClear\"\n        class=\"px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-700 text-sm font-semibold rounded-lg transition-colors\">\n        Fjern markør\n      </button>\n    </div>\n    <p id=\"ptResult\" class=\"mt-2 text-sm text-gray-700 min-h-[1.5rem]\"></p>\n  </section>\n\n  <!-- ===== DRØFTINGSRESULTATER ===== -->\n  <section class=\"bg-white rounded-2xl shadow-sm border border-gray-100 p-4\" id=\"resultsSection\">\n    <h2 class=\"text-sm font-semibold text-gray-700 mb-3 uppercase tracking-wide\">Drøftingsresultater</h2>\n    <div id=\"resultsContent\" class=\"text-sm text-gray-400\">Ingen funksjon tegnet ennå.</div>\n  </section>\n\n  <!-- ===== BEGREPSFORKLARING ===== -->\n  <section class=\"bg-white rounded-2xl shadow-sm border border-gray-100 p-4\">\n    <h2 class=\"text-sm font-semibold text-gray-700 mb-3 uppercase tracking-wide\">Begreper forklart</h2>\n    <div class=\"space-y-2\">\n\n      <details class=\"rounded-lg border border-gray-200\">\n        <summary class=\"px-3 py-2 font-semibold text-gray-800 text-sm\">Nullpunkt</summary>\n        <p class=\"px-3 pb-3 pt-1 text-sm text-gray-600\">\n          Et <strong>nullpunkt</strong> er en x-verdi der f(x) = 0 — altså der grafen krysser (eller berører) x-aksen.\n          Det er der funksjonen «er null». Et andregradspolfynom kan ha 0, 1 eller 2 nullpunkter; et tredjegradspolfynom\n          har alltid minst ett reelt nullpunkt.\n        </p>\n      </details>\n\n      <details class=\"rounded-lg border border-gray-200\">\n        <summary class=\"px-3 py-2 font-semibold text-gray-800 text-sm\">Topp- og bunnpunkt (lokale ekstrema)</summary>\n        <p class=\"px-3 pb-3 pt-1 text-sm text-gray-600\">\n          Et <strong>toppunkt</strong> er et punkt der funksjonen har en lokal maksimalverdi — grafen stiger opp mot\n          punktet og synker etter det. Et <strong>bunnpunkt</strong> er det motsatte: en lokal minimumsverdi.\n          Matematisk finner vi dem der den deriverte f′(x) = 0 og skifter fortegn.\n        </p>\n      </details>\n\n      <details class=\"rounded-lg border border-gray-200\">\n        <summary class=\"px-3 py-2 font-semibold text-gray-800 text-sm\">Skjæring med y-aksen</summary>\n        <p class=\"px-3 pb-3 pt-1 text-sm text-gray-600\">\n          <strong>y-skjæringen</strong> er punktet der grafen krysser y-aksen, dvs. punktet (0, f(0)). Den finner vi\n          enkelt ved å sette x = 0 i funksjonsuttrykket. For et polynom f(x) = ax³ + bx² + cx + d er\n          y-skjæringen alltid (0, d).\n        </p>\n      </details>\n\n      <details class=\"rounded-lg border border-gray-200\">\n        <summary class=\"px-3 py-2 font-semibold text-gray-800 text-sm\">Vekst og synking (stigende / synkende)</summary>\n        <p class=\"px-3 pb-3 pt-1 text-sm text-gray-600\">\n          En funksjon <strong>stiger</strong> i et intervall der f′(x) &gt; 0, og\n          <strong>synker</strong> der f′(x) &lt; 0. Mellom et bunnpunkt og et toppunkt stiger funksjonen; mellom\n          et toppunkt og et bunnpunkt synker den. Vi oppgir vekstintervaller på formen\n          x ∈ (a, b), f.eks. «f stiger for x ∈ (−1, 2)».\n        </p>\n      </details>\n\n      <details class=\"rounded-lg border border-gray-200\">\n        <summary class=\"px-3 py-2 font-semibold text-gray-800 text-sm\">Eksponentialfunksjon</summary>\n        <p class=\"px-3 pb-3 pt-1 text-sm text-gray-600\">\n          En <strong>eksponentialfunksjon</strong> har formen f(x) = a · b^x + c, der b &gt; 0 og b ≠ 1 kalles\n          <em>grunntallet</em>. Hvis b &gt; 1 vokser funksjonen eksponentielt; hvis 0 &lt; b &lt; 1 avtar den.\n          En ren eksponentialfunksjon (c = 0) har ingen nullpunkter og ingen topp-/bunnpunkter.\n        </p>\n      </details>\n\n    </div>\n  </section>\n\n</main>\n\n<footer class=\"text-center text-xs text-gray-400 py-4\">\n  Matematikk 2P · LK20 · Sinus 2P kap. 5.7 · Halison App Studio\n</footer>\n\n<script>\n// ============================================================\n//  STATE\n// ============================================================\nlet currentFn = null;    // function f(x)\nlet currentDfn = null;   // derivative f'(x) (numerical)\nlet currentType = 'poly';\nlet analysisResults = null;\nlet ptMarkerData = null; // {x, svgX, svgY}\n\n// SVG viewport dimensions (matches viewBox)\nconst SVG_W = 800;\nconst SVG_H = 450;\nconst MARGIN = { top: 30, right: 30, bottom: 45, left: 55 };\n\n// ============================================================\n//  TYPE-VELGER\n// ============================================================\ndocument.querySelectorAll('#typeButtons button').forEach(btn => {\n  btn.addEventListener('click', () => {\n    document.querySelectorAll('#typeButtons button').forEach(b => {\n      b.classList.remove('active');\n      b.classList.add('border-gray-300', 'text-gray-600');\n      b.classList.remove('border-blue-600');\n    });\n    btn.classList.add('active');\n    btn.classList.remove('border-gray-300', 'text-gray-600');\n    btn.classList.add('border-blue-600');\n    currentType = btn.dataset.type;\n    document.getElementById('polyPanel').classList.toggle('hidden', currentType !== 'poly');\n    document.getElementById('expPanel').classList.toggle('hidden', currentType !== 'exp');\n  });\n});\n\n// ============================================================\n//  INPUT HELPERS\n// ============================================================\nfunction getNum(id) { return parseFloat(document.getElementById(id).value); }\n\nfunction buildFunction() {\n  if (currentType === 'poly') {\n    const a = getNum('pa'), b = getNum('pb'), c = getNum('pc'), d = getNum('pd');\n    if ([a,b,c,d].some(isNaN)) return null;\n    return {\n      fn: x => a*x*x*x + b*x*x + c*x + d,\n      dfn: x => 3*a*x*x + 2*b*x + c,\n      label: polyLabel(a,b,c,d)\n    };\n  } else {\n    const a = getNum('ea'), b = getNum('eb'), c = getNum('ec');\n    if ([a,b,c].some(isNaN) || b <= 0 || b === 1) return null;\n    return {\n      fn: x => a * Math.pow(b, x) + c,\n      dfn: x => a * Math.log(b) * Math.pow(b, x),\n      label: `f(x) = ${fmt(a)}·${fmt(b)}^x${c !== 0 ? (c>0?'+':'')+fmt(c) : ''}`\n    };\n  }\n}\n\nfunction polyLabel(a,b,c,d) {\n  const terms = [];\n  if (a !== 0) terms.push(`${fmt(a)}x³`);\n  if (b !== 0) terms.push(`${b>0&&terms.length?'+':''}${fmt(b)}x²`);\n  if (c !== 0) terms.push(`${c>0&&terms.length?'+':''}${fmt(c)}x`);\n  if (d !== 0 || terms.length===0) terms.push(`${d>0&&terms.length?'+':''}${fmt(d)}`);\n  return 'f(x) = ' + terms.join(' ').trim();\n}\n\nfunction fmt(v) {\n  if (v === 0) return '0';\n  const s = parseFloat(v.toFixed(4)).toString();\n  return s;\n}\n\nfunction fmtCoord(v) { return parseFloat(v.toFixed(3)).toString(); }\n\n// ============================================================\n//  ANALYSIS: nullpunkter, ekstrema, stiger/synker\n// ============================================================\n\n// Bisection root finding in [lo, hi] where f(lo)*f(hi) < 0\nfunction bisect(f, lo, hi, tol=1e-7, maxIter=60) {\n  let fa = f(lo), fb = f(hi);\n  if (fa === 0) return lo;\n  if (fb === 0) return hi;\n  for (let i = 0; i < maxIter; i++) {\n    const mid = (lo + hi) / 2;\n    const fm = f(mid);\n    if (Math.abs(fm) < tol || (hi - lo) / 2 < tol) return mid;\n    if (fa * fm < 0) { hi = mid; fb = fm; }\n    else { lo = mid; fa = fm; }\n  }\n  return (lo + hi) / 2;\n}\n\nfunction findRoots(f, xlo, xhi, steps=2000) {\n  const roots = [];\n  const dx = (xhi - xlo) / steps;\n  let prev = f(xlo);\n  for (let i = 1; i <= steps; i++) {\n    const x = xlo + i * dx;\n    const curr = f(x);\n    if (prev * curr < 0) {\n      const r = bisect(f, x - dx, x);\n      // deduplicate\n      if (roots.length === 0 || Math.abs(r - roots[roots.length-1]) > 1e-4) {\n        roots.push(r);\n      }\n    } else if (Math.abs(curr) < 1e-8) {\n      if (roots.length === 0 || Math.abs(x - roots[roots.length-1]) > 1e-4) {\n        roots.push(x);\n      }\n    }\n    prev = curr;\n  }\n  return roots;\n}\n\nfunction analyseFunction(f, df, xlo, xhi) {\n  // Nullpunkter\n  const nullpunkter = findRoots(f, xlo, xhi);\n\n  // y-skjæring\n  const ySkjaering = f(0);\n\n  // Ekstrema: der f'(x) = 0 og f' skifter fortegn\n  const dfRoots = findRoots(df, xlo, xhi, 3000);\n  const topp = [], bunn = [];\n  for (const x of dfRoots) {\n    const dBefore = df(x - 0.01);\n    const dAfter  = df(x + 0.01);\n    if (dBefore > 0 && dAfter < 0) topp.push({ x, y: f(x) });\n    else if (dBefore < 0 && dAfter > 0) bunn.push({ x, y: f(x) });\n  }\n\n  // Stiger / synker\n  // Sample derivative sign\n  const n = 500;\n  const dx = (xhi - xlo) / n;\n  let intervals = [];\n  let sign = Math.sign(df(xlo + dx/2));\n  let start = xlo;\n  for (let i = 1; i <= n; i++) {\n    const xm = xlo + (i - 0.5) * dx;\n    const s = Math.sign(df(xm));\n    if (s !== sign || i === n) {\n      if (sign > 0) intervals.push({ type: 'stiger', fra: start, til: xlo + (i-1)*dx });\n      else if (sign < 0) intervals.push({ type: 'synker', fra: start, til: xlo + (i-1)*dx });\n      start = xlo + (i-1)*dx;\n      sign = s;\n    }\n  }\n\n  return { nullpunkter, ySkjaering, topp, bunn, intervals };\n}\n\n// ============================================================\n//  SVG GRAPH\n// ============================================================\nfunction svgNS(tag, attrs) {\n  const el = document.createElementNS('http://www.w3.org/2000/svg', tag);\n  for (const [k,v] of Object.entries(attrs)) el.setAttribute(k, v);\n  return el;\n}\n\nfunction plotGraph(f, df, xlo, xhi) {\n  const svg = document.getElementById('graphSvg');\n  svg.innerHTML = '';\n\n  const plotW = SVG_W - MARGIN.left - MARGIN.right;\n  const plotH = SVG_H - MARGIN.top - MARGIN.bottom;\n\n  // Sample f for y-range\n  const samples = 600;\n  const ys = [];\n  for (let i = 0; i <= samples; i++) {\n    const x = xlo + (i / samples) * (xhi - xlo);\n    const y = f(x);\n    if (isFinite(y)) ys.push(y);\n  }\n  if (ys.length === 0) return;\n\n  let ylo = Math.min(...ys);\n  let yhi = Math.max(...ys);\n  const yPad = (yhi - ylo) * 0.12 || 1;\n  ylo -= yPad; yhi += yPad;\n\n  // mapping\n  const toSvgX = x => MARGIN.left + ((x - xlo) / (xhi - xlo)) * plotW;\n  const toSvgY = y => MARGIN.top + ((yhi - y) / (yhi - ylo)) * plotH;\n\n  // ---- defs / clip ----\n  const defs = svgNS('defs', {});\n  const clip = svgNS('clipPath', { id: 'plotClip' });\n  const clipRect = svgNS('rect', { x: MARGIN.left, y: MARGIN.top, width: plotW, height: plotH });\n  clip.appendChild(clipRect);\n  defs.appendChild(clip);\n  svg.appendChild(defs);\n\n  // ---- background ----\n  svg.appendChild(svgNS('rect', { x: 0, y: 0, width: SVG_W, height: SVG_H, fill: '#f9fafb' }));\n  svg.appendChild(svgNS('rect', { x: MARGIN.left, y: MARGIN.top, width: plotW, height: plotH, fill: 'white' }));\n\n  // ---- grid ----\n  const gridG = svgNS('g', { 'clip-path': 'url(#plotClip)' });\n\n  // x grid lines\n  const xStep = niceStep(xhi - xlo, 8);\n  const xStart = Math.ceil(xlo / xStep) * xStep;\n  for (let xi = xStart; xi <= xhi + 1e-9; xi += xStep) {\n    const sx = toSvgX(xi);\n    gridG.appendChild(svgNS('line', { x1: sx, y1: MARGIN.top, x2: sx, y2: MARGIN.top + plotH, stroke: '#e5e7eb', 'stroke-width': 1 }));\n  }\n  // y grid lines\n  const yStep = niceStep(yhi - ylo, 6);\n  const yStart = Math.ceil(ylo / yStep) * yStep;\n  for (let yi = yStart; yi <= yhi + 1e-9; yi += yStep) {\n    const sy = toSvgY(yi);\n    gridG.appendChild(svgNS('line', { x1: MARGIN.left, y1: sy, x2: MARGIN.left + plotW, y2: sy, stroke: '#e5e7eb', 'stroke-width': 1 }));\n  }\n  svg.appendChild(gridG);\n\n  // ---- axes ----\n  const axisG = svgNS('g', {});\n  // x-axis (at y=0 if visible)\n  const yZeroSvg = Math.max(MARGIN.top, Math.min(MARGIN.top + plotH, toSvgY(0)));\n  axisG.appendChild(svgNS('line', { x1: MARGIN.left, y1: yZeroSvg, x2: MARGIN.left + plotW, y2: yZeroSvg, stroke: '#374151', 'stroke-width': 1.5 }));\n  // y-axis\n  const xZeroSvg = Math.max(MARGIN.left, Math.min(MARGIN.left + plotW, toSvgX(0)));\n  axisG.appendChild(svgNS('line', { x1: xZeroSvg, y1: MARGIN.top, x2: xZeroSvg, y2: MARGIN.top + plotH, stroke: '#374151', 'stroke-width': 1.5 }));\n  // Arrow heads\n  axisG.appendChild(arrow(MARGIN.left + plotW + 8, yZeroSvg, 'right'));\n  axisG.appendChild(arrow(xZeroSvg, MARGIN.top - 8, 'up'));\n  // Axis labels\n  const xl = svgNS('text', { x: MARGIN.left + plotW + 14, y: yZeroSvg + 5, 'font-size': 13, fill: '#374151', 'font-style': 'italic' });\n  xl.textContent = 'x';\n  axisG.appendChild(xl);\n  const yl = svgNS('text', { x: xZeroSvg - 14, y: MARGIN.top - 10, 'font-size': 13, fill: '#374151', 'font-style': 'italic' });\n  yl.textContent = 'y';\n  axisG.appendChild(yl);\n  svg.appendChild(axisG);\n\n  // ---- tick marks & labels ----\n  const tickG = svgNS('g', {});\n  for (let xi = xStart; xi <= xhi + 1e-9; xi += xStep) {\n    if (Math.abs(xi) < 1e-9) continue;\n    const sx = toSvgX(xi);\n    tickG.appendChild(svgNS('line', { x1: sx, y1: yZeroSvg - 4, x2: sx, y2: yZeroSvg + 4, stroke: '#6b7280', 'stroke-width': 1 }));\n    const t = svgNS('text', { x: sx, y: yZeroSvg + 16, 'text-anchor': 'middle', 'font-size': 11, fill: '#6b7280' });\n    t.textContent = fmtTick(xi);\n    tickG.appendChild(t);\n  }\n  for (let yi = yStart; yi <= yhi + 1e-9; yi += yStep) {\n    if (Math.abs(yi) < 1e-9) continue;\n    const sy = toSvgY(yi);\n    tickG.appendChild(svgNS('line', { x1: xZeroSvg - 4, y1: sy, x2: xZeroSvg + 4, y2: sy, stroke: '#6b7280', 'stroke-width': 1 }));\n    const t = svgNS('text', { x: xZeroSvg - 8, y: sy + 4, 'text-anchor': 'end', 'font-size': 11, fill: '#6b7280' });\n    t.textContent = fmtTick(yi);\n    tickG.appendChild(t);\n  }\n  // Origin label\n  const orig = svgNS('text', { x: xZeroSvg - 6, y: yZeroSvg + 14, 'text-anchor': 'end', 'font-size': 11, fill: '#6b7280' });\n  orig.textContent = '0';\n  tickG.appendChild(orig);\n  svg.appendChild(tickG);\n\n  // ---- function curve ----\n  const curveG = svgNS('g', { 'clip-path': 'url(#plotClip)' });\n  let pathD = '';\n  let penDown = false;\n  for (let i = 0; i <= samples; i++) {\n    const x = xlo + (i / samples) * (xhi - xlo);\n    const y = f(x);\n    if (!isFinite(y) || Math.abs(y) > 1e10) { penDown = false; continue; }\n    const sx = toSvgX(x), sy = toSvgY(y);\n    if (!penDown) { pathD += `M ${sx} ${sy} `; penDown = true; }\n    else pathD += `L ${sx} ${sy} `;\n  }\n  const curvePath = svgNS('path', { d: pathD, fill: 'none', stroke: '#2563eb', 'stroke-width': 2.5, 'stroke-linejoin': 'round' });\n  curveG.appendChild(curvePath);\n  svg.appendChild(curveG);\n\n  // ---- analysis ----\n  const res = analyseFunction(f, df, xlo, xhi);\n  analysisResults = res;\n\n  const markerG = svgNS('g', { 'clip-path': 'url(#plotClip)' });\n\n  // Nullpunkter (grønn)\n  for (const x of res.nullpunkter) {\n    const sx = toSvgX(x), sy = toSvgY(0);\n    markerG.appendChild(circle(sx, sy, 6, '#16a34a', 'white'));\n    markerG.appendChild(pointLabel(sx, sy - 10, `(${fmtCoord(x)}, 0)`, '#15803d'));\n  }\n\n  // y-skjæring (lilla)\n  if (xlo <= 0 && 0 <= xhi) {\n    const sx = toSvgX(0), sy = toSvgY(res.ySkjaering);\n    markerG.appendChild(diamond(sx, sy, 7, '#7c3aed'));\n    markerG.appendChild(pointLabel(sx + 10, sy - 2, `(0, ${fmtCoord(res.ySkjaering)})`, '#6d28d9'));\n  }\n\n  // Toppunkter (rød)\n  for (const pt of res.topp) {\n    const sx = toSvgX(pt.x), sy = toSvgY(pt.y);\n    markerG.appendChild(triangle(sx, sy, 7, '#dc2626', 'up'));\n    markerG.appendChild(pointLabel(sx + 8, sy - 4, `(${fmtCoord(pt.x)}, ${fmtCoord(pt.y)})`, '#b91c1c'));\n  }\n\n  // Bunnpunkter (oransje)\n  for (const pt of res.bunn) {\n    const sx = toSvgX(pt.x), sy = toSvgY(pt.y);\n    markerG.appendChild(triangle(sx, sy, 7, '#ea580c', 'down'));\n    markerG.appendChild(pointLabel(sx + 8, sy + 12, `(${fmtCoord(pt.x)}, ${fmtCoord(pt.y)})`, '#c2410c'));\n  }\n\n  svg.appendChild(markerG);\n\n  // ---- punkt-leser markør (gul) ----\n  const ptG = svgNS('g', { id: 'ptMarkerG', 'clip-path': 'url(#plotClip)' });\n  svg.appendChild(ptG);\n\n  // Store mapping for point reader\n  svg._toSvgX = toSvgX;\n  svg._toSvgY = toSvgY;\n  svg._xlo = xlo;\n  svg._xhi = xhi;\n\n  // Re-draw existing marker if any\n  if (ptMarkerData) {\n    drawPointMarker(ptMarkerData.x);\n  }\n\n  // Show results\n  renderResults(res, xlo, xhi);\n}\n\nfunction arrow(x, y, dir) {\n  const g = svgNS('g', {});\n  let d;\n  if (dir === 'right') d = `M ${x} ${y-4} L ${x+7} ${y} L ${x} ${y+4} Z`;\n  else d = `M ${x-4} ${y} L ${x} ${y-7} L ${x+4} ${y} Z`;\n  g.appendChild(svgNS('path', { d, fill: '#374151' }));\n  return g;\n}\n\nfunction circle(cx, cy, r, fill, stroke) {\n  return svgNS('circle', { cx, cy, r, fill, stroke: stroke||fill, 'stroke-width': 2 });\n}\n\nfunction diamond(cx, cy, r, fill) {\n  const d = `M ${cx} ${cy-r} L ${cx+r} ${cy} L ${cx} ${cy+r} L ${cx-r} ${cy} Z`;\n  return svgNS('path', { d, fill, stroke: 'white', 'stroke-width': 1.5 });\n}\n\nfunction triangle(cx, cy, r, fill, dir) {\n  let d;\n  if (dir === 'up') d = `M ${cx} ${cy-r} L ${cx+r} ${cy+r*0.7} L ${cx-r} ${cy+r*0.7} Z`;\n  else d = `M ${cx} ${cy+r} L ${cx+r} ${cy-r*0.7} L ${cx-r} ${cy-r*0.7} Z`;\n  return svgNS('path', { d, fill, stroke: 'white', 'stroke-width': 1.5 });\n}\n\nfunction pointLabel(x, y, text, color) {\n  const bg = svgNS('rect', { x: x - 2, y: y - 11, width: text.length * 6.5 + 4, height: 14, fill: 'rgba(255,255,255,0.82)', rx: 3 });\n  const t = svgNS('text', { x, y, 'font-size': 10.5, fill: color, 'font-weight': '600' });\n  t.textContent = text;\n  const g = svgNS('g', {});\n  g.appendChild(bg); g.appendChild(t);\n  return g;\n}\n\nfunction niceStep(range, targetCount) {\n  const rough = range / targetCount;\n  const mag = Math.pow(10, Math.floor(Math.log10(rough)));\n  const normed = rough / mag;\n  let nice;\n  if (normed < 1.5) nice = 1;\n  else if (normed < 3.5) nice = 2;\n  else if (normed < 7.5) nice = 5;\n  else nice = 10;\n  return nice * mag;\n}\n\nfunction fmtTick(v) {\n  const s = parseFloat(v.toFixed(3));\n  return s === 0 ? '0' : s.toString();\n}\n\n// ============================================================\n//  POINT READER\n// ============================================================\nfunction drawPointMarker(x) {\n  const svg = document.getElementById('graphSvg');\n  if (!svg._toSvgX || !currentFn) return;\n  const ptG = document.getElementById('ptMarkerG');\n  if (!ptG) return;\n  ptG.innerHTML = '';\n\n  if (!isFinite(x)) return;\n  const y = currentFn(x);\n  if (!isFinite(y)) return;\n\n  const sx = svg._toSvgX(x);\n  const sy = svg._toSvgY(y);\n\n  // crosshair lines\n  ptG.appendChild(svgNS('line', { x1: sx, y1: MARGIN.top, x2: sx, y2: MARGIN.top + (SVG_H - MARGIN.top - MARGIN.bottom), stroke: '#ca8a04', 'stroke-width': 1, 'stroke-dasharray': '4,3' }));\n  ptG.appendChild(svgNS('line', { x1: MARGIN.left, y1: sy, x2: MARGIN.left + (SVG_W - MARGIN.left - MARGIN.right), y2: sy, stroke: '#ca8a04', 'stroke-width': 1, 'stroke-dasharray': '4,3' }));\n  // dot\n  ptG.appendChild(circle(sx, sy, 6, '#eab308', 'white'));\n  ptG.appendChild(pointLabel(sx + 10, sy - 6, `(${fmtCoord(x)}, ${fmtCoord(y)})`, '#92400e'));\n\n  ptMarkerData = { x };\n}\n\ndocument.getElementById('ptBtn').addEventListener('click', () => {\n  if (!currentFn) {\n    document.getElementById('ptResult').textContent = 'Tegn en funksjon først.';\n    return;\n  }\n  const x = parseFloat(document.getElementById('ptX').value);\n  if (isNaN(x)) {\n    document.getElementById('ptResult').textContent = 'Skriv inn en gyldig x-verdi.';\n    return;\n  }\n  const y = currentFn(x);\n  document.getElementById('ptResult').textContent =\n    `f(${fmtCoord(x)}) = ${fmtCoord(y)}`;\n  drawPointMarker(x);\n});\n\ndocument.getElementById('ptClear').addEventListener('click', () => {\n  ptMarkerData = null;\n  const ptG = document.getElementById('ptMarkerG');\n  if (ptG) ptG.innerHTML = '';\n  document.getElementById('ptResult').textContent = '';\n});\n\n// ============================================================\n//  DRØFTINGSRESULTATER HTML\n// ============================================================\nfunction renderResults(res, xlo, xhi) {\n  const el = document.getElementById('resultsContent');\n\n  const nullHTML = res.nullpunkter.length > 0\n    ? res.nullpunkter.map(x => `<span class=\"label-chip bg-green-100 text-green-800\">x = ${fmtCoord(x)}</span>`).join(' ')\n    : '<span class=\"text-gray-500\">Ingen nullpunkt i valgt intervall</span>';\n\n  const toppHTML = res.topp.length > 0\n    ? res.topp.map(p => `<span class=\"label-chip bg-red-100 text-red-800\">(${fmtCoord(p.x)}, ${fmtCoord(p.y)})</span>`).join(' ')\n    : '<span class=\"text-gray-500\">Ingen toppunkt</span>';\n\n  const bunnHTML = res.bunn.length > 0\n    ? res.bunn.map(p => `<span class=\"label-chip bg-orange-100 text-orange-800\">(${fmtCoord(p.x)}, ${fmtCoord(p.y)})</span>`).join(' ')\n    : '<span class=\"text-gray-500\">Ingen bunnpunkt</span>';\n\n  const yHTML = `<span class=\"label-chip bg-purple-100 text-purple-800\">(0, ${fmtCoord(res.ySkjaering)})</span>`;\n\n  // Intervals: merge adjacent same-type\n  let intervalHTML = '';\n  if (res.intervals.length === 0) {\n    intervalHTML = '<span class=\"text-gray-500\">Konstant</span>';\n  } else {\n    intervalHTML = res.intervals.map(iv => {\n      const cls = iv.type === 'stiger' ? 'bg-blue-100 text-blue-800' : 'bg-pink-100 text-pink-800';\n      return `<span class=\"label-chip ${cls}\">${iv.type}: x ∈ (${fmtCoord(iv.fra)}, ${fmtCoord(iv.til)})</span>`;\n    }).join(' ');\n  }\n\n  el.innerHTML = `\n    <div class=\"grid sm:grid-cols-2 gap-4\">\n      <div>\n        <p class=\"text-xs font-semibold text-gray-500 uppercase mb-1\">Nullpunkt(er) — f(x) = 0</p>\n        <div class=\"flex flex-wrap gap-1\">${nullHTML}</div>\n      </div>\n      <div>\n        <p class=\"text-xs font-semibold text-gray-500 uppercase mb-1\">Skjæring med y-aksen</p>\n        <div>${yHTML}</div>\n      </div>\n      <div>\n        <p class=\"text-xs font-semibold text-gray-500 uppercase mb-1\">Toppunkt(er)</p>\n        <div class=\"flex flex-wrap gap-1\">${toppHTML}</div>\n      </div>\n      <div>\n        <p class=\"text-xs font-semibold text-gray-500 uppercase mb-1\">Bunnpunkt(er)</p>\n        <div class=\"flex flex-wrap gap-1\">${bunnHTML}</div>\n      </div>\n      <div class=\"sm:col-span-2\">\n        <p class=\"text-xs font-semibold text-gray-500 uppercase mb-1\">Stiger / Synker</p>\n        <div class=\"flex flex-wrap gap-1\">${intervalHTML}</div>\n      </div>\n    </div>\n  `;\n}\n\n// ============================================================\n//  DRAW BUTTON\n// ============================================================\ndocument.getElementById('drawBtn').addEventListener('click', () => {\n  const errEl = document.getElementById('inputError');\n  errEl.classList.add('hidden');\n\n  const xlo = parseFloat(document.getElementById('xmin').value);\n  const xhi = parseFloat(document.getElementById('xmax').value);\n\n  if (isNaN(xlo) || isNaN(xhi) || xlo >= xhi) {\n    errEl.textContent = 'Ugyldig x-intervall: «x fra» må være mindre enn «x til».';\n    errEl.classList.remove('hidden');\n    return;\n  }\n  if (xhi - xlo > 1000) {\n    errEl.textContent = 'x-intervallet er for stort (maks 1000).';\n    errEl.classList.remove('hidden');\n    return;\n  }\n\n  const built = buildFunction();\n  if (!built) {\n    if (currentType === 'exp') {\n      errEl.textContent = 'Ugyldig eksponentialfunksjon: kontroller at b > 0 og b ≠ 1.';\n    } else {\n      errEl.textContent = 'Ugyldig koeffisient(er).';\n    }\n    errEl.classList.remove('hidden');\n    return;\n  }\n\n  currentFn = built.fn;\n  currentDfn = built.dfn;\n  document.getElementById('funcLabel').textContent = built.label;\n  ptMarkerData = null;\n  plotGraph(currentFn, currentDfn, xlo, xhi);\n});\n\n// Auto-draw on load\ndocument.getElementById('drawBtn').click();\n</script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Funksjonsdrøfting",
    "windowTitle": "Funksjonsdrøfting",
    "bundleId": "com.halisonworks.funksjonsdrofting",
    "iconPath": null
  },
  "categoryId": null,
  "source": "import",
  "createdAt": "2026-06-02T12:00:00.000Z",
  "updatedAt": "2026-06-02T12:00:00.000Z",
  "sharedAt": "2026-06-02T12:00:00.000Z"
}
