{
  "schema": "app-studio/canvas@1",
  "id": "example-no2p-geometri",
  "name": "geometri.html",
  "code": "<!DOCTYPE html>\n<!--\n  Geometri (2P) — Halison App Studio-eksempel\n\n  Interaktivt læremiddel for matematikk 2P (LK20): areal og omkrets (også\n  sammensatte figurer), Pytagoras, volum og overflate, og målestokk og formlikhet.\n\n  Fra Halison App Studio sitt offentlige bibliotek:\n  https://github.com/halisonworks/public-app-studio\n\n  Tillatt bruk: personlig, pedagogisk og annen ikke-kommersiell bruk. Behold denne\n  headeren og kildelenken; ikke-kommersiell bruk. Utgitt under Halison App Studio\n  Examples License — se LICENSE-filen i repoet over.\n-->\n<html lang=\"no\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Geometri – Matematikk 2P (LK20)</title>\n<script src=\"https://cdn.tailwindcss.com\"></script>\n<style>\n  body { font-family: 'Segoe UI', system-ui, sans-serif; }\n  .tab-btn { transition: all 0.2s; }\n  .tab-btn.active { background: #1d4ed8; color: white; }\n  .sub-tab-btn { transition: all 0.2s; }\n  .sub-tab-btn.active { background: #2563eb; color: white; }\n  .section-panel { display: none; }\n  .section-panel.active { display: block; }\n  .sub-panel { display: none; }\n  .sub-panel.active { display: block; }\n  input[type=\"number\"], input[type=\"range\"] { accent-color: #2563eb; }\n  .formula-box {\n    background: #eff6ff;\n    border-left: 4px solid #2563eb;\n    font-family: 'Courier New', monospace;\n  }\n  .result-box {\n    background: #f0fdf4;\n    border-left: 4px solid #16a34a;\n  }\n  .example-box {\n    background: #fefce8;\n    border-left: 4px solid #ca8a04;\n  }\n  svg text { user-select: none; }\n  .dim-label { font-size: 12px; fill: #374151; }\n  .shape-fill { fill: #bfdbfe; stroke: #2563eb; stroke-width: 2; }\n  .shape-fill-green { fill: #bbf7d0; stroke: #16a34a; stroke-width: 2; }\n  .shape-fill-yellow { fill: #fef9c3; stroke: #ca8a04; stroke-width: 2; }\n  .shape-fill-red { fill: #fee2e2; stroke: #dc2626; stroke-width: 2; }\n  .angle-mark { fill: none; stroke: #9ca3af; stroke-width: 1.5; }\n  .right-angle { fill: none; stroke: #9ca3af; stroke-width: 1.5; }\n</style>\n</head>\n<body class=\"bg-gray-50 min-h-screen\">\n\n<!-- HEADER -->\n<header class=\"bg-blue-700 text-white py-4 px-4 shadow-lg\">\n  <div class=\"max-w-5xl mx-auto\">\n    <h1 class=\"text-2xl font-bold\">📐 Geometri – Matematikk 2P</h1>\n    <p class=\"text-blue-200 text-sm mt-1\">Interaktivt læremiddel · LK20 · Bokmål</p>\n  </div>\n</header>\n\n<!-- MAIN NAV TABS -->\n<div class=\"max-w-5xl mx-auto px-4 mt-4\">\n  <div class=\"flex flex-wrap gap-2\">\n    <button class=\"tab-btn active px-4 py-2 rounded-lg font-semibold text-sm bg-gray-200 text-gray-700\" data-tab=\"areal\">\n      1. Areal &amp; omkrets\n    </button>\n    <button class=\"tab-btn px-4 py-2 rounded-lg font-semibold text-sm bg-gray-200 text-gray-700\" data-tab=\"pytagoras\">\n      2. Pytagoras\n    </button>\n    <button class=\"tab-btn px-4 py-2 rounded-lg font-semibold text-sm bg-gray-200 text-gray-700\" data-tab=\"volum\">\n      3. Volum &amp; overflate\n    </button>\n    <button class=\"tab-btn px-4 py-2 rounded-lg font-semibold text-sm bg-gray-200 text-gray-700\" data-tab=\"malestokk\">\n      4. Målestokk &amp; formlikhet\n    </button>\n  </div>\n</div>\n\n<main class=\"max-w-5xl mx-auto px-4 pb-16 mt-4\">\n\n<!-- ===================== SECTION 1: AREAL OG OMKRETS ===================== -->\n<div id=\"sec-areal\" class=\"section-panel active\">\n  <div class=\"bg-white rounded-xl shadow p-5 mb-4\">\n    <h2 class=\"text-xl font-bold text-blue-800 mb-2\">Areal og omkrets – 2D-figurer</h2>\n    <p class=\"text-gray-600 text-sm\">\n      Areal (A) er hvor stort et flateinnhold er – måles i cm², m², osv. Omkrets (O) er den totale lengden rundt figuren.\n      Velg en figur under, skriv inn mål, og se resultatet og figuren oppdatere seg.\n    </p>\n  </div>\n\n  <!-- Sub-tabs -->\n  <div class=\"flex flex-wrap gap-2 mb-4\">\n    <button class=\"sub-tab-btn active px-3 py-1.5 rounded text-sm font-medium bg-gray-100 text-gray-700\" data-group=\"areal\" data-sub=\"kvadrat\">Kvadrat</button>\n    <button class=\"sub-tab-btn px-3 py-1.5 rounded text-sm font-medium bg-gray-100 text-gray-700\" data-group=\"areal\" data-sub=\"rektangel\">Rektangel</button>\n    <button class=\"sub-tab-btn px-3 py-1.5 rounded text-sm font-medium bg-gray-100 text-gray-700\" data-group=\"areal\" data-sub=\"parallellogram\">Parallellogram</button>\n    <button class=\"sub-tab-btn px-3 py-1.5 rounded text-sm font-medium bg-gray-100 text-gray-700\" data-group=\"areal\" data-sub=\"trekant\">Trekant</button>\n    <button class=\"sub-tab-btn px-3 py-1.5 rounded text-sm font-medium bg-gray-100 text-gray-700\" data-group=\"areal\" data-sub=\"trapes\">Trapes</button>\n    <button class=\"sub-tab-btn px-3 py-1.5 rounded text-sm font-medium bg-gray-100 text-gray-700\" data-group=\"areal\" data-sub=\"sirkel\">Sirkel</button>\n    <button class=\"sub-tab-btn px-3 py-1.5 rounded text-sm font-medium bg-gray-100 text-gray-700\" data-group=\"areal\" data-sub=\"sammensatt\">Sammensatt figur</button>\n  </div>\n\n  <!-- KVADRAT -->\n  <div id=\"sub-kvadrat\" class=\"sub-panel active\">\n    <div class=\"grid md:grid-cols-2 gap-4\">\n      <div class=\"bg-white rounded-xl shadow p-5\">\n        <h3 class=\"font-bold text-blue-700 mb-2\">Kvadrat</h3>\n        <p class=\"text-sm text-gray-600 mb-3\">Et kvadrat har fire like sider og fire rette vinkler.</p>\n        <div class=\"formula-box rounded p-3 mb-4 text-sm\">\n          A = s²<br>O = 4 · s\n        </div>\n        <label class=\"block text-sm font-medium text-gray-700 mb-1\">Side s (cm)</label>\n        <input type=\"number\" id=\"kv-s\" min=\"1\" max=\"30\" value=\"5\" step=\"0.5\"\n          class=\"border rounded px-3 py-2 w-full text-sm mb-1\" oninput=\"updateKvadrat()\">\n        <input type=\"range\" id=\"kv-s-r\" min=\"1\" max=\"30\" value=\"5\" step=\"0.5\" class=\"w-full mt-1\" oninput=\"syncRange('kv-s','kv-s-r');updateKvadrat()\">\n        <div id=\"kv-result\" class=\"result-box rounded p-3 mt-4 text-sm\"></div>\n      </div>\n      <div class=\"bg-white rounded-xl shadow p-4 flex items-center justify-center\">\n        <svg id=\"svg-kvadrat\" viewBox=\"0 0 220 220\" width=\"220\" height=\"220\"></svg>\n      </div>\n    </div>\n  </div>\n\n  <!-- REKTANGEL -->\n  <div id=\"sub-rektangel\" class=\"sub-panel\">\n    <div class=\"grid md:grid-cols-2 gap-4\">\n      <div class=\"bg-white rounded-xl shadow p-5\">\n        <h3 class=\"font-bold text-blue-700 mb-2\">Rektangel</h3>\n        <p class=\"text-sm text-gray-600 mb-3\">Et rektangel har to par med like sider og fire rette vinkler. Praktisk eksempel: gulvflaten i et rom.</p>\n        <div class=\"formula-box rounded p-3 mb-4 text-sm\">\n          A = l · b<br>O = 2 · (l + b)\n        </div>\n        <label class=\"block text-sm font-medium text-gray-700 mb-1\">Lengde l (m)</label>\n        <input type=\"number\" id=\"rek-l\" min=\"0.5\" max=\"20\" value=\"6\" step=\"0.5\" class=\"border rounded px-3 py-2 w-full text-sm mb-1\" oninput=\"updateRektangel()\">\n        <input type=\"range\" id=\"rek-l-r\" min=\"0.5\" max=\"20\" value=\"6\" step=\"0.5\" class=\"w-full mt-1\" oninput=\"syncRange('rek-l','rek-l-r');updateRektangel()\">\n        <label class=\"block text-sm font-medium text-gray-700 mb-1 mt-3\">Bredde b (m)</label>\n        <input type=\"number\" id=\"rek-b\" min=\"0.5\" max=\"20\" value=\"4\" step=\"0.5\" class=\"border rounded px-3 py-2 w-full text-sm mb-1\" oninput=\"updateRektangel()\">\n        <input type=\"range\" id=\"rek-b-r\" min=\"0.5\" max=\"20\" value=\"4\" step=\"0.5\" class=\"w-full mt-1\" oninput=\"syncRange('rek-b','rek-b-r');updateRektangel()\">\n        <div id=\"rek-result\" class=\"result-box rounded p-3 mt-4 text-sm\"></div>\n      </div>\n      <div class=\"bg-white rounded-xl shadow p-4 flex items-center justify-center\">\n        <svg id=\"svg-rektangel\" viewBox=\"0 0 260 220\" width=\"260\" height=\"220\"></svg>\n      </div>\n    </div>\n  </div>\n\n  <!-- PARALLELLOGRAM -->\n  <div id=\"sub-parallellogram\" class=\"sub-panel\">\n    <div class=\"grid md:grid-cols-2 gap-4\">\n      <div class=\"bg-white rounded-xl shadow p-5\">\n        <h3 class=\"font-bold text-blue-700 mb-2\">Parallellogram</h3>\n        <p class=\"text-sm text-gray-600 mb-3\">To par med parallelle sider. Arealet avhenger av grunnlinjen og høyden (ikke skråsiden).</p>\n        <div class=\"formula-box rounded p-3 mb-4 text-sm\">\n          A = g · h<br>O = 2 · (g + s)\n        </div>\n        <label class=\"block text-sm font-medium text-gray-700 mb-1\">Grunnlinje g (cm)</label>\n        <input type=\"number\" id=\"par-g\" min=\"1\" max=\"20\" value=\"8\" step=\"0.5\" class=\"border rounded px-3 py-2 w-full text-sm mb-1\" oninput=\"updateParallellogram()\">\n        <input type=\"range\" id=\"par-g-r\" min=\"1\" max=\"20\" value=\"8\" step=\"0.5\" class=\"w-full mt-1\" oninput=\"syncRange('par-g','par-g-r');updateParallellogram()\">\n        <label class=\"block text-sm font-medium text-gray-700 mb-1 mt-3\">Høyde h (cm)</label>\n        <input type=\"number\" id=\"par-h\" min=\"1\" max=\"15\" value=\"5\" step=\"0.5\" class=\"border rounded px-3 py-2 w-full text-sm mb-1\" oninput=\"updateParallellogram()\">\n        <input type=\"range\" id=\"par-h-r\" min=\"1\" max=\"15\" value=\"5\" step=\"0.5\" class=\"w-full mt-1\" oninput=\"syncRange('par-h','par-h-r');updateParallellogram()\">\n        <label class=\"block text-sm font-medium text-gray-700 mb-1 mt-3\">Skråside s (cm)</label>\n        <input type=\"number\" id=\"par-s\" min=\"1\" max=\"20\" value=\"6\" step=\"0.5\" class=\"border rounded px-3 py-2 w-full text-sm mb-1\" oninput=\"updateParallellogram()\">\n        <input type=\"range\" id=\"par-s-r\" min=\"1\" max=\"20\" value=\"6\" step=\"0.5\" class=\"w-full mt-1\" oninput=\"syncRange('par-s','par-s-r');updateParallellogram()\">\n        <div id=\"par-result\" class=\"result-box rounded p-3 mt-4 text-sm\"></div>\n      </div>\n      <div class=\"bg-white rounded-xl shadow p-4 flex items-center justify-center\">\n        <svg id=\"svg-parallellogram\" viewBox=\"0 0 260 200\" width=\"260\" height=\"200\"></svg>\n      </div>\n    </div>\n  </div>\n\n  <!-- TREKANT -->\n  <div id=\"sub-trekant\" class=\"sub-panel\">\n    <div class=\"grid md:grid-cols-2 gap-4\">\n      <div class=\"bg-white rounded-xl shadow p-5\">\n        <h3 class=\"font-bold text-blue-700 mb-2\">Trekant</h3>\n        <p class=\"text-sm text-gray-600 mb-3\">Arealet er halvparten av grunnlinje × høyde. Eks: taket på et hus er ofte trekantet.</p>\n        <div class=\"formula-box rounded p-3 mb-4 text-sm\">\n          A = (g · h) / 2<br>O = a + b + c\n        </div>\n        <label class=\"block text-sm font-medium text-gray-700 mb-1\">Grunnlinje g (cm)</label>\n        <input type=\"number\" id=\"tri-g\" min=\"1\" max=\"20\" value=\"8\" step=\"0.5\" class=\"border rounded px-3 py-2 w-full text-sm mb-1\" oninput=\"updateTrekant()\">\n        <input type=\"range\" id=\"tri-g-r\" min=\"1\" max=\"20\" value=\"8\" step=\"0.5\" class=\"w-full mt-1\" oninput=\"syncRange('tri-g','tri-g-r');updateTrekant()\">\n        <label class=\"block text-sm font-medium text-gray-700 mb-1 mt-3\">Høyde h (cm)</label>\n        <input type=\"number\" id=\"tri-h\" min=\"1\" max=\"20\" value=\"6\" step=\"0.5\" class=\"border rounded px-3 py-2 w-full text-sm mb-1\" oninput=\"updateTrekant()\">\n        <input type=\"range\" id=\"tri-h-r\" min=\"1\" max=\"20\" value=\"6\" step=\"0.5\" class=\"w-full mt-1\" oninput=\"syncRange('tri-h','tri-h-r');updateTrekant()\">\n        <div id=\"tri-result\" class=\"result-box rounded p-3 mt-4 text-sm\"></div>\n      </div>\n      <div class=\"bg-white rounded-xl shadow p-4 flex items-center justify-center\">\n        <svg id=\"svg-trekant\" viewBox=\"0 0 260 200\" width=\"260\" height=\"200\"></svg>\n      </div>\n    </div>\n  </div>\n\n  <!-- TRAPES -->\n  <div id=\"sub-trapes\" class=\"sub-panel\">\n    <div class=\"grid md:grid-cols-2 gap-4\">\n      <div class=\"bg-white rounded-xl shadow p-5\">\n        <h3 class=\"font-bold text-blue-700 mb-2\">Trapes</h3>\n        <p class=\"text-sm text-gray-600 mb-3\">Et trapes har to parallelle sider (a og b) og en høyde h mellom dem. Eks: en trapesformet hage.</p>\n        <div class=\"formula-box rounded p-3 mb-4 text-sm\">\n          A = ((a + b) / 2) · h\n        </div>\n        <label class=\"block text-sm font-medium text-gray-700 mb-1\">Parallellside a (cm)</label>\n        <input type=\"number\" id=\"trap-a\" min=\"1\" max=\"20\" value=\"10\" step=\"0.5\" class=\"border rounded px-3 py-2 w-full text-sm mb-1\" oninput=\"updateTrapes()\">\n        <input type=\"range\" id=\"trap-a-r\" min=\"1\" max=\"20\" value=\"10\" step=\"0.5\" class=\"w-full mt-1\" oninput=\"syncRange('trap-a','trap-a-r');updateTrapes()\">\n        <label class=\"block text-sm font-medium text-gray-700 mb-1 mt-3\">Parallellside b (cm)</label>\n        <input type=\"number\" id=\"trap-b\" min=\"1\" max=\"20\" value=\"6\" step=\"0.5\" class=\"border rounded px-3 py-2 w-full text-sm mb-1\" oninput=\"updateTrapes()\">\n        <input type=\"range\" id=\"trap-b-r\" min=\"1\" max=\"20\" value=\"6\" step=\"0.5\" class=\"w-full mt-1\" oninput=\"syncRange('trap-b','trap-b-r');updateTrapes()\">\n        <label class=\"block text-sm font-medium text-gray-700 mb-1 mt-3\">Høyde h (cm)</label>\n        <input type=\"number\" id=\"trap-h\" min=\"1\" max=\"15\" value=\"4\" step=\"0.5\" class=\"border rounded px-3 py-2 w-full text-sm mb-1\" oninput=\"updateTrapes()\">\n        <input type=\"range\" id=\"trap-h-r\" min=\"1\" max=\"15\" value=\"4\" step=\"0.5\" class=\"w-full mt-1\" oninput=\"syncRange('trap-h','trap-h-r');updateTrapes()\">\n        <div id=\"trap-result\" class=\"result-box rounded p-3 mt-4 text-sm\"></div>\n      </div>\n      <div class=\"bg-white rounded-xl shadow p-4 flex items-center justify-center\">\n        <svg id=\"svg-trapes\" viewBox=\"0 0 260 200\" width=\"260\" height=\"200\"></svg>\n      </div>\n    </div>\n  </div>\n\n  <!-- SIRKEL -->\n  <div id=\"sub-sirkel\" class=\"sub-panel\">\n    <div class=\"grid md:grid-cols-2 gap-4\">\n      <div class=\"bg-white rounded-xl shadow p-5\">\n        <h3 class=\"font-bold text-blue-700 mb-2\">Sirkel</h3>\n        <p class=\"text-sm text-gray-600 mb-3\">En sirkel med radius r. Omkretsen kalles også periferi eller sirkelomkrets (C). Eks: vannpøl, pizzabunn.</p>\n        <div class=\"formula-box rounded p-3 mb-4 text-sm\">\n          A = π · r²<br>O = 2 · π · r<br>Diameter d = 2r\n        </div>\n        <label class=\"block text-sm font-medium text-gray-700 mb-1\">Radius r (cm)</label>\n        <input type=\"number\" id=\"sir-r\" min=\"0.5\" max=\"15\" value=\"5\" step=\"0.5\" class=\"border rounded px-3 py-2 w-full text-sm mb-1\" oninput=\"updateSirkel()\">\n        <input type=\"range\" id=\"sir-r-r\" min=\"0.5\" max=\"15\" value=\"5\" step=\"0.5\" class=\"w-full mt-1\" oninput=\"syncRange('sir-r','sir-r-r');updateSirkel()\">\n        <div id=\"sir-result\" class=\"result-box rounded p-3 mt-4 text-sm\"></div>\n      </div>\n      <div class=\"bg-white rounded-xl shadow p-4 flex items-center justify-center\">\n        <svg id=\"svg-sirkel\" viewBox=\"0 0 220 220\" width=\"220\" height=\"220\"></svg>\n      </div>\n    </div>\n  </div>\n\n  <!-- SAMMENSATT FIGUR -->\n  <div id=\"sub-sammensatt\" class=\"sub-panel\">\n    <div class=\"bg-white rounded-xl shadow p-5 mb-4\">\n      <h3 class=\"font-bold text-blue-700 mb-2\">Sammensatte figurer</h3>\n      <p class=\"text-sm text-gray-600 mb-3\">\n        Mange virkelige former er satt sammen av enklere figurer. Fremgangsmåte:\n        <strong>Del opp → beregn hvert del-areal → summer</strong>.\n      </p>\n      <div class=\"example-box rounded p-4 mb-4 text-sm\">\n        <strong>Praktisk eksempel:</strong> En idrettshall har rektangulær planform med to halvsirkler i endene (en friidrettsbane).\n        Finn total gulvflate og den rektangulære midtdelen separat.\n      </div>\n    </div>\n    <div class=\"grid md:grid-cols-2 gap-4\">\n      <div class=\"bg-white rounded-xl shadow p-5\">\n        <h4 class=\"font-semibold text-gray-700 mb-3\">Rektangel + halvsirkel i hver ende (stadion)</h4>\n        <label class=\"block text-sm font-medium text-gray-700 mb-1\">Lengde rektangel L (m)</label>\n        <input type=\"number\" id=\"sam-l\" min=\"5\" max=\"100\" value=\"40\" step=\"1\" class=\"border rounded px-3 py-2 w-full text-sm mb-1\" oninput=\"updateSammensatt()\">\n        <input type=\"range\" id=\"sam-l-r\" min=\"5\" max=\"100\" value=\"40\" step=\"1\" class=\"w-full mt-1\" oninput=\"syncRange('sam-l','sam-l-r');updateSammensatt()\">\n        <label class=\"block text-sm font-medium text-gray-700 mb-1 mt-3\">Bredde b (m) — også diameter på halvsirklene</label>\n        <input type=\"number\" id=\"sam-b\" min=\"2\" max=\"50\" value=\"20\" step=\"1\" class=\"border rounded px-3 py-2 w-full text-sm mb-1\" oninput=\"updateSammensatt()\">\n        <input type=\"range\" id=\"sam-b-r\" min=\"2\" max=\"50\" value=\"20\" step=\"1\" class=\"w-full mt-1\" oninput=\"syncRange('sam-b','sam-b-r');updateSammensatt()\">\n        <div id=\"sam-result\" class=\"result-box rounded p-3 mt-4 text-sm\"></div>\n        <div id=\"sam-steps\" class=\"example-box rounded p-3 mt-3 text-sm\"></div>\n      </div>\n      <div class=\"bg-white rounded-xl shadow p-4 flex items-center justify-center\">\n        <svg id=\"svg-sammensatt\" viewBox=\"0 0 300 200\" width=\"300\" height=\"200\"></svg>\n      </div>\n    </div>\n  </div>\n</div><!-- end sec-areal -->\n\n<!-- ===================== SECTION 2: PYTAGORAS ===================== -->\n<div id=\"sec-pytagoras\" class=\"section-panel\">\n  <div class=\"bg-white rounded-xl shadow p-5 mb-4\">\n    <h2 class=\"text-xl font-bold text-blue-800 mb-2\">Pytagoras' setning</h2>\n    <p class=\"text-sm text-gray-600 mb-2\">\n      I en rettvinklet trekant er kvadratet av hypotenusen (den lengste siden, mot den rette vinkelen) lik summen av kvadratene av de to katetene.\n    </p>\n    <div class=\"formula-box rounded p-3 text-sm\">\n      a² + b² = c²<br>\n      <span class=\"text-gray-500\">der c er hypotenusen</span>\n    </div>\n  </div>\n\n  <div class=\"bg-white rounded-xl shadow p-5 mb-4\">\n    <h3 class=\"font-semibold text-gray-700 mb-3\">Velg hva du vil finne:</h3>\n    <div class=\"flex flex-wrap gap-3 mb-4\">\n      <button id=\"pyth-find-c\" onclick=\"setPythMode('c')\"\n        class=\"px-4 py-2 rounded-lg text-sm font-medium bg-blue-600 text-white\">\n        Finn hypotenusen c\n      </button>\n      <button id=\"pyth-find-a\" onclick=\"setPythMode('a')\"\n        class=\"px-4 py-2 rounded-lg text-sm font-medium bg-gray-200 text-gray-700\">\n        Finn katet a\n      </button>\n      <button id=\"pyth-find-b\" onclick=\"setPythMode('b')\"\n        class=\"px-4 py-2 rounded-lg text-sm font-medium bg-gray-200 text-gray-700\">\n        Finn katet b\n      </button>\n    </div>\n\n    <div class=\"grid md:grid-cols-2 gap-6\">\n      <div>\n        <div id=\"pyth-inputs-c\">\n          <label class=\"block text-sm font-medium text-gray-700 mb-1\">Katet a (cm)</label>\n          <input type=\"number\" id=\"pyth-a\" min=\"0.5\" max=\"30\" value=\"3\" step=\"0.5\" class=\"border rounded px-3 py-2 w-full text-sm mb-1\" oninput=\"updatePytagoras()\">\n          <input type=\"range\" id=\"pyth-a-r\" min=\"0.5\" max=\"30\" value=\"3\" step=\"0.5\" class=\"w-full mt-1 mb-3\" oninput=\"syncRange('pyth-a','pyth-a-r');updatePytagoras()\">\n          <label class=\"block text-sm font-medium text-gray-700 mb-1\">Katet b (cm)</label>\n          <input type=\"number\" id=\"pyth-b\" min=\"0.5\" max=\"30\" value=\"4\" step=\"0.5\" class=\"border rounded px-3 py-2 w-full text-sm mb-1\" oninput=\"updatePytagoras()\">\n          <input type=\"range\" id=\"pyth-b-r\" min=\"0.5\" max=\"30\" value=\"4\" step=\"0.5\" class=\"w-full mt-1\" oninput=\"syncRange('pyth-b','pyth-b-r');updatePytagoras()\">\n        </div>\n        <div id=\"pyth-inputs-a\" style=\"display:none\">\n          <label class=\"block text-sm font-medium text-gray-700 mb-1\">Katet b (cm)</label>\n          <input type=\"number\" id=\"pyth-ba\" min=\"0.5\" max=\"30\" value=\"4\" step=\"0.5\" class=\"border rounded px-3 py-2 w-full text-sm mb-1\" oninput=\"updatePytagoras()\">\n          <input type=\"range\" id=\"pyth-ba-r\" min=\"0.5\" max=\"30\" value=\"4\" step=\"0.5\" class=\"w-full mt-1 mb-3\" oninput=\"syncRange('pyth-ba','pyth-ba-r');updatePytagoras()\">\n          <label class=\"block text-sm font-medium text-gray-700 mb-1\">Hypotenus c (cm)</label>\n          <input type=\"number\" id=\"pyth-ca\" min=\"0.5\" max=\"40\" value=\"5\" step=\"0.5\" class=\"border rounded px-3 py-2 w-full text-sm mb-1\" oninput=\"updatePytagoras()\">\n          <input type=\"range\" id=\"pyth-ca-r\" min=\"0.5\" max=\"40\" value=\"5\" step=\"0.5\" class=\"w-full mt-1\" oninput=\"syncRange('pyth-ca','pyth-ca-r');updatePytagoras()\">\n        </div>\n        <div id=\"pyth-inputs-b\" style=\"display:none\">\n          <label class=\"block text-sm font-medium text-gray-700 mb-1\">Katet a (cm)</label>\n          <input type=\"number\" id=\"pyth-ab\" min=\"0.5\" max=\"30\" value=\"3\" step=\"0.5\" class=\"border rounded px-3 py-2 w-full text-sm mb-1\" oninput=\"updatePytagoras()\">\n          <input type=\"range\" id=\"pyth-ab-r\" min=\"0.5\" max=\"30\" value=\"3\" step=\"0.5\" class=\"w-full mt-1 mb-3\" oninput=\"syncRange('pyth-ab','pyth-ab-r');updatePytagoras()\">\n          <label class=\"block text-sm font-medium text-gray-700 mb-1\">Hypotenus c (cm)</label>\n          <input type=\"number\" id=\"pyth-cb\" min=\"0.5\" max=\"40\" value=\"5\" step=\"0.5\" class=\"border rounded px-3 py-2 w-full text-sm mb-1\" oninput=\"updatePytagoras()\">\n          <input type=\"range\" id=\"pyth-cb-r\" min=\"0.5\" max=\"40\" value=\"5\" step=\"0.5\" class=\"w-full mt-1\" oninput=\"syncRange('pyth-cb','pyth-cb-r');updatePytagoras()\">\n        </div>\n\n        <div id=\"pyth-result\" class=\"result-box rounded p-3 mt-4 text-sm\"></div>\n        <div id=\"pyth-worked\" class=\"example-box rounded p-3 mt-3 text-sm\"></div>\n      </div>\n      <div class=\"flex items-center justify-center\">\n        <svg id=\"svg-pytagoras\" viewBox=\"0 0 280 240\" width=\"280\" height=\"240\"></svg>\n      </div>\n    </div>\n\n    <div class=\"mt-5 bg-blue-50 rounded-lg p-4 text-sm\">\n      <strong class=\"text-blue-800\">Praktisk eksempel:</strong> En stige er 5 m lang og lener seg mot en vegg slik at bunnen er 2 m fra veggen. Hvor høyt opp på veggen når stigen?<br>\n      h = √(5² − 2²) = √(25 − 4) = √21 ≈ <strong>4,58 m</strong>\n    </div>\n  </div>\n</div><!-- end sec-pytagoras -->\n\n<!-- ===================== SECTION 3: VOLUM OG OVERFLATE ===================== -->\n<div id=\"sec-volum\" class=\"section-panel\">\n  <div class=\"bg-white rounded-xl shadow p-5 mb-4\">\n    <h2 class=\"text-xl font-bold text-blue-800 mb-2\">Volum og overflate – 3D-figurer</h2>\n    <p class=\"text-sm text-gray-600\">\n      Volum (V) måler hvor mye en 3D-figur rommer – i cm³, m³, liter (1 liter = 1 dm³). Overflate (S) er summen av alle flatene.\n    </p>\n  </div>\n\n  <div class=\"flex flex-wrap gap-2 mb-4\">\n    <button class=\"sub-tab-btn active px-3 py-1.5 rounded text-sm font-medium bg-gray-100 text-gray-700\" data-group=\"volum\" data-sub=\"kasse\">Kasse/Prisme</button>\n    <button class=\"sub-tab-btn px-3 py-1.5 rounded text-sm font-medium bg-gray-100 text-gray-700\" data-group=\"volum\" data-sub=\"sylinder\">Sylinder</button>\n    <button class=\"sub-tab-btn px-3 py-1.5 rounded text-sm font-medium bg-gray-100 text-gray-700\" data-group=\"volum\" data-sub=\"kule\">Kule</button>\n    <button class=\"sub-tab-btn px-3 py-1.5 rounded text-sm font-medium bg-gray-100 text-gray-700\" data-group=\"volum\" data-sub=\"kjegle\">Kjegle</button>\n    <button class=\"sub-tab-btn px-3 py-1.5 rounded text-sm font-medium bg-gray-100 text-gray-700\" data-group=\"volum\" data-sub=\"pyramide\">Pyramide</button>\n  </div>\n\n  <!-- KASSE -->\n  <div id=\"sub-kasse\" class=\"sub-panel active\">\n    <div class=\"grid md:grid-cols-2 gap-4\">\n      <div class=\"bg-white rounded-xl shadow p-5\">\n        <h3 class=\"font-bold text-blue-700 mb-2\">Kasse (rektangulært prisme)</h3>\n        <p class=\"text-sm text-gray-600 mb-3\">Eks: en fraktpakke, et rom, en akvarium. Finn volum og totalt overflate.</p>\n        <div class=\"formula-box rounded p-3 mb-4 text-sm\">\n          V = l · b · h<br>S = 2·(l·b + l·h + b·h)\n        </div>\n        <label class=\"block text-sm font-medium text-gray-700 mb-1\">Lengde l (cm)</label>\n        <input type=\"number\" id=\"kas-l\" min=\"1\" max=\"30\" value=\"10\" step=\"0.5\" class=\"border rounded px-3 py-2 w-full text-sm mb-1\" oninput=\"updateKasse()\">\n        <input type=\"range\" id=\"kas-l-r\" min=\"1\" max=\"30\" value=\"10\" step=\"0.5\" class=\"w-full mt-1\" oninput=\"syncRange('kas-l','kas-l-r');updateKasse()\">\n        <label class=\"block text-sm font-medium text-gray-700 mb-1 mt-2\">Bredde b (cm)</label>\n        <input type=\"number\" id=\"kas-b\" min=\"1\" max=\"30\" value=\"6\" step=\"0.5\" class=\"border rounded px-3 py-2 w-full text-sm mb-1\" oninput=\"updateKasse()\">\n        <input type=\"range\" id=\"kas-b-r\" min=\"1\" max=\"30\" value=\"6\" step=\"0.5\" class=\"w-full mt-1\" oninput=\"syncRange('kas-b','kas-b-r');updateKasse()\">\n        <label class=\"block text-sm font-medium text-gray-700 mb-1 mt-2\">Høyde h (cm)</label>\n        <input type=\"number\" id=\"kas-h\" min=\"1\" max=\"30\" value=\"4\" step=\"0.5\" class=\"border rounded px-3 py-2 w-full text-sm mb-1\" oninput=\"updateKasse()\">\n        <input type=\"range\" id=\"kas-h-r\" min=\"1\" max=\"30\" value=\"4\" step=\"0.5\" class=\"w-full mt-1\" oninput=\"syncRange('kas-h','kas-h-r');updateKasse()\">\n        <div id=\"kas-result\" class=\"result-box rounded p-3 mt-4 text-sm\"></div>\n      </div>\n      <div class=\"bg-white rounded-xl shadow p-4 flex items-center justify-center\">\n        <svg id=\"svg-kasse\" viewBox=\"0 0 260 220\" width=\"260\" height=\"220\"></svg>\n      </div>\n    </div>\n  </div>\n\n  <!-- SYLINDER -->\n  <div id=\"sub-sylinder\" class=\"sub-panel\">\n    <div class=\"grid md:grid-cols-2 gap-4\">\n      <div class=\"bg-white rounded-xl shadow p-5\">\n        <h3 class=\"font-bold text-blue-700 mb-2\">Sylinder</h3>\n        <p class=\"text-sm text-gray-600 mb-3\">Eks: en sylinderformet tank til vanningsanlegg, en oljefat eller et drikkeglass.</p>\n        <div class=\"formula-box rounded p-3 mb-4 text-sm\">\n          V = π · r² · h<br>S = 2·π·r² + 2·π·r·h<br><span class=\"text-gray-500\">Volum i liter: V (dm³)</span>\n        </div>\n        <label class=\"block text-sm font-medium text-gray-700 mb-1\">Radius r (dm)</label>\n        <input type=\"number\" id=\"syl-r\" min=\"0.1\" max=\"5\" value=\"0.5\" step=\"0.1\" class=\"border rounded px-3 py-2 w-full text-sm mb-1\" oninput=\"updateSylinder()\">\n        <input type=\"range\" id=\"syl-r-r\" min=\"0.1\" max=\"5\" value=\"0.5\" step=\"0.1\" class=\"w-full mt-1\" oninput=\"syncRange('syl-r','syl-r-r');updateSylinder()\">\n        <label class=\"block text-sm font-medium text-gray-700 mb-1 mt-3\">Høyde h (dm)</label>\n        <input type=\"number\" id=\"syl-h\" min=\"0.1\" max=\"20\" value=\"3\" step=\"0.1\" class=\"border rounded px-3 py-2 w-full text-sm mb-1\" oninput=\"updateSylinder()\">\n        <input type=\"range\" id=\"syl-h-r\" min=\"0.1\" max=\"20\" value=\"3\" step=\"0.1\" class=\"w-full mt-1\" oninput=\"syncRange('syl-h','syl-h-r');updateSylinder()\">\n        <div id=\"syl-result\" class=\"result-box rounded p-3 mt-4 text-sm\"></div>\n      </div>\n      <div class=\"bg-white rounded-xl shadow p-4 flex items-center justify-center\">\n        <svg id=\"svg-sylinder\" viewBox=\"0 0 200 240\" width=\"200\" height=\"240\"></svg>\n      </div>\n    </div>\n  </div>\n\n  <!-- KULE -->\n  <div id=\"sub-kule\" class=\"sub-panel\">\n    <div class=\"grid md:grid-cols-2 gap-4\">\n      <div class=\"bg-white rounded-xl shadow p-5\">\n        <h3 class=\"font-bold text-blue-700 mb-2\">Kule</h3>\n        <p class=\"text-sm text-gray-600 mb-3\">Eks: en fotball, en orange, en gasslagertank.</p>\n        <div class=\"formula-box rounded p-3 mb-4 text-sm\">\n          V = (4/3) · π · r³<br>S = 4 · π · r²\n        </div>\n        <label class=\"block text-sm font-medium text-gray-700 mb-1\">Radius r (cm)</label>\n        <input type=\"number\" id=\"kul-r\" min=\"0.5\" max=\"20\" value=\"5\" step=\"0.5\" class=\"border rounded px-3 py-2 w-full text-sm mb-1\" oninput=\"updateKule()\">\n        <input type=\"range\" id=\"kul-r-r\" min=\"0.5\" max=\"20\" value=\"5\" step=\"0.5\" class=\"w-full mt-1\" oninput=\"syncRange('kul-r','kul-r-r');updateKule()\">\n        <div id=\"kul-result\" class=\"result-box rounded p-3 mt-4 text-sm\"></div>\n      </div>\n      <div class=\"bg-white rounded-xl shadow p-4 flex items-center justify-center\">\n        <svg id=\"svg-kule\" viewBox=\"0 0 220 220\" width=\"220\" height=\"220\"></svg>\n      </div>\n    </div>\n  </div>\n\n  <!-- KJEGLE -->\n  <div id=\"sub-kjegle\" class=\"sub-panel\">\n    <div class=\"grid md:grid-cols-2 gap-4\">\n      <div class=\"bg-white rounded-xl shadow p-5\">\n        <h3 class=\"font-bold text-blue-700 mb-2\">Kjegle</h3>\n        <p class=\"text-sm text-gray-600 mb-3\">Eks: en vaffelkjegle, en trafikkjegle, et telt. Slantelinjens lengde: l = √(r² + h²)</p>\n        <div class=\"formula-box rounded p-3 mb-4 text-sm\">\n          V = (1/3) · π · r² · h<br>S = π·r² + π·r·l<br><span class=\"text-gray-500\">l = √(r² + h²) = slantelinje</span>\n        </div>\n        <label class=\"block text-sm font-medium text-gray-700 mb-1\">Radius r (cm)</label>\n        <input type=\"number\" id=\"kje-r\" min=\"0.5\" max=\"15\" value=\"4\" step=\"0.5\" class=\"border rounded px-3 py-2 w-full text-sm mb-1\" oninput=\"updateKjegle()\">\n        <input type=\"range\" id=\"kje-r-r\" min=\"0.5\" max=\"15\" value=\"4\" step=\"0.5\" class=\"w-full mt-1\" oninput=\"syncRange('kje-r','kje-r-r');updateKjegle()\">\n        <label class=\"block text-sm font-medium text-gray-700 mb-1 mt-3\">Høyde h (cm)</label>\n        <input type=\"number\" id=\"kje-h\" min=\"0.5\" max=\"30\" value=\"9\" step=\"0.5\" class=\"border rounded px-3 py-2 w-full text-sm mb-1\" oninput=\"updateKjegle()\">\n        <input type=\"range\" id=\"kje-h-r\" min=\"0.5\" max=\"30\" value=\"9\" step=\"0.5\" class=\"w-full mt-1\" oninput=\"syncRange('kje-h','kje-h-r');updateKjegle()\">\n        <div id=\"kje-result\" class=\"result-box rounded p-3 mt-4 text-sm\"></div>\n      </div>\n      <div class=\"bg-white rounded-xl shadow p-4 flex items-center justify-center\">\n        <svg id=\"svg-kjegle\" viewBox=\"0 0 200 240\" width=\"200\" height=\"240\"></svg>\n      </div>\n    </div>\n  </div>\n\n  <!-- PYRAMIDE -->\n  <div id=\"sub-pyramide\" class=\"sub-panel\">\n    <div class=\"grid md:grid-cols-2 gap-4\">\n      <div class=\"bg-white rounded-xl shadow p-5\">\n        <h3 class=\"font-bold text-blue-700 mb-2\">Pyramide (kvadratisk grunnflate)</h3>\n        <p class=\"text-sm text-gray-600 mb-3\">Eks: pyramidene i Egypt, takspir. Her med kvadratisk bunn med sidelengde a.</p>\n        <div class=\"formula-box rounded p-3 mb-4 text-sm\">\n          V = (1/3) · a² · h<br>S = a² + 4 · (½ · a · l)<br><span class=\"text-gray-500\">l = √(h² + (a/2)²) = slantelinje</span>\n        </div>\n        <label class=\"block text-sm font-medium text-gray-700 mb-1\">Sidelengde a (m)</label>\n        <input type=\"number\" id=\"pyr-a\" min=\"0.5\" max=\"20\" value=\"6\" step=\"0.5\" class=\"border rounded px-3 py-2 w-full text-sm mb-1\" oninput=\"updatePyramide()\">\n        <input type=\"range\" id=\"pyr-a-r\" min=\"0.5\" max=\"20\" value=\"6\" step=\"0.5\" class=\"w-full mt-1\" oninput=\"syncRange('pyr-a','pyr-a-r');updatePyramide()\">\n        <label class=\"block text-sm font-medium text-gray-700 mb-1 mt-3\">Høyde h (m)</label>\n        <input type=\"number\" id=\"pyr-h\" min=\"0.5\" max=\"30\" value=\"8\" step=\"0.5\" class=\"border rounded px-3 py-2 w-full text-sm mb-1\" oninput=\"updatePyramide()\">\n        <input type=\"range\" id=\"pyr-h-r\" min=\"0.5\" max=\"30\" value=\"8\" step=\"0.5\" class=\"w-full mt-1\" oninput=\"syncRange('pyr-h','pyr-h-r');updatePyramide()\">\n        <div id=\"pyr-result\" class=\"result-box rounded p-3 mt-4 text-sm\"></div>\n      </div>\n      <div class=\"bg-white rounded-xl shadow p-4 flex items-center justify-center\">\n        <svg id=\"svg-pyramide\" viewBox=\"0 0 240 240\" width=\"240\" height=\"240\"></svg>\n      </div>\n    </div>\n  </div>\n</div><!-- end sec-volum -->\n\n<!-- ===================== SECTION 4: MÅLESTOKK OG FORMLIKHET ===================== -->\n<div id=\"sec-malestokk\" class=\"section-panel\">\n  <div class=\"bg-white rounded-xl shadow p-5 mb-4\">\n    <h2 class=\"text-xl font-bold text-blue-800 mb-2\">Målestokk og formlikhet</h2>\n    <p class=\"text-sm text-gray-600\">\n      Målestokk er forholdet mellom en lengde på et kart/tegning og den tilsvarende virkelige lengden.\n      Formlikhet handler om figurer med samme form men ulike størrelser — alle tilsvarende vinkler er like, og sidene er proporsjonale.\n    </p>\n  </div>\n\n  <div class=\"flex flex-wrap gap-2 mb-4\">\n    <button class=\"sub-tab-btn active px-3 py-1.5 rounded text-sm font-medium bg-gray-100 text-gray-700\" data-group=\"malestokk\" data-sub=\"kart\">Målestokk / kart</button>\n    <button class=\"sub-tab-btn px-3 py-1.5 rounded text-sm font-medium bg-gray-100 text-gray-700\" data-group=\"malestokk\" data-sub=\"formlikhet\">Formlikhet</button>\n  </div>\n\n  <!-- KART -->\n  <div id=\"sub-kart\" class=\"sub-panel active\">\n    <div class=\"grid md:grid-cols-2 gap-4\">\n      <div class=\"bg-white rounded-xl shadow p-5\">\n        <h3 class=\"font-bold text-blue-700 mb-2\">Målestokk og kartberegning</h3>\n        <p class=\"text-sm text-gray-600 mb-3\">\n          Målestokk 1 : n betyr at 1 enhet på tegningen svarer til n enheter i virkeligheten.<br>\n          <strong>Lengde:</strong> Virkelighet = kart × n<br>\n          <strong>Areal:</strong> Areal i virkeligheten = areal på kart × n²\n        </p>\n        <div class=\"formula-box rounded p-3 mb-4 text-sm\">\n          L<sub>virkelighet</sub> = L<sub>kart</sub> · n<br>\n          A<sub>virkelighet</sub> = A<sub>kart</sub> · n²\n        </div>\n\n        <label class=\"block text-sm font-medium text-gray-700 mb-1\">Målestokk 1 : n  (n =)</label>\n        <input type=\"number\" id=\"mal-n\" min=\"1\" max=\"100000\" value=\"50000\" step=\"1000\" class=\"border rounded px-3 py-2 w-full text-sm mb-1\" oninput=\"updateMalestokk()\">\n        <input type=\"range\" id=\"mal-n-r\" min=\"100\" max=\"100000\" value=\"50000\" step=\"100\" class=\"w-full mt-1\" oninput=\"syncRange('mal-n','mal-n-r');updateMalestokk()\">\n\n        <div class=\"mt-4 border-t pt-4\">\n          <p class=\"text-sm font-semibold text-gray-700 mb-2\">Kart → Virkelighet</p>\n          <label class=\"block text-sm font-medium text-gray-700 mb-1\">Kartlengde (cm)</label>\n          <input type=\"number\" id=\"mal-kl\" min=\"0.1\" max=\"100\" value=\"3.5\" step=\"0.1\" class=\"border rounded px-3 py-2 w-full text-sm mb-1\" oninput=\"updateMalestokk()\">\n          <label class=\"block text-sm font-medium text-gray-700 mb-1 mt-2\">Kartareal (cm²)</label>\n          <input type=\"number\" id=\"mal-ka\" min=\"0.1\" max=\"1000\" value=\"12\" step=\"0.1\" class=\"border rounded px-3 py-2 w-full text-sm mb-1\" oninput=\"updateMalestokk()\">\n        </div>\n\n        <div class=\"mt-4 border-t pt-4\">\n          <p class=\"text-sm font-semibold text-gray-700 mb-2\">Virkelighet → Kart</p>\n          <label class=\"block text-sm font-medium text-gray-700 mb-1\">Virkelig lengde (m)</label>\n          <input type=\"number\" id=\"mal-vl\" min=\"1\" max=\"100000\" value=\"2500\" step=\"10\" class=\"border rounded px-3 py-2 w-full text-sm mb-1\" oninput=\"updateMalestokk()\">\n          <label class=\"block text-sm font-medium text-gray-700 mb-1 mt-2\">Virkelig areal (m²)</label>\n          <input type=\"number\" id=\"mal-va\" min=\"1\" max=\"1e10\" value=\"500000\" step=\"1000\" class=\"border rounded px-3 py-2 w-full text-sm mb-1\" oninput=\"updateMalestokk()\">\n        </div>\n\n        <div id=\"mal-result\" class=\"result-box rounded p-3 mt-4 text-sm\"></div>\n      </div>\n      <div class=\"bg-white rounded-xl shadow p-4\">\n        <svg id=\"svg-malestokk\" viewBox=\"0 0 300 260\" width=\"300\" height=\"260\"></svg>\n        <div class=\"example-box rounded p-3 mt-3 text-sm\">\n          <strong>Eksempel:</strong> Et kart har målestokk 1 : 50 000. En strek på 3,5 cm tilsvarer 3,5 × 50 000 = 175 000 cm = <strong>1 750 m = 1,75 km</strong> i virkeligheten.\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- FORMLIKHET -->\n  <div id=\"sub-formlikhet\" class=\"sub-panel\">\n    <div class=\"grid md:grid-cols-2 gap-4\">\n      <div class=\"bg-white rounded-xl shadow p-5\">\n        <h3 class=\"font-bold text-blue-700 mb-2\">Formlikhet</h3>\n        <p class=\"text-sm text-gray-600 mb-3\">\n          To figurer er formlike (similære) hvis de har samme form. Da er alle tilsvarende vinkler like og forholdet mellom tilsvarende sider er konstant (skalaforholdet k).\n        </p>\n        <div class=\"formula-box rounded p-3 mb-4 text-sm\">\n          k = side₂ / side₁<br>\n          Areal₂ = Areal₁ · k²<br>\n          Volum₂ = Volum₁ · k³\n        </div>\n        <p class=\"text-sm font-semibold text-gray-700 mb-2\">Trekant 1 (original):</p>\n        <label class=\"block text-sm font-medium text-gray-700 mb-1\">Side a₁ (cm)</label>\n        <input type=\"number\" id=\"fl-a1\" min=\"1\" max=\"20\" value=\"6\" step=\"0.5\" class=\"border rounded px-3 py-2 w-full text-sm mb-1\" oninput=\"updateFormlikhet()\">\n        <label class=\"block text-sm font-medium text-gray-700 mb-1 mt-2\">Side b₁ (cm)</label>\n        <input type=\"number\" id=\"fl-b1\" min=\"1\" max=\"20\" value=\"8\" step=\"0.5\" class=\"border rounded px-3 py-2 w-full text-sm mb-1\" oninput=\"updateFormlikhet()\">\n        <label class=\"block text-sm font-medium text-gray-700 mb-1 mt-2\">Side c₁ (cm)</label>\n        <input type=\"number\" id=\"fl-c1\" min=\"1\" max=\"20\" value=\"10\" step=\"0.5\" class=\"border rounded px-3 py-2 w-full text-sm mb-1\" oninput=\"updateFormlikhet()\">\n        <p class=\"text-sm font-semibold text-gray-700 mb-2 mt-4\">Trekant 2 (formlik):</p>\n        <label class=\"block text-sm font-medium text-gray-700 mb-1\">Skalaforhold k (trekant 2 / trekant 1)</label>\n        <input type=\"number\" id=\"fl-k\" min=\"0.1\" max=\"5\" value=\"1.5\" step=\"0.1\" class=\"border rounded px-3 py-2 w-full text-sm mb-1\" oninput=\"updateFormlikhet()\">\n        <input type=\"range\" id=\"fl-k-r\" min=\"0.1\" max=\"5\" value=\"1.5\" step=\"0.1\" class=\"w-full mt-1\" oninput=\"syncRange('fl-k','fl-k-r');updateFormlikhet()\">\n        <div id=\"fl-result\" class=\"result-box rounded p-3 mt-4 text-sm\"></div>\n      </div>\n      <div class=\"bg-white rounded-xl shadow p-4 flex items-center justify-center\">\n        <svg id=\"svg-formlikhet\" viewBox=\"0 0 300 260\" width=\"300\" height=\"260\"></svg>\n      </div>\n    </div>\n    <div class=\"bg-white rounded-xl shadow p-5 mt-4\">\n      <h4 class=\"font-semibold text-blue-700 mb-2\">Praktisk eksempel: Skyggemåling</h4>\n      <p class=\"text-sm text-gray-600 mb-3\">En person på 1,8 m kaster en skygge på 2,4 m. Samtidig kaster et tre en skygge på 8 m. Siden personen og treet er formlike trekanter med solen:</p>\n      <div class=\"formula-box rounded p-3 mb-3 text-sm\">\n        k = 8 / 2,4 ≈ 3,33<br>\n        Treets høyde = 1,8 · k ≈ 1,8 · 3,33 ≈ 6 m\n      </div>\n      <div class=\"grid md:grid-cols-2 gap-4\">\n        <div>\n          <label class=\"block text-sm font-medium text-gray-700 mb-1\">Personens høyde (m)</label>\n          <input type=\"number\" id=\"sky-ph\" min=\"0.5\" max=\"3\" value=\"1.8\" step=\"0.1\" class=\"border rounded px-3 py-2 w-full text-sm\" oninput=\"updateSkyggekalkulator()\">\n          <label class=\"block text-sm font-medium text-gray-700 mb-1 mt-2\">Personens skygge (m)</label>\n          <input type=\"number\" id=\"sky-ps\" min=\"0.1\" max=\"20\" value=\"2.4\" step=\"0.1\" class=\"border rounded px-3 py-2 w-full text-sm\" oninput=\"updateSkyggekalkulator()\">\n          <label class=\"block text-sm font-medium text-gray-700 mb-1 mt-2\">Treets skygge (m)</label>\n          <input type=\"number\" id=\"sky-ts\" min=\"0.1\" max=\"100\" value=\"8\" step=\"0.1\" class=\"border rounded px-3 py-2 w-full text-sm\" oninput=\"updateSkyggekalkulator()\">\n          <div id=\"sky-result\" class=\"result-box rounded p-3 mt-3 text-sm\"></div>\n        </div>\n        <div class=\"flex items-center justify-center\">\n          <svg id=\"svg-skyggekalkulator\" viewBox=\"0 0 280 180\" width=\"280\" height=\"180\"></svg>\n        </div>\n      </div>\n    </div>\n  </div>\n</div><!-- end sec-malestokk -->\n\n</main>\n\n<footer class=\"text-center text-xs text-gray-400 py-6 border-t\">\n  Geometri 2P · LK20 · Halison App Studio ·\n  <a href=\"https://github.com/halisonworks/public-app-studio\" class=\"text-blue-400 hover:underline\">github.com/halisonworks/public-app-studio</a>\n</footer>\n\n<script>\n// ============================================================\n// UTILITIES\n// ============================================================\nconst R = (n, d = 2) => Math.round(n * 10 ** d) / 10 ** d;\nconst π = Math.PI;\n\nfunction syncRange(numId, rangeId) {\n  const num = document.getElementById(numId);\n  const rng = document.getElementById(rangeId);\n  if (num && rng) {\n    if (document.activeElement === rng) num.value = rng.value;\n    else rng.value = num.value;\n  }\n}\n\nfunction getVal(id) {\n  const el = document.getElementById(id);\n  if (!el) return 0;\n  return parseFloat(el.value) || 0;\n}\n\nfunction setSVG(id, content) {\n  const el = document.getElementById(id);\n  if (el) el.innerHTML = content;\n}\n\nfunction setHTML(id, html) {\n  const el = document.getElementById(id);\n  if (el) el.innerHTML = html;\n}\n\n// localStorage helpers\nfunction saveLS(key, val) {\n  try { localStorage.setItem('geo2p_' + key, val); } catch (e) {}\n}\nfunction loadLS(key, def) {\n  try {\n    const v = localStorage.getItem('geo2p_' + key);\n    return v !== null ? v : def;\n  } catch (e) { return def; }\n}\n\n// ============================================================\n// TAB NAVIGATION\n// ============================================================\nconst mainSections = { areal: 'sec-areal', pytagoras: 'sec-pytagoras', volum: 'sec-volum', malestokk: 'sec-malestokk' };\n\ndocument.querySelectorAll('.tab-btn').forEach(btn => {\n  btn.addEventListener('click', () => {\n    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));\n    btn.classList.add('active');\n    const tab = btn.dataset.tab;\n    Object.values(mainSections).forEach(id => {\n      const el = document.getElementById(id);\n      if (el) el.classList.remove('active');\n    });\n    const target = document.getElementById(mainSections[tab]);\n    if (target) target.classList.add('active');\n    saveLS('maintab', tab);\n    triggerAllUpdates();\n  });\n});\n\ndocument.querySelectorAll('.sub-tab-btn').forEach(btn => {\n  btn.addEventListener('click', () => {\n    const group = btn.dataset.group;\n    document.querySelectorAll(`.sub-tab-btn[data-group=\"${group}\"]`).forEach(b => b.classList.remove('active'));\n    btn.classList.add('active');\n    const sub = btn.dataset.sub;\n    // find parent section, hide all sub-panels within it\n    const parentSec = btn.closest('.section-panel') || document.body;\n    parentSec.querySelectorAll('.sub-panel').forEach(p => p.classList.remove('active'));\n    const target = document.getElementById('sub-' + sub);\n    if (target) target.classList.add('active');\n    saveLS('subtab_' + group, sub);\n    triggerAllUpdates();\n  });\n});\n\n// ============================================================\n// SECTION 1: AREAL OG OMKRETS\n// ============================================================\n\n// --- KVADRAT ---\nfunction updateKvadrat() {\n  const s = getVal('kv-s');\n  syncRange('kv-s', 'kv-s-r');\n  const A = s * s;\n  const O = 4 * s;\n  setHTML('kv-result', `\n    <strong>Beregning:</strong><br>\n    A = s² = ${s}² = <strong>${R(A)} cm²</strong><br>\n    O = 4 · s = 4 · ${s} = <strong>${R(O)} cm</strong>\n  `);\n  const pad = 30, max = 160;\n  const side = Math.min(max, Math.max(20, s * 10));\n  const x0 = (220 - side) / 2, y0 = (220 - side) / 2;\n  setSVG('svg-kvadrat', `\n    <rect x=\"${x0}\" y=\"${y0}\" width=\"${side}\" height=\"${side}\" class=\"shape-fill\"/>\n    <text x=\"${110}\" y=\"${y0 - 8}\" text-anchor=\"middle\" class=\"dim-label\">s = ${s} cm</text>\n    <text x=\"${110}\" y=\"${y0 + side + 16}\" text-anchor=\"middle\" class=\"dim-label\">s = ${s} cm</text>\n    <line x1=\"${x0-2}\" y1=\"${y0}\" x2=\"${x0-2}\" y2=\"${y0+side}\" stroke=\"#6b7280\" stroke-width=\"1\"/>\n    <text x=\"${x0-8}\" y=\"${y0+side/2}\" text-anchor=\"middle\" class=\"dim-label\" transform=\"rotate(-90,${x0-8},${y0+side/2})\">s = ${s}</text>\n  `);\n  saveLS('kv-s', s);\n}\n\n// --- REKTANGEL ---\nfunction updateRektangel() {\n  const l = getVal('rek-l'), b = getVal('rek-b');\n  syncRange('rek-l', 'rek-l-r'); syncRange('rek-b', 'rek-b-r');\n  const A = l * b, O = 2 * (l + b);\n  setHTML('rek-result', `\n    <strong>Beregning:</strong><br>\n    A = l · b = ${l} · ${b} = <strong>${R(A)} m²</strong><br>\n    O = 2·(l + b) = 2·(${l} + ${b}) = <strong>${R(O)} m</strong>\n  `);\n  const totalW = 220, totalH = 160;\n  const scale = Math.min(totalW / Math.max(l, 0.1), totalH / Math.max(b, 0.1));\n  const w = Math.max(20, Math.min(210, l * scale * 0.85));\n  const h = Math.max(15, Math.min(150, b * scale * 0.85));\n  const x0 = (260 - w) / 2, y0 = (220 - h) / 2;\n  setSVG('svg-rektangel', `\n    <rect x=\"${x0}\" y=\"${y0}\" width=\"${w}\" height=\"${h}\" class=\"shape-fill\"/>\n    <text x=\"${x0 + w/2}\" y=\"${y0-8}\" text-anchor=\"middle\" class=\"dim-label\">l = ${l} m</text>\n    <text x=\"${x0 + w + 10}\" y=\"${y0 + h/2 + 4}\" text-anchor=\"start\" class=\"dim-label\">b = ${b} m</text>\n  `);\n}\n\n// --- PARALLELLOGRAM ---\nfunction updateParallellogram() {\n  const g = getVal('par-g'), h = getVal('par-h'), s = getVal('par-s');\n  syncRange('par-g', 'par-g-r'); syncRange('par-h', 'par-h-r'); syncRange('par-s', 'par-s-r');\n  const A = g * h, O = 2 * (g + s);\n  setHTML('par-result', `\n    <strong>Beregning:</strong><br>\n    A = g · h = ${g} · ${h} = <strong>${R(A)} cm²</strong><br>\n    O = 2·(g + s) = 2·(${g} + ${s}) = <strong>${R(O)} cm</strong>\n  `);\n  const scaleG = Math.min(180 / Math.max(g, 1), 14);\n  const scaleH = Math.min(120 / Math.max(h, 1), 14);\n  const sc = Math.min(scaleG, scaleH, 10);\n  const gw = g * sc, hh = h * sc;\n  const skew = Math.min(hh * 0.6, 40);\n  const x0 = 30, y0 = 185;\n  const pts = `${x0+skew},${y0-hh} ${x0+skew+gw},${y0-hh} ${x0+gw},${y0} ${x0},${y0}`;\n  setSVG('svg-parallellogram', `\n    <polygon points=\"${pts}\" class=\"shape-fill\"/>\n    <text x=\"${x0 + skew + gw/2}\" y=\"${y0-hh-8}\" text-anchor=\"middle\" class=\"dim-label\">g = ${g} cm</text>\n    <line x1=\"${x0+skew+gw+5}\" y1=\"${y0-hh}\" x2=\"${x0+gw+5}\" y2=\"${y0}\" stroke=\"#9ca3af\" stroke-width=\"1\" stroke-dasharray=\"3,2\"/>\n    <line x1=\"${x0+skew+gw+12}\" y1=\"${y0-hh}\" x2=\"${x0+skew+gw+12}\" y2=\"${y0-hh+3}\" stroke=\"#9ca3af\" stroke-width=\"1\"/>\n    <text x=\"${x0+gw+skew+20}\" y=\"${y0-hh/2}\" class=\"dim-label\">h = ${h}</text>\n    <line x1=\"${x0}\" y1=\"${y0+5}\" x2=\"${x0+gw}\" y2=\"${y0+5}\" stroke=\"#6b7280\" stroke-width=\"1\"/>\n    <text x=\"${x0 + gw/2}\" y=\"${y0+18}\" text-anchor=\"middle\" class=\"dim-label\">g = ${g} cm</text>\n  `);\n}\n\n// --- TREKANT ---\nfunction updateTrekant() {\n  const g = getVal('tri-g'), h = getVal('tri-h');\n  syncRange('tri-g', 'tri-g-r'); syncRange('tri-h', 'tri-h-r');\n  const A = (g * h) / 2;\n  // Isoceles: compute side lengths approximately for omkrets display\n  const halfG = g / 2;\n  const side = Math.sqrt(halfG * halfG + h * h);\n  const O = g + 2 * side;\n  setHTML('tri-result', `\n    <strong>Beregning:</strong><br>\n    A = (g · h) / 2 = (${g} · ${h}) / 2 = <strong>${R(A)} cm²</strong><br>\n    (Likebent trekant: side ≈ ${R(side)} cm)<br>\n    O ≈ g + 2·side = ${g} + 2·${R(side)} = <strong>${R(O)} cm</strong>\n  `);\n  const sc = Math.min(160 / Math.max(g, 1), 120 / Math.max(h, 1), 12);\n  const gw = g * sc, hh = h * sc;\n  const x0 = (260 - gw) / 2, y0 = 185;\n  const apex_x = x0 + gw / 2, apex_y = y0 - hh;\n  setSVG('svg-trekant', `\n    <polygon points=\"${x0},${y0} ${x0+gw},${y0} ${apex_x},${apex_y}\" class=\"shape-fill\"/>\n    <line x1=\"${apex_x}\" y1=\"${apex_y}\" x2=\"${apex_x}\" y2=\"${y0}\" stroke=\"#9ca3af\" stroke-width=\"1.5\" stroke-dasharray=\"4,3\"/>\n    <rect x=\"${apex_x-4}\" y=\"${y0-8}\" width=\"8\" height=\"8\" class=\"right-angle\"/>\n    <text x=\"${apex_x+5}\" y=\"${y0-hh/2}\" class=\"dim-label\">h = ${h} cm</text>\n    <text x=\"${x0 + gw/2}\" y=\"${y0+16}\" text-anchor=\"middle\" class=\"dim-label\">g = ${g} cm</text>\n  `);\n}\n\n// --- TRAPES ---\nfunction updateTrapes() {\n  const a = getVal('trap-a'), b = getVal('trap-b'), h = getVal('trap-h');\n  syncRange('trap-a', 'trap-a-r'); syncRange('trap-b', 'trap-b-r'); syncRange('trap-h', 'trap-h-r');\n  const A = ((a + b) / 2) * h;\n  setHTML('trap-result', `\n    <strong>Beregning:</strong><br>\n    A = ((a + b) / 2) · h<br>\n    = ((${a} + ${b}) / 2) · ${h}<br>\n    = ${R((a+b)/2)} · ${h}<br>\n    = <strong>${R(A)} cm²</strong>\n  `);\n  const sc = Math.min(180 / Math.max(a, 1), 120 / Math.max(h, 1), 12);\n  const aw = a * sc, bw = b * sc, hh = h * sc;\n  const x0 = 20, y0 = 175;\n  const offset = (aw - bw) / 2;\n  setSVG('svg-trapes', `\n    <polygon points=\"${x0},${y0} ${x0+aw},${y0} ${x0+aw-offset},${y0-hh} ${x0+offset},${y0-hh}\" class=\"shape-fill\"/>\n    <text x=\"${x0 + aw/2}\" y=\"${y0+16}\" text-anchor=\"middle\" class=\"dim-label\">a = ${a} cm</text>\n    <text x=\"${x0+offset + bw/2}\" y=\"${y0-hh-8}\" text-anchor=\"middle\" class=\"dim-label\">b = ${b} cm</text>\n    <line x1=\"${x0+aw+8}\" y1=\"${y0}\" x2=\"${x0+aw+8}\" y2=\"${y0-hh}\" stroke=\"#9ca3af\" stroke-width=\"1\"/>\n    <text x=\"${x0+aw+18}\" y=\"${y0-hh/2+4}\" class=\"dim-label\">h=${h}</text>\n  `);\n}\n\n// --- SIRKEL ---\nfunction updateSirkel() {\n  const r = getVal('sir-r');\n  syncRange('sir-r', 'sir-r-r');\n  const A = π * r * r, O = 2 * π * r, d = 2 * r;\n  setHTML('sir-result', `\n    <strong>Beregning:</strong><br>\n    A = π · r² = π · ${r}² = <strong>${R(A)} cm²</strong><br>\n    O = 2·π·r = 2·π·${r} = <strong>${R(O)} cm</strong><br>\n    Diameter d = 2·${r} = <strong>${R(d)} cm</strong>\n  `);\n  const cx = 110, cy = 110;\n  const maxR = 90;\n  const rv = Math.min(maxR, r * 8);\n  setSVG('svg-sirkel', `\n    <circle cx=\"${cx}\" cy=\"${cy}\" r=\"${rv}\" class=\"shape-fill\"/>\n    <line x1=\"${cx}\" y1=\"${cy}\" x2=\"${cx+rv}\" y2=\"${cy}\" stroke=\"#2563eb\" stroke-width=\"1.5\"/>\n    <text x=\"${cx + rv/2}\" y=\"${cy-6}\" text-anchor=\"middle\" class=\"dim-label\">r = ${r} cm</text>\n    <line x1=\"${cx-rv}\" y1=\"${cy+rv+15}\" x2=\"${cx+rv}\" y2=\"${cy+rv+15}\" stroke=\"#6b7280\" stroke-width=\"1\"/>\n    <text x=\"${cx}\" y=\"${cy+rv+28}\" text-anchor=\"middle\" class=\"dim-label\">d = ${d} cm</text>\n  `);\n}\n\n// --- SAMMENSATT ---\nfunction updateSammensatt() {\n  const L = getVal('sam-l'), b = getVal('sam-b');\n  syncRange('sam-l', 'sam-l-r'); syncRange('sam-b', 'sam-b-r');\n  const r = b / 2;\n  const A_rek = L * b;\n  const A_2halvsirkler = π * r * r; // to halvsirkler = én hel sirkel\n  const A_total = A_rek + A_2halvsirkler;\n  const O_lang = 2 * L; // de to lange sidene\n  const O_sirkler = 2 * π * r;\n  const O_total = O_lang + O_sirkler;\n  setHTML('sam-result', `\n    <strong>Samlet areal:</strong> <strong>${R(A_total)} m²</strong><br>\n    Samlet omkrets: ${R(O_total)} m\n  `);\n  setHTML('sam-steps', `\n    <strong>Steg-for-steg utregning:</strong><br>\n    1) Rektangel: A₁ = L · b = ${L} · ${b} = ${R(A_rek)} m²<br>\n    2) To halvsirkler = én sirkel med r = b/2 = ${R(r)} m<br>\n       A₂ = π·r² = π·${R(r)}² ≈ ${R(A_2halvsirkler)} m²<br>\n    3) Totalt: A = A₁ + A₂ = ${R(A_rek)} + ${R(A_2halvsirkler)} = <strong>${R(A_total)} m²</strong>\n  `);\n  // Draw the stadium\n  const W = 300, H = 200;\n  const sc = Math.min((W - 60) / Math.max(L + b, 1), (H - 40) / Math.max(b, 1), 5);\n  const rw = L * sc, rh = b * sc;\n  const rad = rh / 2;\n  const x0 = (W - rw - 2*rad) / 2, y0 = (H - rh) / 2;\n  setSVG('svg-sammensatt', `\n    <rect x=\"${x0+rad}\" y=\"${y0}\" width=\"${rw}\" height=\"${rh}\" fill=\"#bfdbfe\" stroke=\"#2563eb\" stroke-width=\"2\"/>\n    <ellipse cx=\"${x0+rad}\" cy=\"${y0+rh/2}\" rx=\"${rad}\" ry=\"${rh/2}\" fill=\"#bbf7d0\" stroke=\"#16a34a\" stroke-width=\"2\"/>\n    <ellipse cx=\"${x0+rad+rw}\" cy=\"${y0+rh/2}\" rx=\"${rad}\" ry=\"${rh/2}\" fill=\"#bbf7d0\" stroke=\"#16a34a\" stroke-width=\"2\"/>\n    <text x=\"${x0+rad+rw/2}\" y=\"${y0+rh/2+5}\" text-anchor=\"middle\" class=\"dim-label\" fill=\"#1e40af\">L=${L}m</text>\n    <text x=\"${x0+rad+rw/2}\" y=\"${H-8}\" text-anchor=\"middle\" class=\"dim-label\">b = ${b} m</text>\n    <text x=\"${x0+rad/2}\" y=\"${y0+rh/2+5}\" text-anchor=\"middle\" class=\"dim-label\" fill=\"#14532d\" font-size=\"10\">½-sirkel</text>\n    <text x=\"${x0+rad+rw+rad/2}\" y=\"${y0+rh/2+5}\" text-anchor=\"middle\" class=\"dim-label\" fill=\"#14532d\" font-size=\"10\">½-sirkel</text>\n  `);\n}\n\n// ============================================================\n// SECTION 2: PYTAGORAS\n// ============================================================\nlet pythMode = 'c';\n\nfunction setPythMode(mode) {\n  pythMode = mode;\n  ['c','a','b'].forEach(m => {\n    const btn = document.getElementById('pyth-find-' + m);\n    const inputs = document.getElementById('pyth-inputs-' + m);\n    if (btn) btn.className = m === mode\n      ? 'px-4 py-2 rounded-lg text-sm font-medium bg-blue-600 text-white'\n      : 'px-4 py-2 rounded-lg text-sm font-medium bg-gray-200 text-gray-700';\n    if (inputs) inputs.style.display = m === mode ? 'block' : 'none';\n  });\n  updatePytagoras();\n}\n\nfunction updatePytagoras() {\n  let a, b, c, found, worked;\n  if (pythMode === 'c') {\n    a = getVal('pyth-a'); b = getVal('pyth-b');\n    syncRange('pyth-a', 'pyth-a-r'); syncRange('pyth-b', 'pyth-b-r');\n    const c2 = a*a + b*b;\n    c = Math.sqrt(c2);\n    found = c;\n    worked = `a² + b² = c²<br>${a}² + ${b}² = c²<br>${R(a*a)} + ${R(b*b)} = ${R(c2)}<br>c = √${R(c2)} = <strong>${R(c)} cm</strong>`;\n  } else if (pythMode === 'a') {\n    b = getVal('pyth-ba'); c = getVal('pyth-ca');\n    syncRange('pyth-ba', 'pyth-ba-r'); syncRange('pyth-ca', 'pyth-ca-r');\n    const a2 = c*c - b*b;\n    if (a2 <= 0) {\n      setHTML('pyth-result', '<span class=\"text-red-600\">Ugyldig: c må være større enn b!</span>');\n      setHTML('pyth-worked', '');\n      return;\n    }\n    a = Math.sqrt(a2);\n    found = a;\n    worked = `a² = c² − b²<br>${c}² − ${b}² = ${R(a2)}<br>a = √${R(a2)} = <strong>${R(a)} cm</strong>`;\n  } else {\n    a = getVal('pyth-ab'); c = getVal('pyth-cb');\n    syncRange('pyth-ab', 'pyth-ab-r'); syncRange('pyth-cb', 'pyth-cb-r');\n    const b2 = c*c - a*a;\n    if (b2 <= 0) {\n      setHTML('pyth-result', '<span class=\"text-red-600\">Ugyldig: c må være større enn a!</span>');\n      setHTML('pyth-worked', '');\n      return;\n    }\n    b = Math.sqrt(b2);\n    found = b;\n    worked = `b² = c² − a²<br>${c}² − ${a}² = ${R(b2)}<br>b = √${R(b2)} = <strong>${R(b)} cm</strong>`;\n  }\n\n  const findLabel = pythMode === 'c' ? 'Hypotenus c' : (pythMode === 'a' ? 'Katet a' : 'Katet b');\n  setHTML('pyth-result', `<strong>${findLabel} = ${R(found)} cm</strong>`);\n  setHTML('pyth-worked', `<strong>Utregning:</strong><br>${worked}`);\n\n  // Draw triangle\n  if (!a || !b || !c) return;\n  const W = 280, H = 240;\n  const scA = Math.min(180 / Math.max(a, 1), 14);\n  const scB = Math.min(130 / Math.max(b, 1), 14);\n  const sc = Math.min(scA, scB, 10);\n  const aw = a * sc, bh = b * sc;\n  const x0 = 30, y0 = H - 30;\n  const pts_triangle = `${x0},${y0} ${x0+aw},${y0} ${x0+aw},${y0-bh}`;\n  const hyp_x = (x0 + x0 + aw) / 2;\n  const hyp_y = (y0 + y0 - bh) / 2;\n  setSVG('svg-pytagoras', `\n    <polygon points=\"${pts_triangle}\" class=\"shape-fill\"/>\n    <!-- right angle mark -->\n    <polyline points=\"${x0+aw-10},${y0} ${x0+aw-10},${y0-10} ${x0+aw},${y0-10}\" class=\"right-angle\"/>\n    <!-- labels -->\n    <text x=\"${x0 + aw/2}\" y=\"${y0+18}\" text-anchor=\"middle\" class=\"dim-label\" ${pythMode==='c'&&false?'font-weight:bold':''}>a = ${R(a)} cm</text>\n    <text x=\"${x0+aw+12}\" y=\"${y0-bh/2}\" class=\"dim-label\">b = ${R(b)} cm</text>\n    <text x=\"${hyp_x - 15}\" y=\"${hyp_y - 8}\" class=\"dim-label\" fill=\"#dc2626\">c = ${R(c)} cm</text>\n    <!-- squares on sides for visual -->\n    <text x=\"${x0-20}\" y=\"${y0-bh/2}\" text-anchor=\"middle\" class=\"dim-label\" font-size=\"10\" fill=\"#6b7280\">(katet)</text>\n  `);\n}\n\n// ============================================================\n// SECTION 3: VOLUM OG OVERFLATE\n// ============================================================\n\n// --- KASSE ---\nfunction updateKasse() {\n  const l = getVal('kas-l'), b = getVal('kas-b'), h = getVal('kas-h');\n  syncRange('kas-l', 'kas-l-r'); syncRange('kas-b', 'kas-b-r'); syncRange('kas-h', 'kas-h-r');\n  const V = l * b * h;\n  const S = 2 * (l*b + l*h + b*h);\n  const liter = V / 1000;\n  setHTML('kas-result', `\n    <strong>Beregning:</strong><br>\n    V = l·b·h = ${l}·${b}·${h} = <strong>${R(V)} cm³</strong> (≈ ${R(liter,3)} liter)<br>\n    S = 2·(l·b + l·h + b·h)<br>\n    = 2·(${l}·${b} + ${l}·${h} + ${b}·${h})<br>\n    = 2·(${R(l*b)} + ${R(l*h)} + ${R(b*h)})<br>\n    = <strong>${R(S)} cm²</strong>\n  `);\n  // Isometric-style box\n  const W = 260, H = 220;\n  const sc = Math.min(120/Math.max(l,1), 100/Math.max(b,1), 80/Math.max(h,1), 8);\n  const lw = l*sc, bw = b*sc*0.5, hh = h*sc;\n  const ox = 40 + bw/2, oy = 60 + hh;\n  // Front face\n  const f = `${ox},${oy} ${ox+lw},${oy} ${ox+lw},${oy-hh} ${ox},${oy-hh}`;\n  // Top face\n  const t = `${ox},${oy-hh} ${ox+lw},${oy-hh} ${ox+lw+bw},${oy-hh-bw} ${ox+bw},${oy-hh-bw}`;\n  // Right face\n  const r = `${ox+lw},${oy} ${ox+lw+bw},${oy-bw} ${ox+lw+bw},${oy-hh-bw} ${ox+lw},${oy-hh}`;\n  setSVG('svg-kasse', `\n    <polygon points=\"${f}\" fill=\"#bfdbfe\" stroke=\"#2563eb\" stroke-width=\"1.5\"/>\n    <polygon points=\"${t}\" fill=\"#93c5fd\" stroke=\"#2563eb\" stroke-width=\"1.5\"/>\n    <polygon points=\"${r}\" fill=\"#dbeafe\" stroke=\"#2563eb\" stroke-width=\"1.5\"/>\n    <text x=\"${ox + lw/2}\" y=\"${oy+15}\" text-anchor=\"middle\" class=\"dim-label\">l = ${l} cm</text>\n    <text x=\"${ox+lw+bw+5}\" y=\"${oy-bw/2}\" class=\"dim-label\">b = ${b} cm</text>\n    <text x=\"${ox-12}\" y=\"${oy-hh/2}\" text-anchor=\"end\" class=\"dim-label\">h = ${h}</text>\n  `);\n}\n\n// --- SYLINDER ---\nfunction updateSylinder() {\n  const r = getVal('syl-r'), h = getVal('syl-h');\n  syncRange('syl-r', 'syl-r-r'); syncRange('syl-h', 'syl-h-r');\n  const V = π * r * r * h;\n  const S = 2 * π * r * r + 2 * π * r * h;\n  setHTML('syl-result', `\n    <strong>Beregning (dm = 10 cm, 1 dm³ = 1 liter):</strong><br>\n    V = π·r²·h = π·${r}²·${h} = <strong>${R(V)} dm³ = ${R(V)} liter</strong><br>\n    S = 2·π·r² + 2·π·r·h<br>\n    = 2·π·${r}² + 2·π·${r}·${h}<br>\n    = ${R(2*π*r*r)} + ${R(2*π*r*h)}<br>\n    = <strong>${R(S)} dm²</strong>\n  `);\n  const W = 200, H = 240;\n  const sc = Math.min(70/Math.max(r,0.1), 150/Math.max(h,0.1), 20);\n  const rw = r*sc, hh = Math.min(h*sc, 170);\n  const cx = W/2, y0 = 30;\n  setSVG('svg-sylinder', `\n    <!-- body -->\n    <rect x=\"${cx-rw}\" y=\"${y0+rw/2}\" width=\"${rw*2}\" height=\"${hh}\" fill=\"#bfdbfe\" stroke=\"#2563eb\" stroke-width=\"1.5\"/>\n    <!-- bottom ellipse -->\n    <ellipse cx=\"${cx}\" cy=\"${y0+hh+rw/2}\" rx=\"${rw}\" ry=\"${rw/3}\" fill=\"#93c5fd\" stroke=\"#2563eb\" stroke-width=\"1.5\"/>\n    <!-- top ellipse -->\n    <ellipse cx=\"${cx}\" cy=\"${y0+rw/2}\" rx=\"${rw}\" ry=\"${rw/3}\" fill=\"#dbeafe\" stroke=\"#2563eb\" stroke-width=\"1.5\"/>\n    <line x1=\"${cx}\" y1=\"${y0+rw/2}\" x2=\"${cx+rw}\" y2=\"${y0+rw/2}\" stroke=\"#2563eb\" stroke-width=\"1.5\"/>\n    <text x=\"${cx + rw/2}\" y=\"${y0+rw/2-6}\" text-anchor=\"middle\" class=\"dim-label\">r=${r}dm</text>\n    <line x1=\"${cx+rw+5}\" y1=\"${y0+rw/2}\" x2=\"${cx+rw+5}\" y2=\"${y0+hh+rw/2}\" stroke=\"#6b7280\" stroke-width=\"1\"/>\n    <text x=\"${cx+rw+18}\" y=\"${y0+hh/2+rw/2}\" class=\"dim-label\">h=${h}dm</text>\n  `);\n}\n\n// --- KULE ---\nfunction updateKule() {\n  const r = getVal('kul-r');\n  syncRange('kul-r', 'kul-r-r');\n  const V = (4/3) * π * r * r * r;\n  const S = 4 * π * r * r;\n  setHTML('kul-result', `\n    <strong>Beregning:</strong><br>\n    V = (4/3)·π·r³ = (4/3)·π·${r}³ = <strong>${R(V)} cm³</strong><br>\n    S = 4·π·r² = 4·π·${r}² = <strong>${R(S)} cm²</strong>\n  `);\n  const cx = 110, cy = 110;\n  const rv = Math.min(90, r * 7);\n  setSVG('svg-kule', `\n    <defs>\n      <radialGradient id=\"ballGrad\" cx=\"35%\" cy=\"35%\" r=\"60%\">\n        <stop offset=\"0%\" stop-color=\"#dbeafe\"/>\n        <stop offset=\"100%\" stop-color=\"#2563eb\"/>\n      </radialGradient>\n    </defs>\n    <circle cx=\"${cx}\" cy=\"${cy}\" r=\"${rv}\" fill=\"url(#ballGrad)\" stroke=\"#1d4ed8\" stroke-width=\"1.5\"/>\n    <ellipse cx=\"${cx}\" cy=\"${cy}\" rx=\"${rv}\" ry=\"${rv*0.3}\" fill=\"none\" stroke=\"#93c5fd\" stroke-width=\"1\" stroke-dasharray=\"4,3\"/>\n    <line x1=\"${cx}\" y1=\"${cy}\" x2=\"${cx+rv}\" y2=\"${cy}\" stroke=\"#1d4ed8\" stroke-width=\"1.5\"/>\n    <text x=\"${cx + rv/2}\" y=\"${cy-6}\" text-anchor=\"middle\" class=\"dim-label\">r = ${r} cm</text>\n  `);\n}\n\n// --- KJEGLE ---\nfunction updateKjegle() {\n  const r = getVal('kje-r'), h = getVal('kje-h');\n  syncRange('kje-r', 'kje-r-r'); syncRange('kje-h', 'kje-h-r');\n  const l = Math.sqrt(r*r + h*h);\n  const V = (1/3) * π * r * r * h;\n  const S = π * r * r + π * r * l;\n  setHTML('kje-result', `\n    <strong>Beregning:</strong><br>\n    Slantelinje: l = √(r²+h²) = √(${r}²+${h}²) = ${R(l)} cm<br>\n    V = (1/3)·π·r²·h = (1/3)·π·${r}²·${h} = <strong>${R(V)} cm³</strong><br>\n    S = π·r² + π·r·l = π·${r}² + π·${r}·${R(l)}<br>\n    = ${R(π*r*r)} + ${R(π*r*l)} = <strong>${R(S)} cm²</strong>\n  `);\n  const W = 200, H = 240;\n  const sc = Math.min(70/Math.max(r,0.1), 160/Math.max(h,0.1), 15);\n  const rw = r*sc, hh = Math.min(h*sc, 170);\n  const cx = W/2, yt = 25, yb = yt + hh;\n  setSVG('svg-kjegle', `\n    <polygon points=\"${cx},${yt} ${cx-rw},${yb} ${cx+rw},${yb}\" fill=\"#bfdbfe\" stroke=\"#2563eb\" stroke-width=\"1.5\"/>\n    <ellipse cx=\"${cx}\" cy=\"${yb}\" rx=\"${rw}\" ry=\"${rw/3}\" fill=\"#93c5fd\" stroke=\"#2563eb\" stroke-width=\"1.5\"/>\n    <line x1=\"${cx}\" y1=\"${yb}\" x2=\"${cx+rw}\" y2=\"${yb}\" stroke=\"#1d4ed8\" stroke-width=\"1.5\"/>\n    <text x=\"${cx + rw/2}\" y=\"${yb+14}\" text-anchor=\"middle\" class=\"dim-label\">r=${r}cm</text>\n    <line x1=\"${cx+rw+5}\" y1=\"${yt}\" x2=\"${cx+rw+5}\" y2=\"${yb}\" stroke=\"#6b7280\" stroke-width=\"1\"/>\n    <text x=\"${cx+rw+18}\" y=\"${yt+hh/2}\" class=\"dim-label\">h=${h}cm</text>\n  `);\n}\n\n// --- PYRAMIDE ---\nfunction updatePyramide() {\n  const a = getVal('pyr-a'), h = getVal('pyr-h');\n  syncRange('pyr-a', 'pyr-a-r'); syncRange('pyr-h', 'pyr-h-r');\n  const l = Math.sqrt(h*h + (a/2)*(a/2));\n  const V = (1/3) * a * a * h;\n  const S_base = a * a;\n  const S_lateral = 4 * (0.5 * a * l);\n  const S = S_base + S_lateral;\n  setHTML('pyr-result', `\n    <strong>Beregning:</strong><br>\n    Slantelinje: l = √(h²+(a/2)²) = √(${h}²+${R(a/2)}²) = ${R(l)} m<br>\n    V = (1/3)·a²·h = (1/3)·${a}²·${h} = <strong>${R(V)} m³</strong><br>\n    S = a² + 4·(½·a·l)<br>\n    = ${R(S_base)} + 4·${R(0.5*a*l)} = <strong>${R(S)} m²</strong>\n  `);\n  // Isometric pyramide\n  const W = 240, H = 240;\n  const sc = Math.min(140/Math.max(a,1), 130/Math.max(h,1), 10);\n  const aw = a * sc, ah = h * sc;\n  const skew = aw * 0.35;\n  const cx = W/2, ybase = H - 40;\n  // base rhombus\n  const bx0 = cx - aw/2, by0 = ybase;\n  const base = `${bx0},${by0} ${bx0+aw},${by0} ${bx0+aw+skew},${by0-skew} ${bx0+skew},${by0-skew}`;\n  const apex_x = cx + skew/2, apex_y = ybase - skew/2 - ah;\n  // left face\n  const lf = `${bx0},${by0} ${bx0+skew},${by0-skew} ${apex_x},${apex_y}`;\n  // right face\n  const rf = `${bx0+aw},${by0} ${bx0+aw+skew},${by0-skew} ${apex_x},${apex_y}`;\n  // front face\n  const ff = `${bx0},${by0} ${bx0+aw},${by0} ${apex_x},${apex_y}`;\n  setSVG('svg-pyramide', `\n    <polygon points=\"${base}\" fill=\"#fef9c3\" stroke=\"#ca8a04\" stroke-width=\"1.5\"/>\n    <polygon points=\"${lf}\" fill=\"#bbf7d0\" stroke=\"#16a34a\" stroke-width=\"1.5\"/>\n    <polygon points=\"${rf}\" fill=\"#bfdbfe\" stroke=\"#2563eb\" stroke-width=\"1.5\"/>\n    <polygon points=\"${ff}\" fill=\"#dbeafe\" stroke=\"#2563eb\" stroke-width=\"1.5\"/>\n    <line x1=\"${apex_x}\" y1=\"${apex_y}\" x2=\"${cx+skew/2}\" y2=\"${ybase-skew/2}\" stroke=\"#9ca3af\" stroke-width=\"1\" stroke-dasharray=\"4,3\"/>\n    <text x=\"${cx}\" y=\"${ybase+15}\" text-anchor=\"middle\" class=\"dim-label\">a = ${a} m</text>\n    <text x=\"${apex_x+8}\" y=\"${apex_y + ah/2}\" class=\"dim-label\">h = ${h} m</text>\n  `);\n}\n\n// ============================================================\n// SECTION 4: MÅLESTOKK OG FORMLIKHET\n// ============================================================\n\n// --- MÅLESTOKK ---\nfunction updateMalestokk() {\n  const n = getVal('mal-n');\n  syncRange('mal-n', 'mal-n-r');\n  const kl = getVal('mal-kl');\n  const ka = getVal('mal-ka');\n  const vl = getVal('mal-vl');\n  const va = getVal('mal-va');\n\n  // kart -> virkelighet\n  const virkL_cm = kl * n; // cm\n  const virkL_m = virkL_cm / 100;\n  const virkL_km = virkL_m / 1000;\n  const virkA_cm2 = ka * n * n;\n  const virkA_m2 = virkA_cm2 / (100*100);\n  const virkA_km2 = virkA_m2 / 1e6;\n\n  // virkelighet -> kart\n  const kartL_m_cm = (vl / n) * 100; // vl is in meters, n is dimensionless ratio (1cm = n cm real)\n  // Actually: target 1cm on map = n cm in reality = n/100 m\n  // kartL in cm = vl_m / (n/100) / 100 ??? Let's be precise:\n  // 1 cm map = n cm real = n/100 m real\n  // kart_cm = vl_m / (n/100) = vl_m * 100 / n\n  const kartL_cm = (vl * 100) / n;\n  const kartL_mm = kartL_cm * 10;\n  // va in m², 1 cm² map = (n/100)² m² real → kart_cm² = va / (n/100)²\n  const kartA_cm2 = va / Math.pow(n/100, 2);\n\n  setHTML('mal-result', `\n    <strong>Målestokk 1 : ${n.toLocaleString('no')}</strong><br>\n    <em>Kart → Virkelighet:</em><br>\n    ${kl} cm på kart = <strong>${R(virkL_m)} m</strong> (${R(virkL_km,3)} km)<br>\n    ${ka} cm² på kart = <strong>${R(virkA_m2)} m²</strong> (${R(virkA_km2,4)} km²)<br>\n    <em>Virkelighet → Kart:</em><br>\n    ${vl} m i virkeligheten = <strong>${R(kartL_cm,3)} cm</strong> (${R(kartL_mm,2)} mm) på kart<br>\n    ${va.toLocaleString('no')} m² i virkeligheten = <strong>${R(kartA_cm2,2)} cm²</strong> på kart\n  `);\n\n  // Draw scale illustration\n  const W = 300, H = 260;\n  const mapW = 80, mapH = 60;\n  const scale_vis = Math.min(5, n / 10000);\n  const realW = Math.min(200, mapW * 2.5), realH = Math.min(140, mapH * 2.5);\n  setSVG('svg-malestokk', `\n    <!-- Map rectangle -->\n    <rect x=\"20\" y=\"20\" width=\"${mapW}\" height=\"${mapH}\" fill=\"#bfdbfe\" stroke=\"#2563eb\" stroke-width=\"2\"/>\n    <text x=\"${20+mapW/2}\" y=\"${20+mapH/2+5}\" text-anchor=\"middle\" class=\"dim-label\" font-size=\"10\">Kart</text>\n    <text x=\"${20+mapW/2}\" y=\"${20+mapH+15}\" text-anchor=\"middle\" class=\"dim-label\" font-size=\"10\">${kl} cm</text>\n    <!-- Arrow -->\n    <line x1=\"${20+mapW+10}\" y1=\"${20+mapH/2}\" x2=\"${20+mapW+40}\" y2=\"${20+mapH/2}\" stroke=\"#374151\" stroke-width=\"1.5\" marker-end=\"url(#arr)\"/>\n    <text x=\"${20+mapW+25}\" y=\"${20+mapH/2-6}\" text-anchor=\"middle\" class=\"dim-label\" font-size=\"10\">×${n.toLocaleString('no')}</text>\n    <!-- Real rectangle (scaled visually) -->\n    <rect x=\"${20+mapW+60}\" y=\"20\" width=\"${Math.max(40, Math.min(100, mapW+30))}\" height=\"${Math.max(30, Math.min(80, mapH+20))}\" fill=\"#bbf7d0\" stroke=\"#16a34a\" stroke-width=\"2\"/>\n    <text x=\"${20+mapW+60+Math.min(100,mapW+30)/2}\" y=\"${20+Math.min(80,mapH+20)/2+5}\" text-anchor=\"middle\" class=\"dim-label\" font-size=\"10\">Virkelighet</text>\n    <text x=\"${20+mapW+60+Math.min(100,mapW+30)/2}\" y=\"${20+Math.min(80,mapH+20)+15}\" text-anchor=\"middle\" class=\"dim-label\" font-size=\"10\">${R(virkL_m)} m</text>\n    <!-- Scale bar -->\n    <rect x=\"20\" y=\"150\" width=\"100\" height=\"14\" fill=\"#f3f4f6\" stroke=\"#6b7280\" stroke-width=\"1\"/>\n    <rect x=\"20\" y=\"150\" width=\"50\" height=\"14\" fill=\"#374151\"/>\n    <text x=\"20\" y=\"178\" class=\"dim-label\" font-size=\"11\">0</text>\n    <text x=\"68\" y=\"178\" class=\"dim-label\" font-size=\"11\">${R(virkL_m/2)} m</text>\n    <text x=\"118\" y=\"178\" class=\"dim-label\" font-size=\"11\">${R(virkL_m)} m</text>\n    <text x=\"20\" y=\"200\" class=\"dim-label\" font-size=\"10\">Målestokk 1 : ${n.toLocaleString('no')}</text>\n    <!-- Areal note -->\n    <text x=\"20\" y=\"225\" class=\"dim-label\" fill=\"#7c3aed\" font-size=\"11\">Areal skalerer med n² = ${n.toLocaleString('no')}² = ${(n*n).toLocaleString('no')}</text>\n    <defs>\n      <marker id=\"arr\" markerWidth=\"6\" markerHeight=\"6\" refX=\"6\" refY=\"3\" orient=\"auto\">\n        <path d=\"M0,0 L6,3 L0,6 Z\" fill=\"#374151\"/>\n      </marker>\n    </defs>\n  `);\n}\n\n// --- FORMLIKHET ---\nfunction updateFormlikhet() {\n  const a1 = getVal('fl-a1'), b1 = getVal('fl-b1'), c1 = getVal('fl-c1');\n  const k = getVal('fl-k');\n  syncRange('fl-k', 'fl-k-r');\n  const a2 = a1 * k, b2 = b1 * k, c2 = c1 * k;\n  // Heron's formula for area of triangle 1\n  const s1 = (a1 + b1 + c1) / 2;\n  const disc1 = s1*(s1-a1)*(s1-b1)*(s1-c1);\n  const A1 = disc1 > 0 ? Math.sqrt(disc1) : 0;\n  const A2 = A1 * k * k;\n  setHTML('fl-result', `\n    <strong>Trekant 2 (k = ${k}):</strong><br>\n    a₂ = a₁·k = ${a1}·${k} = <strong>${R(a2)} cm</strong><br>\n    b₂ = b₁·k = ${b1}·${k} = <strong>${R(b2)} cm</strong><br>\n    c₂ = c₁·k = ${c1}·${k} = <strong>${R(c2)} cm</strong><br>\n    Areal₁ ≈ ${R(A1)} cm²<br>\n    Areal₂ = Areal₁ · k² = ${R(A1)} · ${k}² = <strong>${R(A2)} cm²</strong>\n  `);\n\n  // Draw both triangles side by side (isosceles approximation for display)\n  const W = 300, H = 260;\n  const maxW1 = 90, maxH1 = 70;\n  const sc1 = Math.min(maxW1 / Math.max(b1, 1), maxH1 / Math.max(a1, 1), 8);\n  const sc2 = sc1 * k;\n  // Triangle 1: right triangle approx with sides a1, b1, c1\n  // Use first two sides as legs for display simplicity\n  const leg_a1 = Math.min(a1 * sc1, 80), leg_b1 = Math.min(b1 * sc1, 60);\n  const leg_a2 = Math.min(a2 * sc1, 150), leg_b2 = Math.min(b2 * sc1, 100);\n  const x1 = 20, y1 = 130;\n  const x2 = 160, y2 = 230;\n  setSVG('svg-formlikhet', `\n    <!-- Triangle 1 -->\n    <polygon points=\"${x1},${y1} ${x1+leg_b1},${y1} ${x1+leg_b1},${y1-leg_a1}\" fill=\"#bfdbfe\" stroke=\"#2563eb\" stroke-width=\"2\"/>\n    <text x=\"${x1 + leg_b1/2}\" y=\"${y1+14}\" text-anchor=\"middle\" class=\"dim-label\" fill=\"#1d4ed8\">b₁=${b1}cm</text>\n    <text x=\"${x1+leg_b1+6}\" y=\"${y1-leg_a1/2}\" class=\"dim-label\" fill=\"#1d4ed8\">a₁=${a1}</text>\n    <text x=\"${x1-5}\" y=\"${y1-leg_a1-5}\" class=\"dim-label\" fill=\"#1d4ed8\">Trekant 1</text>\n    <!-- Triangle 2 (scaled) -->\n    <polygon points=\"${x2},${y2} ${x2+Math.min(leg_b2,120)},${y2} ${x2+Math.min(leg_b2,120)},${y2-Math.min(leg_a2,100)}\" fill=\"#bbf7d0\" stroke=\"#16a34a\" stroke-width=\"2\"/>\n    <text x=\"${x2 + Math.min(leg_b2,120)/2}\" y=\"${y2+14}\" text-anchor=\"middle\" class=\"dim-label\" fill=\"#15803d\">b₂=${R(b2)}cm</text>\n    <text x=\"${x2+Math.min(leg_b2,120)+6}\" y=\"${y2-Math.min(leg_a2,100)/2}\" class=\"dim-label\" fill=\"#15803d\">a₂=${R(a2)}</text>\n    <text x=\"${x2-5}\" y=\"${y2-Math.min(leg_a2,100)-5}\" class=\"dim-label\" fill=\"#15803d\">Trekant 2 (k=${k})</text>\n    <!-- k label -->\n    <text x=\"145\" y=\"80\" text-anchor=\"middle\" class=\"dim-label\" fill=\"#9333ea\" font-size=\"13\">k = ${k}</text>\n    <text x=\"145\" y=\"95\" text-anchor=\"middle\" class=\"dim-label\" fill=\"#9333ea\" font-size=\"11\">A₂/A₁ = k² = ${R(k*k)}</text>\n  `);\n}\n\n// --- SKYGGEKALKULATOR ---\nfunction updateSkyggekalkulator() {\n  const ph = getVal('sky-ph'), ps = getVal('sky-ps'), ts = getVal('sky-ts');\n  if (ps <= 0) { setHTML('sky-result', '<span class=\"text-red-600\">Ugyldig verdi</span>'); return; }\n  const k = ts / ps;\n  const th = ph * k;\n  setHTML('sky-result', `\n    k = tresskygge / personsskygge = ${ts} / ${ps} = ${R(k)}<br>\n    Treets høyde = ${ph} · ${R(k)} = <strong>${R(th)} m</strong>\n  `);\n\n  // Simple diagram\n  const W = 280, H = 180;\n  const ground_y = H - 20;\n  const p_x = 40, p_h = Math.min(80, ph * 12);\n  const t_x = 160, t_h = Math.min(130, th * 8);\n  setSVG('svg-skyggekalkulator', `\n    <!-- ground -->\n    <line x1=\"0\" y1=\"${ground_y}\" x2=\"${W}\" y2=\"${ground_y}\" stroke=\"#92400e\" stroke-width=\"2\"/>\n    <!-- person -->\n    <line x1=\"${p_x}\" y1=\"${ground_y}\" x2=\"${p_x}\" y2=\"${ground_y - p_h}\" stroke=\"#374151\" stroke-width=\"3\"/>\n    <circle cx=\"${p_x}\" cy=\"${ground_y - p_h - 7}\" r=\"7\" fill=\"#374151\"/>\n    <!-- person shadow -->\n    <line x1=\"${p_x}\" y1=\"${ground_y}\" x2=\"${p_x + Math.min(70, ps*10)}\" y2=\"${ground_y}\" stroke=\"#fbbf24\" stroke-width=\"3\"/>\n    <text x=\"${p_x + Math.min(35, ps*5)}\" y=\"${ground_y+14}\" text-anchor=\"middle\" class=\"dim-label\" fill=\"#92400e\">${ps}m</text>\n    <!-- tree -->\n    <line x1=\"${t_x}\" y1=\"${ground_y}\" x2=\"${t_x}\" y2=\"${ground_y - t_h}\" stroke=\"#15803d\" stroke-width=\"4\"/>\n    <polygon points=\"${t_x},${ground_y - t_h - 25} ${t_x-20},${ground_y - t_h + 5} ${t_x+20},${ground_y - t_h + 5}\" fill=\"#16a34a\"/>\n    <!-- tree shadow -->\n    <line x1=\"${t_x}\" y1=\"${ground_y}\" x2=\"${Math.min(W-10, t_x + Math.min(90, ts*8))}\" y2=\"${ground_y}\" stroke=\"#fbbf24\" stroke-width=\"3\"/>\n    <text x=\"${t_x + Math.min(45, ts*4)}\" y=\"${ground_y+14}\" text-anchor=\"middle\" class=\"dim-label\" fill=\"#92400e\">${ts}m</text>\n    <!-- height labels -->\n    <text x=\"${p_x+10}\" y=\"${ground_y - p_h/2}\" class=\"dim-label\" fill=\"#374151\">${ph}m</text>\n    <text x=\"${t_x+10}\" y=\"${ground_y - t_h/2}\" class=\"dim-label\" fill=\"#15803d\">${R(th)}m</text>\n    <!-- sun -->\n    <circle cx=\"250\" cy=\"20\" r=\"12\" fill=\"#fbbf24\"/>\n    <line x1=\"${p_x}\" y1=\"${ground_y - p_h}\" x2=\"${t_x + Math.min(90, ts*8)}\" y2=\"${ground_y}\" stroke=\"#fde68a\" stroke-width=\"1\" stroke-dasharray=\"4,3\"/>\n  `);\n}\n\n// ============================================================\n// TRIGGER ALL UPDATES\n// ============================================================\nfunction triggerAllUpdates() {\n  updateKvadrat();\n  updateRektangel();\n  updateParallellogram();\n  updateTrekant();\n  updateTrapes();\n  updateSirkel();\n  updateSammensatt();\n  updatePytagoras();\n  updateKasse();\n  updateSylinder();\n  updateKule();\n  updateKjegle();\n  updatePyramide();\n  updateMalestokk();\n  updateFormlikhet();\n  updateSkyggekalkulator();\n}\n\n// ============================================================\n// RESTORE FROM LOCALSTORAGE\n// ============================================================\nfunction restoreFromLS() {\n  const fields = [\n    ['kv-s', '5'], ['rek-l','6'], ['rek-b','4'],\n    ['par-g','8'], ['par-h','5'], ['par-s','6'],\n    ['tri-g','8'], ['tri-h','6'],\n    ['trap-a','10'], ['trap-b','6'], ['trap-h','4'],\n    ['sir-r','5'],\n    ['sam-l','40'], ['sam-b','20'],\n    ['pyth-a','3'], ['pyth-b','4'], ['pyth-ba','4'], ['pyth-ca','5'], ['pyth-ab','3'], ['pyth-cb','5'],\n    ['kas-l','10'], ['kas-b','6'], ['kas-h','4'],\n    ['syl-r','0.5'], ['syl-h','3'],\n    ['kul-r','5'],\n    ['kje-r','4'], ['kje-h','9'],\n    ['pyr-a','6'], ['pyr-h','8'],\n    ['mal-n','50000'], ['mal-kl','3.5'], ['mal-ka','12'], ['mal-vl','2500'], ['mal-va','500000'],\n    ['fl-a1','6'], ['fl-b1','8'], ['fl-c1','10'], ['fl-k','1.5'],\n    ['sky-ph','1.8'], ['sky-ps','2.4'], ['sky-ts','8']\n  ];\n  fields.forEach(([id, def]) => {\n    const saved = loadLS(id, def);\n    const el = document.getElementById(id);\n    if (el) el.value = saved;\n    // sync range\n    const rng = document.getElementById(id + '-r');\n    if (rng) rng.value = saved;\n  });\n}\n\n// Add save-on-input for localStorage for all number inputs\ndocument.querySelectorAll('input[type=\"number\"]').forEach(inp => {\n  inp.addEventListener('input', () => {\n    saveLS(inp.id, inp.value);\n  });\n});\n\n// ============================================================\n// INIT\n// ============================================================\nrestoreFromLS();\ntriggerAllUpdates();\n\n// Restore active tab\n(function() {\n  const tab = loadLS('maintab', 'areal');\n  const btn = document.querySelector(`.tab-btn[data-tab=\"${tab}\"]`);\n  if (btn) btn.click();\n})();\n</script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Geometri (2P)",
    "windowTitle": "Geometri (2P)",
    "bundleId": "com.halisonworks.geometri2p",
    "iconPath": null
  },
  "categoryId": null,
  "source": "import",
