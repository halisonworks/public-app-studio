{
  "schema": "app-studio/canvas@1",
  "id": "example-no2p-potenser-og-standardform",
  "name": "potenser-og-standardform.html",
  "code": "<!DOCTYPE html>\n<!--\n  Potenser og standardform — Halison App Studio-eksempel\n\n  Interaktivt læremiddel for matematikk 2P (LK20): potensreglene, a⁰ og a⁻ⁿ, og\n  tall på standardform — med steg-for-steg utregning.\n\n  Fra Halison App Studio sitt offentlige bibliotek:\n  https://github.com/halisonworks/public-app-studio\n\n  Tillatt bruk: personlig, pedagogisk og annen ikke-kommersiell bruk. Behold denne\n  headeren og kildelenken; ikke-kommersiell bruk. Utgitt under Halison App Studio\n  Examples License — se LICENSE-filen i repoet over.\n-->\n<html lang=\"no\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Potenser og standardform – Matematikk 2P</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Segoe UI', system-ui, sans-serif; }\n    .tab-active { @apply bg-blue-600 text-white; }\n    .step-box {\n      background: #f0f7ff;\n      border-left: 4px solid #3b82f6;\n      border-radius: 0.375rem;\n      padding: 0.75rem 1rem;\n      margin-top: 0.5rem;\n      font-size: 1rem;\n    }\n    .result-box {\n      background: #ecfdf5;\n      border-left: 4px solid #10b981;\n      border-radius: 0.375rem;\n      padding: 0.75rem 1rem;\n      margin-top: 0.5rem;\n      font-weight: 600;\n      font-size: 1.05rem;\n    }\n    .error-box {\n      background: #fff1f2;\n      border-left: 4px solid #ef4444;\n      border-radius: 0.375rem;\n      padding: 0.75rem 1rem;\n      margin-top: 0.5rem;\n      color: #b91c1c;\n    }\n    .rule-card {\n      transition: box-shadow 0.15s, border-color 0.15s;\n      cursor: pointer;\n    }\n    .rule-card:hover { box-shadow: 0 4px 16px rgba(59,130,246,0.15); }\n    .rule-card.selected { border-color: #2563eb; background: #eff6ff; }\n    sup { font-size: 0.72em; vertical-align: super; line-height: 0; }\n    .math { font-style: italic; }\n    input[type=number]::-webkit-inner-spin-button,\n    input[type=number]::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }\n    input[type=number] { -moz-appearance: textfield; }\n    .nav-btn {\n      padding: 0.5rem 1.2rem;\n      border-radius: 9999px;\n      font-weight: 600;\n      font-size: 0.97rem;\n      transition: background 0.15s, color 0.15s;\n      border: 2px solid transparent;\n    }\n    .nav-btn.active {\n      background: #2563eb;\n      color: white;\n    }\n    .nav-btn:not(.active) {\n      background: white;\n      color: #374151;\n      border-color: #d1d5db;\n    }\n    .nav-btn:not(.active):hover {\n      background: #f3f4f6;\n    }\n  </style>\n</head>\n<body class=\"bg-gray-50 min-h-screen\">\n\n  <!-- Header -->\n  <header class=\"bg-blue-700 text-white shadow-md\">\n    <div class=\"max-w-4xl mx-auto px-4 py-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2\">\n      <div>\n        <h1 class=\"text-2xl font-bold tracking-tight\">Potenser og standardform</h1>\n        <p class=\"text-blue-200 text-sm mt-0.5\">Matematikk 2P &middot; Sinus 2P kap. 1 &middot; LK20</p>\n      </div>\n      <span class=\"text-xs bg-blue-800 rounded-full px-3 py-1 self-start sm:self-auto\">Interaktivt læremiddel</span>\n    </div>\n  </header>\n\n  <!-- Navigation tabs -->\n  <nav class=\"bg-white border-b border-gray-200 sticky top-0 z-10 shadow-sm\">\n    <div class=\"max-w-4xl mx-auto px-4 py-2 flex flex-wrap gap-2\">\n      <button class=\"nav-btn active\" onclick=\"showSection('regler')\">Potensregler</button>\n      <button class=\"nav-btn\" onclick=\"showSection('kalkulator')\">Potenskalkulator</button>\n      <button class=\"nav-btn\" onclick=\"showSection('standardform')\">Standardform</button>\n    </div>\n  </nav>\n\n  <main class=\"max-w-4xl mx-auto px-4 py-6 space-y-6\">\n\n    <!-- ==================== SECTION: POTENSREGLER ==================== -->\n    <section id=\"sec-regler\">\n\n      <div class=\"bg-white rounded-xl shadow p-5 mb-4\">\n        <h2 class=\"text-xl font-bold text-gray-800 mb-1\">Potensreglene</h2>\n        <p class=\"text-gray-600 text-sm mb-4\">Velg en regel, fyll inn tall og se utregningen steg for steg.</p>\n\n        <!-- Rule cards -->\n        <div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 mb-5\" id=\"rule-cards\">\n\n          <div class=\"rule-card border-2 border-gray-200 rounded-xl p-4 selected\" data-rule=\"mult\" onclick=\"selectRule('mult')\">\n            <div class=\"text-blue-700 font-bold text-lg mb-1\">Regel 1</div>\n            <div class=\"text-gray-700 font-mono text-base\">a<sup>m</sup> · a<sup>n</sup> = a<sup>m+n</sup></div>\n            <div class=\"text-gray-500 text-xs mt-1\">Produkt med samme grunntall</div>\n          </div>\n\n          <div class=\"rule-card border-2 border-gray-200 rounded-xl p-4\" data-rule=\"div\" onclick=\"selectRule('div')\">\n            <div class=\"text-blue-700 font-bold text-lg mb-1\">Regel 2</div>\n            <div class=\"text-gray-700 font-mono text-base\">a<sup>m</sup> / a<sup>n</sup> = a<sup>m−n</sup></div>\n            <div class=\"text-gray-500 text-xs mt-1\">Kvotient med samme grunntall</div>\n          </div>\n\n          <div class=\"rule-card border-2 border-gray-200 rounded-xl p-4\" data-rule=\"pow\" onclick=\"selectRule('pow')\">\n            <div class=\"text-blue-700 font-bold text-lg mb-1\">Regel 3</div>\n            <div class=\"text-gray-700 font-mono text-base\">(a<sup>m</sup>)<sup>n</sup> = a<sup>m·n</sup></div>\n            <div class=\"text-gray-500 text-xs mt-1\">Potens av en potens</div>\n          </div>\n\n          <div class=\"rule-card border-2 border-gray-200 rounded-xl p-4\" data-rule=\"zero\" onclick=\"selectRule('zero')\">\n            <div class=\"text-blue-700 font-bold text-lg mb-1\">Regel 4</div>\n            <div class=\"text-gray-700 font-mono text-base\">a<sup>0</sup> = 1</div>\n            <div class=\"text-gray-500 text-xs mt-1\">Nulleksponent (a ≠ 0)</div>\n          </div>\n\n          <div class=\"rule-card border-2 border-gray-200 rounded-xl p-4\" data-rule=\"neg\" onclick=\"selectRule('neg')\">\n            <div class=\"text-blue-700 font-bold text-lg mb-1\">Regel 5</div>\n            <div class=\"text-gray-700 font-mono text-base\">a<sup>−n</sup> = 1/a<sup>n</sup></div>\n            <div class=\"text-gray-500 text-xs mt-1\">Negativ eksponent</div>\n          </div>\n\n        </div>\n\n        <!-- Dynamic input area -->\n        <div id=\"rule-input-area\" class=\"bg-gray-50 rounded-xl p-4 border border-gray-200\"></div>\n\n        <!-- Output area -->\n        <div id=\"rule-output\" class=\"mt-3\"></div>\n      </div>\n\n      <!-- Teori-boks -->\n      <div class=\"bg-white rounded-xl shadow p-5\">\n        <h3 class=\"text-lg font-bold text-gray-800 mb-3\">Hva er en potens?</h3>\n        <p class=\"text-gray-700 mb-3\">\n          En <strong>potens</strong> er en kortform for gjentatt multiplikasjon. Vi skriver\n          <span class=\"font-mono bg-gray-100 px-1 rounded\">a<sup>n</sup></span>,\n          der <em>a</em> kalles <strong>grunntallet</strong> og <em>n</em> kalles <strong>eksponenten</strong>.\n        </p>\n        <div class=\"bg-blue-50 rounded-lg p-3 font-mono text-blue-900 text-sm mb-3\">\n          2<sup>5</sup> = 2 · 2 · 2 · 2 · 2 = 32\n        </div>\n        <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm text-gray-700\">\n          <div class=\"bg-gray-50 rounded-lg p-3\">\n            <strong>Produkt-regelen</strong><br>\n            3<sup>2</sup> · 3<sup>4</sup> = 3<sup>2+4</sup> = 3<sup>6</sup> = 729<br>\n            <span class=\"text-gray-400 text-xs\">Legg sammen eksponentene</span>\n          </div>\n          <div class=\"bg-gray-50 rounded-lg p-3\">\n            <strong>Kvotient-regelen</strong><br>\n            5<sup>6</sup> / 5<sup>2</sup> = 5<sup>6−2</sup> = 5<sup>4</sup> = 625<br>\n            <span class=\"text-gray-400 text-xs\">Trekk fra eksponentene</span>\n          </div>\n          <div class=\"bg-gray-50 rounded-lg p-3\">\n            <strong>Potens-av-potens</strong><br>\n            (2<sup>3</sup>)<sup>4</sup> = 2<sup>3·4</sup> = 2<sup>12</sup> = 4096<br>\n            <span class=\"text-gray-400 text-xs\">Multipliser eksponentene</span>\n          </div>\n          <div class=\"bg-gray-50 rounded-lg p-3\">\n            <strong>Negativ eksponent</strong><br>\n            4<sup>−2</sup> = 1/4<sup>2</sup> = 1/16 = 0,0625<br>\n            <span class=\"text-gray-400 text-xs\">Flytt til nevneren</span>\n          </div>\n        </div>\n      </div>\n\n    </section>\n\n    <!-- ==================== SECTION: KALKULATOR ==================== -->\n    <section id=\"sec-kalkulator\" class=\"hidden\">\n\n      <div class=\"bg-white rounded-xl shadow p-5\">\n        <h2 class=\"text-xl font-bold text-gray-800 mb-1\">Potenskalkulator</h2>\n        <p class=\"text-gray-600 text-sm mb-4\">Beregn a<sup>n</sup> for alle tall — også negative eksponenter og null.</p>\n\n        <div class=\"grid grid-cols-2 gap-4 max-w-sm mb-4\">\n          <div>\n            <label class=\"block text-sm font-medium text-gray-700 mb-1\">Grunntall <em>a</em></label>\n            <input id=\"calc-base\" type=\"number\" value=\"3\"\n              class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-center text-lg focus:ring-2 focus:ring-blue-500 focus:outline-none\" />\n          </div>\n          <div>\n            <label class=\"block text-sm font-medium text-gray-700 mb-1\">Eksponent <em>n</em></label>\n            <input id=\"calc-exp\" type=\"number\" value=\"4\"\n              class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-center text-lg focus:ring-2 focus:ring-blue-500 focus:outline-none\" />\n          </div>\n        </div>\n\n        <button onclick=\"calcPower()\"\n          class=\"bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-2 rounded-lg transition mb-3\">\n          Beregn\n        </button>\n\n        <div id=\"calc-output\"></div>\n\n        <!-- Quick examples -->\n        <div class=\"mt-5\">\n          <h3 class=\"text-sm font-semibold text-gray-600 mb-2\">Prøv disse eksemplene:</h3>\n          <div class=\"flex flex-wrap gap-2\">\n            <button onclick=\"setCalcExample(2,10)\" class=\"text-xs bg-gray-100 hover:bg-gray-200 rounded-full px-3 py-1\">2¹⁰</button>\n            <button onclick=\"setCalcExample(10,-3)\" class=\"text-xs bg-gray-100 hover:bg-gray-200 rounded-full px-3 py-1\">10⁻³</button>\n            <button onclick=\"setCalcExample(5,0)\" class=\"text-xs bg-gray-100 hover:bg-gray-200 rounded-full px-3 py-1\">5⁰</button>\n            <button onclick=\"setCalcExample(-3,3)\" class=\"text-xs bg-gray-100 hover:bg-gray-200 rounded-full px-3 py-1\">(−3)³</button>\n            <button onclick=\"setCalcExample(4,-2)\" class=\"text-xs bg-gray-100 hover:bg-gray-200 rounded-full px-3 py-1\">4⁻²</button>\n            <button onclick=\"setCalcExample(7,2)\" class=\"text-xs bg-gray-100 hover:bg-gray-200 rounded-full px-3 py-1\">7²</button>\n            <button onclick=\"setCalcExample(10,6)\" class=\"text-xs bg-gray-100 hover:bg-gray-200 rounded-full px-3 py-1\">10⁶</button>\n            <button onclick=\"setCalcExample(2,-8)\" class=\"text-xs bg-gray-100 hover:bg-gray-200 rounded-full px-3 py-1\">2⁻⁸</button>\n          </div>\n        </div>\n      </div>\n\n    </section>\n\n    <!-- ==================== SECTION: STANDARDFORM ==================== -->\n    <section id=\"sec-standardform\" class=\"hidden\">\n\n      <div class=\"bg-white rounded-xl shadow p-5 mb-4\">\n        <h2 class=\"text-xl font-bold text-gray-800 mb-1\">Standardform (vitenskapelig notasjon)</h2>\n        <p class=\"text-gray-600 text-sm mb-4\">\n          Et tall på standardform skrives som <strong>a · 10<sup>n</sup></strong>,\n          der <strong>1 ≤ a &lt; 10</strong> og n er et heltall.\n        </p>\n\n        <!-- Direction toggle -->\n        <div class=\"flex gap-3 mb-5\">\n          <button id=\"btn-to-std\" onclick=\"setStdDir('to')\"\n            class=\"nav-btn active\">\n            Tall → Standardform\n          </button>\n          <button id=\"btn-from-std\" onclick=\"setStdDir('from')\"\n            class=\"nav-btn\">\n            Standardform → Tall\n          </button>\n        </div>\n\n        <!-- To standardform -->\n        <div id=\"std-to-area\">\n          <label class=\"block text-sm font-medium text-gray-700 mb-1\">Skriv inn et tall</label>\n          <div class=\"flex gap-2 max-w-sm mb-3\">\n            <input id=\"std-input\" type=\"text\" placeholder=\"f.eks. 0,000045 eller 6700000\"\n              class=\"flex-1 border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:outline-none\" />\n            <button onclick=\"toStandardForm()\"\n              class=\"bg-blue-600 hover:bg-blue-700 text-white font-semibold px-4 py-2 rounded-lg transition\">\n              Konverter\n            </button>\n          </div>\n          <div class=\"flex flex-wrap gap-2 mb-2\">\n            <span class=\"text-xs text-gray-500\">Eksempler:</span>\n            <button onclick=\"setStdInput('6700000')\" class=\"text-xs bg-gray-100 hover:bg-gray-200 rounded-full px-2 py-0.5\">6 700 000</button>\n            <button onclick=\"setStdInput('0.000045')\" class=\"text-xs bg-gray-100 hover:bg-gray-200 rounded-full px-2 py-0.5\">0,000045</button>\n            <button onclick=\"setStdInput('300000000')\" class=\"text-xs bg-gray-100 hover:bg-gray-200 rounded-full px-2 py-0.5\">300 000 000</button>\n            <button onclick=\"setStdInput('0.00000000167')\" class=\"text-xs bg-gray-100 hover:bg-gray-200 rounded-full px-2 py-0.5\">0,00000000167</button>\n            <button onclick=\"setStdInput('42500')\" class=\"text-xs bg-gray-100 hover:bg-gray-200 rounded-full px-2 py-0.5\">42 500</button>\n            <button onclick=\"setStdInput('0.0073')\" class=\"text-xs bg-gray-100 hover:bg-gray-200 rounded-full px-2 py-0.5\">0,0073</button>\n          </div>\n          <div id=\"std-to-output\"></div>\n        </div>\n\n        <!-- From standardform -->\n        <div id=\"std-from-area\" class=\"hidden\">\n          <p class=\"text-sm text-gray-600 mb-3\">Skriv inn et tall på standardform: <strong>a · 10<sup>n</sup></strong></p>\n          <div class=\"flex flex-wrap items-center gap-2 max-w-md mb-3\">\n            <input id=\"from-a\" type=\"text\" placeholder=\"a (1 ≤ a < 10)\"\n              class=\"w-32 border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:outline-none\" />\n            <span class=\"text-gray-700 font-semibold\">· 10</span>\n            <input id=\"from-n\" type=\"number\" placeholder=\"n\"\n              class=\"w-20 border border-gray-300 rounded-lg px-3 py-2 text-center focus:ring-2 focus:ring-blue-500 focus:outline-none\" />\n            <button onclick=\"fromStandardForm()\"\n              class=\"bg-blue-600 hover:bg-blue-700 text-white font-semibold px-4 py-2 rounded-lg transition\">\n              Konverter\n            </button>\n          </div>\n          <div class=\"flex flex-wrap gap-2 mb-2\">\n            <span class=\"text-xs text-gray-500\">Eksempler:</span>\n            <button onclick=\"setFromStd('3.84', 8)\" class=\"text-xs bg-gray-100 hover:bg-gray-200 rounded-full px-2 py-0.5\">3,84 · 10⁸</button>\n            <button onclick=\"setFromStd('1.6', -19)\" class=\"text-xs bg-gray-100 hover:bg-gray-200 rounded-full px-2 py-0.5\">1,6 · 10⁻¹⁹</button>\n            <button onclick=\"setFromStd('9.109', -31)\" class=\"text-xs bg-gray-100 hover:bg-gray-200 rounded-full px-2 py-0.5\">9,109 · 10⁻³¹</button>\n            <button onclick=\"setFromStd('6.674', -11)\" class=\"text-xs bg-gray-100 hover:bg-gray-200 rounded-full px-2 py-0.5\">6,674 · 10⁻¹¹</button>\n            <button onclick=\"setFromStd('5.972', 24)\" class=\"text-xs bg-gray-100 hover:bg-gray-200 rounded-full px-2 py-0.5\">5,972 · 10²⁴</button>\n          </div>\n          <div id=\"std-from-output\"></div>\n        </div>\n      </div>\n\n      <!-- Teori-boks standardform -->\n      <div class=\"bg-white rounded-xl shadow p-5\">\n        <h3 class=\"text-lg font-bold text-gray-800 mb-3\">Hva er standardform?</h3>\n        <p class=\"text-gray-700 text-sm mb-3\">\n          Standardform (også kalt <em>vitenskapelig notasjon</em>) er en praktisk måte å skrive\n          svært store eller svært små tall på. Alle tall skrives som\n          <strong>a · 10<sup>n</sup></strong>, der a er et desimaltall med én siffer foran kommaet\n          (1 ≤ a &lt; 10), og n er et heltall (positivt, negativt eller null).\n        </p>\n        <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm\">\n          <div class=\"bg-blue-50 rounded-lg p-3\">\n            <div class=\"font-semibold text-blue-800 mb-1\">Store tall</div>\n            <div class=\"font-mono text-blue-900\">\n              93 000 000 = 9,3 · 10<sup>7</sup><br>\n              <span class=\"text-xs text-gray-500\">Komma flyttes 7 plasser til venstre</span>\n            </div>\n          </div>\n          <div class=\"bg-green-50 rounded-lg p-3\">\n            <div class=\"font-semibold text-green-800 mb-1\">Små tall</div>\n            <div class=\"font-mono text-green-900\">\n              0,000027 = 2,7 · 10<sup>−5</sup><br>\n              <span class=\"text-xs text-gray-500\">Komma flyttes 5 plasser til høyre</span>\n            </div>\n          </div>\n          <div class=\"bg-yellow-50 rounded-lg p-3 sm:col-span-2\">\n            <div class=\"font-semibold text-yellow-800 mb-1\">Huskeregel</div>\n            <div class=\"text-yellow-900\">\n              Antall plasser du flytter kommaet = eksponenten.\n              Hvis kommaet flyttes <em>til venstre</em>, blir eksponenten <strong>positiv</strong>.\n              Hvis kommaet flyttes <em>til høyre</em>, blir eksponenten <strong>negativ</strong>.\n            </div>\n          </div>\n        </div>\n      </div>\n\n    </section>\n\n  </main>\n\n  <footer class=\"text-center text-xs text-gray-400 py-6 mt-4\">\n    Matematikk 2P &middot; Halison App Studio &middot; Personlig og pedagogisk bruk\n  </footer>\n\n<script>\n// ============================================================\n// STATE\n// ============================================================\nvar currentRule = 'mult';\nvar stdDir = 'to';\n\n// ============================================================\n// NAVIGATION\n// ============================================================\nfunction showSection(name) {\n  var sections = ['regler', 'kalkulator', 'standardform'];\n  sections.forEach(function(s) {\n    var el = document.getElementById('sec-' + s);\n    if (el) el.classList.toggle('hidden', s !== name);\n  });\n  var btns = document.querySelectorAll('.nav-btn');\n  btns.forEach(function(btn) {\n    btn.classList.remove('active');\n    var txt = btn.textContent.trim().toLowerCase();\n    if (\n      (name === 'regler' && txt.includes('potensregel')) ||\n      (name === 'kalkulator' && txt.includes('kalkulator')) ||\n      (name === 'standardform' && txt.includes('standardform'))\n    ) {\n      btn.classList.add('active');\n    }\n  });\n}\n\n// ============================================================\n// RULE SELECTION\n// ============================================================\nfunction selectRule(rule) {\n  currentRule = rule;\n  document.querySelectorAll('.rule-card').forEach(function(card) {\n    card.classList.toggle('selected', card.dataset.rule === rule);\n  });\n  renderRuleInput(rule);\n  document.getElementById('rule-output').innerHTML = '';\n}\n\nfunction renderRuleInput(rule) {\n  var area = document.getElementById('rule-input-area');\n  var html = '';\n\n  if (rule === 'mult') {\n    html = '<p class=\"text-sm text-gray-600 mb-3\">Beregn <strong>a<sup>m</sup> · a<sup>n</sup></strong></p>' +\n      '<div class=\"flex flex-wrap items-center gap-3\">' +\n      numField('rm-a', 'Grunntall a', 3) +\n      numField('rm-m', 'Eksponent m', 2) +\n      numField('rm-n', 'Eksponent n', 4) +\n      calcBtn('calcRule()') + '</div>';\n  } else if (rule === 'div') {\n    html = '<p class=\"text-sm text-gray-600 mb-3\">Beregn <strong>a<sup>m</sup> / a<sup>n</sup></strong></p>' +\n      '<div class=\"flex flex-wrap items-center gap-3\">' +\n      numField('rd-a', 'Grunntall a', 5) +\n      numField('rd-m', 'Eksponent m', 6) +\n      numField('rd-n', 'Eksponent n', 2) +\n      calcBtn('calcRule()') + '</div>';\n  } else if (rule === 'pow') {\n    html = '<p class=\"text-sm text-gray-600 mb-3\">Beregn <strong>(a<sup>m</sup>)<sup>n</sup></strong></p>' +\n      '<div class=\"flex flex-wrap items-center gap-3\">' +\n      numField('rp-a', 'Grunntall a', 2) +\n      numField('rp-m', 'Eksponent m', 3) +\n      numField('rp-n', 'Eksponent n', 4) +\n      calcBtn('calcRule()') + '</div>';\n  } else if (rule === 'zero') {\n    html = '<p class=\"text-sm text-gray-600 mb-3\">Beregn <strong>a<sup>0</sup></strong> (a ≠ 0)</p>' +\n      '<div class=\"flex flex-wrap items-center gap-3\">' +\n      numField('rz-a', 'Grunntall a', 7) +\n      calcBtn('calcRule()') + '</div>';\n  } else if (rule === 'neg') {\n    html = '<p class=\"text-sm text-gray-600 mb-3\">Beregn <strong>a<sup>−n</sup></strong></p>' +\n      '<div class=\"flex flex-wrap items-center gap-3\">' +\n      numField('rn-a', 'Grunntall a', 4) +\n      numField('rn-n', 'Eksponent n (positivt tall)', 3) +\n      calcBtn('calcRule()') + '</div>';\n  }\n\n  area.innerHTML = html;\n}\n\nfunction numField(id, label, def) {\n  return '<div><label class=\"block text-xs font-medium text-gray-600 mb-1\">' + label + '</label>' +\n    '<input id=\"' + id + '\" type=\"number\" value=\"' + def + '\" ' +\n    'class=\"w-24 border border-gray-300 rounded-lg px-2 py-2 text-center focus:ring-2 focus:ring-blue-500 focus:outline-none\" /></div>';\n}\n\nfunction calcBtn(onclick) {\n  return '<div class=\"self-end\"><button onclick=\"' + onclick + '\" ' +\n    'class=\"bg-blue-600 hover:bg-blue-700 text-white font-semibold px-5 py-2 rounded-lg transition\">Beregn</button></div>';\n}\n\nfunction getVal(id) {\n  var el = document.getElementById(id);\n  return el ? parseFloat(el.value) : NaN;\n}\n\n// ============================================================\n// RULE CALCULATIONS\n// ============================================================\nfunction calcRule() {\n  var out = document.getElementById('rule-output');\n  var rule = currentRule;\n  var html = '';\n\n  if (rule === 'mult') {\n    var a = getVal('rm-a'), m = getVal('rm-m'), n = getVal('rm-n');\n    if (isNaN(a) || isNaN(m) || isNaN(n)) { out.innerHTML = errBox('Fyll inn gyldige tall.'); return; }\n    if (!Number.isInteger(m) || !Number.isInteger(n)) { out.innerHTML = errBox('Eksponentene m og n må være heltall.'); return; }\n    var exp = m + n;\n    var result = Math.pow(a, exp);\n    html = '<div class=\"step-box\"><strong>Regel 1:</strong> a<sup>m</sup> · a<sup>n</sup> = a<sup>m+n</sup></div>' +\n      '<div class=\"step-box\">Vi setter inn: <strong>a = ' + fmtNum(a) + ', m = ' + m + ', n = ' + n + '</strong></div>' +\n      '<div class=\"step-box\">' + fmtNum(a) + '<sup>' + m + '</sup> · ' + fmtNum(a) + '<sup>' + n + '</sup> = ' + fmtNum(a) + '<sup>' + m + '+' + n + '</sup> = ' + fmtNum(a) + '<sup>' + exp + '</sup></div>' +\n      verifyStep(a, m, n, 'mult', exp, result);\n  } else if (rule === 'div') {\n    var a = getVal('rd-a'), m = getVal('rd-m'), n = getVal('rd-n');\n    if (isNaN(a) || isNaN(m) || isNaN(n)) { out.innerHTML = errBox('Fyll inn gyldige tall.'); return; }\n    if (!Number.isInteger(m) || !Number.isInteger(n)) { out.innerHTML = errBox('Eksponentene m og n må være heltall.'); return; }\n    if (a === 0) { out.innerHTML = errBox('Grunntallet kan ikke være 0 (deling med null).'); return; }\n    var exp = m - n;\n    var result = Math.pow(a, exp);\n    html = '<div class=\"step-box\"><strong>Regel 2:</strong> a<sup>m</sup> / a<sup>n</sup> = a<sup>m−n</sup></div>' +\n      '<div class=\"step-box\">Vi setter inn: <strong>a = ' + fmtNum(a) + ', m = ' + m + ', n = ' + n + '</strong></div>' +\n      '<div class=\"step-box\">' + fmtNum(a) + '<sup>' + m + '</sup> / ' + fmtNum(a) + '<sup>' + n + '</sup> = ' + fmtNum(a) + '<sup>' + m + '−' + n + '</sup> = ' + fmtNum(a) + '<sup>' + exp + '</sup></div>' +\n      verifyStep(a, m, n, 'div', exp, result);\n  } else if (rule === 'pow') {\n    var a = getVal('rp-a'), m = getVal('rp-m'), n = getVal('rp-n');\n    if (isNaN(a) || isNaN(m) || isNaN(n)) { out.innerHTML = errBox('Fyll inn gyldige tall.'); return; }\n    if (!Number.isInteger(m) || !Number.isInteger(n)) { out.innerHTML = errBox('Eksponentene m og n må være heltall.'); return; }\n    var exp = m * n;\n    var result = Math.pow(a, exp);\n    html = '<div class=\"step-box\"><strong>Regel 3:</strong> (a<sup>m</sup>)<sup>n</sup> = a<sup>m·n</sup></div>' +\n      '<div class=\"step-box\">Vi setter inn: <strong>a = ' + fmtNum(a) + ', m = ' + m + ', n = ' + n + '</strong></div>' +\n      '<div class=\"step-box\">(' + fmtNum(a) + '<sup>' + m + '</sup>)<sup>' + n + '</sup> = ' + fmtNum(a) + '<sup>' + m + '·' + n + '</sup> = ' + fmtNum(a) + '<sup>' + exp + '</sup></div>' +\n      verifyStep(a, m, n, 'pow', exp, result);\n  } else if (rule === 'zero') {\n    var a = getVal('rz-a');\n    if (isNaN(a)) { out.innerHTML = errBox('Fyll inn et gyldig grunntall.'); return; }\n    if (a === 0) { out.innerHTML = errBox('0⁰ er udefinert — velg et annet grunntall.'); return; }\n    html = '<div class=\"step-box\"><strong>Regel 4:</strong> a<sup>0</sup> = 1, for alle a ≠ 0</div>' +\n      '<div class=\"step-box\">Vi setter inn: <strong>a = ' + fmtNum(a) + '</strong></div>' +\n      '<div class=\"step-box\">' + fmtNum(a) + '<sup>0</sup> = 1</div>' +\n      '<div class=\"step-box\" style=\"background:#f0fdf4;border-color:#22c55e\">Forklaring: a<sup>0</sup> = a<sup>n−n</sup> = a<sup>n</sup>/a<sup>n</sup> = 1 (for a ≠ 0)</div>' +\n      '<div class=\"result-box\">Svar: <strong>' + fmtNum(a) + '<sup>0</sup> = 1</strong></div>';\n  } else if (rule === 'neg') {\n    var a = getVal('rn-a'), n = getVal('rn-n');\n    if (isNaN(a) || isNaN(n)) { out.innerHTML = errBox('Fyll inn gyldige tall.'); return; }\n    if (!Number.isInteger(n) || n < 1) { out.innerHTML = errBox('Eksponenten n må være et positivt heltall.'); return; }\n    if (a === 0) { out.innerHTML = errBox('Grunntallet kan ikke være 0.'); return; }\n    var denom = Math.pow(a, n);\n    var result = 1 / denom;\n    var fracStr = fmtFrac(1, denom);\n    html = '<div class=\"step-box\"><strong>Regel 5:</strong> a<sup>−n</sup> = 1/a<sup>n</sup></div>' +\n      '<div class=\"step-box\">Vi setter inn: <strong>a = ' + fmtNum(a) + ', n = ' + n + '</strong></div>' +\n      '<div class=\"step-box\">' + fmtNum(a) + '<sup>−' + n + '</sup> = 1/' + fmtNum(a) + '<sup>' + n + '</sup> = 1/' + fmtNum(denom) + '</div>' +\n      '<div class=\"result-box\">Svar: <strong>' + fracStr + ' = ' + fmtDec(result) + '</strong></div>';\n  }\n\n  out.innerHTML = html;\n}\n\nfunction verifyStep(a, m, n, op, exp, result) {\n  var fracStr = '';\n  if (exp < 0 && a !== 0) {\n    var denom = Math.pow(a, -exp);\n    fracStr = ' = ' + fmtFrac(1, denom);\n  }\n  var decStr = fmtDec(result);\n  return '<div class=\"result-box\">Svar: <strong>' + fmtNum(a) + '<sup>' + exp + '</sup>' + fracStr + ' = ' + decStr + '</strong></div>';\n}\n\n// ============================================================\n// CALCULATOR\n// ============================================================\nfunction setCalcExample(base, exp) {\n  document.getElementById('calc-base').value = base;\n  document.getElementById('calc-exp').value = exp;\n  calcPower();\n}\n\nfunction calcPower() {\n  var a = parseFloat(document.getElementById('calc-base').value);\n  var n = parseFloat(document.getElementById('calc-exp').value);\n  var out = document.getElementById('calc-output');\n\n  if (isNaN(a) || isNaN(n)) { out.innerHTML = errBox('Fyll inn gyldige tall for grunntall og eksponent.'); return; }\n  if (!Number.isInteger(n)) { out.innerHTML = errBox('Eksponenten må være et heltall.'); return; }\n  if (a === 0 && n < 0) { out.innerHTML = errBox('0 med negativ eksponent er udefinert (deling med null).'); return; }\n  if (a === 0 && n === 0) { out.innerHTML = errBox('0⁰ er matematisk udefinert.'); return; }\n\n  var html = '';\n  var result = Math.pow(a, n);\n\n  if (n === 0) {\n    html = '<div class=\"step-box\">Regel 4: a<sup>0</sup> = 1 for alle a ≠ 0</div>' +\n      '<div class=\"result-box\"><strong>' + fmtNum(a) + '<sup>0</sup> = 1</strong></div>';\n  } else if (n > 0) {\n    var expansion = '';\n    if (n <= 8) {\n      var parts = [];\n      for (var i = 0; i < n; i++) parts.push(fmtNum(a));\n      expansion = '<div class=\"step-box\">Utvidet form: ' + parts.join(' · ') + '</div>';\n    }\n    html = '<div class=\"step-box\">Positiv eksponent: ' + fmtNum(a) + '<sup>' + n + '</sup></div>' +\n      expansion +\n      '<div class=\"result-box\"><strong>' + fmtNum(a) + '<sup>' + n + '</sup> = ' + fmtDec(result) + '</strong></div>';\n  } else {\n    // negative exponent\n    var posN = -n;\n    var denom = Math.pow(a, posN);\n    var fracStr = fmtFrac(1, denom);\n    html = '<div class=\"step-box\">Regel 5: a<sup>−n</sup> = 1/a<sup>n</sup></div>' +\n      '<div class=\"step-box\">' + fmtNum(a) + '<sup>' + n + '</sup> = 1/' + fmtNum(a) + '<sup>' + posN + '</sup> = 1/' + fmtNum(denom) + '</div>' +\n      '<div class=\"result-box\"><strong>' + fracStr + ' = ' + fmtDec(result) + '</strong></div>';\n  }\n\n  out.innerHTML = html;\n}\n\n// ============================================================\n// STANDARDFORM\n// ============================================================\nfunction setStdDir(dir) {\n  stdDir = dir;\n  document.getElementById('std-to-area').classList.toggle('hidden', dir !== 'to');\n  document.getElementById('std-from-area').classList.toggle('hidden', dir !== 'from');\n  document.getElementById('btn-to-std').classList.toggle('active', dir === 'to');\n  document.getElementById('btn-from-std').classList.toggle('active', dir === 'from');\n  document.getElementById('std-to-output').innerHTML = '';\n  document.getElementById('std-from-output').innerHTML = '';\n}\n\nfunction setStdInput(val) {\n  document.getElementById('std-input').value = val.replace('.', ',');\n  toStandardForm();\n}\n\nfunction setFromStd(a, n) {\n  document.getElementById('from-a').value = a.replace('.', ',');\n  document.getElementById('from-n').value = n;\n  fromStandardForm();\n}\n\nfunction toStandardForm() {\n  var raw = document.getElementById('std-input').value.trim().replace(',', '.');\n  var out = document.getElementById('std-to-output');\n\n  var num = parseFloat(raw);\n  if (isNaN(num) || raw === '') { out.innerHTML = errBox('Skriv inn et gyldig tall (bruk komma eller punktum som desimaltegn).'); return; }\n  if (num === 0) { out.innerHTML = errBox('Null kan ikke skrives på standardform.'); return; }\n\n  var sign = num < 0 ? -1 : 1;\n  var abs = Math.abs(num);\n\n  // Find exponent: floor(log10(abs))\n  var exp = Math.floor(Math.log10(abs));\n  var a = abs / Math.pow(10, exp);\n\n  // Fix floating point drift\n  a = Math.round(a * 1e10) / 1e10;\n\n  // If a rounds to 10, adjust\n  if (a >= 10) { a = a / 10; exp += 1; }\n  if (a < 1 && a > 0) { a = a * 10; exp -= 1; }\n\n  var signedA = sign * a;\n  var aStr = fmtDec(signedA);\n\n  var direction = exp > 0 ? 'til venstre' : (exp < 0 ? 'til høyre' : 'ingen forflytning');\n  var movePlaces = Math.abs(exp);\n\n  var html = '<div class=\"step-box\"><strong>Steg 1:</strong> Finn riktig posisjon for desimaltegnet slik at 1 ≤ |a| &lt; 10</div>' +\n    '<div class=\"step-box\"><strong>Steg 2:</strong> Tell antall plasser kommaet flyttes = ' + movePlaces + ' plass' + (movePlaces === 1 ? '' : 'er') + ' ' + direction + '</div>' +\n    '<div class=\"step-box\"><strong>Steg 3:</strong> ' +\n      (exp === 0\n        ? 'Kommaet flyttes ikke. Eksponenten er 0.'\n        : (exp > 0\n            ? 'Kommaet flyttes til venstre → eksponent er positiv: n = ' + exp\n            : 'Kommaet flyttes til høyre → eksponent er negativ: n = ' + exp)) +\n    '</div>' +\n    '<div class=\"result-box\">Svar: <strong>' + fmtDec(num) + ' = ' + aStr + ' · 10<sup>' + exp + '</sup></strong></div>';\n\n  out.innerHTML = html;\n}\n\nfunction fromStandardForm() {\n  var aRaw = document.getElementById('from-a').value.trim().replace(',', '.');\n  var nRaw = document.getElementById('from-n').value.trim();\n  var out = document.getElementById('std-from-output');\n\n  var a = parseFloat(aRaw);\n  var n = parseInt(nRaw, 10);\n\n  if (isNaN(a) || aRaw === '') { out.innerHTML = errBox('Skriv inn en gyldig verdi for a.'); return; }\n  if (isNaN(n) || nRaw === '') { out.innerHTML = errBox('Skriv inn en gyldig heltallsverdi for n.'); return; }\n  if (Math.abs(a) < 1 || Math.abs(a) >= 10) {\n    out.innerHTML = errBox('Verdien a må oppfylle 1 ≤ |a| &lt; 10. Verdien du skrev er utenfor dette området.');\n    return;\n  }\n\n  var result = a * Math.pow(10, n);\n\n  var moveTxt = '';\n  if (n > 0) {\n    moveTxt = 'Flytt kommaet ' + n + ' plass' + (n === 1 ? '' : 'er') + ' til høyre (eksponenten er positiv).';\n  } else if (n < 0) {\n    moveTxt = 'Flytt kommaet ' + Math.abs(n) + ' plass' + (Math.abs(n) === 1 ? '' : 'er') + ' til venstre (eksponenten er negativ).';\n  } else {\n    moveTxt = 'Eksponenten er 0 — kommaet flyttes ikke.';\n  }\n\n  var html = '<div class=\"step-box\"><strong>Steg 1:</strong> Start med a = ' + fmtDec(a) + '</div>' +\n    '<div class=\"step-box\"><strong>Steg 2:</strong> ' + moveTxt + '</div>' +\n    '<div class=\"step-box\">' + fmtDec(a) + ' · 10<sup>' + n + '</sup> = ' + fmtDec(a) + ' · ' + fmtDec(Math.pow(10, n)) + '</div>' +\n    '<div class=\"result-box\">Svar: <strong>' + fmtDec(a) + ' · 10<sup>' + n + '</sup> = ' + fmtDec(result) + '</strong></div>';\n\n  out.innerHTML = html;\n}\n\n// ============================================================\n// HELPERS\n// ============================================================\nfunction fmtNum(x) {\n  if (Number.isInteger(x)) return String(x);\n  return String(x).replace('.', ',');\n}\n\nfunction fmtDec(x) {\n  if (!isFinite(x)) return String(x);\n  // Use Norwegian decimal comma\n  // For very small or very large, show full decimal representation\n  if (Math.abs(x) !== 0 && (Math.abs(x) < 1e-7 || Math.abs(x) > 1e15)) {\n    return x.toExponential().replace('.', ',').replace('e', ' · 10^');\n  }\n  // Remove unnecessary trailing zeros\n  var s = parseFloat(x.toPrecision(12)).toString();\n  return s.replace('.', ',');\n}\n\nfunction fmtFrac(num, denom) {\n  // Simplify fraction\n  var g = gcd(Math.abs(num), Math.abs(denom));\n  var n = num / g;\n  var d = denom / g;\n  if (d === 1) return String(n);\n  if (d < 0) { n = -n; d = -d; }\n  // Check if fraction is a \"nice\" integer denom\n  if (Number.isInteger(n) && Number.isInteger(d)) {\n    return n + '/' + d;\n  }\n  return fmtDec(num / denom);\n}\n\nfunction gcd(a, b) {\n  a = Math.abs(Math.round(a));\n  b = Math.abs(Math.round(b));\n  while (b) { var t = b; b = a % b; a = t; }\n  return a || 1;\n}\n\nfunction errBox(msg) {\n  return '<div class=\"error-box\">' + msg + '</div>';\n}\n\n// ============================================================\n// INIT\n// ============================================================\nrenderRuleInput('mult');\ncalcPower();\n</script>\n\n</body>\n</html>\n",
  "packaging": {
    "appName": "Potenser og standardform",
    "windowTitle": "Potenser og standardform",
    "bundleId": "com.halisonworks.potenserstandardform",
    "iconPath": null
  },
  "categoryId": null,
  "source": "import",
  "createdAt": "2026-06-02T12:00:00.000Z",
  "updatedAt": "2026-06-02T12:00:00.000Z",
  "sharedAt": "2026-06-02T12:00:00.000Z"
}
