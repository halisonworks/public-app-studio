{
  "schema": "app-studio/canvas@1",
  "id": "example-no2p-funksjoner-og-vekst",
  "name": "funksjoner-og-vekst.html",
  "code": "<!DOCTYPE html>\n<!--\n  Funksjoner og vekst — Halison App Studio-eksempel\n\n  Interaktivt læremiddel for matematikk 2P (LK20): tegn lineære, andregrads-,\n  potens- og eksponentialfunksjoner, og utforsk gjennomsnittlig og momentan\n  vekstfart med sekant og tangent.\n\n  Fra Halison App Studio sitt offentlige bibliotek:\n  https://github.com/halisonworks/public-app-studio\n\n  Tillatt bruk: personlig, pedagogisk og annen ikke-kommersiell bruk. Behold denne\n  headeren og kildelenken; ikke-kommersiell bruk. Utgitt under Halison App Studio\n  Examples License — se LICENSE-filen i repoet over.\n-->\n<html lang=\"no\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Funksjoner og vekst — Matematikk 2P</title>\n<script src=\"https://cdn.tailwindcss.com\"></script>\n<style>\n  /* Custom styles supplementing Tailwind */\n  body { font-family: 'Segoe UI', system-ui, sans-serif; }\n  input[type=range] { accent-color: #3b82f6; }\n  input[type=number] { -moz-appearance: textfield; }\n  input[type=number]::-webkit-inner-spin-button,\n  input[type=number]::-webkit-outer-spin-button { -webkit-appearance: none; }\n  .param-label { min-width: 2.5rem; display: inline-block; }\n  svg text { user-select: none; }\n  .tab-btn { transition: all 0.15s ease; }\n  .tab-btn.active { background-color: #3b82f6; color: white; }\n  .tab-btn:not(.active):hover { background-color: #dbeafe; }\n  .info-box { border-left: 4px solid #3b82f6; }\n  .secant-line { stroke: #f59e0b; stroke-width: 2; stroke-dasharray: 6 3; }\n  .tangent-line { stroke: #ef4444; stroke-width: 2; stroke-dasharray: 4 2; }\n  .point-dot { fill: white; stroke-width: 2; }\n  .grid-line { stroke: #e5e7eb; stroke-width: 0.5; }\n  .axis-line { stroke: #374151; stroke-width: 1.5; }\n  .tick-line { stroke: #374151; stroke-width: 1; }\n  .function-curve { fill: none; stroke: #3b82f6; stroke-width: 2.5; stroke-linejoin: round; stroke-linecap: round; }\n</style>\n</head>\n<body class=\"bg-gray-50 min-h-screen\">\n\n<!-- Header -->\n<header class=\"bg-blue-700 text-white shadow-md\">\n  <div class=\"max-w-7xl mx-auto px-4 py-3 flex items-center gap-3\">\n    <div class=\"text-2xl font-bold tracking-tight\">f(x)</div>\n    <div>\n      <h1 class=\"text-lg font-semibold leading-tight\">Funksjoner og vekst</h1>\n      <p class=\"text-blue-200 text-xs\">Matematikk 2P · Kapittel 5 · LK20</p>\n    </div>\n  </div>\n</header>\n\n<main class=\"max-w-7xl mx-auto px-4 py-5 space-y-5\">\n\n  <!-- Function type selector -->\n  <section class=\"bg-white rounded-xl shadow-sm border border-gray-200 p-4\">\n    <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3\">Velg funksjonstype</h2>\n    <div class=\"flex flex-wrap gap-2\" id=\"typeBtns\">\n      <button class=\"tab-btn active px-4 py-2 rounded-lg border border-blue-300 text-sm font-medium\" data-type=\"linear\">Lineær</button>\n      <button class=\"tab-btn px-4 py-2 rounded-lg border border-gray-300 text-sm font-medium\" data-type=\"quadratic\">Andregrad</button>\n      <button class=\"tab-btn px-4 py-2 rounded-lg border border-gray-300 text-sm font-medium\" data-type=\"power\">Potensfunksjon</button>\n      <button class=\"tab-btn px-4 py-2 rounded-lg border border-gray-300 text-sm font-medium\" data-type=\"exponential\">Eksponential</button>\n    </div>\n  </section>\n\n  <!-- Main layout: graph + controls -->\n  <div class=\"grid grid-cols-1 lg:grid-cols-3 gap-5\">\n\n    <!-- Graph area (hero) -->\n    <div class=\"lg:col-span-2 bg-white rounded-xl shadow-sm border border-gray-200 p-4\">\n      <div class=\"flex items-center justify-between mb-2\">\n        <h2 class=\"text-base font-semibold text-gray-800\">Graf</h2>\n        <div id=\"funcExpr\" class=\"font-mono text-blue-700 text-sm bg-blue-50 px-3 py-1 rounded-full border border-blue-200\"></div>\n      </div>\n      <!-- SVG Graph -->\n      <div class=\"w-full\" style=\"aspect-ratio: 4/3;\">\n        <svg id=\"graph\" width=\"100%\" height=\"100%\" viewBox=\"0 0 600 450\" xmlns=\"http://www.w3.org/2000/svg\">\n          <defs>\n            <clipPath id=\"plotArea\">\n              <rect x=\"55\" y=\"15\" width=\"530\" height=\"400\"/>\n            </clipPath>\n            <marker id=\"arrowX\" markerWidth=\"8\" markerHeight=\"8\" refX=\"6\" refY=\"3\" orient=\"auto\">\n              <path d=\"M0,0 L0,6 L8,3 z\" fill=\"#374151\"/>\n            </marker>\n            <marker id=\"arrowY\" markerWidth=\"8\" markerHeight=\"8\" refX=\"3\" refY=\"6\" orient=\"auto\">\n              <path d=\"M0,0 L6,0 L3,8 z\" fill=\"#374151\"/>\n            </marker>\n          </defs>\n          <!-- Grid -->\n          <g id=\"gridLines\"></g>\n          <!-- Function curve (clipped) -->\n          <g clip-path=\"url(#plotArea)\">\n            <path id=\"funcPath\" class=\"function-curve\"/>\n            <path id=\"secantPath\" class=\"secant-line\" style=\"display:none\"/>\n            <path id=\"tangentPath\" class=\"tangent-line\" style=\"display:none\"/>\n            <g id=\"secantPoints\" style=\"display:none\">\n              <circle id=\"secPt1\" r=\"5\" class=\"point-dot\" stroke=\"#f59e0b\"/>\n              <circle id=\"secPt2\" r=\"5\" class=\"point-dot\" stroke=\"#f59e0b\"/>\n            </g>\n            <g id=\"tangentPoint\" style=\"display:none\">\n              <circle id=\"tanPt\" r=\"5\" class=\"point-dot\" stroke=\"#ef4444\"/>\n            </g>\n          </g>\n          <!-- Axes (on top of clip) -->\n          <g id=\"axisLines\"></g>\n          <!-- Tick labels -->\n          <g id=\"tickLabels\" font-size=\"10\" fill=\"#4b5563\" font-family=\"monospace\"></g>\n          <!-- Axis labels -->\n          <text x=\"590\" y=\"228\" font-size=\"12\" fill=\"#374151\" font-family=\"serif\" font-style=\"italic\">x</text>\n          <text x=\"65\" y=\"10\" font-size=\"12\" fill=\"#374151\" font-family=\"serif\" font-style=\"italic\">y</text>\n        </svg>\n      </div>\n      <!-- Legend -->\n      <div class=\"mt-2 flex flex-wrap gap-4 text-xs text-gray-600\">\n        <span class=\"flex items-center gap-1\"><span class=\"inline-block w-6 h-0.5 bg-blue-500 rounded\"></span> f(x)</span>\n        <span class=\"flex items-center gap-1\" id=\"legendSecant\" style=\"display:none\"><span class=\"inline-block w-6 border-t-2 border-dashed border-yellow-500\"></span> Sekant (gj.snittlig vekstfart)</span>\n        <span class=\"flex items-center gap-1\" id=\"legendTangent\" style=\"display:none\"><span class=\"inline-block w-6 border-t-2 border-dashed border-red-500\"></span> Tangent (momentan vekstfart)</span>\n      </div>\n    </div>\n\n    <!-- Right panel: parameters + info -->\n    <div class=\"space-y-4\">\n\n      <!-- Parameters -->\n      <div class=\"bg-white rounded-xl shadow-sm border border-gray-200 p-4\">\n        <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3\">Parametere</h2>\n        <div id=\"paramControls\" class=\"space-y-3\"></div>\n        <!-- View range -->\n        <div class=\"mt-4 pt-3 border-t border-gray-100\">\n          <p class=\"text-xs font-medium text-gray-500 mb-2\">Visningsvindu</p>\n          <div class=\"grid grid-cols-2 gap-2 text-xs\">\n            <label class=\"flex flex-col gap-1\">\n              <span class=\"text-gray-500\">x min</span>\n              <input type=\"number\" id=\"xMin\" value=\"-10\" class=\"border border-gray-300 rounded px-2 py-1 w-full text-sm focus:outline-none focus:ring-1 focus:ring-blue-400\">\n            </label>\n            <label class=\"flex flex-col gap-1\">\n              <span class=\"text-gray-500\">x maks</span>\n              <input type=\"number\" id=\"xMax\" value=\"10\" class=\"border border-gray-300 rounded px-2 py-1 w-full text-sm focus:outline-none focus:ring-1 focus:ring-blue-400\">\n            </label>\n            <label class=\"flex flex-col gap-1\">\n              <span class=\"text-gray-500\">y min</span>\n              <input type=\"number\" id=\"yMin\" value=\"-10\" class=\"border border-gray-300 rounded px-2 py-1 w-full text-sm focus:outline-none focus:ring-1 focus:ring-blue-400\">\n            </label>\n            <label class=\"flex flex-col gap-1\">\n              <span class=\"text-gray-500\">y maks</span>\n              <input type=\"number\" id=\"yMax\" value=\"10\" class=\"border border-gray-300 rounded px-2 py-1 w-full text-sm focus:outline-none focus:ring-1 focus:ring-blue-400\">\n            </label>\n          </div>\n        </div>\n      </div>\n\n      <!-- Kjennetegn -->\n      <div class=\"bg-blue-50 rounded-xl border border-blue-200 p-4 info-box\">\n        <h2 class=\"text-sm font-semibold text-blue-800 mb-2\">Kjennetegn</h2>\n        <div id=\"kjennetegn\" class=\"text-sm text-blue-900 space-y-1\"></div>\n      </div>\n\n    </div>\n  </div>\n\n  <!-- Growth rate section -->\n  <div class=\"grid grid-cols-1 md:grid-cols-2 gap-5\">\n\n    <!-- Gjennomsnittlig vekstfart -->\n    <div class=\"bg-white rounded-xl shadow-sm border border-gray-200 p-4\">\n      <div class=\"flex items-center gap-2 mb-3\">\n        <div class=\"w-6 h-1 bg-yellow-400 rounded\" style=\"border-top: 3px dashed #f59e0b; height:0\"></div>\n        <h2 class=\"text-base font-semibold text-gray-800\">Gjennomsnittlig vekstfart</h2>\n      </div>\n      <p class=\"text-xs text-gray-500 mb-3\">\n        Den gjennomsnittlige vekstfarten mellom to punkter <span class=\"font-mono\">x₁</span> og <span class=\"font-mono\">x₂</span>\n        er helningen til sekanten (den rette linjen gjennom de to punktene):\n      </p>\n      <div class=\"bg-gray-50 rounded-lg p-2 text-center font-mono text-sm text-gray-700 mb-3\">\n        Δy/Δx = (f(x₂) − f(x₁)) / (x₂ − x₁)\n      </div>\n      <div class=\"flex gap-3 mb-3\">\n        <label class=\"flex flex-col gap-1 flex-1\">\n          <span class=\"text-xs text-gray-500\">x₁</span>\n          <input type=\"number\" id=\"secX1\" value=\"-3\" step=\"0.5\" class=\"border border-gray-300 rounded px-2 py-1.5 w-full text-sm focus:outline-none focus:ring-1 focus:ring-yellow-400\">\n        </label>\n        <label class=\"flex flex-col gap-1 flex-1\">\n          <span class=\"text-xs text-gray-500\">x₂</span>\n          <input type=\"number\" id=\"secX2\" value=\"3\" step=\"0.5\" class=\"border border-gray-300 rounded px-2 py-1.5 w-full text-sm focus:outline-none focus:ring-1 focus:ring-yellow-400\">\n        </label>\n        <div class=\"flex items-end\">\n          <button id=\"btnSecant\" class=\"bg-yellow-400 hover:bg-yellow-500 text-white font-semibold text-sm px-4 py-1.5 rounded-lg transition-colors\">Tegn</button>\n        </div>\n      </div>\n      <div id=\"secantResult\" class=\"hidden bg-yellow-50 border border-yellow-200 rounded-lg p-3 text-sm space-y-1\"></div>\n    </div>\n\n    <!-- Momentan vekstfart -->\n    <div class=\"bg-white rounded-xl shadow-sm border border-gray-200 p-4\">\n      <div class=\"flex items-center gap-2 mb-3\">\n        <div style=\"width:24px; border-top: 3px dashed #ef4444; height:0\"></div>\n        <h2 class=\"text-base font-semibold text-gray-800\">Momentan vekstfart</h2>\n      </div>\n      <p class=\"text-xs text-gray-500 mb-3\">\n        Den momentane vekstfarten i ett punkt er grenseverdien til den gjennomsnittlige vekstfarten\n        når <span class=\"font-mono\">Δx → 0</span>. Her estimeres den numerisk med en liten <span class=\"font-mono\">Δx = 0,0001</span>:\n      </p>\n      <div class=\"bg-gray-50 rounded-lg p-2 text-center font-mono text-sm text-gray-700 mb-3\">\n        f′(x) ≈ (f(x + Δx) − f(x)) / Δx\n      </div>\n      <div class=\"flex gap-3 mb-3\">\n        <label class=\"flex flex-col gap-1 flex-1\">\n          <span class=\"text-xs text-gray-500\">x</span>\n          <input type=\"number\" id=\"tanX\" value=\"1\" step=\"0.5\" class=\"border border-gray-300 rounded px-2 py-1.5 w-full text-sm focus:outline-none focus:ring-1 focus:ring-red-400\">\n        </label>\n        <div class=\"flex items-end\">\n          <button id=\"btnTangent\" class=\"bg-red-400 hover:bg-red-500 text-white font-semibold text-sm px-4 py-1.5 rounded-lg transition-colors\">Tegn</button>\n        </div>\n      </div>\n      <div id=\"tangentResult\" class=\"hidden bg-red-50 border border-red-200 rounded-lg p-3 text-sm space-y-1\"></div>\n    </div>\n  </div>\n\n  <!-- Comparison explanation -->\n  <div class=\"bg-white rounded-xl shadow-sm border border-gray-200 p-4\">\n    <h2 class=\"text-base font-semibold text-gray-800 mb-2\">Forskjellen mellom gjennomsnittlig og momentan vekstfart</h2>\n    <div class=\"grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-gray-700\">\n      <div class=\"bg-yellow-50 border border-yellow-200 rounded-lg p-3\">\n        <p class=\"font-semibold text-yellow-800 mb-1\">Gjennomsnittlig vekstfart</p>\n        <p>Beskriver hvor mye funksjonen endrer seg <em>i gjennomsnitt</em> per enhet over et intervall [x₁, x₂].\n           Dette tilsvarer helningen til sekantlinjen — den rette linjen som går gjennom to punkter på grafen.\n           Brukes f.eks. til å finne gjennomsnittlig fart over en strekning.</p>\n      </div>\n      <div class=\"bg-red-50 border border-red-200 rounded-lg p-3\">\n        <p class=\"font-semibold text-red-800 mb-1\">Momentan vekstfart</p>\n        <p>Beskriver den <em>øyeblikkelige</em> endringsraten i ett bestemt punkt. Det er helningen til\n           tangentlinjen i punktet — den rette linjen som berører grafen i akkurat det punktet.\n           Dette er det deriverte, f′(x), og brukes f.eks. til å finne fart i ett bestemt øyeblikk.</p>\n      </div>\n    </div>\n  </div>\n\n</main>\n\n<footer class=\"mt-8 border-t border-gray-200 bg-white py-3 text-center text-xs text-gray-400\">\n  Matematikk 2P · LK20 · Halison App Studio · Kun til personlig og pedagogisk bruk\n</footer>\n\n<script>\n(function() {\n  'use strict';\n\n  // ─── State ───────────────────────────────────────────────────────────────\n  let currentType = 'linear';\n  let params = { a: 1, b: 0, c: 0 };\n  let showSecant = false;\n  let showTangent = false;\n  let secantData = null;\n  let tangentData = null;\n\n  // ─── SVG dimensions ──────────────────────────────────────────────────────\n  const SVG_W = 600;\n  const SVG_H = 450;\n  const PLOT_LEFT = 55;\n  const PLOT_TOP = 15;\n  const PLOT_W = 530;\n  const PLOT_H = 400;\n\n  // ─── Function definitions ─────────────────────────────────────────────────\n  const funcDefs = {\n    linear: {\n      params: [\n        { key: 'a', label: 'a', min: -5, max: 5, step: 0.1, default: 1 },\n        { key: 'b', label: 'b', min: -10, max: 10, step: 0.5, default: 0 }\n      ],\n      f: (x, p) => p.a * x + p.b,\n      expr: (p) => {\n        const aStr = fmt(p.a);\n        const bAbs = Math.abs(p.b);\n        const bSign = p.b >= 0 ? '+' : '−';\n        if (p.a === 0) return `f(x) = ${fmt(p.b)}`;\n        if (p.b === 0) return `f(x) = ${aStr}x`;\n        return `f(x) = ${aStr}x ${bSign} ${fmt(bAbs)}`;\n      },\n      kjennetegn: (p) => {\n        const lines = [];\n        lines.push(`Type: Lineær funksjon — rett linje`);\n        lines.push(`Stigningstall: a = ${fmt(p.a)}`);\n        if (p.a > 0) lines.push('Stigende (a > 0): jo større x, jo større f(x)');\n        else if (p.a < 0) lines.push('Synkende (a < 0): jo større x, jo mindre f(x)');\n        else lines.push('Konstant funksjon (a = 0): horisontal linje');\n        lines.push(`Konstantledd / skjæring med y-aksen: b = ${fmt(p.b)}`);\n        if (p.a !== 0) {\n          const xInt = -p.b / p.a;\n          lines.push(`Nullpunkt (skjæring med x-aksen): x = ${fmt(xInt)}`);\n        }\n        lines.push('Konstant vekstfart: Δy/Δx = a for alle intervaller');\n        return lines;\n      }\n    },\n    quadratic: {\n      params: [\n        { key: 'a', label: 'a', min: -3, max: 3, step: 0.1, default: 1 },\n        { key: 'b', label: 'b', min: -6, max: 6, step: 0.5, default: 0 },\n        { key: 'c', label: 'c', min: -10, max: 10, step: 0.5, default: 0 }\n      ],\n      f: (x, p) => p.a * x * x + p.b * x + p.c,\n      expr: (p) => {\n        let s = 'f(x) = ';\n        if (p.a !== 0) s += `${fmt(p.a)}x²`;\n        if (p.b !== 0) s += ` ${p.b >= 0 ? '+' : '−'} ${fmt(Math.abs(p.b))}x`;\n        if (p.c !== 0) s += ` ${p.c >= 0 ? '+' : '−'} ${fmt(Math.abs(p.c))}`;\n        if (p.a === 0 && p.b === 0) s = `f(x) = ${fmt(p.c)}`;\n        return s.replace('= +', '= ').replace('= −', '= −');\n      },\n      kjennetegn: (p) => {\n        const lines = [];\n        lines.push('Type: Andregradsfunksjon — parabel');\n        if (p.a > 0) lines.push('Åpner oppover (a > 0): har et bunnpunkt (minimum)');\n        else if (p.a < 0) lines.push('Åpner nedover (a < 0): har et toppunkt (maksimum)');\n        else lines.push('a = 0: lineær funksjon');\n        if (p.a !== 0) {\n          const xV = -p.b / (2 * p.a);\n          const yV = p.a * xV * xV + p.b * xV + p.c;\n          lines.push(`${p.a > 0 ? 'Bunnpunkt' : 'Toppunkt'}: (${fmt(xV)}, ${fmt(yV)})`);\n          lines.push(`Symmetriakse: x = ${fmt(xV)}`);\n          const disc = p.b * p.b - 4 * p.a * p.c;\n          if (disc > 0) {\n            const x1 = (-p.b + Math.sqrt(disc)) / (2 * p.a);\n            const x2 = (-p.b - Math.sqrt(disc)) / (2 * p.a);\n            lines.push(`Nullpunkter: x = ${fmt(Math.min(x1,x2))} og x = ${fmt(Math.max(x1,x2))}`);\n          } else if (disc === 0) {\n            lines.push(`Nullpunkt: x = ${fmt(-p.b / (2 * p.a))} (dobbelt)`)\n          } else {\n            lines.push('Ingen reelle nullpunkter (diskriminant < 0)');\n          }\n        }\n        lines.push('Vekstfarten er ikke konstant — endres jevnt');\n        return lines;\n      }\n    },\n    power: {\n      params: [\n        { key: 'a', label: 'a', min: -3, max: 3, step: 0.1, default: 1 },\n        { key: 'b', label: 'b (eksponent)', min: -3, max: 4, step: 0.25, default: 2 }\n      ],\n      f: (x, p) => {\n        if (x === 0 && p.b < 0) return NaN;\n        if (x < 0 && !Number.isInteger(p.b)) return NaN;\n        return p.a * Math.pow(x, p.b);\n      },\n      expr: (p) => `f(x) = ${fmt(p.a)} · x^${fmt(p.b)}`,\n      kjennetegn: (p) => {\n        const lines = [];\n        lines.push('Type: Potensfunksjon — f(x) = a · xᵇ');\n        lines.push(`Koeffisient: a = ${fmt(p.a)}`);\n        lines.push(`Eksponent: b = ${fmt(p.b)}`);\n        if (p.b > 0) lines.push('b > 0: grafen går gjennom origo (0,0)');\n        if (p.b < 0) lines.push('b < 0: asympote ved x = 0 (ikke definert i 0)');\n        if (Number.isInteger(p.b) && p.b > 0 && p.b % 2 === 0) lines.push('Jevn eksponent: symmetrisk om y-aksen');\n        if (Number.isInteger(p.b) && p.b > 0 && p.b % 2 !== 0) lines.push('Odde eksponent: punktsymmetrisk om origo');\n        if (p.b === 1) lines.push('b = 1: lineær funksjon (rett linje)');\n        if (p.b === 2) lines.push('b = 2: parabel (andregradsfunksjon)');\n        return lines;\n      }\n    },\n    exponential: {\n      params: [\n        { key: 'b', label: 'b (startverdi)', min: 0.1, max: 10, step: 0.1, default: 1 },\n        { key: 'a', label: 'a (vekstfaktor)', min: 0.1, max: 3, step: 0.05, default: 2 }\n      ],\n      f: (x, p) => {\n        if (p.a <= 0) return NaN;\n        return p.b * Math.pow(p.a, x);\n      },\n      expr: (p) => `f(x) = ${fmt(p.b)} · ${fmt(p.a)}ˣ`,\n      kjennetegn: (p) => {\n        const lines = [];\n        lines.push('Type: Eksponentialfunksjon — f(x) = b · aˣ');\n        lines.push(`Startverdi (x=0): f(0) = ${fmt(p.b)}`);\n        lines.push(`Vekstfaktor: a = ${fmt(p.a)}`);\n        if (p.a > 1) {\n          const pct = fmt((p.a - 1) * 100);\n          lines.push(`a > 1: eksponentiell vekst (+${pct} % per enhet x)`);\n        } else if (p.a > 0 && p.a < 1) {\n          const pct = fmt((1 - p.a) * 100);\n          lines.push(`0 < a < 1: eksponentiell nedgang (−${pct} % per enhet x)`);\n        }\n        lines.push('Konstant vekstfaktor a for hvert steg Δx = 1');\n        lines.push('Aldri negativ for b > 0: grafen er alltid over x-aksen');\n        lines.push('Asympote: y = 0 (x → −∞ når a > 1)');\n        return lines;\n      }\n    }\n  };\n\n  // ─── Helpers ─────────────────────────────────────────────────────────────\n  function fmt(n) {\n    if (!isFinite(n)) return '∞';\n    const s = parseFloat(n.toFixed(4)).toString();\n    return s;\n  }\n\n  function getViewport() {\n    const xMin = parseFloat(document.getElementById('xMin').value) || -10;\n    const xMax = parseFloat(document.getElementById('xMax').value) || 10;\n    const yMin = parseFloat(document.getElementById('yMin').value) || -10;\n    const yMax = parseFloat(document.getElementById('yMax').value) || 10;\n    return { xMin, xMax, yMin, yMax };\n  }\n\n  function toSVG(x, y, vp) {\n    const sx = PLOT_LEFT + (x - vp.xMin) / (vp.xMax - vp.xMin) * PLOT_W;\n    const sy = PLOT_TOP + (vp.yMax - y) / (vp.yMax - vp.yMin) * PLOT_H;\n    return { sx, sy };\n  }\n\n  function fromSVG(sx, sy, vp) {\n    const x = vp.xMin + (sx - PLOT_LEFT) / PLOT_W * (vp.xMax - vp.xMin);\n    const y = vp.yMax - (sy - PLOT_TOP) / PLOT_H * (vp.yMax - vp.yMin);\n    return { x, y };\n  }\n\n  function evalF(x) {\n    const def = funcDefs[currentType];\n    return def.f(x, params);\n  }\n\n  // ─── Render grid + axes ──────────────────────────────────────────────────\n  function renderGrid() {\n    const vp = getViewport();\n    const gridEl = document.getElementById('gridLines');\n    const axisEl = document.getElementById('axisLines');\n    const tickEl = document.getElementById('tickLabels');\n    gridEl.innerHTML = '';\n    axisEl.innerHTML = '';\n    tickEl.innerHTML = '';\n\n    // Decide nice tick spacing\n    const xRange = vp.xMax - vp.xMin;\n    const yRange = vp.yMax - vp.yMin;\n    const xTick = niceStep(xRange / 8);\n    const yTick = niceStep(yRange / 8);\n\n    // Vertical grid lines + x ticks\n    let xi = Math.ceil(vp.xMin / xTick) * xTick;\n    while (xi <= vp.xMax + 1e-9) {\n      const { sx } = toSVG(xi, 0, vp);\n      const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');\n      line.setAttribute('x1', sx); line.setAttribute('y1', PLOT_TOP);\n      line.setAttribute('x2', sx); line.setAttribute('y2', PLOT_TOP + PLOT_H);\n      line.setAttribute('class', 'grid-line');\n      gridEl.appendChild(line);\n      // Tick label\n      if (Math.abs(xi) > 1e-10) {\n        const { sy: axisY } = toSVG(0, 0, vp);\n        const labelY = Math.min(Math.max(axisY + 14, PLOT_TOP + 12), PLOT_TOP + PLOT_H - 3);\n        const t = document.createElementNS('http://www.w3.org/2000/svg', 'text');\n        t.setAttribute('x', sx); t.setAttribute('y', labelY);\n        t.setAttribute('text-anchor', 'middle');\n        t.textContent = fmt(xi);\n        tickEl.appendChild(t);\n        // tick mark\n        const tk = document.createElementNS('http://www.w3.org/2000/svg', 'line');\n        tk.setAttribute('x1', sx); tk.setAttribute('y1', axisY - 3);\n        tk.setAttribute('x2', sx); tk.setAttribute('y2', axisY + 3);\n        tk.setAttribute('class', 'tick-line');\n        axisEl.appendChild(tk);\n      }\n      xi = parseFloat((xi + xTick).toFixed(10));\n    }\n\n    // Horizontal grid lines + y ticks\n    let yi = Math.ceil(vp.yMin / yTick) * yTick;\n    while (yi <= vp.yMax + 1e-9) {\n      const { sy } = toSVG(0, yi, vp);\n      const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');\n      line.setAttribute('x1', PLOT_LEFT); line.setAttribute('y1', sy);\n      line.setAttribute('x2', PLOT_LEFT + PLOT_W); line.setAttribute('y2', sy);\n      line.setAttribute('class', 'grid-line');\n      gridEl.appendChild(line);\n      if (Math.abs(yi) > 1e-10) {\n        const { sx: axisX } = toSVG(0, 0, vp);\n        const labelX = Math.min(Math.max(axisX - 6, PLOT_LEFT + 2), PLOT_LEFT + PLOT_W - 20);\n        const t = document.createElementNS('http://www.w3.org/2000/svg', 'text');\n        t.setAttribute('x', labelX); t.setAttribute('y', sy + 4);\n        t.setAttribute('text-anchor', 'end');\n        t.textContent = fmt(yi);\n        tickEl.appendChild(t);\n        const { sx: aX } = toSVG(0, 0, vp);\n        const tk = document.createElementNS('http://www.w3.org/2000/svg', 'line');\n        tk.setAttribute('x1', aX - 3); tk.setAttribute('y1', sy);\n        tk.setAttribute('x2', aX + 3); tk.setAttribute('y2', sy);\n        tk.setAttribute('class', 'tick-line');\n        axisEl.appendChild(tk);\n      }\n      yi = parseFloat((yi + yTick).toFixed(10));\n    }\n\n    // X axis\n    const { sy: axY } = toSVG(0, 0, vp);\n    const clampedAxY = Math.min(Math.max(axY, PLOT_TOP), PLOT_TOP + PLOT_H);\n    const xAxis = document.createElementNS('http://www.w3.org/2000/svg', 'line');\n    xAxis.setAttribute('x1', PLOT_LEFT); xAxis.setAttribute('y1', clampedAxY);\n    xAxis.setAttribute('x2', PLOT_LEFT + PLOT_W - 5); xAxis.setAttribute('y2', clampedAxY);\n    xAxis.setAttribute('class', 'axis-line');\n    xAxis.setAttribute('marker-end', 'url(#arrowX)');\n    axisEl.appendChild(xAxis);\n\n    // Y axis\n    const { sx: axX } = toSVG(0, 0, vp);\n    const clampedAxX = Math.min(Math.max(axX, PLOT_LEFT), PLOT_LEFT + PLOT_W);\n    const yAxis = document.createElementNS('http://www.w3.org/2000/svg', 'line');\n    yAxis.setAttribute('x1', clampedAxX); yAxis.setAttribute('y1', PLOT_TOP + PLOT_H);\n    yAxis.setAttribute('x2', clampedAxX); yAxis.setAttribute('y2', PLOT_TOP + 5);\n    yAxis.setAttribute('class', 'axis-line');\n    yAxis.setAttribute('marker-end', 'url(#arrowY)');\n    axisEl.appendChild(yAxis);\n\n    // Origin label \"0\"\n    if (vp.xMin < 0 && vp.xMax > 0 && vp.yMin < 0 && vp.yMax > 0) {\n      const t = document.createElementNS('http://www.w3.org/2000/svg', 'text');\n      t.setAttribute('x', clampedAxX - 6); t.setAttribute('y', clampedAxY + 14);\n      t.setAttribute('text-anchor', 'middle');\n      t.setAttribute('font-size', '10');\n      t.setAttribute('fill', '#4b5563');\n      t.setAttribute('font-family', 'monospace');\n      t.textContent = '0';\n      tickEl.appendChild(t);\n    }\n  }\n\n  function niceStep(roughStep) {\n    const magnitude = Math.pow(10, Math.floor(Math.log10(roughStep)));\n    const normalized = roughStep / magnitude;\n    let nice;\n    if (normalized < 1.5) nice = 1;\n    else if (normalized < 3) nice = 2;\n    else if (normalized < 7) nice = 5;\n    else nice = 10;\n    return nice * magnitude;\n  }\n\n  // ─── Render function curve ────────────────────────────────────────────────\n  function renderCurve() {\n    const vp = getViewport();\n    const path = document.getElementById('funcPath');\n    const N = 800;\n    const step = (vp.xMax - vp.xMin) / N;\n    let d = '';\n    let prevValid = false;\n    for (let i = 0; i <= N; i++) {\n      const x = vp.xMin + i * step;\n      const y = evalF(x);\n      if (!isFinite(y)) { prevValid = false; continue; }\n      const { sx, sy } = toSVG(x, y, vp);\n      if (!prevValid) {\n        d += `M ${sx.toFixed(2)} ${sy.toFixed(2)} `;\n      } else {\n        d += `L ${sx.toFixed(2)} ${sy.toFixed(2)} `;\n      }\n      prevValid = true;\n    }\n    path.setAttribute('d', d);\n  }\n\n  // ─── Render secant ────────────────────────────────────────────────────────\n  function renderSecant() {\n    const secantPath = document.getElementById('secantPath');\n    const secantPts = document.getElementById('secantPoints');\n    const pt1 = document.getElementById('secPt1');\n    const pt2 = document.getElementById('secPt2');\n    const legendSec = document.getElementById('legendSecant');\n\n    if (!showSecant || !secantData) {\n      secantPath.style.display = 'none';\n      secantPts.style.display = 'none';\n      legendSec.style.display = 'none';\n      return;\n    }\n    const vp = getViewport();\n    const { x1, y1, x2, y2 } = secantData;\n\n    // Extend secant line across the full viewport\n    const slope = (y2 - y1) / (x2 - x1);\n    const lineY1 = y1 + slope * (vp.xMin - x1);\n    const lineY2 = y1 + slope * (vp.xMax - x1);\n    const p1 = toSVG(vp.xMin, lineY1, vp);\n    const p2 = toSVG(vp.xMax, lineY2, vp);\n    secantPath.setAttribute('d', `M ${p1.sx} ${p1.sy} L ${p2.sx} ${p2.sy}`);\n    secantPath.style.display = '';\n\n    const sp1 = toSVG(x1, y1, vp);\n    const sp2 = toSVG(x2, y2, vp);\n    pt1.setAttribute('cx', sp1.sx); pt1.setAttribute('cy', sp1.sy);\n    pt2.setAttribute('cx', sp2.sx); pt2.setAttribute('cy', sp2.sy);\n    secantPts.style.display = '';\n    legendSec.style.display = '';\n  }\n\n  // ─── Render tangent ───────────────────────────────────────────────────────\n  function renderTangent() {\n    const tangentPath = document.getElementById('tangentPath');\n    const tangentPt = document.getElementById('tangentPoint');\n    const pt = document.getElementById('tanPt');\n    const legendTan = document.getElementById('legendTangent');\n\n    if (!showTangent || !tangentData) {\n      tangentPath.style.display = 'none';\n      tangentPt.style.display = 'none';\n      legendTan.style.display = 'none';\n      return;\n    }\n    const vp = getViewport();\n    const { x0, y0, slope } = tangentData;\n\n    const lineY1 = y0 + slope * (vp.xMin - x0);\n    const lineY2 = y0 + slope * (vp.xMax - x0);\n    const p1 = toSVG(vp.xMin, lineY1, vp);\n    const p2 = toSVG(vp.xMax, lineY2, vp);\n    tangentPath.setAttribute('d', `M ${p1.sx} ${p1.sy} L ${p2.sx} ${p2.sy}`);\n    tangentPath.style.display = '';\n\n    const sp = toSVG(x0, y0, vp);\n    pt.setAttribute('cx', sp.sx); pt.setAttribute('cy', sp.sy);\n    tangentPt.style.display = '';\n    legendTan.style.display = '';\n  }\n\n  // ─── Full render ──────────────────────────────────────────────────────────\n  function render() {\n    renderGrid();\n    renderCurve();\n    renderSecant();\n    renderTangent();\n    updateExpr();\n    updateKjennetegn();\n  }\n\n  function updateExpr() {\n    const def = funcDefs[currentType];\n    document.getElementById('funcExpr').textContent = def.expr(params);\n  }\n\n  function updateKjennetegn() {\n    const def = funcDefs[currentType];\n    const lines = def.kjennetegn(params);\n    const el = document.getElementById('kjennetegn');\n    el.innerHTML = lines.map(l => `<p class=\"flex items-start gap-1\"><span class=\"text-blue-400 mt-0.5\">▸</span><span>${l}</span></p>`).join('');\n  }\n\n  // ─── Build parameter controls ─────────────────────────────────────────────\n  function buildParamControls() {\n    const def = funcDefs[currentType];\n    const container = document.getElementById('paramControls');\n    container.innerHTML = '';\n    // Reset params to defaults\n    params = {};\n    def.params.forEach(p => { params[p.key] = p.default; });\n\n    def.params.forEach(pd => {\n      const div = document.createElement('div');\n      div.className = 'space-y-1';\n      div.innerHTML = `\n        <div class=\"flex items-center justify-between\">\n          <label class=\"text-sm font-medium text-gray-700\">${pd.label}</label>\n          <span id=\"val_${pd.key}\" class=\"font-mono text-sm text-blue-700 bg-blue-50 px-2 py-0.5 rounded\">${fmt(pd.default)}</span>\n        </div>\n        <input type=\"range\"\n          id=\"slider_${pd.key}\"\n          min=\"${pd.min}\" max=\"${pd.max}\" step=\"${pd.step}\" value=\"${pd.default}\"\n          class=\"w-full h-2 rounded-lg appearance-none cursor-pointer bg-gray-200\">\n        <div class=\"flex justify-between text-xs text-gray-400\">\n          <span>${pd.min}</span><span>${pd.max}</span>\n        </div>`;\n      container.appendChild(div);\n\n      const slider = div.querySelector(`#slider_${pd.key}`);\n      slider.addEventListener('input', () => {\n        params[pd.key] = parseFloat(slider.value);\n        document.getElementById(`val_${pd.key}`).textContent = fmt(params[pd.key]);\n        // Recompute secant/tangent if shown\n        if (showSecant) computeSecant();\n        if (showTangent) computeTangent();\n        render();\n      });\n    });\n  }\n\n  // ─── Type selector ────────────────────────────────────────────────────────\n  document.getElementById('typeBtns').addEventListener('click', e => {\n    const btn = e.target.closest('[data-type]');\n    if (!btn) return;\n    currentType = btn.dataset.type;\n    document.querySelectorAll('#typeBtns .tab-btn').forEach(b => b.classList.remove('active'));\n    btn.classList.add('active');\n    // Reset secant/tangent displays\n    showSecant = false;\n    showTangent = false;\n    secantData = null;\n    tangentData = null;\n    document.getElementById('secantResult').classList.add('hidden');\n    document.getElementById('tangentResult').classList.add('hidden');\n    buildParamControls();\n    render();\n  });\n\n  // ─── Viewport inputs ──────────────────────────────────────────────────────\n  ['xMin','xMax','yMin','yMax'].forEach(id => {\n    document.getElementById(id).addEventListener('change', () => render());\n  });\n\n  // ─── Compute secant ───────────────────────────────────────────────────────\n  function computeSecant() {\n    const x1 = parseFloat(document.getElementById('secX1').value);\n    const x2 = parseFloat(document.getElementById('secX2').value);\n    if (!isFinite(x1) || !isFinite(x2) || Math.abs(x2 - x1) < 1e-10) return false;\n    const y1 = evalF(x1);\n    const y2 = evalF(x2);\n    if (!isFinite(y1) || !isFinite(y2)) return false;\n    const slope = (y2 - y1) / (x2 - x1);\n    secantData = { x1, y1, x2, y2, slope };\n\n    const resultEl = document.getElementById('secantResult');\n    resultEl.classList.remove('hidden');\n    resultEl.innerHTML = `\n      <p><strong>x₁ = ${fmt(x1)}</strong>, f(x₁) = ${fmt(y1)}</p>\n      <p><strong>x₂ = ${fmt(x2)}</strong>, f(x₂) = ${fmt(y2)}</p>\n      <p class=\"pt-1 border-t border-yellow-200 mt-1\">\n        <strong>Gjennomsnittlig vekstfart:</strong>\n        Δy/Δx = (${fmt(y2)} − ${fmt(y1)}) / (${fmt(x2)} − ${fmt(x1)}) = <span class=\"text-yellow-700 font-bold\">${fmt(slope)}</span>\n      </p>\n      <p class=\"text-xs text-gray-500 mt-1\">Sekanten har stigningstall ${fmt(slope)}. ${slope > 0 ? 'Funksjonen stiger i gjennomsnitt.' : slope < 0 ? 'Funksjonen synker i gjennomsnitt.' : 'Ingen gjennomsnittlig endring.'}</p>`;\n    return true;\n  }\n\n  // ─── Compute tangent ──────────────────────────────────────────────────────\n  function computeTangent() {\n    const x0 = parseFloat(document.getElementById('tanX').value);\n    if (!isFinite(x0)) return false;\n    const y0 = evalF(x0);\n    if (!isFinite(y0)) return false;\n    const dx = 0.0001;\n    const slope = (evalF(x0 + dx) - evalF(x0)) / dx;\n    if (!isFinite(slope)) return false;\n    tangentData = { x0, y0, slope };\n\n    const resultEl = document.getElementById('tangentResult');\n    resultEl.classList.remove('hidden');\n    resultEl.innerHTML = `\n      <p><strong>Punkt:</strong> (${fmt(x0)}, ${fmt(y0)})</p>\n      <p class=\"pt-1 border-t border-red-200 mt-1\">\n        <strong>Momentan vekstfart:</strong>\n        f′(${fmt(x0)}) ≈ <span class=\"text-red-700 font-bold\">${fmt(slope)}</span>\n      </p>\n      <p class=\"text-xs text-gray-500 mt-1\">Tangentlinjen berører grafen i punktet (${fmt(x0)}, ${fmt(y0)}) med stigningstall ${fmt(slope)}.</p>`;\n    return true;\n  }\n\n  // ─── Buttons ──────────────────────────────────────────────────────────────\n  document.getElementById('btnSecant').addEventListener('click', () => {\n    if (computeSecant()) {\n      showSecant = true;\n      renderSecant();\n    } else {\n      document.getElementById('secantResult').classList.remove('hidden');\n      document.getElementById('secantResult').innerHTML = '<p class=\"text-red-600\">Ugyldig x-verdi eller x₁ = x₂. Prøv igjen.</p>';\n      showSecant = false;\n      renderSecant();\n    }\n  });\n\n  document.getElementById('btnTangent').addEventListener('click', () => {\n    if (computeTangent()) {\n      showTangent = true;\n      renderTangent();\n    } else {\n      document.getElementById('tangentResult').classList.remove('hidden');\n      document.getElementById('tangentResult').innerHTML = '<p class=\"text-red-600\">Ugyldig x-verdi (f(x) ikke definert her).</p>';\n      showTangent = false;\n      renderTangent();\n    }\n  });\n\n  // ─── Init ─────────────────────────────────────────────────────────────────\n  buildParamControls();\n  render();\n\n})();\n</script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Funksjoner og vekst",
    "windowTitle": "Funksjoner og vekst",
    "bundleId": "com.halisonworks.funksjonervekst",
    "iconPath": null
  },
  "categoryId": null,
  "source": "import",
  "createdAt": "2026-06-02T12:00:00.000Z",
  "updatedAt": "2026-06-02T12:00:00.000Z",
  "sharedAt": "2026-06-02T12:00:00.000Z"
}
