{
  "schema": "app-studio/canvas@1",
  "id": "example-no2p-lineaer-regresjon",
  "name": "lineaer-regresjon.html",
  "code": "<!DOCTYPE html>\n<!--\n  Lineær regresjon — Halison App Studio-eksempel\n\n  Interaktivt læremiddel for matematikk 2P (LK20): legg inn datapunkter, finn den\n  lineære regresjonslinja y = ax + b, og bruk modellen til å gjøre forutsigelser.\n\n  Fra Halison App Studio sitt offentlige bibliotek:\n  https://github.com/halisonworks/public-app-studio\n\n  Tillatt bruk: personlig, pedagogisk og annen ikke-kommersiell bruk. Behold denne\n  headeren og kildelenken; ikke-kommersiell bruk. Utgitt under Halison App Studio\n  Examples License — se LICENSE-filen i repoet over.\n-->\n<html lang=\"no\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Lineær regresjon – Matematikk 2P</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Segoe UI', Arial, sans-serif; }\n    .svg-container { width: 100%; overflow-x: auto; }\n    svg text { font-family: 'Segoe UI', Arial, sans-serif; }\n    input[type=\"number\"]::-webkit-inner-spin-button,\n    input[type=\"number\"]::-webkit-outer-spin-button { opacity: 1; }\n    .punkt-rad:hover { background: #f0f9ff; }\n    .dot-point { fill: #2563eb; stroke: #1d4ed8; stroke-width: 1.5; }\n    .dot-point:hover { fill: #1d4ed8; r: 6; }\n    .pred-point { fill: #dc2626; stroke: #b91c1c; stroke-width: 1.5; }\n  </style>\n</head>\n<body class=\"bg-gray-50 min-h-screen\">\n\n<div class=\"max-w-4xl mx-auto px-4 py-8\">\n\n  <!-- Topptekst -->\n  <header class=\"mb-8\">\n    <div class=\"flex items-center gap-2 mb-1\">\n      <span class=\"text-xs font-semibold uppercase tracking-widest text-blue-600 bg-blue-50 px-2 py-0.5 rounded\">Matematikk 2P · LK20</span>\n      <span class=\"text-xs text-gray-400\">Kapittel 4 – Lineære modeller</span>\n    </div>\n    <h1 class=\"text-3xl font-bold text-gray-900 mt-1\">Lineær regresjon</h1>\n    <p class=\"text-gray-500 mt-1 text-sm\">Legg inn datapunkter, beregn regresjonslinja <em>y = ax + b</em>, og bruk modellen til å gjøre forutsigelser.</p>\n  </header>\n\n  <!-- Forklaring -->\n  <section class=\"bg-blue-50 border border-blue-200 rounded-xl p-5 mb-8 text-sm text-gray-700 leading-relaxed\">\n    <h2 class=\"font-semibold text-blue-800 mb-2 text-base\">Hva er en lineær modell?</h2>\n    <p class=\"mb-2\">\n      En <strong>lineær modell</strong> beskriver sammenhengen mellom to størrelser med en rett linje: <em>y = ax + b</em>.\n      Her er <em>a</em> <strong>stigningstallet</strong> (hvor mye y endrer seg når x øker med 1) og <em>b</em> er\n      <strong>konstantleddet</strong> (verdien av y når x = 0).\n    </p>\n    <p class=\"mb-2\">\n      <strong>Minste kvadraters metode</strong> finner den linja som minimerer summen av kvadrerte avvik mellom\n      de observerte y-verdiene og de modellpredikerte y-verdiene. Formelen er:\n    </p>\n    <div class=\"bg-white rounded-lg px-4 py-3 my-2 font-mono text-sm border border-blue-100 text-blue-900 inline-block\">\n      a = Σ((xᵢ − x̄)(yᵢ − ȳ)) / Σ((xᵢ − x̄)²) &nbsp;&nbsp; b = ȳ − a·x̄\n    </div>\n    <p class=\"mt-2 text-amber-700 bg-amber-50 border border-amber-200 rounded-lg px-3 py-2\">\n      <strong>⚠ Merk:</strong> Vær forsiktig med å bruke modellen utenfor dataområdet\n      (<em>ekstrapolering</em>). Sammenhengen trenger ikke å være lineær utenfor de observerte verdiene.\n    </p>\n  </section>\n\n  <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-8\">\n\n    <!-- Venstre: Datatabell -->\n    <div>\n      <div class=\"bg-white rounded-xl shadow-sm border border-gray-200 p-5\">\n        <div class=\"flex items-center justify-between mb-4\">\n          <h2 class=\"font-semibold text-gray-800 text-base\">Datapunkter</h2>\n          <div class=\"flex gap-2\">\n            <button\n              onclick=\"leggTilRad()\"\n              class=\"text-sm px-3 py-1.5 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition font-medium\"\n            >+ Legg til rad</button>\n            <button\n              onclick=\"tilbakestill()\"\n              class=\"text-sm px-3 py-1.5 bg-gray-100 text-gray-600 rounded-lg hover:bg-gray-200 transition font-medium\"\n            >Tilbakestill</button>\n          </div>\n        </div>\n\n        <!-- Kolonnebeskrivelser -->\n        <div class=\"flex gap-2 mb-2 px-1\">\n          <div class=\"w-8\"></div>\n          <div class=\"flex-1\">\n            <label class=\"block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1\">\n              x-akse:\n            </label>\n            <input\n              id=\"xLabel\"\n              type=\"text\"\n              value=\"Temperatur (°C)\"\n              oninput=\"oppdater()\"\n              class=\"w-full text-sm border border-gray-200 rounded-lg px-2 py-1 focus:outline-none focus:ring-2 focus:ring-blue-300\"\n              placeholder=\"x-akse navn\"\n            />\n          </div>\n          <div class=\"flex-1\">\n            <label class=\"block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1\">\n              y-akse:\n            </label>\n            <input\n              id=\"yLabel\"\n              type=\"text\"\n              value=\"Iskrem solgt (antall)\"\n              oninput=\"oppdater()\"\n              class=\"w-full text-sm border border-gray-200 rounded-lg px-2 py-1 focus:outline-none focus:ring-2 focus:ring-blue-300\"\n              placeholder=\"y-akse navn\"\n            />\n          </div>\n        </div>\n\n        <!-- Tabelloverskrift -->\n        <div class=\"flex gap-2 mb-1 px-1\">\n          <div class=\"w-8 text-center text-xs font-semibold text-gray-400 uppercase\">#</div>\n          <div class=\"flex-1 text-center text-xs font-semibold text-gray-500 uppercase tracking-wide\">x</div>\n          <div class=\"flex-1 text-center text-xs font-semibold text-gray-500 uppercase tracking-wide\">y</div>\n          <div class=\"w-8\"></div>\n        </div>\n\n        <div id=\"tabellKropp\" class=\"space-y-1 max-h-80 overflow-y-auto pr-1\">\n          <!-- rader legges inn av JS -->\n        </div>\n\n        <p id=\"feilMelding\" class=\"text-red-500 text-xs mt-2 hidden\">Trenger minst 2 datapunkter med ulik x-verdi.</p>\n      </div>\n\n      <!-- Resultater -->\n      <div class=\"bg-white rounded-xl shadow-sm border border-gray-200 p-5 mt-5\">\n        <h2 class=\"font-semibold text-gray-800 text-base mb-4\">Regresjonsresultater</h2>\n        <div id=\"resultatBoks\" class=\"space-y-3\">\n          <div class=\"text-gray-400 text-sm italic\">Legg inn minst 2 datapunkter for å beregne.</div>\n        </div>\n      </div>\n\n      <!-- Forutsigelse -->\n      <div class=\"bg-white rounded-xl shadow-sm border border-gray-200 p-5 mt-5\">\n        <h2 class=\"font-semibold text-gray-800 text-base mb-3\">Forutsigelse</h2>\n        <p class=\"text-sm text-gray-500 mb-3\">Skriv inn en x-verdi for å beregne modellens forutsagte y-verdi.</p>\n        <div class=\"flex gap-2 items-end\">\n          <div class=\"flex-1\">\n            <label class=\"block text-xs font-medium text-gray-600 mb-1\">x-verdi:</label>\n            <input\n              id=\"predX\"\n              type=\"number\"\n              step=\"any\"\n              placeholder=\"f.eks. 25\"\n              oninput=\"oppdaterPredikasjon()\"\n              class=\"w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300\"\n            />\n          </div>\n          <div class=\"flex-1\">\n            <label class=\"block text-xs font-medium text-gray-600 mb-1\">Forutsagt y:</label>\n            <div id=\"predY\" class=\"w-full border border-gray-100 bg-gray-50 rounded-lg px-3 py-2 text-sm text-gray-700 min-h-[38px]\">—</div>\n          </div>\n        </div>\n        <div id=\"predAdvarsel\" class=\"mt-2 text-xs text-amber-600 hidden\"></div>\n      </div>\n    </div>\n\n    <!-- Høyre: Graf -->\n    <div>\n      <div class=\"bg-white rounded-xl shadow-sm border border-gray-200 p-5\">\n        <h2 class=\"font-semibold text-gray-800 text-base mb-4\">Diagram</h2>\n        <div class=\"svg-container\">\n          <svg id=\"diagram\" width=\"400\" height=\"360\" viewBox=\"0 0 400 360\"\n            class=\"w-full\"\n            style=\"max-width:100%\"\n            aria-label=\"Spredningsdiagram med regresjonslinje\">\n          </svg>\n        </div>\n        <div class=\"flex flex-wrap gap-4 mt-3 text-xs text-gray-500\">\n          <span class=\"flex items-center gap-1\"><span class=\"inline-block w-3 h-3 rounded-full bg-blue-600\"></span> Datapunkter</span>\n          <span class=\"flex items-center gap-1\"><span class=\"inline-block w-6 h-0.5 bg-green-600\"></span> Regresjonslinje</span>\n          <span class=\"flex items-center gap-1\"><span class=\"inline-block w-3 h-3 rounded-full bg-red-500\"></span> Forutsigelse</span>\n        </div>\n      </div>\n\n      <!-- r-tolkning -->\n      <div id=\"rTolkningBoks\" class=\"bg-white rounded-xl shadow-sm border border-gray-200 p-5 mt-5 hidden\">\n        <h2 class=\"font-semibold text-gray-800 text-base mb-2\">Korrelasjonskoeffisient <em>r</em></h2>\n        <div id=\"rTolkningTekst\" class=\"text-sm text-gray-700\"></div>\n        <div class=\"mt-3\">\n          <!-- r-visualisering -->\n          <div class=\"relative h-5 rounded-full overflow-hidden bg-gradient-to-r from-red-400 via-yellow-200 to-green-400\">\n            <div id=\"rPeker\" class=\"absolute top-0 w-1 h-full bg-gray-900 transition-all\" style=\"left:50%\"></div>\n          </div>\n          <div class=\"flex justify-between text-xs text-gray-400 mt-0.5\">\n            <span>−1</span><span>0</span><span>+1</span>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <footer class=\"mt-10 text-xs text-center text-gray-400\">\n    Matematikk 2P · LK20 · Halison App Studio · Kun til ikke-kommersiell pedagogisk bruk\n  </footer>\n</div>\n\n<script>\n// ─────────────────────────────────────────────────────────────────────────────\n// Datamodell\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst startData = [\n  { x: 10, y: 42 },\n  { x: 14, y: 58 },\n  { x: 17, y: 74 },\n  { x: 20, y: 89 },\n  { x: 23, y: 102 },\n  { x: 26, y: 118 },\n  { x: 29, y: 130 },\n  { x: 32, y: 145 },\n];\n\nlet punkter = startData.map(p => ({ ...p }));\nlet regresjonsA = null;\nlet regresjonsB = null;\nlet rKoeff = null;\n\n// ─────────────────────────────────────────────────────────────────────────────\n// Tabell\n// ─────────────────────────────────────────────────────────────────────────────\n\nfunction byggTabell() {\n  const kropp = document.getElementById('tabellKropp');\n  kropp.innerHTML = '';\n  punkter.forEach((p, i) => {\n    const rad = document.createElement('div');\n    rad.className = 'punkt-rad flex gap-2 items-center rounded-lg px-1 py-0.5';\n    rad.innerHTML = `\n      <div class=\"w-8 text-center text-xs text-gray-400 font-mono select-none\">${i + 1}</div>\n      <input\n        type=\"number\" step=\"any\" value=\"${p.x}\"\n        oninput=\"oppdaterVerdi(${i},'x',this.value)\"\n        class=\"flex-1 border border-gray-200 rounded-lg px-2 py-1.5 text-sm text-center focus:outline-none focus:ring-2 focus:ring-blue-300\"\n        aria-label=\"x-verdi rad ${i+1}\"\n      />\n      <input\n        type=\"number\" step=\"any\" value=\"${p.y}\"\n        oninput=\"oppdaterVerdi(${i},'y',this.value)\"\n        class=\"flex-1 border border-gray-200 rounded-lg px-2 py-1.5 text-sm text-center focus:outline-none focus:ring-2 focus:ring-blue-300\"\n        aria-label=\"y-verdi rad ${i+1}\"\n      />\n      <button\n        onclick=\"fjernRad(${i})\"\n        class=\"w-8 h-8 flex items-center justify-center text-gray-300 hover:text-red-500 rounded-lg hover:bg-red-50 transition text-lg font-bold\"\n        aria-label=\"Fjern rad ${i+1}\"\n        title=\"Fjern denne raden\"\n      >×</button>\n    `;\n    kropp.appendChild(rad);\n  });\n}\n\nfunction oppdaterVerdi(i, felt, verdi) {\n  const tall = parseFloat(verdi);\n  if (!isNaN(tall)) {\n    punkter[i][felt] = tall;\n    oppdater();\n  }\n}\n\nfunction leggTilRad() {\n  const sisteX = punkter.length > 0 ? punkter[punkter.length - 1].x + 3 : 0;\n  punkter.push({ x: sisteX, y: 0 });\n  byggTabell();\n  oppdater();\n  const kropp = document.getElementById('tabellKropp');\n  kropp.scrollTop = kropp.scrollHeight;\n}\n\nfunction fjernRad(i) {\n  if (punkter.length <= 1) return;\n  punkter.splice(i, 1);\n  byggTabell();\n  oppdater();\n}\n\nfunction tilbakestill() {\n  punkter = startData.map(p => ({ ...p }));\n  document.getElementById('xLabel').value = 'Temperatur (°C)';\n  document.getElementById('yLabel').value = 'Iskrem solgt (antall)';\n  document.getElementById('predX').value = '';\n  document.getElementById('predY').textContent = '—';\n  document.getElementById('predAdvarsel').classList.add('hidden');\n  byggTabell();\n  oppdater();\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// Regresjonsberegning\n// ─────────────────────────────────────────────────────────────────────────────\n\nfunction beregnRegresjon(pts) {\n  const n = pts.length;\n  if (n < 2) return null;\n\n  const xMean = pts.reduce((s, p) => s + p.x, 0) / n;\n  const yMean = pts.reduce((s, p) => s + p.y, 0) / n;\n\n  let teller = 0, nevner = 0;\n  for (const p of pts) {\n    teller += (p.x - xMean) * (p.y - yMean);\n    nevner += (p.x - xMean) ** 2;\n  }\n\n  if (nevner === 0) return null; // alle x-verdier like\n\n  const a = teller / nevner;\n  const b = yMean - a * xMean;\n\n  // Korrelasjonskoeffisient r\n  let syTeller = 0, sxSq = 0, sySq = 0;\n  for (const p of pts) {\n    syTeller += (p.x - xMean) * (p.y - yMean);\n    sxSq += (p.x - xMean) ** 2;\n    sySq += (p.y - yMean) ** 2;\n  }\n  const r = sySq === 0 ? 0 : syTeller / Math.sqrt(sxSq * sySq);\n\n  return { a, b, r, xMean, yMean, n };\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// Resultater\n// ─────────────────────────────────────────────────────────────────────────────\n\nfunction fmt(tall, desimaler = 4) {\n  return Number(tall.toFixed(desimaler)).toString();\n}\n\nfunction visResultater(res) {\n  const boks = document.getElementById('resultatBoks');\n  const feil = document.getElementById('feilMelding');\n\n  if (!res) {\n    boks.innerHTML = '<div class=\"text-gray-400 text-sm italic\">Trenger minst 2 datapunkter med ulik x-verdi.</div>';\n    feil.classList.remove('hidden');\n    document.getElementById('rTolkningBoks').classList.add('hidden');\n    return;\n  }\n  feil.classList.add('hidden');\n\n  const aTekst = fmt(res.a, 4);\n  const bTekst = fmt(res.b, 4);\n  const rTekst = fmt(res.r, 4);\n  const fortegnB = res.b >= 0 ? '+' : '−';\n  const bAbs = fmt(Math.abs(res.b), 4);\n\n  // Formel-streng\n  const ligning = `y = ${aTekst}x ${fortegnB} ${bAbs}`;\n\n  boks.innerHTML = `\n    <div class=\"bg-blue-50 border border-blue-200 rounded-xl px-4 py-3 text-center\">\n      <p class=\"text-xs text-blue-600 font-semibold uppercase tracking-widest mb-1\">Regresjonslinja</p>\n      <p class=\"text-xl font-bold text-blue-900 font-mono\">${ligning}</p>\n    </div>\n    <div class=\"grid grid-cols-2 gap-3 mt-1\">\n      <div class=\"bg-gray-50 rounded-lg px-3 py-2 text-center border border-gray-100\">\n        <p class=\"text-xs text-gray-500 mb-0.5\">Stigningstall <em>a</em></p>\n        <p class=\"text-lg font-bold text-gray-800 font-mono\">${aTekst}</p>\n        <p class=\"text-xs text-gray-400\">Økning i y per 1 i x</p>\n      </div>\n      <div class=\"bg-gray-50 rounded-lg px-3 py-2 text-center border border-gray-100\">\n        <p class=\"text-xs text-gray-500 mb-0.5\">Konstantledd <em>b</em></p>\n        <p class=\"text-lg font-bold text-gray-800 font-mono\">${fmt(res.b, 4)}</p>\n        <p class=\"text-xs text-gray-400\">Verdi når x = 0</p>\n      </div>\n    </div>\n    <div class=\"grid grid-cols-2 gap-3 mt-1\">\n      <div class=\"bg-gray-50 rounded-lg px-3 py-2 text-center border border-gray-100\">\n        <p class=\"text-xs text-gray-500 mb-0.5\">Korrelasjon <em>r</em></p>\n        <p class=\"text-lg font-bold text-gray-800 font-mono\">${rTekst}</p>\n      </div>\n      <div class=\"bg-gray-50 rounded-lg px-3 py-2 text-center border border-gray-100\">\n        <p class=\"text-xs text-gray-500 mb-0.5\">Ant. punkter</p>\n        <p class=\"text-lg font-bold text-gray-800 font-mono\">${res.n}</p>\n      </div>\n    </div>\n  `;\n\n  // r-tolkning\n  visRTolkning(res.r);\n}\n\nfunction rTolkningTekst(r) {\n  const abs = Math.abs(r);\n  const retning = r > 0 ? 'positiv' : 'negativ';\n  let styrke;\n  if (abs >= 0.9) styrke = 'svært sterk';\n  else if (abs >= 0.7) styrke = 'sterk';\n  else if (abs >= 0.5) styrke = 'moderat';\n  else if (abs >= 0.3) styrke = 'svak';\n  else styrke = 'veldig svak eller ingen';\n\n  return `<p>Korrelasjonskoeffisienten <strong>r = ${fmt(r, 4)}</strong> indikerer en <strong>${styrke} ${retning} lineær sammenheng</strong> mellom x og y. `\n    + (abs >= 0.7\n      ? 'En lineær modell passer dataene godt.'\n      : abs >= 0.5\n        ? 'En lineær modell kan brukes, men passer ikke perfekt.'\n        : 'En lineær modell er trolig ikke den beste beskrivelsen av dataene.')\n    + '</p>';\n}\n\nfunction visRTolkning(r) {\n  const boks = document.getElementById('rTolkningBoks');\n  const tekst = document.getElementById('rTolkningTekst');\n  const peker = document.getElementById('rPeker');\n\n  boks.classList.remove('hidden');\n  tekst.innerHTML = rTolkningTekst(r);\n\n  // Plasser peker: r går fra -1 til 1, mappes til 0%-100%\n  const pct = ((r + 1) / 2) * 100;\n  peker.style.left = `${Math.max(0, Math.min(100, pct))}%`;\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// Forutsigelse\n// ─────────────────────────────────────────────────────────────────────────────\n\nfunction oppdaterPredikasjon() {\n  const xInput = document.getElementById('predX').value;\n  const yDiv = document.getElementById('predY');\n  const advarsel = document.getElementById('predAdvarsel');\n\n  if (xInput === '' || regresjonsA === null) {\n    yDiv.textContent = '—';\n    advarsel.classList.add('hidden');\n    tegnDiagram();\n    return;\n  }\n\n  const xVal = parseFloat(xInput);\n  if (isNaN(xVal)) {\n    yDiv.textContent = '—';\n    advarsel.classList.add('hidden');\n    tegnDiagram();\n    return;\n  }\n\n  const yVal = regresjonsA * xVal + regresjonsB;\n  yDiv.textContent = fmt(yVal, 2);\n\n  // Sjekk ekstrapolering\n  const xs = punkter.map(p => p.x);\n  const xMin = Math.min(...xs);\n  const xMax = Math.max(...xs);\n  if (xVal < xMin || xVal > xMax) {\n    advarsel.textContent = `⚠ x = ${xVal} er utenfor dataområdet [${xMin}, ${xMax}]. Dette er ekstrapolering – resultatet kan være upålitelig.`;\n    advarsel.classList.remove('hidden');\n  } else {\n    advarsel.classList.add('hidden');\n  }\n\n  tegnDiagram();\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// SVG-diagram\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst PAD = { top: 24, right: 24, bottom: 56, left: 58 };\nconst SVG_W = 400;\nconst SVG_H = 360;\nconst PLOT_W = SVG_W - PAD.left - PAD.right;\nconst PLOT_H = SVG_H - PAD.top - PAD.bottom;\n\nfunction niceRange(min, max, ticks = 5) {\n  if (min === max) { min -= 1; max += 1; }\n  const range = max - min;\n  const rawStep = range / ticks;\n  const mag = Math.pow(10, Math.floor(Math.log10(rawStep)));\n  const niceStep = Math.ceil(rawStep / mag) * mag;\n  const niceMin = Math.floor(min / niceStep) * niceStep;\n  const niceMax = Math.ceil(max / niceStep) * niceStep;\n  return { min: niceMin, max: niceMax, step: niceStep };\n}\n\nfunction tegnDiagram() {\n  const svg = document.getElementById('diagram');\n  svg.innerHTML = '';\n\n  const xLabelTekst = document.getElementById('xLabel').value || 'x';\n  const yLabelTekst = document.getElementById('yLabel').value || 'y';\n\n  if (punkter.length === 0) return;\n\n  // Finn datagrenser (inkluder predikasjonspunkt)\n  const xs = punkter.map(p => p.x);\n  const ys = punkter.map(p => p.y);\n\n  const predXVal = parseFloat(document.getElementById('predX').value);\n  const visPred = !isNaN(predXVal) && regresjonsA !== null;\n  const predYVal = visPred ? regresjonsA * predXVal + regresjonsB : null;\n\n  if (visPred) { xs.push(predXVal); ys.push(predYVal); }\n\n  // Utvid grenser litt for å romme regresjonslinjen pent\n  const xRaw = niceRange(Math.min(...xs), Math.max(...xs), 5);\n  let yAllVals = [...ys];\n  if (regresjonsA !== null) {\n    yAllVals.push(regresjonsA * xRaw.min + regresjonsB);\n    yAllVals.push(regresjonsA * xRaw.max + regresjonsB);\n  }\n  const yRaw = niceRange(Math.min(...yAllVals), Math.max(...yAllVals), 5);\n\n  const xRange = xRaw;\n  const yRange = yRaw;\n\n  function toSVG(x, y) {\n    const sx = PAD.left + (x - xRange.min) / (xRange.max - xRange.min) * PLOT_W;\n    const sy = PAD.top + (1 - (y - yRange.min) / (yRange.max - yRange.min)) * PLOT_H;\n    return { sx, sy };\n  }\n\n  const ns = 'http://www.w3.org/2000/svg';\n\n  function el(tag, attrs, text) {\n    const e = document.createElementNS(ns, tag);\n    for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, v);\n    if (text !== undefined) e.textContent = text;\n    return e;\n  }\n\n  // Bakgrunn\n  svg.appendChild(el('rect', { x: PAD.left, y: PAD.top, width: PLOT_W, height: PLOT_H, fill: '#f9fafb', rx: 4 }));\n\n  // Rutenett og akse-ticks (x)\n  for (let x = xRange.min; x <= xRange.max + 1e-9; x += xRange.step) {\n    const { sx } = toSVG(x, yRange.min);\n    svg.appendChild(el('line', { x1: sx, y1: PAD.top, x2: sx, y2: PAD.top + PLOT_H, stroke: '#e5e7eb', 'stroke-width': 1 }));\n    svg.appendChild(el('line', { x1: sx, y1: PAD.top + PLOT_H, x2: sx, y2: PAD.top + PLOT_H + 5, stroke: '#9ca3af', 'stroke-width': 1 }));\n    svg.appendChild(el('text', { x: sx, y: PAD.top + PLOT_H + 18, 'text-anchor': 'middle', 'font-size': 10, fill: '#6b7280' }, fmt(x, x % 1 === 0 ? 0 : 1)));\n  }\n\n  // Rutenett og akse-ticks (y)\n  for (let y = yRange.min; y <= yRange.max + 1e-9; y += yRange.step) {\n    const { sy } = toSVG(xRange.min, y);\n    svg.appendChild(el('line', { x1: PAD.left, y1: sy, x2: PAD.left + PLOT_W, y2: sy, stroke: '#e5e7eb', 'stroke-width': 1 }));\n    svg.appendChild(el('line', { x1: PAD.left - 5, y1: sy, x2: PAD.left, y2: sy, stroke: '#9ca3af', 'stroke-width': 1 }));\n    svg.appendChild(el('text', { x: PAD.left - 8, y: sy + 4, 'text-anchor': 'end', 'font-size': 10, fill: '#6b7280' }, fmt(y, y % 1 === 0 ? 0 : 1)));\n  }\n\n  // Akselinjer\n  svg.appendChild(el('line', { x1: PAD.left, y1: PAD.top, x2: PAD.left, y2: PAD.top + PLOT_H, stroke: '#6b7280', 'stroke-width': 1.5 }));\n  svg.appendChild(el('line', { x1: PAD.left, y1: PAD.top + PLOT_H, x2: PAD.left + PLOT_W, y2: PAD.top + PLOT_H, stroke: '#6b7280', 'stroke-width': 1.5 }));\n\n  // Akseetiketter\n  svg.appendChild(el('text', {\n    x: PAD.left + PLOT_W / 2,\n    y: SVG_H - 4,\n    'text-anchor': 'middle',\n    'font-size': 11,\n    fill: '#374151',\n    'font-weight': 'bold'\n  }, xLabelTekst));\n\n  const yLabelEl = el('text', {\n    x: 0,\n    y: 0,\n    'text-anchor': 'middle',\n    'font-size': 11,\n    fill: '#374151',\n    'font-weight': 'bold',\n    transform: `translate(13, ${PAD.top + PLOT_H / 2}) rotate(-90)`\n  }, yLabelTekst);\n  svg.appendChild(yLabelEl);\n\n  // Regresjonslinje\n  if (regresjonsA !== null) {\n    const p1 = toSVG(xRange.min, regresjonsA * xRange.min + regresjonsB);\n    const p2 = toSVG(xRange.max, regresjonsA * xRange.max + regresjonsB);\n    svg.appendChild(el('line', {\n      x1: p1.sx, y1: p1.sy, x2: p2.sx, y2: p2.sy,\n      stroke: '#16a34a', 'stroke-width': 2, 'stroke-dasharray': '0'\n    }));\n  }\n\n  // Datapunkter\n  for (const p of punkter) {\n    const { sx, sy } = toSVG(p.x, p.y);\n    const circle = el('circle', { cx: sx, cy: sy, r: 5, fill: '#2563eb', stroke: '#1d4ed8', 'stroke-width': 1.5 });\n    const title = el('title', {});\n    title.textContent = `(${p.x}, ${p.y})`;\n    circle.appendChild(title);\n    svg.appendChild(circle);\n  }\n\n  // Prediksjonspunkt\n  if (visPred) {\n    const { sx, sy } = toSVG(predXVal, predYVal);\n    // Stiplet vertikallinje fra x-akse til punkt\n    const { sy: bottomY } = toSVG(predXVal, yRange.min);\n    svg.appendChild(el('line', { x1: sx, y1: bottomY, x2: sx, y2: sy, stroke: '#dc2626', 'stroke-width': 1, 'stroke-dasharray': '4 3' }));\n    // Stiplet horisontallinje fra y-akse til punkt\n    const { sx: leftX } = toSVG(xRange.min, predYVal);\n    svg.appendChild(el('line', { x1: leftX, y1: sy, x2: sx, y2: sy, stroke: '#dc2626', 'stroke-width': 1, 'stroke-dasharray': '4 3' }));\n    const predCircle = el('circle', { cx: sx, cy: sy, r: 6, fill: '#dc2626', stroke: '#b91c1c', 'stroke-width': 1.5 });\n    const predTitle = el('title', {});\n    predTitle.textContent = `Forutsigelse: x=${fmt(predXVal,2)}, y≈${fmt(predYVal,2)}`;\n    predCircle.appendChild(predTitle);\n    svg.appendChild(predCircle);\n  }\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// Hoved-oppdatering\n// ─────────────────────────────────────────────────────────────────────────────\n\nfunction oppdater() {\n  const res = beregnRegresjon(punkter);\n  if (res) {\n    regresjonsA = res.a;\n    regresjonsB = res.b;\n    rKoeff = res.r;\n  } else {\n    regresjonsA = null;\n    regresjonsB = null;\n    rKoeff = null;\n  }\n\n  visResultater(res);\n  oppdaterPredikasjon(); // kaller tegnDiagram internt\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// Init\n// ─────────────────────────────────────────────────────────────────────────────\n\nbyggTabell();\noppdater();\n</script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Lineær regresjon",
    "windowTitle": "Lineær regresjon",
    "bundleId": "com.halisonworks.lineaerregresjon",
    "iconPath": null
  },
  "categoryId": null,
  "source": "import",
  "createdAt": "2026-06-02T12:00:00.000Z",
  "updatedAt": "2026-06-02T12:00:00.000Z",
  "sharedAt": "2026-06-02T12:00:00.000Z"
}
