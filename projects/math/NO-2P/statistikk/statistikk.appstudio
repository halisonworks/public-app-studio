{
  "schema": "app-studio/canvas@1",
  "id": "example-no2p-statistikk",
  "name": "statistikk.html",
  "code": "<!DOCTYPE html>\n<!--\n  Statistikk — Halison App Studio-eksempel\n\n  Interaktivt læremiddel for matematikk 2P (LK20): regn ut gjennomsnitt, median,\n  typetall, variasjonsbredde og standardavvik for et datasett, med histogram.\n\n  Fra Halison App Studio sitt offentlige bibliotek:\n  https://github.com/halisonworks/public-app-studio\n\n  Tillatt bruk: personlig, pedagogisk og annen ikke-kommersiell bruk. Behold denne\n  headeren og kildelenken; ikke-kommersiell bruk. Utgitt under Halison App Studio\n  Examples License — se LICENSE-filen i repoet over.\n-->\n<html lang=\"no\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Statistikk — Sentralmål og spredning</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Segoe UI', system-ui, sans-serif; }\n    .result-card { transition: box-shadow 0.2s; }\n    .result-card:hover { box-shadow: 0 4px 20px rgba(0,0,0,0.12); }\n    textarea { resize: vertical; }\n    .hist-bar { transition: opacity 0.15s; }\n    .hist-bar:hover { opacity: 0.75; }\n    .tag-pill {\n      display: inline-block;\n      padding: 1px 8px;\n      border-radius: 9999px;\n      font-size: 0.72rem;\n      font-weight: 600;\n      letter-spacing: 0.03em;\n      vertical-align: middle;\n    }\n    .formula-box {\n      font-family: 'Courier New', monospace;\n      background: #f0f4ff;\n      border-left: 3px solid #6366f1;\n      padding: 8px 12px;\n      border-radius: 4px;\n      font-size: 0.9rem;\n      margin: 6px 0;\n    }\n    #error-msg { display: none; }\n  </style>\n</head>\n<body class=\"bg-gradient-to-br from-slate-50 to-indigo-50 min-h-screen\">\n\n  <!-- Header -->\n  <header class=\"bg-indigo-700 text-white shadow-lg\">\n    <div class=\"max-w-4xl mx-auto px-4 py-5\">\n      <h1 class=\"text-2xl font-bold tracking-tight\">Statistikk</h1>\n      <p class=\"text-indigo-200 text-sm mt-0.5\">Sentralmål og spredning — Matematikk 2P (LK20)</p>\n    </div>\n  </header>\n\n  <main class=\"max-w-4xl mx-auto px-4 py-8 space-y-8\">\n\n    <!-- Dataset input -->\n    <section class=\"bg-white rounded-2xl shadow-sm border border-slate-100 p-6\">\n      <h2 class=\"text-lg font-semibold text-slate-800 mb-1\">Datasett</h2>\n      <p class=\"text-sm text-slate-500 mb-3\">\n        Skriv inn eller lim inn tall separert med mellomrom, komma eller linjeskift.\n      </p>\n      <textarea\n        id=\"data-input\"\n        rows=\"4\"\n        class=\"w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 font-mono\"\n        placeholder=\"Eks: 12 15 14 10 18 12 16 14 13 15\"\n      ></textarea>\n      <div id=\"error-msg\" class=\"mt-2 text-red-600 text-sm font-medium\"></div>\n      <div class=\"flex flex-wrap gap-3 mt-4\">\n        <button\n          id=\"calc-btn\"\n          class=\"bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-5 py-2 rounded-lg text-sm transition-colors\"\n        >Beregn</button>\n        <button\n          id=\"reset-btn\"\n          class=\"bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold px-5 py-2 rounded-lg text-sm transition-colors\"\n        >Tilbakestill</button>\n        <span id=\"n-label\" class=\"self-center text-slate-400 text-sm hidden\">\n          <span id=\"n-val\" class=\"font-bold text-slate-600\"></span> verdier\n        </span>\n      </div>\n\n      <!-- Preset datasets -->\n      <div class=\"mt-4 border-t border-slate-100 pt-4\">\n        <p class=\"text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2\">Forhåndsdefinerte datasett</p>\n        <div class=\"flex flex-wrap gap-2\">\n          <button class=\"preset-btn text-xs bg-indigo-50 hover:bg-indigo-100 text-indigo-700 px-3 py-1 rounded-full border border-indigo-200 transition-colors\"\n            data-set=\"12 15 14 10 18 12 16 14 13 15 11 17 14 13 16\">Karakterer (klasse)</button>\n          <button class=\"preset-btn text-xs bg-teal-50 hover:bg-teal-100 text-teal-700 px-3 py-1 rounded-full border border-teal-200 transition-colors\"\n            data-set=\"170 165 178 182 169 175 180 168 172 177 183 165 171 174 176\">Høyde (cm)</button>\n          <button class=\"preset-btn text-xs bg-amber-50 hover:bg-amber-100 text-amber-700 px-3 py-1 rounded-full border border-amber-200 transition-colors\"\n            data-set=\"5 8 7 6 9 10 4 6 7 8 9 5 7 8 6\">Mål per kamp</button>\n          <button class=\"preset-btn text-xs bg-rose-50 hover:bg-rose-100 text-rose-700 px-3 py-1 rounded-full border border-rose-200 transition-colors\"\n            data-set=\"2 5 6 7 8 6 5 4 100 6 7 5 6 8 5\">Med uteligger</button>\n        </div>\n      </div>\n    </section>\n\n    <!-- Results section (hidden until calculated) -->\n    <section id=\"results-section\" class=\"hidden space-y-6\">\n\n      <!-- Summary cards grid -->\n      <div class=\"grid grid-cols-2 md:grid-cols-3 gap-4\" id=\"cards-grid\">\n\n        <div class=\"result-card bg-white rounded-2xl border border-slate-100 shadow-sm p-5\">\n          <div class=\"flex items-center justify-between mb-1\">\n            <span class=\"text-xs font-semibold text-slate-400 uppercase tracking-wider\">Gjennomsnitt</span>\n            <span class=\"tag-pill bg-indigo-100 text-indigo-700\">x̄</span>\n          </div>\n          <p id=\"res-mean\" class=\"text-3xl font-bold text-indigo-700 mt-1\"></p>\n          <p class=\"text-xs text-slate-400 mt-1\">Summen delt på antallet</p>\n        </div>\n\n        <div class=\"result-card bg-white rounded-2xl border border-slate-100 shadow-sm p-5\">\n          <div class=\"flex items-center justify-between mb-1\">\n            <span class=\"text-xs font-semibold text-slate-400 uppercase tracking-wider\">Median</span>\n            <span class=\"tag-pill bg-teal-100 text-teal-700\">Md</span>\n          </div>\n          <p id=\"res-median\" class=\"text-3xl font-bold text-teal-700 mt-1\"></p>\n          <p class=\"text-xs text-slate-400 mt-1\">Midtverdien i sortert rekkefølge</p>\n        </div>\n\n        <div class=\"result-card bg-white rounded-2xl border border-slate-100 shadow-sm p-5\">\n          <div class=\"flex items-center justify-between mb-1\">\n            <span class=\"text-xs font-semibold text-slate-400 uppercase tracking-wider\">Typetall</span>\n            <span class=\"tag-pill bg-amber-100 text-amber-700\">Mo</span>\n          </div>\n          <p id=\"res-mode\" class=\"text-2xl font-bold text-amber-700 mt-1 leading-snug\"></p>\n          <p id=\"res-mode-note\" class=\"text-xs text-slate-400 mt-1\"></p>\n        </div>\n\n        <div class=\"result-card bg-white rounded-2xl border border-slate-100 shadow-sm p-5\">\n          <div class=\"flex items-center justify-between mb-1\">\n            <span class=\"text-xs font-semibold text-slate-400 uppercase tracking-wider\">Variasjonsbredde</span>\n            <span class=\"tag-pill bg-rose-100 text-rose-700\">V</span>\n          </div>\n          <p id=\"res-range\" class=\"text-3xl font-bold text-rose-700 mt-1\"></p>\n          <p class=\"text-xs text-slate-400 mt-1\">Største − minste verdi</p>\n        </div>\n\n        <div class=\"result-card bg-white rounded-2xl border border-slate-100 shadow-sm p-5 col-span-2 md:col-span-2\">\n          <div class=\"flex items-center justify-between mb-1\">\n            <span class=\"text-xs font-semibold text-slate-400 uppercase tracking-wider\">Standardavvik</span>\n            <span class=\"tag-pill bg-purple-100 text-purple-700\">σ</span>\n          </div>\n          <p id=\"res-std\" class=\"text-3xl font-bold text-purple-700 mt-1\"></p>\n          <p class=\"text-xs text-slate-400 mt-1\">Gjennomsnittlig avstand fra gjennomsnittet</p>\n        </div>\n\n      </div>\n\n      <!-- Standardavvik formula -->\n      <div class=\"bg-white rounded-2xl border border-slate-100 shadow-sm p-6\">\n        <h3 class=\"font-semibold text-slate-700 mb-3\">Formel: standardavvik (populasjonsformel, deler på <em>n</em>)</h3>\n        <div class=\"formula-box\">σ = √( (1/n) · Σ(xᵢ − x̄)² )</div>\n        <p class=\"text-sm text-slate-500 mt-2\">\n          I matematikk 2P bruker vi <strong>populasjonsstandardavviket</strong> (σ), der vi deler på\n          <em>n</em> (antall dataverdier). Dette er passende når datasettet representerer hele\n          populasjonen, eller i skolesammenheng der ikke annet er spesifisert.\n          (Merk: I statistikk for utvalg deler man i stedet på <em>n − 1</em> for å få et\n          forventningsrett estimat av populasjonens standardavvik.)\n        </p>\n        <div id=\"std-steps\" class=\"mt-4 text-sm text-slate-600 font-mono bg-slate-50 rounded-lg p-4 leading-relaxed overflow-x-auto\"></div>\n      </div>\n\n      <!-- Histogram -->\n      <div class=\"bg-white rounded-2xl border border-slate-100 shadow-sm p-6\">\n        <h3 class=\"font-semibold text-slate-700 mb-1\">Histogram</h3>\n        <p class=\"text-xs text-slate-400 mb-4\">\n          Den loddrette linjen viser <span class=\"text-indigo-600 font-semibold\">gjennomsnitt</span>\n          og <span class=\"text-teal-600 font-semibold\">median</span>.\n        </p>\n        <div id=\"histogram-container\" class=\"w-full overflow-x-auto\">\n          <svg id=\"histogram\" class=\"block mx-auto\"></svg>\n        </div>\n        <div id=\"histogram-legend\" class=\"flex flex-wrap gap-4 mt-3 text-xs text-slate-600 justify-center\"></div>\n      </div>\n\n      <!-- Sorted data -->\n      <div class=\"bg-white rounded-2xl border border-slate-100 shadow-sm p-6\">\n        <h3 class=\"font-semibold text-slate-700 mb-3\">Sorterte data</h3>\n        <div id=\"sorted-display\" class=\"flex flex-wrap gap-1.5 font-mono text-sm\"></div>\n      </div>\n\n      <!-- Explanations -->\n      <div class=\"bg-white rounded-2xl border border-slate-100 shadow-sm p-6 space-y-4\">\n        <h3 class=\"font-semibold text-slate-700 mb-2\">Hva forteller målene oss?</h3>\n\n        <div class=\"flex gap-3\">\n          <span class=\"tag-pill bg-indigo-100 text-indigo-700 self-start mt-0.5\">x̄</span>\n          <div>\n            <p class=\"font-semibold text-slate-700 text-sm\">Gjennomsnitt</p>\n            <p class=\"text-sm text-slate-500\">\n              Gjennomsnittet beskriver «typisk» verdi ved å fordele summen likt på alle.\n              Det er lett å tolke, men <strong class=\"text-rose-600\">sensitivt for uteliggere</strong>\n              (ekstreme verdier) — én stor avviker kan trekke gjennomsnittet langt i én retning.\n            </p>\n          </div>\n        </div>\n\n        <div class=\"flex gap-3\">\n          <span class=\"tag-pill bg-teal-100 text-teal-700 self-start mt-0.5\">Md</span>\n          <div>\n            <p class=\"font-semibold text-slate-700 text-sm\">Median</p>\n            <p class=\"text-sm text-slate-500\">\n              Medianen er verdien midt i det sorterte datasettet. Den er\n              <strong class=\"text-teal-700\">robust mot uteliggere</strong> og forteller hva\n              «halvparten over / halvparten under»-grensen er. Brukes gjerne om inntekt eller\n              boligpriser der noen ekstreme verdier finnes.\n            </p>\n          </div>\n        </div>\n\n        <div class=\"flex gap-3\">\n          <span class=\"tag-pill bg-amber-100 text-amber-700 self-start mt-0.5\">Mo</span>\n          <div>\n            <p class=\"font-semibold text-slate-700 text-sm\">Typetall (modus)</p>\n            <p class=\"text-sm text-slate-500\">\n              Typetallet er den verdien som forekommer oftest. Det er det eneste sentralmålet\n              som kan brukes på kategoriske data (f.eks. favorittfarge). Et datasett kan ha\n              ingen, ett eller flere typetall.\n            </p>\n          </div>\n        </div>\n\n        <div class=\"flex gap-3\">\n          <span class=\"tag-pill bg-rose-100 text-rose-700 self-start mt-0.5\">V</span>\n          <div>\n            <p class=\"font-semibold text-slate-700 text-sm\">Variasjonsbredde</p>\n            <p class=\"text-sm text-slate-500\">\n              Variasjonsbredden er forskjellen mellom den største og minste verdien i datasettet.\n              Det er det enkleste spredningsmålet, men tar kun hensyn til de to ytterste verdiene\n              og sier ingenting om fordelingen imellom.\n            </p>\n          </div>\n        </div>\n\n        <div class=\"flex gap-3\">\n          <span class=\"tag-pill bg-purple-100 text-purple-700 self-start mt-0.5\">σ</span>\n          <div>\n            <p class=\"font-semibold text-slate-700 text-sm\">Standardavvik</p>\n            <p class=\"text-sm text-slate-500\">\n              Standardavviket måler den gjennomsnittlige avstanden fra gjennomsnittet.\n              Et lavt standardavvik betyr at verdiene ligger tett rundt gjennomsnittet;\n              et høyt betyr stor spredning. Det brukes mye fordi det er i samme enhet som dataene.\n            </p>\n          </div>\n        </div>\n\n        <div class=\"mt-2 bg-amber-50 border border-amber-200 rounded-xl p-4\">\n          <p class=\"text-sm text-amber-800\">\n            <strong>Tips:</strong> Prøv «Med uteligger»-datasettet ovenfor og se hvordan\n            gjennomsnittet påvirkes av den ene ekstreme verdien (100), mens medianen forblir\n            nesten uendret. Dette illustrerer godt hvorfor median ofte er bedre egnet for\n            skjeve fordelinger.\n          </p>\n        </div>\n      </div>\n\n    </section>\n  </main>\n\n  <footer class=\"mt-12 py-6 text-center text-xs text-slate-400\">\n    Halison App Studio · Matematikk 2P (LK20) · Statistikk\n  </footer>\n\n<script>\n(function () {\n  'use strict';\n\n  // ─── DOM refs ────────────────────────────────────────────────────────────────\n  const inputEl      = document.getElementById('data-input');\n  const calcBtn      = document.getElementById('calc-btn');\n  const resetBtn     = document.getElementById('reset-btn');\n  const errorEl      = document.getElementById('error-msg');\n  const resultsEl    = document.getElementById('results-section');\n  const nLabel       = document.getElementById('n-label');\n  const nVal         = document.getElementById('n-val');\n\n  const resMean      = document.getElementById('res-mean');\n  const resMedian    = document.getElementById('res-median');\n  const resMode      = document.getElementById('res-mode');\n  const resModeNote  = document.getElementById('res-mode-note');\n  const resRange     = document.getElementById('res-range');\n  const resStd       = document.getElementById('res-std');\n  const stdSteps     = document.getElementById('std-steps');\n  const sortedDisp   = document.getElementById('sorted-display');\n  const histSvg      = document.getElementById('histogram');\n  const histLegend   = document.getElementById('histogram-legend');\n\n  // ─── Default dataset ────────────────────────────────────────────────────────\n  const DEFAULT = '12 15 14 10 18 12 16 14 13 15 11 17 14 13 16';\n\n  // Restore from localStorage or use default\n  inputEl.value = localStorage.getItem('stat2p-dataset') || DEFAULT;\n\n  // ─── Preset buttons ─────────────────────────────────────────────────────────\n  document.querySelectorAll('.preset-btn').forEach(btn => {\n    btn.addEventListener('click', () => {\n      inputEl.value = btn.dataset.set;\n      compute();\n    });\n  });\n\n  // ─── Parse input ────────────────────────────────────────────────────────────\n  function parseInput(raw) {\n    return raw\n      .split(/[\\s,;\\n]+/)\n      .map(s => s.trim())\n      .filter(s => s.length > 0)\n      .map(s => {\n        const n = parseFloat(s.replace(',', '.'));\n        if (isNaN(n)) throw new Error(`«${s}» er ikke et gyldig tall.`);\n        return n;\n      });\n  }\n\n  // ─── Statistics helpers ─────────────────────────────────────────────────────\n  function mean(arr) {\n    return arr.reduce((a, b) => a + b, 0) / arr.length;\n  }\n\n  function median(sorted) {\n    const n = sorted.length;\n    if (n % 2 === 1) return sorted[Math.floor(n / 2)];\n    return (sorted[n / 2 - 1] + sorted[n / 2]) / 2;\n  }\n\n  function mode(arr) {\n    const freq = {};\n    arr.forEach(v => { freq[v] = (freq[v] || 0) + 1; });\n    const maxFreq = Math.max(...Object.values(freq));\n    if (maxFreq === 1) return { values: [], freq: 1, none: true };\n    const modes = Object.keys(freq).filter(k => freq[k] === maxFreq).map(Number);\n    return { values: modes, freq: maxFreq, none: false };\n  }\n\n  function populationStd(arr, mu) {\n    const n = arr.length;\n    const sumSq = arr.reduce((acc, x) => acc + (x - mu) ** 2, 0);\n    return Math.sqrt(sumSq / n);\n  }\n\n  // ─── Number formatting ──────────────────────────────────────────────────────\n  function fmt(n, decimals = 2) {\n    if (Number.isInteger(n)) return n.toString();\n    return n.toFixed(decimals).replace('.', ',');\n  }\n\n  // ─── Show error ─────────────────────────────────────────────────────────────\n  function showError(msg) {\n    errorEl.style.display = 'block';\n    errorEl.textContent = msg;\n    resultsEl.classList.add('hidden');\n    nLabel.classList.add('hidden');\n  }\n  function clearError() {\n    errorEl.style.display = 'none';\n    errorEl.textContent = '';\n  }\n\n  // ─── Main compute ────────────────────────────────────────────────────────────\n  function compute() {\n    clearError();\n    let data;\n    try {\n      data = parseInput(inputEl.value);\n    } catch (e) {\n      showError('Ugyldig inndata: ' + e.message);\n      return;\n    }\n    if (data.length < 2) {\n      showError('Skriv inn minst 2 tall for å beregne statistikk.');\n      return;\n    }\n\n    // Save to localStorage\n    localStorage.setItem('stat2p-dataset', inputEl.value.trim());\n\n    const n = data.length;\n    const sorted = [...data].sort((a, b) => a - b);\n    const mu = mean(data);\n    const med = median(sorted);\n    const modeResult = mode(data);\n    const range = sorted[n - 1] - sorted[0];\n    const std = populationStd(data, mu);\n\n    // ── Cards ────────────────────────────────────────────────────────────────\n    resMean.textContent = fmt(mu);\n    resMedian.textContent = fmt(med);\n\n    if (modeResult.none) {\n      resMode.textContent = '—';\n      resModeNote.textContent = 'Ingen typetall (alle verdier er like hyppige)';\n    } else if (modeResult.values.length > 3) {\n      resMode.textContent = modeResult.values.slice(0, 3).map(v => fmt(v)).join(', ') + ' …';\n      resModeNote.textContent = `${modeResult.values.length} typetall (hyppighet: ${modeResult.freq})`;\n    } else {\n      resMode.textContent = modeResult.values.map(v => fmt(v)).join(', ');\n      resModeNote.textContent = modeResult.values.length > 1\n        ? `${modeResult.values.length} typetall (hyppighet: ${modeResult.freq})`\n        : `Hyppighet: ${modeResult.freq}`;\n    }\n\n    resRange.textContent = fmt(range);\n    resStd.textContent = fmt(std);\n\n    // ── Std steps ───────────────────────────────────────────────────────────\n    const deviations = data.map(x => x - mu);\n    const squaredDevs = deviations.map(d => d * d);\n    const sumSq = squaredDevs.reduce((a, b) => a + b, 0);\n\n    const showN = Math.min(n, 6);\n    let stepsHTML = `n = ${n}\\n`;\n    stepsHTML += `x̄ = ${fmt(mu)}\\n\\n`;\n    stepsHTML += `Kvadrerte avvik (xᵢ − x̄)²:\\n`;\n    for (let i = 0; i < showN; i++) {\n      stepsHTML += `  (${fmt(data[i])} − ${fmt(mu)})² = (${fmt(deviations[i])})² = ${fmt(squaredDevs[i])}\\n`;\n    }\n    if (n > showN) stepsHTML += `  … (${n - showN} flere)\\n`;\n    stepsHTML += `\\nΣ(xᵢ − x̄)² = ${fmt(sumSq)}\\n`;\n    stepsHTML += `σ = √(${fmt(sumSq)} / ${n}) = √${fmt(sumSq / n)} ≈ ${fmt(std)}`;\n\n    stdSteps.textContent = stepsHTML;\n\n    // ── Sorted display ───────────────────────────────────────────────────────\n    sortedDisp.innerHTML = '';\n    sorted.forEach((v, i) => {\n      const span = document.createElement('span');\n      span.className = 'px-2 py-0.5 rounded bg-slate-100 text-slate-700 text-xs font-mono border border-slate-200';\n      // Highlight median position(s)\n      const isMedianPos = (n % 2 === 1)\n        ? i === Math.floor(n / 2)\n        : (i === n / 2 - 1 || i === n / 2);\n      if (isMedianPos) {\n        span.className = 'px-2 py-0.5 rounded bg-teal-100 text-teal-800 text-xs font-mono border border-teal-300 font-bold';\n        span.title = 'Median-posisjon';\n      }\n      // Highlight mode values\n      if (!modeResult.none && modeResult.values.includes(v)) {\n        span.className = 'px-2 py-0.5 rounded bg-amber-100 text-amber-800 text-xs font-mono border border-amber-300 font-bold';\n        if (isMedianPos) {\n          span.className = 'px-2 py-0.5 rounded bg-purple-100 text-purple-800 text-xs font-mono border border-purple-300 font-bold';\n        }\n        span.title = 'Typetall';\n      }\n      span.textContent = fmt(v);\n      sortedDisp.appendChild(span);\n    });\n\n    // ── Histogram ────────────────────────────────────────────────────────────\n    drawHistogram(sorted, mu, med);\n\n    nVal.textContent = n;\n    nLabel.classList.remove('hidden');\n    resultsEl.classList.remove('hidden');\n    resultsEl.scrollIntoView({ behavior: 'smooth', block: 'start' });\n  }\n\n  // ─── Histogram drawing ───────────────────────────────────────────────────────\n  function drawHistogram(sorted, mu, med) {\n    const n = sorted.length;\n    const minVal = sorted[0];\n    const maxVal = sorted[n - 1];\n\n    // Determine bins\n    let bins;\n    const allIntegers = sorted.every(v => Number.isInteger(v));\n    const distinctVals = [...new Set(sorted)].sort((a, b) => a - b);\n\n    if (allIntegers && distinctVals.length <= 20) {\n      // One bar per distinct integer value\n      bins = distinctVals.map(v => ({\n        label: String(v),\n        from: v - 0.5,\n        to: v + 0.5,\n        count: sorted.filter(x => x === v).length,\n        center: v\n      }));\n    } else {\n      // Sturges' rule for bin count\n      const numBins = Math.max(5, Math.min(15, Math.ceil(Math.log2(n) + 1)));\n      const span = maxVal - minVal;\n      const binWidth = span === 0 ? 1 : span / numBins;\n      const binsArr = [];\n      for (let i = 0; i < numBins; i++) {\n        const from = minVal + i * binWidth;\n        const to = i === numBins - 1 ? maxVal + 1e-9 : from + binWidth;\n        const count = sorted.filter(x => x >= from && x < to).length;\n        binsArr.push({\n          label: `${fmt(from)}–${fmt(from + binWidth)}`,\n          from, to,\n          count,\n          center: from + binWidth / 2\n        });\n      }\n      bins = binsArr.filter(b => b.count > 0 || true); // keep all bins for axis continuity\n    }\n\n    const maxCount = Math.max(...bins.map(b => b.count), 1);\n\n    // SVG dimensions\n    const svgW = Math.max(400, Math.min(760, bins.length * 48 + 80));\n    const svgH = 280;\n    const padLeft = 44;\n    const padRight = 20;\n    const padTop = 20;\n    const padBottom = 54;\n    const chartW = svgW - padLeft - padRight;\n    const chartH = svgH - padTop - padBottom;\n    const barW = chartW / bins.length;\n\n    histSvg.setAttribute('width', svgW);\n    histSvg.setAttribute('height', svgH);\n    histSvg.setAttribute('viewBox', `0 0 ${svgW} ${svgH}`);\n\n    let svgContent = '';\n\n    // Grid lines\n    const yTicks = 4;\n    for (let i = 0; i <= yTicks; i++) {\n      const y = padTop + chartH - (i / yTicks) * chartH;\n      const val = Math.round((i / yTicks) * maxCount);\n      svgContent += `<line x1=\"${padLeft}\" y1=\"${y}\" x2=\"${padLeft + chartW}\" y2=\"${y}\" stroke=\"#e2e8f0\" stroke-width=\"1\"/>`;\n      svgContent += `<text x=\"${padLeft - 6}\" y=\"${y + 4}\" text-anchor=\"end\" font-size=\"11\" fill=\"#94a3b8\">${val}</text>`;\n    }\n\n    // Bars\n    bins.forEach((bin, i) => {\n      const barH = (bin.count / maxCount) * chartH;\n      const x = padLeft + i * barW;\n      const y = padTop + chartH - barH;\n      const color = '#818cf8';\n      const colorDark = '#6366f1';\n      svgContent += `<rect class=\"hist-bar\" x=\"${x + 1}\" y=\"${y}\" width=\"${barW - 2}\" height=\"${barH}\"\n        fill=\"${color}\" stroke=\"${colorDark}\" stroke-width=\"0.5\" rx=\"2\"/>`;\n\n      // Count label on bar\n      if (bin.count > 0) {\n        svgContent += `<text x=\"${x + barW / 2}\" y=\"${y - 4}\" text-anchor=\"middle\" font-size=\"10\" fill=\"#6366f1\" font-weight=\"600\">${bin.count}</text>`;\n      }\n    });\n\n    // X-axis labels\n    // For many bins, show every Nth label\n    const showEvery = bins.length > 10 ? Math.ceil(bins.length / 10) : 1;\n    bins.forEach((bin, i) => {\n      if (i % showEvery !== 0 && i !== bins.length - 1) return;\n      const x = padLeft + i * barW + barW / 2;\n      const y = padTop + chartH + 16;\n      svgContent += `<text x=\"${x}\" y=\"${y}\" text-anchor=\"middle\" font-size=\"10\" fill=\"#64748b\"\n        transform=\"rotate(-30, ${x}, ${y})\">${bin.label}</text>`;\n    });\n\n    // X and Y axis lines\n    svgContent += `<line x1=\"${padLeft}\" y1=\"${padTop}\" x2=\"${padLeft}\" y2=\"${padTop + chartH}\" stroke=\"#cbd5e1\" stroke-width=\"1.5\"/>`;\n    svgContent += `<line x1=\"${padLeft}\" y1=\"${padTop + chartH}\" x2=\"${padLeft + chartW}\" y2=\"${padTop + chartH}\" stroke=\"#cbd5e1\" stroke-width=\"1.5\"/>`;\n\n    // Helper: map data value to x pixel\n    function valToX(v) {\n      if (bins.length === 0) return padLeft;\n      const dataMin = bins[0].from;\n      const dataMax = bins[bins.length - 1].to;\n      return padLeft + ((v - dataMin) / (dataMax - dataMin)) * chartW;\n    }\n\n    // Mean line\n    const meanX = valToX(mu);\n    svgContent += `<line x1=\"${meanX}\" y1=\"${padTop}\" x2=\"${meanX}\" y2=\"${padTop + chartH}\"\n      stroke=\"#6366f1\" stroke-width=\"2\" stroke-dasharray=\"5,3\"/>`;\n    svgContent += `<text x=\"${meanX + 4}\" y=\"${padTop + 14}\" font-size=\"11\" fill=\"#6366f1\" font-weight=\"700\">x̄ = ${fmt(mu)}</text>`;\n\n    // Median line\n    const medX = valToX(med);\n    const medOffset = Math.abs(meanX - medX) < 30 ? 16 : 0;\n    svgContent += `<line x1=\"${medX}\" y1=\"${padTop}\" x2=\"${medX}\" y2=\"${padTop + chartH}\"\n      stroke=\"#0d9488\" stroke-width=\"2\" stroke-dasharray=\"3,3\"/>`;\n    svgContent += `<text x=\"${medX + 4}\" y=\"${padTop + 14 + medOffset}\" font-size=\"11\" fill=\"#0d9488\" font-weight=\"700\">Md = ${fmt(med)}</text>`;\n\n    histSvg.innerHTML = svgContent;\n\n    // Legend\n    histLegend.innerHTML = `\n      <span class=\"flex items-center gap-1.5\">\n        <svg width=\"22\" height=\"10\"><line x1=\"0\" y1=\"5\" x2=\"22\" y2=\"5\" stroke=\"#6366f1\" stroke-width=\"2\" stroke-dasharray=\"5,3\"/></svg>\n        <span class=\"text-indigo-700 font-semibold\">Gjennomsnitt (x̄ = ${fmt(mu)})</span>\n      </span>\n      <span class=\"flex items-center gap-1.5\">\n        <svg width=\"22\" height=\"10\"><line x1=\"0\" y1=\"5\" x2=\"22\" y2=\"5\" stroke=\"#0d9488\" stroke-width=\"2\" stroke-dasharray=\"3,3\"/></svg>\n        <span class=\"text-teal-700 font-semibold\">Median (Md = ${fmt(med)})</span>\n      </span>`;\n  }\n\n  // ─── Event listeners ─────────────────────────────────────────────────────────\n  calcBtn.addEventListener('click', compute);\n\n  inputEl.addEventListener('keydown', e => {\n    if (e.key === 'Enter' && e.ctrlKey) compute();\n  });\n\n  resetBtn.addEventListener('click', () => {\n    inputEl.value = DEFAULT;\n    localStorage.removeItem('stat2p-dataset');\n    clearError();\n    resultsEl.classList.add('hidden');\n    nLabel.classList.add('hidden');\n  });\n\n  // ─── Auto-compute on load ────────────────────────────────────────────────────\n  compute();\n\n}());\n</script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Statistikk",
    "windowTitle": "Statistikk",
    "bundleId": "com.halisonworks.statistikk",
    "iconPath": null
  },
