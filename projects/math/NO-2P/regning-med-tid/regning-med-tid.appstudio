{
  "schema": "app-studio/canvas@1",
  "id": "example-no2p-regningmedtid",
  "name": "regning-med-tid.html",
  "code": "<!DOCTYPE html>\n<!--\n  Regning med tid — Halison App Studio-eksempel\n\n  Interaktivt læremiddel for matematikk 2P (LK20): klokkeslett og tidsdifferanser,\n  omgjøring mellom tidsenheter, og fart = strekning / tid.\n\n  Fra Halison App Studio sitt offentlige bibliotek:\n  https://github.com/halisonworks/public-app-studio\n\n  Tillatt bruk: personlig, pedagogisk og annen ikke-kommersiell bruk. Behold denne\n  headeren og kildelenken; ikke-kommersiell bruk. Utgitt under Halison App Studio\n  Examples License — se LICENSE-filen i repoet over.\n-->\n<html lang=\"no\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Regning med tid – Matematikk 2P</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    .tab-btn.active {\n      background-color: #1d4ed8;\n      color: #fff;\n    }\n    .step-box {\n      border-left: 4px solid #3b82f6;\n      background: #eff6ff;\n      padding: 0.75rem 1rem;\n      margin-top: 0.5rem;\n      border-radius: 0 0.375rem 0.375rem 0;\n    }\n    .result-box {\n      background: #f0fdf4;\n      border: 1px solid #86efac;\n      border-radius: 0.5rem;\n      padding: 1rem;\n      margin-top: 0.75rem;\n    }\n    .error-box {\n      background: #fef2f2;\n      border: 1px solid #fca5a5;\n      border-radius: 0.5rem;\n      padding: 1rem;\n      margin-top: 0.75rem;\n    }\n    .note-box {\n      background: #fefce8;\n      border: 1px solid #fde047;\n      border-radius: 0.5rem;\n      padding: 0.75rem 1rem;\n      margin-top: 0.75rem;\n      font-size: 0.9rem;\n    }\n    input[type=number], input[type=time], select {\n      border: 1px solid #d1d5db;\n      border-radius: 0.375rem;\n      padding: 0.4rem 0.6rem;\n      font-size: 1rem;\n    }\n    input[type=number]:focus, input[type=time]:focus, select:focus {\n      outline: 2px solid #3b82f6;\n    }\n    .formula-box {\n      font-family: 'Courier New', monospace;\n      background: #f8fafc;\n      border: 1px solid #cbd5e1;\n      border-radius: 0.375rem;\n      padding: 0.5rem 1rem;\n      display: inline-block;\n      margin: 0.25rem 0;\n    }\n  </style>\n</head>\n<body class=\"bg-gray-50 min-h-screen font-sans\">\n\n  <!-- Header -->\n  <header class=\"bg-blue-700 text-white py-5 px-4 shadow-md\">\n    <div class=\"max-w-3xl mx-auto\">\n      <h1 class=\"text-2xl font-bold\">Regning med tid</h1>\n      <p class=\"text-blue-200 text-sm mt-1\">Matematikk 2P · LK20 · Sinus 2P kap. 1.5</p>\n    </div>\n  </header>\n\n  <!-- Tab navigation -->\n  <nav class=\"bg-white border-b border-gray-200 sticky top-0 z-10 shadow-sm\">\n    <div class=\"max-w-3xl mx-auto flex flex-wrap gap-1 px-4 py-2\">\n      <button class=\"tab-btn active px-3 py-1.5 rounded text-sm font-medium border border-blue-700 transition-colors\"\n        onclick=\"showTab('tidsdiff')\">Tidsdifferanse</button>\n      <button class=\"tab-btn px-3 py-1.5 rounded text-sm font-medium border border-gray-300 transition-colors\"\n        onclick=\"showTab('omgjoring')\">Omgjøring</button>\n      <button class=\"tab-btn px-3 py-1.5 rounded text-sm font-medium border border-gray-300 transition-colors\"\n        onclick=\"showTab('fart')\">Fart · strekning · tid</button>\n    </div>\n  </nav>\n\n  <main class=\"max-w-3xl mx-auto px-4 py-6 space-y-6\">\n\n    <!-- ============================================================\n         TAB 1: Tidsdifferanse\n    ============================================================ -->\n    <section id=\"tab-tidsdiff\">\n\n      <!-- Section A: Beregn varighet -->\n      <div class=\"bg-white rounded-xl shadow p-5\">\n        <h2 class=\"text-lg font-bold text-blue-800 mb-1\">Tidsdifferanse: beregn varighet</h2>\n        <p class=\"text-gray-600 text-sm mb-4\">\n          Oppgi start- og sluttklokkeslett, og du får varigheten i timer og minutter.\n          Funksjonen håndterer overgang over midnatt.\n        </p>\n\n        <div class=\"grid grid-cols-2 gap-4 max-w-sm\">\n          <div>\n            <label class=\"block text-sm font-medium text-gray-700 mb-1\">Starttidspunkt</label>\n            <input type=\"time\" id=\"td-start\" value=\"08:15\" class=\"w-full\" />\n          </div>\n          <div>\n            <label class=\"block text-sm font-medium text-gray-700 mb-1\">Sluttidspunkt</label>\n            <input type=\"time\" id=\"td-slutt\" value=\"11:45\" class=\"w-full\" />\n          </div>\n        </div>\n\n        <button onclick=\"beregnVarighet()\"\n          class=\"mt-4 bg-blue-700 text-white px-5 py-2 rounded-lg font-medium hover:bg-blue-800 transition-colors\">\n          Beregn varighet\n        </button>\n        <div id=\"td-result\"></div>\n      </div>\n\n      <!-- Section B: Legg til / trekk fra tid -->\n      <div class=\"bg-white rounded-xl shadow p-5\">\n        <h2 class=\"text-lg font-bold text-blue-800 mb-1\">Legg til eller trekk fra tid</h2>\n        <p class=\"text-gray-600 text-sm mb-4\">\n          Finn et nytt klokkeslett ved å legge til eller trekke fra et antall timer og minutter.\n        </p>\n\n        <div class=\"grid grid-cols-1 sm:grid-cols-3 gap-4 max-w-lg\">\n          <div>\n            <label class=\"block text-sm font-medium text-gray-700 mb-1\">Starttidspunkt</label>\n            <input type=\"time\" id=\"lt-start\" value=\"14:30\" class=\"w-full\" />\n          </div>\n          <div>\n            <label class=\"block text-sm font-medium text-gray-700 mb-1\">Timer (t)</label>\n            <input type=\"number\" id=\"lt-timer\" value=\"2\" min=\"0\" max=\"23\" class=\"w-full\" />\n          </div>\n          <div>\n            <label class=\"block text-sm font-medium text-gray-700 mb-1\">Minutter (min)</label>\n            <input type=\"number\" id=\"lt-minutter\" value=\"45\" min=\"0\" max=\"59\" class=\"w-full\" />\n          </div>\n        </div>\n\n        <div class=\"mt-3 flex gap-3 flex-wrap\">\n          <button onclick=\"leggTilTid(1)\"\n            class=\"bg-green-600 text-white px-4 py-2 rounded-lg font-medium hover:bg-green-700 transition-colors\">\n            + Legg til\n          </button>\n          <button onclick=\"leggTilTid(-1)\"\n            class=\"bg-orange-500 text-white px-4 py-2 rounded-lg font-medium hover:bg-orange-600 transition-colors\">\n            − Trekk fra\n          </button>\n        </div>\n        <div id=\"lt-result\"></div>\n      </div>\n\n    </section>\n\n    <!-- ============================================================\n         TAB 2: Omgjøring\n    ============================================================ -->\n    <section id=\"tab-omgjoring\" class=\"hidden\">\n\n      <!-- Forklaring -->\n      <div class=\"bg-white rounded-xl shadow p-5\">\n        <h2 class=\"text-lg font-bold text-blue-800 mb-2\">Hvorfor deler vi på 60?</h2>\n        <p class=\"text-gray-700 text-sm leading-relaxed\">\n          En time er delt inn i <strong>60 minutter</strong>, og ett minutt er delt inn i\n          <strong>60 sekunder</strong>. Det betyr at relasjonen mellom enhetene alltid handler om 60:\n        </p>\n        <div class=\"mt-3 space-y-1 text-sm\">\n          <div class=\"formula-box\">1 time = 60 min</div><br/>\n          <div class=\"formula-box\">1 min = 60 sek</div><br/>\n          <div class=\"formula-box\">1 time = 3 600 sek</div>\n        </div>\n        <p class=\"text-gray-700 text-sm mt-3 leading-relaxed\">\n          For å konvertere <em>minutter til timer</em> deler vi på 60:\n          <br/>\n          <span class=\"font-mono font-bold\">45 min ÷ 60 = 0,75 t</span>\n          <br/>\n          For å konvertere <em>desimaltimer til minutter</em> ganger vi desimaldelen med 60:\n          <br/>\n          <span class=\"font-mono font-bold\">0,75 t × 60 = 45 min</span>\n        </p>\n      </div>\n\n      <!-- Omgjøringsverktøy -->\n      <div class=\"bg-white rounded-xl shadow p-5\">\n        <h2 class=\"text-lg font-bold text-blue-800 mb-3\">Omgjøringsverktøy</h2>\n\n        <div class=\"flex gap-3 flex-wrap mb-4\">\n          <button onclick=\"setOmgjMode('desimal2hm')\"\n            id=\"btn-d2hm\"\n            class=\"px-3 py-1.5 rounded border text-sm font-medium bg-blue-700 text-white border-blue-700 transition-colors\">\n            Desimaltimer → t:min\n          </button>\n          <button onclick=\"setOmgjMode('hm2desimal')\"\n            id=\"btn-hm2d\"\n            class=\"px-3 py-1.5 rounded border text-sm font-medium border-gray-300 text-gray-700 transition-colors\">\n            t:min → Desimaltimer\n          </button>\n          <button onclick=\"setOmgjMode('sek2min')\"\n            id=\"btn-s2m\"\n            class=\"px-3 py-1.5 rounded border text-sm font-medium border-gray-300 text-gray-700 transition-colors\">\n            Sekunder → min:sek\n          </button>\n          <button onclick=\"setOmgjMode('min2sek')\"\n            id=\"btn-m2s\"\n            class=\"px-3 py-1.5 rounded border text-sm font-medium border-gray-300 text-gray-700 transition-colors\">\n            min:sek → Sekunder\n          </button>\n        </div>\n\n        <!-- Desimaltimer → t:min -->\n        <div id=\"omgj-desimal2hm\">\n          <label class=\"block text-sm font-medium text-gray-700 mb-1\">Desimaltimer (t)</label>\n          <input type=\"number\" id=\"og-desimal\" value=\"2.5\" step=\"0.01\" min=\"0\" class=\"w-40\" />\n          <button onclick=\"omgjorDesimal2HM()\"\n            class=\"ml-3 bg-blue-700 text-white px-4 py-1.5 rounded-lg font-medium hover:bg-blue-800 text-sm transition-colors\">\n            Konverter\n          </button>\n          <div id=\"og-d2hm-result\"></div>\n        </div>\n\n        <!-- t:min → Desimaltimer -->\n        <div id=\"omgj-hm2desimal\" class=\"hidden\">\n          <div class=\"flex gap-3 flex-wrap items-end\">\n            <div>\n              <label class=\"block text-sm font-medium text-gray-700 mb-1\">Timer (t)</label>\n              <input type=\"number\" id=\"og-hm-timer\" value=\"1\" min=\"0\" class=\"w-24\" />\n            </div>\n            <div>\n              <label class=\"block text-sm font-medium text-gray-700 mb-1\">Minutter (min)</label>\n              <input type=\"number\" id=\"og-hm-min\" value=\"45\" min=\"0\" max=\"59\" class=\"w-24\" />\n            </div>\n            <button onclick=\"omgjorHM2Desimal()\"\n              class=\"bg-blue-700 text-white px-4 py-1.5 rounded-lg font-medium hover:bg-blue-800 text-sm transition-colors\">\n              Konverter\n            </button>\n          </div>\n          <div id=\"og-hm2d-result\"></div>\n        </div>\n\n        <!-- Sekunder → min:sek -->\n        <div id=\"omgj-sek2min\" class=\"hidden\">\n          <label class=\"block text-sm font-medium text-gray-700 mb-1\">Totalt antall sekunder</label>\n          <input type=\"number\" id=\"og-sek\" value=\"385\" min=\"0\" class=\"w-40\" />\n          <button onclick=\"omgjorSek2Min()\"\n            class=\"ml-3 bg-blue-700 text-white px-4 py-1.5 rounded-lg font-medium hover:bg-blue-800 text-sm transition-colors\">\n            Konverter\n          </button>\n          <div id=\"og-s2m-result\"></div>\n        </div>\n\n        <!-- min:sek → Sekunder -->\n        <div id=\"omgj-min2sek\" class=\"hidden\">\n          <div class=\"flex gap-3 flex-wrap items-end\">\n            <div>\n              <label class=\"block text-sm font-medium text-gray-700 mb-1\">Minutter (min)</label>\n              <input type=\"number\" id=\"og-ms-min\" value=\"6\" min=\"0\" class=\"w-24\" />\n            </div>\n            <div>\n              <label class=\"block text-sm font-medium text-gray-700 mb-1\">Sekunder (sek)</label>\n              <input type=\"number\" id=\"og-ms-sek\" value=\"25\" min=\"0\" max=\"59\" class=\"w-24\" />\n            </div>\n            <button onclick=\"omgjorMin2Sek()\"\n              class=\"bg-blue-700 text-white px-4 py-1.5 rounded-lg font-medium hover:bg-blue-800 text-sm transition-colors\">\n              Konverter\n            </button>\n          </div>\n          <div id=\"og-m2s-result\"></div>\n        </div>\n\n      </div>\n\n      <!-- Eksempler med fasit -->\n      <div class=\"bg-white rounded-xl shadow p-5\">\n        <h2 class=\"text-lg font-bold text-blue-800 mb-3\">Eksempler fra hverdagen</h2>\n        <div class=\"space-y-4 text-sm text-gray-700\">\n\n          <div class=\"step-box\">\n            <p class=\"font-semibold text-gray-800\">Eksempel 1: Sykkeltur på 2,5 timer</p>\n            <p class=\"mt-1\">Kari syklet i 2,5 timer. Hvor lenge er det i timer og minutter?</p>\n            <p class=\"mt-2 font-mono\">2,5 t = 2 t + 0,5 t</p>\n            <p class=\"font-mono\">0,5 t × 60 = 30 min</p>\n            <p class=\"mt-1 font-bold text-green-700\">Svar: 2 timer 30 minutter</p>\n          </div>\n\n          <div class=\"step-box\">\n            <p class=\"font-semibold text-gray-800\">Eksempel 2: Busstur på 1 t 45 min</p>\n            <p class=\"mt-1\">En busstur varer 1 time og 45 minutter. Hva er dette i desimaltimer?</p>\n            <p class=\"mt-2 font-mono\">45 min ÷ 60 = 0,75 t</p>\n            <p class=\"font-mono\">1 + 0,75 = 1,75 t</p>\n            <p class=\"mt-1 font-bold text-green-700\">Svar: 1,75 timer</p>\n          </div>\n\n          <div class=\"step-box\">\n            <p class=\"font-semibold text-gray-800\">Eksempel 3: 385 sekunder i min:sek</p>\n            <p class=\"mt-1\">En 400-meter løper brukte 385 sekunder. Skriv det som minutter og sekunder.</p>\n            <p class=\"mt-2 font-mono\">385 ÷ 60 = 6 (hele minutter) med rest</p>\n            <p class=\"font-mono\">6 × 60 = 360</p>\n            <p class=\"font-mono\">385 − 360 = 25 sek</p>\n            <p class=\"mt-1 font-bold text-green-700\">Svar: 6 min 25 sek</p>\n          </div>\n\n        </div>\n      </div>\n\n    </section>\n\n    <!-- ============================================================\n         TAB 3: Fart, strekning, tid\n    ============================================================ -->\n    <section id=\"tab-fart\" class=\"hidden\">\n\n      <!-- Formelkort -->\n      <div class=\"bg-white rounded-xl shadow p-5\">\n        <h2 class=\"text-lg font-bold text-blue-800 mb-3\">Formlene</h2>\n        <div class=\"grid grid-cols-1 sm:grid-cols-3 gap-3 text-center text-sm\">\n          <div class=\"formula-box w-full\">s = v · t</div>\n          <div class=\"formula-box w-full\">v = s / t</div>\n          <div class=\"formula-box w-full\">t = s / v</div>\n        </div>\n        <p class=\"text-gray-600 text-sm mt-3\">\n          <strong>s</strong> = strekning &nbsp;|&nbsp;\n          <strong>v</strong> = fart (hastighet) &nbsp;|&nbsp;\n          <strong>t</strong> = tid\n        </p>\n\n        <div class=\"note-box mt-3\">\n          <p class=\"font-semibold text-yellow-800\">Enhetsoversikt og konvertering km/h ↔ m/s</p>\n          <ul class=\"list-disc list-inside mt-1 space-y-1 text-gray-700\">\n            <li>1 km = 1 000 m</li>\n            <li>1 time = 3 600 sek</li>\n            <li>km/h → m/s: <span class=\"font-mono\">÷ 3,6</span> &nbsp; (f.eks. 72 km/h ÷ 3,6 = 20 m/s)</li>\n            <li>m/s → km/h: <span class=\"font-mono\">× 3,6</span> &nbsp; (f.eks. 20 m/s × 3,6 = 72 km/h)</li>\n          </ul>\n          <p class=\"mt-1 text-xs text-gray-500\">Hvorfor 3,6? Fordi 1 km/h = 1 000 m / 3 600 sek = 1/3,6 m/s.</p>\n        </div>\n      </div>\n\n      <!-- Kalkulator -->\n      <div class=\"bg-white rounded-xl shadow p-5\">\n        <h2 class=\"text-lg font-bold text-blue-800 mb-3\">Kalkulator: velg hva du vil finne</h2>\n\n        <div class=\"flex gap-3 flex-wrap mb-5\">\n          <button onclick=\"setFartMode('strekning')\"\n            id=\"btn-fs\" class=\"px-3 py-1.5 rounded border text-sm font-medium bg-blue-700 text-white border-blue-700 transition-colors\">\n            Finn strekning (s)\n          </button>\n          <button onclick=\"setFartMode('fart')\"\n            id=\"btn-fv\" class=\"px-3 py-1.5 rounded border text-sm font-medium border-gray-300 text-gray-700 transition-colors\">\n            Finn fart (v)\n          </button>\n          <button onclick=\"setFartMode('tid')\"\n            id=\"btn-ft\" class=\"px-3 py-1.5 rounded border text-sm font-medium border-gray-300 text-gray-700 transition-colors\">\n            Finn tid (t)\n          </button>\n        </div>\n\n        <!-- Finn strekning -->\n        <div id=\"fart-strekning\">\n          <p class=\"text-sm text-gray-600 mb-3 italic\">s = v · t &nbsp; → &nbsp; Oppgi fart og tid.</p>\n          <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-md\">\n            <div>\n              <label class=\"block text-sm font-medium text-gray-700 mb-1\">Fart (v)</label>\n              <div class=\"flex gap-2\">\n                <input type=\"number\" id=\"fs-v\" value=\"80\" min=\"0\" step=\"any\" class=\"w-24\" />\n                <select id=\"fs-v-enhet\" class=\"flex-1\">\n                  <option value=\"kmh\">km/h</option>\n                  <option value=\"ms\">m/s</option>\n                </select>\n              </div>\n            </div>\n            <div>\n              <label class=\"block text-sm font-medium text-gray-700 mb-1\">Tid (t)</label>\n              <div class=\"flex gap-2\">\n                <input type=\"number\" id=\"fs-t\" value=\"2.5\" min=\"0\" step=\"any\" class=\"w-24\" />\n                <select id=\"fs-t-enhet\" class=\"flex-1\">\n                  <option value=\"timer\">timer</option>\n                  <option value=\"min\">minutter</option>\n                  <option value=\"sek\">sekunder</option>\n                </select>\n              </div>\n            </div>\n          </div>\n          <button onclick=\"beregnStrekning()\"\n            class=\"mt-4 bg-blue-700 text-white px-5 py-2 rounded-lg font-medium hover:bg-blue-800 transition-colors\">\n            Beregn strekning\n          </button>\n          <div id=\"fs-result\"></div>\n        </div>\n\n        <!-- Finn fart -->\n        <div id=\"fart-fart\" class=\"hidden\">\n          <p class=\"text-sm text-gray-600 mb-3 italic\">v = s / t &nbsp; → &nbsp; Oppgi strekning og tid.</p>\n          <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-md\">\n            <div>\n              <label class=\"block text-sm font-medium text-gray-700 mb-1\">Strekning (s)</label>\n              <div class=\"flex gap-2\">\n                <input type=\"number\" id=\"fv-s\" value=\"200\" min=\"0\" step=\"any\" class=\"w-24\" />\n                <select id=\"fv-s-enhet\" class=\"flex-1\">\n                  <option value=\"km\">km</option>\n                  <option value=\"m\">m</option>\n                </select>\n              </div>\n            </div>\n            <div>\n              <label class=\"block text-sm font-medium text-gray-700 mb-1\">Tid (t)</label>\n              <div class=\"flex gap-2\">\n                <input type=\"number\" id=\"fv-t\" value=\"2.5\" min=\"0\" step=\"any\" class=\"w-24\" />\n                <select id=\"fv-t-enhet\" class=\"flex-1\">\n                  <option value=\"timer\">timer</option>\n                  <option value=\"min\">minutter</option>\n                  <option value=\"sek\">sekunder</option>\n                </select>\n              </div>\n            </div>\n          </div>\n          <button onclick=\"beregnFart()\"\n            class=\"mt-4 bg-blue-700 text-white px-5 py-2 rounded-lg font-medium hover:bg-blue-800 transition-colors\">\n            Beregn fart\n          </button>\n          <div id=\"fv-result\"></div>\n        </div>\n\n        <!-- Finn tid -->\n        <div id=\"fart-tid\" class=\"hidden\">\n          <p class=\"text-sm text-gray-600 mb-3 italic\">t = s / v &nbsp; → &nbsp; Oppgi strekning og fart.</p>\n          <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-md\">\n            <div>\n              <label class=\"block text-sm font-medium text-gray-700 mb-1\">Strekning (s)</label>\n              <div class=\"flex gap-2\">\n                <input type=\"number\" id=\"ft-s\" value=\"300\" min=\"0\" step=\"any\" class=\"w-24\" />\n                <select id=\"ft-s-enhet\" class=\"flex-1\">\n                  <option value=\"km\">km</option>\n                  <option value=\"m\">m</option>\n                </select>\n              </div>\n            </div>\n            <div>\n              <label class=\"block text-sm font-medium text-gray-700 mb-1\">Fart (v)</label>\n              <div class=\"flex gap-2\">\n                <input type=\"number\" id=\"ft-v\" value=\"120\" min=\"0\" step=\"any\" class=\"w-24\" />\n                <select id=\"ft-v-enhet\" class=\"flex-1\">\n                  <option value=\"kmh\">km/h</option>\n                  <option value=\"ms\">m/s</option>\n                </select>\n              </div>\n            </div>\n          </div>\n          <button onclick=\"beregnTid()\"\n            class=\"mt-4 bg-blue-700 text-white px-5 py-2 rounded-lg font-medium hover:bg-blue-800 transition-colors\">\n            Beregn tid\n          </button>\n          <div id=\"ft-result\"></div>\n        </div>\n\n      </div>\n\n      <!-- Eksempler -->\n      <div class=\"bg-white rounded-xl shadow p-5\">\n        <h2 class=\"text-lg font-bold text-blue-800 mb-3\">Løste eksempler</h2>\n        <div class=\"space-y-4 text-sm text-gray-700\">\n\n          <div class=\"step-box\">\n            <p class=\"font-semibold text-gray-800\">Eksempel 1: Hvor langt kjørte Ola?</p>\n            <p class=\"mt-1\">Ola kjørte med 80 km/h i 2,5 timer på E6. Hva er strekningen?</p>\n            <p class=\"mt-2 font-mono\">s = v · t</p>\n            <p class=\"font-mono\">s = 80 km/h · 2,5 t</p>\n            <p class=\"font-mono\">s = 200 km</p>\n            <p class=\"mt-1 font-bold text-green-700\">Svar: 200 km</p>\n          </div>\n\n          <div class=\"step-box\">\n            <p class=\"font-semibold text-gray-800\">Eksempel 2: Hva var farten?</p>\n            <p class=\"mt-1\">Toget tilbakela 432 km på 2 timer og 24 minutter. Hva var gjennomsnittsfarten i km/h?</p>\n            <p class=\"mt-2 font-mono\">2 t 24 min = 2 + 24/60 t = 2,4 t</p>\n            <p class=\"font-mono\">v = s / t = 432 / 2,4</p>\n            <p class=\"font-mono\">v = 180 km/h</p>\n            <p class=\"mt-1 font-bold text-green-700\">Svar: 180 km/h</p>\n          </div>\n\n          <div class=\"step-box\">\n            <p class=\"font-semibold text-gray-800\">Eksempel 3: Omregning av enheter</p>\n            <p class=\"mt-1\">En spurt-løper har toppfart 10 m/s. Hva er det i km/h?</p>\n            <p class=\"mt-2 font-mono\">10 m/s × 3,6 = 36 km/h</p>\n            <p class=\"mt-1 font-bold text-green-700\">Svar: 36 km/h</p>\n          </div>\n\n          <div class=\"step-box\">\n            <p class=\"font-semibold text-gray-800\">Eksempel 4: Finn tida</p>\n            <p class=\"mt-1\">Ingrid skal sykle 45 km med en gjennomsnittsfart på 18 km/h. Hvor lang tid bruker hun?</p>\n            <p class=\"mt-2 font-mono\">t = s / v = 45 / 18 = 2,5 t</p>\n            <p class=\"font-mono\">0,5 t × 60 = 30 min</p>\n            <p class=\"mt-1 font-bold text-green-700\">Svar: 2 timer 30 minutter</p>\n          </div>\n\n        </div>\n      </div>\n\n    </section>\n\n  </main>\n\n  <footer class=\"text-center text-xs text-gray-400 py-6 px-4\">\n    Matematikk 2P · LK20 · Sinus 2P kap. 1.5 · Halison App Studio-eksempel ·\n    <a href=\"https://github.com/halisonworks/public-app-studio\" class=\"underline hover:text-gray-600\">GitHub</a>\n  </footer>\n\n<script>\n  // =====================================================================\n  // Tab management\n  // =====================================================================\n  const TABS = ['tidsdiff', 'omgjoring', 'fart'];\n\n  function showTab(name) {\n    TABS.forEach(function(t) {\n      var el = document.getElementById('tab-' + t);\n      if (el) el.classList.toggle('hidden', t !== name);\n    });\n    document.querySelectorAll('.tab-btn').forEach(function(btn) {\n      btn.classList.remove('active', 'bg-blue-700', 'text-white', 'border-blue-700');\n      btn.classList.add('border-gray-300', 'text-gray-700');\n    });\n    var btns = document.querySelectorAll('.tab-btn');\n    var idx = TABS.indexOf(name);\n    if (idx >= 0 && btns[idx]) {\n      btns[idx].classList.add('active', 'bg-blue-700', 'text-white', 'border-blue-700');\n      btns[idx].classList.remove('border-gray-300', 'text-gray-700');\n    }\n  }\n\n  // =====================================================================\n  // Helpers\n  // =====================================================================\n  function pad2(n) {\n    return String(Math.floor(Math.abs(n))).padStart(2, '0');\n  }\n\n  function formatHM(totalMinutes) {\n    totalMinutes = Math.round(totalMinutes);\n    var t = Math.floor(totalMinutes / 60);\n    var m = totalMinutes % 60;\n    return t + ' t ' + m + ' min';\n  }\n\n  function showResult(id, html, isError) {\n    var el = document.getElementById(id);\n    var cls = isError ? 'error-box' : 'result-box';\n    el.innerHTML = '<div class=\"' + cls + '\">' + html + '</div>';\n  }\n\n  // =====================================================================\n  // TAB 1A: Beregn varighet\n  // =====================================================================\n  function beregnVarighet() {\n    var startVal = document.getElementById('td-start').value;\n    var sluttVal = document.getElementById('td-slutt').value;\n\n    if (!startVal || !sluttVal) {\n      showResult('td-result', 'Fyll inn begge klokkeslett.', true);\n      return;\n    }\n\n    var sp = startVal.split(':');\n    var ep = sluttVal.split(':');\n    var startMin = parseInt(sp[0], 10) * 60 + parseInt(sp[1], 10);\n    var sluttMin = parseInt(ep[0], 10) * 60 + parseInt(ep[1], 10);\n\n    var diff = sluttMin - startMin;\n    if (diff < 0) diff += 24 * 60; // over midnatt\n\n    var t = Math.floor(diff / 60);\n    var m = diff % 60;\n\n    var midnattNote = (sluttMin < startMin)\n      ? '<p class=\"text-xs text-yellow-700 mt-1\">Merk: slutttidspunktet er neste dag (over midnatt).</p>'\n      : '';\n\n    var html = '<p class=\"font-semibold text-green-800 text-base\">Varighet: ' + t + ' t ' + m + ' min</p>' +\n      '<div class=\"step-box mt-2\">' +\n      '<p class=\"text-sm font-medium text-gray-700\">Løsning:</p>' +\n      '<p class=\"font-mono text-sm\">Start: ' + startVal + ' = ' + startMin + ' min etter midnatt</p>' +\n      '<p class=\"font-mono text-sm\">Slutt: ' + sluttVal + ' = ' + sluttMin + ' min etter midnatt</p>';\n\n    if (sluttMin < startMin) {\n      html += '<p class=\"font-mono text-sm\">Differanse: ' + sluttMin + ' + (24 × 60 − ' + startMin + ') = ' + diff + ' min</p>';\n    } else {\n      html += '<p class=\"font-mono text-sm\">Differanse: ' + sluttMin + ' − ' + startMin + ' = ' + diff + ' min</p>';\n    }\n\n    html += '<p class=\"font-mono text-sm\">' + diff + ' min = ' + t + ' t ' + m + ' min</p>' +\n      '</div>' + midnattNote;\n\n    showResult('td-result', html, false);\n  }\n\n  // =====================================================================\n  // TAB 1B: Legg til / trekk fra tid\n  // =====================================================================\n  function leggTilTid(retning) {\n    var startVal = document.getElementById('lt-start').value;\n    var timerVal = parseInt(document.getElementById('lt-timer').value, 10) || 0;\n    var minVal   = parseInt(document.getElementById('lt-minutter').value, 10) || 0;\n\n    if (!startVal) {\n      showResult('lt-result', 'Fyll inn starttidspunkt.', true);\n      return;\n    }\n    if (timerVal < 0 || minVal < 0) {\n      showResult('lt-result', 'Antall timer og minutter kan ikke være negative.', true);\n      return;\n    }\n\n    var sp = startVal.split(':');\n    var startMinTotal = parseInt(sp[0], 10) * 60 + parseInt(sp[1], 10);\n    var deltaMin = timerVal * 60 + minVal;\n\n    var nyttMin = startMinTotal + retning * deltaMin;\n    // Normaliser til [0, 24*60)\n    nyttMin = ((nyttMin % (24 * 60)) + 24 * 60) % (24 * 60);\n\n    var nyttT = Math.floor(nyttMin / 60);\n    var nyttM = nyttMin % 60;\n    var nyttKlokke = pad2(nyttT) + ':' + pad2(nyttM);\n\n    var operator = retning > 0 ? '+' : '−';\n    var ord = retning > 0 ? 'Legger til' : 'Trekker fra';\n\n    var html = '<p class=\"font-semibold text-green-800 text-base\">Nytt klokkeslett: ' + nyttKlokke + '</p>' +\n      '<div class=\"step-box mt-2\">' +\n      '<p class=\"font-mono text-sm\">' + startVal + ' ' + operator + ' (' + timerVal + ' t ' + minVal + ' min)</p>' +\n      '<p class=\"font-mono text-sm\">= ' + startMinTotal + ' min ' + operator + ' ' + deltaMin + ' min</p>' +\n      '<p class=\"font-mono text-sm\">= ' + nyttMin + ' min etter midnatt</p>' +\n      '<p class=\"font-mono text-sm\">= ' + nyttKlokke + '</p>' +\n      '</div>';\n\n    showResult('lt-result', html, false);\n  }\n\n  // =====================================================================\n  // TAB 2: Omgjøring\n  // =====================================================================\n  var currentOmgjMode = 'desimal2hm';\n\n  function setOmgjMode(mode) {\n    currentOmgjMode = mode;\n    var modes = ['desimal2hm', 'hm2desimal', 'sek2min', 'min2sek'];\n    var btnIds = ['btn-d2hm', 'btn-hm2d', 'btn-s2m', 'btn-m2s'];\n    modes.forEach(function(m, i) {\n      var panelEl = document.getElementById('omgj-' + m);\n      var btnEl   = document.getElementById(btnIds[i]);\n      if (panelEl) panelEl.classList.toggle('hidden', m !== mode);\n      if (btnEl) {\n        if (m === mode) {\n          btnEl.classList.add('bg-blue-700', 'text-white', 'border-blue-700');\n          btnEl.classList.remove('border-gray-300', 'text-gray-700');\n        } else {\n          btnEl.classList.remove('bg-blue-700', 'text-white', 'border-blue-700');\n          btnEl.classList.add('border-gray-300', 'text-gray-700');\n        }\n      }\n    });\n  }\n\n  function omgjorDesimal2HM() {\n    var val = parseFloat(document.getElementById('og-desimal').value);\n    if (isNaN(val) || val < 0) {\n      showResult('og-d2hm-result', 'Skriv inn et positivt tall.', true);\n      return;\n    }\n    var t = Math.floor(val);\n    var desimalDel = val - t;\n    var minutter = Math.round(desimalDel * 60);\n    // håndter avrunding til 60 min\n    if (minutter === 60) { t += 1; minutter = 0; }\n\n    var html = '<p class=\"font-semibold text-green-800 text-base\">' + val + ' t = ' + t + ' t ' + minutter + ' min</p>' +\n      '<div class=\"step-box mt-2\">' +\n      '<p class=\"font-mono text-sm\">Heltalldelen: ' + t + ' t</p>' +\n      '<p class=\"font-mono text-sm\">Desimaldelen: ' + desimalDel.toFixed(10).replace(/0+$/, '').replace(/\\.$/, '') + ' t</p>' +\n      '<p class=\"font-mono text-sm\">Minutter: ' + desimalDel.toFixed(10).replace(/0+$/, '') + ' × 60 = ' + minutter + ' min</p>' +\n      '</div>';\n    showResult('og-d2hm-result', html, false);\n  }\n\n  function omgjorHM2Desimal() {\n    var timer   = parseInt(document.getElementById('og-hm-timer').value, 10) || 0;\n    var minutter = parseInt(document.getElementById('og-hm-min').value, 10) || 0;\n    if (minutter < 0 || minutter > 59) {\n      showResult('og-hm2d-result', 'Minutter må være mellom 0 og 59.', true);\n      return;\n    }\n    var desimal = timer + minutter / 60;\n\n    var html = '<p class=\"font-semibold text-green-800 text-base\">' + timer + ' t ' + minutter + ' min = ' + desimal.toFixed(4).replace(/\\.?0+$/, '') + ' t</p>' +\n      '<div class=\"step-box mt-2\">' +\n      '<p class=\"font-mono text-sm\">' + minutter + ' min ÷ 60 = ' + (minutter / 60).toFixed(6).replace(/0+$/, '') + ' t</p>' +\n      '<p class=\"font-mono text-sm\">' + timer + ' + ' + (minutter / 60).toFixed(6).replace(/0+$/, '') + ' = ' + desimal.toFixed(6).replace(/0+$/, '') + ' t</p>' +\n      '</div>';\n    showResult('og-hm2d-result', html, false);\n  }\n\n  function omgjorSek2Min() {\n    var sek = parseInt(document.getElementById('og-sek').value, 10);\n    if (isNaN(sek) || sek < 0) {\n      showResult('og-s2m-result', 'Skriv inn et positivt heltall.', true);\n      return;\n    }\n    var min = Math.floor(sek / 60);\n    var restSek = sek % 60;\n\n    var html = '<p class=\"font-semibold text-green-800 text-base\">' + sek + ' sek = ' + min + ' min ' + restSek + ' sek</p>' +\n      '<div class=\"step-box mt-2\">' +\n      '<p class=\"font-mono text-sm\">' + sek + ' ÷ 60 = ' + min + ' (hele minutter)</p>' +\n      '<p class=\"font-mono text-sm\">Rest: ' + sek + ' − ' + (min * 60) + ' = ' + restSek + ' sek</p>' +\n      '</div>';\n    showResult('og-s2m-result', html, false);\n  }\n\n  function omgjorMin2Sek() {\n    var min = parseInt(document.getElementById('og-ms-min').value, 10) || 0;\n    var sek = parseInt(document.getElementById('og-ms-sek').value, 10) || 0;\n    if (sek < 0 || sek > 59) {\n      showResult('og-m2s-result', 'Sekunder må være mellom 0 og 59.', true);\n      return;\n    }\n    var total = min * 60 + sek;\n\n    var html = '<p class=\"font-semibold text-green-800 text-base\">' + min + ' min ' + sek + ' sek = ' + total + ' sek</p>' +\n      '<div class=\"step-box mt-2\">' +\n      '<p class=\"font-mono text-sm\">' + min + ' min × 60 = ' + (min * 60) + ' sek</p>' +\n      '<p class=\"font-mono text-sm\">' + (min * 60) + ' + ' + sek + ' = ' + total + ' sek</p>' +\n      '</div>';\n    showResult('og-m2s-result', html, false);\n  }\n\n  // =====================================================================\n  // TAB 3: Fart, strekning, tid\n  // =====================================================================\n  var currentFartMode = 'strekning';\n\n  function setFartMode(mode) {\n    currentFartMode = mode;\n    var modes = ['strekning', 'fart', 'tid'];\n    var btnIds = ['btn-fs', 'btn-fv', 'btn-ft'];\n    modes.forEach(function(m, i) {\n      var panelEl = document.getElementById('fart-' + m);\n      var btnEl   = document.getElementById(btnIds[i]);\n      if (panelEl) panelEl.classList.toggle('hidden', m !== mode);\n      if (btnEl) {\n        if (m === mode) {\n          btnEl.classList.add('bg-blue-700', 'text-white', 'border-blue-700');\n          btnEl.classList.remove('border-gray-300', 'text-gray-700');\n        } else {\n          btnEl.classList.remove('bg-blue-700', 'text-white', 'border-blue-700');\n          btnEl.classList.add('border-gray-300', 'text-gray-700');\n        }\n      }\n    });\n  }\n\n  // Konverter tid til timer (desimal)\n  function tidTilTimer(val, enhet) {\n    if (enhet === 'timer') return val;\n    if (enhet === 'min')   return val / 60;\n    if (enhet === 'sek')   return val / 3600;\n    return val;\n  }\n\n  // Konverter fart til km/h\n  function fartTilKmH(val, enhet) {\n    if (enhet === 'kmh') return val;\n    if (enhet === 'ms')  return val * 3.6;\n    return val;\n  }\n\n  // Konverter strekning til km\n  function strekningTilKm(val, enhet) {\n    if (enhet === 'km') return val;\n    if (enhet === 'm')  return val / 1000;\n    return val;\n  }\n\n  function formatTid(timerDesimal) {\n    var t = Math.floor(timerDesimal);\n    var m = Math.round((timerDesimal - t) * 60);\n    if (m === 60) { t += 1; m = 0; }\n    if (t === 0) return m + ' min';\n    if (m === 0) return t + ' t';\n    return t + ' t ' + m + ' min';\n  }\n\n  function beregnStrekning() {\n    var v    = parseFloat(document.getElementById('fs-v').value);\n    var vEnh = document.getElementById('fs-v-enhet').value;\n    var t    = parseFloat(document.getElementById('fs-t').value);\n    var tEnh = document.getElementById('fs-t-enhet').value;\n\n    if (isNaN(v) || isNaN(t) || v <= 0 || t <= 0) {\n      showResult('fs-result', 'Fyll inn gyldige positive verdier.', true);\n      return;\n    }\n\n    var vKmH = fartTilKmH(v, vEnh);\n    var tTimer = tidTilTimer(t, tEnh);\n    var s = vKmH * tTimer;\n\n    var vNote = vEnh === 'ms' ? ' (' + v + ' m/s × 3,6 = ' + vKmH.toFixed(2) + ' km/h)' : '';\n    var tNote = '';\n    if (tEnh === 'min') tNote = ' (' + t + ' min ÷ 60 = ' + tTimer.toFixed(4) + ' t)';\n    if (tEnh === 'sek') tNote = ' (' + t + ' sek ÷ 3600 = ' + tTimer.toFixed(6) + ' t)';\n\n    var html = '<p class=\"font-semibold text-green-800 text-base\">Strekning: ' + s.toFixed(2) + ' km (' + (s * 1000).toFixed(0) + ' m)</p>' +\n      '<div class=\"step-box mt-2\">' +\n      '<p class=\"font-mono text-sm\">s = v · t</p>' +\n      '<p class=\"font-mono text-sm\">v = ' + vKmH.toFixed(2) + ' km/h' + vNote + '</p>' +\n      '<p class=\"font-mono text-sm\">t = ' + tTimer.toFixed(4).replace(/0+$/, '').replace(/\\.$/, '') + ' t' + tNote + '</p>' +\n      '<p class=\"font-mono text-sm\">s = ' + vKmH.toFixed(2) + ' × ' + tTimer.toFixed(4).replace(/0+$/, '') + ' = ' + s.toFixed(2) + ' km</p>' +\n      '</div>';\n    showResult('fs-result', html, false);\n  }\n\n  function beregnFart() {\n    var s    = parseFloat(document.getElementById('fv-s').value);\n    var sEnh = document.getElementById('fv-s-enhet').value;\n    var t    = parseFloat(document.getElementById('fv-t').value);\n    var tEnh = document.getElementById('fv-t-enhet').value;\n\n    if (isNaN(s) || isNaN(t) || s <= 0 || t <= 0) {\n      showResult('fv-result', 'Fyll inn gyldige positive verdier.', true);\n      return;\n    }\n\n    var sKm   = strekningTilKm(s, sEnh);\n    var tTimer = tidTilTimer(t, tEnh);\n    var v = sKm / tTimer;\n    var vMs = v / 3.6;\n\n    var sNote = sEnh === 'm' ? ' (' + s + ' m ÷ 1000 = ' + sKm.toFixed(4) + ' km)' : '';\n    var tNote = '';\n    if (tEnh === 'min') tNote = ' (' + t + ' min ÷ 60 = ' + tTimer.toFixed(4) + ' t)';\n    if (tEnh === 'sek') tNote = ' (' + t + ' sek ÷ 3600 = ' + tTimer.toFixed(6) + ' t)';\n\n    var html = '<p class=\"font-semibold text-green-800 text-base\">Fart: ' + v.toFixed(2) + ' km/h = ' + vMs.toFixed(2) + ' m/s</p>' +\n      '<div class=\"step-box mt-2\">' +\n      '<p class=\"font-mono text-sm\">v = s / t</p>' +\n      '<p class=\"font-mono text-sm\">s = ' + sKm.toFixed(4).replace(/0+$/, '').replace(/\\.$/, '') + ' km' + sNote + '</p>' +\n      '<p class=\"font-mono text-sm\">t = ' + tTimer.toFixed(4).replace(/0+$/, '').replace(/\\.$/, '') + ' t' + tNote + '</p>' +\n      '<p class=\"font-mono text-sm\">v = ' + sKm.toFixed(4).replace(/0+$/, '') + ' ÷ ' + tTimer.toFixed(4).replace(/0+$/, '') + ' = ' + v.toFixed(2) + ' km/h</p>' +\n      '<p class=\"font-mono text-sm\">m/s: ' + v.toFixed(2) + ' ÷ 3,6 = ' + vMs.toFixed(2) + ' m/s</p>' +\n      '</div>';\n    showResult('fv-result', html, false);\n  }\n\n  function beregnTid() {\n    var s    = parseFloat(document.getElementById('ft-s').value);\n    var sEnh = document.getElementById('ft-s-enhet').value;\n    var v    = parseFloat(document.getElementById('ft-v').value);\n    var vEnh = document.getElementById('ft-v-enhet').value;\n\n    if (isNaN(s) || isNaN(v) || s <= 0 || v <= 0) {\n      showResult('ft-result', 'Fyll inn gyldige positive verdier.', true);\n      return;\n    }\n\n    var sKm  = strekningTilKm(s, sEnh);\n    var vKmH = fartTilKmH(v, vEnh);\n    var tTimer = sKm / vKmH;\n    var tMin   = tTimer * 60;\n\n    var sNote = sEnh === 'm' ? ' (' + s + ' m ÷ 1000 = ' + sKm.toFixed(4) + ' km)' : '';\n    var vNote = vEnh === 'ms' ? ' (' + v + ' m/s × 3,6 = ' + vKmH.toFixed(2) + ' km/h)' : '';\n\n    var html = '<p class=\"font-semibold text-green-800 text-base\">Tid: ' + formatTid(tTimer) + ' (' + tTimer.toFixed(4).replace(/0+$/, '') + ' t = ' + tMin.toFixed(1) + ' min)</p>' +\n      '<div class=\"step-box mt-2\">' +\n      '<p class=\"font-mono text-sm\">t = s / v</p>' +\n      '<p class=\"font-mono text-sm\">s = ' + sKm.toFixed(4).replace(/0+$/, '').replace(/\\.$/, '') + ' km' + sNote + '</p>' +\n      '<p class=\"font-mono text-sm\">v = ' + vKmH.toFixed(2) + ' km/h' + vNote + '</p>' +\n      '<p class=\"font-mono text-sm\">t = ' + sKm.toFixed(4).replace(/0+$/, '') + ' ÷ ' + vKmH.toFixed(2) + ' = ' + tTimer.toFixed(4).replace(/0+$/, '') + ' t</p>' +\n      '<p class=\"font-mono text-sm\">= ' + formatTid(tTimer) + '</p>' +\n      '</div>';\n    showResult('ft-result', html, false);\n  }\n</script>\n\n</body>\n</html>\n",
  "packaging": {
    "appName": "Regning med tid",
