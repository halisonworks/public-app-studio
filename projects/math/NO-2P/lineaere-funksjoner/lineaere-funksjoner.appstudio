{
  "schema": "app-studio/canvas@1",
  "id": "example-no2p-lineaere-funksjoner",
  "name": "lineaere-funksjoner.html",
  "code": "<!DOCTYPE html>\n<!--\n  Lineære funksjoner — Halison App Studio-eksempel\n\n  Interaktivt læremiddel for matematikk 2P (LK20): utforsk y = ax + b — dra i\n  stigningstall og konstantledd og se grafen, nullpunkt og verditabell endre seg.\n\n  Fra Halison App Studio sitt offentlige bibliotek:\n  https://github.com/halisonworks/public-app-studio\n\n  Tillatt bruk: personlig, pedagogisk og annen ikke-kommersiell bruk. Behold denne\n  headeren og kildelenken; ikke-kommersiell bruk. Utgitt under Halison App Studio\n  Examples License — se LICENSE-filen i repoet over.\n-->\n<html lang=\"no\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Lineære funksjoner – y = ax + b</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Segoe UI', system-ui, sans-serif; }\n    .slider-a::-webkit-slider-thumb { background: #2563eb; }\n    .slider-b::-webkit-slider-thumb { background: #16a34a; }\n    input[type=range] {\n      -webkit-appearance: none;\n      height: 6px;\n      border-radius: 3px;\n      outline: none;\n      cursor: pointer;\n    }\n    input[type=range]::-webkit-slider-thumb {\n      -webkit-appearance: none;\n      width: 20px;\n      height: 20px;\n      border-radius: 50%;\n      cursor: pointer;\n      border: 2px solid white;\n      box-shadow: 0 1px 4px rgba(0,0,0,0.3);\n    }\n    .slider-a { background: linear-gradient(to right, #93c5fd, #2563eb); }\n    .slider-b { background: linear-gradient(to right, #86efac, #16a34a); }\n    .svg-container { width: 100%; aspect-ratio: 1 / 1; max-height: 480px; }\n    @media (min-width: 1024px) { .svg-container { max-height: 520px; } }\n    .info-card { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1rem; }\n    .badge-a { background: #dbeafe; color: #1d4ed8; border-radius: 6px; padding: 2px 8px; font-weight: 700; }\n    .badge-b { background: #dcfce7; color: #15803d; border-radius: 6px; padding: 2px 8px; font-weight: 700; }\n    .badge-null { background: #fef9c3; color: #854d0e; border-radius: 6px; padding: 2px 8px; font-weight: 700; }\n    table { border-collapse: collapse; width: 100%; }\n    th, td { border: 1px solid #e2e8f0; padding: 5px 10px; text-align: center; font-size: 0.875rem; }\n    th { background: #f1f5f9; font-weight: 600; }\n    tr:nth-child(even) td { background: #f8fafc; }\n    .highlight-row td { background: #fef9c3 !important; font-weight: 700; }\n  </style>\n</head>\n<body class=\"bg-slate-50 min-h-screen\">\n\n  <!-- Header -->\n  <header class=\"bg-white border-b border-slate-200 py-4 px-4 mb-6 shadow-sm\">\n    <div class=\"max-w-6xl mx-auto flex items-center gap-3\">\n      <div class=\"w-9 h-9 rounded-lg bg-blue-600 flex items-center justify-center text-white font-bold text-lg\">f</div>\n      <div>\n        <h1 class=\"text-xl font-bold text-slate-800 leading-tight\">Lineære funksjoner</h1>\n        <p class=\"text-xs text-slate-500\">Matematikk 2P · LK20 · y = ax + b</p>\n      </div>\n    </div>\n  </header>\n\n  <main class=\"max-w-6xl mx-auto px-4 pb-12\">\n\n    <!-- Main grid: graph left, controls right -->\n    <div class=\"grid grid-cols-1 lg:grid-cols-5 gap-6\">\n\n      <!-- SVG Graph -->\n      <div class=\"lg:col-span-3 bg-white rounded-2xl shadow-sm border border-slate-200 p-4\">\n        <h2 class=\"text-sm font-semibold text-slate-500 mb-3 uppercase tracking-wide\">Graf</h2>\n        <div class=\"svg-container mx-auto\">\n          <svg id=\"graph\" viewBox=\"0 0 500 500\" xmlns=\"http://www.w3.org/2000/svg\"\n               style=\"width:100%;height:100%;display:block;\" aria-label=\"Koordinatsystem med linjen y = ax + b\">\n            <!-- Rendered by JS -->\n          </svg>\n        </div>\n        <!-- Funksjonsuttrykk under grafen -->\n        <div class=\"mt-3 text-center\">\n          <span class=\"text-lg font-bold text-blue-700\" id=\"func-expr\">f(x) = x</span>\n        </div>\n      </div>\n\n      <!-- Controls + info -->\n      <div class=\"lg:col-span-2 flex flex-col gap-4\">\n\n        <!-- Stigningstall a -->\n        <div class=\"info-card\">\n          <label class=\"flex items-center justify-between mb-2\">\n            <span class=\"font-semibold text-slate-700\">Stigningstall <span class=\"badge-a\">a</span></span>\n            <input type=\"number\" id=\"a-num\" value=\"1\" min=\"-10\" max=\"10\" step=\"0.1\"\n                   class=\"w-20 text-center border border-blue-300 rounded-lg py-1 text-blue-700 font-bold text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n          </label>\n          <input type=\"range\" id=\"a-slider\" class=\"slider-a w-full\" min=\"-10\" max=\"10\" step=\"0.1\" value=\"1\" />\n          <p class=\"text-xs text-slate-500 mt-2\" id=\"a-explain\">\n            Når <strong>x</strong> øker med 1, øker <strong>y</strong> med <strong>1</strong>.\n          </p>\n        </div>\n\n        <!-- Konstantledd b -->\n        <div class=\"info-card\">\n          <label class=\"flex items-center justify-between mb-2\">\n            <span class=\"font-semibold text-slate-700\">Konstantledd <span class=\"badge-b\">b</span></span>\n            <input type=\"number\" id=\"b-num\" value=\"0\" min=\"-10\" max=\"10\" step=\"0.1\"\n                   class=\"w-20 text-center border border-green-300 rounded-lg py-1 text-green-700 font-bold text-sm focus:outline-none focus:ring-2 focus:ring-green-400\" />\n          </label>\n          <input type=\"range\" id=\"b-slider\" class=\"slider-b w-full\" min=\"-10\" max=\"10\" step=\"0.1\" value=\"0\" />\n          <p class=\"text-xs text-slate-500 mt-2\" id=\"b-explain\">\n            Grafen skjærer y-aksen i punktet <strong>(0, 0)</strong>.\n          </p>\n        </div>\n\n        <!-- Nullpunkt + y-skjæring -->\n        <div class=\"info-card grid grid-cols-2 gap-3 text-sm\">\n          <div>\n            <p class=\"text-slate-500 text-xs font-semibold uppercase tracking-wide mb-1\">Nullpunkt</p>\n            <p class=\"font-bold text-amber-700\" id=\"nullpunkt-txt\">x = 0</p>\n            <p class=\"text-xs text-slate-400\">(der y = 0)</p>\n          </div>\n          <div>\n            <p class=\"text-slate-500 text-xs font-semibold uppercase tracking-wide mb-1\">y-skjæring</p>\n            <p class=\"font-bold text-green-700\" id=\"y-skjaering-txt\">(0, 0)</p>\n            <p class=\"text-xs text-slate-400\">(der x = 0)</p>\n          </div>\n        </div>\n\n        <!-- Les av verdi -->\n        <div class=\"info-card\">\n          <h3 class=\"font-semibold text-slate-700 mb-2 text-sm\">Les av verdi</h3>\n          <div class=\"flex items-center gap-2\">\n            <label class=\"text-sm text-slate-600\">x =</label>\n            <input type=\"number\" id=\"readoff-x\" value=\"2\" step=\"0.5\"\n                   class=\"w-24 border border-slate-300 rounded-lg py-1 px-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n          </div>\n          <p class=\"mt-2 text-sm text-slate-700\">\n            f(<span id=\"readoff-x-show\">2</span>) = <strong class=\"text-blue-700\" id=\"readoff-y-show\">3</strong>\n          </p>\n          <p class=\"text-xs text-slate-400 mt-1\">Et punkt er markert på grafen.</p>\n        </div>\n\n      </div>\n    </div>\n\n    <!-- Second row: forklaring + verditabell -->\n    <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6 mt-6\">\n\n      <!-- Forklaring -->\n      <div class=\"bg-white rounded-2xl shadow-sm border border-slate-200 p-5\">\n        <h2 class=\"text-sm font-semibold text-slate-500 uppercase tracking-wide mb-3\">Forklaring</h2>\n        <div class=\"space-y-3 text-sm text-slate-700 leading-relaxed\">\n          <p>\n            En <strong>lineær funksjon</strong> er en funksjon der grafen er en rett linje.\n            Den generelle formen er <strong>y = ax + b</strong>.\n          </p>\n          <p id=\"explain-a-long\">\n            <span class=\"badge-a\">a = 1</span> er <strong>stigningstallet</strong>.\n            Det forteller hvor bratt linjen er. Når x øker med 1, endres y med <strong>1</strong>.\n            Er a positiv, stiger linjen. Er a negativ, synker den. Er a = 0, er linjen vannrett.\n          </p>\n          <p id=\"explain-b-long\">\n            <span class=\"badge-b\">b = 0</span> er <strong>konstantleddet</strong>.\n            Det bestemmer hvor linjen krysser y-aksen — punktet <strong>(0, 0)</strong>.\n            Endrer du b, forskyver grafen seg opp eller ned.\n          </p>\n          <p id=\"explain-null-long\">\n            <strong>Nullpunktet</strong> er der grafen krysser x-aksen, altså der y = 0.\n            Vi løser ax + b = 0 → x = −b/a (gjelder kun når a ≠ 0).\n            Her er nullpunktet <strong>x = 0</strong>.\n          </p>\n        </div>\n      </div>\n\n      <!-- Verditabell -->\n      <div class=\"bg-white rounded-2xl shadow-sm border border-slate-200 p-5\">\n        <h2 class=\"text-sm font-semibold text-slate-500 uppercase tracking-wide mb-3\">Verditabell</h2>\n        <div class=\"overflow-x-auto\">\n          <table id=\"verditabell\">\n            <thead>\n              <tr><th>x</th><th>y = f(x)</th></tr>\n            </thead>\n            <tbody id=\"verditabell-body\">\n            </tbody>\n          </table>\n        </div>\n        <p class=\"text-xs text-slate-400 mt-2\">Den gule raden svarer til verdien du leser av over.</p>\n      </div>\n\n    </div>\n  </main>\n\n  <footer class=\"text-center text-xs text-slate-400 py-6 border-t border-slate-200 mt-4\">\n    Halison App Studio · Interaktivt læremiddel for Matematikk 2P (LK20) ·\n    <a href=\"https://github.com/halisonworks/public-app-studio\" class=\"underline hover:text-slate-600\" target=\"_blank\">GitHub</a>\n  </footer>\n\n<script>\n(function () {\n  'use strict';\n\n  // ── State ────────────────────────────────────────────────────────────────\n  let a = 1, b = 0, readX = 2;\n\n  // ── DOM refs ─────────────────────────────────────────────────────────────\n  const aSlider    = document.getElementById('a-slider');\n  const bSlider    = document.getElementById('b-slider');\n  const aNum       = document.getElementById('a-num');\n  const bNum       = document.getElementById('b-num');\n  const readoffX   = document.getElementById('readoff-x');\n  const svg        = document.getElementById('graph');\n\n  // ── Helpers ──────────────────────────────────────────────────────────────\n  function fmt(n) {\n    // Round to 2 decimals, strip trailing zeros\n    return parseFloat(n.toFixed(2)).toString();\n  }\n\n  function fmtCoeff(n) {\n    // Format coefficient for function expression string\n    const r = parseFloat(n.toFixed(2));\n    return r;\n  }\n\n  function buildFuncExpr(a, b) {\n    const af = fmtCoeff(a);\n    const bf = fmtCoeff(b);\n    let expr = 'f(x) = ';\n    if (af === 0 && bf === 0) return expr + '0';\n    if (af === 0) return expr + fmt(bf);\n    // build a*x part\n    let aPart = '';\n    if (af === 1)       aPart = 'x';\n    else if (af === -1) aPart = '−x';\n    else                aPart = fmt(af) + 'x';\n    // build b part\n    let bPart = '';\n    if (bf > 0)       bPart = ' + ' + fmt(bf);\n    else if (bf < 0)  bPart = ' − ' + fmt(Math.abs(bf));\n    return expr + aPart + bPart;\n  }\n\n  // ── SVG coordinate system ────────────────────────────────────────────────\n  // ViewBox: 0 0 500 500. Origin at center (250, 250).\n  // Scale: 30px per unit. Range ≈ −8 to +8 in each axis.\n  const W = 500, H = 500;\n  const OX = 250, OY = 250;   // pixel origin\n  const SCALE = 30;            // px per math unit\n  const AXIS_RANGE = 8;        // units from origin to edge (approx)\n\n  function toSvgX(mx) { return OX + mx * SCALE; }\n  function toSvgY(my) { return OY - my * SCALE; }\n  function toMathX(sx) { return (sx - OX) / SCALE; }\n\n  function svgEl(tag, attrs) {\n    const el = document.createElementNS('http://www.w3.org/2000/svg', tag);\n    for (const [k, v] of Object.entries(attrs)) el.setAttribute(k, v);\n    return el;\n  }\n\n  function renderGraph() {\n    // Clear\n    while (svg.firstChild) svg.removeChild(svg.firstChild);\n\n    // ── Background ─────────────────────────────────────────────────────────\n    svg.appendChild(svgEl('rect', { x: 0, y: 0, width: W, height: H, fill: '#f8fafc' }));\n\n    // ── Gridlines ──────────────────────────────────────────────────────────\n    for (let i = -AXIS_RANGE; i <= AXIS_RANGE; i++) {\n      const px = toSvgX(i);\n      const py = toSvgY(i);\n      if (px >= 0 && px <= W) {\n        svg.appendChild(svgEl('line', {\n          x1: px, y1: 0, x2: px, y2: H,\n          stroke: i === 0 ? '#94a3b8' : '#e2e8f0',\n          'stroke-width': i === 0 ? 1.5 : 1\n        }));\n      }\n      if (py >= 0 && py <= H) {\n        svg.appendChild(svgEl('line', {\n          x1: 0, y1: py, x2: W, y2: py,\n          stroke: i === 0 ? '#94a3b8' : '#e2e8f0',\n          'stroke-width': i === 0 ? 1.5 : 1\n        }));\n      }\n    }\n\n    // ── Axis arrows ────────────────────────────────────────────────────────\n    // x-axis\n    svg.appendChild(svgEl('line', {\n      x1: 5, y1: OY, x2: W - 5, y2: OY,\n      stroke: '#475569', 'stroke-width': 2\n    }));\n    // x arrow head\n    svg.appendChild(svgEl('polygon', {\n      points: `${W-5},${OY} ${W-14},${OY-5} ${W-14},${OY+5}`,\n      fill: '#475569'\n    }));\n    // y-axis\n    svg.appendChild(svgEl('line', {\n      x1: OX, y1: H - 5, x2: OX, y2: 5,\n      stroke: '#475569', 'stroke-width': 2\n    }));\n    // y arrow head\n    svg.appendChild(svgEl('polygon', {\n      points: `${OX},5 ${OX-5},14 ${OX+5},14`,\n      fill: '#475569'\n    }));\n\n    // ── Axis labels ────────────────────────────────────────────────────────\n    svg.appendChild(Object.assign(svgEl('text', {\n      x: W - 8, y: OY + 16, fill: '#475569',\n      'font-size': '13', 'font-family': 'Segoe UI,system-ui,sans-serif', 'font-weight': '600'\n    }), { textContent: 'x' }));\n    svg.appendChild(Object.assign(svgEl('text', {\n      x: OX + 8, y: 16, fill: '#475569',\n      'font-size': '13', 'font-family': 'Segoe UI,system-ui,sans-serif', 'font-weight': '600'\n    }), { textContent: 'y' }));\n\n    // ── Tick marks + numbers ───────────────────────────────────────────────\n    for (let i = -AXIS_RANGE; i <= AXIS_RANGE; i++) {\n      if (i === 0) continue;\n      const px = toSvgX(i);\n      const py = toSvgY(i);\n      // x-axis tick\n      if (px >= 10 && px <= W - 20) {\n        svg.appendChild(svgEl('line', { x1: px, y1: OY - 4, x2: px, y2: OY + 4, stroke: '#475569', 'stroke-width': 1.5 }));\n        const xt = svgEl('text', {\n          x: px, y: OY + 17, fill: '#64748b',\n          'font-size': '11', 'font-family': 'Segoe UI,system-ui,sans-serif',\n          'text-anchor': 'middle'\n        });\n        xt.textContent = i;\n        svg.appendChild(xt);\n      }\n      // y-axis tick\n      if (py >= 10 && py <= H - 20) {\n        svg.appendChild(svgEl('line', { x1: OX - 4, y1: py, x2: OX + 4, y2: py, stroke: '#475569', 'stroke-width': 1.5 }));\n        const yt = svgEl('text', {\n          x: OX - 8, y: py + 4, fill: '#64748b',\n          'font-size': '11', 'font-family': 'Segoe UI,system-ui,sans-serif',\n          'text-anchor': 'end'\n        });\n        yt.textContent = i;\n        svg.appendChild(yt);\n      }\n    }\n    // Origin label\n    const orig = svgEl('text', {\n      x: OX - 8, y: OY + 17, fill: '#94a3b8',\n      'font-size': '11', 'font-family': 'Segoe UI,system-ui,sans-serif', 'text-anchor': 'end'\n    });\n    orig.textContent = '0';\n    svg.appendChild(orig);\n\n    // ── Draw the line y = ax + b ───────────────────────────────────────────\n    // Compute intercepts at SVG edges to clip line to viewport\n    // We'll parameterize by x in math coords from −9 to +9\n    const MX_LEFT  = toMathX(0);\n    const MX_RIGHT = toMathX(W);\n\n    const y_left  = a * MX_LEFT  + b;\n    const y_right = a * MX_RIGHT + b;\n\n    const p1x = toSvgX(MX_LEFT);\n    const p1y = toSvgY(y_left);\n    const p2x = toSvgX(MX_RIGHT);\n    const p2y = toSvgY(y_right);\n\n    svg.appendChild(svgEl('line', {\n      x1: p1x, y1: p1y, x2: p2x, y2: p2y,\n      stroke: '#2563eb', 'stroke-width': 2.5,\n      'stroke-linecap': 'round'\n    }));\n\n    // ── y-intercept point (0, b) ───────────────────────────────────────────\n    const yIntSx = toSvgX(0);\n    const yIntSy = toSvgY(b);\n    svg.appendChild(svgEl('circle', {\n      cx: yIntSx, cy: yIntSy, r: 6,\n      fill: '#16a34a', stroke: 'white', 'stroke-width': 2\n    }));\n    // Label\n    const bLabel = svgEl('text', {\n      x: yIntSx + 10, y: yIntSy - 6,\n      fill: '#15803d', 'font-size': '12',\n      'font-family': 'Segoe UI,system-ui,sans-serif', 'font-weight': '700'\n    });\n    bLabel.textContent = '(0, ' + fmt(b) + ')';\n    svg.appendChild(bLabel);\n\n    // ── Nullpunkt (−b/a, 0) ───────────────────────────────────────────────\n    if (Math.abs(a) > 0.001) {\n      const nullX = -b / a;\n      const nullSx = toSvgX(nullX);\n      const nullSy = toSvgY(0);\n      if (nullSx >= 0 && nullSx <= W) {\n        svg.appendChild(svgEl('circle', {\n          cx: nullSx, cy: nullSy, r: 6,\n          fill: '#d97706', stroke: 'white', 'stroke-width': 2\n        }));\n        const nLabel = svgEl('text', {\n          x: nullSx + 10, y: nullSy - 6,\n          fill: '#b45309', 'font-size': '12',\n          'font-family': 'Segoe UI,system-ui,sans-serif', 'font-weight': '700'\n        });\n        nLabel.textContent = '(' + fmt(nullX) + ', 0)';\n        svg.appendChild(nLabel);\n      }\n    }\n\n    // ── Read-off point ────────────────────────────────────────────────────\n    const roY = a * readX + b;\n    const roSx = toSvgX(readX);\n    const roSy = toSvgY(roY);\n    if (roSx >= 0 && roSx <= W && roSy >= 0 && roSy <= H) {\n      // Dashed drop lines\n      svg.appendChild(svgEl('line', {\n        x1: roSx, y1: roSy, x2: roSx, y2: OY,\n        stroke: '#7c3aed', 'stroke-width': 1.5,\n        'stroke-dasharray': '4,3', opacity: '0.7'\n      }));\n      svg.appendChild(svgEl('line', {\n        x1: roSx, y1: roSy, x2: OX, y2: roSy,\n        stroke: '#7c3aed', 'stroke-width': 1.5,\n        'stroke-dasharray': '4,3', opacity: '0.7'\n      }));\n      svg.appendChild(svgEl('circle', {\n        cx: roSx, cy: roSy, r: 7,\n        fill: '#7c3aed', stroke: 'white', 'stroke-width': 2.5\n      }));\n    }\n  }\n\n  // ── UI update ─────────────────────────────────────────────────────────────\n  function update() {\n    // Sync sliders ↔ number inputs\n    aSlider.value = a;\n    aNum.value    = fmt(a);\n    bSlider.value = b;\n    bNum.value    = fmt(b);\n\n    // Function expression\n    document.getElementById('func-expr').textContent = buildFuncExpr(a, b);\n\n    // a-explain\n    const aDir = a > 0 ? 'øker' : (a < 0 ? 'synker' : 'endres ikke');\n    document.getElementById('a-explain').innerHTML =\n      'Når <strong>x</strong> øker med 1, ' + aDir + ' <strong>y</strong> med <strong>' + fmt(Math.abs(a)) + '</strong>.';\n\n    // b-explain\n    document.getElementById('b-explain').innerHTML =\n      'Grafen skjærer y-aksen i punktet <strong>(0, ' + fmt(b) + ')</strong>.';\n\n    // Nullpunkt\n    let nullTxt, nullLong;\n    if (Math.abs(a) < 0.001) {\n      if (Math.abs(b) < 0.001) {\n        nullTxt  = 'Hele x-aksen';\n        nullLong = 'Siden a = 0 og b = 0 er funksjonen f(x) = 0, og grafen faller sammen med x-aksen.';\n      } else {\n        nullTxt  = 'Ingen (a = 0)';\n        nullLong = 'Siden a = 0 er linjen vannrett og krysser aldri x-aksen (med mindre b = 0).';\n      }\n    } else {\n      const nx = -b / a;\n      nullTxt  = 'x = ' + fmt(nx);\n      nullLong = 'Nullpunktet er der y = 0. Vi løser ax + b = 0 → x = −b/a = ' + fmt(nx) + '. Her er nullpunktet <strong>(' + fmt(nx) + ', 0)</strong>.';\n    }\n    document.getElementById('nullpunkt-txt').textContent    = nullTxt;\n    document.getElementById('y-skjaering-txt').textContent  = '(0, ' + fmt(b) + ')';\n\n    // Forklaring-blokken\n    const af = fmtCoeff(a), bf = fmtCoeff(b);\n    document.getElementById('explain-a-long').innerHTML =\n      '<span class=\"badge-a\">a = ' + fmt(a) + '</span> er <strong>stigningstallet</strong>. ' +\n      'Det forteller hvor bratt linjen er. Når x øker med 1, ' + aDir + ' y med <strong>' + fmt(Math.abs(a)) + '</strong>. ' +\n      (a > 0 ? 'Linjen stiger fra venstre mot høyre.' : a < 0 ? 'Linjen synker fra venstre mot høyre.' : 'Linjen er vannrett.');\n\n    document.getElementById('explain-b-long').innerHTML =\n      '<span class=\"badge-b\">b = ' + fmt(b) + '</span> er <strong>konstantleddet</strong>. ' +\n      'Det bestemmer hvor linjen krysser y-aksen — punktet <strong>(0, ' + fmt(b) + ')</strong>. ' +\n      'Endrer du b, forskyver grafen seg opp eller ned.';\n\n    document.getElementById('explain-null-long').innerHTML =\n      '<strong>Nullpunktet</strong> er der grafen krysser x-aksen (y = 0). ' + nullLong;\n\n    // Read-off\n    const roY = a * readX + b;\n    document.getElementById('readoff-x-show').textContent = fmt(readX);\n    document.getElementById('readoff-y-show').textContent = fmt(roY);\n\n    // Verditabell\n    buildVerditabell();\n\n    // Graph\n    renderGraph();\n  }\n\n  // ── Verditabell ───────────────────────────────────────────────────────────\n  function buildVerditabell() {\n    const tbody = document.getElementById('verditabell-body');\n    tbody.innerHTML = '';\n    const xs = [-4, -3, -2, -1, 0, 1, 2, 3, 4];\n    for (const x of xs) {\n      const y = a * x + b;\n      const tr = document.createElement('tr');\n      const isHighlight = Math.abs(x - readX) < 0.001;\n      if (isHighlight) tr.className = 'highlight-row';\n      const tdx = document.createElement('td');\n      tdx.textContent = x;\n      const tdy = document.createElement('td');\n      tdy.textContent = fmt(y);\n      tr.appendChild(tdx);\n      tr.appendChild(tdy);\n      tbody.appendChild(tr);\n    }\n  }\n\n  // ── Event listeners ───────────────────────────────────────────────────────\n  function clampA(v) { return Math.max(-10, Math.min(10, v)); }\n  function clampB(v) { return Math.max(-10, Math.min(10, v)); }\n\n  aSlider.addEventListener('input', function () {\n    a = clampA(parseFloat(this.value) || 0);\n    update();\n  });\n  aNum.addEventListener('input', function () {\n    const v = parseFloat(this.value);\n    if (!isNaN(v)) { a = clampA(v); update(); }\n  });\n  aNum.addEventListener('change', function () {\n    const v = parseFloat(this.value);\n    a = isNaN(v) ? 0 : clampA(v);\n    update();\n  });\n\n  bSlider.addEventListener('input', function () {\n    b = clampB(parseFloat(this.value) || 0);\n    update();\n  });\n  bNum.addEventListener('input', function () {\n    const v = parseFloat(this.value);\n    if (!isNaN(v)) { b = clampB(v); update(); }\n  });\n  bNum.addEventListener('change', function () {\n    const v = parseFloat(this.value);\n    b = isNaN(v) ? 0 : clampB(v);\n    update();\n  });\n\n  readoffX.addEventListener('input', function () {\n    const v = parseFloat(this.value);\n    if (!isNaN(v)) { readX = v; update(); }\n  });\n  readoffX.addEventListener('change', function () {\n    const v = parseFloat(this.value);\n    readX = isNaN(v) ? 0 : v;\n    update();\n  });\n\n  // ── Initial render ────────────────────────────────────────────────────────\n  update();\n\n})();\n</script>\n\n</body>\n</html>\n",
  "packaging": {
    "appName": "Lineære funksjoner",
    "windowTitle": "Lineære funksjoner",
    "bundleId": "com.halisonworks.lineaerefunksjoner",
    "iconPath": null
  },
