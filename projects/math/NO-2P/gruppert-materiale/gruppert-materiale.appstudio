{
  "schema": "app-studio/canvas@1",
  "id": "example-no2p-gruppert",
  "name": "gruppert-materiale.html",
  "code": "<!DOCTYPE html>\n<!--\n  Gruppert materiale — Halison App Studio-eksempel\n\n  Interaktivt læremiddel for matematikk 2P (LK20): gjennomsnitt, medianklasse og\n  standardavvik for grupperte data, med klassemidtpunkter og histogram.\n\n  Fra Halison App Studio sitt offentlige bibliotek:\n  https://github.com/halisonworks/public-app-studio\n\n  Tillatt bruk: personlig, pedagogisk og annen ikke-kommersiell bruk. Behold denne\n  headeren og kildelenken; ikke-kommersiell bruk. Utgitt under Halison App Studio\n  Examples License — se LICENSE-filen i repoet over.\n-->\n<html lang=\"no\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Sentralmål i gruppert materiale — 2P</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Segoe UI', system-ui, sans-serif; }\n    .formula { font-family: 'Courier New', monospace; }\n    input[type=\"number\"] { -moz-appearance: textfield; }\n    input[type=\"number\"]::-webkit-outer-spin-button,\n    input[type=\"number\"]::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }\n    .result-card { transition: all 0.3s ease; }\n    .highlight-row { background-color: #fef9c3; }\n    svg text { font-family: 'Segoe UI', system-ui, sans-serif; }\n  </style>\n</head>\n<body class=\"bg-gray-50 min-h-screen\">\n\n  <!-- HEADER -->\n  <header class=\"bg-blue-700 text-white py-5 px-4 shadow-md\">\n    <div class=\"max-w-4xl mx-auto\">\n      <p class=\"text-blue-200 text-sm font-medium uppercase tracking-wide mb-1\">Matematikk 2P · LK20 · Kap. 3.7–3.8</p>\n      <h1 class=\"text-2xl sm:text-3xl font-bold\">Sentralmål i et gruppert materiale</h1>\n      <p class=\"text-blue-100 mt-1 text-sm sm:text-base\">Gjennomsnitt, medianklasse og standardavvik med klassemidtpunkter</p>\n    </div>\n  </header>\n\n  <main class=\"max-w-4xl mx-auto px-4 py-6 space-y-8\">\n\n    <!-- FORKLARING -->\n    <section class=\"bg-blue-50 border border-blue-200 rounded-xl p-5\">\n      <h2 class=\"text-lg font-semibold text-blue-800 mb-2\">Hvorfor bruker vi klassemidtpunkter?</h2>\n      <p class=\"text-gray-700 text-sm sm:text-base leading-relaxed\">\n        Når data er gruppert i klasser (intervaller), kjenner vi ikke den eksakte verdien til hvert datapunkt.\n        Vi <strong>antar</strong> at alle verdiene i en klasse er jevnt fordelt, og bruker derfor\n        <strong>klassemidtpunktet</strong> — midten av intervallet — som representativ verdi for klassen.\n        Dette gir oss <em>estimater</em> for gjennomsnitt og standardavvik, ikke eksakte verdier.\n        Jo smalere klassene er, desto bedre er estimatene.\n      </p>\n      <p class=\"mt-2 text-sm text-blue-700 font-medium\">\n        Klassemidtpunkt = (nedre grense + øvre grense) / 2\n      </p>\n    </section>\n\n    <!-- DATAINNTASTING -->\n    <section class=\"bg-white rounded-xl shadow-sm border border-gray-200 p-5\">\n      <h2 class=\"text-xl font-semibold text-gray-800 mb-1\">Klasseintervaller og frekvenser</h2>\n      <p class=\"text-gray-500 text-sm mb-4\">Rediger tabellen nedenfor. Klikk «Legg til klasse» for å legge til en rad, eller «×» for å fjerne en.</p>\n\n      <div class=\"overflow-x-auto\">\n        <table class=\"w-full text-sm\" id=\"inputTable\">\n          <thead>\n            <tr class=\"bg-gray-100 text-gray-600 uppercase text-xs\">\n              <th class=\"py-2 px-3 text-left rounded-tl-lg\">Fra</th>\n              <th class=\"py-2 px-3 text-left\">Til</th>\n              <th class=\"py-2 px-3 text-left\">Frekvens</th>\n              <th class=\"py-2 px-3 rounded-tr-lg\"></th>\n            </tr>\n          </thead>\n          <tbody id=\"inputBody\">\n          </tbody>\n        </table>\n      </div>\n\n      <div class=\"flex flex-wrap gap-3 mt-4\">\n        <button onclick=\"addRow()\" class=\"bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium py-2 px-4 rounded-lg transition\">\n          + Legg til klasse\n        </button>\n        <button onclick=\"calculate()\" class=\"bg-green-600 hover:bg-green-700 text-white text-sm font-medium py-2 px-4 rounded-lg transition\">\n          Beregn →\n        </button>\n        <button onclick=\"resetToExample()\" class=\"bg-gray-200 hover:bg-gray-300 text-gray-700 text-sm font-medium py-2 px-4 rounded-lg transition\">\n          Tilbakestill eksempel\n        </button>\n      </div>\n    </section>\n\n    <!-- RESULTATER -->\n    <div id=\"results\" class=\"hidden space-y-8\">\n\n      <!-- BEREGNINGSTABELLEN -->\n      <section class=\"bg-white rounded-xl shadow-sm border border-gray-200 p-5\">\n        <h2 class=\"text-xl font-semibold text-gray-800 mb-1\">Beregningstabell</h2>\n        <p class=\"text-gray-500 text-sm mb-4\">\n          Medianklassen er uthevet i gult — den klassen der kumulativ frekvens når halvparten av totalen.\n        </p>\n        <div class=\"overflow-x-auto\">\n          <table class=\"w-full text-sm\" id=\"calcTable\">\n            <thead>\n              <tr class=\"bg-gray-100 text-gray-600 uppercase text-xs\">\n                <th class=\"py-2 px-3 text-left rounded-tl-lg\">Klasse</th>\n                <th class=\"py-2 px-3 text-right\">Midtpunkt (mᵢ)</th>\n                <th class=\"py-2 px-3 text-right\">Frekvens (fᵢ)</th>\n                <th class=\"py-2 px-3 text-right\">Kumulativ freq.</th>\n                <th class=\"py-2 px-3 text-right\">mᵢ · fᵢ</th>\n                <th class=\"py-2 px-3 text-right rounded-tr-lg\">(mᵢ − x̄)² · fᵢ</th>\n              </tr>\n            </thead>\n            <tbody id=\"calcBody\"></tbody>\n            <tfoot id=\"calcFoot\"></tfoot>\n          </table>\n        </div>\n      </section>\n\n      <!-- FORMLER OG RESULTATER -->\n      <section class=\"grid grid-cols-1 sm:grid-cols-3 gap-4\">\n\n        <div class=\"result-card bg-green-50 border border-green-200 rounded-xl p-5\">\n          <h3 class=\"text-green-800 font-semibold text-base mb-2\">Gjennomsnitt (x̄)</h3>\n          <div class=\"formula text-xs text-gray-600 mb-3 bg-white rounded p-2 border border-green-100\">\n            x̄ = Σ(mᵢ · fᵢ) / Σfᵢ\n          </div>\n          <p id=\"meanResult\" class=\"text-2xl font-bold text-green-700\"></p>\n          <p id=\"meanWork\" class=\"text-xs text-gray-500 mt-1\"></p>\n        </div>\n\n        <div class=\"result-card bg-yellow-50 border border-yellow-200 rounded-xl p-5\">\n          <h3 class=\"text-yellow-800 font-semibold text-base mb-2\">Medianklasse</h3>\n          <div class=\"formula text-xs text-gray-600 mb-3 bg-white rounded p-2 border border-yellow-100\">\n            Finn klassen der kumulativ<br/>frekvens ≥ n/2\n          </div>\n          <p id=\"medianResult\" class=\"text-xl font-bold text-yellow-700\"></p>\n          <p id=\"medianWork\" class=\"text-xs text-gray-500 mt-1\"></p>\n        </div>\n\n        <div class=\"result-card bg-purple-50 border border-purple-200 rounded-xl p-5\">\n          <h3 class=\"text-purple-800 font-semibold text-base mb-2\">Standardavvik (s)</h3>\n          <div class=\"formula text-xs text-gray-600 mb-3 bg-white rounded p-2 border border-purple-100\">\n            s = √(Σ(mᵢ−x̄)²·fᵢ / Σfᵢ)\n          </div>\n          <p id=\"stdResult\" class=\"text-2xl font-bold text-purple-700\"></p>\n          <p id=\"stdWork\" class=\"text-xs text-gray-500 mt-1\"></p>\n        </div>\n\n      </section>\n\n      <!-- UTREGNINGSSKRITT (vis/skjul) -->\n      <section class=\"bg-white rounded-xl shadow-sm border border-gray-200 p-5\">\n        <button onclick=\"toggleSteps()\" class=\"flex items-center gap-2 text-blue-700 font-semibold text-sm hover:text-blue-900 transition\" id=\"stepsToggleBtn\">\n          <span id=\"stepsArrow\">▶</span> Vis utregningsskritt\n        </button>\n        <div id=\"stepsContent\" class=\"hidden mt-4 space-y-4 text-sm text-gray-700\">\n          <div>\n            <p class=\"font-semibold text-gray-800 mb-1\">Steg 1 — Beregn klassemidtpunkter</p>\n            <p id=\"step1\"></p>\n          </div>\n          <div>\n            <p class=\"font-semibold text-gray-800 mb-1\">Steg 2 — Beregn mᵢ · fᵢ og summer</p>\n            <p id=\"step2\"></p>\n          </div>\n          <div>\n            <p class=\"font-semibold text-gray-800 mb-1\">Steg 3 — Gjennomsnitt</p>\n            <p id=\"step3\" class=\"formula\"></p>\n          </div>\n          <div>\n            <p class=\"font-semibold text-gray-800 mb-1\">Steg 4 — Medianklasse</p>\n            <p id=\"step4\"></p>\n          </div>\n          <div>\n            <p class=\"font-semibold text-gray-800 mb-1\">Steg 5 — Standardavvik</p>\n            <p id=\"step5\" class=\"formula\"></p>\n          </div>\n        </div>\n      </section>\n\n      <!-- HISTOGRAM -->\n      <section class=\"bg-white rounded-xl shadow-sm border border-gray-200 p-5\">\n        <h2 class=\"text-xl font-semibold text-gray-800 mb-1\">Histogram</h2>\n        <p class=\"text-gray-500 text-sm mb-4\">Den loddrette røde linjen viser gjennomsnittet.</p>\n        <div id=\"histogramContainer\" class=\"w-full overflow-x-auto\"></div>\n      </section>\n\n    </div>\n\n    <!-- ERROR MELDING -->\n    <div id=\"errorBox\" class=\"hidden bg-red-50 border border-red-300 rounded-xl p-4 text-red-700 text-sm\"></div>\n\n  </main>\n\n  <footer class=\"mt-12 py-6 border-t border-gray-200 text-center text-xs text-gray-400\">\n    Matematikk 2P · LK20 · Sinus kap. 3.7–3.8 · Halison App Studio-eksempel ·\n    <a href=\"https://github.com/halisonworks/public-app-studio\" class=\"underline hover:text-gray-600\">github.com/halisonworks/public-app-studio</a>\n  </footer>\n\n<script>\n// ─── STATE ────────────────────────────────────────────────────────────────────\nlet rows = [];\n\n// ─── DEFAULT EXAMPLE DATA ────────────────────────────────────────────────────\nconst exampleData = [\n  { from: 0,   to: 10,  freq: 3  },\n  { from: 10,  to: 20,  freq: 7  },\n  { from: 20,  to: 30,  freq: 12 },\n  { from: 30,  to: 40,  freq: 15 },\n  { from: 40,  to: 50,  freq: 9  },\n  { from: 50,  to: 60,  freq: 4  },\n];\n\n// ─── HELPERS ─────────────────────────────────────────────────────────────────\nfunction fmt(n, d = 2) {\n  return Number(n).toFixed(d);\n}\n\nfunction fmtNO(n, d = 2) {\n  // Norwegian decimal comma\n  return fmt(n, d).replace('.', ',');\n}\n\n// ─── ROW MANAGEMENT ──────────────────────────────────────────────────────────\nfunction renderInputTable() {\n  const tbody = document.getElementById('inputBody');\n  tbody.innerHTML = '';\n  rows.forEach((r, i) => {\n    const tr = document.createElement('tr');\n    tr.className = i % 2 === 0 ? 'bg-white' : 'bg-gray-50';\n    tr.innerHTML = `\n      <td class=\"py-1 px-3\">\n        <input type=\"number\" value=\"${r.from}\"\n          class=\"w-20 border border-gray-300 rounded px-2 py-1 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\"\n          onchange=\"updateRow(${i},'from',this.value)\" />\n      </td>\n      <td class=\"py-1 px-3\">\n        <input type=\"number\" value=\"${r.to}\"\n          class=\"w-20 border border-gray-300 rounded px-2 py-1 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\"\n          onchange=\"updateRow(${i},'to',this.value)\" />\n      </td>\n      <td class=\"py-1 px-3\">\n        <input type=\"number\" min=\"0\" value=\"${r.freq}\"\n          class=\"w-20 border border-gray-300 rounded px-2 py-1 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\"\n          onchange=\"updateRow(${i},'freq',this.value)\" />\n      </td>\n      <td class=\"py-1 px-2\">\n        ${rows.length > 2\n          ? `<button onclick=\"removeRow(${i})\"\n               class=\"text-red-400 hover:text-red-600 font-bold text-base leading-none px-2 py-1 rounded hover:bg-red-50 transition\"\n               title=\"Fjern rad\">×</button>`\n          : ''}\n      </td>`;\n    tbody.appendChild(tr);\n  });\n}\n\nfunction addRow() {\n  const last = rows[rows.length - 1];\n  const width = last ? (last.to - last.from) : 10;\n  rows.push({ from: last ? last.to : 0, to: last ? last.to + width : 10, freq: 1 });\n  renderInputTable();\n  hideResults();\n}\n\nfunction removeRow(i) {\n  rows.splice(i, 1);\n  renderInputTable();\n  hideResults();\n}\n\nfunction updateRow(i, field, val) {\n  rows[i][field] = parseFloat(val) || 0;\n  hideResults();\n}\n\nfunction resetToExample() {\n  rows = exampleData.map(r => ({ ...r }));\n  renderInputTable();\n  hideResults();\n  document.getElementById('errorBox').classList.add('hidden');\n}\n\nfunction hideResults() {\n  document.getElementById('results').classList.add('hidden');\n}\n\n// ─── VALIDATION ──────────────────────────────────────────────────────────────\nfunction validate() {\n  if (rows.length < 2) return 'Du trenger minst 2 klasser.';\n  for (let i = 0; i < rows.length; i++) {\n    const r = rows[i];\n    if (r.from >= r.to) return `Rad ${i + 1}: «Fra» må være mindre enn «Til».`;\n    if (r.freq < 0) return `Rad ${i + 1}: Frekvens kan ikke være negativ.`;\n  }\n  // Check contiguous (warning only — we don't block)\n  const totalFreq = rows.reduce((s, r) => s + r.freq, 0);\n  if (totalFreq === 0) return 'Total frekvens er 0 — legg inn frekvenser.';\n  return null;\n}\n\n// ─── MAIN CALCULATION ────────────────────────────────────────────────────────\nfunction calculate() {\n  const errBox = document.getElementById('errorBox');\n  errBox.classList.add('hidden');\n\n  const err = validate();\n  if (err) {\n    errBox.textContent = 'Feil: ' + err;\n    errBox.classList.remove('hidden');\n    return;\n  }\n\n  const n = rows.reduce((s, r) => s + r.freq, 0);\n  let cumFreq = 0;\n  let sumMF = 0;\n  const processed = rows.map(r => {\n    const mid = (r.from + r.to) / 2;\n    const mf = mid * r.freq;\n    cumFreq += r.freq;\n    sumMF += mf;\n    return { ...r, mid, mf, cum: cumFreq };\n  });\n\n  const mean = sumMF / n;\n\n  // Standard deviation (population std for grouped data)\n  let sumSqDev = 0;\n  processed.forEach(r => {\n    sumSqDev += Math.pow(r.mid - mean, 2) * r.freq;\n  });\n  const std = Math.sqrt(sumSqDev / n);\n\n  // Median class: first class where cumulative freq >= n/2\n  const halfN = n / 2;\n  const medianRow = processed.find(r => r.cum >= halfN);\n\n  // ── Render calc table ────────────────────────────────────────────────────\n  const tbody = document.getElementById('calcBody');\n  tbody.innerHTML = '';\n  processed.forEach(r => {\n    const isMedian = r === medianRow;\n    const sqDev = Math.pow(r.mid - mean, 2) * r.freq;\n    const tr = document.createElement('tr');\n    tr.className = isMedian\n      ? 'highlight-row border-t border-yellow-300'\n      : 'border-t border-gray-100 hover:bg-gray-50';\n    tr.innerHTML = `\n      <td class=\"py-2 px-3 font-medium\">${r.from}–${r.to}${isMedian ? ' <span class=\"text-xs text-yellow-600 font-normal\">(medianklasse)</span>' : ''}</td>\n      <td class=\"py-2 px-3 text-right\">${fmtNO(r.mid, 1)}</td>\n      <td class=\"py-2 px-3 text-right\">${r.freq}</td>\n      <td class=\"py-2 px-3 text-right\">${r.cum}</td>\n      <td class=\"py-2 px-3 text-right\">${fmtNO(r.mf, 2)}</td>\n      <td class=\"py-2 px-3 text-right\">${fmtNO(sqDev, 4)}</td>`;\n    tbody.appendChild(tr);\n  });\n\n  const tfoot = document.getElementById('calcFoot');\n  tfoot.innerHTML = `\n    <tr class=\"bg-gray-100 font-semibold border-t-2 border-gray-300\">\n      <td class=\"py-2 px-3 text-gray-700\">Sum</td>\n      <td class=\"py-2 px-3 text-right text-gray-400 text-xs\">—</td>\n      <td class=\"py-2 px-3 text-right\">${n}</td>\n      <td class=\"py-2 px-3 text-right text-gray-400 text-xs\">—</td>\n      <td class=\"py-2 px-3 text-right\">${fmtNO(sumMF, 2)}</td>\n      <td class=\"py-2 px-3 text-right\">${fmtNO(sumSqDev, 4)}</td>\n    </tr>`;\n\n  // ── Result cards ─────────────────────────────────────────────────────────\n  document.getElementById('meanResult').textContent = fmtNO(mean, 2);\n  document.getElementById('meanWork').textContent =\n    `${fmtNO(sumMF, 2)} ÷ ${n} = ${fmtNO(mean, 4)}`;\n\n  document.getElementById('medianResult').textContent =\n    medianRow ? `[${medianRow.from}, ${medianRow.to})` : '—';\n  document.getElementById('medianWork').textContent =\n    medianRow\n      ? `n/2 = ${fmtNO(halfN, 1)}, kumulativ når ${medianRow.cum} i denne klassen`\n      : '';\n\n  document.getElementById('stdResult').textContent = fmtNO(std, 2);\n  document.getElementById('stdWork').textContent =\n    `√(${fmtNO(sumSqDev, 2)} ÷ ${n}) = √${fmtNO(sumSqDev / n, 4)} ≈ ${fmtNO(std, 4)}`;\n\n  // ── Detailed steps ────────────────────────────────────────────────────────\n  document.getElementById('step1').innerHTML = processed\n    .map(r => `(${r.from} + ${r.to}) / 2 = <strong>${fmtNO(r.mid, 1)}</strong>`)\n    .join(' &nbsp;|&nbsp; ');\n\n  document.getElementById('step2').innerHTML = processed\n    .map(r => `${fmtNO(r.mid, 1)} · ${r.freq} = ${fmtNO(r.mf, 2)}`)\n    .join(' + ')\n    + ` = <strong>${fmtNO(sumMF, 2)}</strong>`;\n\n  document.getElementById('step3').textContent =\n    `x̄ = ${fmtNO(sumMF, 2)} / ${n} ≈ ${fmtNO(mean, 2)}`;\n\n  document.getElementById('step4').innerHTML =\n    `n = ${n}, n/2 = ${fmtNO(halfN, 1)}. ` +\n    `Kumulativ frekvens når ${halfN} først i klassen ` +\n    (medianRow ? `<strong>[${medianRow.from}, ${medianRow.to})</strong> (kum. = ${medianRow.cum}).` : '—');\n\n  document.getElementById('step5').textContent =\n    `s = √(${fmtNO(sumSqDev, 4)} / ${n}) = √${fmtNO(sumSqDev / n, 6)} ≈ ${fmtNO(std, 2)}`;\n\n  // ── Histogram ─────────────────────────────────────────────────────────────\n  renderHistogram(processed, mean, n);\n\n  // ── Show results ──────────────────────────────────────────────────────────\n  document.getElementById('results').classList.remove('hidden');\n  document.getElementById('results').scrollIntoView({ behavior: 'smooth', block: 'start' });\n}\n\n// ─── HISTOGRAM ───────────────────────────────────────────────────────────────\nfunction renderHistogram(data, mean, n) {\n  const container = document.getElementById('histogramContainer');\n\n  const W = 680, H = 360;\n  const marginL = 60, marginR = 30, marginT = 20, marginB = 60;\n  const plotW = W - marginL - marginR;\n  const plotH = H - marginT - marginB;\n\n  const minX = data[0].from;\n  const maxX = data[data.length - 1].to;\n  const xRange = maxX - minX;\n  const maxFreq = Math.max(...data.map(r => r.freq));\n  const yMax = Math.ceil(maxFreq * 1.15);\n\n  // Scale helpers\n  const xScale = x => marginL + ((x - minX) / xRange) * plotW;\n  const yScale = f => marginT + plotH - (f / yMax) * plotH;\n\n  // Y-axis ticks\n  const yTicks = [];\n  const yStep = yMax <= 10 ? 1 : yMax <= 20 ? 2 : yMax <= 50 ? 5 : 10;\n  for (let y = 0; y <= yMax; y += yStep) yTicks.push(y);\n\n  // X-axis labels\n  const xLabels = data.map(r => r.from);\n  xLabels.push(data[data.length - 1].to);\n\n  // Bar colours — median class gets amber\n  const medianFrom = data.find(r => r.cum >= n / 2);\n\n  let bars = '';\n  data.forEach(r => {\n    const x1 = xScale(r.from);\n    const x2 = xScale(r.to);\n    const barW = x2 - x1;\n    const barTop = yScale(r.freq);\n    const barH = yScale(0) - barTop;\n    const isMedian = r === medianFrom;\n    const fill = isMedian ? '#fbbf24' : '#3b82f6';\n    const stroke = isMedian ? '#d97706' : '#1d4ed8';\n    bars += `<rect x=\"${x1}\" y=\"${barTop}\" width=\"${barW}\" height=\"${barH}\"\n      fill=\"${fill}\" stroke=\"${stroke}\" stroke-width=\"1.5\" opacity=\"0.85\" />`;\n    // Frequency label on bar\n    if (barH > 14) {\n      bars += `<text x=\"${x1 + barW / 2}\" y=\"${barTop - 4}\" text-anchor=\"middle\"\n        font-size=\"11\" fill=\"#374151\" font-weight=\"600\">${r.freq}</text>`;\n    }\n  });\n\n  // Mean line\n  const meanX = xScale(mean);\n  const meanLine = `\n    <line x1=\"${meanX}\" y1=\"${marginT}\" x2=\"${meanX}\" y2=\"${yScale(0)}\"\n      stroke=\"#ef4444\" stroke-width=\"2\" stroke-dasharray=\"5,4\" />\n    <text x=\"${meanX + 4}\" y=\"${marginT + 14}\" font-size=\"11\" fill=\"#ef4444\" font-weight=\"600\">x̄ = ${fmtNO(mean, 1)}</text>`;\n\n  // Y-axis lines and labels\n  let yAxisLines = '';\n  yTicks.forEach(y => {\n    const yy = yScale(y);\n    yAxisLines += `\n      <line x1=\"${marginL}\" y1=\"${yy}\" x2=\"${marginL + plotW}\" y2=\"${yy}\"\n        stroke=\"#e5e7eb\" stroke-width=\"${y === 0 ? 0 : 1}\" />\n      <text x=\"${marginL - 8}\" y=\"${yy + 4}\" text-anchor=\"end\" font-size=\"11\" fill=\"#6b7280\">${y}</text>`;\n  });\n\n  // X-axis labels\n  let xAxisLabels = '';\n  xLabels.forEach(x => {\n    xAxisLabels += `\n      <text x=\"${xScale(x)}\" y=\"${yScale(0) + 18}\" text-anchor=\"middle\" font-size=\"11\" fill=\"#6b7280\">${x}</text>`;\n  });\n\n  // Axis lines\n  const axes = `\n    <line x1=\"${marginL}\" y1=\"${marginT}\" x2=\"${marginL}\" y2=\"${yScale(0)}\"\n      stroke=\"#9ca3af\" stroke-width=\"1.5\" />\n    <line x1=\"${marginL}\" y1=\"${yScale(0)}\" x2=\"${marginL + plotW}\" y2=\"${yScale(0)}\"\n      stroke=\"#9ca3af\" stroke-width=\"1.5\" />`;\n\n  // Axis titles\n  const axisTitle = `\n    <text x=\"${marginL + plotW / 2}\" y=\"${H - 6}\" text-anchor=\"middle\" font-size=\"12\" fill=\"#374151\">Klasseintervall</text>\n    <text x=\"14\" y=\"${marginT + plotH / 2}\" text-anchor=\"middle\" font-size=\"12\" fill=\"#374151\"\n      transform=\"rotate(-90, 14, ${marginT + plotH / 2})\">Frekvens</text>`;\n\n  // Legend\n  const legY = marginT + 6;\n  const legend = `\n    <rect x=\"${W - marginR - 160}\" y=\"${legY}\" width=\"12\" height=\"12\" fill=\"#3b82f6\" stroke=\"#1d4ed8\" stroke-width=\"1\" rx=\"2\"/>\n    <text x=\"${W - marginR - 144}\" y=\"${legY + 10}\" font-size=\"11\" fill=\"#374151\">Frekvens</text>\n    <rect x=\"${W - marginR - 80}\" y=\"${legY}\" width=\"12\" height=\"12\" fill=\"#fbbf24\" stroke=\"#d97706\" stroke-width=\"1\" rx=\"2\"/>\n    <text x=\"${W - marginR - 64}\" y=\"${legY + 10}\" font-size=\"11\" fill=\"#374151\">Medianklasse</text>`;\n\n  const svg = `\n<svg viewBox=\"0 0 ${W} ${H}\" xmlns=\"http://www.w3.org/2000/svg\"\n  class=\"w-full max-w-full\" style=\"min-width:300px\">\n  ${yAxisLines}\n  ${axes}\n  ${bars}\n  ${meanLine}\n  ${xAxisLabels}\n  ${axisTitle}\n  ${legend}\n</svg>`;\n\n  container.innerHTML = svg;\n}\n\n// ─── TOGGLE STEPS ────────────────────────────────────────────────────────────\nfunction toggleSteps() {\n  const content = document.getElementById('stepsContent');\n  const arrow = document.getElementById('stepsArrow');\n  const btn = document.getElementById('stepsToggleBtn');\n  const isHidden = content.classList.contains('hidden');\n  content.classList.toggle('hidden');\n  arrow.textContent = isHidden ? '▼' : '▶';\n  btn.querySelector('span + span') && (btn.querySelectorAll('span')[1].textContent =\n    isHidden ? 'Skjul utregningsskritt' : 'Vis utregningsskritt');\n  // Simpler: just update the button text node\n  btn.childNodes.forEach(n => {\n    if (n.nodeType === 3) n.textContent = isHidden ? ' Skjul utregningsskritt' : ' Vis utregningsskritt';\n  });\n}\n\n// ─── INIT ────────────────────────────────────────────────────────────────────\nresetToExample();\n</script>\n</body>\n</html>\n",
