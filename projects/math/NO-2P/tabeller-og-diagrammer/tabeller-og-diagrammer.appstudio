{
  "schema": "app-studio/canvas@1",
  "id": "example-no2p-tabeller-og-diagrammer",
  "name": "tabeller-og-diagrammer.html",
  "code": "<!DOCTYPE html>\n<!--\n  Tabeller og diagrammer — Halison App Studio-eksempel\n\n  Interaktivt læremiddel for matematikk 2P (LK20): frekvenstabell med relativ og\n  kumulativ frekvens, og søyle-, kurve- og sektordiagram av samme data.\n\n  Fra Halison App Studio sitt offentlige bibliotek:\n  https://github.com/halisonworks/public-app-studio\n\n  Tillatt bruk: personlig, pedagogisk og annen ikke-kommersiell bruk. Behold denne\n  headeren og kildelenken; ikke-kommersiell bruk. Utgitt under Halison App Studio\n  Examples License — se LICENSE-filen i repoet over.\n-->\n<html lang=\"no\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Tabeller og diagrammer – Matematikk 2P</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Segoe UI', system-ui, sans-serif; }\n    .tab-btn.active { background-color: #2563eb; color: #fff; }\n    .tab-btn { transition: background 0.15s, color 0.15s; }\n    input[type=\"text\"], input[type=\"number\"] {\n      border: 1px solid #d1d5db;\n      border-radius: 0.375rem;\n      padding: 0.25rem 0.5rem;\n      width: 100%;\n      font-size: 0.95rem;\n    }\n    input[type=\"text\"]:focus, input[type=\"number\"]:focus {\n      outline: 2px solid #2563eb;\n      outline-offset: 1px;\n    }\n    svg text { font-family: 'Segoe UI', system-ui, sans-serif; }\n    .diagram-hint { background: #eff6ff; border-left: 4px solid #2563eb; }\n    table thead tr { background: #1e40af; color: #fff; }\n    table tbody tr:nth-child(even) { background: #f0f4ff; }\n    table tfoot tr { background: #dbeafe; font-weight: 700; }\n    .remove-btn:hover { background: #fee2e2; }\n    @media (max-width: 640px) {\n      .svg-wrap svg { width: 100%; height: auto; }\n    }\n  </style>\n</head>\n<body class=\"bg-gray-50 min-h-screen\">\n\n<!-- Header -->\n<header class=\"bg-blue-800 text-white py-4 px-4 shadow\">\n  <div class=\"max-w-4xl mx-auto\">\n    <div class=\"flex items-center gap-3\">\n      <span class=\"text-3xl\">📊</span>\n      <div>\n        <h1 class=\"text-xl font-bold leading-tight\">Tabeller og diagrammer</h1>\n        <p class=\"text-blue-200 text-sm\">Matematikk 2P · Kapittel 2 · LK20</p>\n      </div>\n    </div>\n  </div>\n</header>\n\n<main class=\"max-w-4xl mx-auto px-3 py-6 space-y-6\">\n\n  <!-- Datainntasting -->\n  <section class=\"bg-white rounded-xl shadow p-4 space-y-4\">\n    <div class=\"flex items-center justify-between flex-wrap gap-2\">\n      <h2 class=\"text-lg font-bold text-blue-900\">Legg inn data</h2>\n      <div class=\"flex gap-2 flex-wrap\">\n        <button id=\"btn-load-sample\" class=\"text-sm bg-blue-100 hover:bg-blue-200 text-blue-800 px-3 py-1.5 rounded-lg font-medium\">Last eksempeldata</button>\n        <button id=\"btn-clear-all\" class=\"text-sm bg-red-100 hover:bg-red-200 text-red-800 px-3 py-1.5 rounded-lg font-medium\">Tøm alle rader</button>\n      </div>\n    </div>\n\n    <p class=\"text-sm text-gray-600\">Skriv inn kategorier/verdier og antall observasjoner (frekvens). Minst to rader kreves.</p>\n\n    <div class=\"overflow-x-auto\">\n      <table class=\"w-full text-sm\" id=\"input-table\">\n        <thead>\n          <tr>\n            <th class=\"text-left py-2 px-3 rounded-tl-lg w-1/2\">Verdi / Kategori</th>\n            <th class=\"text-left py-2 px-3 w-1/3\">Frekvens (antall)</th>\n            <th class=\"py-2 px-3 rounded-tr-lg w-16\"></th>\n          </tr>\n        </thead>\n        <tbody id=\"input-tbody\">\n          <!-- rows injected by JS -->\n        </tbody>\n      </table>\n    </div>\n\n    <button id=\"btn-add-row\" class=\"flex items-center gap-2 text-sm bg-green-100 hover:bg-green-200 text-green-800 px-3 py-1.5 rounded-lg font-medium\">\n      <span class=\"text-lg leading-none\">+</span> Legg til rad\n    </button>\n  </section>\n\n  <!-- Frekvenstabell -->\n  <section class=\"bg-white rounded-xl shadow p-4 space-y-3\" id=\"freq-section\">\n    <h2 class=\"text-lg font-bold text-blue-900\">Frekvenstabell</h2>\n    <div class=\"overflow-x-auto\">\n      <table class=\"w-full text-sm border-collapse rounded-lg overflow-hidden\" id=\"freq-table\">\n        <thead>\n          <tr>\n            <th class=\"text-left py-2 px-3\">Verdi / Kategori</th>\n            <th class=\"text-right py-2 px-3\">Frekvens</th>\n            <th class=\"text-right py-2 px-3\">Relativ frekvens (%)</th>\n            <th class=\"text-right py-2 px-3\">Kumulativ frekvens</th>\n          </tr>\n        </thead>\n        <tbody id=\"freq-tbody\">\n        </tbody>\n        <tfoot id=\"freq-tfoot\">\n        </tfoot>\n      </table>\n    </div>\n    <div id=\"freq-error\" class=\"text-red-600 text-sm hidden\"></div>\n  </section>\n\n  <!-- Diagrammer -->\n  <section class=\"bg-white rounded-xl shadow p-4 space-y-4\" id=\"diagram-section\">\n    <h2 class=\"text-lg font-bold text-blue-900\">Diagrammer</h2>\n\n    <!-- Diagram tabs -->\n    <div class=\"flex gap-2 flex-wrap\">\n      <button class=\"tab-btn active px-4 py-2 rounded-lg text-sm font-medium bg-gray-100 text-gray-700\" data-tab=\"soyle\">Søylediagram</button>\n      <button class=\"tab-btn px-4 py-2 rounded-lg text-sm font-medium bg-gray-100 text-gray-700\" data-tab=\"kurve\">Kurvediagram</button>\n      <button class=\"tab-btn px-4 py-2 rounded-lg text-sm font-medium bg-gray-100 text-gray-700\" data-tab=\"sektor\">Sektordiagram</button>\n    </div>\n\n    <!-- Hint boxes -->\n    <div id=\"hint-soyle\" class=\"diagram-hint rounded-lg px-4 py-3 text-sm text-blue-900\">\n      <strong>Søylediagram</strong> passer best når du vil sammenligne kategorier eller diskrete verdier. Hver søyle representerer én kategori, og høyden viser frekvensen. Brukes gjerne for data som ikke er kontinuerlige (f.eks. karakterer, favorittsport, bilmerker).\n    </div>\n    <div id=\"hint-kurve\" class=\"diagram-hint rounded-lg px-4 py-3 text-sm text-blue-900 hidden\">\n      <strong>Kurvediagram</strong> (linjediagram) er egnet når du vil vise utvikling over tid eller en sammenheng mellom verdier som henger naturlig sammen. Punktene kobles med linjer, noe som gir inntrykk av en kontinuerlig utvikling (f.eks. temperatur over dager, salg per måned).\n    </div>\n    <div id=\"hint-sektor\" class=\"diagram-hint rounded-lg px-4 py-3 text-sm text-blue-900 hidden\">\n      <strong>Sektordiagram</strong> (kakediagram) viser hvordan en helhet er fordelt på ulike deler. Hvert stykke av \"kaken\" svarer til den relative frekvensen til kategorien i prosent. Brukes når du har få kategorier og vil fremheve andeler av totalen (f.eks. fordeling av matpreferanser i en klasse).\n    </div>\n\n    <!-- SVG diagrams -->\n    <div class=\"svg-wrap\" id=\"svg-container\">\n      <!-- SVG injected by JS -->\n    </div>\n  </section>\n\n  <!-- Forklaring av begreper -->\n  <section class=\"bg-blue-50 border border-blue-200 rounded-xl p-4 space-y-3\">\n    <h2 class=\"text-lg font-bold text-blue-900\">Faglige begreper</h2>\n    <dl class=\"space-y-2 text-sm text-gray-800\">\n      <div>\n        <dt class=\"font-semibold text-blue-800\">Frekvens</dt>\n        <dd>Antall ganger en verdi eller kategori forekommer i datamaterialet.</dd>\n      </div>\n      <div>\n        <dt class=\"font-semibold text-blue-800\">Relativ frekvens</dt>\n        <dd>Frekvensen delt på totalt antall observasjoner, uttrykt i prosent. Viser andelen av totalen. Formel: <em>f<sub>rel</sub> = (f / n) × 100 %</em></dd>\n      </div>\n      <div>\n        <dt class=\"font-semibold text-blue-800\">Kumulativ frekvens</dt>\n        <dd>Den løpende summen av frekvenser. Forteller hvor mange observasjoner som er lik eller mindre enn en gitt verdi. Gir mening for ordnede data (f.eks. tallverdier).</dd>\n      </div>\n    </dl>\n  </section>\n\n</main>\n\n<footer class=\"text-center text-xs text-gray-400 py-4 mt-2\">\n  Matematikk 2P · Tabeller og diagrammer · Halison App Studio\n</footer>\n\n<script>\n(function () {\n  'use strict';\n\n  // ── Palette for diagrams ───────────────────────────────────────────────────\n  const PALETTE = [\n    '#2563eb','#16a34a','#dc2626','#d97706','#7c3aed',\n    '#0891b2','#db2777','#65a30d','#ea580c','#4f46e5',\n    '#0d9488','#b45309','#9333ea','#0284c7','#15803d'\n  ];\n\n  // ── Sample data ────────────────────────────────────────────────────────────\n  const SAMPLE_DATA = [\n    { label: 'Fotball',      freq: 8  },\n    { label: 'Svømming',     freq: 5  },\n    { label: 'Håndball',     freq: 6  },\n    { label: 'Sykling',      freq: 4  },\n    { label: 'Løping',       freq: 7  },\n    { label: 'Ingen trening',freq: 3  }\n  ];\n\n  // ── State ──────────────────────────────────────────────────────────────────\n  let rows = [];           // [{label, freq}]\n  let activeTab = 'soyle';\n\n  // ── LocalStorage ──────────────────────────────────────────────────────────\n  function saveState() {\n    try { localStorage.setItem('tabdiag_rows', JSON.stringify(rows)); } catch(e){}\n  }\n  function loadState() {\n    try {\n      const s = localStorage.getItem('tabdiag_rows');\n      if (s) { const p = JSON.parse(s); if (Array.isArray(p) && p.length >= 1) return p; }\n    } catch(e){}\n    return null;\n  }\n\n  // ── Row management ─────────────────────────────────────────────────────────\n  function addRow(label = '', freq = '') {\n    rows.push({ label: String(label), freq: freq === '' ? '' : Number(freq) });\n  }\n\n  function removeRow(i) {\n    rows.splice(i, 1);\n    renderInputTable();\n    renderFreqTable();\n    renderDiagram();\n    saveState();\n  }\n\n  // ── Read current input values ──────────────────────────────────────────────\n  function syncRowsFromInputs() {\n    const tbody = document.getElementById('input-tbody');\n    const trs = tbody.querySelectorAll('tr');\n    rows = Array.from(trs).map(tr => {\n      const inputs = tr.querySelectorAll('input');\n      return {\n        label: inputs[0].value.trim(),\n        freq:  inputs[1].value === '' ? '' : parseFloat(inputs[1].value)\n      };\n    });\n  }\n\n  // ── Render input table ─────────────────────────────────────────────────────\n  function renderInputTable() {\n    const tbody = document.getElementById('input-tbody');\n    tbody.innerHTML = '';\n    rows.forEach(function(row, i) {\n      const tr = document.createElement('tr');\n      tr.className = 'border-b border-gray-100';\n      tr.innerHTML = `\n        <td class=\"py-1.5 px-3\">\n          <input type=\"text\" value=\"${escHtml(row.label)}\" placeholder=\"Kategori / verdi\" data-i=\"${i}\" data-field=\"label\" />\n        </td>\n        <td class=\"py-1.5 px-3\">\n          <input type=\"number\" value=\"${row.freq === '' ? '' : row.freq}\" min=\"0\" step=\"1\" placeholder=\"0\" data-i=\"${i}\" data-field=\"freq\" />\n        </td>\n        <td class=\"py-1.5 px-3 text-center\">\n          <button class=\"remove-btn text-red-400 hover:text-red-600 rounded px-2 py-1 text-lg leading-none transition\" data-remove=\"${i}\" title=\"Fjern rad\">✕</button>\n        </td>\n      `;\n      tbody.appendChild(tr);\n    });\n\n    // Bind input change\n    tbody.querySelectorAll('input').forEach(function(inp) {\n      inp.addEventListener('input', function() {\n        const idx  = parseInt(this.dataset.i);\n        const fld  = this.dataset.field;\n        if (fld === 'label') rows[idx].label = this.value.trim();\n        else rows[idx].freq = this.value === '' ? '' : parseFloat(this.value);\n        renderFreqTable();\n        renderDiagram();\n        saveState();\n      });\n    });\n\n    // Bind remove buttons\n    tbody.querySelectorAll('[data-remove]').forEach(function(btn) {\n      btn.addEventListener('click', function() {\n        removeRow(parseInt(this.dataset.remove));\n      });\n    });\n  }\n\n  // ── Build valid dataset (label + non-negative integer freq) ───────────────\n  function getValidData() {\n    return rows\n      .filter(r => r.label !== '' && r.freq !== '' && !isNaN(r.freq) && r.freq >= 0)\n      .map(r => ({ label: r.label, freq: Math.round(r.freq) }));\n  }\n\n  // ── Render frequency table ─────────────────────────────────────────────────\n  function renderFreqTable() {\n    const data   = getValidData();\n    const tbody  = document.getElementById('freq-tbody');\n    const tfoot  = document.getElementById('freq-tfoot');\n    const errDiv = document.getElementById('freq-error');\n\n    tbody.innerHTML = '';\n    tfoot.innerHTML = '';\n    errDiv.classList.add('hidden');\n    errDiv.textContent = '';\n\n    if (data.length < 2) {\n      errDiv.textContent = 'Fyll inn minst to rader med gyldig kategori og frekvens for å se frekvenstabellen.';\n      errDiv.classList.remove('hidden');\n      return;\n    }\n\n    const total = data.reduce((s, r) => s + r.freq, 0);\n    if (total === 0) {\n      errDiv.textContent = 'Total frekvens er 0 – skriv inn minst ett positivt tall.';\n      errDiv.classList.remove('hidden');\n      return;\n    }\n\n    let cumul = 0;\n    data.forEach(function(row) {\n      cumul += row.freq;\n      const relFreq = total > 0 ? (row.freq / total * 100) : 0;\n      const tr = document.createElement('tr');\n      tr.innerHTML = `\n        <td class=\"py-2 px-3\">${escHtml(row.label)}</td>\n        <td class=\"py-2 px-3 text-right\">${row.freq}</td>\n        <td class=\"py-2 px-3 text-right\">${relFreq.toFixed(1)} %</td>\n        <td class=\"py-2 px-3 text-right\">${cumul}</td>\n      `;\n      tbody.appendChild(tr);\n    });\n\n    // Totals row\n    const tftr = document.createElement('tr');\n    tftr.innerHTML = `\n      <td class=\"py-2 px-3\">Totalt</td>\n      <td class=\"py-2 px-3 text-right\">${total}</td>\n      <td class=\"py-2 px-3 text-right\">100,0 %</td>\n      <td class=\"py-2 px-3 text-right\">—</td>\n    `;\n    tfoot.appendChild(tftr);\n  }\n\n  // ── Render diagrams ────────────────────────────────────────────────────────\n  function renderDiagram() {\n    const container = document.getElementById('svg-container');\n    const data = getValidData();\n    if (data.length < 2) {\n      container.innerHTML = '<p class=\"text-gray-400 text-sm italic py-4\">Fyll inn minst to gyldige rader for å se diagrammet.</p>';\n      return;\n    }\n    if (activeTab === 'soyle')  container.innerHTML = buildBarSVG(data);\n    if (activeTab === 'kurve')  container.innerHTML = buildLineSVG(data);\n    if (activeTab === 'sektor') container.innerHTML = buildPieSVG(data);\n  }\n\n  // ── SVG helpers ────────────────────────────────────────────────────────────\n  const SVG_W = 700;\n  const SVG_H = 380;\n  const PAD_LEFT = 60;\n  const PAD_RIGHT = 20;\n  const PAD_TOP = 30;\n  const PAD_BOTTOM = 80;\n  const CHART_W = SVG_W - PAD_LEFT - PAD_RIGHT;\n  const CHART_H = SVG_H - PAD_TOP - PAD_BOTTOM;\n\n  function escHtml(s) {\n    return String(s)\n      .replace(/&/g,'&amp;')\n      .replace(/</g,'&lt;')\n      .replace(/>/g,'&gt;')\n      .replace(/\"/g,'&quot;')\n      .replace(/'/g,'&#39;');\n  }\n\n  function niceMax(val) {\n    if (val <= 0) return 10;\n    const mag = Math.pow(10, Math.floor(Math.log10(val)));\n    const norm = val / mag;\n    let nice;\n    if (norm <= 1) nice = 1;\n    else if (norm <= 2) nice = 2;\n    else if (norm <= 5) nice = 5;\n    else nice = 10;\n    return nice * mag;\n  }\n\n  function yTicks(maxVal) {\n    const nm = niceMax(maxVal);\n    const step = nm / 5;\n    const ticks = [];\n    for (let i = 0; i <= 5; i++) ticks.push(Math.round(step * i));\n    return ticks;\n  }\n\n  function buildBarSVG(data) {\n    const maxFreq = Math.max(...data.map(d => d.freq));\n    const ticks = yTicks(maxFreq);\n    const yMax  = ticks[ticks.length - 1];\n    const n = data.length;\n    const barW = Math.max(10, (CHART_W / n) * 0.6);\n    const gap  = CHART_W / n;\n\n    let svg = `<svg viewBox=\"0 0 ${SVG_W} ${SVG_H}\" xmlns=\"http://www.w3.org/2000/svg\" class=\"w-full max-h-96\">`;\n\n    // Y grid + ticks\n    ticks.forEach(function(t) {\n      const y = PAD_TOP + CHART_H - (t / yMax) * CHART_H;\n      svg += `<line x1=\"${PAD_LEFT}\" y1=\"${y}\" x2=\"${PAD_LEFT + CHART_W}\" y2=\"${y}\" stroke=\"#e5e7eb\" stroke-width=\"1\"/>`;\n      svg += `<text x=\"${PAD_LEFT - 8}\" y=\"${y + 4}\" text-anchor=\"end\" font-size=\"12\" fill=\"#6b7280\">${t}</text>`;\n    });\n\n    // Axes\n    svg += `<line x1=\"${PAD_LEFT}\" y1=\"${PAD_TOP}\" x2=\"${PAD_LEFT}\" y2=\"${PAD_TOP + CHART_H}\" stroke=\"#374151\" stroke-width=\"1.5\"/>`;\n    svg += `<line x1=\"${PAD_LEFT}\" y1=\"${PAD_TOP + CHART_H}\" x2=\"${PAD_LEFT + CHART_W}\" y2=\"${PAD_TOP + CHART_H}\" stroke=\"#374151\" stroke-width=\"1.5\"/>`;\n\n    // Y-axis label\n    svg += `<text transform=\"rotate(-90)\" x=\"${-(PAD_TOP + CHART_H/2)}\" y=\"15\" text-anchor=\"middle\" font-size=\"12\" fill=\"#374151\">Frekvens</text>`;\n\n    // Bars\n    data.forEach(function(d, i) {\n      const x    = PAD_LEFT + gap * i + gap / 2 - barW / 2;\n      const barH = (d.freq / yMax) * CHART_H;\n      const y    = PAD_TOP + CHART_H - barH;\n      const col  = PALETTE[i % PALETTE.length];\n\n      svg += `<rect x=\"${x}\" y=\"${y}\" width=\"${barW}\" height=\"${barH}\" fill=\"${col}\" rx=\"3\"/>`;\n      // Value on top of bar\n      if (barH > 16) {\n        svg += `<text x=\"${x + barW/2}\" y=\"${y - 4}\" text-anchor=\"middle\" font-size=\"12\" font-weight=\"600\" fill=\"${col}\">${d.freq}</text>`;\n      }\n      // X label\n      const lbl = truncate(d.label, 12);\n      const cx  = PAD_LEFT + gap * i + gap / 2;\n      svg += `<text x=\"${cx}\" y=\"${PAD_TOP + CHART_H + 16}\" text-anchor=\"end\" font-size=\"11\" fill=\"#374151\" transform=\"rotate(-35, ${cx}, ${PAD_TOP + CHART_H + 16})\">${escHtml(lbl)}</text>`;\n    });\n\n    svg += '</svg>';\n    return svg;\n  }\n\n  function buildLineSVG(data) {\n    const maxFreq = Math.max(...data.map(d => d.freq));\n    const ticks = yTicks(maxFreq);\n    const yMax  = ticks[ticks.length - 1];\n    const n = data.length;\n    const gap = CHART_W / (n - 1 || 1);\n\n    let svg = `<svg viewBox=\"0 0 ${SVG_W} ${SVG_H}\" xmlns=\"http://www.w3.org/2000/svg\" class=\"w-full max-h-96\">`;\n\n    // Y grid + ticks\n    ticks.forEach(function(t) {\n      const y = PAD_TOP + CHART_H - (t / yMax) * CHART_H;\n      svg += `<line x1=\"${PAD_LEFT}\" y1=\"${y}\" x2=\"${PAD_LEFT + CHART_W}\" y2=\"${y}\" stroke=\"#e5e7eb\" stroke-width=\"1\"/>`;\n      svg += `<text x=\"${PAD_LEFT - 8}\" y=\"${y + 4}\" text-anchor=\"end\" font-size=\"12\" fill=\"#6b7280\">${t}</text>`;\n    });\n\n    // Axes\n    svg += `<line x1=\"${PAD_LEFT}\" y1=\"${PAD_TOP}\" x2=\"${PAD_LEFT}\" y2=\"${PAD_TOP + CHART_H}\" stroke=\"#374151\" stroke-width=\"1.5\"/>`;\n    svg += `<line x1=\"${PAD_LEFT}\" y1=\"${PAD_TOP + CHART_H}\" x2=\"${PAD_LEFT + CHART_W}\" y2=\"${PAD_TOP + CHART_H}\" stroke=\"#374151\" stroke-width=\"1.5\"/>`;\n    svg += `<text transform=\"rotate(-90)\" x=\"${-(PAD_TOP + CHART_H/2)}\" y=\"15\" text-anchor=\"middle\" font-size=\"12\" fill=\"#374151\">Frekvens</text>`;\n\n    // Points and polyline\n    const pts = data.map(function(d, i) {\n      const x = PAD_LEFT + (n > 1 ? gap * i : CHART_W / 2);\n      const y = PAD_TOP + CHART_H - (d.freq / yMax) * CHART_H;\n      return { x, y, d };\n    });\n\n    if (pts.length >= 2) {\n      // Area fill\n      const areaPath = ['M', pts[0].x, PAD_TOP + CHART_H,\n        ...pts.map(p => `L ${p.x} ${p.y}`),\n        'L', pts[pts.length-1].x, PAD_TOP + CHART_H, 'Z'].join(' ');\n      svg += `<path d=\"${areaPath}\" fill=\"#2563eb\" fill-opacity=\"0.08\"/>`;\n\n      const linePath = pts.map((p, i) => (i === 0 ? `M ${p.x} ${p.y}` : `L ${p.x} ${p.y}`)).join(' ');\n      svg += `<path d=\"${linePath}\" fill=\"none\" stroke=\"#2563eb\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/>`;\n    }\n\n    pts.forEach(function(p, i) {\n      svg += `<circle cx=\"${p.x}\" cy=\"${p.y}\" r=\"5\" fill=\"#2563eb\" stroke=\"#fff\" stroke-width=\"2\"/>`;\n      svg += `<text x=\"${p.x}\" y=\"${p.y - 10}\" text-anchor=\"middle\" font-size=\"12\" font-weight=\"600\" fill=\"#2563eb\">${p.d.freq}</text>`;\n      const lbl = truncate(p.d.label, 12);\n      svg += `<text x=\"${p.x}\" y=\"${PAD_TOP + CHART_H + 16}\" text-anchor=\"end\" font-size=\"11\" fill=\"#374151\" transform=\"rotate(-35, ${p.x}, ${PAD_TOP + CHART_H + 16})\">${escHtml(lbl)}</text>`;\n    });\n\n    svg += '</svg>';\n    return svg;\n  }\n\n  function buildPieSVG(data) {\n    const total = data.reduce((s, d) => s + d.freq, 0);\n    if (total === 0) return '<p class=\"text-gray-400 text-sm italic py-4\">Ingen data.</p>';\n\n    const CX = 200, CY = 190, R = 155;\n    const svgW = 700, svgH = 380;\n\n    let svg = `<svg viewBox=\"0 0 ${svgW} ${svgH}\" xmlns=\"http://www.w3.org/2000/svg\" class=\"w-full max-h-96\">`;\n\n    let startAngle = -Math.PI / 2;\n    data.forEach(function(d, i) {\n      const pct   = d.freq / total;\n      const sweep = pct * 2 * Math.PI;\n      const endAngle = startAngle + sweep;\n      const col  = PALETTE[i % PALETTE.length];\n\n      const x1 = CX + R * Math.cos(startAngle);\n      const y1 = CY + R * Math.sin(startAngle);\n      const x2 = CX + R * Math.cos(endAngle);\n      const y2 = CY + R * Math.sin(endAngle);\n      const largeArc = sweep > Math.PI ? 1 : 0;\n\n      svg += `<path d=\"M ${CX} ${CY} L ${x1} ${y1} A ${R} ${R} 0 ${largeArc} 1 ${x2} ${y2} Z\" fill=\"${col}\" stroke=\"#fff\" stroke-width=\"2\"/>`;\n\n      // Label inside slice if big enough\n      if (pct > 0.06) {\n        const midAngle = startAngle + sweep / 2;\n        const lr = R * 0.65;\n        const lx = CX + lr * Math.cos(midAngle);\n        const ly = CY + lr * Math.sin(midAngle);\n        svg += `<text x=\"${lx}\" y=\"${ly}\" text-anchor=\"middle\" dominant-baseline=\"middle\" font-size=\"12\" font-weight=\"700\" fill=\"#fff\">${(pct*100).toFixed(1)}%</text>`;\n      }\n\n      startAngle = endAngle;\n    });\n\n    // Legend — right side\n    const legendX = CX + R + 30;\n    data.forEach(function(d, i) {\n      const pct = d.freq / total;\n      const ly  = 40 + i * 26;\n      const col = PALETTE[i % PALETTE.length];\n      svg += `<rect x=\"${legendX}\" y=\"${ly - 8}\" width=\"14\" height=\"14\" rx=\"2\" fill=\"${col}\"/>`;\n      const lbl = truncate(d.label, 18);\n      svg += `<text x=\"${legendX + 18}\" y=\"${ly + 3}\" font-size=\"12\" fill=\"#374151\">${escHtml(lbl)} — ${(pct*100).toFixed(1)} %</text>`;\n    });\n\n    svg += '</svg>';\n    return svg;\n  }\n\n  function truncate(s, maxLen) {\n    return s.length > maxLen ? s.slice(0, maxLen - 1) + '…' : s;\n  }\n\n  // ── Tab switching ─────────────────────────────────────────────────────────\n  document.querySelectorAll('.tab-btn').forEach(function(btn) {\n    btn.addEventListener('click', function() {\n      activeTab = this.dataset.tab;\n      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));\n      this.classList.add('active');\n\n      ['soyle','kurve','sektor'].forEach(function(t) {\n        const hint = document.getElementById('hint-' + t);\n        if (hint) hint.classList.toggle('hidden', t !== activeTab);\n      });\n\n      renderDiagram();\n    });\n  });\n\n  // ── Add row button ─────────────────────────────────────────────────────────\n  document.getElementById('btn-add-row').addEventListener('click', function() {\n    syncRowsFromInputs();\n    addRow('', '');\n    renderInputTable();\n    saveState();\n  });\n\n  // ── Load sample ───────────────────────────────────────────────────────────\n  document.getElementById('btn-load-sample').addEventListener('click', function() {\n    rows = SAMPLE_DATA.map(r => ({ label: r.label, freq: r.freq }));\n    renderInputTable();\n    renderFreqTable();\n    renderDiagram();\n    saveState();\n  });\n\n  // ── Clear all ─────────────────────────────────────────────────────────────\n  document.getElementById('btn-clear-all').addEventListener('click', function() {\n    rows = [{ label: '', freq: '' }, { label: '', freq: '' }];\n    renderInputTable();\n    renderFreqTable();\n    renderDiagram();\n    saveState();\n  });\n\n  // ── Init ──────────────────────────────────────────────────────────────────\n  const saved = loadState();\n  if (saved) {\n    rows = saved;\n  } else {\n    rows = SAMPLE_DATA.map(r => ({ label: r.label, freq: r.freq }));\n  }\n\n  renderInputTable();\n  renderFreqTable();\n  renderDiagram();\n\n})();\n</script>\n</body>\n</html>\n",
