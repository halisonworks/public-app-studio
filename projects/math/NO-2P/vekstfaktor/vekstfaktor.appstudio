{
  "schema": "app-studio/canvas@1",
  "id": "example-no2p-vekstfaktor",
  "name": "vekstfaktor.html",
  "code": "<!DOCTYPE html>\n<!--\n  Vekstfaktor — Halison App Studio-eksempel\n\n  Interaktivt læremiddel for matematikk 2P (LK20): vekstfaktor og gjentatt\n  prosentvis endring, med tabell og graf — pluss å regne baklengs.\n\n  Fra Halison App Studio sitt offentlige bibliotek:\n  https://github.com/halisonworks/public-app-studio\n\n  Tillatt bruk: personlig, pedagogisk og annen ikke-kommersiell bruk. Behold denne\n  headeren og kildelenken; ikke-kommersiell bruk. Utgitt under Halison App Studio\n  Examples License — se LICENSE-filen i repoet over.\n-->\n<html lang=\"no\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Vekstfaktor – Matematikk 2P</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Segoe UI', system-ui, sans-serif; }\n    .tab-active { border-bottom: 3px solid #2563eb; color: #2563eb; font-weight: 600; }\n    .tab-inactive { border-bottom: 3px solid transparent; color: #6b7280; }\n    .tab-inactive:hover { color: #374151; border-bottom-color: #d1d5db; }\n    input[type=number]::-webkit-inner-spin-button,\n    input[type=number]::-webkit-outer-spin-button { opacity: 1; }\n    .result-card { background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%); }\n    .result-card-green { background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%); }\n    .result-card-red { background: linear-gradient(135deg, #fff1f2 0%, #ffe4e6 100%); }\n    svg text { font-family: 'Segoe UI', system-ui, sans-serif; }\n    .tooltip {\n      position: absolute;\n      background: #1e3a5f;\n      color: white;\n      padding: 4px 10px;\n      border-radius: 6px;\n      font-size: 12px;\n      pointer-events: none;\n      white-space: nowrap;\n      opacity: 0;\n      transition: opacity 0.15s;\n    }\n    .example-btn {\n      cursor: pointer;\n      transition: background 0.15s, transform 0.1s;\n    }\n    .example-btn:hover { transform: translateY(-1px); }\n    .example-btn:active { transform: translateY(0); }\n  </style>\n</head>\n<body class=\"bg-gray-50 min-h-screen\">\n\n<!-- Header -->\n<header class=\"bg-blue-700 text-white shadow-lg\">\n  <div class=\"max-w-4xl mx-auto px-4 py-5\">\n    <div class=\"flex items-center gap-3\">\n      <div class=\"text-3xl\">📈</div>\n      <div>\n        <h1 class=\"text-2xl font-bold tracking-tight\">Vekstfaktor</h1>\n        <p class=\"text-blue-200 text-sm mt-0.5\">Matematikk 2P · Gjentatt prosentvis endring</p>\n      </div>\n    </div>\n  </div>\n</header>\n\n<!-- Tabs -->\n<div class=\"max-w-4xl mx-auto px-4 mt-6\">\n  <div class=\"flex gap-0 border-b border-gray-200 bg-white rounded-t-xl shadow-sm overflow-hidden\">\n    <button id=\"tab-frem\" onclick=\"setTab('frem')\"\n      class=\"tab-active px-6 py-3 text-sm transition-all\">\n      Fremover: beregn sluttverdi\n    </button>\n    <button id=\"tab-bak\" onclick=\"setTab('bak')\"\n      class=\"tab-inactive px-6 py-3 text-sm transition-all\">\n      Bakover: finn vekstfaktor\n    </button>\n    <button id=\"tab-teori\" onclick=\"setTab('teori')\"\n      class=\"tab-inactive px-6 py-3 text-sm transition-all\">\n      Teori\n    </button>\n  </div>\n</div>\n\n<!-- ======================== TAB: FREMOVER ======================== -->\n<div id=\"panel-frem\" class=\"max-w-4xl mx-auto px-4 pb-12\">\n  <div class=\"bg-white rounded-b-xl rounded-tr-xl shadow-sm p-6\">\n\n    <!-- Forklaring -->\n    <div class=\"bg-blue-50 border border-blue-200 rounded-lg p-4 mb-6 text-sm text-blue-900\">\n      <strong>Fremover-beregning:</strong> Skriv inn startverdi, prosentvis endring per periode og antall perioder.\n      Kalkulatoren beregner vekstfaktoren og sluttverdien.\n    </div>\n\n    <!-- Eksempler -->\n    <div class=\"mb-6\">\n      <p class=\"text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2\">Last inn eksempel</p>\n      <div class=\"flex flex-wrap gap-2\">\n        <button class=\"example-btn bg-green-100 text-green-800 border border-green-200 text-xs px-3 py-1.5 rounded-full font-medium\"\n          onclick=\"loadExempel('sparepenger')\">💰 Sparepenger (rente)</button>\n        <button class=\"example-btn bg-orange-100 text-orange-800 border border-orange-200 text-xs px-3 py-1.5 rounded-full font-medium\"\n          onclick=\"loadExempel('bil')\">🚗 Bilverdi (avskrivning)</button>\n        <button class=\"example-btn bg-blue-100 text-blue-800 border border-blue-200 text-xs px-3 py-1.5 rounded-full font-medium\"\n          onclick=\"loadExempel('befolkning')\">🏘️ Befolkningsvekst</button>\n        <button class=\"example-btn bg-red-100 text-red-800 border border-red-200 text-xs px-3 py-1.5 rounded-full font-medium\"\n          onclick=\"loadExempel('rabatt')\">🏷️ Prisnedgang (rabatt)</button>\n      </div>\n    </div>\n\n    <!-- Inputs -->\n    <div class=\"grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6\">\n      <div>\n        <label class=\"block text-sm font-medium text-gray-700 mb-1\">\n          Startverdi\n          <span class=\"text-gray-400 font-normal text-xs\">(kr, innb., stk. …)</span>\n        </label>\n        <input id=\"f-start\" type=\"number\" step=\"any\" value=\"50000\"\n          class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\"\n          oninput=\"beregnFrem()\" />\n      </div>\n      <div>\n        <label class=\"block text-sm font-medium text-gray-700 mb-1\">\n          Endring per periode\n          <span class=\"text-gray-400 font-normal text-xs\">(%)</span>\n        </label>\n        <input id=\"f-prosent\" type=\"number\" step=\"any\" value=\"3.5\"\n          class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\"\n          oninput=\"beregnFrem()\" />\n        <p class=\"text-xs text-gray-400 mt-1\">Negativ verdi = nedgang</p>\n      </div>\n      <div>\n        <label class=\"block text-sm font-medium text-gray-700 mb-1\">\n          Antall perioder\n          <span class=\"text-gray-400 font-normal text-xs\">(n)</span>\n        </label>\n        <input id=\"f-n\" type=\"number\" step=\"1\" min=\"1\" max=\"100\" value=\"5\"\n          class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\"\n          oninput=\"beregnFrem()\" />\n      </div>\n    </div>\n\n    <!-- Resultatkort -->\n    <div id=\"f-result-cards\" class=\"grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6\"></div>\n\n    <!-- Formel-visning -->\n    <div id=\"f-formel\" class=\"bg-gray-50 border border-gray-200 rounded-lg p-4 mb-6 text-sm font-mono text-gray-700\"></div>\n\n    <!-- Graf -->\n    <div class=\"mb-6\">\n      <h3 class=\"text-sm font-semibold text-gray-700 mb-2\">Graf – utvikling over perioder</h3>\n      <div class=\"relative w-full overflow-x-auto\">\n        <div id=\"f-tooltip\" class=\"tooltip\"></div>\n        <svg id=\"f-chart\" class=\"w-full\" style=\"min-width:320px;height:280px;display:block;\"></svg>\n      </div>\n    </div>\n\n    <!-- Tabell -->\n    <div>\n      <h3 class=\"text-sm font-semibold text-gray-700 mb-2\">Periodeoversikt</h3>\n      <div class=\"overflow-x-auto rounded-lg border border-gray-200\">\n        <table class=\"w-full text-sm\">\n          <thead class=\"bg-gray-100 text-gray-600 uppercase text-xs\">\n            <tr>\n              <th class=\"px-4 py-2 text-left\">Periode</th>\n              <th class=\"px-4 py-2 text-right\">Verdi</th>\n              <th class=\"px-4 py-2 text-right\">Endring</th>\n              <th class=\"px-4 py-2 text-right\">Endring (%)</th>\n            </tr>\n          </thead>\n          <tbody id=\"f-tabell\" class=\"divide-y divide-gray-100\"></tbody>\n        </table>\n      </div>\n    </div>\n\n  </div>\n</div>\n\n<!-- ======================== TAB: BAKOVER ======================== -->\n<div id=\"panel-bak\" class=\"max-w-4xl mx-auto px-4 pb-12 hidden\">\n  <div class=\"bg-white rounded-b-xl rounded-tr-xl shadow-sm p-6\">\n\n    <div class=\"bg-amber-50 border border-amber-200 rounded-lg p-4 mb-6 text-sm text-amber-900\">\n      <strong>Bakover-beregning:</strong> Du vet start- og sluttverdien, og antall perioder.\n      Kalkulatoren finner vekstfaktoren og den prosentvise endringen per periode.\n      <br/>\n      <span class=\"font-mono\">Vekstfaktor = (sluttverdi / startverdi)^(1/n)</span>\n    </div>\n\n    <!-- Eksempler bakover -->\n    <div class=\"mb-6\">\n      <p class=\"text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2\">Last inn eksempel</p>\n      <div class=\"flex flex-wrap gap-2\">\n        <button class=\"example-btn bg-purple-100 text-purple-800 border border-purple-200 text-xs px-3 py-1.5 rounded-full font-medium\"\n          onclick=\"loadEksempelBak('hus')\">🏠 Boligprisutvikling</button>\n        <button class=\"example-btn bg-teal-100 text-teal-800 border border-teal-200 text-xs px-3 py-1.5 rounded-full font-medium\"\n          onclick=\"loadEksempelBak('aksje')\">📊 Aksjevekst</button>\n        <button class=\"example-btn bg-rose-100 text-rose-800 border border-rose-200 text-xs px-3 py-1.5 rounded-full font-medium\"\n          onclick=\"loadEksempelBak('befolkningsbak')\">👥 Befolkningsendring</button>\n      </div>\n    </div>\n\n    <div class=\"grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6\">\n      <div>\n        <label class=\"block text-sm font-medium text-gray-700 mb-1\">Startverdi</label>\n        <input id=\"b-start\" type=\"number\" step=\"any\" value=\"200000\"\n          class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400\"\n          oninput=\"beregnBak()\" />\n      </div>\n      <div>\n        <label class=\"block text-sm font-medium text-gray-700 mb-1\">Sluttverdi</label>\n        <input id=\"b-slutt\" type=\"number\" step=\"any\" value=\"280000\"\n          class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400\"\n          oninput=\"beregnBak()\" />\n      </div>\n      <div>\n        <label class=\"block text-sm font-medium text-gray-700 mb-1\">Antall perioder <span class=\"text-gray-400 font-normal text-xs\">(n)</span></label>\n        <input id=\"b-n\" type=\"number\" step=\"1\" min=\"1\" max=\"100\" value=\"5\"\n          class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400\"\n          oninput=\"beregnBak()\" />\n      </div>\n    </div>\n\n    <!-- Resultatkort bakover -->\n    <div id=\"b-result-cards\" class=\"grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6\"></div>\n\n    <!-- Formel bakover -->\n    <div id=\"b-formel\" class=\"bg-gray-50 border border-gray-200 rounded-lg p-4 mb-6 text-sm font-mono text-gray-700\"></div>\n\n    <!-- Graf bakover -->\n    <div class=\"mb-6\">\n      <h3 class=\"text-sm font-semibold text-gray-700 mb-2\">Graf – rekonstruert utvikling</h3>\n      <div class=\"relative w-full overflow-x-auto\">\n        <div id=\"b-tooltip\" class=\"tooltip\"></div>\n        <svg id=\"b-chart\" class=\"w-full\" style=\"min-width:320px;height:280px;display:block;\"></svg>\n      </div>\n    </div>\n\n    <!-- Tabell bakover -->\n    <div>\n      <h3 class=\"text-sm font-semibold text-gray-700 mb-2\">Periodeoversikt</h3>\n      <div class=\"overflow-x-auto rounded-lg border border-gray-200\">\n        <table class=\"w-full text-sm\">\n          <thead class=\"bg-gray-100 text-gray-600 uppercase text-xs\">\n            <tr>\n              <th class=\"px-4 py-2 text-left\">Periode</th>\n              <th class=\"px-4 py-2 text-right\">Verdi</th>\n              <th class=\"px-4 py-2 text-right\">Endring</th>\n              <th class=\"px-4 py-2 text-right\">Endring (%)</th>\n            </tr>\n          </thead>\n          <tbody id=\"b-tabell\" class=\"divide-y divide-gray-100\"></tbody>\n        </table>\n      </div>\n    </div>\n\n  </div>\n</div>\n\n<!-- ======================== TAB: TEORI ======================== -->\n<div id=\"panel-teori\" class=\"max-w-4xl mx-auto px-4 pb-12 hidden\">\n  <div class=\"bg-white rounded-b-xl rounded-tr-xl shadow-sm p-6 space-y-6\">\n\n    <div>\n      <h2 class=\"text-lg font-bold text-gray-800 mb-3\">Hva er vekstfaktor?</h2>\n      <p class=\"text-sm text-gray-700 leading-relaxed\">\n        En <strong>prosentvis endring</strong> kan uttrykkes som én multiplikasjon med en <strong>vekstfaktor</strong>.\n        I stedet for å legge til eller trekke fra en prosentandel, multipliserer vi med vekstfaktoren.\n      </p>\n    </div>\n\n    <div class=\"bg-blue-50 border border-blue-200 rounded-xl p-5\">\n      <h3 class=\"font-bold text-blue-900 mb-3\">Formler</h3>\n      <div class=\"space-y-3 text-sm\">\n        <div class=\"bg-white rounded-lg p-3 border border-blue-100 font-mono\">\n          <span class=\"text-blue-700 font-bold\">Økning p %:</span><br/>\n          Vekstfaktor = 1 + p/100\n        </div>\n        <div class=\"bg-white rounded-lg p-3 border border-blue-100 font-mono\">\n          <span class=\"text-red-600 font-bold\">Nedgang p %:</span><br/>\n          Vekstfaktor = 1 − p/100\n        </div>\n        <div class=\"bg-white rounded-lg p-3 border border-blue-100 font-mono\">\n          <span class=\"text-green-700 font-bold\">Etter n perioder:</span><br/>\n          Sluttverdi = Startverdi × Vekstfaktor<sup>n</sup>\n        </div>\n        <div class=\"bg-white rounded-lg p-3 border border-blue-100 font-mono\">\n          <span class=\"text-purple-700 font-bold\">Baklengs (finn vekstfaktor):</span><br/>\n          Vekstfaktor = (Sluttverdi / Startverdi)<sup>1/n</sup>\n        </div>\n      </div>\n    </div>\n\n    <div>\n      <h3 class=\"font-bold text-gray-800 mb-3\">Eksempler fra virkeligheten</h3>\n      <div class=\"space-y-4\">\n\n        <div class=\"border border-gray-200 rounded-lg p-4\">\n          <div class=\"flex items-center gap-2 mb-2\">\n            <span class=\"text-lg\">💰</span>\n            <span class=\"font-semibold text-gray-800\">Sparepenger med rente</span>\n          </div>\n          <p class=\"text-sm text-gray-600\">\n            Du setter inn <strong>10 000 kr</strong> i banken med <strong>3,5 % rente per år</strong>.\n            Etter <strong>5 år</strong>:\n          </p>\n          <p class=\"text-sm font-mono mt-2 bg-gray-50 rounded p-2\">\n            Vekstfaktor = 1 + 3,5/100 = 1,035<br/>\n            Sluttverdi = 10 000 × 1,035<sup>5</sup> ≈ 11 877 kr\n          </p>\n        </div>\n\n        <div class=\"border border-gray-200 rounded-lg p-4\">\n          <div class=\"flex items-center gap-2 mb-2\">\n            <span class=\"text-lg\">🚗</span>\n            <span class=\"font-semibold text-gray-800\">Bilens verdi synker</span>\n          </div>\n          <p class=\"text-sm text-gray-600\">\n            En ny bil koster <strong>350 000 kr</strong> og mister <strong>15 % av verdien hvert år</strong>.\n            Etter <strong>4 år</strong>:\n          </p>\n          <p class=\"text-sm font-mono mt-2 bg-gray-50 rounded p-2\">\n            Vekstfaktor = 1 − 15/100 = 0,85<br/>\n            Sluttverdi = 350 000 × 0,85<sup>4</sup> ≈ 182 564 kr\n          </p>\n        </div>\n\n        <div class=\"border border-gray-200 rounded-lg p-4\">\n          <div class=\"flex items-center gap-2 mb-2\">\n            <span class=\"text-lg\">🏘️</span>\n            <span class=\"font-semibold text-gray-800\">Befolkningsvekst</span>\n          </div>\n          <p class=\"text-sm text-gray-600\">\n            En by har <strong>45 000 innbyggere</strong> og vokser med <strong>1,2 % per år</strong>.\n            Etter <strong>10 år</strong>:\n          </p>\n          <p class=\"text-sm font-mono mt-2 bg-gray-50 rounded p-2\">\n            Vekstfaktor = 1 + 1,2/100 = 1,012<br/>\n            Sluttverdi = 45 000 × 1,012<sup>10</sup> ≈ 50 629 innbyggere\n          </p>\n        </div>\n\n      </div>\n    </div>\n\n    <div class=\"bg-amber-50 border border-amber-200 rounded-xl p-5\">\n      <h3 class=\"font-bold text-amber-900 mb-2\">Viktig: Prosentvis endring er ikke additiv</h3>\n      <p class=\"text-sm text-amber-800 leading-relaxed\">\n        En oppgang på 10 % etterfulgt av en nedgang på 10 % gir <em>ikke</em> det samme som ingen endring!<br/>\n        <span class=\"font-mono\">1,10 × 0,90 = 0,99</span> — du har faktisk tapt 1 % av startverdien.\n        Dette er fordi prosentene beregnes av ulike grunnlag.\n      </p>\n    </div>\n\n    <div>\n      <h3 class=\"font-bold text-gray-800 mb-2\">Total prosentvis endring</h3>\n      <p class=\"text-sm text-gray-700 leading-relaxed\">\n        Etter n perioder med vekstfaktor V er <strong>total prosentvis endring</strong>:\n      </p>\n      <p class=\"text-sm font-mono bg-gray-50 rounded p-3 mt-2\">\n        Total endring (%) = (V<sup>n</sup> − 1) × 100\n      </p>\n    </div>\n\n  </div>\n</div>\n\n<footer class=\"max-w-4xl mx-auto px-4 py-4 text-center text-xs text-gray-400 pb-8\">\n  Matematikk 2P · LK20 · Halison App Studio ·\n  <a href=\"https://github.com/halisonworks/public-app-studio\" class=\"underline hover:text-gray-600\" target=\"_blank\">public-app-studio</a>\n</footer>\n\n<script>\n// ──────────────────────────────────────────────────────────────────────────────\n// TAB NAVIGATION\n// ──────────────────────────────────────────────────────────────────────────────\nfunction setTab(name) {\n  ['frem','bak','teori'].forEach(t => {\n    document.getElementById('panel-' + t).classList.toggle('hidden', t !== name);\n    document.getElementById('tab-' + t).className =\n      (t === name ? 'tab-active' : 'tab-inactive') +\n      ' px-6 py-3 text-sm transition-all';\n  });\n}\n\n// ──────────────────────────────────────────────────────────────────────────────\n// TALLFORMATERING\n// ──────────────────────────────────────────────────────────────────────────────\nfunction fmtTall(v, desimaler) {\n  if (v === null || isNaN(v)) return '–';\n  const d = desimaler !== undefined ? desimaler : (Math.abs(v) >= 1000 ? 0 : 2);\n  return v.toLocaleString('nb-NO', { minimumFractionDigits: d, maximumFractionDigits: d });\n}\n\nfunction fmtVekst(v) {\n  return v.toLocaleString('nb-NO', { minimumFractionDigits: 4, maximumFractionDigits: 6 });\n}\n\n// ──────────────────────────────────────────────────────────────────────────────\n// EKSEMPLER – FREMOVER\n// ──────────────────────────────────────────────────────────────────────────────\nconst EKSEMPLER_FREM = {\n  sparepenger: { start: 10000,  prosent:  3.5, n: 10, label: 'Sparepenger: 10 000 kr satt inn med 3,5 % rente per år' },\n  bil:         { start: 350000, prosent: -15,  n:  6, label: 'Bilverdi: 350 000 kr, mister 15 % av verdi hvert år' },\n  befolkning:  { start: 45000,  prosent:  1.2, n: 10, label: 'Befolkning: 45 000 innb., vokser 1,2 % per år' },\n  rabatt:      { start: 1200,   prosent: -8,   n:  4, label: 'Pris: 1 200 kr, reduseres med 8 % hvert år' },\n};\n\nfunction loadExempel(key) {\n  const e = EKSEMPLER_FREM[key];\n  document.getElementById('f-start').value   = e.start;\n  document.getElementById('f-prosent').value = e.prosent;\n  document.getElementById('f-n').value       = e.n;\n  beregnFrem();\n  saveToStorage();\n}\n\n// ──────────────────────────────────────────────────────────────────────────────\n// EKSEMPLER – BAKOVER\n// ──────────────────────────────────────────────────────────────────────────────\nconst EKSEMPLER_BAK = {\n  hus:             { start: 2800000, slutt: 4100000, n: 8,  label: 'Bolig: fra 2 800 000 til 4 100 000 kr over 8 år' },\n  aksje:           { start: 5000,    slutt: 12000,   n: 7,  label: 'Aksjer: fra 5 000 til 12 000 kr over 7 år' },\n  befolkningsbak:  { start: 38000,   slutt: 33500,   n: 10, label: 'Befolkning: fra 38 000 til 33 500 innb. over 10 år' },\n};\n\nfunction loadEksempelBak(key) {\n  const e = EKSEMPLER_BAK[key];\n  document.getElementById('b-start').value = e.start;\n  document.getElementById('b-slutt').value = e.slutt;\n  document.getElementById('b-n').value     = e.n;\n  beregnBak();\n  saveToStorage();\n}\n\n// ──────────────────────────────────────────────────────────────────────────────\n// LOCALSTORAGE\n// ──────────────────────────────────────────────────────────────────────────────\nfunction saveToStorage() {\n  try {\n    localStorage.setItem('vekstfaktor_frem', JSON.stringify({\n      start:   document.getElementById('f-start').value,\n      prosent: document.getElementById('f-prosent').value,\n      n:       document.getElementById('f-n').value,\n    }));\n    localStorage.setItem('vekstfaktor_bak', JSON.stringify({\n      start: document.getElementById('b-start').value,\n      slutt: document.getElementById('b-slutt').value,\n      n:     document.getElementById('b-n').value,\n    }));\n  } catch(_) {}\n}\n\nfunction loadFromStorage() {\n  try {\n    const f = JSON.parse(localStorage.getItem('vekstfaktor_frem') || 'null');\n    if (f) {\n      document.getElementById('f-start').value   = f.start;\n      document.getElementById('f-prosent').value = f.prosent;\n      document.getElementById('f-n').value       = f.n;\n    }\n    const b = JSON.parse(localStorage.getItem('vekstfaktor_bak') || 'null');\n    if (b) {\n      document.getElementById('b-start').value = b.start;\n      document.getElementById('b-slutt').value = b.slutt;\n      document.getElementById('b-n').value     = b.n;\n    }\n  } catch(_) {}\n}\n\n// ──────────────────────────────────────────────────────────────────────────────\n// BEREGN FREMOVER\n// ──────────────────────────────────────────────────────────────────────────────\nfunction beregnFrem() {\n  const start   = parseFloat(document.getElementById('f-start').value);\n  const prosent = parseFloat(document.getElementById('f-prosent').value);\n  const n       = parseInt(document.getElementById('f-n').value, 10);\n\n  if (isNaN(start) || isNaN(prosent) || isNaN(n) || n < 1) {\n    document.getElementById('f-result-cards').innerHTML =\n      '<p class=\"text-sm text-red-500 col-span-3\">Fyll inn gyldige verdier for alle felt.</p>';\n    return;\n  }\n\n  const vekstfaktor = 1 + prosent / 100;\n  const slutt = start * Math.pow(vekstfaktor, n);\n  const totalEndringProsent = (Math.pow(vekstfaktor, n) - 1) * 100;\n  const erOkning = vekstfaktor >= 1;\n\n  // Resultatkort\n  const cardClass = erOkning ? 'result-card-green' : 'result-card-red';\n  const vfFarge   = erOkning ? 'text-green-700' : 'text-red-700';\n  document.getElementById('f-result-cards').innerHTML = `\n    <div class=\"result-card rounded-xl p-4 border border-blue-200\">\n      <div class=\"text-xs text-blue-600 font-semibold uppercase mb-1\">Vekstfaktor</div>\n      <div class=\"text-2xl font-bold text-blue-800\">${fmtVekst(vekstfaktor)}</div>\n      <div class=\"text-xs text-blue-500 mt-1\">per periode</div>\n    </div>\n    <div class=\"${cardClass} rounded-xl p-4 border ${erOkning ? 'border-green-200' : 'border-red-200'}\">\n      <div class=\"text-xs ${vfFarge} font-semibold uppercase mb-1\">Sluttverdi</div>\n      <div class=\"text-2xl font-bold ${vfFarge}\">${fmtTall(slutt, 2)}</div>\n      <div class=\"text-xs ${erOkning ? 'text-green-500' : 'text-red-400'} mt-1\">etter ${n} periode${n !== 1 ? 'r' : ''}</div>\n    </div>\n    <div class=\"bg-gray-50 rounded-xl p-4 border border-gray-200\">\n      <div class=\"text-xs text-gray-500 font-semibold uppercase mb-1\">Total endring</div>\n      <div class=\"text-2xl font-bold ${totalEndringProsent >= 0 ? 'text-green-700' : 'text-red-700'}\">\n        ${totalEndringProsent >= 0 ? '+' : ''}${fmtTall(totalEndringProsent, 2)} %\n      </div>\n      <div class=\"text-xs text-gray-400 mt-1\">fra start til slutt</div>\n    </div>\n  `;\n\n  // Formel-visning\n  const vfStr = fmtVekst(vekstfaktor);\n  const startStr = fmtTall(start, 2);\n  const sluttStr = fmtTall(slutt, 2);\n  document.getElementById('f-formel').innerHTML =\n    `Vekstfaktor = 1 ${prosent >= 0 ? '+' : '−'} ${Math.abs(prosent)}/100 = <strong>${vfStr}</strong><br/>` +\n    `Sluttverdi = ${startStr} × ${vfStr}<sup>${n}</sup> = <strong>${sluttStr}</strong>`;\n\n  // Tabell\n  const tbody = document.getElementById('f-tabell');\n  tbody.innerHTML = '';\n  let periodeVerdier = [start];\n  for (let i = 1; i <= n; i++) {\n    periodeVerdier.push(start * Math.pow(vekstfaktor, i));\n  }\n  periodeVerdier.forEach((v, i) => {\n    const endring = i === 0 ? null : v - periodeVerdier[i - 1];\n    const endringPct = i === 0 ? null : prosent;\n    const row = document.createElement('tr');\n    row.className = i % 2 === 0 ? 'bg-white' : 'bg-gray-50';\n    row.innerHTML = `\n      <td class=\"px-4 py-2 text-gray-700\">${i === 0 ? 'Start' : 'Periode ' + i}</td>\n      <td class=\"px-4 py-2 text-right font-medium text-gray-800\">${fmtTall(v, 2)}</td>\n      <td class=\"px-4 py-2 text-right ${endring === null ? 'text-gray-400' : endring >= 0 ? 'text-green-600' : 'text-red-500'}\">\n        ${endring === null ? '–' : (endring >= 0 ? '+' : '') + fmtTall(endring, 2)}\n      </td>\n      <td class=\"px-4 py-2 text-right ${endringPct === null ? 'text-gray-400' : endringPct >= 0 ? 'text-green-600' : 'text-red-500'}\">\n        ${endringPct === null ? '–' : (endringPct >= 0 ? '+' : '') + fmtTall(endringPct, 2) + ' %'}\n      </td>\n    `;\n    tbody.appendChild(row);\n  });\n\n  // Graf\n  tegnGraf('f-chart', 'f-tooltip', periodeVerdier, erOkning);\n  saveToStorage();\n}\n\n// ──────────────────────────────────────────────────────────────────────────────\n// BEREGN BAKOVER\n// ──────────────────────────────────────────────────────────────────────────────\nfunction beregnBak() {\n  const start = parseFloat(document.getElementById('b-start').value);\n  const slutt = parseFloat(document.getElementById('b-slutt').value);\n  const n     = parseInt(document.getElementById('b-n').value, 10);\n\n  if (isNaN(start) || isNaN(slutt) || isNaN(n) || n < 1 || start <= 0 || slutt <= 0) {\n    document.getElementById('b-result-cards').innerHTML =\n      '<p class=\"text-sm text-red-500 col-span-3\">Fyll inn positive verdier for alle felt.</p>';\n    return;\n  }\n\n  const vekstfaktor = Math.pow(slutt / start, 1 / n);\n  const prosent     = (vekstfaktor - 1) * 100;\n  const erOkning    = vekstfaktor >= 1;\n  const totalEndring = (slutt / start - 1) * 100;\n\n  const cardClass = erOkning ? 'result-card-green' : 'result-card-red';\n  const vfFarge   = erOkning ? 'text-green-700' : 'text-red-700';\n\n  document.getElementById('b-result-cards').innerHTML = `\n    <div class=\"result-card rounded-xl p-4 border border-blue-200\">\n      <div class=\"text-xs text-blue-600 font-semibold uppercase mb-1\">Vekstfaktor</div>\n      <div class=\"text-2xl font-bold text-blue-800\">${fmtVekst(vekstfaktor)}</div>\n      <div class=\"text-xs text-blue-500 mt-1\">per periode</div>\n    </div>\n    <div class=\"${cardClass} rounded-xl p-4 border ${erOkning ? 'border-green-200' : 'border-red-200'}\">\n      <div class=\"text-xs ${vfFarge} font-semibold uppercase mb-1\">Endring per periode</div>\n      <div class=\"text-2xl font-bold ${vfFarge}\">${prosent >= 0 ? '+' : ''}${fmtTall(prosent, 4)} %</div>\n      <div class=\"text-xs ${erOkning ? 'text-green-500' : 'text-red-400'} mt-1\">\n        ${erOkning ? 'Økning' : 'Nedgang'} per periode\n      </div>\n    </div>\n    <div class=\"bg-gray-50 rounded-xl p-4 border border-gray-200\">\n      <div class=\"text-xs text-gray-500 font-semibold uppercase mb-1\">Total endring</div>\n      <div class=\"text-2xl font-bold ${totalEndring >= 0 ? 'text-green-700' : 'text-red-700'}\">\n        ${totalEndring >= 0 ? '+' : ''}${fmtTall(totalEndring, 2)} %\n      </div>\n      <div class=\"text-xs text-gray-400 mt-1\">fra start til slutt</div>\n    </div>\n  `;\n\n  const vfStr    = fmtVekst(vekstfaktor);\n  const startStr = fmtTall(start, 2);\n  const sluttStr = fmtTall(slutt, 2);\n  document.getElementById('b-formel').innerHTML =\n    `Vekstfaktor = (${sluttStr} / ${startStr})<sup>1/${n}</sup> = <strong>${vfStr}</strong><br/>` +\n    `Endring per periode: (${vfStr} − 1) × 100 = <strong>${prosent >= 0 ? '+' : ''}${fmtTall(prosent, 4)} %</strong>`;\n\n  // Tabell\n  const tbody = document.getElementById('b-tabell');\n  tbody.innerHTML = '';\n  let periodeVerdier = [start];\n  for (let i = 1; i <= n; i++) {\n    periodeVerdier.push(start * Math.pow(vekstfaktor, i));\n  }\n  periodeVerdier.forEach((v, i) => {\n    const endring    = i === 0 ? null : v - periodeVerdier[i - 1];\n    const endringPct = i === 0 ? null : prosent;\n    const row = document.createElement('tr');\n    row.className = i % 2 === 0 ? 'bg-white' : 'bg-gray-50';\n    row.innerHTML = `\n      <td class=\"px-4 py-2 text-gray-700\">${i === 0 ? 'Start' : 'Periode ' + i}</td>\n      <td class=\"px-4 py-2 text-right font-medium text-gray-800\">${fmtTall(v, 2)}</td>\n      <td class=\"px-4 py-2 text-right ${endring === null ? 'text-gray-400' : endring >= 0 ? 'text-green-600' : 'text-red-500'}\">\n        ${endring === null ? '–' : (endring >= 0 ? '+' : '') + fmtTall(endring, 2)}\n      </td>\n      <td class=\"px-4 py-2 text-right ${endringPct === null ? 'text-gray-400' : endringPct >= 0 ? 'text-green-600' : 'text-red-500'}\">\n        ${endringPct === null ? '–' : (endringPct >= 0 ? '+' : '') + fmtTall(endringPct, 4) + ' %'}\n      </td>\n    `;\n    tbody.appendChild(row);\n  });\n\n  tegnGraf('b-chart', 'b-tooltip', periodeVerdier, erOkning);\n  saveToStorage();\n}\n\n// ──────────────────────────────────────────────────────────────────────────────\n// SVG GRAF\n// ──────────────────────────────────────────────────────────────────────────────\nfunction tegnGraf(svgId, tooltipId, verdier, erOkning) {\n  const svgEl = document.getElementById(svgId);\n  const tooltipEl = document.getElementById(tooltipId);\n  svgEl.innerHTML = '';\n\n  const W = svgEl.clientWidth || 600;\n  const H = 260;\n  const PL = 70, PR = 20, PT = 20, PB = 40;\n  const innerW = W - PL - PR;\n  const innerH = H - PT - PB;\n\n  const n = verdier.length - 1;\n  const minV = Math.min(...verdier);\n  const maxV = Math.max(...verdier);\n  const range = maxV - minV || 1;\n  const padV = range * 0.12;\n  const lo = minV - padV;\n  const hi = maxV + padV;\n\n  const toX = i => PL + (i / Math.max(n, 1)) * innerW;\n  const toY = v => PT + innerH - ((v - lo) / (hi - lo)) * innerH;\n\n  const ns = 'http://www.w3.org/2000/svg';\n  svgEl.setAttribute('viewBox', `0 0 ${W} ${H}`);\n  svgEl.setAttribute('height', H);\n\n  // Grid + Y-akse labels\n  const TICKS = 5;\n  for (let t = 0; t <= TICKS; t++) {\n    const yVal = lo + (t / TICKS) * (hi - lo);\n    const yPx  = toY(yVal);\n    const line = document.createElementNS(ns, 'line');\n    line.setAttribute('x1', PL); line.setAttribute('x2', W - PR);\n    line.setAttribute('y1', yPx); line.setAttribute('y2', yPx);\n    line.setAttribute('stroke', '#e5e7eb'); line.setAttribute('stroke-width', '1');\n    svgEl.appendChild(line);\n\n    const txt = document.createElementNS(ns, 'text');\n    txt.setAttribute('x', PL - 6); txt.setAttribute('y', yPx + 4);\n    txt.setAttribute('text-anchor', 'end'); txt.setAttribute('font-size', '10');\n    txt.setAttribute('fill', '#9ca3af');\n    txt.textContent = fmtTall(yVal, 0);\n    svgEl.appendChild(txt);\n  }\n\n  // X-akse labels\n  for (let i = 0; i <= n; i++) {\n    const xPx = toX(i);\n    const txt = document.createElementNS(ns, 'text');\n    txt.setAttribute('x', xPx); txt.setAttribute('y', H - PB + 16);\n    txt.setAttribute('text-anchor', 'middle'); txt.setAttribute('font-size', '10');\n    txt.setAttribute('fill', '#9ca3af');\n    txt.textContent = i === 0 ? 'Start' : i;\n    svgEl.appendChild(txt);\n  }\n\n  // Areal under kurven (fill)\n  const fillColor = erOkning ? '#bbf7d0' : '#fecdd3';\n  if (n > 0) {\n    let dFill = `M ${toX(0)} ${toY(verdier[0])}`;\n    for (let i = 1; i <= n; i++) {\n      dFill += ` L ${toX(i)} ${toY(verdier[i])}`;\n    }\n    dFill += ` L ${toX(n)} ${toY(lo)} L ${toX(0)} ${toY(lo)} Z`;\n    const areal = document.createElementNS(ns, 'path');\n    areal.setAttribute('d', dFill);\n    areal.setAttribute('fill', fillColor);\n    areal.setAttribute('opacity', '0.5');\n    svgEl.appendChild(areal);\n  }\n\n  // Linje\n  const lineColor = erOkning ? '#16a34a' : '#dc2626';\n  if (n > 0) {\n    let dLine = `M ${toX(0)} ${toY(verdier[0])}`;\n    for (let i = 1; i <= n; i++) {\n      dLine += ` L ${toX(i)} ${toY(verdier[i])}`;\n    }\n    const path = document.createElementNS(ns, 'path');\n    path.setAttribute('d', dLine);\n    path.setAttribute('fill', 'none');\n    path.setAttribute('stroke', lineColor);\n    path.setAttribute('stroke-width', '2.5');\n    path.setAttribute('stroke-linejoin', 'round');\n    svgEl.appendChild(path);\n  }\n\n  // Punkter med tooltip\n  verdier.forEach((v, i) => {\n    const cx = toX(i);\n    const cy = toY(v);\n\n    const circle = document.createElementNS(ns, 'circle');\n    circle.setAttribute('cx', cx); circle.setAttribute('cy', cy);\n    circle.setAttribute('r', '5');\n    circle.setAttribute('fill', lineColor);\n    circle.setAttribute('stroke', 'white');\n    circle.setAttribute('stroke-width', '2');\n    circle.style.cursor = 'pointer';\n\n    // Hover-effekt\n    circle.addEventListener('mouseenter', function(e) {\n      circle.setAttribute('r', '7');\n      const label = i === 0 ? 'Start' : `Periode ${i}`;\n      tooltipEl.textContent = `${label}: ${fmtTall(v, 2)}`;\n      tooltipEl.style.opacity = '1';\n      positionTooltip(tooltipEl, e, svgEl);\n    });\n    circle.addEventListener('mousemove', function(e) {\n      positionTooltip(tooltipEl, e, svgEl);\n    });\n    circle.addEventListener('mouseleave', function() {\n      circle.setAttribute('r', '5');\n      tooltipEl.style.opacity = '0';\n    });\n    svgEl.appendChild(circle);\n  });\n}\n\nfunction positionTooltip(tooltip, event, svgEl) {\n  const rect = svgEl.getBoundingClientRect();\n  const container = svgEl.closest('.relative');\n  if (!container) return;\n  const containerRect = container.getBoundingClientRect();\n  let x = event.clientX - containerRect.left + 10;\n  let y = event.clientY - containerRect.top - 32;\n  tooltip.style.left = x + 'px';\n  tooltip.style.top  = y + 'px';\n}\n\n// ──────────────────────────────────────────────────────────────────────────────\n// INITIALISERING\n// ──────────────────────────────────────────────────────────────────────────────\nwindow.addEventListener('DOMContentLoaded', function() {\n  loadFromStorage();\n  beregnFrem();\n  beregnBak();\n});\n\n// Redraw charts on resize\nlet resizeTimer;\nwindow.addEventListener('resize', function() {\n  clearTimeout(resizeTimer);\n  resizeTimer = setTimeout(function() {\n    beregnFrem();\n    beregnBak();\n  }, 150);\n});\n</script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Vekstfaktor",
    "windowTitle": "Vekstfaktor",
    "bundleId": "com.halisonworks.vekstfaktor",
    "iconPath": null
  },
  "categoryId": null,
  "source": "import",
  "createdAt": "2026-06-02T12:00:00.000Z",
  "updatedAt": "2026-06-02T12:00:00.000Z",
  "sharedAt": "2026-06-02T12:00:00.000Z"
}
