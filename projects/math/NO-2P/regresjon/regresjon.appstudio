{
  "schema": "app-studio/canvas@1",
  "id": "example-no2p-regresjon",
  "name": "regresjon.html",
  "code": "<!DOCTYPE html>\n<!--\n  Regresjon — Halison App Studio-eksempel\n\n  Interaktivt læremiddel for matematikk 2P (LK20): tilpass lineær-, andregrads-,\n  potens- og eksponentialmodeller til data, med R² og forutsigelser.\n\n  Fra Halison App Studio sitt offentlige bibliotek:\n  https://github.com/halisonworks/public-app-studio\n\n  Tillatt bruk: personlig, pedagogisk og annen ikke-kommersiell bruk. Behold denne\n  headeren og kildelenken; ikke-kommersiell bruk. Utgitt under Halison App Studio\n  Examples License — se LICENSE-filen i repoet over.\n-->\n<html lang=\"no\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Regresjon – Matematikk 2P</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Segoe UI', sans-serif; }\n    .model-btn.active { @apply ring-2 ring-offset-1; }\n    table input[type=\"number\"] {\n      width: 100%;\n      border: none;\n      background: transparent;\n      text-align: center;\n      outline: none;\n      font-size: 0.95rem;\n      padding: 2px 4px;\n    }\n    table input[type=\"number\"]:focus {\n      background: #eff6ff;\n      border-radius: 4px;\n    }\n    /* Remove spinner arrows */\n    input[type=number]::-webkit-inner-spin-button,\n    input[type=number]::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }\n    input[type=number] { -moz-appearance: textfield; }\n    .tooltip { position: relative; cursor: help; }\n    .tooltip .tip {\n      visibility: hidden; opacity: 0;\n      background: #1e293b; color: #f1f5f9;\n      font-size: 0.75rem; padding: 6px 10px;\n      border-radius: 6px; position: absolute;\n      bottom: 130%; left: 50%; transform: translateX(-50%);\n      white-space: nowrap; z-index: 10;\n      transition: opacity 0.15s;\n      pointer-events: none;\n    }\n    .tooltip:hover .tip { visibility: visible; opacity: 1; }\n    svg text { user-select: none; }\n    .equation-box {\n      font-family: 'Cambria Math', 'Times New Roman', serif;\n      font-size: 1.05rem;\n    }\n  </style>\n</head>\n<body class=\"bg-slate-50 min-h-screen\">\n\n<!-- ===== HEADER ===== -->\n<header class=\"bg-indigo-700 text-white shadow-md\">\n  <div class=\"max-w-5xl mx-auto px-4 py-4 flex items-center gap-3\">\n    <div class=\"bg-white/20 rounded-lg p-2\">\n      <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-7 w-7\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\">\n        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z\" />\n      </svg>\n    </div>\n    <div>\n      <h1 class=\"text-xl font-bold leading-tight\">Regresjon</h1>\n      <p class=\"text-indigo-200 text-sm\">Matematikk 2P · LK20 · Kap. 5.2 / 5.4 / 5.6</p>\n    </div>\n  </div>\n</header>\n\n<!-- ===== MAIN ===== -->\n<main class=\"max-w-5xl mx-auto px-4 py-6 space-y-6\">\n\n  <!-- ── Kort intro ── -->\n  <section class=\"bg-white rounded-xl shadow-sm p-4 text-sm text-slate-600 border-l-4 border-indigo-400\">\n    <strong class=\"text-slate-800\">Hva er regresjon?</strong>\n    Regresjon handler om å finne den matematiske modellen som passer best til et datasett.\n    Vi beregner <em>forklaringsgraden R²</em> (0–1) for hver modell — jo nærmere 1, desto bedre tilpasning.\n    Skriv inn dine egne datapunkter i tabellen nedenfor.\n  </section>\n\n  <!-- ══════ DATASETT ══════ -->\n  <section class=\"bg-white rounded-xl shadow-sm p-5\">\n    <div class=\"flex items-center justify-between mb-3\">\n      <h2 class=\"text-base font-semibold text-slate-800\">Datasett</h2>\n      <div class=\"flex gap-2\">\n        <button id=\"btnAddRow\"\n          class=\"text-sm bg-indigo-600 hover:bg-indigo-700 text-white px-3 py-1.5 rounded-lg transition\">\n          + Legg til rad\n        </button>\n        <button id=\"btnReset\"\n          class=\"text-sm bg-slate-100 hover:bg-slate-200 text-slate-700 px-3 py-1.5 rounded-lg transition\">\n          Tilbakestill\n        </button>\n      </div>\n    </div>\n\n    <div class=\"overflow-x-auto\">\n      <table class=\"w-full border-collapse text-sm\" id=\"dataTable\">\n        <thead>\n          <tr class=\"bg-slate-100 text-slate-600\">\n            <th class=\"px-3 py-2 text-center w-10\">#</th>\n            <th class=\"px-3 py-2 text-center w-32\">x</th>\n            <th class=\"px-3 py-2 text-center w-32\">y</th>\n            <th class=\"px-3 py-2 w-10\"></th>\n          </tr>\n        </thead>\n        <tbody id=\"tableBody\" class=\"divide-y divide-slate-100\">\n        </tbody>\n      </table>\n    </div>\n    <p class=\"text-xs text-slate-400 mt-2\">Tips: klikk en celle for å redigere. Minimalt 3 datapunkter kreves.</p>\n  </section>\n\n  <!-- ══════ MODELLKORT ══════ -->\n  <section>\n    <h2 class=\"text-base font-semibold text-slate-800 mb-3\">Tilpassede modeller</h2>\n    <div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\" id=\"modelCards\">\n      <!-- Filled by JS -->\n    </div>\n  </section>\n\n  <!-- ══════ ANBEFALING ══════ -->\n  <section id=\"bestModelSection\" class=\"bg-indigo-50 border border-indigo-200 rounded-xl p-4 text-sm hidden\">\n    <span class=\"font-semibold text-indigo-800\" id=\"bestModelText\"></span>\n  </section>\n\n  <!-- ══════ GRAF ══════ -->\n  <section class=\"bg-white rounded-xl shadow-sm p-5\">\n    <div class=\"flex flex-wrap items-center justify-between gap-3 mb-4\">\n      <h2 class=\"text-base font-semibold text-slate-800\">Graf</h2>\n      <div class=\"flex flex-wrap gap-2\" id=\"modelToggle\">\n        <!-- Buttons injected by JS -->\n      </div>\n    </div>\n    <div id=\"svgContainer\" class=\"w-full overflow-x-auto\">\n      <!-- SVG injected by JS -->\n    </div>\n    <p class=\"text-xs text-slate-400 mt-2\">\n      Blå punkter = observerte datapunkter · Farget kurve = valgt modell\n    </p>\n  </section>\n\n  <!-- ══════ FORUTSIGELSE ══════ -->\n  <section class=\"bg-white rounded-xl shadow-sm p-5\">\n    <h2 class=\"text-base font-semibold text-slate-800 mb-3\">Forutsigelse</h2>\n    <div class=\"flex flex-wrap gap-3 items-end\">\n      <div>\n        <label class=\"block text-xs text-slate-500 mb-1\" for=\"predX\">Oppgi x-verdi</label>\n        <input type=\"number\" id=\"predX\" step=\"any\"\n          class=\"border border-slate-300 rounded-lg px-3 py-2 text-sm w-36 focus:outline-none focus:ring-2 focus:ring-indigo-400\"\n          placeholder=\"f.eks. 7\" />\n      </div>\n      <button id=\"btnPredict\"\n        class=\"bg-indigo-600 hover:bg-indigo-700 text-white text-sm px-4 py-2 rounded-lg transition\">\n        Beregn y\n      </button>\n      <div id=\"predResult\" class=\"text-sm text-slate-700 font-medium mt-1 hidden\">\n        <span id=\"predText\"></span>\n      </div>\n    </div>\n    <p class=\"text-xs text-slate-400 mt-3\" id=\"predNote\"></p>\n    <div class=\"mt-3 p-3 bg-amber-50 border border-amber-200 rounded-lg text-xs text-amber-800\">\n      <strong>OBS – ekstrapolering:</strong> Forutsigelser utenfor dataområdet er usikre.\n      Modellen er kun pålitelig nær der du har observert data.\n    </div>\n  </section>\n\n</main>\n\n<footer class=\"text-center text-xs text-slate-400 py-6\">\n  Matematikk 2P · Regresjon · Halison App Studio ·\n  <a href=\"https://github.com/halisonworks/public-app-studio\" class=\"underline hover:text-slate-600\" target=\"_blank\">GitHub</a>\n</footer>\n\n<!-- ══════════ JAVASCRIPT ══════════ -->\n<script>\n\"use strict\";\n\n// ─────────────────────────────────────\n//  Default dataset (realistisk: antall solgte is-krem pr dag vs temperatur)\n// ─────────────────────────────────────\nconst DEFAULT_DATA = [\n  [10, 22], [13, 35], [16, 54], [19, 80], [22, 118],\n  [25, 172], [28, 245], [31, 342], [34, 470], [37, 640]\n];\n\nlet tableData = DEFAULT_DATA.map(r => [...r]);\n\n// Model colors\nconst MODEL_META = {\n  linear:  { label: 'Lineær',      color: '#6366f1', textColor: 'text-indigo-600'  },\n  poly:    { label: 'Andregrads',  color: '#10b981', textColor: 'text-emerald-600' },\n  power:   { label: 'Potens',      color: '#f59e0b', textColor: 'text-amber-500'   },\n  exp:     { label: 'Eksponential',color: '#ef4444', textColor: 'text-red-500'     }\n};\n\nlet activeModel = 'linear';\nlet fitResults = {};\n\n// ─────────────────────────────────────\n//  Helpers\n// ─────────────────────────────────────\nfunction sum(arr) { return arr.reduce((a, b) => a + b, 0); }\n\nfunction mean(arr) { return sum(arr) / arr.length; }\n\nfunction rSquared(ys, yHats) {\n  const yBar = mean(ys);\n  const ssTot = sum(ys.map(y => (y - yBar) ** 2));\n  const ssRes = sum(ys.map((y, i) => (y - yHats[i]) ** 2));\n  if (ssTot === 0) return 1;\n  return 1 - ssRes / ssTot;\n}\n\nfunction fmtNum(n, dec = 4) {\n  if (!isFinite(n)) return '–';\n  return parseFloat(n.toFixed(dec)).toString();\n}\n\nfunction fmtEq(n, dec = 3) {\n  if (!isFinite(n)) return '?';\n  const v = parseFloat(n.toFixed(dec));\n  return v < 0 ? String(v) : String(v);\n}\n\n// ─────────────────────────────────────\n//  Regression algorithms\n// ─────────────────────────────────────\n\n// Linear: y = ax + b  (OLS)\nfunction fitLinear(pts) {\n  const n = pts.length;\n  const xs = pts.map(p => p[0]);\n  const ys = pts.map(p => p[1]);\n  const sx = sum(xs), sy = sum(ys);\n  const sxx = sum(xs.map(x => x * x));\n  const sxy = sum(pts.map(p => p[0] * p[1]));\n  const denom = n * sxx - sx * sx;\n  if (denom === 0) return null;\n  const a = (n * sxy - sx * sy) / denom;\n  const b = (sy - a * sx) / n;\n  const yHats = xs.map(x => a * x + b);\n  const r2 = rSquared(ys, yHats);\n  return { a, b, r2, fn: x => a * x + b,\n    eq: `y = ${fmtEq(a)}x ${b >= 0 ? '+' : '−'} ${fmtEq(Math.abs(b))}` };\n}\n\n// Quadratic: y = ax² + bx + c  (normal equations via 3×3 system)\nfunction fitPoly(pts) {\n  const n = pts.length;\n  if (n < 3) return null;\n  const xs = pts.map(p => p[0]);\n  const ys = pts.map(p => p[1]);\n  // sums\n  const s0 = n;\n  const s1 = sum(xs);\n  const s2 = sum(xs.map(x => x ** 2));\n  const s3 = sum(xs.map(x => x ** 3));\n  const s4 = sum(xs.map(x => x ** 4));\n  const t0 = sum(ys);\n  const t1 = sum(pts.map(p => p[0] * p[1]));\n  const t2 = sum(pts.map(p => p[0] ** 2 * p[1]));\n  // Solve 3x3 via Cramer / Gaussian elim\n  // [ s0 s1 s2 ] [c]   [t0]\n  // [ s1 s2 s3 ] [b] = [t1]\n  // [ s2 s3 s4 ] [a]   [t2]\n  const M = [[s0, s1, s2, t0], [s1, s2, s3, t1], [s2, s3, s4, t2]];\n  const sol = gauss3(M);\n  if (!sol) return null;\n  const [c, b, a] = sol;\n  const yHats = xs.map(x => a * x * x + b * x + c);\n  const r2 = rSquared(ys, yHats);\n  return { a, b, c, r2, fn: x => a * x * x + b * x + c,\n    eq: `y = ${fmtEq(a)}x² ${b >= 0 ? '+' : '−'} ${fmtEq(Math.abs(b))}x ${c >= 0 ? '+' : '−'} ${fmtEq(Math.abs(c))}` };\n}\n\n// Gaussian elimination for 3×3 augmented matrix [M|rhs]\nfunction gauss3(M) {\n  const m = M.map(r => [...r]); // deep copy\n  for (let col = 0; col < 3; col++) {\n    // Partial pivot\n    let maxRow = col;\n    for (let row = col + 1; row < 3; row++) {\n      if (Math.abs(m[row][col]) > Math.abs(m[maxRow][col])) maxRow = row;\n    }\n    [m[col], m[maxRow]] = [m[maxRow], m[col]];\n    if (Math.abs(m[col][col]) < 1e-12) return null;\n    for (let row = col + 1; row < 3; row++) {\n      const f = m[row][col] / m[col][col];\n      for (let k = col; k <= 3; k++) m[row][k] -= f * m[col][k];\n    }\n  }\n  // Back-substitution\n  const x = [0, 0, 0];\n  for (let i = 2; i >= 0; i--) {\n    x[i] = m[i][3];\n    for (let j = i + 1; j < 3; j++) x[i] -= m[i][j] * x[j];\n    x[i] /= m[i][i];\n  }\n  return x;\n}\n\n// Power: y = a·x^b  → ln y = ln a + b·ln x  (requires x,y > 0)\nfunction fitPower(pts) {\n  const valid = pts.filter(p => p[0] > 0 && p[1] > 0);\n  if (valid.length < 2) return { error: 'Krever x > 0 og y > 0 for alle punkter', r2: NaN };\n  const n = valid.length;\n  const lx = valid.map(p => Math.log(p[0]));\n  const ly = valid.map(p => Math.log(p[1]));\n  const slx = sum(lx), sly = sum(ly);\n  const slxlx = sum(lx.map(v => v * v));\n  const slxly = sum(lx.map((v, i) => v * ly[i]));\n  const denom = n * slxlx - slx * slx;\n  if (denom === 0) return null;\n  const b = (n * slxly - slx * sly) / denom;\n  const a = Math.exp((sly - b * slx) / n);\n  const xs = valid.map(p => p[0]);\n  const ys = valid.map(p => p[1]);\n  const yHats = xs.map(x => a * Math.pow(x, b));\n  const r2 = rSquared(ys, yHats);\n  return { a, b, r2, fn: x => a * Math.pow(x, b),\n    eq: `y = ${fmtEq(a)}·x^${fmtEq(b)}`,\n    note: 'Krever x > 0 og y > 0' };\n}\n\n// Exponential: y = b·a^x  → ln y = ln b + x·ln a  (requires y > 0)\nfunction fitExp(pts) {\n  const valid = pts.filter(p => p[1] > 0);\n  if (valid.length < 2) return { error: 'Krever y > 0 for alle punkter', r2: NaN };\n  const n = valid.length;\n  const xs = valid.map(p => p[0]);\n  const ly = valid.map(p => Math.log(p[1]));\n  const sx = sum(xs), sly = sum(ly);\n  const sxx = sum(xs.map(v => v * v));\n  const sxly = sum(xs.map((v, i) => v * ly[i]));\n  const denom = n * sxx - sx * sx;\n  if (denom === 0) return null;\n  const lnA = (n * sxly - sx * sly) / denom;  // ln a\n  const lnB = (sly - lnA * sx) / n;             // ln b\n  const a = Math.exp(lnA);\n  const b = Math.exp(lnB);\n  const ys = valid.map(p => p[1]);\n  const yHats = xs.map(x => b * Math.pow(a, x));\n  const r2 = rSquared(ys, yHats);\n  return { a, b, r2, fn: x => b * Math.pow(a, x),\n    eq: `y = ${fmtEq(b)}·${fmtEq(a)}^x`,\n    note: 'Krever y > 0' };\n}\n\n// ─────────────────────────────────────\n//  Table rendering\n// ─────────────────────────────────────\nfunction renderTable() {\n  const tbody = document.getElementById('tableBody');\n  tbody.innerHTML = '';\n  tableData.forEach((row, i) => {\n    const tr = document.createElement('tr');\n    tr.className = 'hover:bg-slate-50';\n    tr.innerHTML = `\n      <td class=\"px-3 py-1.5 text-center text-slate-400 text-xs\">${i + 1}</td>\n      <td class=\"px-3 py-1.5 text-center\">\n        <input type=\"number\" step=\"any\" value=\"${row[0]}\" data-row=\"${i}\" data-col=\"0\" />\n      </td>\n      <td class=\"px-3 py-1.5 text-center\">\n        <input type=\"number\" step=\"any\" value=\"${row[1]}\" data-row=\"${i}\" data-col=\"1\" />\n      </td>\n      <td class=\"px-3 py-1.5 text-center\">\n        ${tableData.length > 3 ? `<button data-del=\"${i}\" class=\"text-slate-300 hover:text-red-400 transition text-lg leading-none\" title=\"Slett rad\">×</button>` : ''}\n      </td>`;\n    tbody.appendChild(tr);\n  });\n\n  // Events\n  tbody.querySelectorAll('input[type=\"number\"]').forEach(inp => {\n    inp.addEventListener('change', () => {\n      const r = parseInt(inp.dataset.row);\n      const c = parseInt(inp.dataset.col);\n      const v = parseFloat(inp.value);\n      if (!isNaN(v)) {\n        tableData[r][c] = v;\n        update();\n      }\n    });\n  });\n  tbody.querySelectorAll('button[data-del]').forEach(btn => {\n    btn.addEventListener('click', () => {\n      tableData.splice(parseInt(btn.dataset.del), 1);\n      renderTable();\n      update();\n    });\n  });\n}\n\n// ─────────────────────────────────────\n//  Model cards\n// ─────────────────────────────────────\nfunction renderModelCards() {\n  const container = document.getElementById('modelCards');\n  container.innerHTML = '';\n  const models = ['linear', 'poly', 'power', 'exp'];\n  models.forEach(key => {\n    const res = fitResults[key];\n    const meta = MODEL_META[key];\n    const card = document.createElement('div');\n    card.className = 'bg-white border rounded-xl p-4 shadow-sm flex flex-col gap-2';\n    const r2str = (res && isFinite(res.r2)) ? (res.r2 * 100).toFixed(1) + '%' : '–';\n    const r2color = (!res || !isFinite(res.r2)) ? 'text-slate-400' :\n                    res.r2 >= 0.95 ? 'text-emerald-600 font-bold' :\n                    res.r2 >= 0.80 ? 'text-amber-500 font-semibold' : 'text-red-500';\n    const eqHtml = res && res.eq ? `<span class=\"equation-box text-slate-700\">${res.eq}</span>` : '<span class=\"text-slate-400 text-xs\">Kan ikke beregnes</span>';\n    const errHtml = res && res.error ? `<span class=\"text-xs text-red-400\">${res.error}</span>` : '';\n    const noteHtml = res && res.note ? `<span class=\"text-xs text-slate-400\">${res.note}</span>` : '';\n    card.innerHTML = `\n      <div class=\"flex items-center gap-2\">\n        <span class=\"w-3 h-3 rounded-full flex-shrink-0\" style=\"background:${meta.color}\"></span>\n        <span class=\"font-semibold text-slate-700 text-sm\">${meta.label}</span>\n      </div>\n      <div class=\"min-h-[1.6rem]\">${eqHtml}</div>\n      ${errHtml}\n      ${noteHtml}\n      <div class=\"flex items-center justify-between mt-auto pt-2 border-t border-slate-100\">\n        <span class=\"text-xs text-slate-500\">R²</span>\n        <span class=\"text-sm ${r2color}\">${r2str}</span>\n      </div>`;\n    container.appendChild(card);\n  });\n}\n\n// ─────────────────────────────────────\n//  Model toggle buttons\n// ─────────────────────────────────────\nfunction renderToggleButtons() {\n  const container = document.getElementById('modelToggle');\n  container.innerHTML = '';\n  Object.entries(MODEL_META).forEach(([key, meta]) => {\n    const btn = document.createElement('button');\n    btn.id = `toggle-${key}`;\n    btn.textContent = meta.label;\n    btn.className = 'text-xs px-3 py-1.5 rounded-full border transition font-medium';\n    btn.style.borderColor = meta.color;\n    btn.style.color = activeModel === key ? '#fff' : meta.color;\n    btn.style.background = activeModel === key ? meta.color : 'transparent';\n    btn.addEventListener('click', () => {\n      activeModel = key;\n      renderToggleButtons();\n      drawSVG();\n    });\n    container.appendChild(btn);\n  });\n}\n\n// ─────────────────────────────────────\n//  Best model suggestion\n// ─────────────────────────────────────\nfunction renderBestModel() {\n  const sec = document.getElementById('bestModelSection');\n  const txt = document.getElementById('bestModelText');\n  let best = null, bestR2 = -Infinity;\n  Object.entries(fitResults).forEach(([k, r]) => {\n    if (r && isFinite(r.r2) && r.r2 > bestR2) { bestR2 = r.r2; best = k; }\n  });\n  if (best) {\n    const pct = (bestR2 * 100).toFixed(1);\n    txt.textContent = `Anbefalt modell: ${MODEL_META[best].label} (R² = ${pct}%) — dette gir best tilpasning til dataene.`;\n    sec.classList.remove('hidden');\n  } else {\n    sec.classList.add('hidden');\n  }\n}\n\n// ─────────────────────────────────────\n//  SVG chart\n// ─────────────────────────────────────\nfunction drawSVG() {\n  const container = document.getElementById('svgContainer');\n  const pts = tableData.filter(p => isFinite(p[0]) && isFinite(p[1]));\n  if (pts.length < 2) {\n    container.innerHTML = '<p class=\"text-sm text-slate-400 py-8 text-center\">Ikke nok gyldige datapunkter.</p>';\n    return;\n  }\n\n  const res = fitResults[activeModel];\n  const meta = MODEL_META[activeModel];\n\n  // Chart dimensions\n  const W = 560, H = 360;\n  const pad = { top: 20, right: 20, bottom: 50, left: 60 };\n  const cW = W - pad.left - pad.right;\n  const cH = H - pad.top - pad.bottom;\n\n  // Data range\n  const xVals = pts.map(p => p[0]);\n  const yVals = pts.map(p => p[1]);\n  let xMin = Math.min(...xVals), xMax = Math.max(...xVals);\n  let yMin = Math.min(...yVals), yMax = Math.max(...yVals);\n\n  // Extend x-range for curve\n  const xPad = (xMax - xMin) * 0.08 || 1;\n  const xStart = xMin - xPad;\n  const xEnd = xMax + xPad;\n\n  // Compute curve points to get y-range too\n  let curvePoints = [];\n  if (res && res.fn && isFinite(res.r2)) {\n    const steps = 200;\n    for (let i = 0; i <= steps; i++) {\n      const x = xStart + (i / steps) * (xEnd - xStart);\n      const y = res.fn(x);\n      if (isFinite(y)) curvePoints.push([x, y]);\n    }\n    if (curvePoints.length > 0) {\n      yMin = Math.min(yMin, ...curvePoints.map(p => p[1]));\n      yMax = Math.max(yMax, ...curvePoints.map(p => p[1]));\n    }\n  }\n\n  // Expand y-range a bit\n  const yRange = yMax - yMin || 1;\n  yMin -= yRange * 0.08;\n  yMax += yRange * 0.12;\n\n  const sx = x => pad.left + ((x - xStart) / (xEnd - xStart)) * cW;\n  const sy = y => pad.top + cH - ((y - yMin) / (yMax - yMin)) * cH;\n\n  // Nice tick generation\n  function niceTicks(lo, hi, count = 6) {\n    const range = hi - lo;\n    const raw = range / count;\n    const mag = Math.pow(10, Math.floor(Math.log10(raw)));\n    const nice = [1, 2, 2.5, 5, 10].map(f => f * mag).find(f => f >= raw) || raw;\n    const ticks = [];\n    const start = Math.ceil(lo / nice) * nice;\n    for (let t = start; t <= hi + nice * 0.01; t += nice) {\n      if (t >= lo - nice * 0.01) ticks.push(parseFloat(t.toFixed(10)));\n    }\n    return ticks;\n  }\n\n  const xTicks = niceTicks(xStart, xEnd, 7);\n  const yTicks = niceTicks(yMin, yMax, 6);\n\n  let svg = `<svg viewBox=\"0 0 ${W} ${H}\" width=\"${W}\" height=\"${H}\" style=\"max-width:100%;display:block;margin:auto;\" xmlns=\"http://www.w3.org/2000/svg\">`;\n\n  // Background\n  svg += `<rect x=\"${pad.left}\" y=\"${pad.top}\" width=\"${cW}\" height=\"${cH}\" fill=\"#f8fafc\" rx=\"4\"/>`;\n\n  // Grid lines\n  yTicks.forEach(t => {\n    const y = sy(t);\n    if (y >= pad.top && y <= pad.top + cH) {\n      svg += `<line x1=\"${pad.left}\" y1=\"${y}\" x2=\"${pad.left + cW}\" y2=\"${y}\" stroke=\"#e2e8f0\" stroke-width=\"1\"/>`;\n    }\n  });\n  xTicks.forEach(t => {\n    const x = sx(t);\n    if (x >= pad.left && x <= pad.left + cW) {\n      svg += `<line x1=\"${x}\" y1=\"${pad.top}\" x2=\"${x}\" y2=\"${pad.top + cH}\" stroke=\"#e2e8f0\" stroke-width=\"1\"/>`;\n    }\n  });\n\n  // Zero lines (if in range)\n  if (yMin < 0 && yMax > 0) {\n    const y0 = sy(0);\n    svg += `<line x1=\"${pad.left}\" y1=\"${y0}\" x2=\"${pad.left + cW}\" y2=\"${y0}\" stroke=\"#94a3b8\" stroke-width=\"1\" stroke-dasharray=\"4,3\"/>`;\n  }\n  if (xStart < 0 && xEnd > 0) {\n    const x0 = sx(0);\n    svg += `<line x1=\"${x0}\" y1=\"${pad.top}\" x2=\"${x0}\" y2=\"${pad.top + cH}\" stroke=\"#94a3b8\" stroke-width=\"1\" stroke-dasharray=\"4,3\"/>`;\n  }\n\n  // Axes\n  svg += `<line x1=\"${pad.left}\" y1=\"${pad.top}\" x2=\"${pad.left}\" y2=\"${pad.top + cH}\" stroke=\"#475569\" stroke-width=\"1.5\"/>`;\n  svg += `<line x1=\"${pad.left}\" y1=\"${pad.top + cH}\" x2=\"${pad.left + cW}\" y2=\"${pad.top + cH}\" stroke=\"#475569\" stroke-width=\"1.5\"/>`;\n\n  // X tick labels\n  xTicks.forEach(t => {\n    const x = sx(t);\n    if (x >= pad.left - 2 && x <= pad.left + cW + 2) {\n      svg += `<line x1=\"${x}\" y1=\"${pad.top + cH}\" x2=\"${x}\" y2=\"${pad.top + cH + 5}\" stroke=\"#475569\" stroke-width=\"1\"/>`;\n      svg += `<text x=\"${x}\" y=\"${pad.top + cH + 18}\" text-anchor=\"middle\" font-size=\"11\" fill=\"#475569\">${fmtNum(t, 2)}</text>`;\n    }\n  });\n\n  // Y tick labels\n  yTicks.forEach(t => {\n    const y = sy(t);\n    if (y >= pad.top && y <= pad.top + cH) {\n      svg += `<line x1=\"${pad.left - 5}\" y1=\"${y}\" x2=\"${pad.left}\" y2=\"${y}\" stroke=\"#475569\" stroke-width=\"1\"/>`;\n      svg += `<text x=\"${pad.left - 8}\" y=\"${y + 4}\" text-anchor=\"end\" font-size=\"11\" fill=\"#475569\">${fmtNum(t, 1)}</text>`;\n    }\n  });\n\n  // Axis labels\n  svg += `<text x=\"${pad.left + cW / 2}\" y=\"${H - 6}\" text-anchor=\"middle\" font-size=\"12\" fill=\"#64748b\">x</text>`;\n  svg += `<text x=\"13\" y=\"${pad.top + cH / 2}\" text-anchor=\"middle\" font-size=\"12\" fill=\"#64748b\" transform=\"rotate(-90,13,${pad.top + cH / 2})\">y</text>`;\n\n  // Curve\n  if (curvePoints.length > 1) {\n    const pathParts = [];\n    let penDown = false;\n    curvePoints.forEach(([cx, cy]) => {\n      const px = sx(cx), py = sy(cy);\n      if (py < pad.top - 5 || py > pad.top + cH + 5) { penDown = false; return; }\n      if (!penDown) { pathParts.push(`M ${px.toFixed(1)} ${py.toFixed(1)}`); penDown = true; }\n      else { pathParts.push(`L ${px.toFixed(1)} ${py.toFixed(1)}`); }\n    });\n    if (pathParts.length > 1) {\n      svg += `<path d=\"${pathParts.join(' ')}\" fill=\"none\" stroke=\"${meta.color}\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/>`;\n    }\n  }\n\n  // Data points\n  pts.forEach(([px, py]) => {\n    const cx = sx(px), cy = sy(py);\n    if (cx >= pad.left - 8 && cx <= pad.left + cW + 8 && cy >= pad.top - 8 && cy <= pad.top + cH + 8) {\n      svg += `<circle cx=\"${cx.toFixed(1)}\" cy=\"${cy.toFixed(1)}\" r=\"5\" fill=\"#3b82f6\" stroke=\"#fff\" stroke-width=\"1.5\"/>`;\n    }\n  });\n\n  // Legend\n  const legendX = pad.left + cW - 10;\n  const legendY = pad.top + 10;\n  svg += `<rect x=\"${legendX - 100}\" y=\"${legendY}\" width=\"110\" height=\"30\" rx=\"4\" fill=\"white\" opacity=\"0.85\"/>`;\n  svg += `<line x1=\"${legendX - 92}\" y1=\"${legendY + 10}\" x2=\"${legendX - 72}\" y2=\"${legendY + 10}\" stroke=\"${meta.color}\" stroke-width=\"2.5\"/>`;\n  svg += `<text x=\"${legendX - 68}\" y=\"${legendY + 14}\" font-size=\"11\" fill=\"#475569\">${meta.label}</text>`;\n  svg += `<circle cx=\"${legendX - 82}\" cy=\"${legendY + 24}\" r=\"4\" fill=\"#3b82f6\" stroke=\"#fff\" stroke-width=\"1\"/>`;\n  svg += `<text x=\"${legendX - 68}\" y=\"${legendY + 28}\" font-size=\"11\" fill=\"#475569\">Datapunkter</text>`;\n\n  svg += '</svg>';\n  container.innerHTML = svg;\n}\n\n// ─────────────────────────────────────\n//  Prediction\n// ─────────────────────────────────────\nfunction updatePredNote() {\n  const note = document.getElementById('predNote');\n  const res = fitResults[activeModel];\n  if (res && res.note) {\n    note.textContent = `Merk: ${res.note}`;\n  } else {\n    note.textContent = '';\n  }\n}\n\ndocument.getElementById('btnPredict').addEventListener('click', () => {\n  const xInput = parseFloat(document.getElementById('predX').value);\n  const predResult = document.getElementById('predResult');\n  const predText = document.getElementById('predText');\n  if (isNaN(xInput)) {\n    predText.textContent = 'Ugyldig x-verdi.';\n    predResult.classList.remove('hidden');\n    return;\n  }\n  const res = fitResults[activeModel];\n  if (!res || !res.fn || !isFinite(res.r2)) {\n    predText.textContent = 'Modellen kan ikke beregnes for dette datasettet.';\n    predResult.classList.remove('hidden');\n    return;\n  }\n  const y = res.fn(xInput);\n  if (!isFinite(y)) {\n    predText.textContent = `Kan ikke beregne y for x = ${xInput} med denne modellen.`;\n  } else {\n    const model = MODEL_META[activeModel].label.toLowerCase();\n    predText.textContent = `Med ${model}modellen: x = ${xInput} → y ≈ ${fmtNum(y, 3)}`;\n  }\n  predResult.classList.remove('hidden');\n});\n\n// ─────────────────────────────────────\n//  Add row / reset\n// ─────────────────────────────────────\ndocument.getElementById('btnAddRow').addEventListener('click', () => {\n  const last = tableData[tableData.length - 1] || [0, 0];\n  tableData.push([last[0] + 1, '']);\n  renderTable();\n  // focus last x input\n  const inputs = document.querySelectorAll('#tableBody input');\n  if (inputs.length) inputs[inputs.length - 2].focus();\n  update();\n});\n\ndocument.getElementById('btnReset').addEventListener('click', () => {\n  tableData = DEFAULT_DATA.map(r => [...r]);\n  renderTable();\n  update();\n});\n\n// ─────────────────────────────────────\n//  Main update\n// ─────────────────────────────────────\nfunction update() {\n  const pts = tableData.filter(p => isFinite(p[0]) && isFinite(p[1]));\n  fitResults = {\n    linear: pts.length >= 2 ? fitLinear(pts) : null,\n    poly:   pts.length >= 3 ? fitPoly(pts) : null,\n    power:  pts.length >= 2 ? fitPower(pts) : null,\n    exp:    pts.length >= 2 ? fitExp(pts) : null\n  };\n  renderModelCards();\n  renderToggleButtons();\n  renderBestModel();\n  drawSVG();\n  updatePredNote();\n}\n\n// ─────────────────────────────────────\n//  Init\n// ─────────────────────────────────────\nrenderTable();\nupdate();\n</script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Regresjon",
    "windowTitle": "Regresjon",
    "bundleId": "com.halisonworks.regresjon2p",
    "iconPath": null
  },
