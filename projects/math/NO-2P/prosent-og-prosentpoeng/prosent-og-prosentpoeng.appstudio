{
  "schema": "app-studio/canvas@1",
  "id": "example-no2p-prosent-og-prosentpoeng",
  "name": "prosent-og-prosentpoeng.html",
  "code": "<!DOCTYPE html>\n<!--\n  Prosent og prosentpoeng — Halison App Studio-eksempel\n\n  Interaktivt læremiddel for matematikk 2P (LK20): forskjellen på prosentpoeng og\n  prosentvis endring, pluss en prosentkalkulator med tre regnemåter.\n\n  Fra Halison App Studio sitt offentlige bibliotek:\n  https://github.com/halisonworks/public-app-studio\n\n  Tillatt bruk: personlig, pedagogisk og annen ikke-kommersiell bruk. Behold denne\n  headeren og kildelenken; ikke-kommersiell bruk. Utgitt under Halison App Studio\n  Examples License — se LICENSE-filen i repoet over.\n-->\n<html lang=\"no\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Prosent og prosentpoeng – Matematikk 2P</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Segoe UI', system-ui, sans-serif; }\n    .bar-container { transition: width 0.4s ease; }\n    input[type=number]::-webkit-inner-spin-button,\n    input[type=number]::-webkit-outer-spin-button { opacity: 1; }\n    .formula-box { font-family: 'Courier New', monospace; }\n    .tab-btn.active { border-bottom: 3px solid #6366f1; color: #6366f1; font-weight: 700; }\n    .section-card { scroll-margin-top: 1rem; }\n  </style>\n</head>\n<body class=\"bg-gray-50 min-h-screen\">\n\n  <!-- Header -->\n  <header class=\"bg-indigo-700 text-white shadow-md\">\n    <div class=\"max-w-3xl mx-auto px-4 py-5\">\n      <p class=\"text-indigo-200 text-sm font-semibold uppercase tracking-widest mb-1\">Matematikk 2P · LK20</p>\n      <h1 class=\"text-2xl sm:text-3xl font-bold\">Prosent og prosentpoeng</h1>\n      <p class=\"mt-1 text-indigo-100 text-sm\">Lær forskjellen — og regn selv</p>\n    </div>\n  </header>\n\n  <main class=\"max-w-3xl mx-auto px-4 py-8 space-y-10\">\n\n    <!-- ─── SEKSJON 1: FORKLARING ─── -->\n    <section class=\"section-card bg-white rounded-2xl shadow p-6 sm:p-8\" id=\"forklaring\">\n      <h2 class=\"text-xl font-bold text-indigo-700 mb-4\">Hva er forskjellen?</h2>\n\n      <div class=\"grid sm:grid-cols-2 gap-5 mb-6\">\n        <!-- Prosentpoeng -->\n        <div class=\"bg-amber-50 border border-amber-200 rounded-xl p-4\">\n          <h3 class=\"font-bold text-amber-800 mb-2\">📐 Prosentpoeng</h3>\n          <p class=\"text-sm text-amber-900 leading-relaxed\">\n            <strong>Prosentpoeng</strong> er den <em>aritmetiske differansen</em> mellom to prosenttall.\n            Du trekker rett og slett det ene fra det andre.\n          </p>\n          <div class=\"formula-box bg-amber-100 rounded-lg mt-3 px-3 py-2 text-sm text-amber-900\">\n            Endring = til − fra\n          </div>\n          <p class=\"text-xs text-amber-700 mt-2\">\n            Eks.: Renten øker fra 2 % til 3 %. Det er <strong>1 prosentpoeng</strong> opp.\n          </p>\n        </div>\n\n        <!-- Prosentvis endring -->\n        <div class=\"bg-sky-50 border border-sky-200 rounded-xl p-4\">\n          <h3 class=\"font-bold text-sky-800 mb-2\">📊 Prosentvis endring</h3>\n          <p class=\"text-sm text-sky-900 leading-relaxed\">\n            <strong>Prosentvis endring</strong> sier hvor mye endringen er <em>relativt til utgangspunktet</em>.\n            Den svarer på: «Hvor stor økning er dette sammenlignet med det vi startet med?»\n          </p>\n          <div class=\"formula-box bg-sky-100 rounded-lg mt-3 px-3 py-2 text-sm text-sky-900\">\n            Endring = (til − fra) / fra · 100 %\n          </div>\n          <p class=\"text-xs text-sky-700 mt-2\">\n            Eks.: Fra 2 % til 3 %: (3−2)/2 · 100 % = <strong>50 % økning</strong> i renten.\n          </p>\n        </div>\n      </div>\n\n      <div class=\"bg-indigo-50 border-l-4 border-indigo-400 rounded-r-xl p-4 text-sm text-indigo-900\">\n        <strong>Klassisk eksempel:</strong> En bank hever boliglånsrenten fra 2,0 % til 3,0 %.\n        Avisen skriver «renten økte med 1 prosentpoeng». Det er korrekt. Men lånet ditt er egentlig\n        50 % dyrere enn før — det er den <em>prosentvise endringen</em>. Begge tallene er riktige,\n        men de forteller ulike ting. Å blande dem er en vanlig feil!\n      </div>\n    </section>\n\n    <!-- ─── SEKSJON 2: INTERAKTIVT EKSEMPEL ─── -->\n    <section class=\"section-card bg-white rounded-2xl shadow p-6 sm:p-8\" id=\"interaktiv\">\n      <h2 class=\"text-xl font-bold text-indigo-700 mb-1\">Prøv selv: fra … til …</h2>\n      <p class=\"text-sm text-gray-500 mb-5\">Endre «fra» og «til» for å se begge beregningene live.</p>\n\n      <!-- Inputs -->\n      <div class=\"flex flex-wrap gap-4 mb-6\">\n        <div class=\"flex-1 min-w-[130px]\">\n          <label class=\"block text-xs font-semibold text-gray-500 uppercase mb-1\" for=\"inp-fra\">Fra (%)</label>\n          <input id=\"inp-fra\" type=\"number\" step=\"0.1\" min=\"0.1\" max=\"99.9\"\n            class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-lg focus:outline-none focus:ring-2 focus:ring-indigo-400\"\n            placeholder=\"f.eks. 2\" />\n        </div>\n        <div class=\"flex items-end pb-2 text-2xl text-gray-400\">→</div>\n        <div class=\"flex-1 min-w-[130px]\">\n          <label class=\"block text-xs font-semibold text-gray-500 uppercase mb-1\" for=\"inp-til\">Til (%)</label>\n          <input id=\"inp-til\" type=\"number\" step=\"0.1\" min=\"0.1\" max=\"100\"\n            class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-lg focus:outline-none focus:ring-2 focus:ring-indigo-400\"\n            placeholder=\"f.eks. 3\" />\n        </div>\n      </div>\n\n      <!-- Kontekst-velger -->\n      <div class=\"mb-5\">\n        <label class=\"block text-xs font-semibold text-gray-500 uppercase mb-1\">Kontekst (valgfritt)</label>\n        <select id=\"ctx-select\"\n          class=\"border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 bg-white\">\n          <option value=\"rente\">Boliglånsrente</option>\n          <option value=\"arbeidsledighet\">Arbeidsledighet</option>\n          <option value=\"stemmer\">Velgerstøtte (parti)</option>\n          <option value=\"egenandel\">Egenandel (helse)</option>\n          <option value=\"fri\">Egendefinert</option>\n        </select>\n      </div>\n\n      <!-- Resultat-kort -->\n      <div id=\"result-box\" class=\"hidden space-y-4\">\n\n        <!-- Visuelle stolper -->\n        <div class=\"bg-gray-50 rounded-xl p-4 border border-gray-200\">\n          <p class=\"text-xs font-semibold text-gray-400 uppercase mb-3\">Visuell sammenligning</p>\n          <div class=\"space-y-3\">\n            <div>\n              <div class=\"flex justify-between text-xs text-gray-500 mb-1\">\n                <span>Fra</span><span id=\"bar-fra-label\" class=\"font-semibold text-gray-700\"></span>\n              </div>\n              <div class=\"w-full bg-gray-200 rounded-full h-5 overflow-hidden\">\n                <div id=\"bar-fra\" class=\"h-5 rounded-full bg-amber-400 bar-container\" style=\"width:0%\"></div>\n              </div>\n            </div>\n            <div>\n              <div class=\"flex justify-between text-xs text-gray-500 mb-1\">\n                <span>Til</span><span id=\"bar-til-label\" class=\"font-semibold text-gray-700\"></span>\n              </div>\n              <div class=\"w-full bg-gray-200 rounded-full h-5 overflow-hidden\">\n                <div id=\"bar-til\" class=\"h-5 rounded-full bg-sky-500 bar-container\" style=\"width:0%\"></div>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <!-- Prosentpoeng -->\n        <div class=\"bg-amber-50 border border-amber-200 rounded-xl p-4\">\n          <div class=\"flex items-center gap-2 mb-2\">\n            <span class=\"bg-amber-400 text-white text-xs font-bold px-2 py-0.5 rounded-full\">PP</span>\n            <span class=\"font-bold text-amber-800\">Endring i prosentpoeng</span>\n          </div>\n          <div class=\"formula-box text-sm bg-amber-100 rounded-lg px-3 py-2 text-amber-900 mb-2\" id=\"pp-formula\"></div>\n          <p class=\"text-amber-800 font-semibold\" id=\"pp-result\"></p>\n          <p class=\"text-xs text-amber-700 mt-1\" id=\"pp-context\"></p>\n        </div>\n\n        <!-- Prosentvis endring -->\n        <div class=\"bg-sky-50 border border-sky-200 rounded-xl p-4\">\n          <div class=\"flex items-center gap-2 mb-2\">\n            <span class=\"bg-sky-500 text-white text-xs font-bold px-2 py-0.5 rounded-full\">%</span>\n            <span class=\"font-bold text-sky-800\">Prosentvis endring</span>\n          </div>\n          <div class=\"formula-box text-sm bg-sky-100 rounded-lg px-3 py-2 text-sky-900 mb-2\" id=\"pv-formula\"></div>\n          <p class=\"text-sky-800 font-semibold\" id=\"pv-result\"></p>\n          <p class=\"text-xs text-sky-700 mt-1\" id=\"pv-context\"></p>\n        </div>\n\n        <!-- Tolkning -->\n        <div class=\"bg-indigo-50 border border-indigo-200 rounded-xl p-4 text-sm text-indigo-900\" id=\"tolkning-box\"></div>\n      </div>\n\n      <!-- Tom melding -->\n      <div id=\"empty-msg\" class=\"text-center text-gray-400 text-sm py-6\">\n        Skriv inn tall i feltene ovenfor for å se resultatene.\n      </div>\n    </section>\n\n    <!-- ─── SEKSJON 3: PROSENTKALKULATOR ─── -->\n    <section class=\"section-card bg-white rounded-2xl shadow p-6 sm:p-8\" id=\"kalkulator\">\n      <h2 class=\"text-xl font-bold text-indigo-700 mb-1\">Prosentkalkulator</h2>\n      <p class=\"text-sm text-gray-500 mb-5\">Velg regnemåte og fyll inn tallene.</p>\n\n      <!-- Faner -->\n      <div class=\"flex border-b border-gray-200 mb-6 gap-1\">\n        <button class=\"tab-btn active px-3 py-2 text-sm text-gray-600 hover:text-indigo-600 transition-colors\" data-tab=\"0\">\n          A % av B\n        </button>\n        <button class=\"tab-btn px-3 py-2 text-sm text-gray-600 hover:text-indigo-600 transition-colors\" data-tab=\"1\">\n          A av B i %\n        </button>\n        <button class=\"tab-btn px-3 py-2 text-sm text-gray-600 hover:text-indigo-600 transition-colors\" data-tab=\"2\">\n          Endring A→B\n        </button>\n      </div>\n\n      <!-- Fane 0: Hva er A % av B? -->\n      <div class=\"calc-tab\" id=\"tab-0\">\n        <p class=\"text-sm text-gray-600 mb-4\">\n          <strong>Eksempel:</strong> Hva er 15 % av 8 500 kr (månedlig forsikring)?\n        </p>\n        <div class=\"flex flex-wrap gap-4 mb-4\">\n          <div class=\"flex-1 min-w-[110px]\">\n            <label class=\"block text-xs font-semibold text-gray-500 uppercase mb-1\">A (prosent)</label>\n            <input id=\"c0-a\" type=\"number\" step=\"any\" placeholder=\"f.eks. 15\"\n              class=\"w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-400\" />\n          </div>\n          <div class=\"flex items-end pb-2 text-gray-400 text-sm\">% av</div>\n          <div class=\"flex-1 min-w-[110px]\">\n            <label class=\"block text-xs font-semibold text-gray-500 uppercase mb-1\">B (verdi)</label>\n            <input id=\"c0-b\" type=\"number\" step=\"any\" placeholder=\"f.eks. 8500\"\n              class=\"w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-400\" />\n          </div>\n        </div>\n        <div id=\"c0-result\" class=\"hidden\">\n          <div class=\"formula-box text-sm bg-gray-100 rounded-lg px-3 py-2 text-gray-700 mb-2\" id=\"c0-formula\"></div>\n          <div class=\"bg-indigo-600 text-white rounded-xl px-4 py-3 font-bold text-lg\" id=\"c0-answer\"></div>\n        </div>\n      </div>\n\n      <!-- Fane 1: A er hvor mange % av B? -->\n      <div class=\"calc-tab hidden\" id=\"tab-1\">\n        <p class=\"text-sm text-gray-600 mb-4\">\n          <strong>Eksempel:</strong> 340 elever av 1 200 stemte. Hvor mange prosent er det?\n        </p>\n        <div class=\"flex flex-wrap gap-4 mb-4\">\n          <div class=\"flex-1 min-w-[110px]\">\n            <label class=\"block text-xs font-semibold text-gray-500 uppercase mb-1\">A (del)</label>\n            <input id=\"c1-a\" type=\"number\" step=\"any\" placeholder=\"f.eks. 340\"\n              class=\"w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-400\" />\n          </div>\n          <div class=\"flex items-end pb-2 text-gray-400 text-sm\">av</div>\n          <div class=\"flex-1 min-w-[110px]\">\n            <label class=\"block text-xs font-semibold text-gray-500 uppercase mb-1\">B (hele)</label>\n            <input id=\"c1-b\" type=\"number\" step=\"any\" placeholder=\"f.eks. 1200\"\n              class=\"w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-400\" />\n          </div>\n        </div>\n        <div id=\"c1-result\" class=\"hidden\">\n          <div class=\"formula-box text-sm bg-gray-100 rounded-lg px-3 py-2 text-gray-700 mb-2\" id=\"c1-formula\"></div>\n          <div class=\"bg-indigo-600 text-white rounded-xl px-4 py-3 font-bold text-lg\" id=\"c1-answer\"></div>\n        </div>\n      </div>\n\n      <!-- Fane 2: Prosentvis endring fra A til B -->\n      <div class=\"calc-tab hidden\" id=\"tab-2\">\n        <p class=\"text-sm text-gray-600 mb-4\">\n          <strong>Eksempel:</strong> Husleien gikk fra 9 800 kr til 11 200 kr. Hvor stor er økningen i prosent?\n        </p>\n        <div class=\"flex flex-wrap gap-4 mb-4\">\n          <div class=\"flex-1 min-w-[110px]\">\n            <label class=\"block text-xs font-semibold text-gray-500 uppercase mb-1\">Fra (A)</label>\n            <input id=\"c2-a\" type=\"number\" step=\"any\" placeholder=\"f.eks. 9800\"\n              class=\"w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-400\" />\n          </div>\n          <div class=\"flex items-end pb-2 text-gray-400\">→</div>\n          <div class=\"flex-1 min-w-[110px]\">\n            <label class=\"block text-xs font-semibold text-gray-500 uppercase mb-1\">Til (B)</label>\n            <input id=\"c2-b\" type=\"number\" step=\"any\" placeholder=\"f.eks. 11200\"\n              class=\"w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-400\" />\n          </div>\n        </div>\n        <div id=\"c2-result\" class=\"hidden\">\n          <div class=\"formula-box text-sm bg-gray-100 rounded-lg px-3 py-2 text-gray-700 mb-2\" id=\"c2-formula\"></div>\n          <div class=\"bg-indigo-600 text-white rounded-xl px-4 py-3 font-bold text-lg\" id=\"c2-answer\"></div>\n        </div>\n      </div>\n    </section>\n\n    <!-- ─── SEKSJON 4: RASK OPPGAVE ─── -->\n    <section class=\"section-card bg-white rounded-2xl shadow p-6 sm:p-8\" id=\"quiz\">\n      <h2 class=\"text-xl font-bold text-indigo-700 mb-1\">Kjapt spørsmål</h2>\n      <p class=\"text-sm text-gray-500 mb-4\">Test forståelsen din!</p>\n\n      <div id=\"quiz-container\" class=\"space-y-4\">\n        <div class=\"bg-indigo-50 border border-indigo-200 rounded-xl p-4\">\n          <p class=\"font-semibold text-indigo-900 mb-3\" id=\"quiz-question\"></p>\n          <div class=\"space-y-2\" id=\"quiz-options\"></div>\n        </div>\n        <div id=\"quiz-feedback\" class=\"hidden rounded-xl p-4 text-sm font-medium\"></div>\n        <button id=\"quiz-next\"\n          class=\"hidden bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-lg px-4 py-2 text-sm transition-colors\">\n          Neste spørsmål →\n        </button>\n      </div>\n    </section>\n\n  </main>\n\n  <footer class=\"mt-12 border-t border-gray-200 bg-white\">\n    <div class=\"max-w-3xl mx-auto px-4 py-5 text-xs text-gray-400 flex flex-wrap justify-between gap-2\">\n      <span>Matematikk 2P · LK20 · Halison App Studio</span>\n      <a href=\"https://github.com/halisonworks/public-app-studio\" class=\"hover:text-indigo-500 underline\" target=\"_blank\" rel=\"noopener\">\n        github.com/halisonworks/public-app-studio\n      </a>\n    </div>\n  </footer>\n\n  <script>\n    // ── Hjelpefunksjoner ──────────────────────────────────────────────────────\n    function fmt(n, desimaler) {\n      if (desimaler === undefined) desimaler = 2;\n      return n.toLocaleString('nb-NO', { minimumFractionDigits: 0, maximumFractionDigits: desimaler });\n    }\n\n    function fmtProsentpoeng(n) {\n      var abs = Math.abs(n);\n      var s = fmt(abs, 2);\n      return (n >= 0 ? '+' : '−') + s + ' prosentpoeng';\n    }\n\n    function fmtPV(n) {\n      var abs = Math.abs(n);\n      var s = fmt(abs, 1);\n      return (n >= 0 ? '+' : '−') + s + ' %';\n    }\n\n    // ── LocalStorage ──────────────────────────────────────────────────────────\n    function savePP() {\n      var fra = document.getElementById('inp-fra').value;\n      var til = document.getElementById('inp-til').value;\n      var ctx = document.getElementById('ctx-select').value;\n      try { localStorage.setItem('pp_fra', fra); localStorage.setItem('pp_til', til); localStorage.setItem('pp_ctx', ctx); } catch(e) {}\n    }\n\n    function loadPP() {\n      try {\n        var fra = localStorage.getItem('pp_fra');\n        var til = localStorage.getItem('pp_til');\n        var ctx = localStorage.getItem('pp_ctx');\n        if (fra) document.getElementById('inp-fra').value = fra;\n        if (til) document.getElementById('inp-til').value = til;\n        if (ctx) document.getElementById('ctx-select').value = ctx;\n      } catch(e) {}\n    }\n\n    function saveCalc(id, a, b) {\n      try { localStorage.setItem('calc_' + id + '_a', a); localStorage.setItem('calc_' + id + '_b', b); } catch(e) {}\n    }\n\n    function loadCalc() {\n      try {\n        [0,1,2].forEach(function(i) {\n          var a = localStorage.getItem('calc_' + i + '_a');\n          var b = localStorage.getItem('calc_' + i + '_b');\n          if (a) document.getElementById('c' + i + '-a').value = a;\n          if (b) document.getElementById('c' + i + '-b').value = b;\n        });\n      } catch(e) {}\n    }\n\n    // ── Kontekst-tekster ──────────────────────────────────────────────────────\n    var kontekster = {\n      rente: {\n        enhet: '%',\n        ppTekst: function(fra, til, pp) {\n          var retning = pp >= 0 ? 'økte' : 'falt';\n          return 'Boliglånsrenten ' + retning + ' med ' + fmt(Math.abs(pp), 2) + ' prosentpoeng (fra ' + fmt(fra,1) + ' % til ' + fmt(til,1) + ' %).';\n        },\n        pvTekst: function(fra, til, pv) {\n          var retning = pv >= 0 ? 'dyrere' : 'billigere';\n          return 'Lånet er ' + fmt(Math.abs(pv), 1) + ' % ' + retning + ' enn før — målt relativt til utgangspunktet.';\n        }\n      },\n      arbeidsledighet: {\n        enhet: '%',\n        ppTekst: function(fra, til, pp) {\n          var retning = pp >= 0 ? 'økte' : 'falt';\n          return 'Arbeidsledigheten ' + retning + ' med ' + fmt(Math.abs(pp), 2) + ' prosentpoeng.';\n        },\n        pvTekst: function(fra, til, pv) {\n          var retning = pv >= 0 ? 'flere' : 'færre';\n          return 'Det er ' + fmt(Math.abs(pv), 1) + ' % ' + retning + ' arbeidsledige enn ved utgangspunktet.';\n        }\n      },\n      stemmer: {\n        enhet: '%',\n        ppTekst: function(fra, til, pp) {\n          var retning = pp >= 0 ? 'økte' : 'falt';\n          return 'Velgerstøtten ' + retning + ' med ' + fmt(Math.abs(pp), 2) + ' prosentpoeng.';\n        },\n        pvTekst: function(fra, til, pv) {\n          var retning = pv >= 0 ? 'bedre' : 'dårligere';\n          return 'Partiet gjør det ' + fmt(Math.abs(pv), 1) + ' % ' + retning + ' enn sist — relativt sett.';\n        }\n      },\n      egenandel: {\n        enhet: '%',\n        ppTekst: function(fra, til, pp) {\n          var retning = pp >= 0 ? 'økte' : 'falt';\n          return 'Egenandelen ' + retning + ' med ' + fmt(Math.abs(pp), 2) + ' prosentpoeng.';\n        },\n        pvTekst: function(fra, til, pv) {\n          var retning = pv >= 0 ? 'høyere' : 'lavere';\n          return 'Det er ' + fmt(Math.abs(pv), 1) + ' % ' + retning + ' egenandel enn før.';\n        }\n      },\n      fri: {\n        enhet: '%',\n        ppTekst: function(fra, til, pp) {\n          var retning = pp >= 0 ? 'økte' : 'falt';\n          return 'Andelen ' + retning + ' med ' + fmt(Math.abs(pp), 2) + ' prosentpoeng.';\n        },\n        pvTekst: function(fra, til, pv) {\n          var retning = pv >= 0 ? 'mer' : 'mindre';\n          return 'Det er ' + fmt(Math.abs(pv), 1) + ' % ' + retning + ' enn utgangspunktet.';\n        }\n      }\n    };\n\n    // ── Seksjon 2: Prosentpoeng-kalkulator ───────────────────────────────────\n    function oppdaterPP() {\n      var fraVal = parseFloat(document.getElementById('inp-fra').value);\n      var tilVal = parseFloat(document.getElementById('inp-til').value);\n      var ctx = document.getElementById('ctx-select').value;\n      var resultBox = document.getElementById('result-box');\n      var emptyMsg = document.getElementById('empty-msg');\n\n      if (isNaN(fraVal) || isNaN(tilVal) || fraVal <= 0) {\n        resultBox.classList.add('hidden');\n        emptyMsg.classList.remove('hidden');\n        return;\n      }\n\n      resultBox.classList.remove('hidden');\n      emptyMsg.classList.add('hidden');\n\n      var pp = tilVal - fraVal;\n      var pv = (tilVal - fraVal) / fraVal * 100;\n      var k = kontekster[ctx] || kontekster['fri'];\n\n      // Stolper: skaler til maks 100 % av 30 % som \"full bredde\", cap ved 100%\n      var scale = Math.max(fraVal, tilVal);\n      var maxBar = Math.max(scale * 1.4, 5);\n      var fraW = Math.min((fraVal / maxBar) * 100, 100);\n      var tilW = Math.min((tilVal / maxBar) * 100, 100);\n\n      document.getElementById('bar-fra').style.width = fraW + '%';\n      document.getElementById('bar-til').style.width = tilW + '%';\n      document.getElementById('bar-fra-label').textContent = fmt(fraVal, 2) + ' %';\n      document.getElementById('bar-til-label').textContent = fmt(tilVal, 2) + ' %';\n\n      // Prosentpoeng\n      document.getElementById('pp-formula').textContent =\n        'Endring = til − fra = ' + fmt(tilVal, 2) + ' % − ' + fmt(fraVal, 2) + ' % = ' + fmt(Math.abs(pp), 2) + ' prosentpoeng';\n      document.getElementById('pp-result').textContent = fmtProsentpoeng(pp);\n      document.getElementById('pp-context').textContent = k.ppTekst(fraVal, tilVal, pp);\n\n      // Prosentvis endring\n      document.getElementById('pv-formula').textContent =\n        'Endring = (til − fra) / fra · 100 % = (' + fmt(tilVal,2) + ' − ' + fmt(fraVal,2) + ') / ' + fmt(fraVal,2) + ' · 100 % = ' + fmt(Math.abs(pv),1) + ' %';\n      document.getElementById('pv-result').textContent = fmtPV(pv);\n      document.getElementById('pv-context').textContent = k.pvTekst(fraVal, tilVal, pv);\n\n      // Tolkning\n      var endringPP = Math.abs(pp);\n      var endringPV = Math.abs(pv);\n      var retning = pp >= 0 ? 'økning' : 'nedgang';\n      document.getElementById('tolkning-box').innerHTML =\n        '<strong>Tolkning:</strong> En endring på <strong>' + fmt(endringPP,2) + ' prosentpoeng</strong> høres kanskje liten ut. ' +\n        'Men relativt til utgangspunktet på ' + fmt(fraVal,2) + ' % er dette faktisk en ' + retning + ' på <strong>' + fmt(endringPV,1) + ' %</strong>. ' +\n        'Det er viktig å oppgi <em>hvilken</em> type endring man beskriver!';\n\n      savePP();\n    }\n\n    document.getElementById('inp-fra').addEventListener('input', oppdaterPP);\n    document.getElementById('inp-til').addEventListener('input', oppdaterPP);\n    document.getElementById('ctx-select').addEventListener('change', oppdaterPP);\n\n    // ── Seksjon 3: Kalkulator-faner ──────────────────────────────────────────\n    var tabBtns = document.querySelectorAll('.tab-btn');\n    var tabPanels = document.querySelectorAll('.calc-tab');\n\n    tabBtns.forEach(function(btn) {\n      btn.addEventListener('click', function() {\n        var idx = parseInt(btn.getAttribute('data-tab'));\n        tabBtns.forEach(function(b) { b.classList.remove('active'); });\n        tabPanels.forEach(function(p) { p.classList.add('hidden'); });\n        btn.classList.add('active');\n        document.getElementById('tab-' + idx).classList.remove('hidden');\n      });\n    });\n\n    // Fane 0: A % av B\n    function oppdaterC0() {\n      var a = parseFloat(document.getElementById('c0-a').value);\n      var b = parseFloat(document.getElementById('c0-b').value);\n      var res = document.getElementById('c0-result');\n      if (isNaN(a) || isNaN(b)) { res.classList.add('hidden'); return; }\n      var svar = a / 100 * b;\n      document.getElementById('c0-formula').textContent = a + ' % av ' + fmt(b, 2) + ' = ' + a + '/100 × ' + fmt(b,2);\n      document.getElementById('c0-answer').textContent = '= ' + fmt(svar, 2);\n      res.classList.remove('hidden');\n      saveCalc(0, a, b);\n    }\n    document.getElementById('c0-a').addEventListener('input', oppdaterC0);\n    document.getElementById('c0-b').addEventListener('input', oppdaterC0);\n\n    // Fane 1: A er hvor mange % av B?\n    function oppdaterC1() {\n      var a = parseFloat(document.getElementById('c1-a').value);\n      var b = parseFloat(document.getElementById('c1-b').value);\n      var res = document.getElementById('c1-result');\n      if (isNaN(a) || isNaN(b) || b === 0) { res.classList.add('hidden'); return; }\n      var svar = a / b * 100;\n      document.getElementById('c1-formula').textContent = fmt(a,2) + ' / ' + fmt(b,2) + ' × 100 % = ' + fmt(svar,2) + ' %';\n      document.getElementById('c1-answer').textContent = fmt(a,2) + ' er ' + fmt(svar,2) + ' % av ' + fmt(b,2);\n      res.classList.remove('hidden');\n      saveCalc(1, a, b);\n    }\n    document.getElementById('c1-a').addEventListener('input', oppdaterC1);\n    document.getElementById('c1-b').addEventListener('input', oppdaterC1);\n\n    // Fane 2: Prosentvis endring fra A til B\n    function oppdaterC2() {\n      var a = parseFloat(document.getElementById('c2-a').value);\n      var b = parseFloat(document.getElementById('c2-b').value);\n      var res = document.getElementById('c2-result');\n      if (isNaN(a) || isNaN(b) || a === 0) { res.classList.add('hidden'); return; }\n      var svar = (b - a) / a * 100;\n      var retning = svar >= 0 ? 'økning' : 'nedgang';\n      document.getElementById('c2-formula').textContent =\n        '(' + fmt(b,2) + ' − ' + fmt(a,2) + ') / ' + fmt(a,2) + ' × 100 % = ' + fmt(Math.abs(svar),2) + ' %';\n      document.getElementById('c2-answer').textContent =\n        fmt(Math.abs(svar),2) + ' % ' + retning + (svar >= 0 ? ' ▲' : ' ▼');\n      res.classList.remove('hidden');\n      saveCalc(2, a, b);\n    }\n    document.getElementById('c2-a').addEventListener('input', oppdaterC2);\n    document.getElementById('c2-b').addEventListener('input', oppdaterC2);\n\n    // ── Seksjon 4: Quiz ──────────────────────────────────────────────────────\n    var sporsmal = [\n      {\n        tekst: 'Renten gikk fra 4 % til 5 %. Hvor mange prosentpoeng økte renten?',\n        alternativer: ['1 prosentpoeng', '25 prosentpoeng', '4 prosentpoeng', '5 prosentpoeng'],\n        riktig: 0,\n        forklaring: '5 % − 4 % = 1 prosentpoeng. Prosentpoeng er rett og slett differansen mellom de to prosenttallene.'\n      },\n      {\n        tekst: 'Arbeidsledigheten gikk fra 4 % til 5 %. Hva er den prosentvise endringen?',\n        alternativer: ['1 %', '25 %', '20 %', '4 %'],\n        riktig: 1,\n        forklaring: '(5 − 4) / 4 × 100 % = 25 %. Ledigheten er 25 % høyere enn den var — selv om endringen er 1 prosentpoeng.'\n      },\n      {\n        tekst: 'En avis skriver at «skatten økte med 2 prosentpoeng, fra 22 % til 24 %». Hva er den prosentvise økningen i skatten?',\n        alternativer: ['2 %', '22 %', 'ca. 9,1 %', '24 %'],\n        riktig: 2,\n        forklaring: '(24 − 22) / 22 × 100 % ≈ 9,1 %. 2 prosentpoeng opp fra 22 % er relativt sett ca. 9,1 % økning.'\n      },\n      {\n        tekst: 'Hva beskriver «prosentpoeng»?',\n        alternativer: [\n          'Den relative endringen mellom to prosenttall',\n          'Den aritmetiske differansen mellom to prosenttall',\n          'Prosentandelen av et tall',\n          'Antall hundredeler i en brøk'\n        ],\n        riktig: 1,\n        forklaring: 'Prosentpoeng er alltid den enkle differansen: til − fra. Det er ikke en relativ størrelse.'\n      },\n      {\n        tekst: 'Velgerstøtten til et parti falt fra 20 % til 15 %. Hva er nedgangen i prosentpoeng?',\n        alternativer: ['5 prosentpoeng', '25 prosentpoeng', '15 prosentpoeng', '4 prosentpoeng'],\n        riktig: 0,\n        forklaring: '20 % − 15 % = 5 prosentpoeng. (Den prosentvise nedgangen er derimot 25 %.)'\n      }\n    ];\n\n    var quizIndex = 0;\n    var quizBesvart = false;\n\n    function visSporsmal(idx) {\n      quizBesvart = false;\n      var sp = sporsmal[idx % sporsmal.length];\n      document.getElementById('quiz-question').textContent = sp.tekst;\n      var optDiv = document.getElementById('quiz-options');\n      optDiv.innerHTML = '';\n      sp.alternativer.forEach(function(alt, i) {\n        var btn = document.createElement('button');\n        btn.textContent = alt;\n        btn.className = 'w-full text-left px-4 py-2 rounded-lg border border-gray-200 bg-white hover:bg-indigo-50 hover:border-indigo-300 text-sm transition-colors';\n        btn.setAttribute('data-idx', i);\n        btn.addEventListener('click', function() {\n          if (quizBesvart) return;\n          quizBesvart = true;\n          var valgt = parseInt(btn.getAttribute('data-idx'));\n          var feedback = document.getElementById('quiz-feedback');\n          feedback.classList.remove('hidden');\n          if (valgt === sp.riktig) {\n            feedback.className = 'rounded-xl p-4 text-sm font-medium bg-green-50 border border-green-300 text-green-800';\n            feedback.innerHTML = '✓ Riktig! ' + sp.forklaring;\n          } else {\n            feedback.className = 'rounded-xl p-4 text-sm font-medium bg-red-50 border border-red-300 text-red-800';\n            feedback.innerHTML = '✗ Ikke helt. Riktig svar: <strong>' + sp.alternativer[sp.riktig] + '</strong>. ' + sp.forklaring;\n          }\n          // Marker knapper\n          optDiv.querySelectorAll('button').forEach(function(b, bi) {\n            b.disabled = true;\n            if (bi === sp.riktig) {\n              b.className = 'w-full text-left px-4 py-2 rounded-lg border font-semibold text-sm bg-green-100 border-green-400 text-green-800';\n            } else if (bi === valgt) {\n              b.className = 'w-full text-left px-4 py-2 rounded-lg border font-semibold text-sm bg-red-100 border-red-400 text-red-800';\n            } else {\n              b.className = 'w-full text-left px-4 py-2 rounded-lg border text-sm bg-gray-50 border-gray-200 text-gray-400';\n            }\n          });\n          document.getElementById('quiz-next').classList.remove('hidden');\n        });\n        optDiv.appendChild(btn);\n      });\n      document.getElementById('quiz-feedback').classList.add('hidden');\n      document.getElementById('quiz-next').classList.add('hidden');\n    }\n\n    document.getElementById('quiz-next').addEventListener('click', function() {\n      quizIndex++;\n      visSporsmal(quizIndex);\n    });\n\n    // ── Init ──────────────────────────────────────────────────────────────────\n    loadPP();\n    loadCalc();\n    oppdaterPP();\n    oppdaterC0();\n    oppdaterC1();\n    oppdaterC2();\n    visSporsmal(0);\n  </script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Prosent og prosentpoeng",
    "windowTitle": "Prosent og prosentpoeng",
    "bundleId": "com.halisonworks.prosentprosentpoeng",
    "iconPath": null
  },
  "categoryId": null,
  "source": "import",
  "createdAt": "2026-06-02T12:00:00.000Z",
  "updatedAt": "2026-06-02T12:00:00.000Z",
  "sharedAt": "2026-06-02T12:00:00.000Z"
}
