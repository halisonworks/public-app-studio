{
  "schema": "app-studio/canvas@1",
  "id": "example-geo-pytagoras",
  "name": "pytagoras.html",
  "code": "<!DOCTYPE html>\n<!--\n  Pytagoras' setning — Halison App Studio-eksempel\n\n  Interaktivt læremiddel for geometri (matematikk 1P/2P, LK20): finn sider i en\n  rettvinklet trekant, se det visuelle beviset, avstand mellom punkter og\n  romdiagonal.\n\n  Fra Halison App Studio sitt offentlige bibliotek:\n  https://github.com/halisonworks/public-app-studio\n\n  Tillatt bruk: personlig, pedagogisk og annen ikke-kommersiell bruk. Behold denne\n  headeren og kildelenken; ikke-kommersiell bruk. Utgitt under Halison App Studio\n  Examples License — se LICENSE-filen i repoet over.\n-->\n<html lang=\"no\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Pytagoras' setning — Interaktivt læremiddel</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Segoe UI', system-ui, sans-serif; }\n    .tab-btn { transition: all 0.2s; }\n    .tab-btn.active { background-color: #2563eb; color: white; }\n    .tab-btn:not(.active):hover { background-color: #dbeafe; }\n    input[type=\"number\"]::-webkit-inner-spin-button { opacity: 0.6; }\n    .svgfig { display: block; margin: 0 auto; }\n    .fade-in { animation: fadeIn 0.3s ease; }\n    @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }\n    .result-box { background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%); border: 1.5px solid #93c5fd; }\n    .proof-square { opacity: 0.75; }\n    .katex-inline { font-style: italic; }\n  </style>\n</head>\n<body class=\"bg-gray-50 min-h-screen\">\n\n<!-- Header -->\n<header class=\"bg-blue-700 text-white shadow-md\">\n  <div class=\"max-w-4xl mx-auto px-4 py-5\">\n    <h1 class=\"text-2xl font-bold tracking-tight\">Pytagoras' setning</h1>\n    <p class=\"text-blue-200 text-sm mt-1\">Interaktivt læremiddel · Matematikk 1P/2P · LK20</p>\n  </div>\n</header>\n\n<!-- Intro banner -->\n<div class=\"max-w-4xl mx-auto px-4 mt-5\">\n  <div class=\"bg-white border border-blue-200 rounded-xl p-4 shadow-sm flex gap-3 items-start\">\n    <span class=\"text-2xl mt-0.5\">📐</span>\n    <div>\n      <p class=\"font-semibold text-blue-900\">a² + b² = c²</p>\n      <p class=\"text-gray-600 text-sm mt-1\">\n        I en <strong>rettvinklet trekant</strong> er summen av kvadratene på de to katetene (a og b) lik kvadratet på hypotenusen (c).\n        Velg et tema nedenfor for å utforske setningen.\n      </p>\n    </div>\n  </div>\n</div>\n\n<!-- Tabs -->\n<div class=\"max-w-4xl mx-auto px-4 mt-5\">\n  <div class=\"flex flex-wrap gap-2\" role=\"tablist\">\n    <button class=\"tab-btn active px-4 py-2 rounded-lg font-medium text-sm border border-blue-300 bg-blue-600 text-white\" onclick=\"showTab('beregn')\" id=\"tab-beregn\">🔢 Beregn side</button>\n    <button class=\"tab-btn px-4 py-2 rounded-lg font-medium text-sm border border-gray-300 bg-white text-gray-700\" onclick=\"showTab('bevis')\" id=\"tab-bevis\">🟥 Visuelt bevis</button>\n    <button class=\"tab-btn px-4 py-2 rounded-lg font-medium text-sm border border-gray-300 bg-white text-gray-700\" onclick=\"showTab('avstand')\" id=\"tab-avstand\">📍 Avstand mellom punkter</button>\n    <button class=\"tab-btn px-4 py-2 rounded-lg font-medium text-sm border border-gray-300 bg-white text-gray-700\" onclick=\"showTab('3d')\" id=\"tab-3d\">📦 Romdiagonal (3D)</button>\n  </div>\n</div>\n\n<!-- Main content area -->\n<main class=\"max-w-4xl mx-auto px-4 mt-4 pb-16\">\n\n  <!-- ======================== TAB 1: BEREGN SIDE ======================== -->\n  <section id=\"panel-beregn\" class=\"bg-white rounded-xl shadow-sm border border-gray-200 p-6 fade-in\">\n    <h2 class=\"text-xl font-bold text-gray-800 mb-1\">Finn den ukjente siden</h2>\n    <p class=\"text-gray-500 text-sm mb-5\">\n      Skriv inn to kjente sider — la den ukjente stå tom. Kalkulator bruker <em>a² + b² = c²</em>.\n      <br><span class=\"text-orange-600 font-medium\">Merk: Pytagoras gjelder kun for rettvinklede trekanter.</span>\n    </p>\n\n    <div class=\"grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6\">\n      <div>\n        <label class=\"block text-sm font-semibold text-gray-700 mb-1\">Katet <em>a</em></label>\n        <input id=\"inp-a\" type=\"number\" min=\"0\" step=\"any\" placeholder=\"f.eks. 3\"\n          class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-800 focus:outline-none focus:ring-2 focus:ring-blue-400\"\n          oninput=\"beregnSide()\" />\n      </div>\n      <div>\n        <label class=\"block text-sm font-semibold text-gray-700 mb-1\">Katet <em>b</em></label>\n        <input id=\"inp-b\" type=\"number\" min=\"0\" step=\"any\" placeholder=\"f.eks. 4\"\n          class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-800 focus:outline-none focus:ring-2 focus:ring-blue-400\"\n          oninput=\"beregnSide()\" />\n      </div>\n      <div>\n        <label class=\"block text-sm font-semibold text-gray-700 mb-1\">Hypotenusen <em>c</em></label>\n        <input id=\"inp-c\" type=\"number\" min=\"0\" step=\"any\" placeholder=\"f.eks. ?\"\n          class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-800 focus:outline-none focus:ring-2 focus:ring-blue-400\"\n          oninput=\"beregnSide()\" />\n      </div>\n    </div>\n\n    <div id=\"beregn-error\" class=\"hidden text-red-600 text-sm mb-3 bg-red-50 border border-red-200 rounded-lg px-3 py-2\"></div>\n\n    <div id=\"beregn-result\" class=\"hidden result-box rounded-xl p-5 mb-6 fade-in\">\n      <div id=\"beregn-svar\" class=\"text-xl font-bold text-blue-800 mb-2\"></div>\n      <div id=\"beregn-utregning\" class=\"text-gray-700 text-sm leading-relaxed font-mono bg-white rounded-lg p-3 border border-blue-100\"></div>\n    </div>\n\n    <div id=\"beregn-svg-container\" class=\"hidden fade-in\">\n      <h3 class=\"text-sm font-semibold text-gray-600 mb-2 uppercase tracking-wide\">Trekant tegnet til skala</h3>\n      <svg id=\"beregn-svg\" class=\"svgfig\" viewBox=\"0 0 320 260\" width=\"320\" height=\"260\"></svg>\n    </div>\n\n    <button onclick=\"nullstillBeregn()\" class=\"mt-4 text-sm text-gray-500 underline hover:text-red-500\">Nullstill</button>\n  </section>\n\n  <!-- ======================== TAB 2: VISUELT BEVIS ======================== -->\n  <section id=\"panel-bevis\" class=\"hidden bg-white rounded-xl shadow-sm border border-gray-200 p-6 fade-in\">\n    <h2 class=\"text-xl font-bold text-gray-800 mb-1\">Visuelt bevis: arealer av kvadratene</h2>\n    <p class=\"text-gray-500 text-sm mb-5\">\n      Tegn tre kvadrater på sidene i en rettvinklet trekant.\n      Arealet av de to små kvadratene (a² og b²) er alltid lik arealet av det store (c²).\n    </p>\n\n    <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6\">\n      <div>\n        <label class=\"block text-sm font-semibold text-gray-700 mb-1\">Katet <em>a</em></label>\n        <input id=\"bevis-a\" type=\"number\" min=\"1\" max=\"20\" step=\"any\" value=\"3\"\n          class=\"w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400\"\n          oninput=\"tegnBevis()\" />\n      </div>\n      <div>\n        <label class=\"block text-sm font-semibold text-gray-700 mb-1\">Katet <em>b</em></label>\n        <input id=\"bevis-b\" type=\"number\" min=\"1\" max=\"20\" step=\"any\" value=\"4\"\n          class=\"w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400\"\n          oninput=\"tegnBevis()\" />\n      </div>\n    </div>\n\n    <div id=\"bevis-info\" class=\"result-box rounded-xl p-4 mb-5 text-sm text-gray-700\">\n    </div>\n\n    <svg id=\"bevis-svg\" class=\"svgfig\" viewBox=\"0 0 480 400\" width=\"100%\" style=\"max-width:480px;height:auto;\"></svg>\n  </section>\n\n  <!-- ======================== TAB 3: AVSTAND ======================== -->\n  <section id=\"panel-avstand\" class=\"hidden bg-white rounded-xl shadow-sm border border-gray-200 p-6 fade-in\">\n    <h2 class=\"text-xl font-bold text-gray-800 mb-1\">Avstand mellom to punkter</h2>\n    <p class=\"text-gray-500 text-sm mb-5\">\n      Distansen mellom P₁(x₁, y₁) og P₂(x₂, y₂) er hypotenusen i en rettvinklet trekant med kateter\n      Δx = |x₂ − x₁| og Δy = |y₂ − y₁|. Formel: <strong>d = √(Δx² + Δy²)</strong>\n    </p>\n\n    <div class=\"grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6\">\n      <div>\n        <label class=\"block text-sm font-semibold text-gray-700 mb-1\">x₁</label>\n        <input id=\"av-x1\" type=\"number\" step=\"any\" value=\"1\"\n          class=\"w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400\"\n          oninput=\"beregnAvstand()\" />\n      </div>\n      <div>\n        <label class=\"block text-sm font-semibold text-gray-700 mb-1\">y₁</label>\n        <input id=\"av-y1\" type=\"number\" step=\"any\" value=\"1\"\n          class=\"w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400\"\n          oninput=\"beregnAvstand()\" />\n      </div>\n      <div>\n        <label class=\"block text-sm font-semibold text-gray-700 mb-1\">x₂</label>\n        <input id=\"av-x2\" type=\"number\" step=\"any\" value=\"5\"\n          class=\"w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400\"\n          oninput=\"beregnAvstand()\" />\n      </div>\n      <div>\n        <label class=\"block text-sm font-semibold text-gray-700 mb-1\">y₂</label>\n        <input id=\"av-y2\" type=\"number\" step=\"any\" value=\"4\"\n          class=\"w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400\"\n          oninput=\"beregnAvstand()\" />\n      </div>\n    </div>\n\n    <div id=\"avstand-result\" class=\"result-box rounded-xl p-5 mb-6 fade-in\">\n      <div id=\"avstand-svar\" class=\"text-xl font-bold text-blue-800 mb-2\"></div>\n      <div id=\"avstand-utregning\" class=\"text-gray-700 text-sm leading-relaxed font-mono bg-white rounded-lg p-3 border border-blue-100\"></div>\n    </div>\n\n    <h3 class=\"text-sm font-semibold text-gray-600 mb-2 uppercase tracking-wide\">Figur</h3>\n    <svg id=\"avstand-svg\" class=\"svgfig\" viewBox=\"0 0 340 300\" width=\"340\" height=\"300\"></svg>\n  </section>\n\n  <!-- ======================== TAB 4: 3D ROMDIAGONAL ======================== -->\n  <section id=\"panel-3d\" class=\"hidden bg-white rounded-xl shadow-sm border border-gray-200 p-6 fade-in\">\n    <h2 class=\"text-xl font-bold text-gray-800 mb-1\">Romdiagonal i en kasse (3D)</h2>\n    <p class=\"text-gray-500 text-sm mb-5\">\n      Gitt en rektangulær kasse med lengde <em>l</em>, bredde <em>b</em> og høyde <em>h</em>,\n      er romdiagonalen <strong>d = √(l² + b² + h²)</strong>.\n      <br>Beviset bruker Pytagoras to ganger: først grunnflaten, deretter høyden.\n    </p>\n\n    <div class=\"grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6\">\n      <div>\n        <label class=\"block text-sm font-semibold text-gray-700 mb-1\">Lengde <em>l</em></label>\n        <input id=\"d3-l\" type=\"number\" min=\"0.1\" step=\"any\" value=\"4\"\n          class=\"w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400\"\n          oninput=\"beregn3D()\" />\n      </div>\n      <div>\n        <label class=\"block text-sm font-semibold text-gray-700 mb-1\">Bredde <em>b</em></label>\n        <input id=\"d3-b\" type=\"number\" min=\"0.1\" step=\"any\" value=\"3\"\n          class=\"w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400\"\n          oninput=\"beregn3D()\" />\n      </div>\n      <div>\n        <label class=\"block text-sm font-semibold text-gray-700 mb-1\">Høyde <em>h</em></label>\n        <input id=\"d3-h\" type=\"number\" min=\"0.1\" step=\"any\" value=\"2\"\n          class=\"w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400\"\n          oninput=\"beregn3D()\" />\n      </div>\n    </div>\n\n    <div id=\"d3-result\" class=\"result-box rounded-xl p-5 mb-6 fade-in\">\n      <div id=\"d3-svar\" class=\"text-xl font-bold text-blue-800 mb-2\"></div>\n      <div id=\"d3-utregning\" class=\"text-gray-700 text-sm leading-relaxed font-mono bg-white rounded-lg p-3 border border-blue-100\"></div>\n    </div>\n\n    <h3 class=\"text-sm font-semibold text-gray-600 mb-2 uppercase tracking-wide\">Illustrasjon</h3>\n    <svg id=\"d3-svg\" class=\"svgfig\" viewBox=\"0 0 340 280\" width=\"340\" height=\"280\"></svg>\n  </section>\n\n</main>\n\n<!-- Footer -->\n<footer class=\"border-t border-gray-200 bg-white text-center text-xs text-gray-400 py-4 px-4\">\n  Pytagoras' setning · Halison App Studio-eksempel · Matematikk 1P/2P · LK20 ·\n  <a href=\"https://github.com/halisonworks/public-app-studio\" class=\"underline hover:text-blue-500\" target=\"_blank\">GitHub</a>\n</footer>\n\n<script>\n// ─────────────────────────────────────────────\n// Utility\n// ─────────────────────────────────────────────\nfunction fmt(n, decimaler) {\n  if (decimaler === undefined) decimaler = 4;\n  var s = parseFloat(n.toFixed(decimaler));\n  return s.toString();\n}\n\nfunction rund(n) {\n  // Display: up to 4 significant decimals, strip trailing zeros\n  return parseFloat(n.toPrecision(6)).toString();\n}\n\n// ─────────────────────────────────────────────\n// Tab navigation\n// ─────────────────────────────────────────────\nvar TABS = ['beregn', 'bevis', 'avstand', '3d'];\n\nfunction showTab(id) {\n  TABS.forEach(function(t) {\n    var panel = document.getElementById('panel-' + t);\n    var btn   = document.getElementById('tab-' + t);\n    if (t === id) {\n      panel.classList.remove('hidden');\n      btn.classList.add('active');\n      btn.classList.remove('bg-white', 'text-gray-700', 'border-gray-300');\n      btn.classList.add('bg-blue-600', 'text-white', 'border-blue-300');\n    } else {\n      panel.classList.add('hidden');\n      btn.classList.remove('active');\n      btn.classList.remove('bg-blue-600', 'text-white', 'border-blue-300');\n      btn.classList.add('bg-white', 'text-gray-700', 'border-gray-300');\n    }\n  });\n  // Trigger renders on tab switch\n  if (id === 'bevis')    tegnBevis();\n  if (id === 'avstand')  beregnAvstand();\n  if (id === '3d')       beregn3D();\n}\n\n// ─────────────────────────────────────────────\n// TAB 1 – BEREGN SIDE\n// ─────────────────────────────────────────────\nfunction beregnSide() {\n  var va = document.getElementById('inp-a').value.trim();\n  var vb = document.getElementById('inp-b').value.trim();\n  var vc = document.getElementById('inp-c').value.trim();\n\n  var errDiv    = document.getElementById('beregn-error');\n  var resultDiv = document.getElementById('beregn-result');\n  var svgCont   = document.getElementById('beregn-svg-container');\n\n  errDiv.classList.add('hidden');\n  resultDiv.classList.add('hidden');\n  svgCont.classList.add('hidden');\n\n  var filled = [va, vb, vc].filter(function(v) { return v !== ''; });\n  if (filled.length < 2) return; // wait for more input\n\n  var a = va !== '' ? parseFloat(va) : NaN;\n  var b = vb !== '' ? parseFloat(vb) : NaN;\n  var c = vc !== '' ? parseFloat(vc) : NaN;\n\n  // Validate positives\n  var vals = [va !== '' ? a : 1, vb !== '' ? b : 1, vc !== '' ? c : 1];\n  for (var i = 0; i < vals.length; i++) {\n    if (vals[i] <= 0 || isNaN(vals[i])) {\n      showError('Alle sider må være positive tall.');\n      return;\n    }\n  }\n\n  var svar, utregning, aFin, bFin, cFin;\n\n  if (va === '' && vb !== '' && vc !== '') {\n    // a = √(c² - b²)\n    if (c <= b) {\n      showError('Hypotenusen c må være større enn kateten b (c > b).');\n      return;\n    }\n    aFin = Math.sqrt(c * c - b * b);\n    bFin = b; cFin = c;\n    svar = 'a = √(c² − b²) = √(' + rund(c*c) + ' − ' + rund(b*b) + ') = √' + rund(c*c - b*b) + ' ≈ ' + rund(aFin);\n    utregning = 'a² + b² = c²\\na² = c² − b²\\na² = ' + rund(c) + '² − ' + rund(b) + '²\\na² = ' + rund(c*c) + ' − ' + rund(b*b) + '\\na² = ' + rund(c*c - b*b) + '\\na  = √' + rund(c*c - b*b) + '\\na  ≈ ' + rund(aFin);\n  } else if (vb === '' && va !== '' && vc !== '') {\n    // b = √(c² - a²)\n    if (c <= a) {\n      showError('Hypotenusen c må være større enn kateten a (c > a).');\n      return;\n    }\n    bFin = Math.sqrt(c * c - a * a);\n    aFin = a; cFin = c;\n    svar = 'b = √(c² − a²) = √(' + rund(c*c) + ' − ' + rund(a*a) + ') = √' + rund(c*c - a*a) + ' ≈ ' + rund(bFin);\n    utregning = 'a² + b² = c²\\nb² = c² − a²\\nb² = ' + rund(c) + '² − ' + rund(a) + '²\\nb² = ' + rund(c*c) + ' − ' + rund(a*a) + '\\nb² = ' + rund(c*c - a*a) + '\\nb  = √' + rund(c*c - a*a) + '\\nb  ≈ ' + rund(bFin);\n  } else if (vc === '' && va !== '' && vb !== '') {\n    // c = √(a² + b²)\n    cFin = Math.sqrt(a * a + b * b);\n    aFin = a; bFin = b;\n    svar = 'c = √(a² + b²) = √(' + rund(a*a) + ' + ' + rund(b*b) + ') = √' + rund(a*a + b*b) + ' ≈ ' + rund(cFin);\n    utregning = 'a² + b² = c²\\nc² = a² + b²\\nc² = ' + rund(a) + '² + ' + rund(b) + '²\\nc² = ' + rund(a*a) + ' + ' + rund(b*b) + '\\nc² = ' + rund(a*a + b*b) + '\\nc  = √' + rund(a*a + b*b) + '\\nc  ≈ ' + rund(cFin);\n  } else if (va !== '' && vb !== '' && vc !== '') {\n    // All three filled — verify\n    var diff = Math.abs(a*a + b*b - c*c);\n    var relErr = diff / (c*c);\n    if (relErr < 1e-9) {\n      showOK('✓ Disse tre sidene passer perfekt med Pytagoras: ' + rund(a) + '² + ' + rund(b) + '² = ' + rund(c) + '²', '');\n    } else {\n      showError('Disse tre sidene danner IKKE en rettvinklet trekant. Sjekk: a² + b² = ' + rund(a*a + b*b) + ', men c² = ' + rund(c*c) + '.');\n    }\n    return;\n  } else {\n    return;\n  }\n\n  // Show result\n  resultDiv.classList.remove('hidden');\n  document.getElementById('beregn-svar').textContent = svar;\n  document.getElementById('beregn-utregning').textContent = utregning;\n\n  // Draw triangle\n  svgCont.classList.remove('hidden');\n  tegnBeregnTrekant(aFin, bFin, cFin);\n}\n\nfunction showError(msg) {\n  var errDiv = document.getElementById('beregn-error');\n  errDiv.textContent = msg;\n  errDiv.classList.remove('hidden');\n}\n\nfunction showOK(title, body) {\n  var resultDiv = document.getElementById('beregn-result');\n  resultDiv.classList.remove('hidden');\n  document.getElementById('beregn-svar').textContent = title;\n  document.getElementById('beregn-utregning').textContent = body;\n}\n\nfunction nullstillBeregn() {\n  ['inp-a', 'inp-b', 'inp-c'].forEach(function(id) {\n    document.getElementById(id).value = '';\n  });\n  document.getElementById('beregn-error').classList.add('hidden');\n  document.getElementById('beregn-result').classList.add('hidden');\n  document.getElementById('beregn-svg-container').classList.add('hidden');\n}\n\nfunction tegnBeregnTrekant(a, b, c) {\n  var svg = document.getElementById('beregn-svg');\n  var W = 320, H = 260;\n  var pad = 40;\n\n  // Scale so triangle fits\n  var scale = Math.min((W - 2*pad) / b, (H - 2*pad) / a);\n  var sw = b * scale;\n  var sh = a * scale;\n\n  // Anchor: right angle at bottom-left\n  var ox = (W - sw) / 2;\n  var oy = (H + sh) / 2;\n\n  // Points: right angle at (ox, oy), along x-axis for b, up y-axis for a\n  var P = { x: ox,      y: oy      }; // right angle\n  var Q = { x: ox + sw, y: oy      }; // end of b\n  var R = { x: ox,      y: oy - sh }; // end of a\n\n  // Midpoints for labels\n  var midA = { x: (R.x + P.x)/2 - 18, y: (R.y + P.y)/2 };\n  var midB = { x: (P.x + Q.x)/2,      y: (P.y + Q.y)/2 + 18 };\n  var midC = { x: (R.x + Q.x)/2 + 14, y: (R.y + Q.y)/2 };\n\n  var html = '';\n  // Triangle fill\n  html += '<polygon points=\"' + P.x + ',' + P.y + ' ' + Q.x + ',' + Q.y + ' ' + R.x + ',' + R.y + '\" fill=\"#dbeafe\" stroke=\"#2563eb\" stroke-width=\"2.5\"/>';\n  // Right angle marker\n  var ms = 12;\n  html += '<polyline points=\"' + (P.x+ms) + ',' + P.y + ' ' + (P.x+ms) + ',' + (P.y-ms) + ' ' + P.x + ',' + (P.y-ms) + '\" fill=\"none\" stroke=\"#1d4ed8\" stroke-width=\"1.5\"/>';\n  // Labels\n  html += '<text x=\"' + midA.x + '\" y=\"' + midA.y + '\" text-anchor=\"middle\" font-size=\"15\" fill=\"#1d4ed8\" font-weight=\"bold\">a = ' + rund(a) + '</text>';\n  html += '<text x=\"' + midB.x + '\" y=\"' + midB.y + '\" text-anchor=\"middle\" font-size=\"15\" fill=\"#1d4ed8\" font-weight=\"bold\">b = ' + rund(b) + '</text>';\n  html += '<text x=\"' + midC.x + '\" y=\"' + midC.y + '\" text-anchor=\"middle\" font-size=\"15\" fill=\"#7c3aed\" font-weight=\"bold\">c = ' + rund(c) + '</text>';\n  // Vertex labels\n  html += '<text x=\"' + (P.x - 8) + '\" y=\"' + (P.y + 16) + '\" font-size=\"13\" fill=\"#374151\">C</text>';\n  html += '<text x=\"' + (Q.x + 4) + '\" y=\"' + (Q.y + 16) + '\" font-size=\"13\" fill=\"#374151\">B</text>';\n  html += '<text x=\"' + (R.x - 14) + '\" y=\"' + (R.y - 4) + '\" font-size=\"13\" fill=\"#374151\">A</text>';\n\n  svg.innerHTML = html;\n}\n\n// ─────────────────────────────────────────────\n// TAB 2 – VISUELT BEVIS\n// ─────────────────────────────────────────────\nfunction tegnBevis() {\n  var aVal = parseFloat(document.getElementById('bevis-a').value);\n  var bVal = parseFloat(document.getElementById('bevis-b').value);\n\n  var infoDiv = document.getElementById('bevis-info');\n\n  if (isNaN(aVal) || isNaN(bVal) || aVal <= 0 || bVal <= 0) {\n    infoDiv.innerHTML = '<span class=\"text-red-600\">Skriv inn positive verdier for a og b.</span>';\n    return;\n  }\n\n  var cVal = Math.sqrt(aVal * aVal + bVal * bVal);\n  var a2   = aVal * aVal;\n  var b2   = bVal * bVal;\n  var c2   = cVal * cVal;\n\n  infoDiv.innerHTML =\n    '<strong>a² = ' + rund(aVal) + '² = ' + rund(a2) + '</strong>&nbsp;&nbsp;' +\n    '<strong>b² = ' + rund(bVal) + '² = ' + rund(b2) + '</strong>&nbsp;&nbsp;' +\n    '<strong>c² = ' + rund(cVal) + '² ≈ ' + rund(c2) + '</strong><br>' +\n    '<span class=\"text-blue-700 font-semibold mt-1 inline-block\">a² + b² = ' + rund(a2) + ' + ' + rund(b2) + ' = ' + rund(a2 + b2) + ' = c² ✓</span>';\n\n  var svg = document.getElementById('bevis-svg');\n  var W = 480, H = 400;\n\n  // Scale everything so the figure fits nicely\n  var maxSide = Math.max(aVal, bVal, cVal);\n  // We want the drawing area to be about W×H with margins\n  var scale = Math.min(110 / maxSide, 12); // rough cap\n\n  var sa = aVal * scale;\n  var sb = bVal * scale;\n  var sc = cVal * scale;\n\n  // Right angle at origin; place the triangle centrally\n  // Triangle: P (right angle), Q (along x by sb), R (along y by sa) — measured from bottom-left\n  // Center the whole scene\n  var sceneW = sb + sc + sa + 60; // rough estimate\n  var sceneH = sa + sc + 40;\n  var scaleF = Math.min((W - 40) / sceneW, (H - 40) / sceneH);\n  sa *= scaleF; sb *= scaleF; sc *= scaleF;\n  scale *= scaleF;\n\n  // triangle anchor: right angle vertex\n  var ox = 30 + sc * Math.cos(Math.PI - Math.atan2(aVal, bVal)) + sa;\n  // Simpler: place triangle with right-angle corner at (px, py)\n  var px = 30 + sc + 10;\n  var py = 30 + sc + 10;\n\n  // Triangle vertices\n  var P = { x: px,      y: py      }; // right angle\n  var Q = { x: px + sb, y: py      }; // along b\n  var R = { x: px,      y: py - sa }; // along a\n\n  // Angle of hypotenuse: from Q to R\n  var angle = Math.atan2(R.y - Q.y, R.x - Q.x); // direction Q→R\n  // unit vectors perpendicular to hypotenuse (outward from triangle)\n  var perpX = Math.sin(angle);  // rotated 90° clockwise outward\n  var perpY = -Math.cos(angle);\n\n  // Square on a (left side, P to R)\n  // a goes upward: P→R is (0, -sa)\n  // square outward to the left\n  var Sqa = [\n    P,\n    R,\n    { x: R.x - sa, y: R.y },     // R moved left by sa\n    { x: P.x - sa, y: P.y }      // P moved left by sa\n  ];\n\n  // Square on b (bottom, P to Q)\n  // b goes right: P→Q is (sb, 0)\n  // square outward downward\n  var Sqb = [\n    P,\n    Q,\n    { x: Q.x, y: Q.y + sb },\n    { x: P.x, y: P.y + sb }\n  ];\n\n  // Square on c (hypotenuse Q to R, outward)\n  // vector Q→R\n  var qrX = R.x - Q.x, qrY = R.y - Q.y;\n  // perpendicular outward (away from triangle, i.e. rotated CCW)\n  var pX = -qrY, pY = qrX; // rotate 90° CCW (into the \"outside\")\n  // Check: inside point is P; we want perpendicular pointing away from P\n  // Midpoint of QR:\n  var mQR = { x: (Q.x + R.x)/2, y: (Q.y + R.y)/2 };\n  // dot product of perp with (mQR → P): if positive, we need to flip\n  var dotCheck = (P.x - mQR.x) * pX + (P.y - mQR.y) * pY;\n  if (dotCheck > 0) { pX = -pX; pY = -pY; }\n\n  var Sqc = [\n    Q,\n    R,\n    { x: R.x + pX, y: R.y + pY },\n    { x: Q.x + pX, y: Q.y + pY }\n  ];\n\n  function pts(arr) {\n    return arr.map(function(p) { return p.x + ',' + p.y; }).join(' ');\n  }\n  function midOf(arr) {\n    var mx = arr.reduce(function(s,p){return s+p.x;},0)/arr.length;\n    var my = arr.reduce(function(s,p){return s+p.y;},0)/arr.length;\n    return {x: mx, y: my};\n  }\n\n  var html = '';\n\n  // Squares\n  html += '<polygon points=\"' + pts(Sqa) + '\" fill=\"#bfdbfe\" stroke=\"#2563eb\" stroke-width=\"2\" class=\"proof-square\"/>';\n  html += '<polygon points=\"' + pts(Sqb) + '\" fill=\"#bbf7d0\" stroke=\"#16a34a\" stroke-width=\"2\" class=\"proof-square\"/>';\n  html += '<polygon points=\"' + pts(Sqc) + '\" fill=\"#fde68a\" stroke=\"#d97706\" stroke-width=\"2\" class=\"proof-square\"/>';\n\n  // Triangle\n  html += '<polygon points=\"' + P.x + ',' + P.y + ' ' + Q.x + ',' + Q.y + ' ' + R.x + ',' + R.y + '\" fill=\"#e0e7ff\" stroke=\"#4338ca\" stroke-width=\"2.5\"/>';\n\n  // Right angle marker\n  var ms = Math.min(sa, sb, 10);\n  html += '<polyline points=\"' + (P.x+ms) + ',' + P.y + ' ' + (P.x+ms) + ',' + (P.y-ms) + ' ' + P.x + ',' + (P.y-ms) + '\" fill=\"none\" stroke=\"#374151\" stroke-width=\"1.5\"/>';\n\n  // Area labels\n  var ma = midOf(Sqa);\n  var mb = midOf(Sqb);\n  var mc = midOf(Sqc);\n\n  html += '<text x=\"' + ma.x + '\" y=\"' + (ma.y+6) + '\" text-anchor=\"middle\" font-size=\"13\" fill=\"#1d4ed8\" font-weight=\"bold\">a² = ' + rund(a2) + '</text>';\n  html += '<text x=\"' + mb.x + '\" y=\"' + (mb.y+6) + '\" text-anchor=\"middle\" font-size=\"13\" fill=\"#15803d\" font-weight=\"bold\">b² = ' + rund(b2) + '</text>';\n  html += '<text x=\"' + mc.x + '\" y=\"' + (mc.y+6) + '\" text-anchor=\"middle\" font-size=\"13\" fill=\"#92400e\" font-weight=\"bold\">c² ≈ ' + rund(c2) + '</text>';\n\n  // Side labels inside triangle\n  var midA2 = { x: (R.x + P.x)/2 + 10, y: (R.y + P.y)/2 };\n  var midB2 = { x: (P.x + Q.x)/2,      y: (P.y + Q.y)/2 + 14 };\n  var midC2 = { x: (R.x + Q.x)/2 + 6,  y: (R.y + Q.y)/2 };\n\n  html += '<text x=\"' + midA2.x + '\" y=\"' + midA2.y + '\" text-anchor=\"middle\" font-size=\"12\" fill=\"#1d4ed8\">a=' + rund(aVal) + '</text>';\n  html += '<text x=\"' + midB2.x + '\" y=\"' + midB2.y + '\" text-anchor=\"middle\" font-size=\"12\" fill=\"#15803d\">b=' + rund(bVal) + '</text>';\n  html += '<text x=\"' + midC2.x + '\" y=\"' + midC2.y + '\" text-anchor=\"middle\" font-size=\"12\" fill=\"#92400e\">c≈' + rund(cVal) + '</text>';\n\n  svg.innerHTML = html;\n}\n\n// ─────────────────────────────────────────────\n// TAB 3 – AVSTAND MELLOM TO PUNKTER\n// ─────────────────────────────────────────────\nfunction beregnAvstand() {\n  var x1 = parseFloat(document.getElementById('av-x1').value);\n  var y1 = parseFloat(document.getElementById('av-y1').value);\n  var x2 = parseFloat(document.getElementById('av-x2').value);\n  var y2 = parseFloat(document.getElementById('av-y2').value);\n\n  var svarDiv = document.getElementById('avstand-svar');\n  var utrDiv  = document.getElementById('avstand-utregning');\n\n  if ([x1,y1,x2,y2].some(isNaN)) {\n    svarDiv.textContent = 'Skriv inn gyldige koordinater.';\n    utrDiv.textContent  = '';\n    tegnAvstand(0, 0, 1, 1, false);\n    return;\n  }\n\n  var dx   = x2 - x1;\n  var dy   = y2 - y1;\n  var dx2  = dx * dx;\n  var dy2  = dy * dy;\n  var d    = Math.sqrt(dx2 + dy2);\n\n  svarDiv.textContent = 'd = √(Δx² + Δy²) = √(' + rund(dx2) + ' + ' + rund(dy2) + ') ≈ ' + rund(d);\n  utrDiv.textContent  =\n    'P₁ = (' + rund(x1) + ', ' + rund(y1) + '),  P₂ = (' + rund(x2) + ', ' + rund(y2) + ')\\n' +\n    'Δx = x₂ − x₁ = ' + rund(x2) + ' − ' + rund(x1) + ' = ' + rund(dx) + '\\n' +\n    'Δy = y₂ − y₁ = ' + rund(y2) + ' − ' + rund(y1) + ' = ' + rund(dy) + '\\n' +\n    'd  = √(Δx² + Δy²)\\n' +\n    'd  = √(' + rund(dx) + '² + ' + rund(dy) + '²)\\n' +\n    'd  = √(' + rund(dx2) + ' + ' + rund(dy2) + ')\\n' +\n    'd  = √' + rund(dx2 + dy2) + '\\n' +\n    'd  ≈ ' + rund(d);\n\n  tegnAvstand(x1, y1, x2, y2, true);\n}\n\nfunction tegnAvstand(x1, y1, x2, y2, valid) {\n  var svg = document.getElementById('avstand-svg');\n  var W = 340, H = 300;\n\n  if (!valid) { svg.innerHTML = ''; return; }\n\n  // Map world coords to SVG\n  var pad = 50;\n  var allX = [x1, x2];\n  var allY = [y1, y2];\n  var minX = Math.min.apply(null, allX) - 1;\n  var maxX = Math.max.apply(null, allX) + 1;\n  var minY = Math.min.apply(null, allY) - 1;\n  var maxY = Math.max.apply(null, allY) + 1;\n\n  // Keep aspect ratio reasonable\n  var rangeX = maxX - minX || 2;\n  var rangeY = maxY - minY || 2;\n\n  // Force equal aspect ratio\n  var aspect = rangeX / rangeY;\n  var drawW = W - 2*pad;\n  var drawH = H - 2*pad;\n\n  var scaleX, scaleY;\n  if (drawW / drawH > aspect) {\n    scaleY = drawH / rangeY;\n    scaleX = scaleY;\n  } else {\n    scaleX = drawW / rangeX;\n    scaleY = scaleX;\n  }\n\n  function toSvgX(wx) { return pad + (wx - minX) * scaleX; }\n  function toSvgY(wy) { return H - pad - (wy - minY) * scaleY; }\n\n  var sx1 = toSvgX(x1), sy1 = toSvgY(y1);\n  var sx2 = toSvgX(x2), sy2 = toSvgY(y2);\n  var sc  = toSvgX(x2); // corner of right angle\n  var scY = toSvgY(y1);\n\n  // Axis zero lines (if in range)\n  var html = '';\n  if (minX <= 0 && maxX >= 0) {\n    var ax0 = toSvgX(0);\n    html += '<line x1=\"' + ax0 + '\" y1=\"' + (pad-10) + '\" x2=\"' + ax0 + '\" y2=\"' + (H-pad+10) + '\" stroke=\"#d1d5db\" stroke-width=\"1\" stroke-dasharray=\"4,3\"/>';\n  }\n  if (minY <= 0 && maxY >= 0) {\n    var ay0 = toSvgY(0);\n    html += '<line x1=\"' + (pad-10) + '\" y1=\"' + ay0 + '\" x2=\"' + (W-pad+10) + '\" y2=\"' + ay0 + '\" stroke=\"#d1d5db\" stroke-width=\"1\" stroke-dasharray=\"4,3\"/>';\n  }\n\n  // Δx and Δy dashed lines (the two legs)\n  html += '<line x1=\"' + sx1 + '\" y1=\"' + sy1 + '\" x2=\"' + sc + '\" y2=\"' + scY + '\" stroke=\"#16a34a\" stroke-width=\"2\" stroke-dasharray=\"6,3\"/>';\n  html += '<line x1=\"' + sc  + '\" y1=\"' + scY + '\" x2=\"' + sx2 + '\" y2=\"' + sy2 + '\" stroke=\"#9333ea\" stroke-width=\"2\" stroke-dasharray=\"6,3\"/>';\n\n  // Hypotenuse (the distance d)\n  html += '<line x1=\"' + sx1 + '\" y1=\"' + sy1 + '\" x2=\"' + sx2 + '\" y2=\"' + sy2 + '\" stroke=\"#dc2626\" stroke-width=\"2.5\"/>';\n\n  // Right-angle marker at corner\n  var ms = 8;\n  var cornerX = sc, cornerY = scY;\n  var sign_dx = (sx2 > sx1) ? -1 : 1;\n  var sign_dy = (sy2 < sy1) ? 1 : -1; // SVG y is inverted\n  if (Math.abs(x2 - x1) > 1e-9 && Math.abs(y2 - y1) > 1e-9) {\n    var dxDir = sx1 < sx2 ? ms : -ms;\n    var dyDir = sy1 > sy2 ? ms : -ms;\n    html += '<polyline points=\"' +\n      (cornerX + dxDir) + ',' + cornerY + ' ' +\n      (cornerX + dxDir) + ',' + (cornerY - dyDir) + ' ' +\n      cornerX + ',' + (cornerY - dyDir) + '\" fill=\"none\" stroke=\"#374151\" stroke-width=\"1.5\"/>';\n  }\n\n  // Points\n  html += '<circle cx=\"' + sx1 + '\" cy=\"' + sy1 + '\" r=\"5\" fill=\"#2563eb\"/>';\n  html += '<circle cx=\"' + sx2 + '\" cy=\"' + sy2 + '\" r=\"5\" fill=\"#2563eb\"/>';\n\n  // Point labels\n  var loff = 10;\n  html += '<text x=\"' + (sx1 - loff) + '\" y=\"' + (sy1 - loff) + '\" font-size=\"13\" fill=\"#1e40af\" font-weight=\"bold\">P₁(' + rund(x1) + ', ' + rund(y1) + ')</text>';\n  html += '<text x=\"' + (sx2 + 4)    + '\" y=\"' + (sy2 - loff) + '\" font-size=\"13\" fill=\"#1e40af\" font-weight=\"bold\">P₂(' + rund(x2) + ', ' + rund(y2) + ')</text>';\n\n  // Δx label\n  var dx = x2 - x1, dy = y2 - y1;\n  var midDxSvgX = (sx1 + sc) / 2;\n  var midDxSvgY = scY + 16;\n  html += '<text x=\"' + midDxSvgX + '\" y=\"' + midDxSvgY + '\" text-anchor=\"middle\" font-size=\"12\" fill=\"#15803d\" font-weight=\"bold\">Δx = ' + rund(dx) + '</text>';\n\n  // Δy label\n  var midDySvgX = sc + 16;\n  var midDySvgY = (scY + sy2) / 2;\n  html += '<text x=\"' + midDySvgX + '\" y=\"' + midDySvgY + '\" text-anchor=\"middle\" font-size=\"12\" fill=\"#7e22ce\" font-weight=\"bold\">Δy = ' + rund(dy) + '</text>';\n\n  // d label along hypotenuse\n  var midHX = (sx1 + sx2) / 2 - 12;\n  var midHY = (sy1 + sy2) / 2 - 8;\n  var d = Math.sqrt(dx*dx + dy*dy);\n  html += '<text x=\"' + midHX + '\" y=\"' + midHY + '\" text-anchor=\"middle\" font-size=\"12\" fill=\"#b91c1c\" font-weight=\"bold\">d ≈ ' + rund(d) + '</text>';\n\n  svg.innerHTML = html;\n}\n\n// ─────────────────────────────────────────────\n// TAB 4 – 3D ROMDIAGONAL\n// ─────────────────────────────────────────────\nfunction beregn3D() {\n  var l = parseFloat(document.getElementById('d3-l').value);\n  var b = parseFloat(document.getElementById('d3-b').value);\n  var h = parseFloat(document.getElementById('d3-h').value);\n\n  var svarDiv = document.getElementById('d3-svar');\n  var utrDiv  = document.getElementById('d3-utregning');\n\n  if ([l,b,h].some(function(v){return isNaN(v)||v<=0;})) {\n    svarDiv.textContent = 'Skriv inn positive verdier for l, b og h.';\n    utrDiv.textContent  = '';\n    document.getElementById('d3-svg').innerHTML = '';\n    return;\n  }\n\n  // Step 1: diagonal of base = √(l² + b²)\n  var d_base = Math.sqrt(l*l + b*b);\n  // Step 2: space diagonal = √(d_base² + h²) = √(l² + b² + h²)\n  var d_space = Math.sqrt(l*l + b*b + h*h);\n\n  svarDiv.textContent = 'd = √(l² + b² + h²) = √(' + rund(l*l) + ' + ' + rund(b*b) + ' + ' + rund(h*h) + ') ≈ ' + rund(d_space);\n  utrDiv.textContent  =\n    'Steg 1 — diagonal i grunnflaten:\\n' +\n    '  d₁ = √(l² + b²) = √(' + rund(l) + '² + ' + rund(b) + '²) = √(' + rund(l*l) + ' + ' + rund(b*b) + ') = √' + rund(l*l+b*b) + ' ≈ ' + rund(d_base) + '\\n\\n' +\n    'Steg 2 — romdiagonal (d₁ er katet, h er katet):\\n' +\n    '  d = √(d₁² + h²) = √(' + rund(d_base) + '² + ' + rund(h) + '²)\\n' +\n    '    = √(' + rund(d_base*d_base) + ' + ' + rund(h*h) + ')\\n' +\n    '    = √' + rund(d_space*d_space) + '\\n' +\n    '    ≈ ' + rund(d_space) + '\\n\\n' +\n    'Alternativt direkte:\\n' +\n    '  d = √(l² + b² + h²) = √(' + rund(l*l) + ' + ' + rund(b*b) + ' + ' + rund(h*h) + ') ≈ ' + rund(d_space);\n\n  tegn3D(l, b, h, d_base, d_space);\n}\n\nfunction tegn3D(l, b, h, d_base, d_space) {\n  var svg = document.getElementById('d3-svg');\n  var W = 340, H = 280;\n\n  // Isometric-style box projection\n  var maxD = Math.max(l, b, h);\n  var scale = Math.min(80 / maxD, 12);\n  var sl = l * scale;\n  var sb = b * scale;\n  var sh = h * scale;\n\n  // Isometric angles\n  var cosA = Math.cos(Math.PI * 30 / 180);\n  var sinA = Math.sin(Math.PI * 30 / 180);\n\n  // Base origin (front-bottom-left corner in SVG space)\n  var ox = W / 2 - (sl * cosA) / 2;\n  var oy = H * 0.65;\n\n  // 8 corners of the box in isometric projection\n  // x-axis goes right-down (for l), z-axis goes left-down (for b), y-axis goes up (for h)\n  function iso(lc, bc, hc) {\n    return {\n      x: ox + lc * sl * cosA - bc * sb * cosA,\n      y: oy - hc * sh + lc * sl * sinA + bc * sb * sinA\n    };\n  }\n\n  var A = iso(0,0,0); // front-bottom-left\n  var B = iso(1,0,0); // front-bottom-right (along l)\n  var C = iso(1,1,0); // back-bottom-right\n  var D = iso(0,1,0); // back-bottom-left\n  var E = iso(0,0,1); // front-top-left\n  var F = iso(1,0,1); // front-top-right\n  var G = iso(1,1,1); // back-top-right (far corner)\n  var Hi= iso(0,1,1); // back-top-left\n\n  function pt(p) { return p.x.toFixed(1) + ',' + p.y.toFixed(1); }\n\n  var html = '';\n  // Hidden edges (dashed)\n  html += '<line x1=\"' + pt(A).split(',')[0] + '\" y1=\"' + A.y.toFixed(1) + '\" x2=\"' + D.x.toFixed(1) + '\" y2=\"' + D.y.toFixed(1) + '\" stroke=\"#9ca3af\" stroke-width=\"1.2\" stroke-dasharray=\"4,3\"/>';\n  html += '<line x1=\"' + D.x.toFixed(1) + '\" y1=\"' + D.y.toFixed(1) + '\" x2=\"' + Hi.x.toFixed(1) + '\" y2=\"' + Hi.y.toFixed(1) + '\" stroke=\"#9ca3af\" stroke-width=\"1.2\" stroke-dasharray=\"4,3\"/>';\n  html += '<line x1=\"' + D.x.toFixed(1) + '\" y1=\"' + D.y.toFixed(1) + '\" x2=\"' + C.x.toFixed(1) + '\" y2=\"' + C.y.toFixed(1) + '\" stroke=\"#9ca3af\" stroke-width=\"1.2\" stroke-dasharray=\"4,3\"/>';\n\n  // Faces\n  // Bottom\n  html += '<polygon points=\"' + pt(A) + ' ' + pt(B) + ' ' + pt(C) + ' ' + pt(D) + '\" fill=\"#e0e7ff\" stroke=\"#4338ca\" stroke-width=\"1.5\"/>';\n  // Front face\n  html += '<polygon points=\"' + pt(A) + ' ' + pt(B) + ' ' + pt(F) + ' ' + pt(E) + '\" fill=\"#dbeafe\" stroke=\"#2563eb\" stroke-width=\"1.5\"/>';\n  // Right face\n  html += '<polygon points=\"' + pt(B) + ' ' + pt(C) + ' ' + pt(G) + ' ' + pt(F) + '\" fill=\"#ede9fe\" stroke=\"#6d28d9\" stroke-width=\"1.5\"/>';\n  // Top face\n  html += '<polygon points=\"' + pt(E) + ' ' + pt(F) + ' ' + pt(G) + ' ' + pt(Hi) + '\" fill=\"#ecfdf5\" stroke=\"#059669\" stroke-width=\"1.5\"/>';\n\n  // Base diagonal (A to C)\n  html += '<line x1=\"' + A.x.toFixed(1) + '\" y1=\"' + A.y.toFixed(1) + '\" x2=\"' + C.x.toFixed(1) + '\" y2=\"' + C.y.toFixed(1) + '\" stroke=\"#f59e0b\" stroke-width=\"2\" stroke-dasharray=\"5,3\"/>';\n\n  // Space diagonal (A to G) — main feature\n  html += '<line x1=\"' + A.x.toFixed(1) + '\" y1=\"' + A.y.toFixed(1) + '\" x2=\"' + G.x.toFixed(1) + '\" y2=\"' + G.y.toFixed(1) + '\" stroke=\"#dc2626\" stroke-width=\"2.5\"/>';\n\n  // Remaining visible edges\n  html += '<line x1=\"' + E.x.toFixed(1) + '\" y1=\"' + E.y.toFixed(1) + '\" x2=\"' + Hi.x.toFixed(1) + '\" y2=\"' + Hi.y.toFixed(1) + '\" stroke=\"#2563eb\" stroke-width=\"1.5\"/>';\n  html += '<line x1=\"' + Hi.x.toFixed(1) + '\" y1=\"' + Hi.y.toFixed(1) + '\" x2=\"' + G.x.toFixed(1) + '\" y2=\"' + G.y.toFixed(1) + '\" stroke=\"#2563eb\" stroke-width=\"1.5\"/>';\n  html += '<line x1=\"' + C.x.toFixed(1) + '\" y1=\"' + C.y.toFixed(1) + '\" x2=\"' + G.x.toFixed(1) + '\" y2=\"' + G.y.toFixed(1) + '\" stroke=\"#2563eb\" stroke-width=\"1.5\"/>';\n\n  // Dots at corners\n  html += '<circle cx=\"' + A.x.toFixed(1) + '\" cy=\"' + A.y.toFixed(1) + '\" r=\"3\" fill=\"#2563eb\"/>';\n  html += '<circle cx=\"' + G.x.toFixed(1) + '\" cy=\"' + G.y.toFixed(1) + '\" r=\"3\" fill=\"#dc2626\"/>';\n  html += '<circle cx=\"' + C.x.toFixed(1) + '\" cy=\"' + C.y.toFixed(1) + '\" r=\"3\" fill=\"#f59e0b\"/>';\n\n  // Labels on edges\n  var midAB = { x: (A.x+B.x)/2, y: (A.y+B.y)/2 + 14 };\n  var midAD = { x: (A.x+D.x)/2 - 20, y: (A.y+D.y)/2 + 6 };\n  var midAE = { x: A.x - 20, y: (A.y+E.y)/2 };\n  html += '<text x=\"' + midAB.x.toFixed(0) + '\" y=\"' + midAB.y.toFixed(0) + '\" text-anchor=\"middle\" font-size=\"12\" fill=\"#1d4ed8\">l=' + rund(l) + '</text>';\n  html += '<text x=\"' + midAD.x.toFixed(0) + '\" y=\"' + midAD.y.toFixed(0) + '\" text-anchor=\"middle\" font-size=\"12\" fill=\"#6d28d9\">b=' + rund(b) + '</text>';\n  html += '<text x=\"' + midAE.x.toFixed(0) + '\" y=\"' + midAE.y.toFixed(0) + '\" text-anchor=\"middle\" font-size=\"12\" fill=\"#065f46\">h=' + rund(h) + '</text>';\n\n  // Space diagonal label\n  var midAG = { x: (A.x+G.x)/2 + 8, y: (A.y+G.y)/2 - 8 };\n  html += '<text x=\"' + midAG.x.toFixed(0) + '\" y=\"' + midAG.y.toFixed(0) + '\" text-anchor=\"middle\" font-size=\"12\" fill=\"#b91c1c\" font-weight=\"bold\">d≈' + rund(d_space) + '</text>';\n\n  // Base diagonal label\n  var midAC = { x: (A.x+C.x)/2, y: (A.y+C.y)/2 + 14 };\n  html += '<text x=\"' + midAC.x.toFixed(0) + '\" y=\"' + midAC.y.toFixed(0) + '\" text-anchor=\"middle\" font-size=\"11\" fill=\"#b45309\">d₁≈' + rund(d_base) + '</text>';\n\n  svg.innerHTML = html;\n}\n\n// ─────────────────────────────────────────────\n// Init on load\n// ─────────────────────────────────────────────\nwindow.addEventListener('load', function() {\n  // Pre-fill the beregn tab for a 3-4-5 triangle demonstration\n  document.getElementById('inp-a').value = '3';\n  document.getElementById('inp-b').value = '4';\n  beregnSide();\n\n  // Init other tabs silently (so they render when visited)\n  tegnBevis();\n  beregnAvstand();\n  beregn3D();\n});\n</script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Pytagoras setning",
    "windowTitle": "Pytagoras setning",
    "bundleId": "com.halisonworks.geopytagoras",
    "iconPath": null
  },
  "categoryId": null,
  "source": "import",
  "createdAt": "2026-06-02T12:00:00.000Z",
  "updatedAt": "2026-06-02T12:00:00.000Z",
  "sharedAt": "2026-06-02T12:00:00.000Z"
}
