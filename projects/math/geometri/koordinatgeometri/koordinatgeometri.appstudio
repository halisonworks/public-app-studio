{
  "schema": "app-studio/canvas@1",
  "id": "example-geo-koordinatgeometri",
  "name": "koordinatgeometri.html",
  "code": "<!DOCTYPE html>\n<!--\n  Koordinatgeometri — Halison App Studio-eksempel\n\n  Interaktivt læremiddel for geometri (matematikk 1P/2P, LK20): avstand,\n  midtpunkt og stigningstall mellom to punkter i koordinatsystemet.\n\n  Fra Halison App Studio sitt offentlige bibliotek:\n  https://github.com/halisonworks/public-app-studio\n\n  Tillatt bruk: personlig, pedagogisk og annen ikke-kommersiell bruk. Behold denne\n  headeren og kildelenken; ikke-kommersiell bruk. Utgitt under Halison App Studio\n  Examples License — se LICENSE-filen i repoet over.\n-->\n<html lang=\"no\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Koordinatgeometri – Matematikk 1P/2P</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Segoe UI', system-ui, sans-serif; }\n    .point-handle { cursor: grab; }\n    .point-handle:active { cursor: grabbing; }\n    .axis-line { stroke: #374151; stroke-width: 1.5; }\n    .grid-line { stroke: #e5e7eb; stroke-width: 1; }\n    .grid-line-major { stroke: #d1d5db; stroke-width: 1; }\n    .segment-line { stroke: #3b82f6; stroke-width: 2.5; stroke-linecap: round; }\n    .triangle-leg { stroke: #f59e0b; stroke-width: 2; stroke-dasharray: 6 3; }\n    .midpoint-marker { fill: #10b981; stroke: white; stroke-width: 2; }\n    .point-a { fill: #ef4444; stroke: white; stroke-width: 2.5; }\n    .point-b { fill: #6366f1; stroke: white; stroke-width: 2.5; }\n    .label-text { font-size: 13px; font-weight: 600; font-family: 'Segoe UI', system-ui, sans-serif; }\n    .axis-label { font-size: 12px; fill: #374151; font-family: 'Segoe UI', system-ui, sans-serif; }\n    .dim-label { font-size: 11px; fill: #b45309; font-family: 'Segoe UI', system-ui, sans-serif; font-style: italic; }\n    input[type=number]::-webkit-inner-spin-button,\n    input[type=number]::-webkit-outer-spin-button { opacity: 1; }\n    .calc-box { background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%); }\n    .formula-highlight { background: #fef3c7; border-left: 3px solid #f59e0b; }\n    .result-highlight { background: #ecfdf5; border-left: 3px solid #10b981; }\n    .slope-highlight { background: #ede9fe; border-left: 3px solid #6366f1; }\n  </style>\n</head>\n<body class=\"bg-gray-50 min-h-screen\">\n\n  <!-- Header -->\n  <header class=\"bg-white border-b border-gray-200 shadow-sm\">\n    <div class=\"max-w-6xl mx-auto px-4 py-4\">\n      <div class=\"flex items-center gap-3\">\n        <div class=\"w-10 h-10 bg-blue-600 rounded-xl flex items-center justify-center text-white font-bold text-lg\">K</div>\n        <div>\n          <h1 class=\"text-xl font-bold text-gray-900\">Koordinatgeometri</h1>\n          <p class=\"text-sm text-gray-500\">Matematikk 1P/2P · LK20 · Avstand, midtpunkt og stigningstall</p>\n        </div>\n      </div>\n    </div>\n  </header>\n\n  <main class=\"max-w-6xl mx-auto px-4 py-6\">\n\n    <!-- Point input controls -->\n    <div class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-5 mb-6\">\n      <h2 class=\"text-base font-semibold text-gray-700 mb-4\">Sett koordinater for punktene</h2>\n      <div class=\"flex flex-wrap gap-6\">\n        <!-- Point A -->\n        <div class=\"flex items-center gap-3\">\n          <div class=\"w-8 h-8 bg-red-500 rounded-full flex items-center justify-center text-white font-bold text-sm flex-shrink-0\">A</div>\n          <div class=\"flex items-center gap-2\">\n            <label class=\"text-sm font-medium text-gray-600\">x<sub>1</sub></label>\n            <input id=\"ax\" type=\"number\" step=\"0.5\" value=\"-3\"\n              class=\"w-20 border border-gray-300 rounded-lg px-2 py-1.5 text-sm text-center focus:outline-none focus:ring-2 focus:ring-red-400\" />\n          </div>\n          <div class=\"flex items-center gap-2\">\n            <label class=\"text-sm font-medium text-gray-600\">y<sub>1</sub></label>\n            <input id=\"ay\" type=\"number\" step=\"0.5\" value=\"1\"\n              class=\"w-20 border border-gray-300 rounded-lg px-2 py-1.5 text-sm text-center focus:outline-none focus:ring-2 focus:ring-red-400\" />\n          </div>\n        </div>\n        <!-- Point B -->\n        <div class=\"flex items-center gap-3\">\n          <div class=\"w-8 h-8 bg-indigo-500 rounded-full flex items-center justify-center text-white font-bold text-sm flex-shrink-0\">B</div>\n          <div class=\"flex items-center gap-2\">\n            <label class=\"text-sm font-medium text-gray-600\">x<sub>2</sub></label>\n            <input id=\"bx\" type=\"number\" step=\"0.5\" value=\"3\"\n              class=\"w-20 border border-gray-300 rounded-lg px-2 py-1.5 text-sm text-center focus:outline-none focus:ring-2 focus:ring-indigo-400\" />\n          </div>\n          <div class=\"flex items-center gap-2\">\n            <label class=\"text-sm font-medium text-gray-600\">y<sub>2</sub></label>\n            <input id=\"by\" type=\"number\" step=\"0.5\" value=\"5\"\n              class=\"w-20 border border-gray-300 rounded-lg px-2 py-1.5 text-sm text-center focus:outline-none focus:ring-2 focus:ring-indigo-400\" />\n          </div>\n        </div>\n        <!-- Legend -->\n        <div class=\"flex items-center gap-4 ml-auto flex-wrap\">\n          <div class=\"flex items-center gap-2 text-xs text-gray-500\">\n            <div class=\"w-6 h-0.5 bg-blue-500\"></div><span>Linjestykket AB</span>\n          </div>\n          <div class=\"flex items-center gap-2 text-xs text-gray-500\">\n            <div class=\"w-6 h-0.5 bg-amber-500\" style=\"border-top: 2px dashed #f59e0b; background:none;\"></div><span>Δx og Δy (Pytagoras)</span>\n          </div>\n          <div class=\"flex items-center gap-2 text-xs text-gray-500\">\n            <div class=\"w-3 h-3 bg-emerald-500 rounded-full\"></div><span>Midtpunkt M</span>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Main content: SVG + calculations -->\n    <div class=\"flex flex-col lg:flex-row gap-6\">\n\n      <!-- SVG Coordinate System -->\n      <div class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-4 flex-shrink-0\">\n        <svg id=\"coordSvg\" width=\"460\" height=\"460\" viewBox=\"0 0 460 460\"\n             style=\"display:block; touch-action:none; user-select:none;\">\n          <!-- Grid and axes rendered by JS -->\n          <g id=\"gridGroup\"></g>\n          <g id=\"axesGroup\"></g>\n          <g id=\"triangleGroup\"></g>\n          <g id=\"segmentGroup\"></g>\n          <g id=\"midpointGroup\"></g>\n          <g id=\"pointsGroup\"></g>\n          <g id=\"labelsGroup\"></g>\n        </svg>\n      </div>\n\n      <!-- Calculations panel -->\n      <div class=\"flex-1 flex flex-col gap-4\">\n\n        <!-- Avstand -->\n        <div class=\"calc-box rounded-2xl border border-gray-200 shadow-sm p-5\">\n          <div class=\"flex items-center gap-2 mb-3\">\n            <div class=\"w-7 h-7 bg-amber-400 rounded-lg flex items-center justify-center\">\n              <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-4 h-4 text-white\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M4 12h16M4 12l4-4M4 12l4 4\"/></svg>\n            </div>\n            <h3 class=\"font-bold text-gray-800\">Avstand mellom A og B</h3>\n          </div>\n          <div class=\"formula-highlight rounded-lg px-4 py-3 mb-3\">\n            <p class=\"text-sm font-medium text-amber-800\">Formel (Pytagoras):</p>\n            <p class=\"text-sm text-amber-900 mt-1\">|AB| = √( (x₂ − x₁)² + (y₂ − y₁)² )</p>\n            <p class=\"text-xs text-amber-700 mt-1\">Δx og Δy er katetene; |AB| er hypotenusen i rettvinklet trekant.</p>\n          </div>\n          <div id=\"distCalc\" class=\"text-sm text-gray-700 space-y-1 leading-relaxed\"></div>\n          <div id=\"distResult\" class=\"result-highlight rounded-lg px-4 py-2 mt-3\"></div>\n        </div>\n\n        <!-- Midtpunkt -->\n        <div class=\"calc-box rounded-2xl border border-gray-200 shadow-sm p-5\">\n          <div class=\"flex items-center gap-2 mb-3\">\n            <div class=\"w-7 h-7 bg-emerald-500 rounded-lg flex items-center justify-center\">\n              <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-4 h-4 text-white\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\"><circle cx=\"12\" cy=\"12\" r=\"3\" fill=\"white\"/></svg>\n            </div>\n            <h3 class=\"font-bold text-gray-800\">Midtpunkt M</h3>\n          </div>\n          <div class=\"formula-highlight rounded-lg px-4 py-3 mb-3\" style=\"background:#d1fae5;border-left-color:#10b981;\">\n            <p class=\"text-sm font-medium text-emerald-800\">Formel:</p>\n            <p class=\"text-sm text-emerald-900 mt-1\">M = ( (x₁ + x₂) / 2 , (y₁ + y₂) / 2 )</p>\n          </div>\n          <div id=\"midCalc\" class=\"text-sm text-gray-700 space-y-1 leading-relaxed\"></div>\n          <div id=\"midResult\" class=\"result-highlight rounded-lg px-4 py-2 mt-3\"></div>\n        </div>\n\n        <!-- Stigningstall -->\n        <div class=\"calc-box rounded-2xl border border-gray-200 shadow-sm p-5\">\n          <div class=\"flex items-center gap-2 mb-3\">\n            <div class=\"w-7 h-7 bg-indigo-500 rounded-lg flex items-center justify-center\">\n              <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-4 h-4 text-white\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2.5\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M3 17l6-6 4 4 8-8\"/></svg>\n            </div>\n            <h3 class=\"font-bold text-gray-800\">Stigningstall</h3>\n          </div>\n          <div class=\"formula-highlight rounded-lg px-4 py-3 mb-3\" style=\"background:#ede9fe;border-left-color:#6366f1;\">\n            <p class=\"text-sm font-medium text-indigo-800\">Formel:</p>\n            <p class=\"text-sm text-indigo-900 mt-1\">a = (y₂ − y₁) / (x₂ − x₁) = Δy / Δx</p>\n            <p class=\"text-xs text-indigo-700 mt-1\">Stigningstallet forteller hvor mye y øker per enhet x øker.</p>\n          </div>\n          <div id=\"slopeCalc\" class=\"text-sm text-gray-700 space-y-1 leading-relaxed\"></div>\n          <div id=\"slopeResult\" class=\"slope-highlight rounded-lg px-4 py-2 mt-3\"></div>\n        </div>\n\n      </div>\n    </div>\n\n    <!-- Info footer -->\n    <div class=\"mt-6 bg-blue-50 border border-blue-100 rounded-xl px-5 py-4 text-sm text-blue-800\">\n      <strong>Tips:</strong> Dra punktene A og B direkte i koordinatsystemet, eller skriv inn koordinater i feltene over. Formler og utregninger oppdateres automatisk.\n    </div>\n\n  </main>\n\n  <script>\n  (function() {\n    // ---- SVG setup ----\n    const SVG_W = 460, SVG_H = 460;\n    const PADDING = 40;\n    const GRID_RANGE = 8;  // -8 to 8\n    const TICK_STEP = 1;\n\n    // Math coords to SVG pixel coords\n    function toSvg(mx, my) {\n      const cx = SVG_W / 2;\n      const cy = SVG_H / 2;\n      const scale = (SVG_W - 2 * PADDING) / (2 * GRID_RANGE);\n      return {\n        x: cx + mx * scale,\n        y: cy - my * scale\n      };\n    }\n\n    // SVG pixel coords to math coords\n    function toMath(sx, sy) {\n      const cx = SVG_W / 2;\n      const cy = SVG_H / 2;\n      const scale = (SVG_W - 2 * PADDING) / (2 * GRID_RANGE);\n      return {\n        x: (sx - cx) / scale,\n        y: (cy - sy) / scale\n      };\n    }\n\n    function getScale() {\n      return (SVG_W - 2 * PADDING) / (2 * GRID_RANGE);\n    }\n\n    // ---- State ----\n    let ptA = { x: -3, y: 1 };\n    let ptB = { x: 3, y: 5 };\n\n    // ---- Build grid and axes (once) ----\n    function buildGridAndAxes() {\n      const gridGroup = document.getElementById('gridGroup');\n      const axesGroup = document.getElementById('axesGroup');\n      gridGroup.innerHTML = '';\n      axesGroup.innerHTML = '';\n\n      const ns = 'http://www.w3.org/2000/svg';\n\n      // Grid lines\n      for (let i = -GRID_RANGE; i <= GRID_RANGE; i++) {\n        if (i === 0) continue;\n        const isMajor = (i % 2 === 0);\n        // Vertical\n        const vx = toSvg(i, 0).x;\n        const vLine = document.createElementNS(ns, 'line');\n        vLine.setAttribute('x1', vx); vLine.setAttribute('y1', toSvg(0, GRID_RANGE).y);\n        vLine.setAttribute('x2', vx); vLine.setAttribute('y2', toSvg(0, -GRID_RANGE).y);\n        vLine.setAttribute('class', isMajor ? 'grid-line-major' : 'grid-line');\n        gridGroup.appendChild(vLine);\n        // Horizontal\n        const hy = toSvg(0, i).y;\n        const hLine = document.createElementNS(ns, 'line');\n        hLine.setAttribute('x1', toSvg(-GRID_RANGE, 0).x); hLine.setAttribute('y1', hy);\n        hLine.setAttribute('x2', toSvg(GRID_RANGE, 0).x);  hLine.setAttribute('y2', hy);\n        hLine.setAttribute('class', isMajor ? 'grid-line-major' : 'grid-line');\n        gridGroup.appendChild(hLine);\n      }\n\n      // Tick labels\n      for (let i = -GRID_RANGE; i <= GRID_RANGE; i++) {\n        if (i === 0) continue;\n        if (i % 2 !== 0) continue; // only even labels\n        // x-axis labels\n        const xPos = toSvg(i, 0);\n        const xt = document.createElementNS(ns, 'text');\n        xt.setAttribute('x', xPos.x);\n        xt.setAttribute('y', xPos.y + 16);\n        xt.setAttribute('text-anchor', 'middle');\n        xt.setAttribute('class', 'axis-label');\n        xt.textContent = i;\n        axesGroup.appendChild(xt);\n        // y-axis labels\n        const yPos = toSvg(0, i);\n        const yt = document.createElementNS(ns, 'text');\n        yt.setAttribute('x', yPos.x - 14);\n        yt.setAttribute('y', yPos.y + 4);\n        yt.setAttribute('text-anchor', 'end');\n        yt.setAttribute('class', 'axis-label');\n        yt.textContent = i;\n        axesGroup.appendChild(yt);\n      }\n\n      // Axes\n      const xAxis = document.createElementNS(ns, 'line');\n      xAxis.setAttribute('x1', toSvg(-GRID_RANGE - 0.5, 0).x);\n      xAxis.setAttribute('y1', toSvg(0, 0).y);\n      xAxis.setAttribute('x2', toSvg(GRID_RANGE + 0.5, 0).x);\n      xAxis.setAttribute('y2', toSvg(0, 0).y);\n      xAxis.setAttribute('class', 'axis-line');\n      axesGroup.appendChild(xAxis);\n\n      const yAxis = document.createElementNS(ns, 'line');\n      yAxis.setAttribute('x1', toSvg(0, 0).x);\n      yAxis.setAttribute('y1', toSvg(0, GRID_RANGE + 0.5).y);\n      yAxis.setAttribute('x2', toSvg(0, 0).x);\n      yAxis.setAttribute('y2', toSvg(0, -GRID_RANGE - 0.5).y);\n      yAxis.setAttribute('class', 'axis-line');\n      axesGroup.appendChild(yAxis);\n\n      // Axis arrows\n      function arrowHead(x1,y1,x2,y2) {\n        const angle = Math.atan2(y2-y1, x2-x1);\n        const s = 8;\n        const p1x = x2 - s*Math.cos(angle-0.4);\n        const p1y = y2 - s*Math.sin(angle-0.4);\n        const p2x = x2 - s*Math.cos(angle+0.4);\n        const p2y = y2 - s*Math.sin(angle+0.4);\n        const poly = document.createElementNS(ns, 'polygon');\n        poly.setAttribute('points', `${x2},${y2} ${p1x},${p1y} ${p2x},${p2y}`);\n        poly.setAttribute('fill', '#374151');\n        return poly;\n      }\n      axesGroup.appendChild(arrowHead(toSvg(-GRID_RANGE,0).x, toSvg(0,0).y, toSvg(GRID_RANGE+0.5,0).x, toSvg(0,0).y));\n      axesGroup.appendChild(arrowHead(toSvg(0,-GRID_RANGE).x, toSvg(0,-GRID_RANGE).y, toSvg(0,0).x, toSvg(0,GRID_RANGE+0.5).y));\n\n      // Axis labels\n      const xlbl = document.createElementNS(ns, 'text');\n      xlbl.setAttribute('x', toSvg(GRID_RANGE + 0.3, 0).x + 8);\n      xlbl.setAttribute('y', toSvg(0, 0).y + 5);\n      xlbl.setAttribute('class', 'label-text');\n      xlbl.setAttribute('fill', '#374151');\n      xlbl.textContent = 'x';\n      axesGroup.appendChild(xlbl);\n\n      const ylbl = document.createElementNS(ns, 'text');\n      ylbl.setAttribute('x', toSvg(0, 0).x + 6);\n      ylbl.setAttribute('y', toSvg(0, GRID_RANGE + 0.5).y - 4);\n      ylbl.setAttribute('class', 'label-text');\n      ylbl.setAttribute('fill', '#374151');\n      ylbl.textContent = 'y';\n      axesGroup.appendChild(ylbl);\n\n      // Origin label\n      const origin = document.createElementNS(ns, 'text');\n      origin.setAttribute('x', toSvg(0, 0).x - 14);\n      origin.setAttribute('y', toSvg(0, 0).y + 16);\n      origin.setAttribute('text-anchor', 'middle');\n      origin.setAttribute('class', 'axis-label');\n      origin.textContent = '0';\n      axesGroup.appendChild(origin);\n    }\n\n    // ---- Render dynamic elements ----\n    function render() {\n      const ns = 'http://www.w3.org/2000/svg';\n      const sA = toSvg(ptA.x, ptA.y);\n      const sB = toSvg(ptB.x, ptB.y);\n      const sC = toSvg(ptB.x, ptA.y); // right-angle corner\n\n      const mx = (ptA.x + ptB.x) / 2;\n      const my = (ptA.y + ptB.y) / 2;\n      const sM = toSvg(mx, my);\n\n      // --- Triangle group ---\n      const tg = document.getElementById('triangleGroup');\n      tg.innerHTML = '';\n\n      // Only draw if not same point\n      const dx = ptB.x - ptA.x;\n      const dy = ptB.y - ptA.y;\n\n      if (Math.abs(dx) > 0.01 && Math.abs(dy) > 0.01) {\n        // Δx leg (horizontal)\n        const leg1 = document.createElementNS(ns, 'line');\n        leg1.setAttribute('x1', sA.x); leg1.setAttribute('y1', sA.y);\n        leg1.setAttribute('x2', sC.x); leg1.setAttribute('y2', sC.y);\n        leg1.setAttribute('class', 'triangle-leg');\n        tg.appendChild(leg1);\n\n        // Δy leg (vertical)\n        const leg2 = document.createElementNS(ns, 'line');\n        leg2.setAttribute('x1', sC.x); leg2.setAttribute('y1', sC.y);\n        leg2.setAttribute('x2', sB.x); leg2.setAttribute('y2', sB.y);\n        leg2.setAttribute('class', 'triangle-leg');\n        tg.appendChild(leg2);\n\n        // Right angle marker\n        const sc = getScale();\n        const size = 10;\n        const signX = dx > 0 ? 1 : -1;\n        const signY = dy > 0 ? 1 : -1;\n        const rmPath = document.createElementNS(ns, 'path');\n        rmPath.setAttribute('d',\n          `M ${sC.x - signX * size} ${sC.y} L ${sC.x - signX * size} ${sC.y + signY * size} L ${sC.x} ${sC.y + signY * size}`\n        );\n        rmPath.setAttribute('fill', 'none');\n        rmPath.setAttribute('stroke', '#b45309');\n        rmPath.setAttribute('stroke-width', '1.5');\n        tg.appendChild(rmPath);\n\n        // Δx label\n        const dxLabel = document.createElementNS(ns, 'text');\n        dxLabel.setAttribute('x', (sA.x + sC.x) / 2);\n        dxLabel.setAttribute('y', sA.y + (dy > 0 ? 16 : -8));\n        dxLabel.setAttribute('text-anchor', 'middle');\n        dxLabel.setAttribute('class', 'dim-label');\n        dxLabel.textContent = 'Δx = ' + fmt(dx);\n        tg.appendChild(dxLabel);\n\n        // Δy label\n        const dyLabel = document.createElementNS(ns, 'text');\n        dyLabel.setAttribute('x', sC.x + (dx > 0 ? 5 : -5));\n        dyLabel.setAttribute('y', (sC.y + sB.y) / 2 + 4);\n        dyLabel.setAttribute('text-anchor', dx > 0 ? 'start' : 'end');\n        dyLabel.setAttribute('class', 'dim-label');\n        dyLabel.textContent = 'Δy = ' + fmt(dy);\n        tg.appendChild(dyLabel);\n      }\n\n      // --- Segment group ---\n      const sg = document.getElementById('segmentGroup');\n      sg.innerHTML = '';\n      const seg = document.createElementNS(ns, 'line');\n      seg.setAttribute('x1', sA.x); seg.setAttribute('y1', sA.y);\n      seg.setAttribute('x2', sB.x); seg.setAttribute('y2', sB.y);\n      seg.setAttribute('class', 'segment-line');\n      sg.appendChild(seg);\n\n      // --- Midpoint group ---\n      const mg = document.getElementById('midpointGroup');\n      mg.innerHTML = '';\n      const mCircle = document.createElementNS(ns, 'circle');\n      mCircle.setAttribute('cx', sM.x);\n      mCircle.setAttribute('cy', sM.y);\n      mCircle.setAttribute('r', 6);\n      mCircle.setAttribute('class', 'midpoint-marker');\n      mg.appendChild(mCircle);\n\n      const mLabel = document.createElementNS(ns, 'text');\n      mLabel.setAttribute('x', sM.x + 10);\n      mLabel.setAttribute('y', sM.y - 8);\n      mLabel.setAttribute('class', 'label-text');\n      mLabel.setAttribute('fill', '#059669');\n      mLabel.textContent = 'M';\n      mg.appendChild(mLabel);\n\n      // Midpoint coord label\n      const mCoordLabel = document.createElementNS(ns, 'text');\n      mCoordLabel.setAttribute('x', sM.x + 10);\n      mCoordLabel.setAttribute('y', sM.y + 6);\n      mCoordLabel.setAttribute('class', 'axis-label');\n      mCoordLabel.setAttribute('fill', '#059669');\n      mCoordLabel.textContent = '(' + fmt(mx) + ', ' + fmt(my) + ')';\n      mg.appendChild(mCoordLabel);\n\n      // --- Points group ---\n      const pg = document.getElementById('pointsGroup');\n      pg.innerHTML = '';\n\n      const circA = document.createElementNS(ns, 'circle');\n      circA.setAttribute('cx', sA.x); circA.setAttribute('cy', sA.y);\n      circA.setAttribute('r', 9); circA.setAttribute('class', 'point-a point-handle');\n      circA.dataset.point = 'A';\n      pg.appendChild(circA);\n\n      const circB = document.createElementNS(ns, 'circle');\n      circB.setAttribute('cx', sB.x); circB.setAttribute('cy', sB.y);\n      circB.setAttribute('r', 9); circB.setAttribute('class', 'point-b point-handle');\n      circB.dataset.point = 'B';\n      pg.appendChild(circB);\n\n      // --- Labels group ---\n      const lg = document.getElementById('labelsGroup');\n      lg.innerHTML = '';\n\n      function labelOffset(sx, sy) {\n        // offset label away from center\n        const cx = SVG_W / 2, cy = SVG_H / 2;\n        const ox = sx < cx ? -22 : 14;\n        const oy = sy < cy ? -14 : 18;\n        return { ox, oy };\n      }\n\n      const offA = labelOffset(sA.x, sA.y);\n      const labA = document.createElementNS(ns, 'text');\n      labA.setAttribute('x', sA.x + offA.ox);\n      labA.setAttribute('y', sA.y + offA.oy);\n      labA.setAttribute('class', 'label-text');\n      labA.setAttribute('fill', '#dc2626');\n      labA.textContent = `A(${fmt(ptA.x)}, ${fmt(ptA.y)})`;\n      lg.appendChild(labA);\n\n      const offB = labelOffset(sB.x, sB.y);\n      const labB = document.createElementNS(ns, 'text');\n      labB.setAttribute('x', sB.x + offB.ox);\n      labB.setAttribute('y', sB.y + offB.oy);\n      labB.setAttribute('class', 'label-text');\n      labB.setAttribute('fill', '#4f46e5');\n      labB.textContent = `B(${fmt(ptB.x)}, ${fmt(ptB.y)})`;\n      lg.appendChild(labB);\n\n      // ---- Update calculations ----\n      updateCalcs(dx, dy);\n    }\n\n    function fmt(v) {\n      // Round to 4 decimals, then trim trailing zeros\n      const r = Math.round(v * 10000) / 10000;\n      if (Number.isInteger(r)) return r.toString();\n      return r.toString();\n    }\n\n    function fmtFrac(num, den) {\n      // Returns a nice fraction string or decimal\n      if (den === 0) return 'udefinert';\n      const v = num / den;\n      // Try to show as fraction if small integers\n      const gcd = (a, b) => b === 0 ? a : gcd(b, a % b);\n      const n = Math.round(num * 100), d = Math.round(den * 100);\n      if (Number.isInteger(num) && Number.isInteger(den)) {\n        const g = gcd(Math.abs(num), Math.abs(den));\n        const sn = num / g, sd = den / g;\n        if (sd === 1) return sn.toString();\n        return `${sn}/${sd}`;\n      }\n      return fmt(v);\n    }\n\n    function updateCalcs(dx, dy) {\n      const dist = Math.sqrt(dx * dx + dy * dy);\n\n      // ---- Avstand ----\n      const dxSq = dx * dx, dySq = dy * dy;\n      const dxFmt = fmt(dx), dyFmt = fmt(dy);\n      const dxSqFmt = fmt(dxSq), dySqFmt = fmt(dySq);\n      const sumSq = dxSq + dySq;\n\n      document.getElementById('distCalc').innerHTML =\n        `<p>Δx = x₂ − x₁ = ${fmt(ptB.x)} − (${fmt(ptA.x)}) = <strong>${dxFmt}</strong></p>\n         <p>Δy = y₂ − y₁ = ${fmt(ptB.y)} − (${fmt(ptA.y)}) = <strong>${dyFmt}</strong></p>\n         <p class=\"mt-1\">|AB| = √( (${dxFmt})² + (${dyFmt})² )</p>\n         <p>     = √( ${dxSqFmt} + ${dySqFmt} )</p>\n         <p>     = √${fmt(sumSq)}</p>`;\n\n      document.getElementById('distResult').innerHTML =\n        `<span class=\"font-bold text-emerald-800\">|AB| = √${fmt(sumSq)} ≈ ${fmt(Math.round(dist * 1000) / 1000)}</span>`;\n\n      // ---- Midtpunkt ----\n      const mx = (ptA.x + ptB.x) / 2;\n      const my = (ptA.y + ptB.y) / 2;\n\n      document.getElementById('midCalc').innerHTML =\n        `<p>x<sub>M</sub> = (x₁ + x₂) / 2 = (${fmt(ptA.x)} + ${fmt(ptB.x)}) / 2 = ${fmt(ptA.x + ptB.x)} / 2 = <strong>${fmt(mx)}</strong></p>\n         <p>y<sub>M</sub> = (y₁ + y₂) / 2 = (${fmt(ptA.y)} + ${fmt(ptB.y)}) / 2 = ${fmt(ptA.y + ptB.y)} / 2 = <strong>${fmt(my)}</strong></p>`;\n\n      document.getElementById('midResult').innerHTML =\n        `<span class=\"font-bold text-emerald-800\">M = (${fmt(mx)}, ${fmt(my)})</span>`;\n\n      // ---- Stigningstall ----\n      const slopeDiv = document.getElementById('slopeCalc');\n      const slopeRes = document.getElementById('slopeResult');\n\n      if (Math.abs(dx) < 0.0001) {\n        slopeDiv.innerHTML =\n          `<p>Δx = ${fmt(dx)} ≈ 0 — linja er <strong>loddrett</strong></p>\n           <p>Stigningstallet er ikke definert for loddrette linjer.</p>`;\n        slopeRes.innerHTML = `<span class=\"font-bold text-indigo-800\">a er udefinert (loddrett linje)</span>`;\n      } else {\n        const slope = dy / dx;\n        const slopeFmt = fmt(Math.round(slope * 10000) / 10000);\n        slopeDiv.innerHTML =\n          `<p>Δy = y₂ − y₁ = ${fmt(ptB.y)} − (${fmt(ptA.y)}) = <strong>${dyFmt}</strong></p>\n           <p>Δx = x₂ − x₁ = ${fmt(ptB.x)} − (${fmt(ptA.x)}) = <strong>${dxFmt}</strong></p>\n           <p class=\"mt-1\">a = Δy / Δx = ${dyFmt} / ${dxFmt} = <strong>${slopeFmt}</strong></p>`;\n        let interp = '';\n        if (Math.abs(slope) < 0.0001) {\n          interp = 'Linja er horisontal (stigningstall = 0).';\n        } else if (slope > 0) {\n          interp = `Linja stiger med ${slopeFmt} enheter i y for hver enhet i x (positiv stigning).`;\n        } else {\n          interp = `Linja synker med ${fmt(Math.abs(slope))} enheter i y for hver enhet i x (negativ stigning).`;\n        }\n        slopeRes.innerHTML = `<span class=\"font-bold text-indigo-800\">a = ${slopeFmt}</span><span class=\"text-indigo-700 text-xs ml-2\">${interp}</span>`;\n      }\n    }\n\n    // ---- Drag handling ----\n    let dragging = null;\n    let dragOffX = 0, dragOffY = 0;\n\n    function getSvgPoint(e) {\n      const svg = document.getElementById('coordSvg');\n      const rect = svg.getBoundingClientRect();\n      let clientX, clientY;\n      if (e.touches) {\n        clientX = e.touches[0].clientX;\n        clientY = e.touches[0].clientY;\n      } else {\n        clientX = e.clientX;\n        clientY = e.clientY;\n      }\n      const scaleX = SVG_W / rect.width;\n      const scaleY = SVG_H / rect.height;\n      return {\n        x: (clientX - rect.left) * scaleX,\n        y: (clientY - rect.top) * scaleY\n      };\n    }\n\n    function snapToHalf(v) {\n      return Math.round(v * 2) / 2;\n    }\n\n    function clamp(v, lo, hi) {\n      return Math.max(lo, Math.min(hi, v));\n    }\n\n    document.getElementById('coordSvg').addEventListener('pointerdown', function(e) {\n      const target = e.target.closest('.point-handle');\n      if (!target) return;\n      dragging = target.dataset.point;\n      e.target.setPointerCapture(e.pointerId);\n      e.preventDefault();\n    });\n\n    document.getElementById('coordSvg').addEventListener('pointermove', function(e) {\n      if (!dragging) return;\n      e.preventDefault();\n      const sp = getSvgPoint(e);\n      const mp = toMath(sp.x, sp.y);\n      const cx = clamp(snapToHalf(mp.x), -GRID_RANGE, GRID_RANGE);\n      const cy = clamp(snapToHalf(mp.y), -GRID_RANGE, GRID_RANGE);\n      if (dragging === 'A') {\n        ptA = { x: cx, y: cy };\n        document.getElementById('ax').value = cx;\n        document.getElementById('ay').value = cy;\n      } else {\n        ptB = { x: cx, y: cy };\n        document.getElementById('bx').value = cx;\n        document.getElementById('by').value = cy;\n      }\n      render();\n    });\n\n    document.getElementById('coordSvg').addEventListener('pointerup', function(e) {\n      dragging = null;\n    });\n\n    // ---- Number input handling ----\n    function parseInput(id, fallback) {\n      const v = parseFloat(document.getElementById(id).value);\n      return isNaN(v) ? fallback : clamp(v, -GRID_RANGE, GRID_RANGE);\n    }\n\n    function onInputChange() {\n      ptA = {\n        x: parseInput('ax', ptA.x),\n        y: parseInput('ay', ptA.y)\n      };\n      ptB = {\n        x: parseInput('bx', ptB.x),\n        y: parseInput('by', ptB.y)\n      };\n      // Sync inputs to clamped values\n      document.getElementById('ax').value = ptA.x;\n      document.getElementById('ay').value = ptA.y;\n      document.getElementById('bx').value = ptB.x;\n      document.getElementById('by').value = ptB.y;\n      render();\n    }\n\n    ['ax', 'ay', 'bx', 'by'].forEach(id => {\n      document.getElementById(id).addEventListener('input', onInputChange);\n      document.getElementById(id).addEventListener('change', onInputChange);\n    });\n\n    // ---- Init ----\n    buildGridAndAxes();\n    render();\n  })();\n  </script>\n\n</body>\n</html>\n",
  "packaging": {
    "appName": "Koordinatgeometri",
    "windowTitle": "Koordinatgeometri",
    "bundleId": "com.halisonworks.geokoordinat",
