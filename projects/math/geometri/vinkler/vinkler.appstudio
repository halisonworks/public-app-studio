{
  "schema": "app-studio/canvas@1",
  "id": "example-geo-vinkler",
  "name": "vinkler.html",
  "code": "<!DOCTYPE html>\n<!--\n  Vinkler — Halison App Studio-eksempel\n\n  Interaktivt læremiddel for geometri (matematikk 1P/2P, LK20): vinkeltyper,\n  vinkelsum i mangekanter, og vinkelpar (nabovinkler, toppvinkler).\n\n  Fra Halison App Studio sitt offentlige bibliotek:\n  https://github.com/halisonworks/public-app-studio\n\n  Tillatt bruk: personlig, pedagogisk og annen ikke-kommersiell bruk. Behold denne\n  headeren og kildelenken; ikke-kommersiell bruk. Utgitt under Halison App Studio\n  Examples License — se LICENSE-filen i repoet over.\n-->\n<html lang=\"no\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Vinkler – Interaktivt læremiddel</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Segoe UI', system-ui, sans-serif; }\n    .tab-btn { transition: background 0.15s, color 0.15s, border-color 0.15s; }\n    .tab-btn.active { background: #2563eb; color: #fff; border-color: #2563eb; }\n    .tab-panel { display: none; }\n    .tab-panel.active { display: block; }\n    svg text { user-select: none; }\n    input[type=range] { accent-color: #2563eb; }\n    .vinkel-label { font-size: 1.1rem; font-weight: 700; }\n    .angle-arc { fill: none; stroke-width: 2; }\n    .draggable-ray { cursor: grab; }\n    .draggable-ray:active { cursor: grabbing; }\n    .info-box { border-left: 4px solid #2563eb; background: #eff6ff; }\n    .triangle-input { width: 70px; }\n    @media (max-width: 640px) {\n      .triangle-input { width: 56px; }\n    }\n  </style>\n</head>\n<body class=\"bg-gray-50 min-h-screen\">\n\n  <!-- Header -->\n  <header class=\"bg-blue-700 text-white shadow-md\">\n    <div class=\"max-w-4xl mx-auto px-4 py-4 flex items-center gap-3\">\n      <svg width=\"36\" height=\"36\" viewBox=\"0 0 36 36\" class=\"flex-shrink-0\">\n        <polygon points=\"4,32 18,4 32,32\" fill=\"none\" stroke=\"white\" stroke-width=\"2.5\"/>\n        <path d=\"M4,32 Q10,22 18,4\" fill=\"none\" stroke=\"#93c5fd\" stroke-width=\"1.5\"/>\n        <circle cx=\"4\" cy=\"32\" r=\"2.5\" fill=\"#fbbf24\"/>\n      </svg>\n      <div>\n        <h1 class=\"text-xl font-bold leading-tight\">Vinkler</h1>\n        <p class=\"text-blue-200 text-sm\">Matematikk 1P/2P – LK20</p>\n      </div>\n    </div>\n  </header>\n\n  <!-- Tab bar -->\n  <nav class=\"bg-white border-b border-gray-200 sticky top-0 z-10 shadow-sm\">\n    <div class=\"max-w-4xl mx-auto px-4 flex gap-1 py-2 overflow-x-auto\">\n      <button class=\"tab-btn active px-4 py-2 rounded-lg border border-gray-200 text-sm font-semibold whitespace-nowrap\" data-tab=\"vinkeltyper\">\n        1. Vinkeltyper\n      </button>\n      <button class=\"tab-btn px-4 py-2 rounded-lg border border-gray-200 text-sm font-semibold whitespace-nowrap\" data-tab=\"vinkelsum\">\n        2. Vinkelsum\n      </button>\n      <button class=\"tab-btn px-4 py-2 rounded-lg border border-gray-200 text-sm font-semibold whitespace-nowrap\" data-tab=\"vinkelpar\">\n        3. Vinkelpar\n      </button>\n    </div>\n  </nav>\n\n  <main class=\"max-w-4xl mx-auto px-4 py-6 space-y-6\">\n\n    <!-- ============================================================\n         TAB 1: Vinkeltyper\n    ============================================================ -->\n    <section id=\"tab-vinkeltyper\" class=\"tab-panel active space-y-6\">\n\n      <div class=\"bg-white rounded-2xl shadow p-5\">\n        <h2 class=\"text-lg font-bold text-gray-800 mb-1\">Interaktiv vinkel</h2>\n        <p class=\"text-gray-500 text-sm mb-4\">\n          Dra strålen eller bruk glidebryteren for å endre vinkelen. Se hva slags vinkel det er!\n        </p>\n\n        <!-- SVG canvas for draggable angle -->\n        <div class=\"flex flex-col items-center gap-4\">\n          <svg id=\"angleSvg\" width=\"300\" height=\"300\" viewBox=\"0 0 300 300\"\n               class=\"rounded-xl border border-gray-100 bg-blue-50 touch-none select-none\"\n               style=\"max-width:100%\">\n\n            <!-- Fixed ray: along positive x-axis -->\n            <line id=\"fixedRay\" x1=\"150\" y1=\"150\" x2=\"280\" y2=\"150\"\n                  stroke=\"#64748b\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n            <!-- Arrowhead for fixed ray -->\n            <polygon id=\"fixedArrow\" points=\"280,150 271,145 271,155\"\n                     fill=\"#64748b\"/>\n\n            <!-- Moving ray (draggable) -->\n            <line id=\"movingRay\" x1=\"150\" y1=\"150\" x2=\"280\" y2=\"150\"\n                  stroke=\"#2563eb\" stroke-width=\"2.5\" stroke-linecap=\"round\"\n                  class=\"draggable-ray\"/>\n            <!-- Arrowhead for moving ray -->\n            <polygon id=\"movingArrow\" points=\"280,150 271,145 271,155\"\n                     fill=\"#2563eb\"/>\n\n            <!-- Arc showing the angle -->\n            <path id=\"angleArc\" d=\"\" class=\"angle-arc\" stroke=\"#f59e0b\" stroke-width=\"2.5\"/>\n            <!-- Filled arc area -->\n            <path id=\"angleArcFill\" d=\"\" fill=\"rgba(251,191,36,0.15)\"/>\n\n            <!-- Vertex dot -->\n            <circle cx=\"150\" cy=\"150\" r=\"5\" fill=\"#1e40af\"/>\n\n            <!-- Angle label -->\n            <text id=\"angleText\" x=\"150\" y=\"150\" text-anchor=\"middle\"\n                  class=\"vinkel-label\" fill=\"#1e40af\" font-size=\"18\"></text>\n\n            <!-- Drag hint -->\n            <text x=\"150\" y=\"288\" text-anchor=\"middle\" fill=\"#94a3b8\" font-size=\"11\">\n              Dra den blå strålen\n            </text>\n          </svg>\n\n          <!-- Slider -->\n          <div class=\"w-full max-w-xs flex items-center gap-3\">\n            <span class=\"text-xs text-gray-400 w-6\">0°</span>\n            <input type=\"range\" id=\"angleSlider\" min=\"0\" max=\"360\" value=\"45\"\n                   class=\"flex-1 h-2 rounded-full\"/>\n            <span class=\"text-xs text-gray-400 w-8 text-right\">360°</span>\n          </div>\n\n          <!-- Classification badge -->\n          <div id=\"classificationBox\"\n               class=\"w-full max-w-xs rounded-xl px-5 py-3 text-center bg-yellow-50 border border-yellow-200\">\n            <div id=\"classificationName\" class=\"text-lg font-bold text-blue-700\"></div>\n            <div id=\"classificationDesc\" class=\"text-sm text-gray-600 mt-1\"></div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Reference card -->\n      <div class=\"bg-white rounded-2xl shadow p-5\">\n        <h2 class=\"text-lg font-bold text-gray-800 mb-3\">Oversikt over vinkeltyper</h2>\n        <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n\n          <!-- Spiss vinkel -->\n          <div class=\"rounded-xl border border-gray-100 p-4 flex gap-3 items-start\">\n            <svg width=\"64\" height=\"64\" viewBox=\"0 0 64 64\" class=\"flex-shrink-0\">\n              <line x1=\"8\" y1=\"56\" x2=\"56\" y2=\"56\" stroke=\"#64748b\" stroke-width=\"2\"/>\n              <line x1=\"8\" y1=\"56\" x2=\"44\" y2=\"16\" stroke=\"#2563eb\" stroke-width=\"2\"/>\n              <path d=\"M22,56 A14,14 0 0,0 17.2,43.6\" fill=\"rgba(251,191,36,0.25)\" stroke=\"#f59e0b\" stroke-width=\"1.5\"/>\n              <text x=\"26\" y=\"54\" fill=\"#1e40af\" font-size=\"11\" font-weight=\"bold\">~45°</text>\n            </svg>\n            <div>\n              <div class=\"font-bold text-gray-800\">Spiss vinkel</div>\n              <div class=\"text-sm text-gray-500\">Større enn 0° og <strong>mindre enn 90°</strong></div>\n            </div>\n          </div>\n\n          <!-- Rett vinkel -->\n          <div class=\"rounded-xl border border-gray-100 p-4 flex gap-3 items-start\">\n            <svg width=\"64\" height=\"64\" viewBox=\"0 0 64 64\" class=\"flex-shrink-0\">\n              <line x1=\"8\" y1=\"56\" x2=\"56\" y2=\"56\" stroke=\"#64748b\" stroke-width=\"2\"/>\n              <line x1=\"8\" y1=\"56\" x2=\"8\" y2=\"8\" stroke=\"#2563eb\" stroke-width=\"2\"/>\n              <rect x=\"8\" y=\"44\" width=\"12\" height=\"12\" fill=\"rgba(251,191,36,0.25)\" stroke=\"#f59e0b\" stroke-width=\"1.5\"/>\n            </svg>\n            <div>\n              <div class=\"font-bold text-gray-800\">Rett vinkel</div>\n              <div class=\"text-sm text-gray-500\">Nøyaktig <strong>90°</strong></div>\n            </div>\n          </div>\n\n          <!-- Stump vinkel -->\n          <div class=\"rounded-xl border border-gray-100 p-4 flex gap-3 items-start\">\n            <svg width=\"64\" height=\"64\" viewBox=\"0 0 64 64\" class=\"flex-shrink-0\">\n              <line x1=\"8\" y1=\"40\" x2=\"56\" y2=\"40\" stroke=\"#64748b\" stroke-width=\"2\"/>\n              <line x1=\"8\" y1=\"40\" x2=\"42\" y2=\"10\" stroke=\"#2563eb\" stroke-width=\"2\"/>\n              <path d=\"M26,40 A18,18 0 0,0 16.5,26.5\" fill=\"rgba(251,191,36,0.25)\" stroke=\"#f59e0b\" stroke-width=\"1.5\"/>\n              <text x=\"28\" y=\"38\" fill=\"#1e40af\" font-size=\"11\" font-weight=\"bold\">~130°</text>\n            </svg>\n            <div>\n              <div class=\"font-bold text-gray-800\">Stump vinkel</div>\n              <div class=\"text-sm text-gray-500\">Større enn 90° og <strong>mindre enn 180°</strong></div>\n            </div>\n          </div>\n\n          <!-- Rettlinjet vinkel -->\n          <div class=\"rounded-xl border border-gray-100 p-4 flex gap-3 items-start\">\n            <svg width=\"64\" height=\"64\" viewBox=\"0 0 64 64\" class=\"flex-shrink-0\">\n              <line x1=\"4\" y1=\"40\" x2=\"60\" y2=\"40\" stroke=\"#64748b\" stroke-width=\"2\"/>\n              <line x1=\"32\" y1=\"40\" x2=\"32\" y2=\"8\" stroke=\"#2563eb\" stroke-width=\"2\" stroke-dasharray=\"3,2\"/>\n              <path d=\"M44,40 A12,12 0 0,0 20,40\" fill=\"rgba(251,191,36,0.25)\" stroke=\"#f59e0b\" stroke-width=\"1.5\"/>\n              <text x=\"32\" y=\"28\" fill=\"#1e40af\" font-size=\"11\" font-weight=\"bold\" text-anchor=\"middle\">180°</text>\n            </svg>\n            <div>\n              <div class=\"font-bold text-gray-800\">Rettlinjet vinkel</div>\n              <div class=\"text-sm text-gray-500\">Nøyaktig <strong>180°</strong> — en rett linje</div>\n            </div>\n          </div>\n\n          <!-- Refleksvinkel -->\n          <div class=\"rounded-xl border border-gray-100 p-4 flex gap-3 items-start sm:col-span-2\">\n            <svg width=\"64\" height=\"64\" viewBox=\"0 0 64 64\" class=\"flex-shrink-0\">\n              <line x1=\"32\" y1=\"32\" x2=\"58\" y2=\"32\" stroke=\"#64748b\" stroke-width=\"2\"/>\n              <line x1=\"32\" y1=\"32\" x2=\"58\" y2=\"42\" stroke=\"#2563eb\" stroke-width=\"2\"/>\n              <path d=\"M50,32 A18,18 0 1,1 50.3,42.6\" fill=\"rgba(251,191,36,0.15)\" stroke=\"#f59e0b\" stroke-width=\"1.5\"/>\n              <text x=\"18\" y=\"22\" fill=\"#1e40af\" font-size=\"10\" font-weight=\"bold\">~270°</text>\n            </svg>\n            <div>\n              <div class=\"font-bold text-gray-800\">Refleksvinkel</div>\n              <div class=\"text-sm text-gray-500\">Større enn 180° og <strong>mindre enn 360°</strong></div>\n            </div>\n          </div>\n\n        </div>\n      </div>\n    </section>\n\n    <!-- ============================================================\n         TAB 2: Vinkelsum\n    ============================================================ -->\n    <section id=\"tab-vinkelsum\" class=\"tab-panel space-y-6\">\n\n      <!-- Triangle interactive -->\n      <div class=\"bg-white rounded-2xl shadow p-5\">\n        <h2 class=\"text-lg font-bold text-gray-800 mb-1\">Vinkelsum i trekant = 180°</h2>\n        <p class=\"text-gray-500 text-sm mb-4\">\n          Skriv inn to av vinklene i trekanten. Den tredje regnes ut automatisk.\n        </p>\n        <div class=\"flex flex-wrap gap-3 items-end mb-4\">\n          <div class=\"flex flex-col gap-1\">\n            <label class=\"text-xs font-semibold text-gray-500 uppercase tracking-wide\">Vinkel A</label>\n            <div class=\"flex items-center gap-1\">\n              <input type=\"number\" id=\"triA\" min=\"1\" max=\"178\" value=\"60\"\n                     class=\"triangle-input border border-gray-300 rounded-lg px-2 py-2 text-center text-base font-bold focus:outline-none focus:ring-2 focus:ring-blue-400\"/>\n              <span class=\"text-gray-500\">°</span>\n            </div>\n          </div>\n          <div class=\"flex flex-col gap-1\">\n            <label class=\"text-xs font-semibold text-gray-500 uppercase tracking-wide\">Vinkel B</label>\n            <div class=\"flex items-center gap-1\">\n              <input type=\"number\" id=\"triB\" min=\"1\" max=\"178\" value=\"60\"\n                     class=\"triangle-input border border-gray-300 rounded-lg px-2 py-2 text-center text-base font-bold focus:outline-none focus:ring-2 focus:ring-blue-400\"/>\n              <span class=\"text-gray-500\">°</span>\n            </div>\n          </div>\n          <div class=\"flex flex-col gap-1\">\n            <label class=\"text-xs font-semibold text-gray-500 uppercase tracking-wide\">Vinkel C</label>\n            <div class=\"flex items-center gap-1\">\n              <div id=\"triC\"\n                   class=\"triangle-input border-2 border-blue-400 bg-blue-50 rounded-lg px-2 py-2 text-center text-base font-bold text-blue-700\">\n                60\n              </div>\n              <span class=\"text-gray-500\">°</span>\n            </div>\n          </div>\n          <div id=\"triError\" class=\"text-sm text-red-600 font-semibold hidden\">\n            ⚠ Ugyldig (sum &gt; 180°)\n          </div>\n        </div>\n\n        <!-- Triangle SVG -->\n        <div class=\"flex justify-center\">\n          <svg id=\"triangleSvg\" width=\"300\" height=\"220\" viewBox=\"0 0 300 220\"\n               class=\"rounded-xl bg-blue-50 border border-gray-100\" style=\"max-width:100%\">\n            <!-- triangle drawn by JS -->\n          </svg>\n        </div>\n\n        <div class=\"info-box rounded-lg px-4 py-3 mt-4 text-sm text-gray-700\">\n          <strong>Regel:</strong> Summen av de tre indre vinklene i en trekant er alltid\n          <strong>180°</strong>: A + B + C = 180°.\n        </div>\n      </div>\n\n      <!-- Polygon angle sum -->\n      <div class=\"bg-white rounded-2xl shadow p-5\">\n        <h2 class=\"text-lg font-bold text-gray-800 mb-1\">Vinkelsum i mangekanter</h2>\n        <p class=\"text-gray-500 text-sm mb-4\">\n          Velg antall sider (n) for å se vinkelsummen i mangekanten.\n        </p>\n\n        <div class=\"flex flex-wrap gap-4 items-center mb-4\">\n          <div class=\"flex items-center gap-3\">\n            <label class=\"text-sm font-semibold text-gray-600\" for=\"polySlider\">Antall sider (n):</label>\n            <input type=\"range\" id=\"polySlider\" min=\"3\" max=\"12\" value=\"4\"\n                   class=\"w-36 h-2 rounded-full\"/>\n            <span id=\"polyN\" class=\"text-lg font-bold text-blue-700 w-6\">4</span>\n          </div>\n        </div>\n\n        <div class=\"flex flex-col sm:flex-row gap-5 items-center\">\n          <svg id=\"polySvg\" width=\"220\" height=\"220\" viewBox=\"0 0 220 220\"\n               class=\"rounded-xl bg-blue-50 border border-gray-100 flex-shrink-0\" style=\"max-width:220px;\">\n          </svg>\n          <div class=\"flex-1 space-y-3\">\n            <div class=\"rounded-xl bg-blue-50 border border-blue-200 px-4 py-3\">\n              <div class=\"text-xs text-gray-500 uppercase tracking-wide font-semibold mb-1\">Formel</div>\n              <div class=\"text-base font-bold text-gray-800\" id=\"polyFormula\">(n − 2) · 180°</div>\n            </div>\n            <div class=\"rounded-xl bg-yellow-50 border border-yellow-200 px-4 py-3\">\n              <div class=\"text-xs text-gray-500 uppercase tracking-wide font-semibold mb-1\">Utregning</div>\n              <div class=\"text-base font-bold text-gray-800\" id=\"polyCalc\"></div>\n            </div>\n            <div class=\"rounded-xl bg-green-50 border border-green-200 px-4 py-3\">\n              <div class=\"text-xs text-gray-500 uppercase tracking-wide font-semibold mb-1\">Vinkelsum</div>\n              <div class=\"text-2xl font-extrabold text-green-700\" id=\"polyResult\"></div>\n            </div>\n            <div class=\"text-sm text-gray-500\" id=\"polyName\"></div>\n          </div>\n        </div>\n\n        <!-- Table -->\n        <div class=\"mt-5 overflow-x-auto\">\n          <table class=\"w-full text-sm border-collapse\">\n            <thead>\n              <tr class=\"bg-blue-700 text-white\">\n                <th class=\"px-3 py-2 text-left rounded-tl-lg\">Mangekant</th>\n                <th class=\"px-3 py-2 text-center\">Sider (n)</th>\n                <th class=\"px-3 py-2 text-center\">Formel</th>\n                <th class=\"px-3 py-2 text-right rounded-tr-lg\">Vinkelsum</th>\n              </tr>\n            </thead>\n            <tbody id=\"polyTable\">\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </section>\n\n    <!-- ============================================================\n         TAB 3: Vinkelpar\n    ============================================================ -->\n    <section id=\"tab-vinkelpar\" class=\"tab-panel space-y-6\">\n\n      <!-- Nabovinkel -->\n      <div class=\"bg-white rounded-2xl shadow p-5\">\n        <h2 class=\"text-lg font-bold text-gray-800 mb-1\">Nabovinkler (supplementære vinkler)</h2>\n        <p class=\"text-gray-500 text-sm mb-3\">\n          To vinkler er <strong>nabovinkler</strong> når de ligger ved siden av hverandre og\n          tilsammen utgjør en rett linje (180°). De kalles også <em>supplementære vinkler</em>.\n        </p>\n\n        <div class=\"flex flex-col sm:flex-row gap-5 items-center\">\n          <svg id=\"naboSvg\" width=\"240\" height=\"160\" viewBox=\"0 0 240 160\"\n               class=\"rounded-xl bg-blue-50 border border-gray-100 flex-shrink-0\" style=\"max-width:240px;\">\n          </svg>\n          <div class=\"flex-1 space-y-3\">\n            <div class=\"flex items-center gap-3\">\n              <label class=\"text-sm font-semibold text-gray-600 w-24\">Vinkel α:</label>\n              <input type=\"range\" id=\"naboSlider\" min=\"1\" max=\"179\" value=\"110\"\n                     class=\"flex-1 h-2 rounded-full\"/>\n              <span id=\"naboAlpha\" class=\"w-12 text-right font-bold text-blue-700\">110°</span>\n            </div>\n            <div class=\"rounded-xl bg-yellow-50 border border-yellow-200 px-4 py-3 text-sm\">\n              <span class=\"font-semibold\">β = 180° − α = </span>\n              <span id=\"naboBeta\" class=\"font-bold text-blue-700\">70°</span>\n            </div>\n            <div class=\"info-box rounded-lg px-4 py-2 text-sm text-gray-700\">\n              <strong>Regel:</strong> α + β = 180°\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Toppvinkler -->\n      <div class=\"bg-white rounded-2xl shadow p-5\">\n        <h2 class=\"text-lg font-bold text-gray-800 mb-1\">Toppvinkler</h2>\n        <p class=\"text-gray-500 text-sm mb-3\">\n          Når to linjer krysser hverandre, dannes fire vinkler. De <strong>motstående</strong>\n          (toppvinkler) er alltid like store.\n        </p>\n\n        <div class=\"flex flex-col sm:flex-row gap-5 items-center\">\n          <svg id=\"toppSvg\" width=\"240\" height=\"240\" viewBox=\"0 0 240 240\"\n               class=\"rounded-xl bg-blue-50 border border-gray-100 flex-shrink-0\" style=\"max-width:240px;\">\n          </svg>\n          <div class=\"flex-1 space-y-3\">\n            <div class=\"flex items-center gap-3\">\n              <label class=\"text-sm font-semibold text-gray-600 w-28\">Vinkel α:</label>\n              <input type=\"range\" id=\"toppSlider\" min=\"10\" max=\"170\" value=\"55\"\n                     class=\"flex-1 h-2 rounded-full\"/>\n              <span id=\"toppAlpha\" class=\"w-12 text-right font-bold text-blue-700\">55°</span>\n            </div>\n            <div class=\"grid grid-cols-2 gap-2 text-sm\">\n              <div class=\"rounded-lg bg-blue-50 border border-blue-200 px-3 py-2\">\n                <span class=\"font-semibold\">α = </span>\n                <span id=\"toppA\" class=\"font-bold text-blue-700\">55°</span>\n                <div class=\"text-xs text-gray-500 mt-0.5\">øverst/nedenfor</div>\n              </div>\n              <div class=\"rounded-lg bg-orange-50 border border-orange-200 px-3 py-2\">\n                <span class=\"font-semibold\">β = </span>\n                <span id=\"toppB\" class=\"font-bold text-orange-600\">125°</span>\n                <div class=\"text-xs text-gray-500 mt-0.5\">til siden</div>\n              </div>\n            </div>\n            <div class=\"info-box rounded-lg px-4 py-2 text-sm text-gray-700\">\n              <strong>Regel:</strong> Toppvinkler er like store. α = α, β = β, og α + β = 180°.\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Samsvarende vinkler -->\n      <div class=\"bg-white rounded-2xl shadow p-5\">\n        <h2 class=\"text-lg font-bold text-gray-800 mb-1\">Samsvarende vinkler ved parallelle linjer</h2>\n        <p class=\"text-gray-500 text-sm mb-3\">\n          Når en tverrlinje (transversal) krysser to parallelle linjer, er\n          <strong>samsvarende vinkler</strong> (F-vinkler) like store, og\n          <strong>kryss­vinkler</strong> (Z-vinkler) er like store.\n          <strong>Nabovinkler</strong> (medsidevinkler, U-vinkler) er supplementære (sum 180°).\n        </p>\n\n        <div class=\"flex flex-col sm:flex-row gap-5 items-center\">\n          <svg id=\"parallelSvg\" width=\"260\" height=\"240\" viewBox=\"0 0 260 240\"\n               class=\"rounded-xl bg-blue-50 border border-gray-100 flex-shrink-0\" style=\"max-width:260px;\">\n          </svg>\n          <div class=\"flex-1 space-y-3\">\n            <div class=\"flex items-center gap-3\">\n              <label class=\"text-sm font-semibold text-gray-600 w-28\">Tverrlinje-vinkel:</label>\n              <input type=\"range\" id=\"parallelSlider\" min=\"15\" max=\"165\" value=\"55\"\n                     class=\"flex-1 h-2 rounded-full\"/>\n              <span id=\"parallelAlpha\" class=\"w-12 text-right font-bold text-blue-700\">55°</span>\n            </div>\n            <div class=\"space-y-2 text-sm\">\n              <div class=\"rounded-lg bg-blue-50 border border-blue-200 px-3 py-2 flex justify-between\">\n                <span>Samsvarende vinkler (F):</span>\n                <span id=\"pSamsvare\" class=\"font-bold text-blue-700\">55°</span>\n              </div>\n              <div class=\"rounded-lg bg-green-50 border border-green-200 px-3 py-2 flex justify-between\">\n                <span>Kryssvinkler (Z):</span>\n                <span id=\"pKryss\" class=\"font-bold text-green-700\">55°</span>\n              </div>\n              <div class=\"rounded-lg bg-orange-50 border border-orange-200 px-3 py-2 flex justify-between\">\n                <span>Medsidevinkler (U):</span>\n                <span id=\"pMedside\" class=\"font-bold text-orange-600\">125°</span>\n              </div>\n            </div>\n            <div class=\"info-box rounded-lg px-4 py-2 text-sm text-gray-700\">\n              <strong>Regler:</strong> Samsvarende = like. Kryssvinkler = like.\n              Medsidevinkler = supplementære (sum 180°).\n            </div>\n          </div>\n        </div>\n      </div>\n\n    </section>\n  </main>\n\n  <footer class=\"max-w-4xl mx-auto px-4 py-6 text-center text-xs text-gray-400 mt-4\">\n    Halison App Studio · Offentlig bibliotek ·\n    <a href=\"https://github.com/halisonworks/public-app-studio\"\n       class=\"underline hover:text-gray-600\" target=\"_blank\" rel=\"noopener\">\n      github.com/halisonworks/public-app-studio\n    </a>\n  </footer>\n\n<script>\n(function () {\n  'use strict';\n\n  /* ============================================================\n     UTILITIES\n  ============================================================ */\n  function deg2rad(d) { return d * Math.PI / 180; }\n  function rad2deg(r) { return r * 180 / Math.PI; }\n  function clamp(v, lo, hi) { return Math.max(lo, Math.min(hi, v)); }\n\n  // Polar coords (angle measured counter-clockwise from positive x, but we\n  // want clockwise from positive x for standard mathematical display)\n  // SVG y-axis is flipped, so clockwise visually = negative angle in math.\n  function polarPoint(cx, cy, r, angleDeg) {\n    var rad = deg2rad(angleDeg);\n    return { x: cx + r * Math.cos(rad), y: cy - r * Math.sin(rad) };\n  }\n\n  /* ============================================================\n     TABS\n  ============================================================ */\n  var tabBtns = document.querySelectorAll('.tab-btn');\n  var tabPanels = document.querySelectorAll('.tab-panel');\n\n  tabBtns.forEach(function (btn) {\n    btn.addEventListener('click', function () {\n      tabBtns.forEach(function (b) { b.classList.remove('active'); });\n      tabPanels.forEach(function (p) { p.classList.remove('active'); });\n      btn.classList.add('active');\n      var panelId = 'tab-' + btn.dataset.tab;\n      document.getElementById(panelId).classList.add('active');\n    });\n  });\n\n  /* ============================================================\n     TAB 1: VINKELTYPER — Interactive angle\n  ============================================================ */\n  var angleSvg = document.getElementById('angleSvg');\n  var movingRay = document.getElementById('movingRay');\n  var movingArrow = document.getElementById('movingArrow');\n  var angleArc = document.getElementById('angleArc');\n  var angleArcFill = document.getElementById('angleArcFill');\n  var angleText = document.getElementById('angleText');\n  var angleSlider = document.getElementById('angleSlider');\n  var classificationName = document.getElementById('classificationName');\n  var classificationDesc = document.getElementById('classificationDesc');\n  var classificationBox = document.getElementById('classificationBox');\n\n  var CX = 150, CY = 150, RAY_LEN = 120;\n\n  function classifyAngle(deg) {\n    if (deg === 0 || deg === 360) return { name: 'Nullvinkel', desc: 'Vinkelen er 0° – strålen peker i samme retning', color: 'gray' };\n    if (deg < 90) return { name: 'Spiss vinkel', desc: 'Mellom 0° og 90°', color: 'green' };\n    if (deg === 90) return { name: 'Rett vinkel', desc: 'Nøyaktig 90°', color: 'blue' };\n    if (deg < 180) return { name: 'Stump vinkel', desc: 'Mellom 90° og 180°', color: 'orange' };\n    if (deg === 180) return { name: 'Rettlinjet vinkel', desc: 'Nøyaktig 180° – en rett linje', color: 'purple' };\n    return { name: 'Refleksvinkel', desc: 'Mellom 180° og 360°', color: 'red' };\n  }\n\n  var colorMap = {\n    green:  { box: 'bg-green-50 border-green-200',  name: 'text-green-700' },\n    blue:   { box: 'bg-blue-50 border-blue-200',    name: 'text-blue-700' },\n    orange: { box: 'bg-orange-50 border-orange-200',name: 'text-orange-600' },\n    purple: { box: 'bg-purple-50 border-purple-200',name: 'text-purple-700' },\n    red:    { box: 'bg-red-50 border-red-200',      name: 'text-red-600' },\n    gray:   { box: 'bg-gray-50 border-gray-200',    name: 'text-gray-600' }\n  };\n\n  // Describe arc SVG path for angle 0..360 from fixedRay (pointing right, 0°)\n  // We draw counter-clockwise in SVG space (which is clockwise in standard math\n  // because SVG y-axis is inverted).\n  function arcPath(angleDeg, radius) {\n    // Start: fixed ray direction (0° = right = east)\n    var sx = CX + radius;\n    var sy = CY;\n    if (angleDeg <= 0) return '';\n    if (angleDeg >= 360) {\n      // full circle\n      return 'M ' + (CX + radius) + ' ' + CY +\n             ' A ' + radius + ' ' + radius + ' 0 1 0 ' + (CX + radius - 0.001) + ' ' + CY + ' Z';\n    }\n    var end = polarPoint(CX, CY, radius, angleDeg);\n    var largeArc = angleDeg > 180 ? 1 : 0;\n    // SVG arc sweep-flag=0 is counter-clockwise, but because y is flipped\n    // sweep=0 draws clockwise visually (which is what we want for standard angle display)\n    return 'M ' + sx + ' ' + sy +\n           ' A ' + radius + ' ' + radius + ' 0 ' + largeArc + ' 0 ' + end.x + ' ' + end.y;\n  }\n\n  function arcFillPath(angleDeg, radius) {\n    if (angleDeg <= 0) return '';\n    if (angleDeg >= 360) {\n      return 'M ' + (CX + radius) + ' ' + CY +\n             ' A ' + radius + ' ' + radius + ' 0 1 0 ' + (CX + radius - 0.001) + ' ' + CY + ' Z';\n    }\n    var sx = CX + radius;\n    var sy = CY;\n    var end = polarPoint(CX, CY, radius, angleDeg);\n    var largeArc = angleDeg > 180 ? 1 : 0;\n    return 'M ' + CX + ' ' + CY +\n           ' L ' + sx + ' ' + sy +\n           ' A ' + radius + ' ' + radius + ' 0 ' + largeArc + ' 0 ' + end.x + ' ' + end.y +\n           ' Z';\n  }\n\n  function updateAngle(deg) {\n    deg = clamp(deg, 0, 360);\n    angleSlider.value = deg;\n\n    var end = polarPoint(CX, CY, RAY_LEN, deg);\n    movingRay.setAttribute('x2', end.x);\n    movingRay.setAttribute('y2', end.y);\n\n    // Arrow head for moving ray (small triangle at tip)\n    var dir = deg2rad(deg);\n    var ax = end.x, ay = end.y;\n    var perp1 = { x: ax - 10 * Math.cos(dir) + 5 * Math.sin(dir), y: ay + 10 * Math.sin(dir) + 5 * Math.cos(dir) };\n    var perp2 = { x: ax - 10 * Math.cos(dir) - 5 * Math.sin(dir), y: ay + 10 * Math.sin(dir) - 5 * Math.cos(dir) };\n    movingArrow.setAttribute('points', ax + ',' + ay + ' ' + perp1.x + ',' + perp1.y + ' ' + perp2.x + ',' + perp2.y);\n\n    var arcR = deg > 180 ? 40 : 50;\n    angleArc.setAttribute('d', arcPath(deg, arcR));\n    angleArcFill.setAttribute('d', arcFillPath(deg, arcR));\n\n    // Label position: midpoint of arc\n    var labelR = arcR + 18;\n    var midDeg = deg / 2;\n    var lp = polarPoint(CX, CY, labelR, midDeg);\n    // For large reflex angles, push label further out\n    if (deg > 270) { lp = polarPoint(CX, CY, labelR + 10, midDeg); }\n    angleText.setAttribute('x', lp.x);\n    angleText.setAttribute('y', lp.y + 6);\n    angleText.textContent = deg + '°';\n\n    var cls = classifyAngle(deg);\n    classificationName.textContent = cls.name;\n    classificationDesc.textContent = cls.desc;\n    var cm = colorMap[cls.color];\n    classificationBox.className = 'w-full max-w-xs rounded-xl px-5 py-3 text-center border ' + cm.box;\n    classificationName.className = 'text-lg font-bold ' + cm.name;\n  }\n\n  // Drag on SVG\n  var isDragging = false;\n\n  function svgPos(e, svgEl) {\n    var rect = svgEl.getBoundingClientRect();\n    var scaleX = 300 / rect.width;\n    var scaleY = 300 / rect.height;\n    var clientX = e.touches ? e.touches[0].clientX : e.clientX;\n    var clientY = e.touches ? e.touches[0].clientY : e.clientY;\n    return {\n      x: (clientX - rect.left) * scaleX,\n      y: (clientY - rect.top) * scaleY\n    };\n  }\n\n  function angleFromSvg(e) {\n    var p = svgPos(e, angleSvg);\n    var dx = p.x - CX, dy = -(p.y - CY); // flip y for standard math\n    var deg = rad2deg(Math.atan2(dy, dx));\n    if (deg < 0) deg += 360;\n    return Math.round(deg);\n  }\n\n  angleSvg.addEventListener('mousedown', function (e) {\n    isDragging = true;\n    updateAngle(angleFromSvg(e));\n    e.preventDefault();\n  });\n  window.addEventListener('mousemove', function (e) {\n    if (isDragging) updateAngle(angleFromSvg(e));\n  });\n  window.addEventListener('mouseup', function () { isDragging = false; });\n\n  angleSvg.addEventListener('touchstart', function (e) {\n    isDragging = true;\n    updateAngle(angleFromSvg(e));\n    e.preventDefault();\n  }, { passive: false });\n  window.addEventListener('touchmove', function (e) {\n    if (isDragging) updateAngle(angleFromSvg(e));\n  }, { passive: true });\n  window.addEventListener('touchend', function () { isDragging = false; });\n\n  angleSlider.addEventListener('input', function () {\n    updateAngle(parseInt(this.value));\n  });\n\n  updateAngle(45);\n\n  /* ============================================================\n     TAB 2: VINKELSUM — Triangle\n  ============================================================ */\n  var triA = document.getElementById('triA');\n  var triB = document.getElementById('triB');\n  var triCEl = document.getElementById('triC');\n  var triError = document.getElementById('triError');\n  var triangleSvg = document.getElementById('triangleSvg');\n\n  function drawTriangle(a, b, c) {\n    // Clear\n    while (triangleSvg.firstChild) triangleSvg.removeChild(triangleSvg.firstChild);\n\n    // Build triangle with bottom-left at fixed position\n    // Place vertex C bottom-left, vertex B bottom-right, vertex A at top\n    // We'll compute vertex positions from angles using law of sines.\n    // For display, fix bottom edge and compute top.\n    var svgW = 300, svgH = 220;\n    var margin = 30;\n    var baseLen = svgW - 2 * margin;\n    // Angle at bottom-left = C (we rename to match display: bottom-left=C, bottom-right=B, top=A)\n    // Actually let's just place: left=A, right=B, top=C\n    var Arad = deg2rad(a), Brad = deg2rad(b), Crad = deg2rad(c);\n    // Using law of sines: fix side c (opposite to C) = baseLen\n    // a/sin(A) = b/sin(B) = c/sin(C) = 2R\n    var sideC = baseLen; // bottom edge\n    var sideA = sideC * Math.sin(Arad) / Math.sin(Crad);\n    var sideB = sideC * Math.sin(Brad) / Math.sin(Crad);\n\n    var x1 = margin, y1 = svgH - margin;          // left vertex (angle A)\n    var x2 = margin + sideC, y2 = svgH - margin;  // right vertex (angle B)\n    // Top vertex (angle C): from left, travel sideB at angle A upward\n    var x3 = x1 + sideB * Math.cos(Arad);\n    var y3 = y1 - sideB * Math.sin(Arad);\n\n    // Center the triangle\n    var cx = (x1 + x2 + x3) / 3;\n    var cy = (y1 + y2 + y3) / 3;\n    var svgCx = svgW / 2, svgCy = svgH / 2;\n    var dx = svgCx - cx, dy = svgCy - cy;\n    x1 += dx; y1 += dy; x2 += dx; y2 += dy; x3 += dx; y3 += dy;\n\n    function el(tag, attrs, text) {\n      var e = document.createElementNS('http://www.w3.org/2000/svg', tag);\n      Object.keys(attrs).forEach(function (k) { e.setAttribute(k, attrs[k]); });\n      if (text) e.textContent = text;\n      return e;\n    }\n\n    // Fill\n    triangleSvg.appendChild(el('polygon', {\n      points: x1+','+y1+' '+x2+','+y2+' '+x3+','+y3,\n      fill: 'rgba(37,99,235,0.08)', stroke: '#2563eb', 'stroke-width': '2', 'stroke-linejoin': 'round'\n    }));\n\n    // Angle arcs at each vertex\n    function angleArcAt(vx, vy, fromDeg, toDeg, arcR, color) {\n      var d = arcPath2(vx, vy, fromDeg, toDeg, arcR);\n      triangleSvg.appendChild(el('path', { d: d, fill: 'rgba(251,191,36,0.25)', stroke: color, 'stroke-width': '1.5' }));\n    }\n\n    // Angle at left vertex (A): directions to right vertex and top vertex\n    function dirDeg(fromX, fromY, toX, toY) {\n      return rad2deg(Math.atan2(-(toY - fromY), toX - fromX));\n    }\n\n    function arcPath2(vx, vy, fromDeg, toDeg, r) {\n      // Ensure we go counter-clockwise (positive direction)\n      var span = toDeg - fromDeg;\n      if (span < 0) span += 360;\n      var sp = polarPoint(vx, vy, r, fromDeg);\n      var ep = polarPoint(vx, vy, r, toDeg);\n      var large = span > 180 ? 1 : 0;\n      return 'M ' + vx + ' ' + vy + ' L ' + sp.x + ' ' + sp.y +\n             ' A ' + r + ' ' + r + ' 0 ' + large + ' 0 ' + ep.x + ' ' + ep.y + ' Z';\n    }\n\n    var d1 = dirDeg(x1, y1, x2, y2); // right\n    var d2 = dirDeg(x1, y1, x3, y3); // top\n    angleArcAt(x1, y1, d1, d2 < d1 ? d2 + 360 : d2, 22, '#f59e0b');\n\n    var d3 = dirDeg(x2, y2, x3, y3); // top\n    var d4 = dirDeg(x2, y2, x1, y1); // left\n    angleArcAt(x2, y2, d3, d4 < d3 ? d4 + 360 : d4, 22, '#10b981');\n\n    var d5 = dirDeg(x3, y3, x1, y1);\n    var d6 = dirDeg(x3, y3, x2, y2);\n    angleArcAt(x3, y3, d5, d6 < d5 ? d6 + 360 : d5 + (360 - (d5 - d6)), 22, '#8b5cf6');\n\n    // Labels\n    var offsets = [\n      { x: x1 - 18, y: y1 + 4 },\n      { x: x2 + 6,  y: y2 + 4 },\n      { x: x3,      y: y3 - 10 }\n    ];\n    var labels = [a + '°', b + '°', c + '°'];\n    var colors = ['#d97706', '#059669', '#7c3aed'];\n    labels.forEach(function (lbl, i) {\n      triangleSvg.appendChild(el('text', {\n        x: offsets[i].x, y: offsets[i].y,\n        fill: colors[i], 'font-size': '13', 'font-weight': 'bold', 'text-anchor': 'middle'\n      }, lbl));\n    });\n\n    // Sum display\n    triangleSvg.appendChild(el('text', {\n      x: svgW / 2, y: svgH - 6,\n      fill: '#64748b', 'font-size': '11', 'text-anchor': 'middle'\n    }, a + '° + ' + b + '° + ' + c + '° = 180°'));\n  }\n\n  function updateTriangle() {\n    var a = parseInt(triA.value) || 0;\n    var b = parseInt(triB.value) || 0;\n    if (a <= 0 || b <= 0 || a + b >= 180) {\n      triError.classList.remove('hidden');\n      triCEl.textContent = '–';\n      return;\n    }\n    triError.classList.add('hidden');\n    var c = 180 - a - b;\n    triCEl.textContent = c;\n    drawTriangle(a, b, c);\n  }\n\n  triA.addEventListener('input', updateTriangle);\n  triB.addEventListener('input', updateTriangle);\n  updateTriangle();\n\n  /* ============================================================\n     TAB 2: POLYGON angle sum\n  ============================================================ */\n  var polySlider = document.getElementById('polySlider');\n  var polyNEl = document.getElementById('polyN');\n  var polySvg = document.getElementById('polySvg');\n  var polyFormula = document.getElementById('polyFormula');\n  var polyCalc = document.getElementById('polyCalc');\n  var polyResult = document.getElementById('polyResult');\n  var polyName = document.getElementById('polyName');\n  var polyTable = document.getElementById('polyTable');\n\n  var polyNames = {\n    3: 'Trekant', 4: 'Firkant', 5: 'Femkant', 6: 'Sekskant',\n    7: 'Syvkant', 8: 'Åttekant', 9: 'Nikant', 10: 'Tikant',\n    11: 'Ellvekant', 12: 'Tolvkant'\n  };\n\n  function drawPolygon(n) {\n    while (polySvg.firstChild) polySvg.removeChild(polySvg.firstChild);\n    var cx = 110, cy = 110, r = 90;\n    var pts = [];\n    for (var i = 0; i < n; i++) {\n      var ang = deg2rad(90 + 360 * i / n); // start at top\n      pts.push({ x: cx + r * Math.cos(-ang), y: cy + r * Math.sin(-ang) });\n    }\n    function el(tag, attrs) {\n      var e = document.createElementNS('http://www.w3.org/2000/svg', tag);\n      Object.keys(attrs).forEach(function (k) { e.setAttribute(k, attrs[k]); });\n      return e;\n    }\n    var pointsStr = pts.map(function (p) { return p.x + ',' + p.y; }).join(' ');\n    polySvg.appendChild(el('polygon', {\n      points: pointsStr, fill: 'rgba(37,99,235,0.1)', stroke: '#2563eb', 'stroke-width': '2', 'stroke-linejoin': 'round'\n    }));\n    // Vertex dots\n    pts.forEach(function (p) {\n      polySvg.appendChild(el('circle', { cx: p.x, cy: p.y, r: '4', fill: '#2563eb' }));\n    });\n  }\n\n  function fillPolyTable() {\n    polyTable.innerHTML = '';\n    for (var n = 3; n <= 10; n++) {\n      var sum = (n - 2) * 180;\n      var name = polyNames[n] || (n + '-kant');\n      var tr = document.createElement('tr');\n      tr.className = n % 2 === 0 ? 'bg-white' : 'bg-gray-50';\n      tr.innerHTML =\n        '<td class=\"px-3 py-2 font-medium\">' + name + '</td>' +\n        '<td class=\"px-3 py-2 text-center\">' + n + '</td>' +\n        '<td class=\"px-3 py-2 text-center text-gray-500\">(' + n + '−2)·180°</td>' +\n        '<td class=\"px-3 py-2 text-right font-bold text-blue-700\">' + sum + '°</td>';\n      polyTable.appendChild(tr);\n    }\n  }\n\n  function updatePoly() {\n    var n = parseInt(polySlider.value);\n    polyNEl.textContent = n;\n    var sum = (n - 2) * 180;\n    var name = polyNames[n] || (n + '-kant');\n    polyName.textContent = name;\n    polyCalc.textContent = '(' + n + ' − 2) · 180° = ' + (n - 2) + ' · 180°';\n    polyResult.textContent = sum + '°';\n    drawPolygon(n);\n  }\n\n  polySlider.addEventListener('input', updatePoly);\n  fillPolyTable();\n  updatePoly();\n\n  /* ============================================================\n     TAB 3: NABOVINKLER\n  ============================================================ */\n  var naboSlider = document.getElementById('naboSlider');\n  var naboAlphaEl = document.getElementById('naboAlpha');\n  var naboBetaEl = document.getElementById('naboBeta');\n  var naboSvg = document.getElementById('naboSvg');\n\n  function drawNabo(alphaDeg) {\n    while (naboSvg.firstChild) naboSvg.removeChild(naboSvg.firstChild);\n    var beta = 180 - alphaDeg;\n    var cx = 120, cy = 110, lineLen = 100;\n\n    function el(tag, attrs, txt) {\n      var e = document.createElementNS('http://www.w3.org/2000/svg', tag);\n      Object.keys(attrs).forEach(function (k) { e.setAttribute(k, attrs[k]); });\n      if (txt !== undefined) e.textContent = txt;\n      return e;\n    }\n\n    // Base line\n    naboSvg.appendChild(el('line', { x1: cx - lineLen, y1: cy, x2: cx + lineLen, y2: cy, stroke: '#64748b', 'stroke-width': '2.5', 'stroke-linecap': 'round' }));\n\n    // Moving ray upward (angle alpha from left direction = 180°)\n    var rayDeg = alphaDeg; // from positive x\n    var rp = polarPoint(cx, cy, lineLen, rayDeg);\n    naboSvg.appendChild(el('line', { x1: cx, y1: cy, x2: rp.x, y2: rp.y, stroke: '#2563eb', 'stroke-width': '2.5', 'stroke-linecap': 'round' }));\n\n    // Arc for alpha (right side: from 0° to alphaDeg)\n    var arcR = 38;\n    var ap = arcPath3(cx, cy, 0, alphaDeg, arcR);\n    naboSvg.appendChild(el('path', { d: ap, fill: 'rgba(37,99,235,0.15)', stroke: '#2563eb', 'stroke-width': '1.5' }));\n\n    // Arc for beta (left side: from alphaDeg to 180°)\n    var bp = arcPath3(cx, cy, alphaDeg, 180, arcR);\n    naboSvg.appendChild(el('path', { d: bp, fill: 'rgba(249,115,22,0.15)', stroke: '#f97316', 'stroke-width': '1.5' }));\n\n    // Labels\n    var alphaLabelR = arcR + 14;\n    var alphaLabel = polarPoint(cx, cy, alphaLabelR, alphaDeg / 2);\n    naboSvg.appendChild(el('text', { x: alphaLabel.x, y: alphaLabel.y + 4, fill: '#1d4ed8', 'font-size': '13', 'font-weight': 'bold', 'text-anchor': 'middle' }, 'α=' + alphaDeg + '°'));\n\n    var betaLabelR = arcR + 14;\n    var betaLabel = polarPoint(cx, cy, betaLabelR, alphaDeg + beta / 2);\n    naboSvg.appendChild(el('text', { x: betaLabel.x, y: betaLabel.y + 4, fill: '#ea580c', 'font-size': '13', 'font-weight': 'bold', 'text-anchor': 'middle' }, 'β=' + beta + '°'));\n  }\n\n  function arcPath3(vx, vy, fromDeg, toDeg, r) {\n    var sp = polarPoint(vx, vy, r, fromDeg);\n    var ep = polarPoint(vx, vy, r, toDeg);\n    var span = toDeg - fromDeg;\n    var large = span > 180 ? 1 : 0;\n    return 'M ' + vx + ' ' + vy + ' L ' + sp.x + ' ' + sp.y +\n           ' A ' + r + ' ' + r + ' 0 ' + large + ' 0 ' + ep.x + ' ' + ep.y + ' Z';\n  }\n\n  function updateNabo() {\n    var a = parseInt(naboSlider.value);\n    naboAlphaEl.textContent = a + '°';\n    naboBetaEl.textContent = (180 - a) + '°';\n    drawNabo(a);\n  }\n\n  naboSlider.addEventListener('input', updateNabo);\n  updateNabo();\n\n  /* ============================================================\n     TAB 3: TOPPVINKLER\n  ============================================================ */\n  var toppSlider = document.getElementById('toppSlider');\n  var toppAlphaEl = document.getElementById('toppAlpha');\n  var toppAEl = document.getElementById('toppA');\n  var toppBEl = document.getElementById('toppB');\n  var toppSvg = document.getElementById('toppSvg');\n\n  function drawTopp(alphaDeg) {\n    while (toppSvg.firstChild) toppSvg.removeChild(toppSvg.firstChild);\n    var cx = 120, cy = 120, lineLen = 105;\n    var beta = 180 - alphaDeg;\n\n    function el(tag, attrs, txt) {\n      var e = document.createElementNS('http://www.w3.org/2000/svg', tag);\n      Object.keys(attrs).forEach(function (k) { e.setAttribute(k, attrs[k]); });\n      if (txt !== undefined) e.textContent = txt;\n      return e;\n    }\n\n    // Line 1: horizontal-ish (0° and 180°)\n    var p1a = polarPoint(cx, cy, lineLen, 0);\n    var p1b = polarPoint(cx, cy, lineLen, 180);\n    toppSvg.appendChild(el('line', { x1: p1a.x, y1: p1a.y, x2: p1b.x, y2: p1b.y, stroke: '#64748b', 'stroke-width': '2.5', 'stroke-linecap': 'round' }));\n\n    // Line 2: at alphaDeg and alphaDeg+180\n    var p2a = polarPoint(cx, cy, lineLen, alphaDeg);\n    var p2b = polarPoint(cx, cy, lineLen, alphaDeg + 180);\n    toppSvg.appendChild(el('line', { x1: p2a.x, y1: p2a.y, x2: p2b.x, y2: p2b.y, stroke: '#2563eb', 'stroke-width': '2.5', 'stroke-linecap': 'round' }));\n\n    // 4 angle arcs\n    var arcR = 32;\n    // Top-right: 0° to alphaDeg\n    toppSvg.appendChild(el('path', { d: arcPath3(cx, cy, 0, alphaDeg, arcR), fill: 'rgba(37,99,235,0.2)', stroke: '#2563eb', 'stroke-width': '1.5' }));\n    // Top-left: alphaDeg to 180°\n    toppSvg.appendChild(el('path', { d: arcPath3(cx, cy, alphaDeg, 180, arcR), fill: 'rgba(249,115,22,0.2)', stroke: '#f97316', 'stroke-width': '1.5' }));\n    // Bottom-left: 180° to alphaDeg+180\n    toppSvg.appendChild(el('path', { d: arcPath3(cx, cy, 180, alphaDeg + 180, arcR), fill: 'rgba(37,99,235,0.2)', stroke: '#2563eb', 'stroke-width': '1.5' }));\n    // Bottom-right: alphaDeg+180 to 360\n    toppSvg.appendChild(el('path', { d: arcPath3(cx, cy, alphaDeg + 180, 360, arcR), fill: 'rgba(249,115,22,0.2)', stroke: '#f97316', 'stroke-width': '1.5' }));\n\n    // Labels\n    var lr = arcR + 16;\n    function addLabel(midDeg, text, color) {\n      var lp = polarPoint(cx, cy, lr, midDeg);\n      toppSvg.appendChild(el('text', { x: lp.x, y: lp.y + 4, fill: color, 'font-size': '12', 'font-weight': 'bold', 'text-anchor': 'middle' }, text));\n    }\n\n    addLabel(alphaDeg / 2, 'α=' + alphaDeg + '°', '#1d4ed8');\n    addLabel(alphaDeg + beta / 2, 'β=' + beta + '°', '#c2410c');\n    addLabel(180 + alphaDeg / 2, 'α=' + alphaDeg + '°', '#1d4ed8');\n    addLabel(alphaDeg + 180 + beta / 2, 'β=' + beta + '°', '#c2410c');\n\n    // Vertex\n    toppSvg.appendChild(el('circle', { cx: cx, cy: cy, r: '4', fill: '#1e40af' }));\n  }\n\n  function updateTopp() {\n    var a = parseInt(toppSlider.value);\n    var b = 180 - a;\n    toppAlphaEl.textContent = a + '°';\n    toppAEl.textContent = a + '°';\n    toppBEl.textContent = b + '°';\n    drawTopp(a);\n  }\n\n  toppSlider.addEventListener('input', updateTopp);\n  updateTopp();\n\n  /* ============================================================\n     TAB 3: PARALLELLE LINJER\n  ============================================================ */\n  var parallelSlider = document.getElementById('parallelSlider');\n  var parallelAlphaEl = document.getElementById('parallelAlpha');\n  var pSamsvareEl = document.getElementById('pSamsvare');\n  var pKryssEl = document.getElementById('pKryss');\n  var pMedsideEl = document.getElementById('pMedside');\n  var parallelSvg = document.getElementById('parallelSvg');\n\n  function drawParallel(alphaDeg) {\n    while (parallelSvg.firstChild) parallelSvg.removeChild(parallelSvg.firstChild);\n    var svgW = 260, svgH = 240;\n    var lineY1 = 70, lineY2 = 170;\n    var lineX1 = 20, lineX2 = 240;\n    var beta = 180 - alphaDeg;\n\n    function el(tag, attrs, txt) {\n      var e = document.createElementNS('http://www.w3.org/2000/svg', tag);\n      Object.keys(attrs).forEach(function (k) { e.setAttribute(k, attrs[k]); });\n      if (txt !== undefined) e.textContent = txt;\n      return e;\n    }\n\n    // Draw parallel lines with arrows\n    parallelSvg.appendChild(el('line', { x1: lineX1, y1: lineY1, x2: lineX2, y2: lineY1, stroke: '#64748b', 'stroke-width': '2.5', 'stroke-linecap': 'round' }));\n    parallelSvg.appendChild(el('line', { x1: lineX1, y1: lineY2, x2: lineX2, y2: lineY2, stroke: '#64748b', 'stroke-width': '2.5', 'stroke-linecap': 'round' }));\n\n    // Parallel arrows\n    parallelSvg.appendChild(el('polygon', { points: (lineX2)+','+(lineY1)+' '+(lineX2-8)+','+(lineY1-4)+' '+(lineX2-8)+','+(lineY1+4), fill: '#64748b' }));\n    parallelSvg.appendChild(el('polygon', { points: (lineX2)+','+(lineY2)+' '+(lineX2-8)+','+(lineY2-4)+' '+(lineX2-8)+','+(lineY2+4), fill: '#64748b' }));\n\n    // Labels for parallel lines\n    parallelSvg.appendChild(el('text', { x: lineX1 - 2, y: lineY1 - 8, fill: '#64748b', 'font-size': '11', 'font-weight': 'bold' }, 'l₁'));\n    parallelSvg.appendChild(el('text', { x: lineX1 - 2, y: lineY2 - 8, fill: '#64748b', 'font-size': '11', 'font-weight': 'bold' }, 'l₂'));\n\n    // Transversal: calculate x positions at each line\n    // Angle alphaDeg from horizontal\n    var halfH = (lineY2 - lineY1) / 2;\n    var dx = halfH / Math.tan(deg2rad(alphaDeg));\n    var midX = svgW / 2;\n    var tx1 = midX - dx; // x at line1\n    var tx2 = midX + dx; // x at line2\n    // Extend the transversal\n    var extFactor = 1.4;\n    var txTop = midX - dx * extFactor;\n    var txBot = midX + dx * extFactor;\n    var tyTop = lineY1 - (lineY2 - lineY1) * (extFactor - 1);\n    var tyBot = lineY2 + (lineY2 - lineY1) * (extFactor - 1);\n\n    parallelSvg.appendChild(el('line', { x1: txTop, y1: tyTop, x2: txBot, y2: tyBot, stroke: '#2563eb', 'stroke-width': '2.5', 'stroke-linecap': 'round' }));\n\n    // Intersection points\n    var ix1 = tx1, iy1 = lineY1;\n    var ix2 = tx2, iy2 = lineY2;\n\n    // Transversal direction angle (in SVG coords, measured from positive x)\n    // transversal goes from top-left to bottom-right at angle (180 - alphaDeg) from horizontal\n    var transAngle = -(180 - alphaDeg); // SVG angle (y flipped)\n    // Actually: transversal slope = dy/dx = (tyBot-tyTop)/(txBot-txTop)\n    var tAngleRad = Math.atan2(-(tyBot - tyTop), txBot - txTop);\n    var tAngleDeg = rad2deg(tAngleRad);\n    if (tAngleDeg < 0) tAngleDeg += 180;\n\n    // At intersection 1: 4 angles\n    // From right horizontal = 0°, transversal goes at tAngleDeg (going up-left = tAngleDeg+180)\n    var tRight = tAngleDeg; // direction toward bottom-right\n    var tLeft = tAngleDeg + 180; // direction toward top-left (mod 360)\n\n    var arcR = 24;\n\n    // At line 1 (top intersection ix1, iy1):\n    // Quadrant 1 (right of transversal, below line): angles from tRight to 0° (= right)\n    // Standard: angles from line-right (0°) to tRight going CCW = alphaDeg\n    // Let line go: left=180°, right=0°, transversal from top-left dir and bottom-right dir\n\n    // Upper-right at intersection 1 (between line going right and transversal going upper-right):\n    var trUpperRight1 = arcPath3(ix1, iy1, 0, tAngleDeg, arcR);\n    parallelSvg.appendChild(el('path', { d: trUpperRight1, fill: 'rgba(37,99,235,0.2)', stroke: '#2563eb', 'stroke-width': '1.5' }));\n\n    // Upper-left at intersection 1:\n    var trUpperLeft1 = arcPath3(ix1, iy1, tAngleDeg, 180, arcR);\n    parallelSvg.appendChild(el('path', { d: trUpperLeft1, fill: 'rgba(249,115,22,0.2)', stroke: '#f97316', 'stroke-width': '1.5' }));\n\n    // Lower-left at intersection 1 (toppvinkel of upper-right):\n    var trLowerLeft1 = arcPath3(ix1, iy1, 180, tAngleDeg + 180, arcR);\n    parallelSvg.appendChild(el('path', { d: trLowerLeft1, fill: 'rgba(37,99,235,0.2)', stroke: '#2563eb', 'stroke-width': '1.5' }));\n\n    // Lower-right at intersection 1:\n    var trLowerRight1 = arcPath3(ix1, iy1, tAngleDeg + 180, 360, arcR);\n    parallelSvg.appendChild(el('path', { d: trLowerRight1, fill: 'rgba(249,115,22,0.2)', stroke: '#f97316', 'stroke-width': '1.5' }));\n\n    // At intersection 2 (ix2, iy2) — same angles, samsvarende\n    var trUpperRight2 = arcPath3(ix2, iy2, 0, tAngleDeg, arcR);\n    parallelSvg.appendChild(el('path', { d: trUpperRight2, fill: 'rgba(16,185,129,0.2)', stroke: '#10b981', 'stroke-width': '1.5' }));\n\n    var trUpperLeft2 = arcPath3(ix2, iy2, tAngleDeg, 180, arcR);\n    parallelSvg.appendChild(el('path', { d: trUpperLeft2, fill: 'rgba(249,115,22,0.2)', stroke: '#f97316', 'stroke-width': '1.5' }));\n\n    var trLowerLeft2 = arcPath3(ix2, iy2, 180, tAngleDeg + 180, arcR);\n    parallelSvg.appendChild(el('path', { d: trLowerLeft2, fill: 'rgba(16,185,129,0.2)', stroke: '#10b981', 'stroke-width': '1.5' }));\n\n    var trLowerRight2 = arcPath3(ix2, iy2, tAngleDeg + 180, 360, arcR);\n    parallelSvg.appendChild(el('path', { d: trLowerRight2, fill: 'rgba(249,115,22,0.2)', stroke: '#f97316', 'stroke-width': '1.5' }));\n\n    // Dots at intersections\n    parallelSvg.appendChild(el('circle', { cx: ix1, cy: iy1, r: '4', fill: '#1e40af' }));\n    parallelSvg.appendChild(el('circle', { cx: ix2, cy: iy2, r: '4', fill: '#1e40af' }));\n\n    // Labels: alphaDeg for samsvarende (upper-right at both intersections)\n    var lr1 = arcR + 14;\n    function lp1(midDeg) { return polarPoint(ix1, iy1, lr1, midDeg); }\n    function lp2(midDeg) { return polarPoint(ix2, iy2, lr1, midDeg); }\n\n    var alphaText = alphaDeg + '°';\n    var betaText = beta + '°';\n\n    // Int1 upper-right\n    var p = lp1(tAngleDeg / 2);\n    parallelSvg.appendChild(el('text', { x: p.x, y: p.y + 4, fill: '#1d4ed8', 'font-size': '10', 'font-weight': 'bold', 'text-anchor': 'middle' }, alphaText));\n\n    // Int1 upper-left\n    p = lp1(tAngleDeg + beta / 2);\n    parallelSvg.appendChild(el('text', { x: p.x, y: p.y + 4, fill: '#c2410c', 'font-size': '10', 'font-weight': 'bold', 'text-anchor': 'middle' }, betaText));\n\n    // Int2 upper-right (samsvarende med Int1 upper-right)\n    p = lp2(tAngleDeg / 2);\n    parallelSvg.appendChild(el('text', { x: p.x, y: p.y + 4, fill: '#065f46', 'font-size': '10', 'font-weight': 'bold', 'text-anchor': 'middle' }, alphaText));\n\n    // Int2 upper-left\n    p = lp2(tAngleDeg + beta / 2);\n    parallelSvg.appendChild(el('text', { x: p.x, y: p.y + 4, fill: '#c2410c', 'font-size': '10', 'font-weight': 'bold', 'text-anchor': 'middle' }, betaText));\n  }\n\n  function updateParallel() {\n    var a = parseInt(parallelSlider.value);\n    var b = 180 - a;\n    parallelAlphaEl.textContent = a + '°';\n    pSamsvareEl.textContent = a + '°';\n    pKryssEl.textContent = a + '°';\n    pMedsideEl.textContent = b + '°';\n    drawParallel(a);\n  }\n\n  parallelSlider.addEventListener('input', updateParallel);\n  updateParallel();\n\n})();\n</script>\n</body>\n</html>\n",
