{
  "schema": "app-studio/canvas@1",
  "id": "example-geo-maalestokk",
  "name": "maalestokk.html",
  "code": "<!DOCTYPE html>\n<!--\n  Målestokk og kart — Halison App Studio-eksempel\n\n  Interaktivt læremiddel for geometri (matematikk 1P/2P, LK20): regn mellom\n  kartavstand og virkelig avstand, og hvordan areal skalerer med målestokken.\n\n  Fra Halison App Studio sitt offentlige bibliotek:\n  https://github.com/halisonworks/public-app-studio\n\n  Tillatt bruk: personlig, pedagogisk og annen ikke-kommersiell bruk. Behold denne\n  headeren og kildelenken; ikke-kommersiell bruk. Utgitt under Halison App Studio\n  Examples License — se LICENSE-filen i repoet over.\n-->\n<html lang=\"no\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Målestokk og kart – matematikk 1P/2P</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Segoe UI', system-ui, sans-serif; }\n    .tab-btn { transition: background 0.2s, color 0.2s; }\n    .tab-btn.active { background: #1d4ed8; color: #fff; }\n    .tab-btn:not(.active) { background: #e5e7eb; color: #374151; }\n    .result-box { background: #f0fdf4; border-left: 4px solid #16a34a; }\n    .formula-box { background: #eff6ff; border-left: 4px solid #2563eb; }\n    .warning-box { background: #fff7ed; border-left: 4px solid #ea580c; }\n    .step { counter-increment: step; }\n    .step::before { content: counter(step) \". \"; font-weight: 700; color: #1d4ed8; }\n    ol.steps { counter-reset: step; list-style: none; padding-left: 0; }\n    input[type=\"number\"]::-webkit-inner-spin-button,\n    input[type=\"number\"]::-webkit-outer-spin-button { opacity: 1; }\n    .scale-figure { transition: all 0.4s ease; }\n    .scalebar-tick { stroke: #374151; stroke-width: 1.5; }\n  </style>\n</head>\n<body class=\"bg-gray-50 min-h-screen\">\n\n<!-- HEADER -->\n<header class=\"bg-blue-700 text-white shadow-md\">\n  <div class=\"max-w-4xl mx-auto px-4 py-5\">\n    <h1 class=\"text-2xl font-bold tracking-tight\">Målestokk og kart</h1>\n    <p class=\"text-blue-200 text-sm mt-1\">Matematikk 1P/2P · LK20 · Geometri</p>\n  </div>\n</header>\n\n<!-- NAV TABS -->\n<div class=\"max-w-4xl mx-auto px-4 mt-6\">\n  <div class=\"flex flex-wrap gap-2\">\n    <button class=\"tab-btn active px-4 py-2 rounded-lg text-sm font-semibold\" onclick=\"showTab('kart')\">🗺 Kart og avstand</button>\n    <button class=\"tab-btn px-4 py-2 rounded-lg text-sm font-semibold\" onclick=\"showTab('forstorring')\">🔍 Forstørring / forminskning</button>\n    <button class=\"tab-btn px-4 py-2 rounded-lg text-sm font-semibold\" onclick=\"showTab('areal')\">⬛ Areal og målestokk</button>\n    <button class=\"tab-btn px-4 py-2 rounded-lg text-sm font-semibold\" onclick=\"showTab('visuell')\">📐 Visuell målestokk</button>\n  </div>\n</div>\n\n<!-- ============================================================\n     TAB 1: KART OG AVSTAND\n     ============================================================ -->\n<main class=\"max-w-4xl mx-auto px-4 pb-16\">\n\n<section id=\"tab-kart\" class=\"tab-section mt-6 space-y-6\">\n  <div class=\"bg-white rounded-2xl shadow p-6\">\n    <h2 class=\"text-xl font-bold text-blue-800 mb-2\">Hva er målestokk?</h2>\n    <p class=\"text-gray-700 leading-relaxed\">\n      Målestokk viser forholdet mellom en avstand på kartet og den tilsvarende virkelige avstanden.\n      Målestokk <strong>1 : n</strong> betyr at <strong>1 cm på kartet</strong> tilsvarer <strong>n cm i virkeligheten</strong>.\n    </p>\n    <div class=\"formula-box rounded-lg p-4 mt-4 text-sm\">\n      <p class=\"font-semibold text-blue-700 mb-1\">Grunnformlene:</p>\n      <p class=\"font-mono\">Virkelig avstand = Kartavstand × n</p>\n      <p class=\"font-mono mt-1\">Kartavstand = Virkelig avstand ÷ n</p>\n      <p class=\"text-gray-500 mt-2 text-xs\">Her er n den andre faktoren i målestokken (f.eks. 50 000 i målestokk 1 : 50 000)</p>\n    </div>\n  </div>\n\n  <!-- KALKULATOR -->\n  <div class=\"bg-white rounded-2xl shadow p-6\">\n    <h2 class=\"text-lg font-bold text-gray-800 mb-4\">Kalkulator – kartavstand ↔ virkelig avstand</h2>\n\n    <!-- Målestokk input -->\n    <div class=\"mb-5\">\n      <label class=\"block text-sm font-semibold text-gray-600 mb-1\">Målestokk  1 :</label>\n      <input id=\"k-n\" type=\"number\" min=\"1\" value=\"50000\"\n        class=\"w-48 border border-gray-300 rounded-lg px-3 py-2 text-base focus:outline-none focus:ring-2 focus:ring-blue-400\"\n        oninput=\"kartKalkuler()\" />\n      <span class=\"ml-2 text-gray-500 text-sm\">f.eks. 50000 for 1 : 50 000</span>\n    </div>\n\n    <!-- Konverteringsretning -->\n    <div class=\"flex gap-3 mb-5 flex-wrap\">\n      <button id=\"btn-kart-til-virk\" onclick=\"setKartRetning('kart-til-virk')\"\n        class=\"px-4 py-2 rounded-lg text-sm font-semibold bg-blue-600 text-white shadow\">\n        Kart → Virkelighet\n      </button>\n      <button id=\"btn-virk-til-kart\" onclick=\"setKartRetning('virk-til-kart')\"\n        class=\"px-4 py-2 rounded-lg text-sm font-semibold bg-gray-200 text-gray-700\">\n        Virkelighet → Kart\n      </button>\n    </div>\n\n    <!-- Input felt -->\n    <div id=\"kart-input-kart-til-virk\" class=\"space-y-3\">\n      <div class=\"flex items-center gap-3 flex-wrap\">\n        <label class=\"text-sm font-semibold text-gray-600 w-36\">Kartavstand:</label>\n        <input id=\"k-kartavstand\" type=\"number\" min=\"0\" step=\"0.1\" value=\"3\"\n          class=\"w-32 border border-gray-300 rounded-lg px-3 py-2 text-base focus:outline-none focus:ring-2 focus:ring-blue-400\"\n          oninput=\"kartKalkuler()\" />\n        <select id=\"k-kart-enhet\" onchange=\"kartKalkuler()\"\n          class=\"border border-gray-300 rounded-lg px-2 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\">\n          <option value=\"cm\" selected>cm</option>\n          <option value=\"mm\">mm</option>\n          <option value=\"m\">m</option>\n        </select>\n      </div>\n    </div>\n\n    <div id=\"kart-input-virk-til-kart\" class=\"space-y-3 hidden\">\n      <div class=\"flex items-center gap-3 flex-wrap\">\n        <label class=\"text-sm font-semibold text-gray-600 w-36\">Virkelig avstand:</label>\n        <input id=\"k-virkavstand\" type=\"number\" min=\"0\" step=\"0.1\" value=\"1.5\"\n          class=\"w-32 border border-gray-300 rounded-lg px-3 py-2 text-base focus:outline-none focus:ring-2 focus:ring-blue-400\"\n          oninput=\"kartKalkuler()\" />\n        <select id=\"k-virk-enhet\" onchange=\"kartKalkuler()\"\n          class=\"border border-gray-300 rounded-lg px-2 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\">\n          <option value=\"cm\">cm</option>\n          <option value=\"m\">m</option>\n          <option value=\"km\" selected>km</option>\n        </select>\n      </div>\n    </div>\n\n    <!-- Resultat og utregning -->\n    <div id=\"kart-resultat\" class=\"result-box rounded-lg p-4 mt-5 hidden\">\n      <p class=\"font-semibold text-green-700 text-sm mb-2\">Svar:</p>\n      <p id=\"kart-svar\" class=\"text-xl font-bold text-gray-800\"></p>\n    </div>\n\n    <div id=\"kart-utregning\" class=\"mt-4 bg-gray-50 rounded-lg p-4 border border-gray-200 hidden\">\n      <p class=\"text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2\">Utregning steg for steg</p>\n      <ol class=\"steps space-y-1 text-sm text-gray-700\" id=\"kart-steps\"></ol>\n    </div>\n  </div>\n\n  <!-- EKSEMPEL -->\n  <div class=\"bg-blue-50 rounded-2xl p-5 border border-blue-200\">\n    <h3 class=\"font-bold text-blue-800 mb-2\">Eksempel fra læreboken</h3>\n    <p class=\"text-sm text-gray-700\">Kart med målestokk <strong>1 : 50 000</strong>. Kartet viser at det er <strong>3 cm</strong> mellom to hytter.</p>\n    <p class=\"text-sm text-gray-700 mt-2\">Virkelig avstand = 3 cm × 50 000 = 150 000 cm = <strong>1,5 km</strong>.</p>\n    <p class=\"text-sm text-gray-500 mt-2 italic\">Tips: Sett inn verdiene i kalkulatoren over for å se alle stegene.</p>\n  </div>\n</section>\n\n<!-- ============================================================\n     TAB 2: FORSTØRRING / FORMINSKNING\n     ============================================================ -->\n<section id=\"tab-forstorring\" class=\"tab-section mt-6 space-y-6 hidden\">\n  <div class=\"bg-white rounded-2xl shadow p-6\">\n    <h2 class=\"text-xl font-bold text-blue-800 mb-2\">Forstørring og forminskning</h2>\n    <p class=\"text-gray-700 leading-relaxed\">\n      En målestokk trenger ikke være en forminskning. Målestokk <strong>2 : 1</strong> betyr at tegningen er\n      dobbelt så stor som originalen – altså en <em>forstørring</em>.\n    </p>\n    <div class=\"formula-box rounded-lg p-4 mt-4 text-sm\">\n      <p class=\"font-semibold text-blue-700 mb-1\">Generell formel for målestokk a : b:</p>\n      <p class=\"font-mono\">Tegningsavstand / Virkelig avstand = a / b</p>\n      <p class=\"font-mono mt-1\">Virkelig avstand = Tegningsavstand × (b / a)</p>\n      <p class=\"font-mono mt-1\">Tegningsavstand = Virkelig avstand × (a / b)</p>\n    </div>\n    <div class=\"mt-4 grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm\">\n      <div class=\"bg-orange-50 border border-orange-200 rounded-lg p-3\">\n        <p class=\"font-semibold text-orange-700\">Forstørring: a &gt; b</p>\n        <p class=\"text-gray-600 mt-1\">Eks: 2 : 1, 5 : 1, 10 : 1</p>\n        <p class=\"text-gray-600\">Tegning er <em>større</em> enn original</p>\n      </div>\n      <div class=\"bg-purple-50 border border-purple-200 rounded-lg p-3\">\n        <p class=\"font-semibold text-purple-700\">Forminskning: a &lt; b</p>\n        <p class=\"text-gray-600 mt-1\">Eks: 1 : 100, 1 : 50 000</p>\n        <p class=\"text-gray-600\">Tegning er <em>mindre</em> enn original</p>\n      </div>\n    </div>\n  </div>\n\n  <!-- KALKULATOR FORSTØRRING -->\n  <div class=\"bg-white rounded-2xl shadow p-6\">\n    <h2 class=\"text-lg font-bold text-gray-800 mb-4\">Kalkulator – a : b målestokk</h2>\n\n    <div class=\"flex items-center gap-2 mb-5 flex-wrap\">\n      <label class=\"text-sm font-semibold text-gray-600\">Målestokk:</label>\n      <input id=\"f-a\" type=\"number\" min=\"1\" value=\"2\"\n        class=\"w-20 border border-gray-300 rounded-lg px-3 py-2 text-base focus:outline-none focus:ring-2 focus:ring-blue-400\"\n        oninput=\"forstKalkuler()\" />\n      <span class=\"text-gray-500 font-bold text-lg\">:</span>\n      <input id=\"f-b\" type=\"number\" min=\"1\" value=\"1\"\n        class=\"w-20 border border-gray-300 rounded-lg px-3 py-2 text-base focus:outline-none focus:ring-2 focus:ring-blue-400\"\n        oninput=\"forstKalkuler()\" />\n    </div>\n\n    <div class=\"flex gap-3 mb-5 flex-wrap\">\n      <button id=\"btn-f-teg-til-virk\" onclick=\"setForstRetning('teg-til-virk')\"\n        class=\"px-4 py-2 rounded-lg text-sm font-semibold bg-blue-600 text-white shadow\">\n        Tegning → Virkelighet\n      </button>\n      <button id=\"btn-f-virk-til-teg\" onclick=\"setForstRetning('virk-til-teg')\"\n        class=\"px-4 py-2 rounded-lg text-sm font-semibold bg-gray-200 text-gray-700\">\n        Virkelighet → Tegning\n      </button>\n    </div>\n\n    <div id=\"forst-input-teg-til-virk\" class=\"flex items-center gap-3 flex-wrap\">\n      <label class=\"text-sm font-semibold text-gray-600 w-40\">Avstand på tegning:</label>\n      <input id=\"f-teg\" type=\"number\" min=\"0\" step=\"0.1\" value=\"10\"\n        class=\"w-32 border border-gray-300 rounded-lg px-3 py-2 text-base focus:outline-none focus:ring-2 focus:ring-blue-400\"\n        oninput=\"forstKalkuler()\" />\n      <select id=\"f-teg-enhet\" onchange=\"forstKalkuler()\"\n        class=\"border border-gray-300 rounded-lg px-2 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\">\n        <option value=\"mm\">mm</option>\n        <option value=\"cm\" selected>cm</option>\n        <option value=\"m\">m</option>\n      </select>\n    </div>\n\n    <div id=\"forst-input-virk-til-teg\" class=\"flex items-center gap-3 flex-wrap hidden\">\n      <label class=\"text-sm font-semibold text-gray-600 w-40\">Virkelig avstand:</label>\n      <input id=\"f-virk\" type=\"number\" min=\"0\" step=\"0.1\" value=\"5\"\n        class=\"w-32 border border-gray-300 rounded-lg px-3 py-2 text-base focus:outline-none focus:ring-2 focus:ring-blue-400\"\n        oninput=\"forstKalkuler()\" />\n      <select id=\"f-virk-enhet\" onchange=\"forstKalkuler()\"\n        class=\"border border-gray-300 rounded-lg px-2 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\">\n        <option value=\"mm\">mm</option>\n        <option value=\"cm\" selected>cm</option>\n        <option value=\"m\">m</option>\n      </select>\n    </div>\n\n    <div id=\"forst-resultat\" class=\"result-box rounded-lg p-4 mt-5 hidden\">\n      <p class=\"font-semibold text-green-700 text-sm mb-1\">Svar:</p>\n      <p id=\"forst-svar\" class=\"text-xl font-bold text-gray-800\"></p>\n    </div>\n\n    <div id=\"forst-utregning\" class=\"mt-4 bg-gray-50 rounded-lg p-4 border border-gray-200 hidden\">\n      <p class=\"text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2\">Utregning steg for steg</p>\n      <ol class=\"steps space-y-1 text-sm text-gray-700\" id=\"forst-steps\"></ol>\n    </div>\n\n    <!-- Forstørring/forminskning indikator -->\n    <div id=\"forst-type\" class=\"mt-4 hidden\">\n      <span id=\"forst-type-badge\" class=\"inline-block px-3 py-1 rounded-full text-xs font-bold\"></span>\n    </div>\n  </div>\n</section>\n\n<!-- ============================================================\n     TAB 3: AREAL OG MÅLESTOKK\n     ============================================================ -->\n<section id=\"tab-areal\" class=\"tab-section mt-6 space-y-6 hidden\">\n  <div class=\"bg-white rounded-2xl shadow p-6\">\n    <h2 class=\"text-xl font-bold text-blue-800 mb-2\">Areal skalerer med kvadratet av målestokken</h2>\n    <p class=\"text-gray-700 leading-relaxed\">\n      Når alle lengder skaleres med faktoren <strong>k</strong>, skaleres arealet med <strong>k²</strong>.\n      Det betyr at arealet vokser (eller krymper) mye raskere enn lengdene.\n    </p>\n\n    <div class=\"formula-box rounded-lg p-4 mt-4 text-sm\">\n      <p class=\"font-semibold text-blue-700 mb-2\">Formel:</p>\n      <p class=\"font-mono\">Hvis lengde skaleres med k  →  Areal skaleres med k²</p>\n      <p class=\"font-mono mt-1\">A_ny = A_original × k²</p>\n      <p class=\"font-mono mt-1\">k = (a / b)  der a : b er målestokken</p>\n    </div>\n\n    <!-- Visuell forklaring: rektangel skalert -->\n    <div class=\"mt-5 overflow-x-auto\">\n      <p class=\"text-sm font-semibold text-gray-600 mb-2\">Illustrasjon: lengde dobles (k = 2), areal firedobles (k² = 4)</p>\n      <svg viewBox=\"0 0 400 180\" class=\"w-full max-w-md\" aria-label=\"Illustrasjon av arealskaling\">\n        <!-- Original rektangel -->\n        <rect x=\"20\" y=\"60\" width=\"60\" height=\"40\" fill=\"#bfdbfe\" stroke=\"#2563eb\" stroke-width=\"2\" rx=\"2\"/>\n        <text x=\"50\" y=\"55\" text-anchor=\"middle\" font-size=\"11\" fill=\"#1e40af\">Original</text>\n        <text x=\"50\" y=\"115\" text-anchor=\"middle\" font-size=\"10\" fill=\"#374151\">A = L × B</text>\n        <!-- Pil -->\n        <line x1=\"100\" y1=\"80\" x2=\"130\" y2=\"80\" stroke=\"#6b7280\" stroke-width=\"1.5\" marker-end=\"url(#arr)\"/>\n        <text x=\"115\" y=\"72\" text-anchor=\"middle\" font-size=\"10\" fill=\"#ea580c\">k = 2</text>\n        <defs>\n          <marker id=\"arr\" markerWidth=\"8\" markerHeight=\"8\" refX=\"6\" refY=\"3\" orient=\"auto\">\n            <path d=\"M0,0 L0,6 L8,3 z\" fill=\"#6b7280\"/>\n          </marker>\n        </defs>\n        <!-- Skalert rektangel -->\n        <rect x=\"140\" y=\"40\" width=\"120\" height=\"80\" fill=\"#bbf7d0\" stroke=\"#16a34a\" stroke-width=\"2\" rx=\"2\"/>\n        <text x=\"200\" y=\"35\" text-anchor=\"middle\" font-size=\"11\" fill=\"#166534\">Ny (k = 2)</text>\n        <text x=\"200\" y=\"135\" text-anchor=\"middle\" font-size=\"10\" fill=\"#374151\">A = (2L) × (2B) = 4·L·B</text>\n        <!-- Brev -->\n        <text x=\"50\" y=\"90\" text-anchor=\"middle\" font-size=\"12\" fill=\"#1e40af\">L × B</text>\n        <text x=\"200\" y=\"85\" text-anchor=\"middle\" font-size=\"12\" fill=\"#166534\">2L × 2B</text>\n        <!-- Etikett -->\n        <rect x=\"280\" y=\"55\" width=\"110\" height=\"50\" fill=\"#fef3c7\" stroke=\"#d97706\" stroke-width=\"1.5\" rx=\"6\"/>\n        <text x=\"335\" y=\"75\" text-anchor=\"middle\" font-size=\"11\" fill=\"#92400e\">Areal: ×k² = ×4</text>\n        <text x=\"335\" y=\"93\" text-anchor=\"middle\" font-size=\"10\" fill=\"#78350f\">4 ganger større!</text>\n      </svg>\n    </div>\n\n    <!-- Worked example -->\n    <div class=\"mt-5 bg-yellow-50 border border-yellow-300 rounded-xl p-5\">\n      <h3 class=\"font-bold text-yellow-800 mb-3\">Gjennomgått eksempel</h3>\n      <p class=\"text-sm text-gray-700 mb-3\">\n        En plantegning har målestokk <strong>1 : 100</strong>. Et rom ser ut til å ha et areal på\n        <strong>12 cm²</strong> på tegningen. Hva er det virkelige arealet?\n      </p>\n      <ol class=\"steps space-y-2 text-sm text-gray-700\">\n        <li class=\"step\">Skaleringsforholdet er k = 1/100 (tegning er forminsket med faktor 100).</li>\n        <li class=\"step\">Arealet skaleres med k² = (1/100)² = 1/10 000.</li>\n        <li class=\"step\">Virkelig areal = 12 cm² ÷ (1/10 000) = 12 × 10 000 = 120 000 cm².</li>\n        <li class=\"step\">Omgjøring: 120 000 cm² = 12 m².</li>\n        <li class=\"step\">Svaret er <strong>12 m²</strong>.</li>\n      </ol>\n    </div>\n  </div>\n\n  <!-- AREAL KALKULATOR -->\n  <div class=\"bg-white rounded-2xl shadow p-6\">\n    <h2 class=\"text-lg font-bold text-gray-800 mb-4\">Kalkulator – arealskaling</h2>\n\n    <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4 mb-5\">\n      <div>\n        <label class=\"block text-sm font-semibold text-gray-600 mb-1\">Målestokk a :</label>\n        <input id=\"ar-a\" type=\"number\" min=\"1\" value=\"1\"\n          class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-base focus:outline-none focus:ring-2 focus:ring-blue-400\"\n          oninput=\"arealKalkuler()\" />\n      </div>\n      <div>\n        <label class=\"block text-sm font-semibold text-gray-600 mb-1\">: b</label>\n        <input id=\"ar-b\" type=\"number\" min=\"1\" value=\"100\"\n          class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-base focus:outline-none focus:ring-2 focus:ring-blue-400\"\n          oninput=\"arealKalkuler()\" />\n      </div>\n    </div>\n\n    <div class=\"flex gap-3 mb-5 flex-wrap\">\n      <button id=\"btn-ar-teg-til-virk\" onclick=\"setArealRetning('teg-til-virk')\"\n        class=\"px-4 py-2 rounded-lg text-sm font-semibold bg-blue-600 text-white shadow\">\n        Tegningsareal → Virkelig areal\n      </button>\n      <button id=\"btn-ar-virk-til-teg\" onclick=\"setArealRetning('virk-til-teg')\"\n        class=\"px-4 py-2 rounded-lg text-sm font-semibold bg-gray-200 text-gray-700\">\n        Virkelig areal → Tegningsareal\n      </button>\n    </div>\n\n    <div id=\"areal-input-teg-til-virk\" class=\"flex items-center gap-3 flex-wrap\">\n      <label class=\"text-sm font-semibold text-gray-600 w-44\">Areal på tegning:</label>\n      <input id=\"ar-teg\" type=\"number\" min=\"0\" step=\"0.01\" value=\"12\"\n        class=\"w-32 border border-gray-300 rounded-lg px-3 py-2 text-base focus:outline-none focus:ring-2 focus:ring-blue-400\"\n        oninput=\"arealKalkuler()\" />\n      <select id=\"ar-teg-enhet\" onchange=\"arealKalkuler()\"\n        class=\"border border-gray-300 rounded-lg px-2 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\">\n        <option value=\"mm2\">mm²</option>\n        <option value=\"cm2\" selected>cm²</option>\n        <option value=\"m2\">m²</option>\n      </select>\n    </div>\n\n    <div id=\"areal-input-virk-til-teg\" class=\"flex items-center gap-3 flex-wrap hidden\">\n      <label class=\"text-sm font-semibold text-gray-600 w-44\">Virkelig areal:</label>\n      <input id=\"ar-virk\" type=\"number\" min=\"0\" step=\"0.01\" value=\"12\"\n        class=\"w-32 border border-gray-300 rounded-lg px-3 py-2 text-base focus:outline-none focus:ring-2 focus:ring-blue-400\"\n        oninput=\"arealKalkuler()\" />\n      <select id=\"ar-virk-enhet\" onchange=\"arealKalkuler()\"\n        class=\"border border-gray-300 rounded-lg px-2 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\">\n        <option value=\"mm2\">mm²</option>\n        <option value=\"cm2\">cm²</option>\n        <option value=\"m2\" selected>m²</option>\n        <option value=\"km2\">km²</option>\n      </select>\n    </div>\n\n    <div id=\"areal-resultat\" class=\"result-box rounded-lg p-4 mt-5 hidden\">\n      <p class=\"font-semibold text-green-700 text-sm mb-1\">Svar:</p>\n      <p id=\"areal-svar\" class=\"text-xl font-bold text-gray-800\"></p>\n    </div>\n\n    <div id=\"areal-utregning\" class=\"mt-4 bg-gray-50 rounded-lg p-4 border border-gray-200 hidden\">\n      <p class=\"text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2\">Utregning steg for steg</p>\n      <ol class=\"steps space-y-1 text-sm text-gray-700\" id=\"areal-steps\"></ol>\n    </div>\n  </div>\n\n  <!-- Kvadratisk vekst tabell -->\n  <div class=\"bg-white rounded-2xl shadow p-6\">\n    <h2 class=\"text-lg font-bold text-gray-800 mb-3\">Tabell: Arealskaling for ulike k-verdier</h2>\n    <div class=\"overflow-x-auto\">\n      <table class=\"text-sm w-full text-left border-collapse\">\n        <thead>\n          <tr class=\"bg-blue-50 text-blue-800\">\n            <th class=\"px-3 py-2 border border-blue-200\">Lengdeskalering k</th>\n            <th class=\"px-3 py-2 border border-blue-200\">Arealskaling k²</th>\n            <th class=\"px-3 py-2 border border-blue-200\">Eksempel på målestokk</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr class=\"hover:bg-gray-50\"><td class=\"px-3 py-2 border border-gray-200\">1/2</td><td class=\"px-3 py-2 border border-gray-200\">1/4</td><td class=\"px-3 py-2 border border-gray-200\">1 : 2</td></tr>\n          <tr class=\"hover:bg-gray-50\"><td class=\"px-3 py-2 border border-gray-200\">1/10</td><td class=\"px-3 py-2 border border-gray-200\">1/100</td><td class=\"px-3 py-2 border border-gray-200\">1 : 10</td></tr>\n          <tr class=\"hover:bg-gray-50\"><td class=\"px-3 py-2 border border-gray-200\">1/100</td><td class=\"px-3 py-2 border border-gray-200\">1/10 000</td><td class=\"px-3 py-2 border border-gray-200\">1 : 100</td></tr>\n          <tr class=\"hover:bg-gray-50\"><td class=\"px-3 py-2 border border-gray-200\">1/1 000</td><td class=\"px-3 py-2 border border-gray-200\">1/1 000 000</td><td class=\"px-3 py-2 border border-gray-200\">1 : 1 000</td></tr>\n          <tr class=\"hover:bg-gray-50\"><td class=\"px-3 py-2 border border-gray-200\">2</td><td class=\"px-3 py-2 border border-gray-200\">4</td><td class=\"px-3 py-2 border border-gray-200\">2 : 1</td></tr>\n          <tr class=\"hover:bg-gray-50\"><td class=\"px-3 py-2 border border-gray-200\">5</td><td class=\"px-3 py-2 border border-gray-200\">25</td><td class=\"px-3 py-2 border border-gray-200\">5 : 1</td></tr>\n        </tbody>\n      </table>\n    </div>\n  </div>\n</section>\n\n<!-- ============================================================\n     TAB 4: VISUELL MÅLESTOKK\n     ============================================================ -->\n<section id=\"tab-visuell\" class=\"tab-section mt-6 space-y-6 hidden\">\n  <div class=\"bg-white rounded-2xl shadow p-6\">\n    <h2 class=\"text-xl font-bold text-blue-800 mb-2\">Visuell målestokk</h2>\n    <p class=\"text-gray-700 leading-relaxed mb-4\">\n      Tilpass målestokken og se en skaleringslinje (målestokk-bar) og en figur som endrer størrelse i sanntid.\n    </p>\n\n    <!-- Kontroller -->\n    <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-5 mb-5\">\n      <div>\n        <label class=\"block text-sm font-semibold text-gray-600 mb-1\">Målestokk 1 : n</label>\n        <div class=\"flex items-center gap-2\">\n          <input id=\"vis-n\" type=\"range\" min=\"100\" max=\"200000\" step=\"100\" value=\"25000\"\n            class=\"flex-1 accent-blue-600\" oninput=\"visKalkuler()\" />\n          <span id=\"vis-n-val\" class=\"text-sm font-mono w-20 text-right text-blue-700\">25 000</span>\n        </div>\n      </div>\n      <div>\n        <label class=\"block text-sm font-semibold text-gray-600 mb-1\">Kartavstand som vises (cm)</label>\n        <div class=\"flex items-center gap-2\">\n          <input id=\"vis-cm\" type=\"range\" min=\"0.5\" max=\"20\" step=\"0.5\" value=\"5\"\n            class=\"flex-1 accent-green-600\" oninput=\"visKalkuler()\" />\n          <span id=\"vis-cm-val\" class=\"text-sm font-mono w-16 text-right text-green-700\">5 cm</span>\n        </div>\n      </div>\n    </div>\n\n    <!-- SVG VISNING -->\n    <div class=\"border border-gray-200 rounded-xl bg-white overflow-hidden\">\n      <svg id=\"vis-svg\" viewBox=\"0 0 500 260\" class=\"w-full\" aria-label=\"Visuell målestokk-illustrasjon\">\n\n        <!-- Bakgrunn simulert kart -->\n        <rect width=\"500\" height=\"260\" fill=\"#f0f9ff\"/>\n\n        <!-- Rutenett - stilisert kart -->\n        <g stroke=\"#dbeafe\" stroke-width=\"0.8\">\n          <line x1=\"0\" y1=\"52\" x2=\"500\" y2=\"52\"/>\n          <line x1=\"0\" y1=\"104\" x2=\"500\" y2=\"104\"/>\n          <line x1=\"0\" y1=\"156\" x2=\"500\" y2=\"156\"/>\n          <line x1=\"0\" y1=\"208\" x2=\"500\" y2=\"208\"/>\n          <line x1=\"83\" y1=\"0\" x2=\"83\" y2=\"260\"/>\n          <line x1=\"166\" y1=\"0\" x2=\"166\" y2=\"260\"/>\n          <line x1=\"249\" y1=\"0\" x2=\"249\" y2=\"260\"/>\n          <line x1=\"332\" y1=\"0\" x2=\"332\" y2=\"260\"/>\n          <line x1=\"415\" y1=\"0\" x2=\"415\" y2=\"260\"/>\n        </g>\n\n        <!-- Vei simulasjon -->\n        <path d=\"M0,130 Q125,110 250,130 Q375,150 500,130\" stroke=\"#fbbf24\" stroke-width=\"4\" fill=\"none\" opacity=\"0.6\"/>\n\n        <!-- Skalert figur (rektangel/hus-form) -->\n        <g id=\"vis-figur\" transform=\"translate(200,70)\">\n          <!-- Hus kropp -->\n          <rect id=\"vis-hus-vegger\" x=\"-30\" y=\"15\" width=\"60\" height=\"45\" fill=\"#bfdbfe\" stroke=\"#2563eb\" stroke-width=\"1.5\" rx=\"2\"/>\n          <!-- Tak -->\n          <polygon id=\"vis-hus-tak\" points=\"0,0 -35,18 35,18\" fill=\"#1d4ed8\" stroke=\"#1e40af\" stroke-width=\"1\"/>\n          <!-- Dør -->\n          <rect id=\"vis-hus-dor\" x=\"-8\" y=\"40\" width=\"16\" height=\"20\" fill=\"#7c3aed\" rx=\"2\"/>\n          <!-- Vindu venstre -->\n          <rect id=\"vis-hus-vindu-l\" x=\"-26\" y=\"25\" width=\"14\" height=\"12\" fill=\"#bae6fd\" stroke=\"#0ea5e9\" stroke-width=\"1\" rx=\"1\"/>\n          <!-- Vindu høyre -->\n          <rect id=\"vis-hus-vindu-r\" x=\"12\" y=\"25\" width=\"14\" height=\"12\" fill=\"#bae6fd\" stroke=\"#0ea5e9\" stroke-width=\"1\" rx=\"1\"/>\n        </g>\n\n        <!-- Punkt A -->\n        <circle id=\"vis-ptA\" cx=\"120\" cy=\"130\" r=\"4\" fill=\"#dc2626\"/>\n        <text id=\"vis-lblA\" x=\"124\" y=\"126\" font-size=\"11\" fill=\"#dc2626\" font-weight=\"bold\">A</text>\n\n        <!-- Punkt B (flyttes basert på kartavstand) -->\n        <circle id=\"vis-ptB\" cx=\"280\" cy=\"130\" r=\"4\" fill=\"#dc2626\"/>\n        <text id=\"vis-lblB\" x=\"284\" y=\"126\" font-size=\"11\" fill=\"#dc2626\" font-weight=\"bold\">B</text>\n\n        <!-- Avstandslinje A til B -->\n        <line id=\"vis-linje\" x1=\"120\" y1=\"130\" x2=\"280\" y2=\"130\" stroke=\"#dc2626\" stroke-width=\"1.5\" stroke-dasharray=\"4,3\"/>\n\n        <!-- Målestokk-bar (scale bar) -->\n        <g id=\"vis-scalebar\" transform=\"translate(20, 225)\">\n          <!-- Bakgrunn -->\n          <rect x=\"0\" y=\"-4\" width=\"220\" height=\"28\" rx=\"4\" fill=\"white\" fill-opacity=\"0.85\" stroke=\"#9ca3af\" stroke-width=\"0.8\"/>\n          <!-- Bar -->\n          <rect id=\"sb-fill\" x=\"5\" y=\"4\" width=\"100\" height=\"10\" fill=\"#1d4ed8\" rx=\"1\"/>\n          <!-- Ticks -->\n          <line class=\"scalebar-tick\" x1=\"5\" y1=\"0\" x2=\"5\" y2=\"14\"/>\n          <line id=\"sb-mid-tick\" class=\"scalebar-tick\" x1=\"55\" y1=\"0\" x2=\"55\" y2=\"10\"/>\n          <line id=\"sb-end-tick\" class=\"scalebar-tick\" x1=\"105\" y1=\"0\" x2=\"105\" y2=\"14\"/>\n          <!-- Etiketter -->\n          <text x=\"5\" y=\"-4\" font-size=\"9\" fill=\"#374151\" text-anchor=\"middle\">0</text>\n          <text id=\"sb-mid-lbl\" x=\"55\" y=\"-4\" font-size=\"9\" fill=\"#374151\" text-anchor=\"middle\"></text>\n          <text id=\"sb-end-lbl\" x=\"105\" y=\"-4\" font-size=\"9\" fill=\"#374151\" text-anchor=\"middle\"></text>\n          <text id=\"sb-unit\" x=\"165\" y=\"11\" font-size=\"9\" fill=\"#6b7280\"></text>\n        </g>\n\n        <!-- Tekstboks: info -->\n        <rect x=\"320\" y=\"215\" width=\"175\" height=\"40\" rx=\"6\" fill=\"white\" fill-opacity=\"0.9\" stroke=\"#d1d5db\" stroke-width=\"0.8\"/>\n        <text x=\"408\" y=\"232\" text-anchor=\"middle\" font-size=\"10\" fill=\"#374151\" id=\"vis-info-1\"></text>\n        <text x=\"408\" y=\"247\" text-anchor=\"middle\" font-size=\"10\" fill=\"#059669\" font-weight=\"bold\" id=\"vis-info-2\"></text>\n      </svg>\n    </div>\n\n    <!-- Tekstresultat under SVG -->\n    <div class=\"mt-4 result-box rounded-lg p-4\">\n      <p class=\"text-sm font-semibold text-green-700 mb-1\">Avstand i virkeligheten:</p>\n      <p id=\"vis-tekst\" class=\"text-xl font-bold text-gray-800\"></p>\n    </div>\n  </div>\n\n  <!-- Hva betyr symbolene på kart -->\n  <div class=\"bg-white rounded-2xl shadow p-6\">\n    <h2 class=\"text-lg font-bold text-gray-800 mb-3\">Vanlige kartmålestokker i Norge</h2>\n    <div class=\"overflow-x-auto\">\n      <table class=\"text-sm w-full text-left border-collapse\">\n        <thead>\n          <tr class=\"bg-blue-50 text-blue-800\">\n            <th class=\"px-3 py-2 border border-blue-200\">Målestokk</th>\n            <th class=\"px-3 py-2 border border-blue-200\">1 cm på kart =</th>\n            <th class=\"px-3 py-2 border border-blue-200\">Typisk bruksområde</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr class=\"hover:bg-gray-50\"><td class=\"px-3 py-2 border border-gray-200\">1 : 5 000</td><td class=\"px-3 py-2 border border-gray-200\">50 m</td><td class=\"px-3 py-2 border border-gray-200\">Bykart, detaljert</td></tr>\n          <tr class=\"hover:bg-gray-50\"><td class=\"px-3 py-2 border border-gray-200\">1 : 10 000</td><td class=\"px-3 py-2 border border-gray-200\">100 m</td><td class=\"px-3 py-2 border border-gray-200\">Orienteringskart</td></tr>\n          <tr class=\"hover:bg-gray-50\"><td class=\"px-3 py-2 border border-gray-200\">1 : 50 000</td><td class=\"px-3 py-2 border border-gray-200\">500 m</td><td class=\"px-3 py-2 border border-gray-200\">Turkart (M711-serien)</td></tr>\n          <tr class=\"hover:bg-gray-50\"><td class=\"px-3 py-2 border border-gray-200\">1 : 250 000</td><td class=\"px-3 py-2 border border-gray-200\">2,5 km</td><td class=\"px-3 py-2 border border-gray-200\">Regionskart</td></tr>\n          <tr class=\"hover:bg-gray-50\"><td class=\"px-3 py-2 border border-gray-200\">1 : 1 000 000</td><td class=\"px-3 py-2 border border-gray-200\">10 km</td><td class=\"px-3 py-2 border border-gray-200\">Landsoversikt</td></tr>\n        </tbody>\n      </table>\n    </div>\n  </div>\n</section>\n\n</main>\n\n<!-- FOOTER -->\n<footer class=\"border-t border-gray-200 mt-8\">\n  <div class=\"max-w-4xl mx-auto px-4 py-4 text-xs text-gray-400 flex flex-wrap gap-2 justify-between items-center\">\n    <span>Halison App Studio · <a href=\"https://github.com/halisonworks/public-app-studio\" class=\"underline hover:text-blue-500\">github.com/halisonworks/public-app-studio</a></span>\n    <span>Matematikk 1P/2P · LK20 · Geometri</span>\n  </div>\n</footer>\n\n<script>\n// =============================================\n// HJELPEFUNKSJONER: ENHETSOMREGNING\n// =============================================\n\nconst LENGDE_TIL_CM = { mm: 0.1, cm: 1, m: 100, km: 100000 };\nconst AREAL_TIL_CM2 = { mm2: 0.01, cm2: 1, m2: 10000, km2: 1e10 };\n\nfunction formaterTall(v) {\n  if (isNaN(v) || !isFinite(v)) return '—';\n  if (v === 0) return '0';\n  if (Math.abs(v) >= 1e9) return (v / 1e9).toLocaleString('nb-NO', { maximumFractionDigits: 3 }) + ' × 10⁹';\n  if (Math.abs(v) >= 1000000) return (v / 1000000).toLocaleString('nb-NO', { maximumFractionDigits: 4 }) + ' mill.';\n  return v.toLocaleString('nb-NO', { maximumFractionDigits: 6 });\n}\n\nfunction velgBestAvastandEnhet(cm) {\n  // Velg best lesbar enhet\n  if (cm >= 100000) return { val: cm / 100000, enhet: 'km' };\n  if (cm >= 100) return { val: cm / 100, enhet: 'm' };\n  if (cm >= 1) return { val: cm, enhet: 'cm' };\n  return { val: cm * 10, enhet: 'mm' };\n}\n\nfunction velgBestArealEnhet(cm2) {\n  if (cm2 >= 1e10) return { val: cm2 / 1e10, enhet: 'km²' };\n  if (cm2 >= 10000) return { val: cm2 / 10000, enhet: 'm²' };\n  if (cm2 >= 1) return { val: cm2, enhet: 'cm²' };\n  return { val: cm2 * 100, enhet: 'mm²' };\n}\n\n// =============================================\n// TAB-STYRING\n// =============================================\n\nlet currentTab = 'kart';\n\nfunction showTab(tab) {\n  document.querySelectorAll('.tab-section').forEach(s => s.classList.add('hidden'));\n  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));\n  document.getElementById('tab-' + tab).classList.remove('hidden');\n  document.querySelectorAll('.tab-btn').forEach(b => {\n    if (b.getAttribute('onclick') === \"showTab('\" + tab + \"')\") b.classList.add('active');\n  });\n  currentTab = tab;\n  if (tab === 'visuell') visKalkuler();\n}\n\n// =============================================\n// TAB 1: KART OG AVSTAND\n// =============================================\n\nlet kartRetning = 'kart-til-virk';\n\nfunction setKartRetning(r) {\n  kartRetning = r;\n  document.getElementById('kart-input-kart-til-virk').classList.toggle('hidden', r !== 'kart-til-virk');\n  document.getElementById('kart-input-virk-til-kart').classList.toggle('hidden', r !== 'virk-til-kart');\n  document.getElementById('btn-kart-til-virk').className =\n    'px-4 py-2 rounded-lg text-sm font-semibold ' +\n    (r === 'kart-til-virk' ? 'bg-blue-600 text-white shadow' : 'bg-gray-200 text-gray-700');\n  document.getElementById('btn-virk-til-kart').className =\n    'px-4 py-2 rounded-lg text-sm font-semibold ' +\n    (r === 'virk-til-kart' ? 'bg-blue-600 text-white shadow' : 'bg-gray-200 text-gray-700');\n  kartKalkuler();\n}\n\nfunction kartKalkuler() {\n  const n = parseFloat(document.getElementById('k-n').value);\n  if (!n || n <= 0) return;\n\n  let steps = [];\n  let svarTekst = '';\n\n  if (kartRetning === 'kart-til-virk') {\n    const kartVal = parseFloat(document.getElementById('k-kartavstand').value);\n    const kartEnhet = document.getElementById('k-kart-enhet').value;\n    if (isNaN(kartVal) || kartVal < 0) return;\n\n    const kartCm = kartVal * LENGDE_TIL_CM[kartEnhet];\n    const virkCm = kartCm * n;\n    const { val: virkVal, enhet: virkEnhet } = velgBestAvastandEnhet(virkCm);\n\n    steps.push(`Målestokk 1 : ${formaterTall(n)}, kartavstand = ${formaterTall(kartVal)} ${kartEnhet}`);\n    steps.push(`Konverter til cm: ${formaterTall(kartVal)} ${kartEnhet} = ${formaterTall(kartCm)} cm`);\n    steps.push(`Formel: Virkelig avstand = Kartavstand × n = ${formaterTall(kartCm)} cm × ${formaterTall(n)}`);\n    steps.push(`= ${formaterTall(virkCm)} cm`);\n    const { val: v2, enhet: e2 } = velgBestAvastandEnhet(virkCm);\n    if (e2 !== 'cm') steps.push(`Omgjøring: ${formaterTall(virkCm)} cm = ${formaterTall(v2)} ${e2}`);\n    svarTekst = `${formaterTall(virkVal)} ${virkEnhet}`;\n\n  } else {\n    const virkVal = parseFloat(document.getElementById('k-virkavstand').value);\n    const virkEnhet = document.getElementById('k-virk-enhet').value;\n    if (isNaN(virkVal) || virkVal < 0) return;\n\n    const virkCm = virkVal * LENGDE_TIL_CM[virkEnhet];\n    const kartCm = virkCm / n;\n    const { val: kartVis, enhet: kartEnhetVis } = velgBestAvastandEnhet(kartCm);\n\n    steps.push(`Målestokk 1 : ${formaterTall(n)}, virkelig avstand = ${formaterTall(virkVal)} ${virkEnhet}`);\n    steps.push(`Konverter til cm: ${formaterTall(virkVal)} ${virkEnhet} = ${formaterTall(virkCm)} cm`);\n    steps.push(`Formel: Kartavstand = Virkelig avstand ÷ n = ${formaterTall(virkCm)} cm ÷ ${formaterTall(n)}`);\n    steps.push(`= ${formaterTall(kartCm)} cm`);\n    if (kartEnhetVis !== 'cm') steps.push(`Omgjøring: ${formaterTall(kartCm)} cm = ${formaterTall(kartVis)} ${kartEnhetVis}`);\n    svarTekst = `${formaterTall(kartVis)} ${kartEnhetVis}`;\n  }\n\n  const resultatEl = document.getElementById('kart-resultat');\n  const utregEl = document.getElementById('kart-utregning');\n  const stepsEl = document.getElementById('kart-steps');\n\n  document.getElementById('kart-svar').textContent = svarTekst;\n  stepsEl.innerHTML = steps.map(s => `<li class=\"step\">${s}</li>`).join('');\n  resultatEl.classList.remove('hidden');\n  utregEl.classList.remove('hidden');\n}\n\n// =============================================\n// TAB 2: FORSTØRRING\n// =============================================\n\nlet forstRetning = 'teg-til-virk';\n\nfunction setForstRetning(r) {\n  forstRetning = r;\n  document.getElementById('forst-input-teg-til-virk').classList.toggle('hidden', r !== 'teg-til-virk');\n  document.getElementById('forst-input-virk-til-teg').classList.toggle('hidden', r !== 'virk-til-teg');\n  document.getElementById('btn-f-teg-til-virk').className =\n    'px-4 py-2 rounded-lg text-sm font-semibold ' +\n    (r === 'teg-til-virk' ? 'bg-blue-600 text-white shadow' : 'bg-gray-200 text-gray-700');\n  document.getElementById('btn-f-virk-til-teg').className =\n    'px-4 py-2 rounded-lg text-sm font-semibold ' +\n    (r === 'virk-til-teg' ? 'bg-blue-600 text-white shadow' : 'bg-gray-200 text-gray-700');\n  forstKalkuler();\n}\n\nfunction forstKalkuler() {\n  const a = parseFloat(document.getElementById('f-a').value);\n  const b = parseFloat(document.getElementById('f-b').value);\n  if (!a || !b || a <= 0 || b <= 0) return;\n\n  const k = a / b;\n  const typeBadge = document.getElementById('forst-type-badge');\n  const typeDiv = document.getElementById('forst-type');\n  if (k > 1) {\n    typeBadge.textContent = 'Forstørring (a > b)';\n    typeBadge.className = 'inline-block px-3 py-1 rounded-full text-xs font-bold bg-orange-100 text-orange-700 border border-orange-300';\n  } else if (k < 1) {\n    typeBadge.textContent = 'Forminskning (a < b)';\n    typeBadge.className = 'inline-block px-3 py-1 rounded-full text-xs font-bold bg-purple-100 text-purple-700 border border-purple-300';\n  } else {\n    typeBadge.textContent = 'Ingen skalering (a = b, 1 : 1)';\n    typeBadge.className = 'inline-block px-3 py-1 rounded-full text-xs font-bold bg-gray-100 text-gray-700 border border-gray-300';\n  }\n  typeDiv.classList.remove('hidden');\n\n  let steps = [];\n  let svarTekst = '';\n\n  if (forstRetning === 'teg-til-virk') {\n    const tegVal = parseFloat(document.getElementById('f-teg').value);\n    const tegEnhet = document.getElementById('f-teg-enhet').value;\n    if (isNaN(tegVal) || tegVal < 0) return;\n\n    const tegCm = tegVal * LENGDE_TIL_CM[tegEnhet];\n    // Tegningsavstand / Virkelig = a/b  →  Virkelig = Tegning × b/a\n    const virkCm = tegCm * b / a;\n    const { val: virkVis, enhet: virkEnhetVis } = velgBestAvastandEnhet(virkCm);\n\n    steps.push(`Målestokk ${a} : ${b}  (k = a/b = ${formaterTall(k)})`);\n    steps.push(`Tegningsavstand = ${formaterTall(tegVal)} ${tegEnhet} = ${formaterTall(tegCm)} cm`);\n    steps.push(`Formel: Virkelig = Tegning × (b/a) = ${formaterTall(tegCm)} cm × (${b}/${a})`);\n    steps.push(`= ${formaterTall(tegCm)} cm × ${formaterTall(b/a)} = ${formaterTall(virkCm)} cm`);\n    if (virkEnhetVis !== 'cm') steps.push(`Omgjøring: ${formaterTall(virkCm)} cm = ${formaterTall(virkVis)} ${virkEnhetVis}`);\n    svarTekst = `${formaterTall(virkVis)} ${virkEnhetVis}`;\n\n  } else {\n    const virkVal = parseFloat(document.getElementById('f-virk').value);\n    const virkEnhet = document.getElementById('f-virk-enhet').value;\n    if (isNaN(virkVal) || virkVal < 0) return;\n\n    const virkCm = virkVal * LENGDE_TIL_CM[virkEnhet];\n    // Tegning = Virkelig × (a/b)\n    const tegCm = virkCm * a / b;\n    const { val: tegVis, enhet: tegEnhetVis } = velgBestAvastandEnhet(tegCm);\n\n    steps.push(`Målestokk ${a} : ${b}  (k = a/b = ${formaterTall(k)})`);\n    steps.push(`Virkelig avstand = ${formaterTall(virkVal)} ${virkEnhet} = ${formaterTall(virkCm)} cm`);\n    steps.push(`Formel: Tegning = Virkelig × (a/b) = ${formaterTall(virkCm)} cm × (${a}/${b})`);\n    steps.push(`= ${formaterTall(virkCm)} cm × ${formaterTall(a/b)} = ${formaterTall(tegCm)} cm`);\n    if (tegEnhetVis !== 'cm') steps.push(`Omgjøring: ${formaterTall(tegCm)} cm = ${formaterTall(tegVis)} ${tegEnhetVis}`);\n    svarTekst = `${formaterTall(tegVis)} ${tegEnhetVis}`;\n  }\n\n  document.getElementById('forst-svar').textContent = svarTekst;\n  document.getElementById('forst-steps').innerHTML = steps.map(s => `<li class=\"step\">${s}</li>`).join('');\n  document.getElementById('forst-resultat').classList.remove('hidden');\n  document.getElementById('forst-utregning').classList.remove('hidden');\n}\n\n// =============================================\n// TAB 3: AREAL\n// =============================================\n\nlet arealRetning = 'teg-til-virk';\n\nfunction setArealRetning(r) {\n  arealRetning = r;\n  document.getElementById('areal-input-teg-til-virk').classList.toggle('hidden', r !== 'teg-til-virk');\n  document.getElementById('areal-input-virk-til-teg').classList.toggle('hidden', r !== 'virk-til-teg');\n  document.getElementById('btn-ar-teg-til-virk').className =\n    'px-4 py-2 rounded-lg text-sm font-semibold ' +\n    (r === 'teg-til-virk' ? 'bg-blue-600 text-white shadow' : 'bg-gray-200 text-gray-700');\n  document.getElementById('btn-ar-virk-til-teg').className =\n    'px-4 py-2 rounded-lg text-sm font-semibold ' +\n    (r === 'virk-til-teg' ? 'bg-blue-600 text-white shadow' : 'bg-gray-200 text-gray-700');\n  arealKalkuler();\n}\n\nfunction arealKalkuler() {\n  const a = parseFloat(document.getElementById('ar-a').value);\n  const b = parseFloat(document.getElementById('ar-b').value);\n  if (!a || !b || a <= 0 || b <= 0) return;\n\n  const k = a / b;\n  const k2 = k * k;\n\n  let steps = [];\n  let svarTekst = '';\n\n  if (arealRetning === 'teg-til-virk') {\n    const tegVal = parseFloat(document.getElementById('ar-teg').value);\n    const tegEnhet = document.getElementById('ar-teg-enhet').value;\n    if (isNaN(tegVal) || tegVal < 0) return;\n\n    const tegCm2 = tegVal * AREAL_TIL_CM2[tegEnhet];\n    // Areal_virkelig = Areal_tegning / k²  (siden k = tegning/virkelig)\n    const virkCm2 = tegCm2 / k2;\n    const { val: virkVis, enhet: virkEnhetVis } = velgBestArealEnhet(virkCm2);\n\n    steps.push(`Målestokk ${a} : ${b}  →  lengdeskalering k = ${formaterTall(a)}/${formaterTall(b)} = ${formaterTall(k)}`);\n    steps.push(`Arealskaleringsfaktor = k² = (${formaterTall(k)})² = ${formaterTall(k2)}`);\n    steps.push(`Tegningsareal = ${formaterTall(tegVal)} ${tegEnhet} = ${formaterTall(tegCm2)} cm²`);\n    steps.push(`Formel: Virkelig areal = Tegningsareal ÷ k²`);\n    steps.push(`= ${formaterTall(tegCm2)} cm² ÷ ${formaterTall(k2)} = ${formaterTall(virkCm2)} cm²`);\n    if (virkEnhetVis !== 'cm²') steps.push(`Omgjøring: ${formaterTall(virkCm2)} cm² = ${formaterTall(virkVis)} ${virkEnhetVis}`);\n    svarTekst = `${formaterTall(virkVis)} ${virkEnhetVis}`;\n\n  } else {\n    const virkVal = parseFloat(document.getElementById('ar-virk').value);\n    const virkEnhet = document.getElementById('ar-virk-enhet').value;\n    if (isNaN(virkVal) || virkVal < 0) return;\n\n    const virkCm2 = virkVal * AREAL_TIL_CM2[virkEnhet];\n    const tegCm2 = virkCm2 * k2;\n    const { val: tegVis, enhet: tegEnhetVis } = velgBestArealEnhet(tegCm2);\n\n    steps.push(`Målestokk ${a} : ${b}  →  lengdeskalering k = ${formaterTall(a)}/${formaterTall(b)} = ${formaterTall(k)}`);\n    steps.push(`Arealskaleringsfaktor = k² = (${formaterTall(k)})² = ${formaterTall(k2)}`);\n    steps.push(`Virkelig areal = ${formaterTall(virkVal)} ${virkEnhet} = ${formaterTall(virkCm2)} cm²`);\n    steps.push(`Formel: Tegningsareal = Virkelig areal × k²`);\n    steps.push(`= ${formaterTall(virkCm2)} cm² × ${formaterTall(k2)} = ${formaterTall(tegCm2)} cm²`);\n    if (tegEnhetVis !== 'cm²') steps.push(`Omgjøring: ${formaterTall(tegCm2)} cm² = ${formaterTall(tegVis)} ${tegEnhetVis}`);\n    svarTekst = `${formaterTall(tegVis)} ${tegEnhetVis}`;\n  }\n\n  document.getElementById('areal-svar').textContent = svarTekst;\n  document.getElementById('areal-steps').innerHTML = steps.map(s => `<li class=\"step\">${s}</li>`).join('');\n  document.getElementById('areal-resultat').classList.remove('hidden');\n  document.getElementById('areal-utregning').classList.remove('hidden');\n}\n\n// =============================================\n// TAB 4: VISUELL\n// =============================================\n\nfunction visKalkuler() {\n  const n = parseInt(document.getElementById('vis-n').value);\n  const kartCm = parseFloat(document.getElementById('vis-cm').value);\n\n  document.getElementById('vis-n-val').textContent = n.toLocaleString('nb-NO');\n  document.getElementById('vis-cm-val').textContent = kartCm.toLocaleString('nb-NO', {minimumFractionDigits: 1}) + ' cm';\n\n  const virkCm = kartCm * n;\n  const { val: virkVis, enhet: virkEnhet } = velgBestAvastandEnhet(virkCm);\n\n  document.getElementById('vis-tekst').textContent =\n    kartCm.toLocaleString('nb-NO', {minimumFractionDigits: 1}) + ' cm på kartet = ' +\n    formaterTall(virkVis) + ' ' + virkEnhet + ' i virkeligheten (målestokk 1 : ' + n.toLocaleString('nb-NO') + ')';\n\n  // Skalert figur: størrelse relativ til n (figur representerer hus i skala)\n  // Max n = 200000, min = 100. Vi ønsker figur synlig alltid.\n  const scaleFactor = Math.max(0.3, Math.min(3.0, 50000 / n));\n  const figEl = document.getElementById('vis-figur');\n  figEl.setAttribute('transform', `translate(200,70) scale(${scaleFactor})`);\n\n  // Oppdater avstandslinje basert på kartCm (maks 20 cm → maks 320 px, min 0.5 → 8 px)\n  const linjePixels = Math.max(8, Math.min(320, kartCm * 16));\n  const ptBx = 120 + linjePixels;\n  document.getElementById('vis-ptB').setAttribute('cx', ptBx);\n  document.getElementById('vis-lblB').setAttribute('x', ptBx + 4);\n  document.getElementById('vis-linje').setAttribute('x2', ptBx);\n\n  // Scalebar: 100 px = ? km/m\n  // 1 px = (n/96) cm * (1/100) m = n/9600 m\n  // Vi vil vise en \"round number\" for 100 px\n  const meterPer100px = n * (2.54 / 96); // 1 inch = 2.54 cm, 96 dpi screen\n  // Finn pen tallverdi\n  let sbVal = meterPer100px;\n  let sbUnit = 'm';\n  if (sbVal >= 1000) { sbVal /= 1000; sbUnit = 'km'; }\n  // Round to nice number\n  const sbNice = parseFloat(sbVal.toPrecision(2));\n  const sbNiceMid = parseFloat((sbVal / 2).toPrecision(2));\n\n  document.getElementById('sb-mid-lbl').textContent = formaterTall(sbNiceMid);\n  document.getElementById('sb-end-lbl').textContent = formaterTall(sbNice);\n  document.getElementById('sb-unit').textContent = sbUnit;\n\n  document.getElementById('vis-info-1').textContent = 'Kartavstand: ' + kartCm.toLocaleString('nb-NO', {minimumFractionDigits:1}) + ' cm';\n  document.getElementById('vis-info-2').textContent = '= ' + formaterTall(virkVis) + ' ' + virkEnhet;\n}\n\n// =============================================\n// INITIALISERING\n// =============================================\nwindow.addEventListener('DOMContentLoaded', function() {\n  kartKalkuler();\n  forstKalkuler();\n  arealKalkuler();\n  visKalkuler();\n});\n</script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Maalestokk og kart",
    "windowTitle": "Maalestokk og kart",
    "bundleId": "com.halisonworks.geomaalestokk",
    "iconPath": null
  },
  "categoryId": null,
  "source": "import",
  "createdAt": "2026-06-02T12:00:00.000Z",
  "updatedAt": "2026-06-02T12:00:00.000Z",
  "sharedAt": "2026-06-02T12:00:00.000Z"
}
