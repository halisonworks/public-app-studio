{
  "schema": "app-studio/canvas@1",
  "id": "example-geo-sirkelen",
  "name": "sirkelen.html",
  "code": "<!DOCTYPE html>\n<!--\n  Sirkelen — Halison App Studio-eksempel\n\n  Interaktivt læremiddel for geometri (matematikk 1P/2P, LK20): omkrets og areal\n  av sirkel, og sektorareal og buelengde.\n\n  Fra Halison App Studio sitt offentlige bibliotek:\n  https://github.com/halisonworks/public-app-studio\n\n  Tillatt bruk: personlig, pedagogisk og annen ikke-kommersiell bruk. Behold denne\n  headeren og kildelenken; ikke-kommersiell bruk. Utgitt under Halison App Studio\n  Examples License — se LICENSE-filen i repoet over.\n-->\n<html lang=\"no\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Sirkelen – Interaktiv geometri (1P/2P)</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    :root {\n      --color-primary: #1d4ed8;\n      --color-accent: #f59e0b;\n      --color-sector: #ef4444;\n    }\n\n    body {\n      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;\n    }\n\n    .formula-box {\n      background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);\n      border-left: 4px solid #1d4ed8;\n    }\n\n    .formula-box.sektor {\n      background: linear-gradient(135deg, #fff7ed 0%, #fed7aa 100%);\n      border-left: 4px solid #f59e0b;\n    }\n\n    .pi-box {\n      background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);\n      border-left: 4px solid #16a34a;\n    }\n\n    input[type=\"range\"] {\n      accent-color: var(--color-primary);\n    }\n\n    input[type=\"range\"].sektor-slider {\n      accent-color: var(--color-sector);\n    }\n\n    .value-badge {\n      display: inline-block;\n      padding: 2px 10px;\n      border-radius: 9999px;\n      font-weight: 700;\n      font-size: 1rem;\n      background: #1d4ed8;\n      color: #fff;\n      min-width: 3.5rem;\n      text-align: center;\n    }\n\n    .value-badge.orange {\n      background: #f59e0b;\n      color: #1a1a1a;\n    }\n\n    .value-badge.red {\n      background: #ef4444;\n      color: #fff;\n    }\n\n    .value-badge.green {\n      background: #16a34a;\n      color: #fff;\n    }\n\n    .tab-btn {\n      transition: background 0.15s, color 0.15s, border-color 0.15s;\n    }\n\n    .tab-btn.active {\n      background: #1d4ed8;\n      color: #fff;\n      border-color: #1d4ed8;\n    }\n\n    .tab-content {\n      display: none;\n    }\n\n    .tab-content.active {\n      display: block;\n    }\n\n    svg text {\n      font-family: 'Segoe UI', system-ui, sans-serif;\n      user-select: none;\n    }\n\n    .highlight-change {\n      animation: flash 0.35s ease-out;\n    }\n\n    @keyframes flash {\n      0% { background-color: #fef9c3; }\n      100% { background-color: transparent; }\n    }\n  </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 min-h-screen\">\n\n  <!-- Header -->\n  <header class=\"bg-blue-700 text-white shadow-lg\">\n    <div class=\"max-w-4xl mx-auto px-4 py-5\">\n      <h1 class=\"text-2xl md:text-3xl font-bold tracking-tight\">Sirkelen</h1>\n      <p class=\"text-blue-200 text-sm mt-1\">Interaktivt læremiddel · Matematikk 1P/2P · LK20</p>\n    </div>\n  </header>\n\n  <!-- Tabs -->\n  <div class=\"max-w-4xl mx-auto px-4 mt-6\">\n    <div class=\"flex gap-2 flex-wrap\">\n      <button id=\"tab-btn-sirkel\" class=\"tab-btn active px-5 py-2 rounded-full border-2 border-blue-700 font-semibold text-sm focus:outline-none\" onclick=\"showTab('sirkel')\">\n        Sirkel\n      </button>\n      <button id=\"tab-btn-sektor\" class=\"tab-btn px-5 py-2 rounded-full border-2 border-slate-300 font-semibold text-sm text-slate-600 hover:border-blue-400 focus:outline-none\" onclick=\"showTab('sektor')\">\n        Sektor\n      </button>\n      <button id=\"tab-btn-pi\" class=\"tab-btn px-5 py-2 rounded-full border-2 border-slate-300 font-semibold text-sm text-slate-600 hover:border-green-500 focus:outline-none\" onclick=\"showTab('pi')\">\n        Hva er π?\n      </button>\n    </div>\n  </div>\n\n  <main class=\"max-w-4xl mx-auto px-4 py-6 space-y-6\">\n\n    <!-- ===================== TAB: SIRKEL ===================== -->\n    <section id=\"tab-sirkel\" class=\"tab-content active space-y-6\">\n\n      <!-- Intro tekst -->\n      <div class=\"bg-white rounded-2xl shadow-sm p-5 border border-slate-100\">\n        <h2 class=\"text-xl font-bold text-blue-700 mb-2\">Radius, diameter, omkrets og areal</h2>\n        <p class=\"text-slate-600 text-sm leading-relaxed\">\n          En sirkel er mengden av alle punkter som er like langt fra ett bestemt punkt – <strong>sentrum</strong>.\n          Avstanden fra sentrum til sirkelen kalles <strong>radius</strong> (r). Bruk glidebryteren nedenfor\n          til å utforske hvordan radius påvirker omkrets og areal.\n        </p>\n      </div>\n\n      <!-- Formler -->\n      <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n        <div class=\"formula-box rounded-xl p-4\">\n          <p class=\"text-xs font-semibold text-blue-500 uppercase tracking-widest mb-1\">Formler</p>\n          <ul class=\"space-y-1 text-sm font-mono text-slate-700\">\n            <li><span class=\"font-bold text-blue-700\">d</span> = 2r &nbsp;(diameter)</li>\n            <li><span class=\"font-bold text-blue-700\">O</span> = 2πr = πd &nbsp;(omkrets)</li>\n            <li><span class=\"font-bold text-blue-700\">A</span> = πr² &nbsp;(areal)</li>\n          </ul>\n        </div>\n        <div class=\"formula-box rounded-xl p-4\">\n          <p class=\"text-xs font-semibold text-blue-500 uppercase tracking-widest mb-1\">Nåværende verdier</p>\n          <ul class=\"space-y-2 text-sm text-slate-700\">\n            <li>Radius <span class=\"value-badge\" id=\"val-r\">5</span> cm</li>\n            <li>Diameter <span class=\"value-badge orange\" id=\"val-d\">10</span> cm</li>\n            <li>Omkrets <span class=\"value-badge green\" id=\"val-o\">31,42</span> cm</li>\n            <li>Areal <span class=\"value-badge red\" id=\"val-a\">78,54</span> cm²</li>\n          </ul>\n        </div>\n      </div>\n\n      <!-- SVG + Slider -->\n      <div class=\"bg-white rounded-2xl shadow-sm p-5 border border-slate-100 flex flex-col items-center gap-5\">\n        <svg id=\"sirkel-svg\" viewBox=\"0 0 300 300\" width=\"280\" height=\"280\" aria-label=\"Interaktiv sirkel\">\n          <!-- Grid bakgrunn (lette linjer) -->\n          <defs>\n            <pattern id=\"grid\" width=\"20\" height=\"20\" patternUnits=\"userSpaceOnUse\">\n              <path d=\"M 20 0 L 0 0 0 20\" fill=\"none\" stroke=\"#e2e8f0\" stroke-width=\"0.5\"/>\n            </pattern>\n          </defs>\n          <rect width=\"300\" height=\"300\" fill=\"url(#grid)\"/>\n\n          <!-- Sirkel -->\n          <circle id=\"svg-circle\" cx=\"150\" cy=\"150\" r=\"80\"\n            fill=\"rgba(59,130,246,0.12)\" stroke=\"#1d4ed8\" stroke-width=\"2.5\"/>\n\n          <!-- Sentrum -->\n          <circle cx=\"150\" cy=\"150\" r=\"4\" fill=\"#1d4ed8\"/>\n\n          <!-- Radius-linje -->\n          <line id=\"svg-radius-line\" x1=\"150\" y1=\"150\" x2=\"230\" y2=\"150\"\n            stroke=\"#1d4ed8\" stroke-width=\"1.8\" stroke-dasharray=\"5,3\"/>\n\n          <!-- Diameter-linje -->\n          <line id=\"svg-diameter-line\" x1=\"70\" y1=\"150\" x2=\"230\" y2=\"150\"\n            stroke=\"#f59e0b\" stroke-width=\"1.5\" stroke-dasharray=\"2,4\" opacity=\"0.7\"/>\n\n          <!-- Etiketter -->\n          <text id=\"svg-label-r\" x=\"185\" y=\"143\" fill=\"#1d4ed8\" font-size=\"12\" font-weight=\"600\">r = 5 cm</text>\n          <text id=\"svg-label-d\" x=\"108\" y=\"168\" fill=\"#b45309\" font-size=\"11\" opacity=\"0.85\">d = 10 cm</text>\n          <text id=\"svg-label-o\" x=\"150\" y=\"270\" fill=\"#16a34a\" font-size=\"11\" text-anchor=\"middle\">O ≈ 31,42 cm</text>\n          <text id=\"svg-label-a\" x=\"150\" y=\"285\" fill=\"#ef4444\" font-size=\"11\" text-anchor=\"middle\">A ≈ 78,54 cm²</text>\n        </svg>\n\n        <!-- Slider -->\n        <div class=\"w-full max-w-xs space-y-1\">\n          <label for=\"slider-r\" class=\"flex justify-between text-sm font-medium text-slate-700\">\n            <span>Radius (r)</span>\n            <span id=\"slider-r-display\" class=\"text-blue-700 font-bold\">5 cm</span>\n          </label>\n          <input type=\"range\" id=\"slider-r\" min=\"1\" max=\"13\" step=\"0.5\" value=\"5\"\n            class=\"w-full h-2 rounded-lg cursor-pointer\"\n            oninput=\"updateSirkel()\" />\n          <div class=\"flex justify-between text-xs text-slate-400\">\n            <span>1 cm</span>\n            <span>13 cm</span>\n          </div>\n        </div>\n      </div>\n\n      <!-- Utregning steg-for-steg -->\n      <div class=\"bg-white rounded-2xl shadow-sm p-5 border border-slate-100\">\n        <h3 class=\"font-bold text-slate-700 mb-3 text-base\">Utregning steg for steg</h3>\n        <div id=\"steg-sirkel\" class=\"text-sm text-slate-600 space-y-1 font-mono\"></div>\n      </div>\n\n    </section>\n\n    <!-- ===================== TAB: SEKTOR ===================== -->\n    <section id=\"tab-sektor\" class=\"tab-content space-y-6\">\n\n      <div class=\"bg-white rounded-2xl shadow-sm p-5 border border-slate-100\">\n        <h2 class=\"text-xl font-bold text-amber-600 mb-2\">Sektor – sentralvinkel, sektorareal og buelengde</h2>\n        <p class=\"text-slate-600 text-sm leading-relaxed\">\n          En <strong>sektor</strong> er «kakestykket» du klipper ut av sirkelen med to radier og en bue.\n          Størrelsen bestemmes av <strong>sentralvinkelen v</strong> (i grader).\n          Juster radius og vinkel for å se hvordan sektorarealet og buelengden endrer seg.\n        </p>\n      </div>\n\n      <!-- Formler sektor -->\n      <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n        <div class=\"formula-box sektor rounded-xl p-4\">\n          <p class=\"text-xs font-semibold text-amber-600 uppercase tracking-widest mb-1\">Formler</p>\n          <ul class=\"space-y-1 text-sm font-mono text-slate-700\">\n            <li><span class=\"font-bold text-amber-600\">A<sub>s</sub></span> = (v / 360) · πr²</li>\n            <li><span class=\"font-bold text-amber-600\">l</span> = (v / 360) · 2πr</li>\n          </ul>\n          <p class=\"text-xs text-slate-500 mt-2\">v = sentralvinkel (°), r = radius</p>\n        </div>\n        <div class=\"formula-box sektor rounded-xl p-4\">\n          <p class=\"text-xs font-semibold text-amber-600 uppercase tracking-widest mb-1\">Nåværende verdier</p>\n          <ul class=\"space-y-2 text-sm text-slate-700\">\n            <li>Radius <span class=\"value-badge\" id=\"sek-val-r\">6</span> cm</li>\n            <li>Sentralvinkel <span class=\"value-badge orange\" id=\"sek-val-v\">90</span>°</li>\n            <li>Buelengde <span class=\"value-badge green\" id=\"sek-val-l\">9,42</span> cm</li>\n            <li>Sektorareal <span class=\"value-badge red\" id=\"sek-val-a\">28,27</span> cm²</li>\n          </ul>\n        </div>\n      </div>\n\n      <!-- SVG sektor + slidere -->\n      <div class=\"bg-white rounded-2xl shadow-sm p-5 border border-slate-100 flex flex-col items-center gap-5\">\n        <svg id=\"sektor-svg\" viewBox=\"0 0 300 300\" width=\"280\" height=\"280\" aria-label=\"Interaktiv sektor\">\n          <defs>\n            <pattern id=\"grid2\" width=\"20\" height=\"20\" patternUnits=\"userSpaceOnUse\">\n              <path d=\"M 20 0 L 0 0 0 20\" fill=\"none\" stroke=\"#e2e8f0\" stroke-width=\"0.5\"/>\n            </pattern>\n          </defs>\n          <rect width=\"300\" height=\"300\" fill=\"url(#grid2)\"/>\n\n          <!-- Hel sirkelkontur (grå) -->\n          <circle id=\"sek-full-circle\" cx=\"150\" cy=\"150\" r=\"90\"\n            fill=\"none\" stroke=\"#cbd5e1\" stroke-width=\"1.5\" stroke-dasharray=\"4,3\"/>\n\n          <!-- Sektor (fylt) -->\n          <path id=\"sek-sector-path\" d=\"\"\n            fill=\"rgba(245,158,11,0.25)\" stroke=\"#f59e0b\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/>\n\n          <!-- Buen-markering (rød) -->\n          <path id=\"sek-arc-path\" d=\"\"\n            fill=\"none\" stroke=\"#ef4444\" stroke-width=\"3\" stroke-linecap=\"round\"/>\n\n          <!-- Sentrum -->\n          <circle cx=\"150\" cy=\"150\" r=\"4\" fill=\"#1d4ed8\"/>\n\n          <!-- Vinkelmarkering (liten bue) -->\n          <path id=\"sek-angle-arc\" d=\"\" fill=\"none\" stroke=\"#6366f1\" stroke-width=\"1.5\"/>\n\n          <!-- Etiketter -->\n          <text id=\"sek-label-v\" x=\"150\" y=\"270\" fill=\"#6366f1\" font-size=\"11\" text-anchor=\"middle\"></text>\n          <text id=\"sek-label-l\" x=\"150\" y=\"284\" fill=\"#ef4444\" font-size=\"11\" text-anchor=\"middle\"></text>\n          <text id=\"sek-label-a\" x=\"150\" y=\"298\" fill=\"#b45309\" font-size=\"11\" text-anchor=\"middle\"></text>\n        </svg>\n\n        <!-- Slidere -->\n        <div class=\"w-full max-w-xs space-y-4\">\n          <div class=\"space-y-1\">\n            <label for=\"slider-sek-r\" class=\"flex justify-between text-sm font-medium text-slate-700\">\n              <span>Radius (r)</span>\n              <span id=\"slider-sek-r-display\" class=\"text-blue-700 font-bold\">6 cm</span>\n            </label>\n            <input type=\"range\" id=\"slider-sek-r\" min=\"1\" max=\"13\" step=\"0.5\" value=\"6\"\n              class=\"w-full h-2 rounded-lg cursor-pointer\"\n              oninput=\"updateSektor()\" />\n            <div class=\"flex justify-between text-xs text-slate-400\">\n              <span>1 cm</span>\n              <span>13 cm</span>\n            </div>\n          </div>\n\n          <div class=\"space-y-1\">\n            <label for=\"slider-sek-v\" class=\"flex justify-between text-sm font-medium text-slate-700\">\n              <span>Sentralvinkel (v)</span>\n              <span id=\"slider-sek-v-display\" class=\"text-red-600 font-bold\">90°</span>\n            </label>\n            <input type=\"range\" id=\"slider-sek-v\" min=\"1\" max=\"359\" step=\"1\" value=\"90\"\n              class=\"sektor-slider w-full h-2 rounded-lg cursor-pointer\"\n              oninput=\"updateSektor()\" />\n            <div class=\"flex justify-between text-xs text-slate-400\">\n              <span>1°</span>\n              <span>359°</span>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Utregning steg-for-steg sektor -->\n      <div class=\"bg-white rounded-2xl shadow-sm p-5 border border-slate-100\">\n        <h3 class=\"font-bold text-slate-700 mb-3 text-base\">Utregning steg for steg</h3>\n        <div id=\"steg-sektor\" class=\"text-sm text-slate-600 space-y-1 font-mono\"></div>\n      </div>\n\n    </section>\n\n    <!-- ===================== TAB: PI ===================== -->\n    <section id=\"tab-pi\" class=\"tab-content space-y-6\">\n\n      <div class=\"bg-white rounded-2xl shadow-sm p-5 border border-slate-100\">\n        <h2 class=\"text-xl font-bold text-green-700 mb-2\">Hva er π (pi)?</h2>\n        <p class=\"text-slate-600 text-sm leading-relaxed mb-4\">\n          Tallet π (pi) er forholdet mellom <strong>omkretsen</strong> og <strong>diameteren</strong> til en sirkel –\n          uansett hvor stor eller liten sirkelen er. Det vil si:\n        </p>\n        <div class=\"pi-box rounded-xl p-4 text-center mb-4\">\n          <p class=\"text-2xl font-bold text-green-700 font-mono\">π = O / d</p>\n          <p class=\"text-slate-500 text-sm mt-1\">omkrets delt på diameter – alltid det samme tallet</p>\n        </div>\n        <p class=\"text-slate-600 text-sm leading-relaxed\">\n          π er et <em>irrasjonalt tall</em>: desimalene fortsetter i det uendelige uten mønster.\n          De første sifrene er <strong>3,14159265358979…</strong>\n          I beregninger bruker vi gjerne <strong>π ≈ 3,14</strong> (2 desimaler) eller den eksakte verdien på kalkulatoren.\n        </p>\n      </div>\n\n      <!-- Interaktiv Pi-demonstrasjon -->\n      <div class=\"bg-white rounded-2xl shadow-sm p-5 border border-slate-100\">\n        <h3 class=\"font-bold text-slate-700 mb-3\">Utforsk: diameter og omkrets</h3>\n        <p class=\"text-slate-500 text-sm mb-4\">\n          Endre diameteren og se at <strong>O ÷ d alltid er ≈ π</strong>.\n        </p>\n\n        <div class=\"flex flex-col items-center gap-4\">\n          <svg id=\"pi-svg\" viewBox=\"0 0 300 200\" width=\"300\" height=\"200\" aria-label=\"Pi-illustrasjon\">\n            <defs>\n              <pattern id=\"grid3\" width=\"20\" height=\"20\" patternUnits=\"userSpaceOnUse\">\n                <path d=\"M 20 0 L 0 0 0 20\" fill=\"none\" stroke=\"#e2e8f0\" stroke-width=\"0.5\"/>\n              </pattern>\n            </defs>\n            <rect width=\"300\" height=\"200\" fill=\"url(#grid3)\"/>\n\n            <!-- Sirkel -->\n            <circle id=\"pi-circle\" cx=\"150\" cy=\"100\" r=\"60\"\n              fill=\"rgba(22,163,74,0.10)\" stroke=\"#16a34a\" stroke-width=\"2.2\"/>\n\n            <!-- Diameter -->\n            <line id=\"pi-diameter-line\" x1=\"90\" y1=\"100\" x2=\"210\" y2=\"100\"\n              stroke=\"#6366f1\" stroke-width=\"2\" stroke-dasharray=\"4,3\"/>\n\n            <!-- Pil markering diameter -->\n            <polygon id=\"pi-arrow-r\" points=\"210,100 204,96 204,104\" fill=\"#6366f1\"/>\n            <polygon id=\"pi-arrow-l\" points=\"90,100 96,96 96,104\" fill=\"#6366f1\"/>\n\n            <!-- Etikett diameter -->\n            <text id=\"pi-label-d\" x=\"150\" y=\"92\" fill=\"#6366f1\" font-size=\"11\" font-weight=\"600\" text-anchor=\"middle\">d = 8 cm</text>\n\n            <!-- Etikett omkrets -->\n            <text id=\"pi-label-o\" x=\"150\" y=\"175\" fill=\"#16a34a\" font-size=\"11\" font-weight=\"600\" text-anchor=\"middle\">O ≈ 25,13 cm</text>\n            <text id=\"pi-label-ratio\" x=\"150\" y=\"190\" fill=\"#ef4444\" font-size=\"11\" font-weight=\"700\" text-anchor=\"middle\">O ÷ d = π ≈ 3,14159…</text>\n          </svg>\n\n          <div class=\"w-full max-w-xs space-y-1\">\n            <label for=\"slider-pi-d\" class=\"flex justify-between text-sm font-medium text-slate-700\">\n              <span>Diameter (d)</span>\n              <span id=\"slider-pi-d-display\" class=\"text-green-700 font-bold\">8 cm</span>\n            </label>\n            <input type=\"range\" id=\"slider-pi-d\" min=\"2\" max=\"16\" step=\"0.5\" value=\"8\"\n              class=\"w-full h-2 rounded-lg cursor-pointer\"\n              style=\"accent-color: #16a34a;\"\n              oninput=\"updatePi()\" />\n            <div class=\"flex justify-between text-xs text-slate-400\">\n              <span>2 cm</span>\n              <span>16 cm</span>\n            </div>\n          </div>\n\n          <!-- Tabell med eksempler -->\n          <div class=\"w-full overflow-x-auto mt-2\">\n            <table class=\"w-full text-sm text-center border-collapse\">\n              <thead>\n                <tr class=\"bg-green-50 text-green-700 font-semibold\">\n                  <th class=\"border border-green-200 px-3 py-2\">Diameter d</th>\n                  <th class=\"border border-green-200 px-3 py-2\">Omkrets O</th>\n                  <th class=\"border border-green-200 px-3 py-2\">O ÷ d</th>\n                </tr>\n              </thead>\n              <tbody class=\"text-slate-600\" id=\"pi-table-body\">\n                <!-- Fylles av JS -->\n              </tbody>\n            </table>\n          </div>\n        </div>\n      </div>\n\n      <!-- π desimaler -->\n      <div class=\"pi-box rounded-2xl p-5\">\n        <h3 class=\"font-bold text-green-700 mb-2\">De første 20 desimalene av π</h3>\n        <p class=\"font-mono text-slate-700 text-base break-all leading-relaxed\">\n          3.<span class=\"text-green-700 font-bold\">14159265358979323846</span>…\n        </p>\n        <p class=\"text-slate-500 text-xs mt-2\">\n          I skolematematikk bruker vi <strong>π ≈ 3,14</strong> eller <strong>π-knappen</strong> på kalkulatoren.\n          Husk: norsk desimaltegn er komma (3,14), ikke punktum.\n        </p>\n      </div>\n\n    </section>\n\n  </main>\n\n  <footer class=\"max-w-4xl mx-auto px-4 pb-8 mt-2 text-center text-xs text-slate-400\">\n    Halison App Studio-eksempel · Matematikk 1P/2P · LK20 ·\n    <a href=\"https://github.com/halisonworks/public-app-studio\" class=\"underline hover:text-blue-500\" target=\"_blank\" rel=\"noopener\">\n      github.com/halisonworks/public-app-studio\n    </a>\n  </footer>\n\n  <script>\n    'use strict';\n\n    // ============================================================\n    // Hjelpefunksjoner\n    // ============================================================\n\n    /** Formater tall norsk stil (komma som desimaltegn, gitt antall desimaler) */\n    function norsk(num, des) {\n      return num.toFixed(des).replace('.', ',');\n    }\n\n    /** Konverter grader til radianer */\n    function toRad(deg) {\n      return (deg * Math.PI) / 180;\n    }\n\n    /**\n     * Beregn SVG-bane for en sektor med sentrum (cx,cy), radius r, startvinkel alpha (rad),\n     * og sluttpunkt bestemt av sentralvinkel v (grader).\n     * Returnerer {sectorPath, arcPath}\n     */\n    function sektorPath(cx, cy, r, startDeg, vDeg) {\n      var startRad = toRad(startDeg);\n      var endRad   = toRad(startDeg + vDeg);\n      var x1 = cx + r * Math.cos(startRad);\n      var y1 = cy + r * Math.sin(startRad);\n      var x2 = cx + r * Math.cos(endRad);\n      var y2 = cy + r * Math.sin(endRad);\n      var large = vDeg > 180 ? 1 : 0;\n\n      var sectorPath = [\n        'M', cx, cy,\n        'L', x1, y1,\n        'A', r, r, 0, large, 1, x2, y2,\n        'Z'\n      ].join(' ');\n\n      var arcPath = [\n        'M', x1, y1,\n        'A', r, r, 0, large, 1, x2, y2\n      ].join(' ');\n\n      return { sectorPath: sectorPath, arcPath: arcPath };\n    }\n\n    /** Liten vinkelbuepath (for vinkelmarkering i sentrum) */\n    function vinkelArcPath(cx, cy, r, startDeg, vDeg) {\n      if (vDeg >= 359) return '';\n      var startRad = toRad(startDeg);\n      var endRad   = toRad(startDeg + vDeg);\n      var x1 = cx + r * Math.cos(startRad);\n      var y1 = cy + r * Math.sin(startRad);\n      var x2 = cx + r * Math.cos(endRad);\n      var y2 = cy + r * Math.sin(endRad);\n      var large = vDeg > 180 ? 1 : 0;\n      return ['M', x1, y1, 'A', r, r, 0, large, 1, x2, y2].join(' ');\n    }\n\n    // ============================================================\n    // Tab-bytte\n    // ============================================================\n    function showTab(id) {\n      var tabs = ['sirkel', 'sektor', 'pi'];\n      tabs.forEach(function(t) {\n        var content = document.getElementById('tab-' + t);\n        var btn = document.getElementById('tab-btn-' + t);\n        if (t === id) {\n          content.classList.add('active');\n          btn.classList.add('active');\n          btn.classList.remove('border-slate-300', 'text-slate-600');\n        } else {\n          content.classList.remove('active');\n          btn.classList.remove('active');\n          btn.classList.add('border-slate-300', 'text-slate-600');\n        }\n      });\n    }\n\n    // ============================================================\n    // TAB 1: SIRKEL\n    // ============================================================\n    function updateSirkel() {\n      var r = parseFloat(document.getElementById('slider-r').value);\n      var d = 2 * r;\n      var O = 2 * Math.PI * r;\n      var A = Math.PI * r * r;\n\n      // Oppdater badges\n      setText('val-r', norsk(r, 1));\n      setText('val-d', norsk(d, 1));\n      setText('val-o', norsk(O, 2));\n      setText('val-a', norsk(A, 2));\n      setText('slider-r-display', norsk(r, 1) + ' cm');\n\n      // Skaler SVG-sirkel (maks radius = 13 cm → 125 px i SVG)\n      var scale = 125 / 13;\n      var svgR  = r * scale;\n      var cx = 150, cy = 150;\n\n      setAttr('svg-circle', 'r', svgR);\n      setAttr('svg-radius-line', 'x2', cx + svgR);\n      setAttr('svg-diameter-line', 'x1', cx - svgR);\n      setAttr('svg-diameter-line', 'x2', cx + svgR);\n\n      var midR = cx + svgR / 2;\n      setAttr('svg-label-r', 'x', midR - 15);\n      document.getElementById('svg-label-r').textContent = 'r = ' + norsk(r, 1) + ' cm';\n      document.getElementById('svg-label-d').textContent = 'd = ' + norsk(d, 1) + ' cm';\n      document.getElementById('svg-label-o').textContent = 'O ≈ ' + norsk(O, 2) + ' cm';\n      document.getElementById('svg-label-a').textContent = 'A ≈ ' + norsk(A, 2) + ' cm²';\n\n      // Plasser tekst riktig\n      var oy = cy + svgR + 18;\n      if (oy > 270) oy = 270;\n      setAttr('svg-label-o', 'y', oy);\n      setAttr('svg-label-a', 'y', oy + 14);\n\n      // Steg for steg\n      var steg = [\n        'd = 2 · r = 2 · ' + norsk(r, 1) + ' = ' + norsk(d, 1) + ' cm',\n        'O = 2 · π · r = 2 · 3,14159… · ' + norsk(r, 1) + ' ≈ ' + norsk(O, 2) + ' cm',\n        'A = π · r² = π · ' + norsk(r, 1) + '² = π · ' + norsk(r * r, 2) + ' ≈ ' + norsk(A, 2) + ' cm²'\n      ];\n      document.getElementById('steg-sirkel').innerHTML = steg.map(function(s) {\n        return '<p class=\"py-0.5 border-b border-slate-100\">' + s + '</p>';\n      }).join('');\n    }\n\n    // ============================================================\n    // TAB 2: SEKTOR\n    // ============================================================\n    function updateSektor() {\n      var r = parseFloat(document.getElementById('slider-sek-r').value);\n      var v = parseFloat(document.getElementById('slider-sek-v').value);\n\n      var As = (v / 360) * Math.PI * r * r;\n      var l  = (v / 360) * 2 * Math.PI * r;\n\n      // Badges\n      setText('sek-val-r', norsk(r, 1));\n      setText('sek-val-v', norsk(v, 0));\n      setText('sek-val-l', norsk(l, 2));\n      setText('sek-val-a', norsk(As, 2));\n      setText('slider-sek-r-display', norsk(r, 1) + ' cm');\n      setText('slider-sek-v-display', norsk(v, 0) + '°');\n\n      // SVG\n      var scale = 120 / 13;\n      var svgR  = r * scale;\n      var cx = 150, cy = 150;\n\n      setAttr('sek-full-circle', 'r', svgR);\n\n      // Start fra høyre (0°) og gå med klokka (SVG y-akse peker ned)\n      var startDeg = -90; // topp av sirkelen\n      var paths = sektorPath(cx, cy, svgR, startDeg, v);\n      document.getElementById('sek-sector-path').setAttribute('d', paths.sectorPath);\n      document.getElementById('sek-arc-path').setAttribute('d', paths.arcPath);\n\n      // Vinkelmarkering\n      var vArc = vinkelArcPath(cx, cy, 22, startDeg, v);\n      document.getElementById('sek-angle-arc').setAttribute('d', vArc);\n\n      // Etiketter\n      var yBase = cy + svgR + 15;\n      if (yBase > 268) yBase = 268;\n\n      var labelEl = document.getElementById('sek-label-v');\n      labelEl.setAttribute('y', yBase);\n      labelEl.textContent = 'v = ' + norsk(v, 0) + '°';\n\n      var lEl = document.getElementById('sek-label-l');\n      lEl.setAttribute('y', yBase + 14);\n      lEl.textContent = 'Buelengde l ≈ ' + norsk(l, 2) + ' cm';\n\n      var aEl = document.getElementById('sek-label-a');\n      aEl.setAttribute('y', yBase + 28);\n      if (yBase + 28 > 300) {\n        aEl.setAttribute('y', 298);\n        lEl.setAttribute('y', 284);\n        labelEl.setAttribute('y', 270);\n      }\n      aEl.textContent = 'Sektorareal ≈ ' + norsk(As, 2) + ' cm²';\n\n      // Steg for steg\n      var steg = [\n        'r = ' + norsk(r, 1) + ' cm,  v = ' + norsk(v, 0) + '°',\n        'Buelengde: l = (v/360) · 2πr = (' + norsk(v, 0) + '/360) · 2π · ' + norsk(r, 1),\n        '  = ' + norsk(v / 360, 4) + ' · ' + norsk(2 * Math.PI * r, 4) + ' ≈ ' + norsk(l, 2) + ' cm',\n        'Sektorareal: As = (v/360) · πr² = (' + norsk(v, 0) + '/360) · π · ' + norsk(r, 1) + '²',\n        '  = ' + norsk(v / 360, 4) + ' · ' + norsk(Math.PI * r * r, 4) + ' ≈ ' + norsk(As, 2) + ' cm²'\n      ];\n      document.getElementById('steg-sektor').innerHTML = steg.map(function(s) {\n        return '<p class=\"py-0.5 border-b border-slate-100\">' + s + '</p>';\n      }).join('');\n    }\n\n    // ============================================================\n    // TAB 3: PI\n    // ============================================================\n    function updatePi() {\n      var d = parseFloat(document.getElementById('slider-pi-d').value);\n      var r = d / 2;\n      var O = Math.PI * d;\n\n      setText('slider-pi-d-display', norsk(d, 1) + ' cm');\n\n      // SVG\n      var maxD  = 16;\n      var scale = 90 / maxD; // maks radius = 90/2 = 45 ved d=16... justert\n      var svgR  = r * scale;\n      var cx = 150, cy = 100;\n\n      setAttr('pi-circle', 'r', svgR);\n      setAttr('pi-circle', 'cx', cx);\n      setAttr('pi-circle', 'cy', cy);\n\n      setAttr('pi-diameter-line', 'x1', cx - svgR);\n      setAttr('pi-diameter-line', 'x2', cx + svgR);\n      setAttr('pi-diameter-line', 'y1', cy);\n      setAttr('pi-diameter-line', 'y2', cy);\n\n      setAttr('pi-arrow-r', 'points', (cx + svgR) + ',' + cy + ' ' + (cx + svgR - 6) + ',' + (cy - 4) + ' ' + (cx + svgR - 6) + ',' + (cy + 4));\n      setAttr('pi-arrow-l', 'points', (cx - svgR) + ',' + cy + ' ' + (cx - svgR + 6) + ',' + (cy - 4) + ' ' + (cx - svgR + 6) + ',' + (cy + 4));\n\n      document.getElementById('pi-label-d').textContent = 'd = ' + norsk(d, 1) + ' cm';\n      document.getElementById('pi-label-d').setAttribute('x', cx);\n      document.getElementById('pi-label-d').setAttribute('y', cy - svgR - 6 > 20 ? cy - svgR - 6 : 14);\n\n      document.getElementById('pi-label-o').textContent = 'O = π · d = π · ' + norsk(d, 1) + ' ≈ ' + norsk(O, 2) + ' cm';\n      document.getElementById('pi-label-ratio').textContent = 'O ÷ d = ' + norsk(O, 5) + ' ÷ ' + norsk(d, 1) + ' = π ≈ 3,14159…';\n\n      // Tabell\n      var diameters = [2, 4, 6, 8, 10, 12, 14, 16];\n      var tbody = document.getElementById('pi-table-body');\n      tbody.innerHTML = diameters.map(function(di) {\n        var oi = Math.PI * di;\n        var ratio = oi / di;\n        var highlight = Math.abs(di - d) < 0.01 ? ' class=\"bg-green-50 font-semibold\"' : '';\n        return '<tr' + highlight + '>' +\n          '<td class=\"border border-slate-200 px-3 py-1\">' + norsk(di, 0) + ' cm</td>' +\n          '<td class=\"border border-slate-200 px-3 py-1\">' + norsk(oi, 2) + ' cm</td>' +\n          '<td class=\"border border-slate-200 px-3 py-1 text-green-700 font-mono\">' + norsk(ratio, 5) + '</td>' +\n          '</tr>';\n      }).join('');\n    }\n\n    // ============================================================\n    // DOM-hjelpere\n    // ============================================================\n    function setText(id, val) {\n      var el = document.getElementById(id);\n      if (el) el.textContent = val;\n    }\n\n    function setAttr(id, attr, val) {\n      var el = document.getElementById(id);\n      if (el) el.setAttribute(attr, val);\n    }\n\n    // ============================================================\n    // Init\n    // ============================================================\n    updateSirkel();\n    updateSektor();\n    updatePi();\n  </script>\n\n</body>\n</html>\n",
  "packaging": {
    "appName": "Sirkelen",
    "windowTitle": "Sirkelen",
    "bundleId": "com.halisonworks.geosirkelen",
    "iconPath": null
  },
  "categoryId": null,
  "source": "import",
  "createdAt": "2026-06-02T12:00:00.000Z",
  "updatedAt": "2026-06-02T12:00:00.000Z",
  "sharedAt": "2026-06-02T12:00:00.000Z"
}
