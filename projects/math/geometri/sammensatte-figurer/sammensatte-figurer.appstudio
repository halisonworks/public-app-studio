{
  "schema": "app-studio/canvas@1",
  "id": "example-geo-sammensatte-figurer",
  "name": "sammensatte-figurer.html",
  "code": "<!DOCTYPE html>\n<!--\n  Sammensatte figurer — Halison App Studio-eksempel\n\n  Interaktivt læremiddel for geometri (matematikk 1P/2P, LK20): finn areal og\n  omkrets av sammensatte figurer ved å dele dem opp i kjente deler.\n\n  Fra Halison App Studio sitt offentlige bibliotek:\n  https://github.com/halisonworks/public-app-studio\n\n  Tillatt bruk: personlig, pedagogisk og annen ikke-kommersiell bruk. Behold denne\n  headeren og kildelenken; ikke-kommersiell bruk. Utgitt under Halison App Studio\n  Examples License — se LICENSE-filen i repoet over.\n-->\n<html lang=\"no\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Sammensatte figurer – Areal og omkrets</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Segoe UI', system-ui, sans-serif; }\n    .part-highlight { transition: opacity 0.3s, filter 0.3s; }\n    .part-highlight.dim { opacity: 0.3; }\n    .part-label { font-size: 13px; font-weight: 600; }\n    input[type=range] { accent-color: #6366f1; }\n    .step-card { border-left: 4px solid #6366f1; }\n    .formula-box { font-family: 'Courier New', monospace; }\n    svg text { user-select: none; }\n    .tab-btn.active { background: #6366f1; color: #fff; }\n    .tab-btn { transition: background 0.2s, color 0.2s; }\n  </style>\n</head>\n<body class=\"bg-slate-50 min-h-screen\">\n\n<!-- Header -->\n<header class=\"bg-indigo-700 text-white shadow-md\">\n  <div class=\"max-w-5xl mx-auto px-4 py-4 flex flex-col sm:flex-row items-start sm:items-center gap-2\">\n    <div>\n      <h1 class=\"text-2xl font-bold tracking-tight\">Sammensatte figurer</h1>\n      <p class=\"text-indigo-200 text-sm mt-0.5\">Areal og omkrets — Matematikk 1P/2P (LK20)</p>\n    </div>\n    <span class=\"sm:ml-auto bg-indigo-600 text-indigo-100 text-xs px-3 py-1 rounded-full font-medium\">Interaktivt læremiddel</span>\n  </div>\n</header>\n\n<!-- Intro -->\n<section class=\"max-w-5xl mx-auto px-4 pt-6 pb-2\">\n  <div class=\"bg-white rounded-xl shadow-sm border border-slate-200 p-5\">\n    <h2 class=\"text-lg font-semibold text-slate-800 mb-2\">Hva er en sammensatt figur?</h2>\n    <p class=\"text-slate-600 text-sm leading-relaxed\">\n      En <strong>sammensatt figur</strong> er en figur som består av to eller flere kjente grunnformer\n      (rektangler, trekanter, sirkler osv.). For å finne arealet kan vi enten\n      <span class=\"text-indigo-700 font-semibold\">addere</span> delene eller\n      <span class=\"text-rose-600 font-semibold\">subtrahere</span> et utskåret område fra en større figur.\n      Omkretsen er summen av alle <em>ytterlige</em> sider.\n    </p>\n    <div class=\"mt-3 flex flex-wrap gap-3 text-sm\">\n      <span class=\"bg-indigo-50 text-indigo-800 px-3 py-1 rounded-lg border border-indigo-200\">\n        Rektangel: A = l · b\n      </span>\n      <span class=\"bg-emerald-50 text-emerald-800 px-3 py-1 rounded-lg border border-emerald-200\">\n        Trekant: A = ½ · g · h\n      </span>\n      <span class=\"bg-amber-50 text-amber-800 px-3 py-1 rounded-lg border border-amber-200\">\n        Sirkel: A = π · r²\n      </span>\n      <span class=\"bg-rose-50 text-rose-800 px-3 py-1 rounded-lg border border-rose-200\">\n        Halvsirkel: A = ½ · π · r²\n      </span>\n    </div>\n  </div>\n</section>\n\n<!-- Figure selector tabs -->\n<section class=\"max-w-5xl mx-auto px-4 pt-5\">\n  <div class=\"flex flex-wrap gap-2 mb-1\" id=\"tabs\">\n    <button class=\"tab-btn active text-sm font-medium px-4 py-2 rounded-lg border border-indigo-300\" data-tab=\"0\">L-formet rom</button>\n    <button class=\"tab-btn text-sm font-medium px-4 py-2 rounded-lg border border-slate-300 bg-white text-slate-700\" data-tab=\"1\">Hus med trekanttak</button>\n    <button class=\"tab-btn text-sm font-medium px-4 py-2 rounded-lg border border-slate-300 bg-white text-slate-700\" data-tab=\"2\">Rektangel med sirkulært hull</button>\n  </div>\n</section>\n\n<!-- Main content area -->\n<main class=\"max-w-5xl mx-auto px-4 pb-10\">\n  <div id=\"figure-container\" class=\"bg-white rounded-xl shadow-sm border border-slate-200 mt-0 p-5\">\n\n    <!-- Figure title & description -->\n    <div class=\"mb-4\">\n      <h2 id=\"fig-title\" class=\"text-xl font-bold text-slate-800\"></h2>\n      <p id=\"fig-desc\" class=\"text-slate-500 text-sm mt-1\"></p>\n    </div>\n\n    <!-- Two-column layout: SVG + steps -->\n    <div class=\"flex flex-col lg:flex-row gap-6\">\n\n      <!-- SVG panel -->\n      <div class=\"flex-1 flex flex-col items-center\">\n        <div id=\"svg-container\" class=\"w-full flex justify-center\"></div>\n\n        <!-- Part highlight buttons (generated per figure) -->\n        <div id=\"highlight-controls\" class=\"mt-3 flex flex-wrap gap-2 justify-center\"></div>\n\n        <!-- Sliders -->\n        <div id=\"sliders\" class=\"mt-4 w-full max-w-xs space-y-4\"></div>\n      </div>\n\n      <!-- Steps panel -->\n      <div class=\"lg:w-80 flex flex-col gap-3\">\n        <div id=\"method-badge\" class=\"text-xs font-semibold px-3 py-1 rounded-full self-start\"></div>\n        <div id=\"steps-container\" class=\"space-y-3\"></div>\n        <div id=\"result-box\" class=\"rounded-xl p-4 border-2 mt-1\"></div>\n      </div>\n\n    </div>\n  </div>\n\n  <!-- Forklaring av metode -->\n  <div class=\"mt-6 bg-indigo-50 border border-indigo-200 rounded-xl p-5\">\n    <h3 class=\"font-semibold text-indigo-800 mb-2\">Fremgangsmåte — steg for steg</h3>\n    <ol class=\"list-decimal list-inside text-sm text-indigo-900 space-y-1 leading-relaxed\">\n      <li>Identifiser hvilke grunnformer figuren består av (eller hva som er fjernet).</li>\n      <li>Merk av mål på figuren og sett inn kjente formler.</li>\n      <li>Regn ut arealet for hver del.</li>\n      <li>Adder (eller subtraher) delene for totalarealet.</li>\n      <li>Finn omkretsen ved å legge sammen alle <em>ytterste</em> kanter.</li>\n    </ol>\n  </div>\n</main>\n\n<script>\n// ─── Utility ───────────────────────────────────────────────────────────────────\nfunction round2(n) { return Math.round(n * 100) / 100; }\nfunction fmt(n) {\n  const r = round2(n);\n  return Number.isInteger(r) ? r.toString() : r.toFixed(2);\n}\n\n// ─── Figure definitions ────────────────────────────────────────────────────────\n\n// Each figure returns { svgHtml, parts, steps, result } given current dims.\n// dims = { [key]: value }\n\nconst FIGURES = [\n\n  // ── 0: L-formet rom ──────────────────────────────────────────────────────────\n  {\n    title: 'L-formet rom',\n    desc:  'Et L-formet rom deles i to rektangler. Arealet finnes ved addisjon.',\n    method: 'Addisjon av deler',\n    methodColor: 'bg-indigo-100 text-indigo-800',\n    sliders: [\n      { key: 'a', label: 'Totalbredde (a)', min: 4, max: 12, step: 0.5, unit: 'm' },\n      { key: 'b', label: 'Totalhøyde (b)',  min: 4, max: 12, step: 0.5, unit: 'm' },\n      { key: 'c', label: 'Utsprang bredde (c)', min: 1, max: 6, step: 0.5, unit: 'm' },\n      { key: 'd', label: 'Utsprang høyde (d)',  min: 1, max: 6, step: 0.5, unit: 'm' },\n    ],\n    defaults: { a: 8, b: 6, c: 3, d: 3 },\n    clamp(dims) {\n      dims.c = Math.min(dims.c, dims.a - 1);\n      dims.d = Math.min(dims.d, dims.b - 1);\n      return dims;\n    },\n    parts: [\n      { id: 'p1', label: 'Del 1 (A₁)', color: '#6366f1', colorLight: '#e0e7ff' },\n      { id: 'p2', label: 'Del 2 (A₂)', color: '#06b6d4', colorLight: '#cffafe' },\n    ],\n    compute(dims) {\n      const { a, b, c, d } = dims;\n      // Split: bottom rectangle full width, top-left rectangle\n      const A1 = a * (b - d);          // bottom strip: full width × (b-d) height\n      const A2 = (a - c) * d;          // top-left: (a-c) width × d height\n      // Wait — standard L: one big rect + one small rect\n      // Let's define: rect1 = a × (b-d) [lower], rect2 = (a-c) × d [upper-left]\n      const totalA = A1 + A2;\n      // Perimeter: trace the L shape\n      // Lower-left corner going clockwise:\n      // bottom: a, right side: b, top of upper-right notch: c, step down: d, step left to (a-c), step up: 0 already counted wrong\n      // Correct perimeter of L-shape:\n      const perim = a + b + c + d + (a - c) + (b - d);\n      return { A1, A2, totalA, perim };\n    },\n    render(dims, highlighted) {\n      const { a, b, c, d } = dims;\n      const res = this.compute(dims);\n      const S = 40; // scale: pixels per metre\n      const PAD = 30;\n      const W = a * S + PAD * 2;\n      const H = b * S + PAD * 2;\n      // Coordinates in SVG (y increases downward)\n      // L-shape: full rect minus top-right corner\n      // Bottom-left of figure at (PAD, PAD+b*S)\n      const ox = PAD, oy = PAD;\n      // L polygon points (clockwise from top-left):\n      // top-left: (ox, oy)\n      // top-right of left part: (ox+(a-c)*S, oy)\n      // inner corner step down: (ox+(a-c)*S, oy+d*S)\n      // top-right: (ox+a*S, oy+d*S)\n      // bottom-right: (ox+a*S, oy+b*S)\n      // bottom-left: (ox, oy+b*S)\n      const pts = [\n        [ox,           oy],\n        [ox+(a-c)*S,   oy],\n        [ox+(a-c)*S,   oy+d*S],\n        [ox+a*S,       oy+d*S],\n        [ox+a*S,       oy+b*S],\n        [ox,           oy+b*S],\n      ];\n      const poly = pts.map(p=>p.join(',')).join(' ');\n\n      const dim1 = highlighted === 'p1' ? 0.9 : (highlighted === 'p2' ? 0.2 : 0.85);\n      const dim2 = highlighted === 'p2' ? 0.9 : (highlighted === 'p1' ? 0.2 : 0.6);\n\n      // Rect1 (bottom strip): x=ox, y=oy+d*S, w=a*S, h=(b-d)*S\n      const r1x=ox, r1y=oy+d*S, r1w=a*S, r1h=(b-d)*S;\n      // Rect2 (top-left): x=ox, y=oy, w=(a-c)*S, h=d*S\n      const r2x=ox, r2y=oy, r2w=(a-c)*S, r2h=d*S;\n\n      const svgW = W, svgH = H;\n\n      let svg = `<svg viewBox=\"0 0 ${svgW} ${svgH}\" width=\"${svgW}\" height=\"${svgH}\" xmlns=\"http://www.w3.org/2000/svg\">`;\n\n      // Part 1 fill\n      svg += `<rect x=\"${r1x}\" y=\"${r1y}\" width=\"${r1w}\" height=\"${r1h}\" fill=\"#e0e7ff\" opacity=\"${dim1}\" class=\"part-highlight\" data-part=\"p1\"/>`;\n      // Part 2 fill\n      svg += `<rect x=\"${r2x}\" y=\"${r2y}\" width=\"${r2w}\" height=\"${r2h}\" fill=\"#cffafe\" opacity=\"${dim2}\" class=\"part-highlight\" data-part=\"p2\"/>`;\n      // Divider line\n      svg += `<line x1=\"${r2x}\" y1=\"${oy+d*S}\" x2=\"${r2x+r2w}\" y2=\"${oy+d*S}\" stroke=\"#94a3b8\" stroke-width=\"1.5\" stroke-dasharray=\"6,3\"/>`;\n\n      // Outline\n      svg += `<polygon points=\"${poly}\" fill=\"none\" stroke=\"#1e293b\" stroke-width=\"2.5\"/>`;\n\n      // Part labels\n      const cx1 = r1x + r1w/2, cy1 = r1y + r1h/2;\n      const cx2 = r2x + r2w/2, cy2 = r2y + r2h/2;\n      svg += `<text x=\"${cx1}\" y=\"${cy1}\" text-anchor=\"middle\" dominant-baseline=\"middle\" class=\"part-label\" fill=\"#4338ca\" opacity=\"${dim1}\">A₁ = ${fmt(res.A1)} m²</text>`;\n      svg += `<text x=\"${cx2}\" y=\"${cy2}\" text-anchor=\"middle\" dominant-baseline=\"middle\" class=\"part-label\" fill=\"#0891b2\" opacity=\"${dim2}\">A₂ = ${fmt(res.A2)} m²</text>`;\n\n      // Dimension annotations\n      svg += dimArrow(ox, oy+b*S+10, ox+a*S, oy+b*S+10, `a = ${fmt(a)} m`, 'below');\n      svg += dimArrow(ox-10, oy, ox-10, oy+b*S, `b = ${fmt(b)} m`, 'left');\n      svg += dimArrow(ox+(a-c)*S, oy-10, ox+a*S, oy-10, `c = ${fmt(c)} m`, 'above');\n      svg += dimArrow(ox+a*S+10, oy+d*S, ox+a*S+10, oy+b*S, `(b−d) = ${fmt(b-d)} m`, 'right');\n\n      svg += '</svg>';\n      return svg;\n    },\n    buildSteps(dims) {\n      const { a, b, c, d } = dims;\n      const res = this.compute(dims);\n      return [\n        {\n          title: 'Del figuren i to rektangler',\n          text: `Del 1 (nedre): bredde = <b>${fmt(a)} m</b>, høyde = <b>${fmt(b-d)} m</b><br>\n                 Del 2 (øvre venstre): bredde = <b>${fmt(a-c)} m</b>, høyde = <b>${fmt(d)} m</b>`,\n          color: '#e0e7ff', border: '#6366f1'\n        },\n        {\n          title: 'Regn ut arealet av Del 1',\n          formula: `A₁ = ${fmt(a)} · ${fmt(b-d)} = ${fmt(res.A1)} m²`,\n          color: '#ede9fe', border: '#7c3aed'\n        },\n        {\n          title: 'Regn ut arealet av Del 2',\n          formula: `A₂ = ${fmt(a-c)} · ${fmt(d)} = ${fmt(res.A2)} m²`,\n          color: '#cffafe', border: '#06b6d4'\n        },\n        {\n          title: 'Totalarealet',\n          formula: `A = A₁ + A₂ = ${fmt(res.A1)} + ${fmt(res.A2)} = ${fmt(res.totalA)} m²`,\n          color: '#f0fdf4', border: '#22c55e'\n        },\n        {\n          title: 'Omkrets',\n          text: `Legg sammen alle yttersider:<br>\n                 O = a + b + c + d + (a−c) + (b−d)<br>\n                 = ${fmt(a)} + ${fmt(b)} + ${fmt(c)} + ${fmt(d)} + ${fmt(a-c)} + ${fmt(b-d)}`,\n          formula: `O = ${fmt(res.perim)} m`,\n          color: '#fef9c3', border: '#ca8a04'\n        },\n      ];\n    },\n  },\n\n  // ── 1: Hus med trekanttak ────────────────────────────────────────────────────\n  {\n    title: 'Hus med trekanttak',\n    desc:  'Et hus består av et rektangel (vegger) og en likebent trekant (tak). Addér delene.',\n    method: 'Addisjon av deler',\n    methodColor: 'bg-indigo-100 text-indigo-800',\n    sliders: [\n      { key: 'w', label: 'Husbredde (b)',    min: 3, max: 12, step: 0.5, unit: 'm' },\n      { key: 'wh', label: 'Vegg-høyde (h₁)', min: 2, max: 8,  step: 0.5, unit: 'm' },\n      { key: 'th', label: 'Tak-høyde (h₂)',  min: 1, max: 6,  step: 0.5, unit: 'm' },\n    ],\n    defaults: { w: 8, wh: 4, th: 3 },\n    clamp(d) { return d; },\n    parts: [\n      { id: 'p1', label: 'Rektangel (A₁)', color: '#f59e0b', colorLight: '#fef3c7' },\n      { id: 'p2', label: 'Trekant (A₂)',   color: '#ef4444', colorLight: '#fee2e2' },\n    ],\n    compute(dims) {\n      const { w, wh, th } = dims;\n      const A1 = w * wh;\n      const A2 = 0.5 * w * th;\n      const totalA = A1 + A2;\n      // Skråsider av taket (Pytagoras): √((w/2)²+th²)\n      const slope = Math.sqrt((w/2)**2 + th**2);\n      const perim = w + wh + slope + slope + wh; // bottom + left wall + left slope + right slope + right wall\n      return { A1, A2, totalA, slope, perim };\n    },\n    render(dims, highlighted) {\n      const { w, wh, th } = dims;\n      const res = this.compute(dims);\n      const S = 40;\n      const PAD = 35;\n      const svgW = w * S + PAD * 2;\n      const svgH = (wh + th) * S + PAD * 2;\n      const ox = PAD, oy = PAD;\n\n      const dim1 = highlighted === 'p1' ? 0.9 : (highlighted === 'p2' ? 0.2 : 0.85);\n      const dim2 = highlighted === 'p2' ? 0.9 : (highlighted === 'p1' ? 0.2 : 0.7);\n\n      // Rectangle: bottom\n      const rx = ox, ry = oy + th*S, rw = w*S, rh = wh*S;\n      // Triangle: apex at top centre\n      const tx1 = ox, ty1 = oy + th*S;\n      const tx2 = ox + w*S, ty2 = oy + th*S;\n      const tx3 = ox + (w/2)*S, ty3 = oy;\n\n      let svg = `<svg viewBox=\"0 0 ${svgW} ${svgH}\" width=\"${svgW}\" height=\"${svgH}\" xmlns=\"http://www.w3.org/2000/svg\">`;\n\n      svg += `<rect x=\"${rx}\" y=\"${ry}\" width=\"${rw}\" height=\"${rh}\" fill=\"#fef3c7\" opacity=\"${dim1}\" class=\"part-highlight\" data-part=\"p1\"/>`;\n      svg += `<polygon points=\"${tx1},${ty1} ${tx2},${ty2} ${tx3},${ty3}\" fill=\"#fee2e2\" opacity=\"${dim2}\" class=\"part-highlight\" data-part=\"p2\"/>`;\n\n      // Outlines\n      svg += `<rect x=\"${rx}\" y=\"${ry}\" width=\"${rw}\" height=\"${rh}\" fill=\"none\" stroke=\"#1e293b\" stroke-width=\"2.5\"/>`;\n      svg += `<polygon points=\"${tx1},${ty1} ${tx2},${ty2} ${tx3},${ty3}\" fill=\"none\" stroke=\"#1e293b\" stroke-width=\"2.5\"/>`;\n\n      // Labels\n      svg += `<text x=\"${rx+rw/2}\" y=\"${ry+rh/2}\" text-anchor=\"middle\" dominant-baseline=\"middle\" class=\"part-label\" fill=\"#b45309\" opacity=\"${dim1}\">A₁ = ${fmt(res.A1)} m²</text>`;\n      svg += `<text x=\"${rx+rw/2}\" y=\"${oy+th*S/2}\" text-anchor=\"middle\" dominant-baseline=\"middle\" class=\"part-label\" fill=\"#b91c1c\" opacity=\"${dim2}\">A₂ = ${fmt(res.A2)} m²</text>`;\n\n      // Dim annotations\n      svg += dimArrow(ox, oy+(th+wh)*S+12, ox+w*S, oy+(th+wh)*S+12, `b = ${fmt(w)} m`, 'below');\n      svg += dimArrow(ox-12, oy+th*S, ox-12, oy+(th+wh)*S, `h₁ = ${fmt(wh)} m`, 'left');\n      svg += dimArrow(ox+w*S+12, oy, ox+w*S+12, oy+th*S, `h₂ = ${fmt(th)} m`, 'right');\n\n      svg += '</svg>';\n      return svg;\n    },\n    buildSteps(dims) {\n      const { w, wh, th } = dims;\n      const res = this.compute(dims);\n      return [\n        {\n          title: 'Identifiser delene',\n          text: 'Figuren består av ett <b>rektangel</b> (veggene) og én <b>trekant</b> (taket).',\n          color: '#fff7ed', border: '#f59e0b'\n        },\n        {\n          title: 'Areal av rektangelet (vegger)',\n          formula: `A₁ = b · h₁ = ${fmt(w)} · ${fmt(wh)} = ${fmt(res.A1)} m²`,\n          color: '#fef3c7', border: '#f59e0b'\n        },\n        {\n          title: 'Areal av trekanten (tak)',\n          formula: `A₂ = ½ · g · h = ½ · ${fmt(w)} · ${fmt(th)} = ${fmt(res.A2)} m²`,\n          color: '#fee2e2', border: '#ef4444'\n        },\n        {\n          title: 'Totalareal',\n          formula: `A = A₁ + A₂ = ${fmt(res.A1)} + ${fmt(res.A2)} = ${fmt(res.totalA)} m²`,\n          color: '#f0fdf4', border: '#22c55e'\n        },\n        {\n          title: 'Omkrets',\n          text: `Skråside (Pytagoras): s = √((b/2)² + h₂²) = √(${fmt(w/2)}² + ${fmt(th)}²) = ${fmt(res.slope)} m`,\n          formula: `O = b + 2·h₁ + 2·s = ${fmt(w)} + 2·${fmt(wh)} + 2·${fmt(res.slope)} = ${fmt(res.perim)} m`,\n          color: '#fef9c3', border: '#ca8a04'\n        },\n      ];\n    },\n  },\n\n  // ── 2: Rektangel med sirkulært hull ─────────────────────────────────────────\n  {\n    title: 'Rektangel med sirkulært hull',\n    desc:  'Et rektangel med et sirkulært hull i midten. Arealet finnes ved subtraksjon.',\n    method: 'Subtraksjon av del',\n    methodColor: 'bg-rose-100 text-rose-800',\n    sliders: [\n      { key: 'w', label: 'Bredde (b)',   min: 4, max: 14, step: 0.5, unit: 'm' },\n      { key: 'h', label: 'Høyde (h)',    min: 3, max: 10, step: 0.5, unit: 'm' },\n      { key: 'r', label: 'Radius (r)',   min: 0.5, max: 3, step: 0.1, unit: 'm' },\n    ],\n    defaults: { w: 10, h: 6, r: 2 },\n    clamp(dims) {\n      const maxR = Math.min(dims.w, dims.h) / 2 - 0.5;\n      dims.r = Math.min(dims.r, Math.max(0.5, maxR));\n      return dims;\n    },\n    parts: [\n      { id: 'p1', label: 'Rektangel (A₁)', color: '#8b5cf6', colorLight: '#ede9fe' },\n      { id: 'p2', label: 'Sirkel (A₂)',    color: '#ef4444', colorLight: '#fee2e2' },\n    ],\n    compute(dims) {\n      const { w, h, r } = dims;\n      const A1 = w * h;\n      const A2 = Math.PI * r * r;\n      const totalA = A1 - A2;\n      // Perimeter: outer rect perimeter + inner circle circumference\n      const perim = 2 * (w + h) + 2 * Math.PI * r;\n      return { A1, A2, totalA, perim };\n    },\n    render(dims, highlighted) {\n      const { w, h, r } = dims;\n      const res = this.compute(dims);\n      const S = 40;\n      const PAD = 35;\n      const svgW = w * S + PAD * 2;\n      const svgH = h * S + PAD * 2;\n      const ox = PAD, oy = PAD;\n      const cx = ox + w*S/2, cy = oy + h*S/2;\n      const cr = r * S;\n\n      const dim1 = highlighted === 'p1' ? 0.9 : (highlighted === 'p2' ? 0.2 : 0.8);\n      const dim2 = highlighted === 'p2' ? 0.9 : (highlighted === 'p1' ? 0.2 : 0.85);\n\n      let svg = `<svg viewBox=\"0 0 ${svgW} ${svgH}\" width=\"${svgW}\" height=\"${svgH}\" xmlns=\"http://www.w3.org/2000/svg\">`;\n\n      // Rect fill\n      svg += `<rect x=\"${ox}\" y=\"${oy}\" width=\"${w*S}\" height=\"${h*S}\" fill=\"#ede9fe\" opacity=\"${dim1}\"/>`;\n      // Circle cutout (white, then dashed border)\n      svg += `<circle cx=\"${cx}\" cy=\"${cy}\" r=\"${cr}\" fill=\"white\" opacity=\"${dim2}\"/>`;\n      svg += `<circle cx=\"${cx}\" cy=\"${cy}\" r=\"${cr}\" fill=\"#fee2e2\" opacity=\"${dim2 * 0.5}\"/>`;\n\n      // Rect outline\n      svg += `<rect x=\"${ox}\" y=\"${oy}\" width=\"${w*S}\" height=\"${h*S}\" fill=\"none\" stroke=\"#1e293b\" stroke-width=\"2.5\"/>`;\n      // Circle outline\n      svg += `<circle cx=\"${cx}\" cy=\"${cy}\" r=\"${cr}\" fill=\"none\" stroke=\"#ef4444\" stroke-width=\"2.5\" stroke-dasharray=\"8,4\"/>`;\n      // Radius line\n      svg += `<line x1=\"${cx}\" y1=\"${cy}\" x2=\"${cx+cr}\" y2=\"${cy}\" stroke=\"#ef4444\" stroke-width=\"1.5\"/>`;\n      svg += `<text x=\"${cx+cr/2}\" y=\"${cy-6}\" text-anchor=\"middle\" class=\"part-label\" fill=\"#ef4444\" font-size=\"12\">r = ${fmt(r)} m</text>`;\n\n      // Labels\n      svg += `<text x=\"${ox + 20}\" y=\"${oy + 20}\" text-anchor=\"start\" class=\"part-label\" fill=\"#6d28d9\" opacity=\"${dim1}\" font-size=\"13\">A₁ = ${fmt(res.A1)} m²</text>`;\n      svg += `<text x=\"${cx}\" y=\"${cy+4}\" text-anchor=\"middle\" class=\"part-label\" fill=\"#b91c1c\" opacity=\"${dim2}\" font-size=\"12\">A₂ = ${fmt(res.A2)} m²</text>`;\n\n      // Dim annotations\n      svg += dimArrow(ox, oy+h*S+12, ox+w*S, oy+h*S+12, `b = ${fmt(w)} m`, 'below');\n      svg += dimArrow(ox-12, oy, ox-12, oy+h*S, `h = ${fmt(h)} m`, 'left');\n\n      svg += '</svg>';\n      return svg;\n    },\n    buildSteps(dims) {\n      const { w, h, r } = dims;\n      const res = this.compute(dims);\n      return [\n        {\n          title: 'Metode: subtraksjon',\n          text: 'Start med hele rektangelet og <b>trekk fra</b> arealet av det sirkulære hullet.',\n          color: '#fdf2f8', border: '#d946ef'\n        },\n        {\n          title: 'Areal av hele rektangelet',\n          formula: `A₁ = b · h = ${fmt(w)} · ${fmt(h)} = ${fmt(res.A1)} m²`,\n          color: '#ede9fe', border: '#8b5cf6'\n        },\n        {\n          title: 'Areal av det sirkulære hullet',\n          formula: `A₂ = π · r² = π · ${fmt(r)}² ≈ ${fmt(res.A2)} m²`,\n          color: '#fee2e2', border: '#ef4444'\n        },\n        {\n          title: 'Totalareal (subtraksjon)',\n          formula: `A = A₁ − A₂ = ${fmt(res.A1)} − ${fmt(res.A2)} ≈ ${fmt(res.totalA)} m²`,\n          color: '#f0fdf4', border: '#22c55e'\n        },\n        {\n          title: 'Omkrets',\n          text: 'Yttersidene inkluderer kantene av rektangelet <em>og</em> kanten av hullet (sirkelomkrets).',\n          formula: `O = 2(b+h) + 2πr = 2·(${fmt(w)}+${fmt(h)}) + 2π·${fmt(r)} ≈ ${fmt(res.perim)} m`,\n          color: '#fef9c3', border: '#ca8a04'\n        },\n      ];\n    },\n  },\n\n];\n\n// ─── SVG dimension arrow helper ────────────────────────────────────────────────\nfunction dimArrow(x1, y1, x2, y2, label, side) {\n  // Draw a thin dimension line with arrowheads and label\n  const mx = (x1 + x2) / 2, my = (y1 + y2) / 2;\n  let lx = mx, ly = my;\n  const offset = 0;\n  let anchor = 'middle', dy = 0;\n  if (side === 'below') { ly = y1 + 4; dy = 12; anchor = 'middle'; }\n  if (side === 'above') { ly = y1 - 4; dy = -4; anchor = 'middle'; }\n  if (side === 'left')  { lx = x1 - 4; anchor = 'end'; dy = 4; }\n  if (side === 'right') { lx = x1 + 4; anchor = 'start'; dy = 4; }\n\n  let out = `<line x1=\"${x1}\" y1=\"${y1}\" x2=\"${x2}\" y2=\"${y2}\" stroke=\"#64748b\" stroke-width=\"1\" marker-start=\"url(#arr)\" marker-end=\"url(#arr)\"/>`;\n  out += `<text x=\"${lx}\" y=\"${ly + dy}\" text-anchor=\"${anchor}\" font-size=\"11\" fill=\"#475569\">${label}</text>`;\n  return out;\n}\n\nfunction svgDefs() {\n  return `<defs>\n    <marker id=\"arr\" markerWidth=\"6\" markerHeight=\"6\" refX=\"3\" refY=\"3\" orient=\"auto-start-reverse\">\n      <path d=\"M0,0 L0,6 L6,3 z\" fill=\"#64748b\"/>\n    </marker>\n  </defs>`;\n}\n\n// ─── State ─────────────────────────────────────────────────────────────────────\nlet currentFig = 0;\nlet currentDims = {};\nlet highlighted = null;\n\nfunction initFig(idx) {\n  currentFig = idx;\n  const fig = FIGURES[idx];\n  currentDims = {};\n  fig.sliders.forEach(s => { currentDims[s.key] = fig.defaults[s.key]; });\n  highlighted = null;\n  renderAll();\n}\n\nfunction renderAll() {\n  const fig = FIGURES[currentFig];\n  fig.clamp(currentDims);\n\n  // Title / desc\n  document.getElementById('fig-title').textContent = fig.title;\n  document.getElementById('fig-desc').textContent = fig.desc;\n\n  // Method badge\n  const mb = document.getElementById('method-badge');\n  mb.textContent = fig.method;\n  mb.className = `text-xs font-semibold px-3 py-1 rounded-full self-start ${fig.methodColor}`;\n\n  // SVG\n  const svgEl = document.getElementById('svg-container');\n  const rawSvg = fig.render(currentDims, highlighted);\n  // Inject defs into the SVG\n  const svgWithDefs = rawSvg.replace('<svg ', '<svg ').replace('</svg>', svgDefs() + '</svg>');\n  svgEl.innerHTML = svgWithDefs;\n\n  // Highlight controls\n  const hc = document.getElementById('highlight-controls');\n  hc.innerHTML = '';\n  const resetBtn = document.createElement('button');\n  resetBtn.textContent = 'Vis alle deler';\n  resetBtn.className = `text-xs px-3 py-1 rounded-lg border font-medium transition ${highlighted === null ? 'bg-slate-700 text-white border-slate-700' : 'bg-white text-slate-700 border-slate-300'}`;\n  resetBtn.onclick = () => { highlighted = null; renderAll(); };\n  hc.appendChild(resetBtn);\n\n  fig.parts.forEach(p => {\n    const btn = document.createElement('button');\n    btn.textContent = p.label;\n    const isActive = highlighted === p.id;\n    btn.className = `text-xs px-3 py-1 rounded-lg border font-medium transition`;\n    btn.style.backgroundColor = isActive ? p.color : p.colorLight;\n    btn.style.color = isActive ? '#fff' : '#1e293b';\n    btn.style.borderColor = p.color;\n    btn.onclick = () => { highlighted = isActive ? null : p.id; renderAll(); };\n    hc.appendChild(btn);\n  });\n\n  // Sliders\n  const sl = document.getElementById('sliders');\n  sl.innerHTML = '';\n  fig.sliders.forEach(s => {\n    const val = currentDims[s.key];\n    const wrap = document.createElement('div');\n    wrap.className = 'space-y-1';\n    const labelRow = document.createElement('div');\n    labelRow.className = 'flex justify-between text-sm font-medium text-slate-700';\n    const lbl = document.createElement('span');\n    lbl.textContent = s.label;\n    const valSpan = document.createElement('span');\n    valSpan.className = 'text-indigo-700 font-bold';\n    valSpan.textContent = `${fmt(val)} ${s.unit}`;\n    labelRow.appendChild(lbl);\n    labelRow.appendChild(valSpan);\n    const input = document.createElement('input');\n    input.type = 'range';\n    input.min = s.min;\n    input.max = s.max;\n    input.step = s.step;\n    input.value = val;\n    input.className = 'w-full';\n    input.addEventListener('input', () => {\n      currentDims[s.key] = parseFloat(input.value);\n      renderAll();\n    });\n    wrap.appendChild(labelRow);\n    wrap.appendChild(input);\n    sl.appendChild(wrap);\n  });\n\n  // Steps\n  const sc = document.getElementById('steps-container');\n  sc.innerHTML = '';\n  const steps = fig.buildSteps(currentDims);\n  steps.forEach((step, i) => {\n    const card = document.createElement('div');\n    card.className = 'rounded-lg p-3 text-sm step-card';\n    card.style.backgroundColor = step.color;\n    card.style.borderLeftColor = step.border;\n    const title = document.createElement('div');\n    title.className = 'font-semibold text-slate-800 mb-1';\n    title.textContent = `${i + 1}. ${step.title}`;\n    card.appendChild(title);\n    if (step.text) {\n      const txt = document.createElement('div');\n      txt.className = 'text-slate-700 text-xs leading-relaxed mb-1';\n      txt.innerHTML = step.text;\n      card.appendChild(txt);\n    }\n    if (step.formula) {\n      const f = document.createElement('div');\n      f.className = 'formula-box bg-white rounded px-2 py-1 text-xs font-bold text-slate-900 border mt-1';\n      f.style.borderColor = step.border;\n      f.textContent = step.formula;\n      card.appendChild(f);\n    }\n    sc.appendChild(card);\n  });\n\n  // Result box\n  const rb = document.getElementById('result-box');\n  const res = fig.compute(currentDims);\n  rb.style.backgroundColor = '#f0fdf4';\n  rb.style.borderColor = '#16a34a';\n  rb.innerHTML = `\n    <div class=\"text-sm font-bold text-green-800 mb-1\">Svar</div>\n    <div class=\"formula-box text-base font-bold text-green-900\">A = ${fmt(res.totalA)} m²</div>\n    <div class=\"formula-box text-sm text-green-800 mt-1\">O = ${fmt(res.perim)} m</div>\n  `;\n}\n\n// ─── Tabs ──────────────────────────────────────────────────────────────────────\ndocument.getElementById('tabs').addEventListener('click', e => {\n  const btn = e.target.closest('[data-tab]');\n  if (!btn) return;\n  const idx = parseInt(btn.dataset.tab);\n  document.querySelectorAll('.tab-btn').forEach((b, i) => {\n    if (i === idx) {\n      b.classList.add('active');\n      b.classList.remove('bg-white', 'text-slate-700', 'border-slate-300');\n      b.classList.add('border-indigo-300');\n    } else {\n      b.classList.remove('active');\n      b.classList.add('bg-white', 'text-slate-700', 'border-slate-300');\n      b.classList.remove('border-indigo-300');\n    }\n  });\n  initFig(idx);\n});\n\n// ─── Boot ──────────────────────────────────────────────────────────────────────\ninitFig(0);\n</script>\n\n<footer class=\"max-w-5xl mx-auto px-4 pb-6 text-center text-xs text-slate-400\">\n  Halison App Studio – offentlig eksempelbibliotek &middot;\n  <a href=\"https://github.com/halisonworks/public-app-studio\" class=\"underline hover:text-indigo-500\" target=\"_blank\" rel=\"noopener\">GitHub</a>\n  &middot; Matematikk 1P/2P, LK20 &middot; Ikke-kommersiell bruk\n</footer>\n\n</body>\n</html>\n",
  "packaging": {
    "appName": "Sammensatte figurer",
    "windowTitle": "Sammensatte figurer",
    "bundleId": "com.halisonworks.geosammensatte",
    "iconPath": null
  },
  "categoryId": null,
  "source": "import",
  "createdAt": "2026-06-02T12:00:00.000Z",
  "updatedAt": "2026-06-02T12:00:00.000Z",
  "sharedAt": "2026-06-02T12:00:00.000Z"
}
