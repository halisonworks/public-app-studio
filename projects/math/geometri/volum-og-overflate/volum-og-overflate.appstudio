{
  "schema": "app-studio/canvas@1",
  "id": "example-geo-volum-og-overflate",
  "name": "volum-og-overflate.html",
  "code": "<!DOCTYPE html>\n<!--\n  Volum og overflate — Halison App Studio-eksempel\n\n  Interaktivt læremiddel for geometri (matematikk 1P/2P, LK20): volum og\n  overflate av prisme, sylinder, kule, kjegle og pyramide — med liter-omregning.\n\n  Fra Halison App Studio sitt offentlige bibliotek:\n  https://github.com/halisonworks/public-app-studio\n\n  Tillatt bruk: personlig, pedagogisk og annen ikke-kommersiell bruk. Behold denne\n  headeren og kildelenken; ikke-kommersiell bruk. Utgitt under Halison App Studio\n  Examples License — se LICENSE-filen i repoet over.\n-->\n<html lang=\"no\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Volum og overflate av romfigurer</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Segoe UI', system-ui, sans-serif; }\n    .shape-btn { transition: all 0.2s; }\n    .shape-btn.active { transform: scale(1.04); }\n    input[type=number]::-webkit-inner-spin-button,\n    input[type=number]::-webkit-outer-spin-button { opacity: 1; }\n    .result-block { border-left: 4px solid #6366f1; }\n    .formula-box { background: linear-gradient(135deg, #f0f4ff 0%, #e8f5ff 100%); }\n    .step { animation: fadeIn 0.3s ease; }\n    @keyframes fadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }\n    .svg-3d { filter: drop-shadow(2px 4px 6px rgba(0,0,0,0.18)); }\n    .unit-tag { font-size: 0.75rem; color: #6b7280; margin-left: 2px; }\n  </style>\n</head>\n<body class=\"bg-gray-50 min-h-screen\">\n\n<!-- HEADER -->\n<header class=\"bg-indigo-700 text-white py-5 px-4 shadow-lg\">\n  <div class=\"max-w-4xl mx-auto\">\n    <h1 class=\"text-2xl md:text-3xl font-bold tracking-tight\">Volum og overflate av romfigurer</h1>\n    <p class=\"text-indigo-200 text-sm mt-1\">Matematikk 1P/2P · Læreplanen LK20 · Velg en figur og juster målene</p>\n  </div>\n</header>\n\n<!-- SHAPE PICKER -->\n<nav class=\"bg-white shadow-sm sticky top-0 z-10\">\n  <div class=\"max-w-4xl mx-auto px-4 py-3 flex flex-wrap gap-2\">\n    <button onclick=\"selectShape('prisme')\" id=\"btn-prisme\"\n      class=\"shape-btn active px-4 py-2 rounded-lg font-semibold text-sm bg-indigo-600 text-white shadow\">\n      📦 Rett prisme\n    </button>\n    <button onclick=\"selectShape('sylinder')\" id=\"btn-sylinder\"\n      class=\"shape-btn px-4 py-2 rounded-lg font-semibold text-sm bg-gray-100 text-gray-700 hover:bg-indigo-50\">\n      🥫 Sylinder\n    </button>\n    <button onclick=\"selectShape('kule')\" id=\"btn-kule\"\n      class=\"shape-btn px-4 py-2 rounded-lg font-semibold text-sm bg-gray-100 text-gray-700 hover:bg-indigo-50\">\n      🔵 Kule\n    </button>\n    <button onclick=\"selectShape('kjegle')\" id=\"btn-kjegle\"\n      class=\"shape-btn px-4 py-2 rounded-lg font-semibold text-sm bg-gray-100 text-gray-700 hover:bg-indigo-50\">\n      🔺 Kjegle\n    </button>\n    <button onclick=\"selectShape('pyramide')\" id=\"btn-pyramide\"\n      class=\"shape-btn px-4 py-2 rounded-lg font-semibold text-sm bg-gray-100 text-gray-700 hover:bg-indigo-50\">\n      🏛️ Pyramide\n    </button>\n  </div>\n</nav>\n\n<!-- MAIN CONTENT -->\n<main class=\"max-w-4xl mx-auto px-4 py-8 space-y-8\">\n\n  <!-- FIGURE + INPUTS SIDE BY SIDE -->\n  <div class=\"grid md:grid-cols-2 gap-6\">\n\n    <!-- SVG FIGURE -->\n    <div class=\"bg-white rounded-2xl shadow p-6 flex flex-col items-center justify-center min-h-64\" id=\"svg-container\">\n      <!-- filled by JS -->\n    </div>\n\n    <!-- INPUTS & FORMULAS -->\n    <div class=\"space-y-5\">\n      <div class=\"bg-white rounded-2xl shadow p-5\">\n        <h2 class=\"text-lg font-bold text-gray-800 mb-4\" id=\"shape-title\">Rett prisme (kasse)</h2>\n\n        <!-- Formula display -->\n        <div class=\"formula-box rounded-xl p-4 mb-4 text-sm\" id=\"formula-display\">\n          <!-- filled by JS -->\n        </div>\n\n        <!-- Inputs -->\n        <div class=\"space-y-3\" id=\"inputs-container\">\n          <!-- filled by JS -->\n        </div>\n\n        <!-- Unit selector -->\n        <div class=\"mt-4\">\n          <label class=\"block text-xs font-semibold text-gray-500 mb-1\">Måleenhet</label>\n          <select id=\"unit-select\" onchange=\"recalc()\"\n            class=\"w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-300 outline-none\">\n            <option value=\"cm\">cm (centimeter)</option>\n            <option value=\"dm\">dm (desimeter)</option>\n            <option value=\"m\">m (meter)</option>\n          </select>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- RESULTS -->\n  <div class=\"bg-white rounded-2xl shadow p-6\" id=\"results-container\">\n    <!-- filled by JS -->\n  </div>\n\n  <!-- LITER CONVERSION -->\n  <div class=\"bg-indigo-50 border border-indigo-200 rounded-2xl p-6\" id=\"liter-container\">\n    <!-- filled by JS -->\n  </div>\n\n  <!-- INFO BOX -->\n  <div class=\"bg-amber-50 border border-amber-200 rounded-xl p-5 text-sm text-amber-900\">\n    <p class=\"font-bold mb-1\">Husk: enheter og volum</p>\n    <ul class=\"list-disc ml-5 space-y-1\">\n      <li>1 dm³ = 1 liter (L)</li>\n      <li>1 m³ = 1 000 liter</li>\n      <li>1 cm³ = 0,001 liter = 1 milliliter (mL)</li>\n      <li>Overflate måles i kvadratenheter (f.eks. cm²)</li>\n      <li>Volum måles i kubikkenheter (f.eks. cm³ eller dm³)</li>\n    </ul>\n  </div>\n\n</main>\n\n<footer class=\"text-center text-xs text-gray-400 py-6\">\n  Halison App Studio · Matematikk 1P/2P · LK20\n</footer>\n\n<script>\n// ─── STATE ───────────────────────────────────────────────────────────────────\nlet currentShape = 'prisme';\n\n// Default values per shape (in the chosen unit)\nconst defaults = {\n  prisme:   { l: 4, b: 3, h: 5 },\n  sylinder: { r: 3, h: 7 },\n  kule:     { r: 4 },\n  kjegle:   { r: 3, h: 8 },\n  pyramide: { l: 4, b: 4, h: 6 }\n};\n\n// ─── SHAPE METADATA ──────────────────────────────────────────────────────────\nconst shapes = {\n  prisme: {\n    title: 'Rett prisme (kasse / rektangulær prisme)',\n    formulaHtml: `\n      <p class=\"font-bold text-indigo-800 mb-1\">Formler — Rett prisme</p>\n      <p><strong>Volum:</strong> V = l · b · h</p>\n      <p><strong>Overflate:</strong> O = 2(l·b + l·h + b·h)</p>\n      <p class=\"text-xs text-gray-500 mt-1\">l = lengde, b = bredde, h = høyde</p>`,\n    inputs: [\n      { id: 'l', label: 'Lengde (l)', min: 0.1, step: 0.1, val: () => defaults.prisme.l },\n      { id: 'b', label: 'Bredde (b)', min: 0.1, step: 0.1, val: () => defaults.prisme.b },\n      { id: 'h', label: 'Høyde (h)', min: 0.1, step: 0.1, val: () => defaults.prisme.h }\n    ]\n  },\n  sylinder: {\n    title: 'Sylinder',\n    formulaHtml: `\n      <p class=\"font-bold text-indigo-800 mb-1\">Formler — Sylinder</p>\n      <p><strong>Volum:</strong> V = π · r² · h</p>\n      <p><strong>Overflate:</strong> O = 2π · r² + 2π · r · h = 2πr(r + h)</p>\n      <p class=\"text-xs text-gray-500 mt-1\">r = radius, h = høyde</p>`,\n    inputs: [\n      { id: 'r', label: 'Radius (r)', min: 0.1, step: 0.1, val: () => defaults.sylinder.r },\n      { id: 'h', label: 'Høyde (h)', min: 0.1, step: 0.1, val: () => defaults.sylinder.h }\n    ]\n  },\n  kule: {\n    title: 'Kule',\n    formulaHtml: `\n      <p class=\"font-bold text-indigo-800 mb-1\">Formler — Kule</p>\n      <p><strong>Volum:</strong> V = 4/3 · π · r³</p>\n      <p><strong>Overflate:</strong> O = 4 · π · r²</p>\n      <p class=\"text-xs text-gray-500 mt-1\">r = radius</p>`,\n    inputs: [\n      { id: 'r', label: 'Radius (r)', min: 0.1, step: 0.1, val: () => defaults.kule.r }\n    ]\n  },\n  kjegle: {\n    title: 'Kjegle',\n    formulaHtml: `\n      <p class=\"font-bold text-indigo-800 mb-1\">Formler — Kjegle</p>\n      <p><strong>Volum:</strong> V = 1/3 · π · r² · h</p>\n      <p><strong>Overflate:</strong> O = π · r² + π · r · s</p>\n      <p><strong>Slantelengde:</strong> s = √(r² + h²)</p>\n      <p class=\"text-xs text-gray-500 mt-1\">r = radius (bunn), h = høyde, s = slantelengde</p>`,\n    inputs: [\n      { id: 'r', label: 'Radius (r)', min: 0.1, step: 0.1, val: () => defaults.kjegle.r },\n      { id: 'h', label: 'Høyde (h)', min: 0.1, step: 0.1, val: () => defaults.kjegle.h }\n    ]\n  },\n  pyramide: {\n    title: 'Rett pyramide (rektangulær base)',\n    formulaHtml: `\n      <p class=\"font-bold text-indigo-800 mb-1\">Formler — Pyramide</p>\n      <p><strong>Volum:</strong> V = 1/3 · G · h</p>\n      <p><strong>Grunnflate:</strong> G = l · b</p>\n      <p><strong>Overflate:</strong> O = G + 2 · (½ · l · h<sub>l</sub>) + 2 · (½ · b · h<sub>b</sub>)</p>\n      <p class=\"text-xs text-gray-500 mt-1\">l = lengde, b = bredde, h = høyde · h<sub>l</sub> og h<sub>b</sub> er høydene i trekantflatene</p>`,\n    inputs: [\n      { id: 'l', label: 'Lengde (l)', min: 0.1, step: 0.1, val: () => defaults.pyramide.l },\n      { id: 'b', label: 'Bredde (b)', min: 0.1, step: 0.1, val: () => defaults.pyramide.b },\n      { id: 'h', label: 'Høyde (h)', min: 0.1, step: 0.1, val: () => defaults.pyramide.h }\n    ]\n  }\n};\n\n// ─── SVG GENERATORS ──────────────────────────────────────────────────────────\nfunction svgPrisme(l, b, h) {\n  // Isometric-ish box\n  const W = 200, H = 180;\n  const ox = 100, oy = 130;\n  const sx = 1.6, sy = 0.7; // skew for depth\n  const fw = Math.min(l * 10, 90);\n  const fh = Math.min(h * 10, 80);\n  const fd = Math.min(b * 8, 50);\n  const dx = fd * sx, dy = fd * sy;\n\n  const p = (x, y) => `${ox + x},${oy + y}`;\n  // Front face\n  const f = [[0,0],[fw,0],[fw,-fh],[0,-fh]];\n  // Top face\n  const t = [[0,-fh],[fw,-fh],[fw+dx,-fh-dy],[dx,-fh-dy]];\n  // Right face\n  const r = [[fw,0],[fw+dx,-dy],[fw+dx,-fh-dy],[fw,-fh]];\n\n  return `<svg viewBox=\"0 0 ${W} ${H}\" class=\"svg-3d w-full max-w-xs\">\n    <defs>\n      <linearGradient id=\"gFront\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n        <stop offset=\"0%\" stop-color=\"#818cf8\"/>\n        <stop offset=\"100%\" stop-color=\"#6366f1\"/>\n      </linearGradient>\n      <linearGradient id=\"gTop\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n        <stop offset=\"0%\" stop-color=\"#a5b4fc\"/>\n        <stop offset=\"100%\" stop-color=\"#818cf8\"/>\n      </linearGradient>\n      <linearGradient id=\"gRight\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"0\">\n        <stop offset=\"0%\" stop-color=\"#4f46e5\"/>\n        <stop offset=\"100%\" stop-color=\"#6366f1\"/>\n      </linearGradient>\n    </defs>\n    <!-- Front -->\n    <polygon points=\"${f.map(([x,y])=>p(x,y)).join(' ')}\" fill=\"url(#gFront)\" stroke=\"#3730a3\" stroke-width=\"1.5\"/>\n    <!-- Top -->\n    <polygon points=\"${t.map(([x,y])=>p(x,y)).join(' ')}\" fill=\"url(#gTop)\" stroke=\"#3730a3\" stroke-width=\"1.5\"/>\n    <!-- Right -->\n    <polygon points=\"${r.map(([x,y])=>p(x,y)).join(' ')}\" fill=\"url(#gRight)\" stroke=\"#3730a3\" stroke-width=\"1.5\"/>\n    <!-- Labels -->\n    <text x=\"${ox + fw/2}\" y=\"${oy + 14}\" text-anchor=\"middle\" font-size=\"11\" fill=\"#3730a3\" font-weight=\"bold\">l</text>\n    <text x=\"${ox + fw + dx/2 + 6}\" y=\"${oy - dy/2}\" text-anchor=\"start\" font-size=\"11\" fill=\"#3730a3\" font-weight=\"bold\">b</text>\n    <text x=\"${ox - 10}\" y=\"${oy - fh/2}\" text-anchor=\"end\" font-size=\"11\" fill=\"#3730a3\" font-weight=\"bold\">h</text>\n  </svg>`;\n}\n\nfunction svgSylinder(r, h) {\n  const W = 200, H = 200;\n  const cx = 100, ry = 18;\n  const width = Math.min(r * 18, 70);\n  const height = Math.min(h * 12, 110);\n  const top = 40;\n  const bot = top + height;\n\n  return `<svg viewBox=\"0 0 ${W} ${H}\" class=\"svg-3d w-full max-w-xs\">\n    <defs>\n      <linearGradient id=\"cylGrad\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"0\">\n        <stop offset=\"0%\" stop-color=\"#4f46e5\"/>\n        <stop offset=\"40%\" stop-color=\"#818cf8\"/>\n        <stop offset=\"100%\" stop-color=\"#4f46e5\"/>\n      </linearGradient>\n      <linearGradient id=\"cylTop\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n        <stop offset=\"0%\" stop-color=\"#a5b4fc\"/>\n        <stop offset=\"100%\" stop-color=\"#818cf8\"/>\n      </linearGradient>\n    </defs>\n    <!-- Body -->\n    <rect x=\"${cx - width}\" y=\"${top}\" width=\"${width*2}\" height=\"${height}\" fill=\"url(#cylGrad)\" stroke=\"#3730a3\" stroke-width=\"1.5\"/>\n    <!-- Bottom ellipse -->\n    <ellipse cx=\"${cx}\" cy=\"${bot}\" rx=\"${width}\" ry=\"${ry}\" fill=\"#4f46e5\" stroke=\"#3730a3\" stroke-width=\"1.5\"/>\n    <!-- Top ellipse -->\n    <ellipse cx=\"${cx}\" cy=\"${top}\" rx=\"${width}\" ry=\"${ry}\" fill=\"url(#cylTop)\" stroke=\"#3730a3\" stroke-width=\"1.5\"/>\n    <!-- Radius line -->\n    <line x1=\"${cx}\" y1=\"${top}\" x2=\"${cx+width}\" y2=\"${top}\" stroke=\"#e0e7ff\" stroke-width=\"1.5\" stroke-dasharray=\"4,3\"/>\n    <text x=\"${cx + width/2}\" y=\"${top - 6}\" text-anchor=\"middle\" font-size=\"11\" fill=\"#3730a3\" font-weight=\"bold\">r</text>\n    <!-- Height line -->\n    <line x1=\"${cx + width + 8}\" y1=\"${top}\" x2=\"${cx + width + 8}\" y2=\"${bot}\" stroke=\"#3730a3\" stroke-width=\"1.5\" marker-end=\"url(#arr)\"/>\n    <text x=\"${cx + width + 18}\" y=\"${top + height/2}\" text-anchor=\"start\" font-size=\"11\" fill=\"#3730a3\" font-weight=\"bold\">h</text>\n  </svg>`;\n}\n\nfunction svgKule(r) {\n  const W = 200, H = 200;\n  const cx = 100, cy = 100;\n  const rad = Math.min(r * 14, 75);\n\n  return `<svg viewBox=\"0 0 ${W} ${H}\" class=\"svg-3d w-full max-w-xs\">\n    <defs>\n      <radialGradient id=\"kuleGrad\" cx=\"38%\" cy=\"35%\">\n        <stop offset=\"0%\" stop-color=\"#c7d2fe\"/>\n        <stop offset=\"50%\" stop-color=\"#818cf8\"/>\n        <stop offset=\"100%\" stop-color=\"#3730a3\"/>\n      </radialGradient>\n    </defs>\n    <circle cx=\"${cx}\" cy=\"${cy}\" r=\"${rad}\" fill=\"url(#kuleGrad)\" stroke=\"#3730a3\" stroke-width=\"1.5\"/>\n    <!-- Equator ellipse (dashed) -->\n    <ellipse cx=\"${cx}\" cy=\"${cy}\" rx=\"${rad}\" ry=\"${rad*0.28}\" fill=\"none\" stroke=\"#6366f1\" stroke-width=\"1\" stroke-dasharray=\"5,4\"/>\n    <!-- Radius -->\n    <line x1=\"${cx}\" y1=\"${cy}\" x2=\"${cx + rad}\" y2=\"${cy}\" stroke=\"white\" stroke-width=\"1.5\" stroke-dasharray=\"4,3\"/>\n    <circle cx=\"${cx}\" cy=\"${cy}\" r=\"3\" fill=\"white\"/>\n    <text x=\"${cx + rad/2}\" y=\"${cy - 7}\" text-anchor=\"middle\" font-size=\"12\" fill=\"white\" font-weight=\"bold\">r</text>\n  </svg>`;\n}\n\nfunction svgKjegle(r, h) {\n  const W = 200, H = 210;\n  const cx = 100;\n  const ry = 18;\n  const width = Math.min(r * 18, 68);\n  const height = Math.min(h * 12, 120);\n  const top = 30;\n  const bot = top + height;\n\n  return `<svg viewBox=\"0 0 ${W} ${H}\" class=\"svg-3d w-full max-w-xs\">\n    <defs>\n      <linearGradient id=\"kjGrad\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"0\">\n        <stop offset=\"0%\" stop-color=\"#4f46e5\"/>\n        <stop offset=\"50%\" stop-color=\"#818cf8\"/>\n        <stop offset=\"100%\" stop-color=\"#4f46e5\"/>\n      </linearGradient>\n    </defs>\n    <!-- Left side -->\n    <line x1=\"${cx}\" y1=\"${top}\" x2=\"${cx - width}\" y2=\"${bot}\" stroke=\"#3730a3\" stroke-width=\"1.5\"/>\n    <!-- Right side -->\n    <line x1=\"${cx}\" y1=\"${top}\" x2=\"${cx + width}\" y2=\"${bot}\" stroke=\"#3730a3\" stroke-width=\"1.5\"/>\n    <!-- Filled cone body (left half) -->\n    <polygon points=\"${cx},${top} ${cx - width},${bot} ${cx + width},${bot}\" fill=\"url(#kjGrad)\" stroke=\"#3730a3\" stroke-width=\"1.5\" opacity=\"0.9\"/>\n    <!-- Bottom ellipse -->\n    <ellipse cx=\"${cx}\" cy=\"${bot}\" rx=\"${width}\" ry=\"${ry}\" fill=\"#4f46e5\" stroke=\"#3730a3\" stroke-width=\"1.5\"/>\n    <!-- Height dashed line -->\n    <line x1=\"${cx}\" y1=\"${top}\" x2=\"${cx}\" y2=\"${bot}\" stroke=\"#e0e7ff\" stroke-width=\"1.5\" stroke-dasharray=\"5,4\"/>\n    <!-- Radius line -->\n    <line x1=\"${cx}\" y1=\"${bot}\" x2=\"${cx + width}\" y2=\"${bot}\" stroke=\"white\" stroke-width=\"1.5\" stroke-dasharray=\"4,3\"/>\n    <!-- Slant line label -->\n    <line x1=\"${cx}\" y1=\"${top}\" x2=\"${cx + width}\" y2=\"${bot}\" stroke=\"#fbbf24\" stroke-width=\"1.5\" stroke-dasharray=\"5,3\"/>\n    <text x=\"${cx + width/2 + 10}\" y=\"${top + height/2}\" text-anchor=\"start\" font-size=\"10\" fill=\"#b45309\" font-weight=\"bold\">s</text>\n    <text x=\"${cx - 10}\" y=\"${top + height/2}\" text-anchor=\"end\" font-size=\"11\" fill=\"#e0e7ff\" font-weight=\"bold\">h</text>\n    <text x=\"${cx + width/2}\" y=\"${bot + ry + 12}\" text-anchor=\"middle\" font-size=\"11\" fill=\"#3730a3\" font-weight=\"bold\">r</text>\n  </svg>`;\n}\n\nfunction svgPyramide(l, b, h) {\n  const W = 200, H = 200;\n  const ox = 100, oy = 155;\n  const fw = Math.min(l * 9, 80);\n  const fd = Math.min(b * 7, 45);\n  const fh = Math.min(h * 12, 110);\n  const sx = 1.5, sy = 0.6;\n  const dx = fd * sx, dy = fd * sy;\n  const tipX = ox + fw/2 + dx/2;\n  const tipY = oy - fh - dy/2;\n\n  // Base corners\n  const A = [ox, oy];\n  const B = [ox + fw, oy];\n  const C = [ox + fw + dx, oy - dy];\n  const D = [ox + dx, oy - dy];\n  const T = [tipX, tipY];\n\n  const pt = arr => arr.map(([x,y])=>`${x},${y}`).join(' ');\n\n  return `<svg viewBox=\"0 0 ${W} ${H}\" class=\"svg-3d w-full max-w-xs\">\n    <defs>\n      <linearGradient id=\"pyLeft\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"0\">\n        <stop offset=\"0%\" stop-color=\"#4f46e5\"/>\n        <stop offset=\"100%\" stop-color=\"#818cf8\"/>\n      </linearGradient>\n      <linearGradient id=\"pyRight\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"0\">\n        <stop offset=\"0%\" stop-color=\"#6366f1\"/>\n        <stop offset=\"100%\" stop-color=\"#4338ca\"/>\n      </linearGradient>\n      <linearGradient id=\"pyFront\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n        <stop offset=\"0%\" stop-color=\"#818cf8\"/>\n        <stop offset=\"100%\" stop-color=\"#4f46e5\"/>\n      </linearGradient>\n    </defs>\n    <!-- Base -->\n    <polygon points=\"${pt([A,B,C,D])}\" fill=\"#a5b4fc\" stroke=\"#3730a3\" stroke-width=\"1.5\" opacity=\"0.7\"/>\n    <!-- Left face (A-D-T) -->\n    <polygon points=\"${pt([A,D,T])}\" fill=\"url(#pyLeft)\" stroke=\"#3730a3\" stroke-width=\"1.5\" opacity=\"0.9\"/>\n    <!-- Back face (D-C-T) -->\n    <polygon points=\"${pt([D,C,T])}\" fill=\"#6366f1\" stroke=\"#3730a3\" stroke-width=\"1.5\" opacity=\"0.75\"/>\n    <!-- Right face (B-C-T) -->\n    <polygon points=\"${pt([B,C,T])}\" fill=\"url(#pyRight)\" stroke=\"#3730a3\" stroke-width=\"1.5\" opacity=\"0.85\"/>\n    <!-- Front face (A-B-T) -->\n    <polygon points=\"${pt([A,B,T])}\" fill=\"url(#pyFront)\" stroke=\"#3730a3\" stroke-width=\"1.5\"/>\n    <!-- Height dashed -->\n    <line x1=\"${(A[0]+B[0]+C[0]+D[0])/4}\" y1=\"${(A[1]+B[1]+C[1]+D[1])/4}\" x2=\"${T[0]}\" y2=\"${T[1]}\" stroke=\"#e0e7ff\" stroke-width=\"1.5\" stroke-dasharray=\"5,4\"/>\n    <!-- Labels -->\n    <text x=\"${(A[0]+B[0])/2}\" y=\"${oy+14}\" text-anchor=\"middle\" font-size=\"11\" fill=\"#3730a3\" font-weight=\"bold\">l</text>\n    <text x=\"${B[0]+dx/2+5}\" y=\"${(B[1]+C[1])/2}\" text-anchor=\"start\" font-size=\"11\" fill=\"#3730a3\" font-weight=\"bold\">b</text>\n    <text x=\"${T[0]+8}\" y=\"${(T[1]+oy)/2}\" text-anchor=\"start\" font-size=\"11\" fill=\"#e0e7ff\" font-weight=\"bold\">h</text>\n  </svg>`;\n}\n\n// ─── CALCULATION FUNCTIONS ────────────────────────────────────────────────────\nfunction calcPrisme(l, b, h, u) {\n  const V = l * b * h;\n  const O = 2 * (l*b + l*h + b*h);\n  const steps = [\n    `Volum: V = l · b · h`,\n    `V = ${fmt(l)} · ${fmt(b)} · ${fmt(h)} ${u}³`,\n    `V = ${fmt(V)} ${u}³`,\n    ``,\n    `Overflate: O = 2(l·b + l·h + b·h)`,\n    `O = 2·(${fmt(l)}·${fmt(b)} + ${fmt(l)}·${fmt(h)} + ${fmt(b)}·${fmt(h)}) ${u}²`,\n    `O = 2·(${fmt(l*b)} + ${fmt(l*h)} + ${fmt(b*h)}) ${u}²`,\n    `O = 2·${fmt(l*b + l*h + b*h)} ${u}²`,\n    `O = ${fmt(O)} ${u}²`\n  ];\n  return { V, O, steps };\n}\n\nfunction calcSylinder(r, h, u) {\n  const V = Math.PI * r * r * h;\n  const O = 2 * Math.PI * r * (r + h);\n  const steps = [\n    `Volum: V = π · r² · h`,\n    `V = π · ${fmt(r)}² · ${fmt(h)} ${u}³`,\n    `V = π · ${fmt(r*r)} · ${fmt(h)} ${u}³`,\n    `V = ${fmt(Math.PI * r * r)} · ${fmt(h)} ${u}³`,\n    `V ≈ ${fmt(V)} ${u}³`,\n    ``,\n    `Overflate: O = 2πr(r + h)`,\n    `O = 2 · π · ${fmt(r)} · (${fmt(r)} + ${fmt(h)}) ${u}²`,\n    `O = 2 · π · ${fmt(r)} · ${fmt(r+h)} ${u}²`,\n    `O ≈ ${fmt(O)} ${u}²`\n  ];\n  return { V, O, steps };\n}\n\nfunction calcKule(r, u) {\n  const V = (4/3) * Math.PI * r * r * r;\n  const O = 4 * Math.PI * r * r;\n  const steps = [\n    `Volum: V = 4/3 · π · r³`,\n    `V = 4/3 · π · ${fmt(r)}³`,\n    `V = 4/3 · π · ${fmt(r*r*r)}`,\n    `V ≈ ${fmt(V)} ${u}³`,\n    ``,\n    `Overflate: O = 4 · π · r²`,\n    `O = 4 · π · ${fmt(r)}²`,\n    `O = 4 · π · ${fmt(r*r)}`,\n    `O ≈ ${fmt(O)} ${u}²`\n  ];\n  return { V, O, steps };\n}\n\nfunction calcKjegle(r, h, u) {\n  const s = Math.sqrt(r*r + h*h);\n  const V = (1/3) * Math.PI * r * r * h;\n  const O = Math.PI * r * r + Math.PI * r * s;\n  const steps = [\n    `Slantelengde: s = √(r² + h²)`,\n    `s = √(${fmt(r)}² + ${fmt(h)}²) = √(${fmt(r*r)} + ${fmt(h*h)})`,\n    `s = √${fmt(r*r + h*h)} ≈ ${fmt(s)} ${u}`,\n    ``,\n    `Volum: V = 1/3 · π · r² · h`,\n    `V = 1/3 · π · ${fmt(r)}² · ${fmt(h)} ${u}³`,\n    `V = 1/3 · π · ${fmt(r*r)} · ${fmt(h)} ${u}³`,\n    `V ≈ ${fmt(V)} ${u}³`,\n    ``,\n    `Overflate: O = π·r² + π·r·s`,\n    `O = π · ${fmt(r)}² + π · ${fmt(r)} · ${fmt(s)}`,\n    `O = π · ${fmt(r*r)} + π · ${fmt(r*s)}`,\n    `O ≈ ${fmt(Math.PI*r*r)} + ${fmt(Math.PI*r*s)} ${u}²`,\n    `O ≈ ${fmt(O)} ${u}²`\n  ];\n  return { V, O, steps, s };\n}\n\nfunction calcPyramide(l, b, h, u) {\n  const G = l * b;\n  const V = (1/3) * G * h;\n  // Heights of the triangular faces\n  // For l-faces: slant from apex to midpoint of l-edge\n  const hl = Math.sqrt((b/2)*(b/2) + h*h);\n  // For b-faces: slant from apex to midpoint of b-edge\n  const hb = Math.sqrt((l/2)*(l/2) + h*h);\n  const A_l_faces = 2 * (0.5 * l * hl); // two l-faces\n  const A_b_faces = 2 * (0.5 * b * hb); // two b-faces\n  const O = G + A_l_faces + A_b_faces;\n  const steps = [\n    `Grunnflate: G = l · b = ${fmt(l)} · ${fmt(b)} = ${fmt(G)} ${u}²`,\n    ``,\n    `Volum: V = 1/3 · G · h`,\n    `V = 1/3 · ${fmt(G)} · ${fmt(h)} ${u}³`,\n    `V ≈ ${fmt(V)} ${u}³`,\n    ``,\n    `Overflate: O = G + sideflater`,\n    `Slanth. mot l-kanter: h_l = √((b/2)² + h²) = √(${fmt((b/2)*(b/2))} + ${fmt(h*h)}) ≈ ${fmt(hl)} ${u}`,\n    `Slanth. mot b-kanter: h_b = √((l/2)² + h²) = √(${fmt((l/2)*(l/2))} + ${fmt(h*h)}) ≈ ${fmt(hb)} ${u}`,\n    `2 l-flater: 2 · ½ · ${fmt(l)} · ${fmt(hl)} ≈ ${fmt(A_l_faces)} ${u}²`,\n    `2 b-flater: 2 · ½ · ${fmt(b)} · ${fmt(hb)} ≈ ${fmt(A_b_faces)} ${u}²`,\n    `O = ${fmt(G)} + ${fmt(A_l_faces)} + ${fmt(A_b_faces)}`,\n    `O ≈ ${fmt(O)} ${u}²`\n  ];\n  return { V, O, steps, G };\n}\n\n// ─── LITER CONVERSION ────────────────────────────────────────────────────────\nfunction toLiter(V, unit) {\n  // Convert V (in unit³) to litres\n  // 1 cm³ = 0.001 L, 1 dm³ = 1 L, 1 m³ = 1000 L\n  const factors = { cm: 0.001, dm: 1, m: 1000 };\n  return V * (factors[unit] || 1);\n}\n\nfunction fmtLiter(L) {\n  if (L >= 1000) return `${fmt(L / 1000)} kL (kiloliter)`;\n  if (L >= 1) return `${fmt(L)} L (liter)`;\n  if (L >= 0.001) return `${fmt(L * 1000)} mL (milliliter)`;\n  return `${fmt(L * 1000)} mL (milliliter)`;\n}\n\n// ─── NUMBER FORMATTING ───────────────────────────────────────────────────────\nfunction fmt(n) {\n  if (Math.abs(n) >= 1000) return n.toFixed(1).replace('.', ',');\n  if (Math.abs(n) >= 100) return n.toFixed(2).replace('.', ',');\n  if (Math.abs(n) >= 10) return n.toFixed(3).replace('.', ',');\n  return n.toFixed(4).replace('.', ',').replace(/,?0+$/, '').replace(/,$/, '');\n}\n\n// ─── GET INPUT VALUES ────────────────────────────────────────────────────────\nfunction getVal(id) {\n  const el = document.getElementById('inp-' + id);\n  if (!el) return 0;\n  return parseFloat(el.value) || 0;\n}\n\n// ─── RENDER FUNCTIONS ────────────────────────────────────────────────────────\nfunction renderInputs(shape) {\n  const meta = shapes[shape];\n  const container = document.getElementById('inputs-container');\n  const unit = document.getElementById('unit-select').value;\n  container.innerHTML = meta.inputs.map(inp => `\n    <div class=\"flex items-center gap-3\">\n      <label class=\"w-28 text-sm font-medium text-gray-700 shrink-0\">${inp.label} <span class=\"unit-tag\">(${unit})</span></label>\n      <input id=\"inp-${inp.id}\" type=\"number\" min=\"${inp.min}\" step=\"${inp.step}\"\n        value=\"${inp.val()}\"\n        oninput=\"recalc()\"\n        class=\"flex-1 border border-gray-200 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-300 outline-none\" />\n    </div>\n  `).join('');\n}\n\nfunction renderSVG(shape) {\n  const container = document.getElementById('svg-container');\n  const unit = document.getElementById('unit-select').value;\n  let svg = '';\n  if (shape === 'prisme') {\n    const l = getVal('l') || defaults.prisme.l;\n    const b = getVal('b') || defaults.prisme.b;\n    const h = getVal('h') || defaults.prisme.h;\n    svg = svgPrisme(l, b, h);\n  } else if (shape === 'sylinder') {\n    const r = getVal('r') || defaults.sylinder.r;\n    const h = getVal('h') || defaults.sylinder.h;\n    svg = svgSylinder(r, h);\n  } else if (shape === 'kule') {\n    const r = getVal('r') || defaults.kule.r;\n    svg = svgKule(r);\n  } else if (shape === 'kjegle') {\n    const r = getVal('r') || defaults.kjegle.r;\n    const h = getVal('h') || defaults.kjegle.h;\n    svg = svgKjegle(r, h);\n  } else if (shape === 'pyramide') {\n    const l = getVal('l') || defaults.pyramide.l;\n    const b = getVal('b') || defaults.pyramide.b;\n    const h = getVal('h') || defaults.pyramide.h;\n    svg = svgPyramide(l, b, h);\n  }\n  container.innerHTML = svg;\n}\n\nfunction renderResults(shape) {\n  const unit = document.getElementById('unit-select').value;\n  let result = null;\n  let valid = true;\n\n  if (shape === 'prisme') {\n    const l = getVal('l'), b = getVal('b'), h = getVal('h');\n    if (l <= 0 || b <= 0 || h <= 0) { valid = false; }\n    else result = calcPrisme(l, b, h, unit);\n  } else if (shape === 'sylinder') {\n    const r = getVal('r'), h = getVal('h');\n    if (r <= 0 || h <= 0) { valid = false; }\n    else result = calcSylinder(r, h, unit);\n  } else if (shape === 'kule') {\n    const r = getVal('r');\n    if (r <= 0) { valid = false; }\n    else result = calcKule(r, unit);\n  } else if (shape === 'kjegle') {\n    const r = getVal('r'), h = getVal('h');\n    if (r <= 0 || h <= 0) { valid = false; }\n    else result = calcKjegle(r, h, unit);\n  } else if (shape === 'pyramide') {\n    const l = getVal('l'), b = getVal('b'), h = getVal('h');\n    if (l <= 0 || b <= 0 || h <= 0) { valid = false; }\n    else result = calcPyramide(l, b, h, unit);\n  }\n\n  const rc = document.getElementById('results-container');\n  const lc = document.getElementById('liter-container');\n\n  if (!valid || !result) {\n    rc.innerHTML = `<p class=\"text-red-500 text-sm\">Alle mål må være større enn 0.</p>`;\n    lc.innerHTML = '';\n    return;\n  }\n\n  // Result cards\n  rc.innerHTML = `\n    <h2 class=\"text-lg font-bold text-gray-800 mb-5\">Beregning — steg for steg</h2>\n    <div class=\"grid md:grid-cols-2 gap-6 mb-6\">\n      <div class=\"result-block bg-indigo-50 rounded-xl p-5\">\n        <p class=\"text-xs font-semibold text-indigo-500 uppercase tracking-wide mb-1\">Volum</p>\n        <p class=\"text-3xl font-bold text-indigo-700\">${fmt(result.V)} <span class=\"text-lg font-normal text-indigo-400\">${unit}³</span></p>\n      </div>\n      <div class=\"result-block bg-purple-50 rounded-xl p-5\" style=\"border-color:#a855f7\">\n        <p class=\"text-xs font-semibold text-purple-500 uppercase tracking-wide mb-1\">Overflate</p>\n        <p class=\"text-3xl font-bold text-purple-700\">${fmt(result.O)} <span class=\"text-lg font-normal text-purple-400\">${unit}²</span></p>\n      </div>\n    </div>\n    <div class=\"bg-gray-50 rounded-xl p-4\">\n      <p class=\"text-xs font-semibold text-gray-500 uppercase tracking-wide mb-3\">Utregning</p>\n      <div class=\"space-y-1 font-mono text-sm text-gray-700\">\n        ${result.steps.map(s => s === '' ? '<div class=\"h-2\"></div>' : `<div class=\"step\">${s.replace(/≈/g, '≈').replace(/·/g, '·')}</div>`).join('')}\n      </div>\n    </div>\n  `;\n\n  // Liter conversion\n  const liters = toLiter(result.V, unit);\n  const litersFormatted = fmtLiter(liters);\n  const convFactor = unit === 'cm' ? '0,001' : unit === 'dm' ? '1' : '1 000';\n  const convUnit = unit === 'cm' ? 'cm³' : unit === 'dm' ? 'dm³' : 'm³';\n\n  lc.innerHTML = `\n    <h3 class=\"font-bold text-indigo-800 mb-3 flex items-center gap-2\">\n      <span class=\"text-xl\">💧</span> Liter-omregning: Hvor mye rommer figuren?\n    </h3>\n    <div class=\"grid md:grid-cols-2 gap-5\">\n      <div>\n        <p class=\"text-sm text-indigo-700 mb-2\"><strong>Volum:</strong> ${fmt(result.V)} ${unit}³</p>\n        <div class=\"bg-white rounded-lg p-3 text-sm font-mono text-gray-700 space-y-1\">\n          <div>1 ${convUnit} = ${convFactor} L</div>\n          <div>${fmt(result.V)} ${convUnit} × ${convFactor} L/${convUnit}</div>\n          <div class=\"font-bold text-indigo-700\">= ${litersFormatted}</div>\n        </div>\n      </div>\n      <div class=\"flex flex-col justify-center\">\n        <p class=\"text-xs text-indigo-600 font-semibold mb-2\">Omregningstabell</p>\n        <table class=\"text-xs w-full border-collapse\">\n          <thead>\n            <tr class=\"bg-indigo-100\">\n              <th class=\"text-left px-2 py-1 rounded-tl-lg\">Enhet</th>\n              <th class=\"text-right px-2 py-1 rounded-tr-lg\">= Liter</th>\n            </tr>\n          </thead>\n          <tbody class=\"bg-white\">\n            <tr class=\"border-b border-indigo-50\"><td class=\"px-2 py-1\">1 cm³</td><td class=\"text-right px-2 py-1\">0,001 L = 1 mL</td></tr>\n            <tr class=\"border-b border-indigo-50\"><td class=\"px-2 py-1\">1 dm³</td><td class=\"text-right px-2 py-1\">1 L</td></tr>\n            <tr><td class=\"px-2 py-1\">1 m³</td><td class=\"text-right px-2 py-1\">1 000 L</td></tr>\n          </tbody>\n        </table>\n      </div>\n    </div>\n  `;\n}\n\n// ─── MAIN RECALC ─────────────────────────────────────────────────────────────\nfunction recalc() {\n  renderSVG(currentShape);\n  renderResults(currentShape);\n}\n\n// ─── SELECT SHAPE ────────────────────────────────────────────────────────────\nfunction selectShape(shape) {\n  currentShape = shape;\n\n  // Update button styles\n  Object.keys(shapes).forEach(s => {\n    const btn = document.getElementById('btn-' + s);\n    if (s === shape) {\n      btn.className = 'shape-btn active px-4 py-2 rounded-lg font-semibold text-sm bg-indigo-600 text-white shadow';\n    } else {\n      btn.className = 'shape-btn px-4 py-2 rounded-lg font-semibold text-sm bg-gray-100 text-gray-700 hover:bg-indigo-50';\n    }\n  });\n\n  // Update title and formula\n  document.getElementById('shape-title').textContent = shapes[shape].title;\n  document.getElementById('formula-display').innerHTML = shapes[shape].formulaHtml;\n\n  // Render inputs (fresh defaults)\n  renderInputs(shape);\n  recalc();\n}\n\n// ─── INIT ────────────────────────────────────────────────────────────────────\nselectShape('prisme');\n</script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Volum og overflate",
    "windowTitle": "Volum og overflate",
    "bundleId": "com.halisonworks.geovolumoverflate",
    "iconPath": null
  },
  "categoryId": null,
  "source": "import",
  "createdAt": "2026-06-02T12:00:00.000Z",
  "updatedAt": "2026-06-02T12:00:00.000Z",
  "sharedAt": "2026-06-02T12:00:00.000Z"
}
