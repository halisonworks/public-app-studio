{
  "schema": "app-studio/canvas@1",
  "id": "example-citation-builder",
  "name": "citation-builder.html",
  "code": "<!DOCTYPE html>\n<!--\n  Source Citation Builder — Halison App Studio example\n\n  Build a tidy, consistent source citation for common genealogy record types — census, vital records, parish registers, gravestones, newspapers, and online databases.\n\n  From the Halison App Studio public library:\n  https://github.com/halisonworks/public-app-studio\n\n  Permitted use: personal, educational, and other non-commercial use. You may\n  modify it, but keep this header and the source link intact, and do not sell,\n  commercialize, or republish it. Released under the Halison App Studio Examples\n  License — see the LICENSE file in the repository above.\n-->\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Source Citation Builder</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Inter', 'Segoe UI', sans-serif; }\n    .fade-in { animation: fadeIn 0.35s ease; }\n    @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }\n    .type-btn.active { background: #4f46e5; color: #fff; border-color: #4f46e5; }\n    .type-btn.active svg { color: #fff; }\n    .copied-flash { background: #d1fae5 !important; color: #065f46 !important; border-color: #6ee7b7 !important; }\n    .cite-out { white-space: pre-wrap; word-break: break-word; }\n  </style>\n</head>\n<body class=\"bg-gray-50 min-h-screen\">\n\n  <!-- Header -->\n  <header class=\"bg-white border-b border-gray-200 sticky top-0 z-30 shadow-sm\">\n    <div class=\"max-w-4xl mx-auto px-4 py-4 flex items-center gap-3\">\n      <div class=\"w-9 h-9 rounded-lg bg-indigo-600 flex items-center justify-center flex-shrink-0\">\n        <svg class=\"w-5 h-5 text-white\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M9 7h6m-6 4h6m-6 4h4M5 4h14a1 1 0 011 1v14a1 1 0 01-1 1H5a1 1 0 01-1-1V5a1 1 0 011-1z\" />\n        </svg>\n      </div>\n      <div>\n        <h1 class=\"text-lg font-bold text-gray-900 leading-tight\">Source Citation Builder</h1>\n        <p class=\"text-xs text-gray-500\">Consistent, layered citations for genealogy sources</p>\n      </div>\n    </div>\n  </header>\n\n  <main class=\"max-w-4xl mx-auto px-4 py-8 space-y-6\">\n\n    <!-- Record type selector -->\n    <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n      <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4\">Record type</h2>\n      <div id=\"typeGrid\" class=\"grid grid-cols-2 sm:grid-cols-4 gap-3\"></div>\n    </section>\n\n    <!-- Fields -->\n    <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n      <div class=\"flex items-center justify-between mb-4 gap-3 flex-wrap\">\n        <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider\">\n          Details — <span id=\"typeLabel\" class=\"text-indigo-600 normal-case tracking-normal font-semibold\">Census</span>\n        </h2>\n        <button id=\"clearBtn\" class=\"text-xs font-medium text-gray-500 hover:text-red-600 border border-gray-300 rounded-md px-3 py-1.5 hover:border-red-300 transition\">Clear fields</button>\n      </div>\n      <div id=\"fieldGrid\" class=\"grid grid-cols-1 sm:grid-cols-2 gap-4\"></div>\n    </section>\n\n    <!-- Outputs -->\n    <section class=\"space-y-4 fade-in\">\n\n      <div class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n        <div class=\"flex items-center justify-between mb-3 gap-2\">\n          <div>\n            <h3 class=\"text-sm font-semibold text-gray-800\">Full / First Reference Note</h3>\n            <p class=\"text-xs text-gray-400\">Footnote style — layered: what, where, when, repository, access</p>\n          </div>\n          <button data-copy=\"outFull\" class=\"copy-btn text-xs font-medium text-indigo-600 border border-indigo-200 rounded-md px-3 py-1.5 hover:bg-indigo-50 transition flex-shrink-0\">Copy</button>\n        </div>\n        <div id=\"outFull\" class=\"cite-out text-sm text-gray-800 bg-gray-50 border border-gray-200 rounded-lg px-4 py-3 leading-relaxed min-h-[3rem]\"></div>\n      </div>\n\n      <div class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n        <div class=\"flex items-center justify-between mb-3 gap-2\">\n          <div>\n            <h3 class=\"text-sm font-semibold text-gray-800\">Short / Subsequent Note</h3>\n            <p class=\"text-xs text-gray-400\">Abbreviated form for repeat citations</p>\n          </div>\n          <button data-copy=\"outShort\" class=\"copy-btn text-xs font-medium text-indigo-600 border border-indigo-200 rounded-md px-3 py-1.5 hover:bg-indigo-50 transition flex-shrink-0\">Copy</button>\n        </div>\n        <div id=\"outShort\" class=\"cite-out text-sm text-gray-800 bg-gray-50 border border-gray-200 rounded-lg px-4 py-3 leading-relaxed min-h-[3rem]\"></div>\n      </div>\n\n      <div class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n        <div class=\"flex items-center justify-between mb-3 gap-2\">\n          <div>\n            <h3 class=\"text-sm font-semibold text-gray-800\">Source List / Bibliography Entry</h3>\n            <p class=\"text-xs text-gray-400\">Reordered, author/jurisdiction-first, period-terminated</p>\n          </div>\n          <button data-copy=\"outBib\" class=\"copy-btn text-xs font-medium text-indigo-600 border border-indigo-200 rounded-md px-3 py-1.5 hover:bg-indigo-50 transition flex-shrink-0\">Copy</button>\n        </div>\n        <div id=\"outBib\" class=\"cite-out text-sm text-gray-800 bg-gray-50 border border-gray-200 rounded-lg px-4 py-3 leading-relaxed min-h-[3rem]\"></div>\n      </div>\n\n      <div class=\"flex justify-end\">\n        <button id=\"saveBtn\" class=\"bg-indigo-600 text-white text-sm font-semibold rounded-lg px-5 py-2.5 hover:bg-indigo-700 transition shadow-sm flex items-center gap-2\">\n          <svg class=\"w-4 h-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M5 13l4 4L19 7\"/></svg>\n          Save to source log\n        </button>\n      </div>\n    </section>\n\n    <!-- Saved citations -->\n    <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n      <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4\">Saved citations <span id=\"savedCount\" class=\"text-gray-400\"></span></h2>\n      <div id=\"savedEmpty\" class=\"text-sm text-gray-400 italic\">No saved citations yet. Build a citation above and click \"Save to source log\".</div>\n      <ul id=\"savedList\" class=\"space-y-3\"></ul>\n    </section>\n\n    <!-- About -->\n    <section class=\"bg-gray-50 rounded-xl border border-gray-200 px-5 py-4 text-xs text-gray-500 leading-relaxed\">\n      <strong class=\"text-gray-700\">About these formats:</strong> The three outputs are <em>simplified</em> citation forms inspired by the layered \"Evidence Explained\" style developed by Elizabeth Shown Mills — a full reference note that moves from the specific item to its container, repository, and how it was accessed; a short note for repeat use; and a reordered source-list entry. House styles vary between societies, journals, and software, so treat these as a clean starting point and adapt punctuation and ordering to whatever standard your project follows. Empty fields are skipped automatically so you never get doubled commas or semicolons.\n    </section>\n\n  </main>\n\n  <footer class=\"max-w-4xl mx-auto px-4 py-6 text-center text-xs text-gray-400\">\n    Source Citation Builder &mdash; <a href=\"https://github.com/halisonworks/public-app-studio\" class=\"underline hover:text-indigo-500\" target=\"_blank\" rel=\"noopener\">Halison App Studio</a>\n  </footer>\n\n<script>\n// ─── Helpers ────────────────────────────────────────────────────────────────\n\n// Join non-empty parts with a separator (filters out empty/whitespace).\nfunction join(parts, sep) {\n  return parts.map(p => (p == null ? '' : String(p).trim())).filter(p => p.length > 0).join(sep);\n}\n\n// Ensure a string ends with a period (and not a doubled one).\nfunction period(s) {\n  s = (s || '').trim();\n  if (!s) return '';\n  return /[.!?]$/.test(s) ? s : s + '.';\n}\n\n// Quote a value if present.\nfunction quote(s) {\n  s = (s || '').trim();\n  return s ? '\"' + s + '\"' : '';\n}\n\n// Wrap with a prefix label if value present, e.g. lbl('p.', '42') -> 'p. 42'\nfunction lbl(prefix, v) {\n  v = (v || '').trim();\n  return v ? prefix + ' ' + v : '';\n}\n\n// Parenthesize if present.\nfunction paren(s) {\n  s = (s || '').trim();\n  return s ? '(' + s + ')' : '';\n}\n\n// \"accessed DATE\" clause\nfunction accessed(d) {\n  d = (d || '').trim();\n  return d ? 'accessed ' + d : '';\n}\n\n// ─── Record type definitions ────────────────────────────────────────────────\n// Each type defines its fields and three builder functions.\n\nconst ICONS = {\n  census: 'M3 7h18M3 12h18M3 17h18',\n  vital: 'M9 12l2 2 4-4m5 2a9 9 0 11-18 0 9 9 0 0118 0z',\n  parish: 'M12 3l8 5v2H4V8l8-5zM5 12h14v7H5v-7z',\n  grave: 'M12 3a4 4 0 014 4v8H8V7a4 4 0 014-4zM6 19h12v2H6z',\n  newspaper: 'M4 5h16v14H4zM8 9h8M8 13h8M8 17h4',\n  book: 'M5 4h11a2 2 0 012 2v14H7a2 2 0 01-2-2V4zM5 4v14',\n  database: 'M4 6c0-1.7 3.6-3 8-3s8 1.3 8 3-3.6 3-8 3-8-1.3-8-3zm0 0v12c0 1.7 3.6 3 8 3s8-1.3 8-3V6',\n  letter: 'M4 6h16v12H4zM4 7l8 6 8-6'\n};\n\nfunction field(id, label, placeholder, opts) {\n  return Object.assign({ id, label, placeholder: placeholder || '', type: 'text' }, opts || {});\n}\n\nconst TYPES = [\n  // ── Census ───────────────────────────────────────────────────────────────\n  {\n    key: 'census', name: 'Census', icon: ICONS.census,\n    fields: [\n      field('jurisdiction', 'Country / jurisdiction', 'e.g. United States'),\n      field('year', 'Census year', 'e.g. 1900'),\n      field('place', 'Place (state / county / town)', 'e.g. Cook County, Illinois'),\n      field('locator', 'Enumeration district / piece / folio / page', 'e.g. ED 42, folio 17, p. 8B'),\n      field('household', 'Household / line', 'e.g. dwelling 112, family 118'),\n      field('person', 'Person of interest', 'e.g. John A. Smith'),\n      field('repository', 'Archive / repository', 'e.g. NARA, Washington, D.C.'),\n      field('accessVia', 'Accessed via', 'e.g. Ancestry.com'),\n      field('url', 'URL', 'https://...'),\n      field('dateAccessed', 'Date accessed', 'e.g. 14 May 2026')\n    ],\n    full: f => period(join([\n      join([f.year, f.jurisdiction, 'census'], ' '),\n      f.place,\n      f.locator,\n      f.household,\n      f.person ? join([f.person, '(household)'], ' ') : '',\n      f.repository,\n      f.accessVia ? join([join([f.accessVia, paren(f.url)], ' '), accessed(f.dateAccessed)], ', ') : accessed(f.dateAccessed)\n    ], ', ')),\n    short: f => period(join([\n      join([f.year, f.jurisdiction, 'census'], ' '),\n      f.place,\n      f.person,\n      f.locator\n    ], ', ')),\n    bib: f => period(join([\n      period(join([f.jurisdiction, f.place], '. ')),\n      join([f.year, 'Census'], ' '),\n      f.accessVia ? join([f.accessVia, paren(join([f.url, accessed(f.dateAccessed)], ' : '))], ' ') : ''\n    ], ' '))\n  },\n  // ── Vital record ───────────────────────────────────────────────────────────\n  {\n    key: 'vital', name: 'Vital record', icon: ICONS.vital,\n    fields: [\n      field('kind', 'Type (birth / marriage / death)', 'e.g. death certificate'),\n      field('names', 'Name(s)', 'e.g. Mary E. (Smith) Johnson'),\n      field('eventDate', 'Event date', 'e.g. 3 March 1921'),\n      field('place', 'Place', 'e.g. Boston, Suffolk, Massachusetts'),\n      field('number', 'Registration / certificate no.', 'e.g. no. 1921-04412'),\n      field('authority', 'Issuing authority', 'e.g. Massachusetts Registry of Vital Records'),\n      field('repository', 'Repository', 'e.g. Massachusetts State Archives'),\n      field('dateAccessed', 'Date accessed', 'e.g. 14 May 2026')\n    ],\n    full: f => period(join([\n      join([f.place, f.kind], ', '),\n      f.number,\n      f.names ? join([f.names, paren(f.eventDate)], ' ') : f.eventDate,\n      f.authority,\n      f.repository ? join([f.repository, accessed(f.dateAccessed)], '; ') : accessed(f.dateAccessed)\n    ], ', ')),\n    short: f => period(join([\n      f.place,\n      f.kind,\n      f.names,\n      f.number\n    ], ', ')),\n    bib: f => period(join([\n      period(f.place || f.authority),\n      join([f.kind, paren('records')], ' '),\n      f.repository\n    ], ' '))\n  },\n  // ── Church / Parish register ────────────────────────────────────────────────\n  {\n    key: 'parish', name: 'Parish register', icon: ICONS.parish,\n    fields: [\n      field('denomination', 'Denomination', 'e.g. Church of England'),\n      field('parish', 'Parish', 'e.g. St Mary, Whitechapel'),\n      field('place', 'Place', 'e.g. London, England'),\n      field('registerType', 'Register type', 'e.g. baptisms'),\n      field('entryDate', 'Entry date', 'e.g. 12 April 1834'),\n      field('names', 'Name(s)', 'e.g. Thomas, son of William Hall'),\n      field('volPage', 'Volume / page', 'e.g. vol. 4, p. 211, entry 1683'),\n      field('repository', 'Repository', 'e.g. London Metropolitan Archives'),\n      field('url', 'URL', 'https://...'),\n      field('dateAccessed', 'Date accessed', 'e.g. 14 May 2026')\n    ],\n    full: f => period(join([\n      join([f.parish, paren(f.denomination)], ' '),\n      f.place,\n      join([f.registerType, paren(f.entryDate)], ' '),\n      f.names,\n      f.volPage,\n      f.repository,\n      f.url ? join([paren(f.url), accessed(f.dateAccessed)], ' ') : accessed(f.dateAccessed)\n    ], ', ')),\n    short: f => period(join([\n      f.parish,\n      f.registerType,\n      f.names,\n      f.entryDate\n    ], ', ')),\n    bib: f => period(join([\n      period(join([f.parish, paren(f.denomination)], ' ')),\n      period(f.place),\n      join(['Parish registers', f.repository ? join(['—', f.repository], ' ') : ''], ' ')\n    ], ' '))\n  },\n  // ── Gravestone / Cemetery ───────────────────────────────────────────────────\n  {\n    key: 'grave', name: 'Gravestone', icon: ICONS.grave,\n    fields: [\n      field('name', 'Name', 'e.g. Eliza Hart (1842–1910)'),\n      field('cemetery', 'Cemetery', 'e.g. Mount Auburn Cemetery'),\n      field('place', 'Town / place', 'e.g. Cambridge, Massachusetts'),\n      field('plot', 'Plot / section', 'e.g. Section 7, Lot 214'),\n      field('readingDate', 'Reading / inscription date', 'e.g. read 2 June 2026'),\n      field('recordedBy', 'Recorded by', 'e.g. personal visit'),\n      field('photoSource', 'Photo source', 'e.g. Find A Grave memorial no. 1234567'),\n      field('url', 'URL', 'https://...'),\n      field('dateAccessed', 'Date accessed', 'e.g. 14 May 2026')\n    ],\n    full: f => period(join([\n      f.name ? join([f.name, 'gravestone'], ', ') : 'gravestone',\n      f.cemetery,\n      f.place,\n      f.plot,\n      f.recordedBy,\n      f.readingDate,\n      f.photoSource ? join([f.photoSource, paren(f.url), accessed(f.dateAccessed)], ' ') : ''\n    ], ', ')),\n    short: f => period(join([\n      f.name,\n      f.cemetery,\n      f.place,\n      f.plot\n    ], ', ')),\n    bib: f => period(join([\n      period(f.cemetery),\n      period(f.place),\n      join(['Gravestone inscriptions', f.photoSource ? join(['—', f.photoSource], ' ') : ''], ' ')\n    ], ' '))\n  },\n  // ── Newspaper ───────────────────────────────────────────────────────────────\n  {\n    key: 'newspaper', name: 'Newspaper', icon: ICONS.newspaper,\n    fields: [\n      field('title', 'Article title', 'e.g. \"Local Man Honored\"'),\n      field('paper', 'Newspaper name', 'e.g. The Boston Globe'),\n      field('place', 'Place', 'e.g. Boston, Massachusetts'),\n      field('issueDate', 'Issue date', 'e.g. 14 July 1899'),\n      field('pageCol', 'Page / column', 'e.g. p. 3, col. 2'),\n      field('archive', 'Archive / database', 'e.g. Newspapers.com'),\n      field('url', 'URL', 'https://...'),\n      field('dateAccessed', 'Date accessed', 'e.g. 14 May 2026')\n    ],\n    full: f => period(join([\n      quote(f.title.replace(/^\"|\"$/g, '')),\n      f.paper ? join([f.paper, paren(f.place)], ' ') : '',\n      f.issueDate,\n      f.pageCol,\n      f.archive ? join([f.archive, paren(f.url), accessed(f.dateAccessed)], ' ') : ''\n    ], ', ')),\n    short: f => period(join([\n      f.paper,\n      f.issueDate,\n      f.pageCol\n    ], ', ')),\n    bib: f => period(join([\n      period(f.paper ? join([f.paper, paren(f.place)], ' ') : ''),\n      f.archive ? join([f.archive, paren(f.url)], ' ') : ''\n    ], ' '))\n  },\n  // ── Book ────────────────────────────────────────────────────────────────────\n  {\n    key: 'book', name: 'Book', icon: ICONS.book,\n    fields: [\n      field('author', 'Author', 'e.g. Jane R. Holloway'),\n      field('title', 'Title', 'e.g. The Holloways of Devon'),\n      field('place', 'Place of publication', 'e.g. Exeter'),\n      field('publisher', 'Publisher', 'e.g. Westcountry Press'),\n      field('year', 'Year', 'e.g. 1987'),\n      field('pages', 'Page(s)', 'e.g. 142–145'),\n      field('repoUrl', 'Repository or URL', 'e.g. FamilySearch Library; https://...')\n    ],\n    full: f => period(join([\n      f.author,\n      f.title,\n      paren(join([join([f.place, f.publisher], ': '), f.year], ', ')),\n      lbl('p.', f.pages),\n      f.repoUrl\n    ], ', ')),\n    short: f => period(join([\n      f.author ? f.author.split(',')[0].split(' ').slice(-1)[0] : '',\n      f.title,\n      lbl('p.', f.pages)\n    ], ', ')),\n    bib: f => period(join([\n      period(f.author),\n      period(f.title),\n      paren(join([join([f.place, f.publisher], ': '), f.year], ', '))\n    ], ' '))\n  },\n  // ── Online database / website ───────────────────────────────────────────────\n  {\n    key: 'database', name: 'Online database', icon: ICONS.database,\n    fields: [\n      field('dbTitle', 'Database title', 'e.g. \"England & Wales, Civil Registration Index\"'),\n      field('publisher', 'Website / publisher', 'e.g. Ancestry.com'),\n      field('url', 'URL', 'https://...'),\n      field('item', 'Item / record description', 'e.g. entry for Thomas Hall, 1834'),\n      field('dateAccessed', 'Date accessed', 'e.g. 14 May 2026'),\n      field('original', 'Original source cited', 'e.g. citing GRO indexes, vol. 5b')\n    ],\n    full: f => period(join([\n      quote(f.dbTitle.replace(/^\"|\"$/g, '')),\n      f.publisher,\n      f.url ? paren(join([f.url, accessed(f.dateAccessed)], ' : ')) : accessed(f.dateAccessed),\n      f.item ? join(['entry for', f.item.replace(/^entry for /i, '')], ' ') : '',\n      f.original\n    ], ', ')),\n    short: f => period(join([\n      f.dbTitle.replace(/^\"|\"$/g, ''),\n      f.publisher,\n      f.item\n    ], ', ')),\n    bib: f => period(join([\n      period(f.publisher),\n      quote(f.dbTitle.replace(/^\"|\"$/g, '')),\n      f.url ? join(['Database.', f.publisher, paren(f.url)], ' ') : 'Database.'\n    ], ' '))\n  },\n  // ── Letter / Manuscript ─────────────────────────────────────────────────────\n  {\n    key: 'letter', name: 'Letter / MS', icon: ICONS.letter,\n    fields: [\n      field('author', 'Author', 'e.g. Henry Field'),\n      field('recipient', 'Recipient', 'e.g. to Sarah Field'),\n      field('date', 'Date', 'e.g. 9 November 1862'),\n      field('description', 'Description', 'e.g. autograph letter, 2 pp.'),\n      field('collection', 'Collection / repository', 'e.g. Field Family Papers, MS 214'),\n      field('location', 'Location', 'e.g. Yale University Library, New Haven')\n    ],\n    full: f => period(join([\n      f.author,\n      f.recipient ? (/^to /i.test(f.recipient.trim()) ? f.recipient : 'to ' + f.recipient) : '',\n      f.date,\n      f.description,\n      f.collection,\n      f.location\n    ], ', ')),\n    short: f => period(join([\n      f.author,\n      f.recipient ? (/^to /i.test(f.recipient.trim()) ? f.recipient : 'to ' + f.recipient) : '',\n      f.date\n    ], ', ')),\n    bib: f => period(join([\n      period(f.author),\n      period(f.description || 'Correspondence'),\n      f.collection ? join([f.collection + '.', f.location], ' ') : f.location\n    ], ' '))\n  }\n];\n\n// ─── State ──────────────────────────────────────────────────────────────────\n\nconst STORE_KEY = 'citationBuilder.state.v1';\nconst SAVED_KEY = 'citationBuilder.saved.v1';\n\nlet currentType = TYPES[0].key;\nlet values = {}; // values[typeKey][fieldId] = string\n\nfunction typeDef(key) { return TYPES.find(t => t.key === key); }\n\nfunction loadState() {\n  try {\n    const s = JSON.parse(localStorage.getItem(STORE_KEY));\n    if (s && typeof s === 'object') {\n      if (s.currentType && typeDef(s.currentType)) currentType = s.currentType;\n      if (s.values && typeof s.values === 'object') values = s.values;\n    }\n  } catch (e) { /* ignore */ }\n}\n\nfunction saveState() {\n  try {\n    localStorage.setItem(STORE_KEY, JSON.stringify({ currentType, values }));\n  } catch (e) { /* ignore */ }\n}\n\nfunction loadSaved() {\n  try {\n    const s = JSON.parse(localStorage.getItem(SAVED_KEY));\n    return Array.isArray(s) ? s : [];\n  } catch (e) { return []; }\n}\n\nfunction storeSaved(list) {\n  try { localStorage.setItem(SAVED_KEY, JSON.stringify(list)); } catch (e) { /* ignore */ }\n}\n\nfunction curValues() {\n  return values[currentType] || (values[currentType] = {});\n}\n\n// ─── Rendering ──────────────────────────────────────────────────────────────\n\nfunction renderTypeButtons() {\n  const grid = document.getElementById('typeGrid');\n  grid.innerHTML = '';\n  TYPES.forEach(t => {\n    const btn = document.createElement('button');\n    btn.className = 'type-btn flex flex-col items-center justify-center gap-1.5 border-2 border-gray-200 rounded-xl px-2 py-3 text-xs font-medium text-gray-600 hover:border-indigo-300 transition' + (t.key === currentType ? ' active' : '');\n    btn.innerHTML =\n      '<svg class=\"w-5 h-5 text-indigo-500\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"1.8\">' +\n      '<path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"' + t.icon + '\"/></svg>' +\n      '<span class=\"text-center leading-tight\">' + t.name + '</span>';\n    btn.addEventListener('click', () => {\n      currentType = t.key;\n      saveState();\n      renderTypeButtons();\n      renderFields();\n      updateOutputs();\n    });\n    grid.appendChild(btn);\n  });\n}\n\nfunction renderFields() {\n  const def = typeDef(currentType);\n  document.getElementById('typeLabel').textContent = def.name;\n  const grid = document.getElementById('fieldGrid');\n  grid.innerHTML = '';\n  const v = curValues();\n  def.fields.forEach(fld => {\n    const wrap = document.createElement('div');\n    const wide = /title|description|item|locator|original|repoUrl|household|volPage|photoSource/.test(fld.id);\n    if (wide) wrap.className = 'sm:col-span-2';\n    const label = document.createElement('label');\n    label.className = 'block text-xs font-medium text-gray-500 mb-1';\n    label.textContent = fld.label;\n    const input = document.createElement('input');\n    input.type = 'text';\n    input.value = v[fld.id] || '';\n    input.placeholder = fld.placeholder;\n    input.className = 'w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent';\n    input.addEventListener('input', () => {\n      curValues()[fld.id] = input.value;\n      saveState();\n      updateOutputs();\n    });\n    wrap.appendChild(label);\n    wrap.appendChild(input);\n    grid.appendChild(wrap);\n  });\n}\n\nfunction buildCitations() {\n  const def = typeDef(currentType);\n  const v = curValues();\n  // Normalize: ensure all field ids exist as strings.\n  const f = {};\n  def.fields.forEach(fld => { f[fld.id] = (v[fld.id] || '').toString(); });\n  let full = '', short = '', bib = '';\n  try { full = def.full(f) || ''; } catch (e) { full = ''; }\n  try { short = def.short(f) || ''; } catch (e) { short = ''; }\n  try { bib = def.bib(f) || ''; } catch (e) { bib = ''; }\n  // Clean up any stray double punctuation / spaces.\n  const tidy = s => s\n    .replace(/\\s+,/g, ',')\n    .replace(/,\\s*,/g, ',')\n    .replace(/;\\s*;/g, ';')\n    .replace(/\\(\\s*\\)/g, '')\n    .replace(/\\s{2,}/g, ' ')\n    .replace(/\\s+([.,;])/g, '$1')\n    .replace(/,\\s*\\(/g, ' (')\n    .replace(/\\.{2,}/g, '.')\n    .trim();\n  return { full: tidy(full), short: tidy(short), bib: tidy(bib) };\n}\n\nfunction updateOutputs() {\n  const c = buildCitations();\n  const placeholder = '<span class=\"text-gray-400 italic\">Fill in the fields above…</span>';\n  document.getElementById('outFull').innerHTML = c.full ? escapeHtml(c.full) : placeholder;\n  document.getElementById('outShort').innerHTML = c.short ? escapeHtml(c.short) : placeholder;\n  document.getElementById('outBib').innerHTML = c.bib ? escapeHtml(c.bib) : placeholder;\n}\n\nfunction escapeHtml(s) {\n  return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n}\n\n// ─── Copy ───────────────────────────────────────────────────────────────────\n\nfunction copyText(text, btn) {\n  const flash = () => {\n    const orig = btn.textContent;\n    btn.textContent = 'Copied!';\n    btn.classList.add('copied-flash');\n    setTimeout(() => { btn.textContent = orig; btn.classList.remove('copied-flash'); }, 1200);\n  };\n  if (navigator.clipboard && navigator.clipboard.writeText) {\n    navigator.clipboard.writeText(text).then(flash).catch(() => fallbackCopy(text, flash));\n  } else {\n    fallbackCopy(text, flash);\n  }\n}\n\nfunction fallbackCopy(text, cb) {\n  const ta = document.createElement('textarea');\n  ta.value = text;\n  ta.style.position = 'fixed';\n  ta.style.opacity = '0';\n  document.body.appendChild(ta);\n  ta.focus();\n  ta.select();\n  try { document.execCommand('copy'); cb && cb(); } catch (e) { /* ignore */ }\n  document.body.removeChild(ta);\n}\n\ndocument.querySelectorAll('.copy-btn').forEach(btn => {\n  btn.addEventListener('click', () => {\n    const id = btn.getAttribute('data-copy');\n    const el = document.getElementById(id);\n    const text = el.textContent.trim();\n    if (text && !/Fill in the fields/.test(text)) copyText(text, btn);\n  });\n});\n\n// ─── Saved citations ────────────────────────────────────────────────────────\n\nfunction renderSaved() {\n  const list = loadSaved();\n  const ul = document.getElementById('savedList');\n  const empty = document.getElementById('savedEmpty');\n  const count = document.getElementById('savedCount');\n  ul.innerHTML = '';\n  count.textContent = list.length ? '(' + list.length + ')' : '';\n  empty.style.display = list.length ? 'none' : 'block';\n  list.forEach((item, idx) => {\n    const li = document.createElement('li');\n    li.className = 'border border-gray-200 rounded-lg px-4 py-3 flex items-start gap-3';\n    const body = document.createElement('div');\n    body.className = 'flex-1 min-w-0';\n    const meta = document.createElement('div');\n    meta.className = 'text-[11px] uppercase tracking-wide font-semibold text-indigo-500 mb-1';\n    meta.textContent = item.typeName || 'Citation';\n    const txt = document.createElement('div');\n    txt.className = 'cite-out text-sm text-gray-800 leading-relaxed';\n    txt.textContent = item.text;\n    body.appendChild(meta);\n    body.appendChild(txt);\n    const actions = document.createElement('div');\n    actions.className = 'flex flex-col gap-1 flex-shrink-0';\n    const copyB = document.createElement('button');\n    copyB.className = 'copy-btn text-xs font-medium text-indigo-600 border border-indigo-200 rounded-md px-2 py-1 hover:bg-indigo-50 transition';\n    copyB.textContent = 'Copy';\n    copyB.addEventListener('click', () => copyText(item.text, copyB));\n    const rmB = document.createElement('button');\n    rmB.className = 'text-xs font-medium text-gray-400 border border-gray-200 rounded-md px-2 py-1 hover:text-red-600 hover:border-red-300 transition';\n    rmB.textContent = 'Remove';\n    rmB.addEventListener('click', () => {\n      const cur = loadSaved();\n      cur.splice(idx, 1);\n      storeSaved(cur);\n      renderSaved();\n    });\n    actions.appendChild(copyB);\n    actions.appendChild(rmB);\n    li.appendChild(body);\n    li.appendChild(actions);\n    ul.appendChild(li);\n  });\n}\n\ndocument.getElementById('saveBtn').addEventListener('click', () => {\n  const c = buildCitations();\n  if (!c.full) return;\n  const list = loadSaved();\n  list.unshift({ typeName: typeDef(currentType).name, text: c.full, ts: Date.now() });\n  storeSaved(list);\n  renderSaved();\n  const btn = document.getElementById('saveBtn');\n  const orig = btn.innerHTML;\n  btn.innerHTML = 'Saved ✓';\n  setTimeout(() => { btn.innerHTML = orig; }, 1100);\n});\n\n// ─── Clear ──────────────────────────────────────────────────────────────────\n\ndocument.getElementById('clearBtn').addEventListener('click', () => {\n  values[currentType] = {};\n  saveState();\n  renderFields();\n  updateOutputs();\n});\n\n// ─── Init ───────────────────────────────────────────────────────────────────\n\nloadState();\nrenderTypeButtons();\nrenderFields();\nupdateOutputs();\nrenderSaved();\n</script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Source Citation Builder",
    "windowTitle": "Source Citation Builder",
    "bundleId": "com.halisonworks.citationbuilder",
    "iconPath": null
  },
  "categoryId": null,
  "source": "import",
  "createdAt": "2026-06-02T12:00:00.000Z",
  "updatedAt": "2026-06-02T12:00:00.000Z",
