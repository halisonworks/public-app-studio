{
  "schema": "app-studio/canvas@1",
  "id": "example-biologisk-far-bayes",
  "name": "biologisk-far-bayes.html",
  "code": "<!DOCTYPE html>\n<!--\n  Bayesiansk farskaps-sannsynlighet — Halison App Studio-eksempel\n\n  En pedagogisk demonstrasjon av Bayes' teorem: oppdater sannsynligheten for at en dokumentert far er biologisk far ut fra en antatt feilfar-rate og eventuelt DNA-bevis. Ikke en farskapstest.\n\n  Fra Halison App Studio sitt offentlige bibliotek:\n  https://github.com/halisonworks/public-app-studio\n\n  Tillatt bruk: personlig, pedagogisk og annen ikke-kommersiell bruk. Behold denne\n  headeren og kildelenken intakt; du kan endre verktøyet, men ikke selg, kommersialiser\n  eller republiser det. Utgitt under Halison App Studio Examples License — se\n  LICENSE-filen i repoet over.\n-->\n<html lang=\"no\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Bayesiansk farskaps-sannsynlighet</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Inter', 'Segoe UI', sans-serif; }\n    input[type=number]::-webkit-inner-spin-button,\n    input[type=number]::-webkit-outer-spin-button { opacity: 1; }\n    input[type=range] { accent-color: #6366f1; }\n    .bar-track { transition: width 0.7s cubic-bezier(0.4,0,0.2,1); }\n    .fade-in { animation: fadeIn 0.4s ease; }\n    @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }\n    .evidence-card { transition: border-color 0.15s ease, background-color 0.15s ease; cursor: pointer; }\n    .evidence-card.selected { border-color: #6366f1; background-color: #eef2ff; }\n    .tooltip { position: relative; }\n    .tooltip:hover .tooltip-text { display: block; }\n    .tooltip-text { display: none; position: absolute; bottom: 125%; left: 50%; transform: translateX(-50%);\n      background: #1e293b; color: #f8fafc; font-size: 11px; padding: 4px 8px; border-radius: 5px;\n      white-space: nowrap; z-index: 50; pointer-events: none; }\n    .tooltip-text::after { content: ''; position: absolute; top: 100%; left: 50%; transform: translateX(-50%);\n      border: 5px solid transparent; border-top-color: #1e293b; }\n  </style>\n</head>\n<body class=\"bg-gray-50 min-h-screen\">\n\n  <!-- Header -->\n  <header class=\"bg-white border-b border-gray-200 sticky top-0 z-30 shadow-sm\">\n    <div class=\"max-w-4xl mx-auto px-4 py-4 flex items-center gap-3\">\n      <div class=\"w-9 h-9 rounded-lg bg-indigo-600 flex items-center justify-center flex-shrink-0\">\n        <svg class=\"w-5 h-5 text-white\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 4.5v15m0-15a3 3 0 100 6m0-6a3 3 0 110 6m-6 9a3 3 0 100-6m0 6a3 3 0 110-6m0 6c4 0 6-3 6-6m6 6a3 3 0 100-6m0 6a3 3 0 110-6m0 6c-4 0-6-3-6-6\" />\n        </svg>\n      </div>\n      <div>\n        <h1 class=\"text-lg font-bold text-gray-900 leading-tight\">Bayesiansk farskaps-sannsynlighet</h1>\n        <p class=\"text-xs text-gray-500\">Bayes' teorem for slektsforskere — feilfar-rate og DNA-bevis</p>\n      </div>\n    </div>\n  </header>\n\n  <main class=\"max-w-4xl mx-auto px-4 py-8 space-y-6\">\n\n    <!-- Forbehold-kort -->\n    <section class=\"bg-amber-50 border border-amber-200 rounded-2xl px-5 py-4 text-sm text-amber-900 leading-relaxed flex gap-3\">\n      <svg class=\"w-5 h-5 flex-shrink-0 mt-0.5 text-amber-600\" fill=\"currentColor\" viewBox=\"0 0 20 20\">\n        <path fill-rule=\"evenodd\" d=\"M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z\" clip-rule=\"evenodd\"/>\n      </svg>\n      <div>\n        <strong class=\"text-amber-800\">Viktig forbehold:</strong> Dette er en <strong>pedagogisk demonstrasjon av Bayes' teorem</strong>, IKKE en farskapstest og ikke juridisk eller medisinsk rådgivning. Ekte farskapstesting gjøres ved akkrediterte laboratorier med mange DNA-markører. Tallene under (feilfar-rate og likelihood-forhold) er illustrative og kan justeres; delt-cM-områdene overlapper i praksis.\n      </div>\n    </section>\n\n    <!-- PRIOR -->\n    <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n      <div class=\"flex items-center gap-2 mb-1\">\n        <span class=\"w-6 h-6 rounded-full bg-indigo-100 text-indigo-700 flex items-center justify-center font-bold text-xs\">1</span>\n        <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider\">Prior — utgangspunktet</h2>\n      </div>\n      <p class=\"text-sm text-gray-600 mb-5\">Før vi ser på DNA: hvor sannsynlig er det at den dokumenterte faren faktisk er biologisk far? Det avhenger av hvor ofte «feilfar»-hendelser (NPE — <em>non-paternity events</em>) skjer.</p>\n\n      <div class=\"rounded-xl border border-gray-200 p-5 bg-gray-50\">\n        <div class=\"flex items-center justify-between mb-2\">\n          <label for=\"npeRate\" class=\"text-sm font-medium text-gray-700\">Antatt feilfar-rate (NPE) per generasjon</label>\n          <span id=\"npeRateLabel\" class=\"text-sm font-bold text-indigo-700 tabular-nums\">1,5 %</span>\n        </div>\n        <input id=\"npeRate\" type=\"range\" min=\"0.5\" max=\"10\" step=\"0.1\" value=\"1.5\" class=\"w-full\" />\n        <div class=\"flex justify-between text-xs text-gray-400 mt-1\">\n          <span>0,5 %</span><span>10 %</span>\n        </div>\n        <p class=\"text-xs text-gray-500 mt-3 leading-relaxed\">\n          Historiske og genetiske anslag ligger ofte rundt <strong>1–2 %</strong> per generasjon i vestlige befolkninger. Prior P(dokumentert far er biologisk) = 1 − rate.\n        </p>\n        <div class=\"mt-4 bg-white rounded-lg border border-indigo-100 px-4 py-3 flex items-center justify-between\">\n          <span class=\"text-xs text-indigo-600 font-medium\">Prior P(biologisk far)</span>\n          <span id=\"priorPct\" class=\"text-xl font-bold text-indigo-700 tabular-nums\">98,5 %</span>\n        </div>\n      </div>\n    </section>\n\n    <!-- BEVIS -->\n    <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n      <div class=\"flex items-center gap-2 mb-1\">\n        <span class=\"w-6 h-6 rounded-full bg-indigo-100 text-indigo-700 flex items-center justify-center font-bold text-xs\">2</span>\n        <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider\">Bevis — hva sier DNA-en?</h2>\n      </div>\n      <p class=\"text-sm text-gray-600 mb-5\">Velg ett resultat. Hvert bevis har et <strong>likelihood-forhold (LR)</strong> som sier hvor mange ganger mer (eller mindre) sannsynlig observasjonen er hvis faren <em>er</em> biologisk far, sammenlignet med hvis han ikke er det. Du kan overstyre standardverdiene.</p>\n\n      <div id=\"evidenceList\" class=\"space-y-3\"></div>\n\n      <p class=\"text-xs text-gray-400 mt-4 leading-relaxed\">\n        cM = centimorgan, et mål på mengden delt DNA. Forelder–barn deler typisk ~3400–3700 cM; tall i mellomsjiktet kan komme fra onkel, tante, halvsøsken eller besteforelder, og områdene overlapper. LR over 1 støtter farskap, under 1 taler mot, og 0 betyr utelukket.\n      </p>\n    </section>\n\n    <!-- RESULTAT -->\n    <div id=\"resultsSection\" class=\"space-y-5 fade-in\">\n\n      <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n        <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider mb-5\">Resultat — posterior sannsynlighet</h2>\n\n        <!-- Tre tall -->\n        <div class=\"grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6\">\n          <div class=\"rounded-xl border border-gray-200 p-4 bg-gray-50\">\n            <div class=\"text-xs text-gray-500 font-medium mb-1\">Prior</div>\n            <div id=\"rPrior\" class=\"text-2xl font-bold text-gray-700 tabular-nums\">—</div>\n            <div class=\"text-xs text-gray-400 mt-0.5\">før DNA</div>\n          </div>\n          <div class=\"rounded-xl border border-gray-200 p-4 bg-gray-50\">\n            <div class=\"text-xs text-gray-500 font-medium mb-1 tooltip\">\n              Likelihood-forhold (LR)\n              <span class=\"tooltip-text\">Hvor mye beviset flytter oddsen</span>\n            </div>\n            <div id=\"rLR\" class=\"text-2xl font-bold text-gray-700 tabular-nums\">—</div>\n            <div id=\"rLRdir\" class=\"text-xs text-gray-400 mt-0.5\">&nbsp;</div>\n          </div>\n          <div class=\"rounded-xl border-2 border-indigo-300 p-4 bg-indigo-50\">\n            <div class=\"text-xs text-indigo-600 font-medium mb-1\">Posterior P(biologisk far)</div>\n            <div id=\"rPosterior\" class=\"text-3xl font-extrabold text-indigo-700 tabular-nums\">—</div>\n            <div class=\"text-xs text-indigo-400 mt-0.5\">etter DNA</div>\n          </div>\n        </div>\n\n        <!-- Visualisering prior -> posterior -->\n        <div class=\"space-y-3\">\n          <div>\n            <div class=\"flex justify-between text-xs text-gray-500 mb-1\">\n              <span>Prior</span><span id=\"barPriorPct\" class=\"tabular-nums\">—</span>\n            </div>\n            <div class=\"w-full h-4 bg-gray-100 rounded-full overflow-hidden\">\n              <div id=\"barPrior\" class=\"bar-track h-full bg-gray-400 rounded-full\" style=\"width:0%\"></div>\n            </div>\n          </div>\n          <div class=\"flex justify-center text-gray-300\">\n            <svg class=\"w-5 h-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M19 14l-7 7m0 0l-7-7m7 7V3\"/></svg>\n          </div>\n          <div>\n            <div class=\"flex justify-between text-xs text-indigo-600 font-medium mb-1\">\n              <span>Posterior</span><span id=\"barPostPct\" class=\"tabular-nums\">—</span>\n            </div>\n            <div class=\"w-full h-5 bg-gray-100 rounded-full overflow-hidden\">\n              <div id=\"barPost\" class=\"bar-track h-full bg-indigo-500 rounded-full\" style=\"width:0%\"></div>\n            </div>\n          </div>\n        </div>\n\n        <!-- Tolkning -->\n        <div id=\"interpretation\" class=\"mt-6 rounded-xl px-5 py-4 text-sm leading-relaxed border\"></div>\n      </section>\n\n      <!-- Metode -->\n      <section class=\"bg-gray-50 rounded-xl border border-gray-200 px-5 py-4 text-xs text-gray-500 leading-relaxed\">\n        <strong class=\"text-gray-700\">Metode (Bayes' teorem på odds-form):</strong>\n        Prior P = 1 − rate. Prior-odds = P / (1 − P). Posterior-odds = prior-odds × LR (eller 0 hvis utelukket). Posterior-sannsynlighet = odds / (1 + odds). Denne forenklingen behandler ett samlet bevis med ett LR; et ekte laboratorium kombinerer mange uavhengige markører. Verdiene er illustrative.\n      </section>\n\n    </div>\n  </main>\n\n  <footer class=\"max-w-4xl mx-auto px-4 py-6 text-center text-xs text-gray-400\">\n    Bayesiansk farskaps-sannsynlighet &mdash; <a href=\"https://github.com/halisonworks/public-app-studio\" class=\"underline hover:text-indigo-500\" target=\"_blank\" rel=\"noopener\">Halison App Studio</a>\n  </footer>\n\n<script>\n// ─── Bevisalternativer (id, etikett, beskrivelse, standard-LR, utelukket-flagg) ──\nconst EVIDENCE = [\n  { id: 'none',      label: 'Ingen DNA-test',\n    desc: 'Vi har bare det dokumenterte (skriftlige) farskapet.', lr: 1, excluded: false },\n  { id: 'auto_high', label: 'Autosomal DNA: deler ca. 3300–3700 cM',\n    desc: 'Forelder–barn-nivå. Støtter farskap sterkt.', lr: 1000, excluded: false },\n  { id: 'auto_mid',  label: 'Autosomal DNA: deler ca. 1300–2500 cM',\n    desc: 'Nær slekt, men ikke forelder — f.eks. onkel eller halvbror. Taler mot.', lr: 0.001, excluded: false },\n  { id: 'auto_zero', label: 'Autosomal DNA: deler ~0 cM (ingen match)',\n    desc: 'Utelukket. Den dokumenterte faren kan ikke være biologisk far.', lr: 0, excluded: true },\n  { id: 'y_match',   label: 'Y-DNA: patrilineær linje matcher',\n    desc: 'Støtter farskap — gjelder kun farslinjen (gjelder ikke for døtre).', lr: 100, excluded: false },\n  { id: 'y_nomatch', label: 'Y-DNA: patrilineær linje matcher IKKE',\n    desc: 'Taler mot farskap for farslinjen.', lr: 0.0005, excluded: false },\n];\n\n// Brukerens (ev. overstyrte) LR-verdier, indeksert på id\nconst lrValues = {};\nEVIDENCE.forEach(e => { lrValues[e.id] = e.lr; });\nlet selectedId = 'none';\n\n// ─── Formatering ──────────────────────────────────────────────────────────────\nfunction pctNo(x, decimals) {\n  if (decimals === undefined) decimals = 1;\n  return (x * 100).toFixed(decimals).replace('.', ',') + ' %';\n}\nfunction fmtNum(x) {\n  if (x === 0) return '0';\n  // pen visning av store og små LR-verdier\n  if (x >= 1) {\n    return (Number.isInteger(x) ? x.toString() : x.toFixed(2)).replace('.', ',');\n  }\n  // små tall\n  let s = x.toString();\n  if (s.includes('e') || x < 0.0001) s = x.toExponential(1);\n  return s.replace('.', ',');\n}\n\n// ─── Bygg bevisliste i DOM ──────────────────────────────────────────────────────\nfunction buildEvidence() {\n  const list = document.getElementById('evidenceList');\n  list.innerHTML = '';\n  EVIDENCE.forEach(e => {\n    const card = document.createElement('label');\n    card.className = 'evidence-card block rounded-xl border-2 border-gray-200 p-4' +\n      (e.id === selectedId ? ' selected' : '');\n    card.setAttribute('data-id', e.id);\n\n    const lrField = e.excluded\n      ? `<span class=\"text-xs font-semibold text-red-600 px-2 py-1 bg-red-50 rounded-md border border-red-200\">Utelukket (LR = 0)</span>`\n      : `<div class=\"flex items-center gap-2\">\n           <span class=\"text-xs text-gray-500 font-medium\">LR =</span>\n           <input type=\"number\" step=\"any\" min=\"0\" value=\"${e.lr}\"\n             data-lr-input=\"${e.id}\"\n             class=\"w-28 border border-gray-300 rounded-lg px-2 py-1 text-sm text-gray-800 tabular-nums focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent\" />\n         </div>`;\n\n    card.innerHTML = `\n      <div class=\"flex items-start gap-3\">\n        <input type=\"radio\" name=\"evidence\" value=\"${e.id}\" class=\"mt-1 accent-indigo-600 w-4 h-4 flex-shrink-0\" ${e.id === selectedId ? 'checked' : ''} />\n        <div class=\"flex-1 min-w-0\">\n          <div class=\"flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2\">\n            <span class=\"font-medium text-gray-800 text-sm\">${e.label}</span>\n            ${lrField}\n          </div>\n          <p class=\"text-xs text-gray-500 mt-1\">${e.desc}</p>\n        </div>\n      </div>`;\n    list.appendChild(card);\n  });\n\n  // Lyttere: radio\n  list.querySelectorAll('input[name=\"evidence\"]').forEach(r => {\n    r.addEventListener('change', () => {\n      selectedId = r.value;\n      list.querySelectorAll('.evidence-card').forEach(c =>\n        c.classList.toggle('selected', c.getAttribute('data-id') === selectedId));\n      calculate();\n    });\n  });\n\n  // Lyttere: LR-overstyring\n  list.querySelectorAll('input[data-lr-input]').forEach(inp => {\n    inp.addEventListener('input', () => {\n      const id = inp.getAttribute('data-lr-input');\n      const v = parseFloat(inp.value);\n      lrValues[id] = (isNaN(v) || v < 0) ? 0 : v;\n      // Hvis brukeren redigerer LR på et ikke-valgt kort, velg det også\n      if (id !== selectedId) {\n        const radio = list.querySelector(`input[name=\"evidence\"][value=\"${id}\"]`);\n        if (radio) { radio.checked = true; selectedId = id; }\n        list.querySelectorAll('.evidence-card').forEach(c =>\n          c.classList.toggle('selected', c.getAttribute('data-id') === selectedId));\n      }\n      calculate();\n    });\n  });\n}\n\n// ─── Tolkningstekst ─────────────────────────────────────────────────────────────\nfunction interpret(ev, posterior, prior) {\n  if (ev.excluded) {\n    return {\n      cls: 'bg-red-50 border-red-200 text-red-800',\n      html: '<strong>Utelukket.</strong> Den dokumenterte faren kan ikke være biologisk far ved dette resultatet — uten delt autosomalt DNA er farskap praktisk talt umulig. Sannsynligheten faller til ~0 %.'\n    };\n  }\n  if (posterior >= 0.999) {\n    return {\n      cls: 'bg-emerald-50 border-emerald-200 text-emerald-800',\n      html: `<strong>Svært sterk støtte.</strong> Beviset styrker antakelsen kraftig: posterior ≈ ${pctNo(posterior, 1)}. Et treff på forelder–barn-nivå gjør det nær sikkert at faren er biologisk.`\n    };\n  }\n  if (posterior >= 0.95) {\n    return {\n      cls: 'bg-emerald-50 border-emerald-200 text-emerald-800',\n      html: `<strong>Sterk støtte.</strong> Posterior ≈ ${pctNo(posterior, 1)} — beviset trekker tydelig i retning av at den dokumenterte faren er biologisk far.`\n    };\n  }\n  if (posterior > prior + 0.0005) {\n    return {\n      cls: 'bg-indigo-50 border-indigo-200 text-indigo-800',\n      html: `<strong>Noe støtte.</strong> Beviset løfter sannsynligheten fra ${pctNo(prior, 1)} til ${pctNo(posterior, 1)}.`\n    };\n  }\n  if (posterior < 0.05) {\n    return {\n      cls: 'bg-red-50 border-red-200 text-red-800',\n      html: `<strong>Taler sterkt mot farskap.</strong> Posterior ≈ ${pctNo(posterior, 1)} — beviset gjør det lite sannsynlig at den dokumenterte faren er biologisk far. En annen, beslektet mann (f.eks. en bror eller onkel) kan være et bedre kandidat.`\n    };\n  }\n  if (posterior < prior - 0.0005) {\n    return {\n      cls: 'bg-orange-50 border-orange-200 text-orange-800',\n      html: `<strong>Taler mot.</strong> Beviset senker sannsynligheten fra ${pctNo(prior, 1)} til ${pctNo(posterior, 1)}.`\n    };\n  }\n  return {\n    cls: 'bg-gray-50 border-gray-200 text-gray-700',\n    html: `<strong>Nøytralt.</strong> Med LR = 1 endrer beviset ingenting: posterior = prior = ${pctNo(posterior, 1)}.`\n  };\n}\n\n// ─── Hovedberegning ─────────────────────────────────────────────────────────────\nfunction calculate() {\n  const rate = parseFloat(document.getElementById('npeRate').value) / 100;\n  const ev = EVIDENCE.find(e => e.id === selectedId);\n  const LR = lrValues[selectedId];\n\n  // Bayes på odds-form (som spesifisert)\n  const P = 1 - rate;                  // prior\n  const priorOdds = P / (1 - P);\n  const posteriorOdds = LR === 0 ? 0 : priorOdds * LR;\n  const posterior = LR === 0 ? 0 : posteriorOdds / (1 + posteriorOdds);\n\n  // Prior-seksjon\n  document.getElementById('npeRateLabel').textContent = (rate * 100).toFixed(1).replace('.', ',') + ' %';\n  document.getElementById('priorPct').textContent = pctNo(P, 1);\n\n  // Resultatkort\n  document.getElementById('rPrior').textContent = pctNo(P, 1);\n  document.getElementById('rLR').textContent = ev.excluded ? '0' : fmtNum(LR);\n  const dir = document.getElementById('rLRdir');\n  if (ev.excluded || LR === 0) { dir.textContent = 'utelukker'; dir.className = 'text-xs text-red-500 mt-0.5'; }\n  else if (LR > 1) { dir.textContent = 'støtter farskap'; dir.className = 'text-xs text-emerald-600 mt-0.5'; }\n  else if (LR < 1) { dir.textContent = 'taler mot'; dir.className = 'text-xs text-orange-600 mt-0.5'; }\n  else { dir.textContent = 'nøytralt'; dir.className = 'text-xs text-gray-400 mt-0.5'; }\n\n  document.getElementById('rPosterior').textContent =\n    (posterior > 0 && posterior < 0.001) ? '< 0,1 %' :\n    (posterior > 0.999 && posterior < 1) ? '> 99,9 %' :\n    pctNo(posterior, 1);\n\n  // Søyler\n  const priorW = Math.max(0, Math.min(100, P * 100));\n  const postW = Math.max(0, Math.min(100, posterior * 100));\n  document.getElementById('barPrior').style.width = priorW + '%';\n  document.getElementById('barPost').style.width = postW + '%';\n  document.getElementById('barPriorPct').textContent = pctNo(P, 1);\n  document.getElementById('barPostPct').textContent = pctNo(posterior, 1);\n\n  // Tolkning\n  const interp = interpret(ev, posterior, P);\n  const box = document.getElementById('interpretation');\n  box.className = 'mt-6 rounded-xl px-5 py-4 text-sm leading-relaxed border ' + interp.cls;\n  box.innerHTML = interp.html;\n\n  // Lagre\n  try {\n    localStorage.setItem('farbayes', JSON.stringify({\n      rate: rate * 100, selectedId, lrValues\n    }));\n  } catch (e) { /* ignorer */ }\n}\n\n// ─── Slider-lytter ──────────────────────────────────────────────────────────────\ndocument.getElementById('npeRate').addEventListener('input', calculate);\n\n// ─── Gjenopprett / init ─────────────────────────────────────────────────────────\n(function restoreOrInit() {\n  try {\n    const saved = JSON.parse(localStorage.getItem('farbayes'));\n    if (saved) {\n      if (typeof saved.rate === 'number') {\n        document.getElementById('npeRate').value = Math.min(10, Math.max(0.5, saved.rate));\n      }\n      if (saved.selectedId && EVIDENCE.some(e => e.id === saved.selectedId)) {\n        selectedId = saved.selectedId;\n      }\n      if (saved.lrValues) {\n        EVIDENCE.forEach(e => {\n          if (!e.excluded && typeof saved.lrValues[e.id] === 'number' && saved.lrValues[e.id] >= 0) {\n            lrValues[e.id] = saved.lrValues[e.id];\n          }\n        });\n      }\n    }\n  } catch (e) { /* ignorer */ }\n  buildEvidence();\n  calculate();\n})();\n</script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Bayesiansk farskaps-sannsynlighet",
    "windowTitle": "Bayesiansk farskaps-sannsynlighet",
    "bundleId": "com.halisonworks.biologiskfarbayes",
    "iconPath": null
  },
  "categoryId": null,
  "source": "import",
  "createdAt": "2026-06-02T12:00:00.000Z",
  "updatedAt": "2026-06-02T12:00:00.000Z",
  "sharedAt": "2026-06-02T12:00:00.000Z"
}
