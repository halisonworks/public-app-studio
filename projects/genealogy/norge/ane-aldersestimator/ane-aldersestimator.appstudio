{
  "schema": "app-studio/canvas@1",
  "id": "example-ane-aldersestimator",
  "name": "ane-aldersestimator.html",
  "code": "<!DOCTYPE html>\n<!--\n  Ane-aldersestimator — Halison App Studio-eksempel\n\n  Estimer sannsynlige fødselsår for foreldre, besteforeldre og eldre aner ut fra en persons fødselsår, for å avgrense søk i Digitalarkivet og andre kilder.\n\n  Fra Halison App Studio sitt offentlige bibliotek:\n  https://github.com/halisonworks/public-app-studio\n\n  Tillatt bruk: personlig, pedagogisk og annen ikke-kommersiell bruk. Behold denne\n  headeren og kildelenken intakt; du kan endre verktøyet, men ikke selg, kommersialiser\n  eller republiser det. Utgitt under Halison App Studio Examples License — se\n  LICENSE-filen i repoet over.\n-->\n<html lang=\"no\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Ane-aldersestimator</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Inter', 'Segoe UI', sans-serif; }\n    input[type=number]::-webkit-inner-spin-button,\n    input[type=number]::-webkit-outer-spin-button { opacity: 1; }\n    input[type=range] { accent-color: #4f46e5; }\n    .fade-in { animation: fadeIn 0.35s ease; }\n    @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }\n    .gen-row { transition: background-color 0.15s ease; }\n    .gen-row:hover { background-color: #f9fafb; }\n  </style>\n</head>\n<body class=\"bg-gray-50 min-h-screen\">\n\n  <!-- Header -->\n  <header class=\"bg-white border-b border-gray-200 sticky top-0 z-30 shadow-sm\">\n    <div class=\"max-w-4xl mx-auto px-4 py-4 flex items-center gap-3\">\n      <div class=\"w-9 h-9 rounded-lg bg-indigo-600 flex items-center justify-center flex-shrink-0\">\n        <svg class=\"w-5 h-5 text-white\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 4a3 3 0 100 6 3 3 0 000-6zM5 20a3 3 0 100-6 3 3 0 000 6zm14 0a3 3 0 100-6 3 3 0 000 6zM12 10v4m0 0l-5 3m5-3l5 3\" />\n        </svg>\n      </div>\n      <div>\n        <h1 class=\"text-lg font-bold text-gray-900 leading-tight\">Ane-aldersestimator</h1>\n        <p class=\"text-xs text-gray-500\">Sannsynlige fødselsår for foreldre og forfedre — for å avgrense arkivsøk</p>\n      </div>\n    </div>\n  </header>\n\n  <main class=\"max-w-4xl mx-auto px-4 py-8 space-y-6\">\n\n    <!-- Input Section -->\n    <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n      <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider mb-5\">Kjent person</h2>\n      <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n        <div>\n          <label class=\"block text-xs font-medium text-gray-500 mb-1\">Fødselsår</label>\n          <input id=\"birthYear\" type=\"number\" min=\"1400\" max=\"2025\" value=\"1850\"\n            class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent\"\n            placeholder=\"f.eks. 1850\" />\n          <p class=\"text-xs text-gray-400 mt-1\">Året personen du tar utgangspunkt i ble født.</p>\n        </div>\n        <div>\n          <label class=\"block text-xs font-medium text-gray-500 mb-1\">\n            Generasjoner bakover: <span id=\"genLabel\" class=\"font-bold text-indigo-600\">4</span>\n          </label>\n          <input id=\"generations\" type=\"range\" min=\"1\" max=\"6\" value=\"4\" step=\"1\" class=\"w-full mt-2\" />\n          <div class=\"flex justify-between text-xs text-gray-400 mt-1 px-0.5\">\n            <span>1</span><span>2</span><span>3</span><span>4</span><span>5</span><span>6</span>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- Parameters Section -->\n    <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n      <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-5\">\n        <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider\">Alder ved barnets fødsel</h2>\n        <div class=\"flex flex-wrap gap-2\">\n          <span class=\"text-xs text-gray-400 self-center mr-1\">Forhåndsinnstilling:</span>\n          <button data-preset=\"1700\" class=\"preset-btn text-xs font-medium px-3 py-1.5 rounded-lg border border-gray-300 text-gray-700 hover:bg-indigo-50 hover:border-indigo-300 transition\">1700-tallet</button>\n          <button data-preset=\"1800\" class=\"preset-btn text-xs font-medium px-3 py-1.5 rounded-lg border border-gray-300 text-gray-700 hover:bg-indigo-50 hover:border-indigo-300 transition\">1800-tallet</button>\n          <button data-preset=\"1900\" class=\"preset-btn text-xs font-medium px-3 py-1.5 rounded-lg border border-gray-300 text-gray-700 hover:bg-indigo-50 hover:border-indigo-300 transition\">Moderne (1900+)</button>\n        </div>\n      </div>\n\n      <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n        <!-- Far -->\n        <div class=\"rounded-xl border-2 border-blue-200 p-5 space-y-4\">\n          <div class=\"flex items-center gap-2\">\n            <span class=\"w-7 h-7 rounded-full bg-blue-100 text-blue-700 flex items-center justify-center font-bold text-sm\">♂</span>\n            <span class=\"font-semibold text-gray-800\">Fars alder</span>\n          </div>\n          <div class=\"grid grid-cols-3 gap-3\">\n            <div>\n              <label class=\"block text-xs font-medium text-gray-500 mb-1\">Nedre</label>\n              <input id=\"farLo\" type=\"number\" min=\"12\" max=\"80\" value=\"24\"\n                class=\"w-full border border-gray-300 rounded-lg px-2 py-2 text-gray-800 text-sm text-center focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n            </div>\n            <div>\n              <label class=\"block text-xs font-medium text-gray-500 mb-1\">Median</label>\n              <input id=\"farMid\" type=\"number\" min=\"12\" max=\"80\" value=\"33\"\n                class=\"w-full border border-gray-300 rounded-lg px-2 py-2 text-gray-800 text-sm text-center font-semibold focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n            </div>\n            <div>\n              <label class=\"block text-xs font-medium text-gray-500 mb-1\">Øvre</label>\n              <input id=\"farHi\" type=\"number\" min=\"12\" max=\"80\" value=\"45\"\n                class=\"w-full border border-gray-300 rounded-lg px-2 py-2 text-gray-800 text-sm text-center focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n            </div>\n          </div>\n          <p class=\"text-xs text-gray-400\">Antall år far er eldre enn barnet.</p>\n        </div>\n\n        <!-- Mor -->\n        <div class=\"rounded-xl border-2 border-rose-200 p-5 space-y-4\">\n          <div class=\"flex items-center gap-2\">\n            <span class=\"w-7 h-7 rounded-full bg-rose-100 text-rose-700 flex items-center justify-center font-bold text-sm\">♀</span>\n            <span class=\"font-semibold text-gray-800\">Mors alder</span>\n          </div>\n          <div class=\"grid grid-cols-3 gap-3\">\n            <div>\n              <label class=\"block text-xs font-medium text-gray-500 mb-1\">Nedre</label>\n              <input id=\"morLo\" type=\"number\" min=\"12\" max=\"60\" value=\"20\"\n                class=\"w-full border border-gray-300 rounded-lg px-2 py-2 text-gray-800 text-sm text-center focus:outline-none focus:ring-2 focus:ring-rose-400\" />\n            </div>\n            <div>\n              <label class=\"block text-xs font-medium text-gray-500 mb-1\">Median</label>\n              <input id=\"morMid\" type=\"number\" min=\"12\" max=\"60\" value=\"30\"\n                class=\"w-full border border-gray-300 rounded-lg px-2 py-2 text-gray-800 text-sm text-center font-semibold focus:outline-none focus:ring-2 focus:ring-rose-400\" />\n            </div>\n            <div>\n              <label class=\"block text-xs font-medium text-gray-500 mb-1\">Øvre</label>\n              <input id=\"morHi\" type=\"number\" min=\"12\" max=\"60\" value=\"44\"\n                class=\"w-full border border-gray-300 rounded-lg px-2 py-2 text-gray-800 text-sm text-center focus:outline-none focus:ring-2 focus:ring-rose-400\" />\n            </div>\n          </div>\n          <p class=\"text-xs text-rose-500 flex items-start gap-1\">\n            <svg class=\"w-3.5 h-3.5 flex-shrink-0 mt-0.5\" fill=\"currentColor\" viewBox=\"0 0 20 20\"><path fill-rule=\"evenodd\" d=\"M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z\" clip-rule=\"evenodd\"/></svg>\n            <span>Øvre verdi er en biologisk yttergrense. Sett den ikke for høyt.</span>\n          </p>\n        </div>\n      </div>\n    </section>\n\n    <!-- Error Banner -->\n    <div id=\"errorBanner\" class=\"hidden bg-red-50 border border-red-200 rounded-xl px-5 py-3 text-red-700 text-sm flex items-center gap-2\">\n      <svg class=\"w-4 h-4 flex-shrink-0\" fill=\"currentColor\" viewBox=\"0 0 20 20\"><path fill-rule=\"evenodd\" d=\"M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z\" clip-rule=\"evenodd\"/></svg>\n      <span id=\"errorText\"></span>\n    </div>\n\n    <!-- Results -->\n    <div id=\"resultsSection\" class=\"space-y-6 fade-in\">\n\n      <!-- Summary Card -->\n      <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n        <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3\">Sammendrag</h2>\n        <p id=\"summaryText\" class=\"text-xl font-bold text-gray-800\"></p>\n        <p class=\"text-sm text-gray-500 mt-2 flex items-start gap-1.5\">\n          <svg class=\"w-4 h-4 flex-shrink-0 mt-0.5 text-indigo-500\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"/></svg>\n          <span>Bruk fødselsårs-vinduet <span class=\"font-medium text-gray-600\">[laveste–høyeste]</span> som dato-filter når du søker i Digitalarkivet, kirkebøker og folketellinger.</span>\n        </p>\n      </section>\n\n      <!-- Generations -->\n      <section class=\"space-y-5\">\n        <div id=\"generationsContainer\" class=\"space-y-5\"></div>\n      </section>\n\n      <!-- Omvendt -->\n      <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n        <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4\">Omvendt — når fikk hun barn?</h2>\n        <p class=\"text-sm text-gray-500 mb-4\">Gitt en kvinnes fødselsår, vis vinduet for når barna hennes sannsynligvis ble født (mors alder 18–44 år).</p>\n        <div class=\"flex flex-col sm:flex-row sm:items-end gap-4\">\n          <div class=\"sm:w-48\">\n            <label class=\"block text-xs font-medium text-gray-500 mb-1\">Kvinnens fødselsår</label>\n            <input id=\"revYear\" type=\"number\" min=\"1400\" max=\"2025\" value=\"1820\"\n              class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400\" />\n          </div>\n          <div class=\"flex-1 bg-indigo-50 rounded-xl px-5 py-4 border border-indigo-100\">\n            <div class=\"text-xs text-indigo-600 font-medium uppercase tracking-wider mb-1\">Barna trolig født</div>\n            <div id=\"revResult\" class=\"text-lg font-bold text-indigo-800\">—</div>\n          </div>\n        </div>\n      </section>\n\n      <!-- About / How it works -->\n      <section class=\"bg-gray-50 rounded-2xl border border-gray-200 p-6\">\n        <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3\">Om / slik fungerer det</h2>\n        <div class=\"text-sm text-gray-600 leading-relaxed space-y-3\">\n          <p>\n            Verktøyet bygger et anetre fra en kjent persons fødselsår. For hver ane regnes et\n            <span class=\"font-medium text-gray-700\">mest sannsynlige fødselsår</span> ved å trekke median-alderen til far/mor fra barnets år,\n            samt et <span class=\"font-medium text-gray-700\">fødselsårs-vindu</span> ut fra nedre og øvre alder. Vinduet blir naturlig bredere jo lenger\n            tilbake du går — det er forventet, og gjenspeiler økende usikkerhet.\n          </p>\n          <p class=\"flex items-start gap-1.5\">\n            <svg class=\"w-4 h-4 flex-shrink-0 mt-0.5 text-amber-500\" fill=\"currentColor\" viewBox=\"0 0 20 20\"><path fill-rule=\"evenodd\" d=\"M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z\" clip-rule=\"evenodd\"/></svg>\n            <span>\n              <span class=\"font-semibold text-gray-700\">Forbehold:</span> Dette er et statistisk hjelpemiddel, ikke fakta. Estimatene er ikke\n              dokumentasjon på faktiske personer. Bruk dem kun som søkefilter for å avgrense leting i kilder — verifiser alltid mot\n              primærkilder som kirkebøker og folketellinger.\n            </span>\n          </p>\n        </div>\n      </section>\n\n    </div>\n  </main>\n\n  <footer class=\"max-w-4xl mx-auto px-4 py-6 text-center text-xs text-gray-400\">\n    Ane-aldersestimator &mdash; <a href=\"https://github.com/halisonworks/public-app-studio\" class=\"underline hover:text-indigo-500\" target=\"_blank\" rel=\"noopener\">Halison App Studio</a>\n  </footer>\n\n<script>\n// ─── Konstanter ──────────────────────────────────────────────────────────────\n\nvar MIN_YEAR = 1400;\nvar MAX_YEAR = 2025;\n\n// Forhåndsinnstillinger: [farLo, farMid, farHi, morLo, morMid, morHi]\nvar PRESETS = {\n  '1700': { farLo: 25, farMid: 34, farHi: 48, morLo: 20, morMid: 28, morHi: 44 },\n  '1800': { farLo: 24, farMid: 33, farHi: 45, morLo: 20, morMid: 30, morHi: 44 },\n  '1900': { farLo: 23, farMid: 30, farHi: 42, morLo: 21, morMid: 29, morHi: 42 }\n};\n\n// Generasjonsnavn (samlebetegnelse per nivå over personen)\nvar GEN_NAMES = ['Foreldre', 'Besteforeldre', 'Oldeforeldre', 'Tippoldeforeldre',\n                 'Tipptippoldeforeldre', 'Tipptipptippoldeforeldre'];\n\n// ─── DOM-hjelpere ────────────────────────────────────────────────────────────\n\nfunction out(id) { return document.getElementById(id); }\nfunction valNum(id) { return parseInt(out(id).value, 10); }\n\n// ─── Relasjonsnavn ───────────────────────────────────────────────────────────\n\n// Bygg \"olde\"/\"tippolde\"-prefiks for et gitt antall generasjoner over besteledd.\n// extra = 0 -> \"beste\", 1 -> \"olde\", 2 -> \"tippolde\", 3 -> \"tipptippolde\", ...\nfunction oldePrefix(extra) {\n  if (extra === 0) return 'beste';\n  var p = 'olde';\n  for (var i = 1; i < extra; i++) p = 'tipp' + p;\n  return p;\n}\n\n// Returner relasjonsnavn ut fra generasjon (1 = foreldre) og kjønn ('m'/'f'),\n// samt linjen (sekvens av 'm'/'f' fra personen og oppover, der siste ledd er denne anen).\nfunction relationName(gen, line) {\n  // line: array av 'far'/'mor'-steg fra personen og opp til denne anen.\n  // For gen 1: \"far\"/\"mor\".\n  // For gen 2: \"farfar\",\"farmor\",\"morfar\",\"mormor\".\n  // For gen 3: \"olde\" + bestebetegnelse, f.eks. \"oldefar (fars side)\".\n  var sex = line[line.length - 1]; // 'm' eller 'f' for denne anen selv\n  var selfWord = sex === 'm' ? 'far' : 'mor';\n\n  if (gen === 1) {\n    return sex === 'm' ? 'far' : 'mor';\n  }\n  if (gen === 2) {\n    // line = [child-side, self]. F.eks. ['m','m'] = farfar.\n    var via = line[0] === 'm' ? 'far' : 'mor';\n    return via + selfWord; // farfar, farmor, morfar, mormor\n  }\n  // gen >= 3: prefiks \"olde\"/\"tippolde\" + \"far\"/\"mor\", med side-angivelse.\n  var prefix = oldePrefix(gen - 2); // gen3 -> \"olde\", gen4 -> \"tippolde\"\n  var sideVia = line[0] === 'm' ? 'fars' : 'mors';\n  return prefix + selfWord + ' (' + sideVia + ' side)';\n}\n\n// ─── Beregning ───────────────────────────────────────────────────────────────\n\nfunction clampYear(y) { return y; }\n\nfunction computeTree(birthYear, generations, p) {\n  // Hver node: { gen, line, sex, lo, hi, mid }\n  // Start: personen selv (gen 0)\n  var root = { gen: 0, line: [], sex: null, lo: birthYear, hi: birthYear, mid: birthYear };\n\n  // Vi samler aner per generasjon.\n  var perGen = [];\n  for (var g = 0; g < generations; g++) perGen.push([]);\n\n  function expand(child) {\n    if (child.gen >= generations) return;\n    // Far\n    var far = {\n      gen: child.gen + 1,\n      line: child.line.concat(['m']),\n      sex: 'm',\n      mid: child.mid - p.farMid,\n      lo: child.lo - p.farHi,\n      hi: child.hi - p.farLo\n    };\n    // Mor\n    var mor = {\n      gen: child.gen + 1,\n      line: child.line.concat(['f']),\n      sex: 'f',\n      mid: child.mid - p.morMid,\n      lo: child.lo - p.morHi,\n      hi: child.hi - p.morLo\n    };\n    perGen[far.gen - 1].push(far);\n    perGen[mor.gen - 1].push(mor);\n    expand(far);\n    expand(mor);\n  }\n  expand(root);\n  return perGen;\n}\n\n// ─── Rendering ───────────────────────────────────────────────────────────────\n\nfunction genTitle(gen) {\n  if (gen <= GEN_NAMES.length) return GEN_NAMES[gen - 1];\n  return gen + '. generasjons aner';\n}\n\nfunction sexBadge(sex) {\n  if (sex === 'm') {\n    return '<span class=\"inline-flex items-center justify-center w-6 h-6 rounded-full bg-blue-100 text-blue-700 text-xs font-bold\">♂</span>';\n  }\n  return '<span class=\"inline-flex items-center justify-center w-6 h-6 rounded-full bg-rose-100 text-rose-700 text-xs font-bold\">♀</span>';\n}\n\nfunction capitalize(s) { return s.charAt(0).toUpperCase() + s.slice(1); }\n\nfunction renderTree(perGen) {\n  var container = out('generationsContainer');\n  container.innerHTML = '';\n\n  for (var g = 0; g < perGen.length; g++) {\n    var gen = g + 1;\n    var aner = perGen[g];\n\n    var card = document.createElement('section');\n    card.className = 'bg-white rounded-2xl shadow-sm border border-gray-200 p-6';\n\n    var header = document.createElement('div');\n    header.className = 'flex items-center justify-between mb-4';\n    header.innerHTML =\n      '<h3 class=\"text-sm font-semibold text-gray-700\">' + genTitle(gen) +\n      '</h3><span class=\"text-xs text-gray-400\">' + aner.length + ' aner &middot; ' + (gen) + '. generasjon</span>';\n    card.appendChild(header);\n\n    var list = document.createElement('div');\n    list.className = 'divide-y divide-gray-100';\n\n    for (var i = 0; i < aner.length; i++) {\n      var a = aner[i];\n      var rel = relationName(gen, a.line);\n      var row = document.createElement('div');\n      row.className = 'gen-row flex items-center gap-3 py-2.5 px-2 -mx-2 rounded-lg';\n      row.innerHTML =\n        sexBadge(a.sex) +\n        '<div class=\"flex-1 min-w-0\">' +\n          '<div class=\"text-sm font-medium text-gray-800 truncate\">' + capitalize(rel) + '</div>' +\n          '<div class=\"text-xs text-gray-400\">' + (a.sex === 'm' ? 'Mann' : 'Kvinne') + '</div>' +\n        '</div>' +\n        '<div class=\"text-right flex-shrink-0\">' +\n          '<div class=\"text-base font-bold text-indigo-600\">' + a.mid + '</div>' +\n          '<div class=\"text-xs text-gray-500 font-mono\">[' + a.lo + '–' + a.hi + ']</div>' +\n        '</div>';\n      list.appendChild(row);\n    }\n\n    card.appendChild(list);\n    container.appendChild(card);\n  }\n}\n\n// ─── Omvendt ─────────────────────────────────────────────────────────────────\n\nfunction renderReverse() {\n  var y = parseInt(out('revYear').value, 10);\n  var el = out('revResult');\n  if (isNaN(y) || y < MIN_YEAR || y > MAX_YEAR) {\n    el.textContent = 'Skriv inn et gyldig årstall (' + MIN_YEAR + '–' + MAX_YEAR + ').';\n    el.className = 'text-sm font-medium text-red-500';\n    return;\n  }\n  var lo = y + 18;\n  var hi = y + 44;\n  el.className = 'text-lg font-bold text-indigo-800';\n  el.innerHTML = 'ca. <span class=\"font-mono\">' + lo + '–' + hi + '</span> ' +\n    '<span class=\"text-sm font-normal text-indigo-500\">(mors alder 18–44)</span>';\n}\n\n// ─── Validering + hovedløp ───────────────────────────────────────────────────\n\nfunction readParams() {\n  return {\n    farLo: valNum('farLo'), farMid: valNum('farMid'), farHi: valNum('farHi'),\n    morLo: valNum('morLo'), morMid: valNum('morMid'), morHi: valNum('morHi')\n  };\n}\n\nfunction validate(birthYear, p) {\n  var errors = [];\n  if (isNaN(birthYear) || birthYear < MIN_YEAR || birthYear > MAX_YEAR) {\n    errors.push('Fødselsår må være mellom ' + MIN_YEAR + ' og ' + MAX_YEAR + '.');\n  }\n  var keys = ['farLo','farMid','farHi','morLo','morMid','morHi'];\n  for (var i = 0; i < keys.length; i++) {\n    if (isNaN(p[keys[i]])) { errors.push('Alle aldersverdier må fylles ut.'); break; }\n  }\n  if (errors.length === 0) {\n    if (!(p.farLo <= p.farMid && p.farMid <= p.farHi)) {\n      errors.push('Fars alder må følge rekkefølgen nedre ≤ median ≤ øvre.');\n    }\n    if (!(p.morLo <= p.morMid && p.morMid <= p.morHi)) {\n      errors.push('Mors alder må følge rekkefølgen nedre ≤ median ≤ øvre.');\n    }\n  }\n  return errors;\n}\n\nfunction calculate() {\n  var birthYear = valNum('birthYear');\n  var generations = valNum('generations');\n  var p = readParams();\n\n  out('genLabel').textContent = generations;\n\n  var errors = validate(birthYear, p);\n  var errBanner = out('errorBanner');\n  var resultsSection = out('resultsSection');\n\n  if (errors.length > 0) {\n    out('errorText').textContent = errors[0];\n    errBanner.classList.remove('hidden');\n    resultsSection.classList.add('opacity-30', 'pointer-events-none');\n    renderReverse();\n    persist();\n    return;\n  }\n  errBanner.classList.add('hidden');\n  resultsSection.classList.remove('opacity-30', 'pointer-events-none');\n\n  var perGen = computeTree(birthYear, generations, p);\n\n  // Sammendrag: foreldre (generasjon 1) = [far, mor]\n  var parents = perGen[0];\n  var far = parents[0], mor = parents[1];\n  out('summaryText').innerHTML =\n    'Foreldre trolig født ca. <span class=\"text-indigo-600\">' + far.mid + '</span> (far) / ' +\n    '<span class=\"text-indigo-600\">' + mor.mid + '</span> (mor)';\n\n  renderTree(perGen);\n  renderReverse();\n  persist();\n}\n\n// ─── Forhåndsinnstillinger ───────────────────────────────────────────────────\n\nfunction applyPreset(key) {\n  var p = PRESETS[key];\n  if (!p) return;\n  out('farLo').value = p.farLo; out('farMid').value = p.farMid; out('farHi').value = p.farHi;\n  out('morLo').value = p.morLo; out('morMid').value = p.morMid; out('morHi').value = p.morHi;\n  calculate();\n}\n\n// ─── localStorage ────────────────────────────────────────────────────────────\n\nfunction persist() {\n  try {\n    var state = {\n      birthYear: out('birthYear').value,\n      generations: out('generations').value,\n      farLo: out('farLo').value, farMid: out('farMid').value, farHi: out('farHi').value,\n      morLo: out('morLo').value, morMid: out('morMid').value, morHi: out('morHi').value,\n      revYear: out('revYear').value\n    };\n    localStorage.setItem('aneEstimator', JSON.stringify(state));\n  } catch (e) { /* ignorer */ }\n}\n\nfunction restore() {\n  try {\n    var saved = JSON.parse(localStorage.getItem('aneEstimator'));\n    if (!saved) return;\n    var ids = ['birthYear','generations','farLo','farMid','farHi','morLo','morMid','morHi','revYear'];\n    for (var i = 0; i < ids.length; i++) {\n      if (saved[ids[i]] !== undefined && saved[ids[i]] !== null) out(ids[i]).value = saved[ids[i]];\n    }\n  } catch (e) { /* ignorer */ }\n}\n\n// ─── Hendelser ───────────────────────────────────────────────────────────────\n\nvar liveIds = ['birthYear','generations','farLo','farMid','farHi','morLo','morMid','morHi'];\nfor (var i = 0; i < liveIds.length; i++) {\n  out(liveIds[i]).addEventListener('input', calculate);\n}\nout('revYear').addEventListener('input', function () { renderReverse(); persist(); });\n\nvar presetBtns = document.querySelectorAll('.preset-btn');\nfor (var j = 0; j < presetBtns.length; j++) {\n  presetBtns[j].addEventListener('click', function () {\n    applyPreset(this.getAttribute('data-preset'));\n  });\n}\n\n// ─── Init ────────────────────────────────────────────────────────────────────\n\nrestore();\ncalculate();\n</script>\n</body>\n</html>\n",
