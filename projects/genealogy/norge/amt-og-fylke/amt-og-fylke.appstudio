{
  "schema": "app-studio/canvas@1",
  "id": "example-amt-og-fylke",
  "name": "amt-og-fylke.html",
  "code": "<!DOCTYPE html>\n<!--\n  Amt ↔ fylke — Halison App Studio-eksempel\n\n  Slå opp gamle norske amtsnavn mot dagens fylker, og se hvordan inndelingen endret seg i 1919, 2020 og 2024 — for å forstå stedsnavn i gamle kilder.\n\n  Fra Halison App Studio sitt offentlige bibliotek:\n  https://github.com/halisonworks/public-app-studio\n\n  Tillatt bruk: personlig, pedagogisk og annen ikke-kommersiell bruk. Behold denne\n  headeren og kildelenken intakt; du kan endre verktøyet, men ikke selg, kommersialiser\n  eller republiser det. Utgitt under Halison App Studio Examples License — se\n  LICENSE-filen i repoet over.\n-->\n<html lang=\"no\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Amt ↔ fylke</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Inter', 'Segoe UI', sans-serif; }\n    .fade-in { animation: fadeIn 0.35s ease; }\n    @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }\n    .row-hover { transition: background-color 0.15s ease; cursor: pointer; }\n    .row-hover:hover { background-color: #eef2ff; }\n    mark { background: #fde68a; color: #92400e; padding: 0 1px; border-radius: 2px; }\n    .timeline-dot { box-shadow: 0 0 0 3px #fff, 0 0 0 5px #c7d2fe; }\n    .pill { font-size: 11px; padding: 1px 8px; border-radius: 9999px; font-weight: 600; white-space: nowrap; }\n    .pill-amt { background: #fef3c7; color: #92400e; }\n    .pill-1919 { background: #dbeafe; color: #1e40af; }\n    .pill-2020 { background: #ede9fe; color: #5b21b6; }\n    .pill-2024 { background: #d1fae5; color: #065f46; }\n  </style>\n</head>\n<body class=\"bg-gray-50 min-h-screen\">\n\n  <!-- Header -->\n  <header class=\"bg-white border-b border-gray-200 sticky top-0 z-30 shadow-sm\">\n    <div class=\"max-w-5xl mx-auto px-4 py-4 flex items-center gap-3\">\n      <div class=\"w-9 h-9 rounded-lg bg-indigo-600 flex items-center justify-center flex-shrink-0\">\n        <svg class=\"w-5 h-5 text-white\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7\" />\n        </svg>\n      </div>\n      <div>\n        <h1 class=\"text-lg font-bold text-gray-900 leading-tight\">Amt ↔ fylke</h1>\n        <p class=\"text-xs text-gray-500\">Gamle amtsnavn mot dagens fylker — og forvaltningshistorien bak</p>\n      </div>\n    </div>\n  </header>\n\n  <main class=\"max-w-5xl mx-auto px-4 py-8 space-y-6\">\n\n    <!-- Om-kort -->\n    <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n      <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3\">Om inndelingen</h2>\n      <div class=\"text-sm text-gray-600 leading-relaxed space-y-3\">\n        <p>\n          Norge var delt inn i <strong class=\"text-gray-800\">amt</strong> fram til\n          <strong class=\"text-gray-800\">1. januar 1919</strong>, da amtene ble til\n          <strong class=\"text-gray-800\">fylker</strong> og de fleste fikk nye, fornorska navn.\n          Byen <em>Kristiania</em> ble til <em>Oslo</em> i 1925.\n        </p>\n        <p>\n          I <strong class=\"text-gray-800\">2020</strong> ble en rekke fylker slått sammen til\n          større regioner (regionreformen). Flere av disse ble\n          <strong class=\"text-gray-800\">delt opp igjen fra 1. januar 2024</strong>, slik at\n          gamle fylkesnavn som Østfold, Akershus, Buskerud, Vestfold, Telemark, Troms og\n          Finnmark ble gjenoppretta.\n        </p>\n        <p class=\"text-gray-500\">\n          Verktøyet hjelper deg å tolke stedsnavn i gamle kilder: et amtsnavn i en kirkebok\n          eller folketelling kan slås opp mot fylket det ble til — og videre fram til dagens\n          inndeling.\n        </p>\n      </div>\n    </section>\n\n    <!-- Hierarki-kort -->\n    <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n      <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4\">Forvaltningshierarki</h2>\n      <div class=\"flex flex-wrap items-center gap-2 text-sm\">\n        <span class=\"px-3 py-1.5 rounded-lg bg-gray-100 text-gray-700 font-semibold\">Rike</span>\n        <svg class=\"w-4 h-4 text-gray-300\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M9 5l7 7-7 7\"/></svg>\n        <span class=\"px-3 py-1.5 rounded-lg bg-amber-100 text-amber-800 font-semibold\">Amt / fylke</span>\n        <svg class=\"w-4 h-4 text-gray-300\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M9 5l7 7-7 7\"/></svg>\n        <span class=\"px-3 py-1.5 rounded-lg bg-indigo-100 text-indigo-800 font-semibold\">Fogderi / prestegjeld</span>\n        <svg class=\"w-4 h-4 text-gray-300\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M9 5l7 7-7 7\"/></svg>\n        <span class=\"px-3 py-1.5 rounded-lg bg-emerald-100 text-emerald-800 font-semibold\">Sokn / tinglag</span>\n      </div>\n      <p class=\"text-xs text-gray-500 leading-relaxed mt-4\">\n        <strong class=\"text-gray-700\">Merk:</strong> kirkebøkene er ordna etter\n        <em>prestegjeld</em> og <em>sokn</em>, ikke etter amt eller fylke. Når du vet hvilket\n        amt et sted lå i, må du finne riktig prestegjeld og sokn for å lete i kirkebøkene —\n        søk i <span class=\"font-medium text-gray-700\">Digitalarkivet</span> for disse.\n      </p>\n    </section>\n\n    <!-- Slå opp motsatt vei -->\n    <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n      <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4\">Slå opp motsatt vei</h2>\n      <p class=\"text-xs text-gray-500 mb-3\">Skriv inn et moderne fylke (1919–2019) for å se hvilket amt det tilsvarte.</p>\n      <div class=\"flex flex-col sm:flex-row gap-3\">\n        <input id=\"reverseInput\" type=\"text\" autocomplete=\"off\"\n          class=\"flex-1 border border-gray-300 rounded-lg px-3 py-2 text-gray-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent\"\n          placeholder=\"f.eks. Østfold, Hedmark, Sør-Trøndelag…\" list=\"fylkeList\" />\n        <datalist id=\"fylkeList\"></datalist>\n      </div>\n      <div id=\"reverseResult\" class=\"mt-4 hidden fade-in\"></div>\n    </section>\n\n    <!-- Søk + tabell -->\n    <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n      <div class=\"flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4\">\n        <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider\">Amtene og fylkene deres</h2>\n        <span id=\"resultCount\" class=\"text-xs text-gray-400\"></span>\n      </div>\n\n      <div class=\"relative mb-5\">\n        <svg class=\"w-4 h-4 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z\"/></svg>\n        <input id=\"searchInput\" type=\"text\" autocomplete=\"off\"\n          class=\"w-full border border-gray-300 rounded-lg pl-9 pr-3 py-2 text-gray-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent\"\n          placeholder=\"Søk på amt, fylke eller region…\" />\n      </div>\n\n      <!-- Desktop tabell -->\n      <div class=\"hidden md:block overflow-x-auto\">\n        <table class=\"w-full text-sm border-collapse\">\n          <thead>\n            <tr class=\"text-left text-xs uppercase tracking-wider text-gray-400 border-b border-gray-200\">\n              <th class=\"py-2 pr-3 font-semibold\">Amt <span class=\"font-normal normal-case text-gray-300\">(før 1919)</span></th>\n              <th class=\"py-2 px-3 font-semibold\">Fylke <span class=\"font-normal normal-case text-gray-300\">(1919–2019)</span></th>\n              <th class=\"py-2 px-3 font-semibold\">Region <span class=\"font-normal normal-case text-gray-300\">(2020–2023)</span></th>\n              <th class=\"py-2 pl-3 font-semibold\">Status fra 2024</th>\n            </tr>\n          </thead>\n          <tbody id=\"tableBody\"></tbody>\n        </table>\n      </div>\n\n      <!-- Mobil liste -->\n      <div id=\"cardList\" class=\"md:hidden space-y-2\"></div>\n\n      <p id=\"noResults\" class=\"hidden text-sm text-gray-400 text-center py-8\">Ingen treff. Prøv et annet søkeord.</p>\n    </section>\n\n  </main>\n\n  <!-- Detalj-modal -->\n  <div id=\"detailOverlay\" class=\"hidden fixed inset-0 z-40 bg-black/40 flex items-end sm:items-center justify-center p-0 sm:p-4\">\n    <div id=\"detailCard\" class=\"bg-white w-full sm:max-w-lg sm:rounded-2xl rounded-t-2xl shadow-xl max-h-[90vh] overflow-y-auto fade-in\"></div>\n  </div>\n\n  <footer class=\"max-w-5xl mx-auto px-4 py-6 text-center text-xs text-gray-400\">\n    Amt ↔ fylke &mdash; <a href=\"https://github.com/halisonworks/public-app-studio\" class=\"underline hover:text-indigo-500\" target=\"_blank\" rel=\"noopener\">Halison App Studio</a>\n  </footer>\n\n<script>\n// ─── Data ─────────────────────────────────────────────────────────────────────\nconst DATA = [\n {amt:'Smaalenenes amt', fylke:'Østfold', r2020:'Viken', r2024:'Østfold (gjenoppretta)'},\n {amt:'Akershus amt', fylke:'Akershus', r2020:'Viken', r2024:'Akershus (gjenoppretta)'},\n {amt:'Kristiania (by)', fylke:'Oslo', r2020:'Oslo', r2024:'Oslo'},\n {amt:'Hedemarkens amt', fylke:'Hedmark', r2020:'Innlandet', r2024:'Innlandet'},\n {amt:'Kristians amt', fylke:'Oppland', r2020:'Innlandet', r2024:'Innlandet'},\n {amt:'Buskeruds amt', fylke:'Buskerud', r2020:'Viken', r2024:'Buskerud (gjenoppretta)'},\n {amt:'Jarlsberg og Larviks amt', fylke:'Vestfold', r2020:'Vestfold og Telemark', r2024:'Vestfold (gjenoppretta)'},\n {amt:'Bratsberg amt', fylke:'Telemark', r2020:'Vestfold og Telemark', r2024:'Telemark (gjenoppretta)'},\n {amt:'Nedenes amt', fylke:'Aust-Agder', r2020:'Agder', r2024:'Agder'},\n {amt:'Lister og Mandals amt', fylke:'Vest-Agder', r2020:'Agder', r2024:'Agder'},\n {amt:'Stavanger amt', fylke:'Rogaland', r2020:'Rogaland', r2024:'Rogaland'},\n {amt:'Søndre Bergenhus amt', fylke:'Hordaland', r2020:'Vestland', r2024:'Vestland'},\n {amt:'Bergen (by)', fylke:'Bergen (eget fylke til 1972, så Hordaland)', r2020:'Vestland', r2024:'Vestland'},\n {amt:'Nordre Bergenhus amt', fylke:'Sogn og Fjordane', r2020:'Vestland', r2024:'Vestland'},\n {amt:'Romsdals amt', fylke:'Møre og Romsdal', r2020:'Møre og Romsdal', r2024:'Møre og Romsdal'},\n {amt:'Søndre Trondhjems amt', fylke:'Sør-Trøndelag', r2020:'Trøndelag', r2024:'Trøndelag'},\n {amt:'Nordre Trondhjems amt', fylke:'Nord-Trøndelag', r2020:'Trøndelag', r2024:'Trøndelag'},\n {amt:'Nordlands amt', fylke:'Nordland', r2020:'Nordland', r2024:'Nordland'},\n {amt:'Tromsø amt', fylke:'Troms', r2020:'Troms og Finnmark', r2024:'Troms (gjenoppretta)'},\n {amt:'Finmarkens amt', fylke:'Finnmark', r2020:'Troms og Finnmark', r2024:'Finnmark (gjenoppretta)'}\n];\n\n// Korte merknader per amt (vises i detaljkortet der det er relevant)\nconst NOTES = {\n  'Kristiania (by)': 'Hovedstaden het Kristiania fram til 1925, da bynavnet ble endra til Oslo. I gamle kilder før 1925 finner du derfor «Christiania» eller «Kristiania».',\n  'Bergen (by)': 'Bergen var en egen bykommune og eget fylke fram til 1972, da byen ble slått sammen med Hordaland fylke.',\n  'Hedemarkens amt': 'Skrives «Hedemarkens» i amtsperioden; fylkesnavnet ble «Hedmark» fra 1919.',\n  'Søndre Trondhjems amt': 'Trondhjem ble skrevet med «-hjem» i amtsnavnet; byen het offisielt Trondhjem til 1930. Fylket ble «Sør-Trøndelag».',\n  'Nordre Trondhjems amt': 'Tilsvarende ble «Nordre Trondhjems amt» til fylket «Nord-Trøndelag» i 1919.',\n  'Smaalenenes amt': 'Det gamle amtsnavnet «Smaalenene» ble erstatta av fylkesnavnet «Østfold» i 1919.',\n  'Finmarkens amt': 'Skrives «Finmarkens» (med én n) i amtsperioden; fylkesnavnet ble «Finnmark».',\n  'Jarlsberg og Larviks amt': 'Slått sammen av de gamle grevskapene Jarlsberg og Larvik; ble fylket «Vestfold» i 1919.',\n  'Bratsberg amt': 'Det gamle amtsnavnet «Bratsberg» ble erstatta av fylkesnavnet «Telemark» i 1919.'\n};\n\n// ─── Hjelpefunksjoner ─────────────────────────────────────────────────────────\nfunction esc(s) {\n  return String(s).replace(/[&<>\"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\n}\nfunction norm(s) {\n  return String(s).toLowerCase().trim();\n}\nfunction highlight(text, query) {\n  const safe = esc(text);\n  if (!query) return safe;\n  const q = norm(query);\n  const lower = text.toLowerCase();\n  const idx = lower.indexOf(q);\n  if (idx === -1) return safe;\n  // Bygg highlight på ren tekst, så escape per del\n  const before = text.slice(0, idx);\n  const match = text.slice(idx, idx + q.length);\n  const after = text.slice(idx + q.length);\n  return esc(before) + '<mark>' + esc(match) + '</mark>' + esc(after);\n}\n\n// ─── DOM-refs ─────────────────────────────────────────────────────────────────\nconst tableBody = document.getElementById('tableBody');\nconst cardList = document.getElementById('cardList');\nconst searchInput = document.getElementById('searchInput');\nconst noResults = document.getElementById('noResults');\nconst resultCount = document.getElementById('resultCount');\n\n// ─── Render tabell + mobilliste ───────────────────────────────────────────────\nfunction render(query) {\n  const q = norm(query);\n  const rows = DATA.filter(d =>\n    !q ||\n    norm(d.amt).includes(q) ||\n    norm(d.fylke).includes(q) ||\n    norm(d.r2020).includes(q) ||\n    norm(d.r2024).includes(q)\n  );\n\n  tableBody.innerHTML = '';\n  cardList.innerHTML = '';\n\n  rows.forEach(d => {\n    const i = DATA.indexOf(d);\n\n    // Desktop-rad\n    const tr = document.createElement('tr');\n    tr.className = 'row-hover border-b border-gray-100';\n    tr.setAttribute('data-idx', i);\n    tr.innerHTML =\n      '<td class=\"py-3 pr-3 font-semibold text-gray-800\">' + highlight(d.amt, query) + '</td>' +\n      '<td class=\"py-3 px-3 text-gray-700\">' + highlight(d.fylke, query) + '</td>' +\n      '<td class=\"py-3 px-3 text-gray-500\">' + highlight(d.r2020, query) + '</td>' +\n      '<td class=\"py-3 pl-3 text-gray-700\">' + highlight(d.r2024, query) + '</td>';\n    tableBody.appendChild(tr);\n\n    // Mobilkort\n    const card = document.createElement('div');\n    card.className = 'row-hover border border-gray-200 rounded-xl p-3';\n    card.setAttribute('data-idx', i);\n    card.innerHTML =\n      '<div class=\"font-semibold text-gray-800 mb-2\">' + highlight(d.amt, query) + '</div>' +\n      '<div class=\"grid grid-cols-1 gap-1 text-xs\">' +\n        '<div class=\"flex gap-2\"><span class=\"pill pill-1919\">1919</span><span class=\"text-gray-700\">' + highlight(d.fylke, query) + '</span></div>' +\n        '<div class=\"flex gap-2\"><span class=\"pill pill-2020\">2020</span><span class=\"text-gray-600\">' + highlight(d.r2020, query) + '</span></div>' +\n        '<div class=\"flex gap-2\"><span class=\"pill pill-2024\">2024</span><span class=\"text-gray-700\">' + highlight(d.r2024, query) + '</span></div>' +\n      '</div>';\n    cardList.appendChild(card);\n  });\n\n  const has = rows.length > 0;\n  noResults.classList.toggle('hidden', has);\n  resultCount.textContent = rows.length + ' av ' + DATA.length;\n}\n\n// ─── Detaljkort (tidslinje) ───────────────────────────────────────────────────\nconst overlay = document.getElementById('detailOverlay');\nconst detailCard = document.getElementById('detailCard');\n\nfunction timelineStep(year, label, value, pillClass, isLast) {\n  return (\n    '<div class=\"relative pl-8 ' + (isLast ? '' : 'pb-6') + '\">' +\n      (isLast ? '' : '<span class=\"absolute left-[7px] top-3 bottom-0 w-0.5 bg-indigo-100\"></span>') +\n      '<span class=\"absolute left-0 top-1.5 w-3.5 h-3.5 rounded-full bg-indigo-500 timeline-dot\"></span>' +\n      '<div class=\"flex items-center gap-2 mb-0.5\">' +\n        '<span class=\"pill ' + pillClass + '\">' + esc(year) + '</span>' +\n        '<span class=\"text-xs uppercase tracking-wider text-gray-400 font-semibold\">' + esc(label) + '</span>' +\n      '</div>' +\n      '<div class=\"text-gray-800 font-semibold\">' + esc(value) + '</div>' +\n    '</div>'\n  );\n}\n\nfunction openDetail(idx) {\n  const d = DATA[idx];\n  const note = NOTES[d.amt];\n  detailCard.innerHTML =\n    '<div class=\"p-6\">' +\n      '<div class=\"flex items-start justify-between gap-4 mb-5\">' +\n        '<div>' +\n          '<p class=\"text-xs uppercase tracking-wider text-gray-400 font-semibold mb-1\">Tidslinje</p>' +\n          '<h3 class=\"text-xl font-bold text-gray-900\">' + esc(d.amt) + '</h3>' +\n        '</div>' +\n        '<button id=\"closeDetail\" class=\"text-gray-400 hover:text-gray-700 flex-shrink-0 -mt-1 -mr-1 p-1\" aria-label=\"Lukk\">' +\n          '<svg class=\"w-6 h-6\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M6 18L18 6M6 6l12 12\"/></svg>' +\n        '</button>' +\n      '</div>' +\n      '<div class=\"mb-5\">' +\n        timelineStep('før 1919', 'Amt', d.amt, 'pill-amt', false) +\n        timelineStep('1919', 'Fylke', d.fylke, 'pill-1919', false) +\n        timelineStep('2020', 'Region', d.r2020, 'pill-2020', false) +\n        timelineStep('2024', 'Status', d.r2024, 'pill-2024', true) +\n      '</div>' +\n      (note\n        ? '<div class=\"bg-amber-50 border border-amber-200 rounded-xl px-4 py-3 text-sm text-amber-900 leading-relaxed flex gap-2\">' +\n            '<svg class=\"w-4 h-4 flex-shrink-0 mt-0.5\" fill=\"currentColor\" viewBox=\"0 0 20 20\"><path fill-rule=\"evenodd\" d=\"M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z\" clip-rule=\"evenodd\"/></svg>' +\n            '<span>' + esc(note) + '</span>' +\n          '</div>'\n        : '') +\n      '<p class=\"text-xs text-gray-400 mt-5 leading-relaxed\">Kirkebøker er ordna etter prestegjeld og sokn — bruk fylket over til å finne riktig prestegjeld, og søk i Digitalarkivet.</p>' +\n    '</div>';\n\n  overlay.classList.remove('hidden');\n  document.body.style.overflow = 'hidden';\n  document.getElementById('closeDetail').addEventListener('click', closeDetail);\n}\n\nfunction closeDetail() {\n  overlay.classList.add('hidden');\n  document.body.style.overflow = '';\n}\n\noverlay.addEventListener('click', e => { if (e.target === overlay) closeDetail(); });\ndocument.addEventListener('keydown', e => { if (e.key === 'Escape') closeDetail(); });\n\n// Delegert klikk på rader / kort\nfunction bindRowClick(container) {\n  container.addEventListener('click', e => {\n    const el = e.target.closest('[data-idx]');\n    if (el) openDetail(parseInt(el.getAttribute('data-idx'), 10));\n  });\n}\nbindRowClick(tableBody);\nbindRowClick(cardList);\n\n// ─── Slå opp motsatt vei ──────────────────────────────────────────────────────\nconst reverseInput = document.getElementById('reverseInput');\nconst reverseResult = document.getElementById('reverseResult');\nconst fylkeList = document.getElementById('fylkeList');\n\n// Fyll datalist med fylkesnavn (1919). Ta hovednavnet før parentes.\nconst fylkeNames = [...new Set(DATA.map(d => d.fylke.replace(/\\s*\\(.*\\)\\s*$/, '').trim()))];\nfylkeNames.forEach(n => {\n  const opt = document.createElement('option');\n  opt.value = n;\n  fylkeList.appendChild(opt);\n});\n\nfunction reverseLookup(query) {\n  const q = norm(query);\n  if (!q) { reverseResult.classList.add('hidden'); reverseResult.innerHTML = ''; return; }\n\n  const matches = DATA.filter(d => norm(d.fylke).includes(q));\n  reverseResult.classList.remove('hidden');\n\n  if (matches.length === 0) {\n    reverseResult.innerHTML =\n      '<div class=\"bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-sm text-gray-500\">' +\n        'Fant ingen fylker som matcher «' + esc(query) + '». Prøv f.eks. Østfold, Hedmark eller Sør-Trøndelag.' +\n      '</div>';\n    return;\n  }\n\n  const items = matches.map(d =>\n    '<button type=\"button\" data-idx=\"' + DATA.indexOf(d) + '\" class=\"rev-pick w-full text-left bg-indigo-50 border border-indigo-200 rounded-xl px-4 py-3 hover:bg-indigo-100 transition-colors\">' +\n      '<div class=\"flex items-center gap-2 flex-wrap\">' +\n        '<span class=\"pill pill-1919\">Fylke</span>' +\n        '<span class=\"font-semibold text-gray-800\">' + esc(d.fylke) + '</span>' +\n        '<svg class=\"w-4 h-4 text-gray-300\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M11 17l-5-5m0 0l5-5m-5 5h12\"/></svg>' +\n        '<span class=\"pill pill-amt\">Amt</span>' +\n        '<span class=\"font-semibold text-gray-800\">' + esc(d.amt) + '</span>' +\n      '</div>' +\n      '<div class=\"text-xs text-gray-500 mt-1\">Klikk for hele tidslinjen</div>' +\n    '</button>'\n  ).join('');\n\n  reverseResult.innerHTML = '<div class=\"space-y-2\">' + items + '</div>';\n  reverseResult.querySelectorAll('.rev-pick').forEach(btn => {\n    btn.addEventListener('click', () => openDetail(parseInt(btn.getAttribute('data-idx'), 10)));\n  });\n}\n\n// ─── Hendelser ────────────────────────────────────────────────────────────────\nsearchInput.addEventListener('input', () => {\n  render(searchInput.value);\n  try { localStorage.setItem('amtfylke_search', searchInput.value); } catch (e) { /* ignore */ }\n});\nreverseInput.addEventListener('input', () => {\n  reverseLookup(reverseInput.value);\n  try { localStorage.setItem('amtfylke_reverse', reverseInput.value); } catch (e) { /* ignore */ }\n});\n\n// ─── Init + gjenoppretting ────────────────────────────────────────────────────\n(function init() {\n  try {\n    const s = localStorage.getItem('amtfylke_search');\n    if (s) searchInput.value = s;\n    const r = localStorage.getItem('amtfylke_reverse');\n    if (r) reverseInput.value = r;\n  } catch (e) { /* ignore */ }\n  render(searchInput.value);\n  if (reverseInput.value) reverseLookup(reverseInput.value);\n})();\n</script>\n</body>\n</html>\n",
