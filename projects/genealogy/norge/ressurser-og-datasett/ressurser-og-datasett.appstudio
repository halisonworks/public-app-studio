{
  "schema": "app-studio/canvas@1",
  "id": "example-ressurser-og-datasett",
  "name": "ressurser-og-datasett.html",
  "code": "<!DOCTYPE html>\n<!--\n  Ressurser & datasett — Halison App Studio-eksempel\n\n  Et organisert, søkbart lenkebibliotek til de viktigste kildene for norsk slektsforskning: arkiver, folketellinger, kirkebøker, foreninger, gravminner, DNA og mer.\n\n  Fra Halison App Studio sitt offentlige bibliotek:\n  https://github.com/halisonworks/public-app-studio\n\n  Tillatt bruk: personlig, pedagogisk og annen ikke-kommersiell bruk. Behold denne\n  headeren og kildelenken intakt; du kan endre verktøyet, men ikke selg, kommersialiser\n  eller republiser det. Utgitt under Halison App Studio Examples License — se\n  LICENSE-filen i repoet over.\n-->\n<html lang=\"no\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Ressurser & datasett — Norsk slektsforskning</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Inter', 'Segoe UI', sans-serif; }\n    .fade-in { animation: fadeIn 0.35s ease; }\n    @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }\n    .badge-free { background: #d1fae5; color: #065f46; border: 1px solid #6ee7b7; }\n    .badge-paid { background: #fef3c7; color: #92400e; border: 1px solid #fcd34d; }\n    .badge-mix  { background: #e0e7ff; color: #3730a3; border: 1px solid #a5b4fc; }\n    .star-btn { transition: transform 0.15s ease, color 0.15s ease; }\n    .star-btn:hover { transform: scale(1.18); }\n    .star-on { color: #f59e0b; }\n    .star-off { color: #d1d5db; }\n    mark { background: #fde68a; color: inherit; border-radius: 2px; padding: 0 1px; }\n    .card { transition: box-shadow 0.18s ease, border-color 0.18s ease; }\n    .card:hover { box-shadow: 0 4px 14px -2px rgba(79,70,229,0.12); border-color: #c7d2fe; }\n  </style>\n</head>\n<body class=\"bg-gray-50 min-h-screen\">\n\n  <!-- Header -->\n  <header class=\"bg-white border-b border-gray-200 sticky top-0 z-30 shadow-sm\">\n    <div class=\"max-w-5xl mx-auto px-4 py-4 flex items-center gap-3\">\n      <div class=\"w-9 h-9 rounded-lg bg-indigo-600 flex items-center justify-center flex-shrink-0\">\n        <!-- bokstabel/lenke ikon -->\n        <svg class=\"w-5 h-5 text-white\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253\" />\n        </svg>\n      </div>\n      <div>\n        <h1 class=\"text-lg font-bold text-gray-900 leading-tight\">Ressurser &amp; datasett</h1>\n        <p class=\"text-xs text-gray-500\">Norsk slektsforskning</p>\n      </div>\n    </div>\n  </header>\n\n  <main class=\"max-w-5xl mx-auto px-4 py-8 space-y-6\">\n\n    <!-- Om-kort -->\n    <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n      <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3\">Om denne siden</h2>\n      <p class=\"text-sm text-gray-600 leading-relaxed\">\n        Dette er en startside med eksterne lenker til de viktigste kildene for norsk slektsforskning.\n        Nettsteder kan endre adresse over tid, så en lenke kan av og til peke et nytt sted eller være utdatert.\n        Noen baser er gratis, andre krever abonnement eller medlemskap — dette er merket på hvert kort med\n        <span class=\"inline-block align-middle text-xs font-semibold px-2 py-0.5 rounded-full badge-free\">Gratis</span>,\n        <span class=\"inline-block align-middle text-xs font-semibold px-2 py-0.5 rounded-full badge-paid\">Betalt</span> eller\n        <span class=\"inline-block align-middle text-xs font-semibold px-2 py-0.5 rounded-full badge-mix\">Gratis/medlem</span>.\n        Trykk på stjernen for å lagre en favoritt — favorittene dine vises øverst og huskes i nettleseren din.\n      </p>\n    </section>\n\n    <!-- Søk/filter -->\n    <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-4 sticky top-[72px] z-20\">\n      <div class=\"relative\">\n        <span class=\"absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none\">\n          <svg class=\"w-5 h-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z\" />\n          </svg>\n        </span>\n        <input id=\"search\" type=\"search\" autocomplete=\"off\"\n          class=\"w-full border border-gray-300 rounded-xl pl-11 pr-10 py-2.5 text-gray-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent\"\n          placeholder=\"Søk i tittel, beskrivelse eller emne — f.eks. «kirkebøker», «DNA», «utvandring»…\" />\n        <button id=\"clearSearch\" type=\"button\" aria-label=\"Tøm søk\"\n          class=\"hidden absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600\">\n          <svg class=\"w-5 h-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M6 18L18 6M6 6l12 12\" />\n          </svg>\n        </button>\n      </div>\n      <p id=\"resultCount\" class=\"text-xs text-gray-400 mt-2 px-1\"></p>\n    </section>\n\n    <!-- Innhold rendres her -->\n    <div id=\"content\" class=\"space-y-8\"></div>\n\n    <!-- Tomt resultat -->\n    <div id=\"emptyState\" class=\"hidden bg-white rounded-2xl border border-gray-200 p-10 text-center\">\n      <svg class=\"w-10 h-10 text-gray-300 mx-auto mb-3\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"1.5\">\n        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z\" />\n      </svg>\n      <p class=\"text-gray-500 text-sm\">Ingen ressurser passer søket ditt.</p>\n      <p class=\"text-gray-400 text-xs mt-1\">Prøv et annet ord, eller tøm søkefeltet.</p>\n    </div>\n\n  </main>\n\n  <footer class=\"max-w-5xl mx-auto px-4 py-6 text-center text-xs text-gray-400\">\n    Ressurser &amp; datasett &mdash; <a href=\"https://github.com/halisonworks/public-app-studio\" class=\"underline hover:text-indigo-500\" target=\"_blank\" rel=\"noopener\">Halison App Studio</a>\n  </footer>\n\n<script>\n// ─── Datasett: alle lenkene som objekter ────────────────────────────────────\n// pris: 'free' | 'paid' | 'mix'\nconst RESOURCES = [\n  // ARKIV & PRIMÆRKILDER\n  { id: 'digitalarkivet', section: 'Arkiv & primærkilder', title: 'Digitalarkivet',\n    url: 'https://www.digitalarkivet.no', pris: 'free',\n    desc: 'Arkivverkets digitale arkiv: folketellinger, kirkebøker, skifter, panteregister m.m.',\n    tags: ['arkiv', 'folketelling', 'kirkebøker', 'skifte', 'panteregister', 'primærkilde'] },\n  { id: 'arkivverket', section: 'Arkiv & primærkilder', title: 'Arkivverket',\n    url: 'https://www.arkivverket.no', pris: 'free',\n    desc: 'Riksarkivet og statsarkivene; arkivkataloger.',\n    tags: ['arkiv', 'riksarkivet', 'statsarkiv', 'katalog'] },\n  { id: 'nb-nettbibliotek', section: 'Arkiv & primærkilder', title: 'Nasjonalbiblioteket (Nettbiblioteket)',\n    url: 'https://www.nb.no', pris: 'free',\n    desc: 'Digitaliserte bøker, aviser, tidsskrift og bygdebøker.',\n    tags: ['bøker', 'aviser', 'tidsskrift', 'bygdebøker', 'digitalisert'] },\n  { id: 'nb-aviser', section: 'Arkiv & primærkilder', title: 'Nasjonalbiblioteket – Aviser',\n    url: 'https://www.nb.no/search?mediatype=aviser', pris: 'free',\n    desc: 'Historiske aviser, søkbare.',\n    tags: ['aviser', 'historisk', 'søkbar'] },\n  { id: 'kartverket', section: 'Arkiv & primærkilder', title: 'Kartverket',\n    url: 'https://www.kartverket.no', pris: 'free',\n    desc: 'Historiske kart, matrikkel og stedsnavn.',\n    tags: ['kart', 'matrikkel', 'stedsnavn', 'gård'] },\n\n  // FOLKETELLINGER & BEFOLKNINGSREGISTRE\n  { id: 'rhd', section: 'Folketellinger & befolkningsregistre', title: 'RHD – Registreringssentral for historiske data (UiT)',\n    url: 'https://www.rhd.uit.no', pris: 'free',\n    desc: 'Transkriberte folketellinger og kirkebøker.',\n    tags: ['folketelling', 'kirkebøker', 'transkribert', 'uit', 'tromsø'] },\n  { id: 'histreg', section: 'Folketellinger & befolkningsregistre', title: 'Histreg – Historisk befolkningsregister',\n    url: 'https://histreg.no', pris: 'free',\n    desc: 'Kobler personer på tvers av kilder 1800-tallet–1964.',\n    tags: ['befolkningsregister', 'personkobling', '1800-tallet', '1964'] },\n\n  // FORENINGER & HJELP\n  { id: 'slektogdata', section: 'Foreninger & hjelp', title: 'Slekt og Data (tidl. DIS-Norge)',\n    url: 'https://www.slektogdata.no', pris: 'mix',\n    desc: 'Landsforening: forum, kurs, DNA-gruppe, Gravminner.',\n    tags: ['forening', 'forum', 'kurs', 'dna', 'gravminner', 'dis-norge'] },\n  { id: 'nsf', section: 'Foreninger & hjelp', title: 'Norsk Slektshistorisk Forening (NSF)',\n    url: 'https://www.genealogi.no', pris: 'mix',\n    desc: 'Kilder, skannede bøker og tidsskriftet Genealogen.',\n    tags: ['forening', 'kilder', 'bøker', 'genealogen', 'tidsskrift'] },\n  { id: 'lokalhistoriewiki', section: 'Foreninger & hjelp', title: 'Lokalhistoriewiki',\n    url: 'https://lokalhistoriewiki.no', pris: 'free',\n    desc: 'Wiki fra Nasjonalbiblioteket om steder, gårder og personer.',\n    tags: ['wiki', 'lokalhistorie', 'gård', 'steder', 'personer'] },\n\n  // GRAVMINNER & KIRKEGÅRDER\n  { id: 'gravminner', section: 'Gravminner & kirkegårder', title: 'Gravminner (Slekt og Data)',\n    url: 'https://www.slektogdata.no/no/gravminner', pris: 'free',\n    desc: 'Base over gravminner i Norge.',\n    tags: ['gravminner', 'kirkegård', 'gravstein', 'database'] },\n  { id: 'digitaltmuseum', section: 'Gravminner & kirkegårder', title: 'DigitaltMuseum',\n    url: 'https://digitaltmuseum.no', pris: 'free',\n    desc: 'Foto og museumssamlinger.',\n    tags: ['foto', 'museum', 'samling', 'bilder'] },\n\n  // UTVANDRING\n  { id: 'norwayheritage', section: 'Utvandring', title: 'Norway Heritage',\n    url: 'https://www.norwayheritage.com', pris: 'free',\n    desc: 'Emigrantskip og utvandrerhistorie.',\n    tags: ['utvandring', 'emigrant', 'skip', 'amerika'] },\n  { id: 'nagc', section: 'Utvandring', title: 'Norwegian American Genealogical Center (NAGC)',\n    url: 'https://nagcnl.org', pris: 'mix',\n    desc: 'Norsk-amerikansk slektsforskning.',\n    tags: ['utvandring', 'norsk-amerikansk', 'amerika', 'genealogi'] },\n\n  // DNA-SLEKTSFORSKNING\n  { id: 'dnapainter', section: 'DNA-slektsforskning', title: 'DNA Painter',\n    url: 'https://dnapainter.com', pris: 'free',\n    desc: 'Verktøy for å tolke DNA-treff (delt cM m.m.).',\n    tags: ['dna', 'cm', 'treff', 'verktøy', 'kromosom'] },\n  { id: 'gedmatch', section: 'DNA-slektsforskning', title: 'GEDmatch',\n    url: 'https://www.gedmatch.com', pris: 'mix',\n    desc: 'Last opp rådata og sammenlign på tvers av selskaper.',\n    tags: ['dna', 'rådata', 'sammenligne', 'opplasting'] },\n  { id: 'slektogdata-dna', section: 'DNA-slektsforskning', title: 'Slekt og Data – DNA',\n    url: 'https://www.slektogdata.no/no/dna', pris: 'mix',\n    desc: 'Norsk DNA-hjelp og grupper.',\n    tags: ['dna', 'hjelp', 'gruppe', 'norsk'] },\n\n  // INTERNASJONALE BASER\n  { id: 'familysearch', section: 'Internasjonale baser', title: 'FamilySearch',\n    url: 'https://www.familysearch.org', pris: 'free',\n    desc: 'Stor gratis base (drevet av Jesu Kristi Kirke).',\n    tags: ['internasjonal', 'gratis', 'base', 'familysearch'] },\n  { id: 'myheritage', section: 'Internasjonale baser', title: 'MyHeritage',\n    url: 'https://www.myheritage.no', pris: 'paid',\n    desc: 'Slektstrær og poster.',\n    tags: ['internasjonal', 'slektstre', 'poster', 'dna'] },\n  { id: 'ancestry', section: 'Internasjonale baser', title: 'Ancestry',\n    url: 'https://www.ancestry.com', pris: 'paid',\n    desc: 'Stor kommersiell base.',\n    tags: ['internasjonal', 'kommersiell', 'base'] },\n  { id: 'geni', section: 'Internasjonale baser', title: 'Geni',\n    url: 'https://www.geni.com', pris: 'mix',\n    desc: 'Felles verdenstre.',\n    tags: ['internasjonal', 'verdenstre', 'samarbeid'] },\n];\n\n// Seksjonsrekkefølge (favoritter håndteres separat øverst)\nconst SECTION_ORDER = [\n  'Arkiv & primærkilder',\n  'Folketellinger & befolkningsregistre',\n  'Foreninger & hjelp',\n  'Gravminner & kirkegårder',\n  'Utvandring',\n  'DNA-slektsforskning',\n  'Internasjonale baser',\n];\n\nconst PRIS_LABEL = {\n  free: 'Gratis',\n  paid: 'Betalt',\n  mix:  'Gratis/medlem',\n};\nconst PRIS_CLASS = {\n  free: 'badge-free',\n  paid: 'badge-paid',\n  mix:  'badge-mix',\n};\n\n// ─── Favoritter (localStorage) ──────────────────────────────────────────────\nconst STORAGE_KEY = 'genealogi_ressurser_favoritter';\n\nfunction loadFavs() {\n  try {\n    const raw = localStorage.getItem(STORAGE_KEY);\n    if (!raw) return new Set();\n    const arr = JSON.parse(raw);\n    return new Set(Array.isArray(arr) ? arr : []);\n  } catch (e) {\n    return new Set();\n  }\n}\nfunction saveFavs(set) {\n  try {\n    localStorage.setItem(STORAGE_KEY, JSON.stringify([...set]));\n  } catch (e) { /* ignore */ }\n}\nlet favorites = loadFavs();\n\n// ─── Hjelpere ───────────────────────────────────────────────────────────────\nfunction escapeHtml(s) {\n  return String(s)\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .replace(/\"/g, '&quot;')\n    .replace(/'/g, '&#39;');\n}\n\n// Marker treff i tekst (etter at teksten er HTML-escaped)\nfunction highlight(escapedText, query) {\n  if (!query) return escapedText;\n  const q = query.trim();\n  if (!q) return escapedText;\n  // escape regex-spesialtegn\n  const safe = q.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n  try {\n    return escapedText.replace(new RegExp('(' + safe + ')', 'gi'), '<mark>$1</mark>');\n  } catch (e) {\n    return escapedText;\n  }\n}\n\nfunction matchesQuery(r, q) {\n  if (!q) return true;\n  const hay = (r.title + ' ' + r.desc + ' ' + r.tags.join(' ') + ' ' + r.section).toLowerCase();\n  // Alle ord må finnes (AND-søk)\n  return q.toLowerCase().split(/\\s+/).filter(Boolean).every(w => hay.includes(w));\n}\n\nfunction prettyUrl(url) {\n  return url.replace(/^https?:\\/\\//, '').replace(/\\/$/, '');\n}\n\n// ─── Render ─────────────────────────────────────────────────────────────────\nconst contentEl = document.getElementById('content');\nconst emptyEl = document.getElementById('emptyState');\nconst countEl = document.getElementById('resultCount');\n\nfunction cardHtml(r, q) {\n  const isFav = favorites.has(r.id);\n  const title = highlight(escapeHtml(r.title), q);\n  const desc = highlight(escapeHtml(r.desc), q);\n  const badgeLabel = PRIS_LABEL[r.pris] || '';\n  const badgeClass = PRIS_CLASS[r.pris] || 'badge-free';\n\n  return (\n    '<div class=\"card bg-white rounded-2xl border border-gray-200 p-5 flex flex-col gap-2 fade-in\">' +\n      '<div class=\"flex items-start gap-3\">' +\n        '<div class=\"flex-1 min-w-0\">' +\n          '<a href=\"' + escapeHtml(r.url) + '\" target=\"_blank\" rel=\"noopener\" ' +\n            'class=\"text-base font-semibold text-indigo-700 hover:text-indigo-900 hover:underline break-words\">' +\n            title +\n            '<svg class=\"inline-block w-3.5 h-3.5 ml-0.5 -mt-0.5 text-indigo-400\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\">' +\n              '<path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14\" />' +\n            '</svg>' +\n          '</a>' +\n          '<div class=\"text-xs text-gray-400 mt-0.5 break-words\">' + escapeHtml(prettyUrl(r.url)) + '</div>' +\n        '</div>' +\n        '<button type=\"button\" class=\"star-btn flex-shrink-0 ' + (isFav ? 'star-on' : 'star-off') + '\" ' +\n          'data-id=\"' + escapeHtml(r.id) + '\" aria-label=\"' + (isFav ? 'Fjern favoritt' : 'Lagre favoritt') + '\" ' +\n          'title=\"' + (isFav ? 'Fjern fra favoritter' : 'Lagre som favoritt') + '\">' +\n          '<svg class=\"w-6 h-6\" viewBox=\"0 0 24 24\" fill=\"' + (isFav ? 'currentColor' : 'none') + '\" stroke=\"currentColor\" stroke-width=\"1.8\">' +\n            '<path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M11.48 3.5l2.34 4.74 5.23.76-3.78 3.69.89 5.21-4.68-2.46-4.68 2.46.89-5.21-3.78-3.69 5.23-.76 2.34-4.74z\" />' +\n          '</svg>' +\n        '</button>' +\n      '</div>' +\n      '<p class=\"text-sm text-gray-600 leading-snug\">' + desc + '</p>' +\n      '<div class=\"mt-1\">' +\n        '<span class=\"inline-block text-xs font-semibold px-2.5 py-0.5 rounded-full ' + badgeClass + '\">' + badgeLabel + '</span>' +\n      '</div>' +\n    '</div>'\n  );\n}\n\nfunction sectionHtml(title, cards, opts) {\n  opts = opts || {};\n  const iconStar = opts.fav\n    ? '<svg class=\"w-4 h-4 inline-block -mt-0.5 mr-1 text-amber-400\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M11.48 3.5l2.34 4.74 5.23.76-3.78 3.69.89 5.21-4.68-2.46-4.68 2.46.89-5.21-3.78-3.69 5.23-.76 2.34-4.74z\"/></svg>'\n    : '';\n  return (\n    '<section>' +\n      '<h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3 px-1\">' +\n        iconStar + escapeHtml(title) +\n        ' <span class=\"text-gray-300 font-normal normal-case tracking-normal\">(' + cards.length + ')</span>' +\n      '</h2>' +\n      '<div class=\"grid grid-cols-1 md:grid-cols-2 gap-4\">' + cards.join('') + '</div>' +\n    '</section>'\n  );\n}\n\nfunction render() {\n  const q = document.getElementById('search').value.trim();\n  const filtered = RESOURCES.filter(r => matchesQuery(r, q));\n\n  // Telling\n  countEl.textContent = q\n    ? (filtered.length + ' av ' + RESOURCES.length + ' ressurser passer søket')\n    : (RESOURCES.length + ' ressurser i biblioteket');\n\n  if (filtered.length === 0) {\n    contentEl.innerHTML = '';\n    emptyEl.classList.remove('hidden');\n    return;\n  }\n  emptyEl.classList.add('hidden');\n\n  const html = [];\n\n  // Favoritter-seksjon øverst (kun de som også passer søket)\n  const favCards = filtered.filter(r => favorites.has(r.id));\n  if (favCards.length > 0) {\n    html.push(sectionHtml('Favoritter', favCards.map(r => cardHtml(r, q)), { fav: true }));\n  }\n\n  // Vanlige seksjoner\n  for (const section of SECTION_ORDER) {\n    const inSection = filtered.filter(r => r.section === section);\n    if (inSection.length === 0) continue;\n    html.push(sectionHtml(section, inSection.map(r => cardHtml(r, q))));\n  }\n\n  contentEl.innerHTML = html.join('');\n}\n\n// ─── Hendelser ──────────────────────────────────────────────────────────────\nconst searchEl = document.getElementById('search');\nconst clearBtn = document.getElementById('clearSearch');\n\nsearchEl.addEventListener('input', () => {\n  clearBtn.classList.toggle('hidden', !searchEl.value);\n  render();\n});\nclearBtn.addEventListener('click', () => {\n  searchEl.value = '';\n  clearBtn.classList.add('hidden');\n  render();\n  searchEl.focus();\n});\n\n// Stjerne-klikk (event delegation — favoritt kan vises flere steder)\ncontentEl.addEventListener('click', (e) => {\n  const btn = e.target.closest('.star-btn');\n  if (!btn) return;\n  const id = btn.getAttribute('data-id');\n  if (!id) return;\n  if (favorites.has(id)) favorites.delete(id);\n  else favorites.add(id);\n  saveFavs(favorites);\n  render();\n});\n\n// ─── Init ───────────────────────────────────────────────────────────────────\nrender();\n</script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Ressurser & datasett",
    "windowTitle": "Ressurser & datasett",
    "bundleId": "com.halisonworks.ressurserogdatasett",
    "iconPath": null
  },
  "categoryId": null,
  "source": "import",
  "createdAt": "2026-06-02T12:00:00.000Z",
  "updatedAt": "2026-06-02T12:00:00.000Z",
  "sharedAt": "2026-06-02T12:00:00.000Z"
}
