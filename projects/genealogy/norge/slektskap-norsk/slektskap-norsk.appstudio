{
  "schema": "app-studio/canvas@1",
  "id": "example-slektskap-norsk",
  "name": "slektskap-norsk.html",
  "code": "<!DOCTYPE html>\n<!--\n  Slektskap (norske termer) — Halison App Studio-eksempel\n\n  Finn det norske slektskapsordet for to slektninger (søskenbarn, tremenning, grandonkel …) ut fra hvor mange ledd hver er fra felles ane.\n\n  Fra Halison App Studio sitt offentlige bibliotek:\n  https://github.com/halisonworks/public-app-studio\n\n  Tillatt bruk: personlig, pedagogisk og annen ikke-kommersiell bruk. Behold denne\n  headeren og kildelenken intakt; du kan endre verktøyet, men ikke selg, kommersialiser\n  eller republiser det. Utgitt under Halison App Studio Examples License — se\n  LICENSE-filen i repoet over.\n-->\n<html lang=\"no\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Slektskap (norske termer)</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Inter', 'Segoe UI', sans-serif; }\n    input[type=number]::-webkit-inner-spin-button,\n    input[type=number]::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }\n    input[type=number] { -moz-appearance: textfield; }\n    .fade-in { animation: fadeIn 0.4s ease; }\n    @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }\n    .preset-btn { transition: all 0.15s ease; }\n  </style>\n</head>\n<body class=\"bg-gray-50 min-h-screen\">\n\n  <!-- Header -->\n  <header class=\"bg-white border-b border-gray-200 sticky top-0 z-30 shadow-sm\">\n    <div class=\"max-w-4xl mx-auto px-4 py-4 flex items-center justify-between\">\n      <div class=\"flex items-center gap-3\">\n        <div class=\"w-9 h-9 rounded-lg bg-indigo-600 flex items-center justify-center\">\n          <svg class=\"w-5 h-5 text-white\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m6-1.13a4 4 0 10-4 0m4 0a4 4 0 014 0m-8 0a4 4 0 00-4 0m4-9a3 3 0 100-6 3 3 0 000 6z\" />\n          </svg>\n        </div>\n        <div>\n          <h1 class=\"text-lg font-bold text-gray-900 leading-tight\">Slektskap (norske termer)</h1>\n          <p class=\"text-xs text-gray-500\">Finn det norske slektskapsordet fra felles ane</p>\n        </div>\n      </div>\n    </div>\n  </header>\n\n  <main class=\"max-w-4xl mx-auto px-4 py-8 space-y-6\">\n\n    <!-- Presets -->\n    <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n      <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4\">Forhåndsinnstillinger</h2>\n      <div id=\"presets\" class=\"flex flex-wrap gap-2\"></div>\n    </section>\n\n    <!-- Input Section -->\n    <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n      <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider mb-5\">Ledd fra felles ane</h2>\n      <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n\n        <!-- Person 1 -->\n        <div class=\"rounded-xl border-2 border-blue-200 p-5 space-y-4\">\n          <div class=\"flex items-center gap-2\">\n            <span class=\"w-7 h-7 rounded-full bg-blue-100 text-blue-700 flex items-center justify-center font-bold text-sm\">1</span>\n            <span class=\"font-semibold text-gray-800\">Person 1</span>\n          </div>\n          <div>\n            <label class=\"block text-xs font-medium text-gray-500 mb-1\">Antall ledd fra felles ane ned til Person 1</label>\n            <div class=\"flex items-center gap-2\">\n              <button data-step=\"g1\" data-dir=\"-1\" class=\"stepper w-9 h-9 rounded-lg border border-gray-300 bg-gray-50 text-gray-600 font-bold text-lg hover:bg-gray-100 active:scale-95 transition\">−</button>\n              <input id=\"g1\" type=\"number\" min=\"0\" max=\"12\" value=\"2\"\n                class=\"w-full text-center border border-gray-300 rounded-lg px-3 py-2 text-gray-800 text-lg font-bold focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-transparent\" />\n              <button data-step=\"g1\" data-dir=\"1\" class=\"stepper w-9 h-9 rounded-lg border border-gray-300 bg-gray-50 text-gray-600 font-bold text-lg hover:bg-gray-100 active:scale-95 transition\">+</button>\n            </div>\n            <p class=\"text-xs text-gray-400 mt-2 leading-relaxed\">0 = Person 1 ER den felles anen · 1 = barn · 2 = barnebarn · 3 = oldebarn …</p>\n          </div>\n          <div>\n            <label class=\"block text-xs font-medium text-gray-500 mb-1\">Kjønn (valgfritt)</label>\n            <select id=\"s1\" class=\"w-full text-sm border border-gray-300 rounded-lg px-2 py-2 bg-white text-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-400\">\n              <option value=\"u\">Ukjent</option>\n              <option value=\"m\">Mann</option>\n              <option value=\"k\">Kvinne</option>\n            </select>\n          </div>\n        </div>\n\n        <!-- Person 2 -->\n        <div class=\"rounded-xl border-2 border-indigo-200 p-5 space-y-4\">\n          <div class=\"flex items-center gap-2\">\n            <span class=\"w-7 h-7 rounded-full bg-indigo-100 text-indigo-700 flex items-center justify-center font-bold text-sm\">2</span>\n            <span class=\"font-semibold text-gray-800\">Person 2</span>\n          </div>\n          <div>\n            <label class=\"block text-xs font-medium text-gray-500 mb-1\">Antall ledd fra felles ane ned til Person 2</label>\n            <div class=\"flex items-center gap-2\">\n              <button data-step=\"g2\" data-dir=\"-1\" class=\"stepper w-9 h-9 rounded-lg border border-gray-300 bg-gray-50 text-gray-600 font-bold text-lg hover:bg-gray-100 active:scale-95 transition\">−</button>\n              <input id=\"g2\" type=\"number\" min=\"0\" max=\"12\" value=\"2\"\n                class=\"w-full text-center border border-gray-300 rounded-lg px-3 py-2 text-gray-800 text-lg font-bold focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent\" />\n              <button data-step=\"g2\" data-dir=\"1\" class=\"stepper w-9 h-9 rounded-lg border border-gray-300 bg-gray-50 text-gray-600 font-bold text-lg hover:bg-gray-100 active:scale-95 transition\">+</button>\n            </div>\n            <p class=\"text-xs text-gray-400 mt-2 leading-relaxed\">0 = Person 2 ER den felles anen · 1 = barn · 2 = barnebarn · 3 = oldebarn …</p>\n          </div>\n          <div>\n            <label class=\"block text-xs font-medium text-gray-500 mb-1\">Kjønn (valgfritt)</label>\n            <select id=\"s2\" class=\"w-full text-sm border border-gray-300 rounded-lg px-2 py-2 bg-white text-gray-700 focus:outline-none focus:ring-2 focus:ring-indigo-400\">\n              <option value=\"u\">Ukjent</option>\n              <option value=\"m\">Mann</option>\n              <option value=\"k\">Kvinne</option>\n            </select>\n          </div>\n        </div>\n\n      </div>\n    </section>\n\n    <!-- Results Section -->\n    <div id=\"resultsSection\" class=\"space-y-5 fade-in\">\n\n      <!-- Relationship Card -->\n      <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n        <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4\">Slektskap</h2>\n        <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n          <div class=\"rounded-xl bg-indigo-50 border border-indigo-100 px-5 py-4\">\n            <div class=\"text-xs text-indigo-600 font-medium mb-1\">Person 2 er Person 1 sin</div>\n            <div id=\"rel21\" class=\"text-2xl font-bold text-indigo-700\">—</div>\n          </div>\n          <div class=\"rounded-xl bg-blue-50 border border-blue-100 px-5 py-4\">\n            <div class=\"text-xs text-blue-600 font-medium mb-1\">Person 1 er Person 2 sin</div>\n            <div id=\"rel12\" class=\"text-2xl font-bold text-blue-700\">—</div>\n          </div>\n        </div>\n        <div class=\"mt-4 bg-gray-50 rounded-xl border border-gray-200 px-5 py-4\">\n          <div class=\"text-xs text-gray-500 font-medium mb-1\">Forklaring</div>\n          <p id=\"explain\" class=\"text-sm text-gray-700 leading-relaxed\">—</p>\n        </div>\n        <div class=\"mt-4 flex flex-wrap gap-4\">\n          <div class=\"bg-white rounded-xl border border-gray-200 px-4 py-3 shadow-sm\">\n            <div class=\"text-xs text-gray-500 font-medium\">Slektskapsgrad (sivil grad)</div>\n            <div id=\"grad\" class=\"text-xl font-bold text-gray-800\">—</div>\n          </div>\n        </div>\n      </section>\n\n      <!-- Descent diagram -->\n      <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n        <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4\">Nedstigningsdiagram</h2>\n        <div class=\"w-full overflow-x-auto\">\n          <svg id=\"diagram\" width=\"100%\" viewBox=\"0 0 560 360\" preserveAspectRatio=\"xMidYMid meet\" class=\"block\"></svg>\n        </div>\n      </section>\n\n      <!-- About menning system -->\n      <section class=\"bg-gray-50 rounded-xl border border-gray-200 px-5 py-4 text-xs text-gray-500 leading-relaxed\">\n        <strong class=\"text-gray-700\">Om menning-systemet:</strong> To personer er N-menninger når nærmeste\n        felles ane ligger N ledd bak for begge. <strong>Søsken</strong> deler foreldre (1 ledd hver).\n        <strong>Søskenbarn</strong> deler besteforeldre (2 ledd hver). <strong>Tremenning</strong> deler\n        oldeforeldre (3 ledd hver). <strong>Firmenning</strong> deler tippoldeforeldre (4 ledd hver), og slik\n        videre. Ligger anen ulikt mange ledd bak for de to, blir relasjonen «forskjøvet» et antall ledd\n        (f.eks. søskenbarn forskjøvet 1 ledd, eller onkel/tante ↔ nevø/niese).\n      </section>\n\n    </div>\n  </main>\n\n  <footer class=\"max-w-4xl mx-auto px-4 py-6 text-center text-xs text-gray-400\">\n    Slektskap (norske termer) &mdash; <a href=\"https://github.com/halisonworks/public-app-studio\" class=\"underline hover:text-indigo-500\" target=\"_blank\" rel=\"noopener\">Halison App Studio</a>\n  </footer>\n\n<script>\n// ─── Kjernelogikk (transkribert) ─────────────────────────────────────────────\n\nfunction ordenstall(n){const t=['','første','andre','tredje','fjerde','femte','sjette','sjuende','åttende','niende','tiende'];return t[n]||(n+'.');}\nfunction menning(n){ // likt antall ledd, n>=1\n  if(n===1) return 'søsken';\n  if(n===2) return 'søskenbarn';\n  const ord={3:'tre',4:'fir',5:'fem',6:'seks',7:'sju',8:'åtte',9:'ni',10:'ti'};\n  return (ord[n]||n)+'menning';\n}\nfunction oldePrefiks(lvl){ // lvl: 0->'', 1->'olde', 2->'tippolde', 3->'tipptippolde', n-> ('tipp' gjentatt (n-1)) + 'olde'\n  if(lvl<=0) return '';\n  if(lvl===1) return 'olde';\n  return 'tipp'.repeat(lvl-1)+'olde';\n}\n\n// ─── Kjønnshjelpere ──────────────────────────────────────────────────────────\n// g: 'm' (mann), 'k' (kvinne), 'u' (ukjent)\n\nfunction gendered(neutral, male, female, g){\n  if(g==='m') return male;\n  if(g==='k') return female;\n  return neutral;\n}\n\n// Direkte linje: anen er d generasjoner over etterkommeren.\n// Returnerer ordet for ANEN (sett fra etterkommeren), gitt anens kjønn gAne.\nfunction direkteAne(d, gAne){\n  if(d===1) return gendered('forelder','far','mor', gAne);\n  if(d===2) return gendered('besteforelder','bestefar','bestemor', gAne);\n  if(d===3) return gendered('oldeforelder','oldefar','oldemor', gAne);\n  // d>=4\n  const pre = oldePrefiks(d-2); // d=4 => 'tippolde', d=5 => 'tipptippolde'\n  return pre + gendered('forelder','far','mor', gAne);\n}\n// Returnerer ordet for ETTERKOMMEREN (sett fra anen), gitt etterkommerens kjønn gEtt.\nfunction direkteEtterkommer(d, gEtt){\n  if(d===1) return gendered('barn','sønn','datter', gEtt);\n  if(d===2) return 'barnebarn';\n  if(d===3) return 'oldebarn';\n  // d>=4\n  const pre = oldePrefiks(d-2); // d=4 => 'tippolde', d=5 => 'tipptippolde'\n  return pre + 'barn';\n}\n\n// Avunkulær: min=1, removed r (=|g1-g2|).\n// Personen på \"min=1\"-siden er sibling-of-ancestor; den andre er nedstigende.\n// Returnerer ordet for ONKEL/TANTE-rollen, gitt dens kjønn g.\nfunction avunkulaerEldre(r, g){\n  if(r===1) return gendered('onkel/tante','onkel','tante', g);\n  if(r===2) return gendered('grandonkel/grandtante','grandonkel','grandtante', g);\n  // r>=3 (uformelt)\n  return ('tipp'.repeat(r-2)+'olde') + gendered('onkel/tante','onkel','tante', g);\n}\n// Returnerer ordet for NEVØ/NIESE-rollen, gitt dens kjønn g.\nfunction avunkulaerYngre(r, g){\n  if(r===1) return gendered('nevø/niese','nevø','niese', g);\n  if(r===2) return gendered('grandnevø/grandniese','grandnevø','grandniese', g);\n  // r>=3\n  return ('tipp'.repeat(r-2)+'olde') + gendered('nevø/niese','nevø','niese', g);\n}\n\n// ─── Hovedfunksjon: beregn relasjon ──────────────────────────────────────────\n// Returnerer { rel21, rel12, explain, grad }\n//   rel21 = hva Person 2 er TIL Person 1\n//   rel12 = hva Person 1 er TIL Person 2\n\nfunction beregn(g1, g2, s1, s2){\n  const grad = g1 + g2;\n\n  // Begge er den felles anen\n  if(g1===0 && g2===0){\n    return {\n      rel21: 'samme person',\n      rel12: 'samme person',\n      explain: 'Begge står på den felles anen selv — det er samme person (0 ledd fra anen for begge).',\n      grad: 0\n    };\n  }\n\n  // Direkte linje: en av dem ER den felles anen.\n  if(g1===0 || g2===0){\n    const d = Math.max(g1, g2);\n    if(g1===0){\n      // Person 1 er anen, Person 2 er etterkommer d ledd ned.\n      const rel21 = direkteEtterkommer(d, s2); // P2 til P1: P2 er P1 sitt barn/barnebarn …\n      const rel12 = direkteAne(d, s1);         // P1 til P2: P1 er P2 sin forelder/besteforelder …\n      return {\n        rel21, rel12,\n        explain: `Person 1 er den felles anen, og Person 2 stammer rett ned ${d} ledd. Person 2 er da Person 1 sitt ${rel21}, og Person 1 er Person 2 sitt ${rel12}.`,\n        grad\n      };\n    } else {\n      // Person 2 er anen, Person 1 er etterkommer d ledd ned.\n      const rel12 = direkteEtterkommer(d, s1); // P1 til P2: P1 er P2 sitt barn …\n      const rel21 = direkteAne(d, s2);         // P2 til P1: P2 er P1 sin forelder …\n      return {\n        rel21, rel12,\n        explain: `Person 2 er den felles anen, og Person 1 stammer rett ned ${d} ledd. Person 1 er da Person 2 sitt ${rel12}, og Person 2 er Person 1 sitt ${rel21}.`,\n        grad\n      };\n    }\n  }\n\n  // Begge stammer ned fra felles ane (g1>=1 og g2>=1).\n  const mn = Math.min(g1, g2);\n  const r = Math.abs(g1 - g2);\n\n  // Likt antall ledd: ren menning-relasjon.\n  if(r===0){\n    let rel21, rel12;\n    if(mn===1){\n      // søsken\n      rel21 = gendered('søsken','bror','søster', s2);\n      rel12 = gendered('søsken','bror','søster', s1);\n    } else if(mn===2){\n      // søskenbarn → fetter/kusine\n      rel21 = gendered('søskenbarn','fetter','kusine', s2);\n      rel12 = gendered('søskenbarn','fetter','kusine', s1);\n    } else {\n      rel21 = menning(mn);\n      rel12 = menning(mn);\n    }\n    const aneOrd = fellesAneOrd(mn);\n    return {\n      rel21, rel12,\n      explain: `Begge stammer ${mn} ledd ned fra ${aneOrd}. De er ${menning(mn)} (${ordenstall(mn)} leddet fra felles ane for begge).`,\n      grad\n    };\n  }\n\n  // min===1: avunkulær (onkel/tante ↔ nevø/niese), eventuelt grand-/tipp-.\n  if(mn===1){\n    let rel21, rel12;\n    if(g1 < g2){\n      // Person 1 er nærmest anen (onkel/tante-rollen), Person 2 er nedstigende (nevø/niese).\n      rel21 = avunkulaerYngre(r, s2); // P2 til P1: P2 er P1 sin nevø/niese\n      rel12 = avunkulaerEldre(r, s1); // P1 til P2: P1 er P2 sin onkel/tante\n    } else {\n      // Person 2 er nærmest anen, Person 1 er nedstigende.\n      rel21 = avunkulaerEldre(r, s2); // P2 til P1: P2 er P1 sin onkel/tante\n      rel12 = avunkulaerYngre(r, s1); // P1 til P2: P1 er P2 sin nevø/niese\n    }\n    return {\n      rel21, rel12,\n      explain: `Den ene er ${avunkulaerEldre(r,'u')} til den andre, som er ${avunkulaerYngre(r,'u')}. De deler en felles ane som er forelder til den eldste grenen og lengre tilbake for den yngste (forskjøvet ${r} ledd).`,\n      grad\n    };\n  }\n\n  // min>=2 og r>0: søskenbarn ulikt ledd → menning forskjøvet r ledd.\n  const base = menning(mn);\n  const aneOrd = fellesAneOrd(mn);\n  const rel = `${base} forskjøvet ${r} ledd`;\n  return {\n    rel21: rel,\n    rel12: rel,\n    explain: `Den nærmeste av de to er ${base} til en av forfedrene til den andre. Med andre ord: de stammer fra felles ${aneOrd}, men ulikt mange ledd ned — ${mn} ledd for den ene og ${mn+r} ledd for den andre. Relasjonen er da «${rel}».`,\n    grad\n  };\n}\n\n// Navn på den felles anen sett som slektsgruppe (foreldre, besteforeldre …)\nfunction fellesAneOrd(mn){\n  if(mn===1) return 'foreldre';\n  if(mn===2) return 'besteforeldre';\n  if(mn===3) return 'oldeforeldre';\n  if(mn===4) return 'tippoldeforeldre';\n  const pre = oldePrefiks(mn-2); // mn=5 => tipptippolde\n  return pre + 'foreldre';\n}\n\n// ─── SVG nedstigningsdiagram ─────────────────────────────────────────────────\n\nfunction tegnDiagram(g1, g2){\n  const svg = document.getElementById('diagram');\n  svg.innerHTML = '';\n  const NS = 'http://www.w3.org/2000/svg';\n  function ns(tag, attrs){\n    const el = document.createElementNS(NS, tag);\n    for(const k in attrs) el.setAttribute(k, attrs[k]);\n    return el;\n  }\n  function txt(x, y, s, opts){\n    const t = document.createElementNS(NS, 'text');\n    t.setAttribute('x', x); t.setAttribute('y', y);\n    t.setAttribute('text-anchor', (opts&&opts.anchor)||'middle');\n    t.setAttribute('font-size', (opts&&opts.size)||'12');\n    t.setAttribute('fill', (opts&&opts.fill)||'#374151');\n    if(opts&&opts.weight) t.setAttribute('font-weight', opts.weight);\n    t.textContent = s;\n    svg.appendChild(t);\n    return t;\n  }\n\n  const W = 560;\n  const maxLed = Math.max(g1, g2, 1);\n  const topY = 40;\n  const rowH = Math.min(58, (300) / (maxLed + 1));\n  const xAne = W/2;\n  const x1 = W*0.27;\n  const x2 = W*0.73;\n  const r = 16;\n\n  // Felles ane node (øverst, midt)\n  svg.appendChild(ns('circle', { cx: xAne, cy: topY, r: r, fill: '#4f46e5' }));\n  txt(xAne, topY+4, '★', { fill:'#fff', size:'14', weight:'700' });\n  txt(xAne, topY-r-6, 'Felles ane', { fill:'#4f46e5', size:'12', weight:'700' });\n\n  // Stige for én person\n  function stige(g, x, color, lightColor, label, labelColor){\n    let prevX = xAne, prevY = topY;\n    if(g===0){\n      // Personen ER anen → marker rundt ane-noden\n      svg.appendChild(ns('circle', { cx: xAne, cy: topY, r: r+6, fill:'none', stroke: color, 'stroke-width': 2.5, 'stroke-dasharray':'4 3' }));\n      txt(x, topY+r+24, label + ' = felles ane', { fill: labelColor, size:'11', weight:'600' });\n      return;\n    }\n    for(let i=1;i<=g;i++){\n      const cy = topY + i*rowH;\n      const cx = x;\n      // linje fra forrige\n      svg.appendChild(ns('line', { x1: prevX, y1: prevY+ (i===1? r : r), x2: cx, y2: cy - r, stroke: lightColor, 'stroke-width': 2 }));\n      // node\n      const isLast = (i===g);\n      svg.appendChild(ns('circle', { cx: cx, cy: cy, r: isLast? r : r-3, fill: isLast? color : '#fff', stroke: color, 'stroke-width': 2 }));\n      txt(cx, cy+4, String(i), { fill: isLast? '#fff' : color, size: isLast?'12':'10', weight: isLast?'700':'400' });\n      prevX = cx; prevY = cy;\n    }\n    // etikett under siste node\n    txt(prevX, prevY + r + 16, label, { fill: labelColor, size:'12', weight:'700' });\n    txt(prevX, prevY + r + 31, g + (g===1?' ledd':' ledd'), { fill:'#9ca3af', size:'10' });\n  }\n\n  stige(g1, x1, '#2563eb', '#93c5fd', 'Person 1', '#2563eb');\n  stige(g2, x2, '#4f46e5', '#a5b4fc', 'Person 2', '#4f46e5');\n\n  // juster viewBox-høyde dynamisk\n  const needed = topY + maxLed*rowH + 50;\n  svg.setAttribute('viewBox', `0 0 ${W} ${Math.max(220, needed)}`);\n}\n\n// ─── DOM / oppdatering ───────────────────────────────────────────────────────\n\nconst $ = id => document.getElementById(id);\n\nfunction clamp(n){\n  if(isNaN(n)) n = 0;\n  return Math.max(0, Math.min(12, Math.round(n)));\n}\n\nfunction oppdater(){\n  const g1 = clamp(parseInt($('g1').value, 10));\n  const g2 = clamp(parseInt($('g2').value, 10));\n  $('g1').value = g1;\n  $('g2').value = g2;\n  const s1 = $('s1').value;\n  const s2 = $('s2').value;\n\n  const res = beregn(g1, g2, s1, s2);\n\n  $('rel21').textContent = res.rel21;\n  $('rel12').textContent = res.rel12;\n  $('explain').textContent = res.explain;\n  $('grad').textContent = res.grad + '. grad';\n\n  tegnDiagram(g1, g2);\n\n  try {\n    localStorage.setItem('slektskap', JSON.stringify({ g1, g2, s1, s2 }));\n  } catch(e) { /* ignore */ }\n}\n\n// ─── Forhåndsinnstillinger ───────────────────────────────────────────────────\n\nconst PRESETS = [\n  { navn: 'Søsken', g1:1, g2:1 },\n  { navn: 'Søskenbarn', g1:2, g2:2 },\n  { navn: 'Tremenning', g1:3, g2:3 },\n  { navn: 'Firmenning', g1:4, g2:4 },\n  { navn: 'Forelder & barn', g1:0, g2:1 },\n  { navn: 'Besteforelder & barnebarn', g1:0, g2:2 },\n  { navn: 'Onkel/tante & nevø/niese', g1:1, g2:2 },\n  { navn: 'Grandonkel', g1:1, g2:3 },\n];\n\n(function buildPresets(){\n  const wrap = $('presets');\n  PRESETS.forEach(p => {\n    const b = document.createElement('button');\n    b.className = 'preset-btn px-3 py-1.5 rounded-lg border border-gray-300 bg-white text-sm text-gray-700 hover:border-indigo-400 hover:bg-indigo-50 hover:text-indigo-700 active:scale-95';\n    b.textContent = p.navn;\n    b.addEventListener('click', () => {\n      $('g1').value = p.g1;\n      $('g2').value = p.g2;\n      oppdater();\n    });\n    wrap.appendChild(b);\n  });\n})();\n\n// ─── Steppere (+ / −) ────────────────────────────────────────────────────────\n\ndocument.querySelectorAll('.stepper').forEach(btn => {\n  btn.addEventListener('click', () => {\n    const id = btn.getAttribute('data-step');\n    const dir = parseInt(btn.getAttribute('data-dir'), 10);\n    $(id).value = clamp(parseInt($(id).value, 10) + dir);\n    oppdater();\n  });\n});\n\n// ─── Event listeners ─────────────────────────────────────────────────────────\n\n['g1','g2','s1','s2'].forEach(id => {\n  $(id).addEventListener('input', oppdater);\n  $(id).addEventListener('change', oppdater);\n});\n\n// ─── Last fra localStorage ───────────────────────────────────────────────────\n\n(function restoreOrInit(){\n  try {\n    const saved = JSON.parse(localStorage.getItem('slektskap'));\n    if(saved){\n      $('g1').value = saved.g1;\n      $('g2').value = saved.g2;\n      $('s1').value = saved.s1 || 'u';\n      $('s2').value = saved.s2 || 'u';\n    }\n  } catch(e) { /* ignore */ }\n  oppdater();\n})();\n\n// ─── Selvtest (logges kun til konsoll, valideringsstøtte) ────────────────────\n\n(function selvtest(){\n  const cases = [\n    [1,1,'søsken'], [2,2,'søskenbarn'], [3,3,'tremenning'],\n    [4,4,'firmenning'], [5,5,'femmenning'],\n  ];\n  cases.forEach(([a,b,exp]) => {\n    const r = beregn(a,b,'u','u');\n    if(r.rel21 !== exp) console.warn('Selvtest avvik', a, b, 'fikk', r.rel21, 'forventet', exp);\n  });\n})();\n</script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Slektskap (norske termer)",
    "windowTitle": "Slektskap (norske termer)",
    "bundleId": "com.halisonworks.slektskapnorsk",
    "iconPath": null
  },
