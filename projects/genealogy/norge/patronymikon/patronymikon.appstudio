{
  "schema": "app-studio/canvas@1",
  "id": "example-patronymikon",
  "name": "patronymikon.html",
  "code": "<!DOCTYPE html>\n<!--\n  Patronymikon — Halison App Studio-eksempel\n\n  Bygg og tolk norske patronymer (Ole → Olsen/Olsdatter og omvendt), med notater om gårdsnavn og navneloven av 1923.\n\n  Fra Halison App Studio sitt offentlige bibliotek:\n  https://github.com/halisonworks/public-app-studio\n\n  Tillatt bruk: personlig, pedagogisk og annen ikke-kommersiell bruk. Behold denne\n  headeren og kildelenken intakt; du kan endre verktøyet, men ikke selg, kommersialiser\n  eller republiser det. Utgitt under Halison App Studio Examples License — se\n  LICENSE-filen i repoet over.\n-->\n<html lang=\"no\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Patronymikon</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Inter', 'Segoe UI', sans-serif; }\n    .fade-in { animation: fadeIn 0.4s ease; }\n    @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }\n    .pill { display: inline-flex; align-items: center; gap: 0.35rem; }\n    .gender-btn { transition: all 0.15s ease; }\n    .gender-son.active { background: #eef2ff; border-color: #6366f1; color: #4338ca; }\n    .gender-dtr.active { background: #fdf2f8; border-color: #ec4899; color: #be185d; }\n  </style>\n</head>\n<body class=\"bg-gray-50 min-h-screen\">\n\n  <!-- Header -->\n  <header class=\"bg-white border-b border-gray-200 sticky top-0 z-30 shadow-sm\">\n    <div class=\"max-w-4xl mx-auto px-4 py-4 flex items-center justify-between\">\n      <div class=\"flex items-center gap-3\">\n        <div class=\"w-9 h-9 rounded-lg bg-indigo-600 flex items-center justify-center\">\n          <svg class=\"w-5 h-5 text-white\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z\" />\n          </svg>\n        </div>\n        <div>\n          <h1 class=\"text-lg font-bold text-gray-900 leading-tight\">Patronymikon</h1>\n          <p class=\"text-xs text-gray-500\">Bygg og tolk norske patronymer</p>\n        </div>\n      </div>\n      <a href=\"https://github.com/halisonworks/public-app-studio\" target=\"_blank\" rel=\"noopener\"\n         class=\"hidden sm:inline-flex text-xs text-gray-400 hover:text-indigo-500 underline\">App Studio</a>\n    </div>\n  </header>\n\n  <main class=\"max-w-4xl mx-auto px-4 py-8 space-y-6\">\n\n    <!-- Om norske patronymer -->\n    <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n      <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4\">Om norske patronymer</h2>\n      <div class=\"text-sm text-gray-600 leading-relaxed space-y-3\">\n        <p>\n          Et <strong class=\"text-gray-800\">patronym</strong> er et navn dannet av farens fornavn pluss en endelse:\n          <span class=\"text-indigo-700 font-semibold\">«-sen/-son»</span> (sønn) eller\n          <span class=\"text-pink-700 font-semibold\">«-datter/-dotter»</span> (datter).\n          Slik ble <em>Ole</em> sin sønn til <em>Olsen</em> og hans datter til <em>Olsdatter</em>.\n        </p>\n        <p>\n          Skikken var nærmest enerådende i Norge før ca. <strong class=\"text-gray-800\">1900</strong>. Hver ny generasjon fikk\n          et nytt patronym, så «etternavnet» skiftet fra far til barn og var ikke arvelig på den måten vi kjenner i dag.\n        </p>\n        <p>\n          I tillegg brukte folk ofte <strong class=\"text-gray-800\">gårdsnavn</strong> som et slags etternavn — men dette\n          fulgte bostedet og kunne endre seg når familien flyttet til en annen gård. En person kunne altså bytte\n          «etternavn» ved å flytte.\n        </p>\n        <p>\n          <strong class=\"text-gray-800\">Navneloven av 1923</strong> gjorde etternavn arvelige og faste. Mange frøs da fast\n          datidens patronym eller gårdsnavn som det slektsnavnet vi kjenner i dag.\n        </p>\n        <p class=\"text-xs text-gray-500 bg-gray-50 rounded-lg px-4 py-3 border border-gray-100\">\n          Merk: formene <span class=\"font-semibold\">-son</span> og <span class=\"font-semibold\">-dotter</span> er eldre og\n          dialektale — særlig vanlige på Vestlandet — mens <span class=\"font-semibold\">-sen</span> og\n          <span class=\"font-semibold\">-datter</span> er de mer utbredte/moderne formene i bokmålsområdet.\n        </p>\n      </div>\n    </section>\n\n    <!-- 1) BYGG -->\n    <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n      <div class=\"flex items-center gap-2 mb-5\">\n        <span class=\"w-7 h-7 rounded-full bg-indigo-100 text-indigo-700 flex items-center justify-center font-bold text-sm\">1</span>\n        <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider\">Bygg patronym</h2>\n      </div>\n\n      <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n        <div class=\"space-y-4\">\n          <div>\n            <label class=\"block text-xs font-medium text-gray-500 mb-1\">Farens fornavn</label>\n            <input id=\"byggNavn\" type=\"text\" value=\"Ole\" autocomplete=\"off\"\n              class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent\"\n              placeholder=\"f.eks. Ole\" />\n          </div>\n          <div>\n            <label class=\"block text-xs font-medium text-gray-500 mb-1\">Barnets kjønn</label>\n            <div class=\"grid grid-cols-2 gap-3\">\n              <button id=\"byggSon\" type=\"button\"\n                class=\"gender-btn gender-son active border-2 rounded-lg px-3 py-2.5 text-sm font-semibold text-gray-600 border-gray-200 flex items-center justify-center gap-2\">\n                <svg class=\"w-4 h-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"8\" r=\"4\"/><path stroke-linecap=\"round\" d=\"M12 12v9M8 16h8\"/></svg>\n                Sønn\n              </button>\n              <button id=\"byggDtr\" type=\"button\"\n                class=\"gender-btn gender-dtr border-2 rounded-lg px-3 py-2.5 text-sm font-semibold text-gray-600 border-gray-200 flex items-center justify-center gap-2\">\n                <svg class=\"w-4 h-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"8\" r=\"4\"/><path stroke-linecap=\"round\" d=\"M12 12v9M9 18h6\"/></svg>\n                Datter\n              </button>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"space-y-3\">\n          <div class=\"bg-indigo-50 rounded-xl px-5 py-4 border border-indigo-100\">\n            <div class=\"text-xs text-indigo-600 font-medium mb-1\">Moderne form (-sen / -datter)</div>\n            <div id=\"byggModerne\" class=\"text-2xl font-bold text-indigo-800\">—</div>\n          </div>\n          <div class=\"bg-gray-50 rounded-xl px-5 py-4 border border-gray-200\">\n            <div class=\"text-xs text-gray-500 font-medium mb-1\">Eldre / dialektal form (-son / -dotter)</div>\n            <div id=\"byggEldre\" class=\"text-2xl font-bold text-gray-700\">—</div>\n          </div>\n          <p id=\"byggNote\" class=\"text-xs text-gray-400\"></p>\n        </div>\n      </div>\n    </section>\n\n    <!-- 2) TOLK -->\n    <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n      <div class=\"flex items-center gap-2 mb-5\">\n        <span class=\"w-7 h-7 rounded-full bg-indigo-100 text-indigo-700 flex items-center justify-center font-bold text-sm\">2</span>\n        <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider\">Tolk patronym</h2>\n      </div>\n\n      <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n        <div>\n          <label class=\"block text-xs font-medium text-gray-500 mb-1\">Patronym</label>\n          <input id=\"tolkInput\" type=\"text\" value=\"Olsdatter\" autocomplete=\"off\"\n            class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent\"\n            placeholder=\"f.eks. Olsdatter, Pedersen, Larsson\" />\n          <p class=\"text-xs text-gray-400 mt-2\">Skriv inn et patronym så tolker verktøyet kjønn og sannsynlig farsnavn.</p>\n        </div>\n\n        <div id=\"tolkResult\" class=\"space-y-3\">\n          <div class=\"bg-gray-50 rounded-xl px-5 py-4 border border-gray-200\">\n            <div class=\"text-xs text-gray-500 font-medium mb-1\">Kjønn</div>\n            <div id=\"tolkKjonn\" class=\"text-lg font-bold text-gray-800\">—</div>\n          </div>\n          <div class=\"bg-gray-50 rounded-xl px-5 py-4 border border-gray-200\">\n            <div class=\"text-xs text-gray-500 font-medium mb-1\">Sannsynlig farsnavn</div>\n            <div id=\"tolkFar\" class=\"text-lg font-bold text-gray-800\">—</div>\n            <div id=\"tolkAlt\" class=\"text-xs text-gray-500 mt-1\"></div>\n          </div>\n          <p id=\"tolkNote\" class=\"text-xs text-gray-400\"></p>\n        </div>\n      </div>\n    </section>\n\n    <!-- 3) GÅRDSNAVN & NAVNELOV -->\n    <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n      <div class=\"flex items-center gap-2 mb-5\">\n        <span class=\"w-7 h-7 rounded-full bg-indigo-100 text-indigo-700 flex items-center justify-center font-bold text-sm\">3</span>\n        <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider\">Gårdsnavn &amp; navneloven</h2>\n      </div>\n\n      <div class=\"text-sm text-gray-600 leading-relaxed space-y-3\">\n        <p>\n          Ved siden av patronymet brukte folk gjerne et <strong class=\"text-gray-800\">gårdsnavn</strong> for å si hvor de\n          bodde. I kirkebøker og folketellinger ser du ofte en tredelt struktur:\n          <span class=\"font-semibold text-indigo-700\">fornavn + patronym + gårdsnavn</span>.\n        </p>\n        <p>\n          Fordi gårdsnavnet fulgte <strong class=\"text-gray-800\">bostedet</strong>, kunne det skifte gjennom livet. Flyttet\n          en husmann fra <em>Haugen</em> til <em>Berget</em>, ble han gjerne kalt etter den nye gården. Dette gjør\n          slektsgransking utfordrende: «etternavnet» er ikke alltid stabilt før 1900-tallet.\n        </p>\n        <p>\n          <strong class=\"text-gray-800\">Navneloven av 1923</strong> innførte arvelige, faste etternavn for alle. Da ble enten\n          patronymet eller gårdsnavnet låst som familienavn — derfor heter mange i dag både <em>Olsen</em> (frosset patronym)\n          og <em>Haugen</em> (frosset gårdsnavn).\n        </p>\n\n        <div class=\"bg-gray-50 rounded-xl border border-gray-200 p-4 space-y-3 mt-2\">\n          <div class=\"text-xs font-semibold text-gray-500 uppercase tracking-wider\">Eksempler</div>\n          <div class=\"flex gap-3\">\n            <span class=\"text-indigo-500 font-bold flex-shrink-0\">›</span>\n            <p><strong class=\"text-gray-800\">Ole Pedersen Haugen</strong> = Ole, sønn av Peder, bosatt på gården Haugen.</p>\n          </div>\n          <div class=\"flex gap-3\">\n            <span class=\"text-indigo-500 font-bold flex-shrink-0\">›</span>\n            <p><strong class=\"text-gray-800\">Marit Larsdatter Berge</strong> = Marit, datter av Lars, bosatt på gården Berge.</p>\n          </div>\n          <div class=\"flex gap-3\">\n            <span class=\"text-indigo-500 font-bold flex-shrink-0\">›</span>\n            <p><strong class=\"text-gray-800\">Nils Knutsen Li</strong> som flytter til Haugen, kan senere stå oppført som\n              <strong class=\"text-gray-800\">Nils Knutsen Haugen</strong> — samme person, nytt gårdsnavn.</p>\n          </div>\n        </div>\n      </div>\n    </section>\n\n  </main>\n\n  <footer class=\"max-w-4xl mx-auto px-4 py-6 text-center text-xs text-gray-400\">\n    Patronymikon &mdash; <a href=\"https://github.com/halisonworks/public-app-studio\" class=\"underline hover:text-indigo-500\" target=\"_blank\" rel=\"noopener\">Halison App Studio</a>\n  </footer>\n\n<script>\n// ─── Oppslagstabell: fornavn → patronymisk stamme ───────────────────────────\nconst TABELL = {\n 'Ole':'Ols','Ola':'Ols','Lars':'Lars','Nils':'Nils','Anders':'Anders','Hans':'Hans',\n 'Knut':'Knut','Peder':'Peders','Per':'Pers','Jon':'Jons','Johan':'Johans','Johannes':'Johannes',\n 'Erik':'Eriks','Halvor':'Halvors','Gunnar':'Gunnars','Svein':'Svens','Sven':'Svens','Tor':'Tors',\n 'Bjørn':'Bjørns','Rasmus':'Rasmus','Kristen':'Kristens','Kristoffer':'Kristoffers','Sjur':'Sjurs',\n 'Ivar':'Ivars','Arne':'Arnes','Engebret':'Engebret','Gulbrand':'Gulbrands','Torstein':'Torsteins',\n 'Mikkel':'Mikkels','Gjert':'Gjerts','Eilert':'Eilerts','Elling':'Ellings','Syver':'Syvers',\n 'Even':'Evens','Amund':'Amunds','Åge':'Åges','Audun':'Auduns','Håkon':'Håkons','Trond':'Tronds',\n 'Jakob':'Jakobs','Mathias':'Mathias','Kristian':'Kristians','Markus':'Markus','Nikolai':'Nikolais'\n};\n\n// ─── Hjelpere ───────────────────────────────────────────────────────────────\n\n// Stor forbokstav, resten små (for pen visning)\nfunction tittelCase(s) {\n  s = s.trim();\n  if (!s) return '';\n  return s.charAt(0).toUpperCase() + s.slice(1).toLowerCase();\n}\n\n// Finn patronymisk stamme fra et fornavn\nfunction finnStamme(navn) {\n  // Eksakt treff i tabell (case-insensitivt)\n  for (const key in TABELL) {\n    if (key.toLowerCase() === navn.toLowerCase()) return TABELL[key];\n  }\n  // Fallback: slutter navnet på 's' -> ikke legg til ny s; ellers legg til 's'\n  const lower = navn.toLowerCase();\n  if (lower.endsWith('s')) return navn;\n  return navn + 's';\n}\n\n// Sikre at stammen har genitiv-s (noen tabell-stammer er lagret uten, f.eks. 'Knut')\nfunction genitiv(stamme) {\n  return stamme.toLowerCase().endsWith('s') ? stamme : stamme + 's';\n}\n\n// Bygg patronym fra stamme + kjønn + form\nfunction byggPatronym(stamme, erSon, moderne) {\n  const g = genitiv(stamme);                       // Ols, Lars, Knuts ...\n  if (erSon) {\n    if (moderne) return g + 'en';                  // Ols+en = Olsen, Knuts+en = Knutsen\n    return g + 'son';                              // eldre: Ols+son = Olsson, Lars+son = Larsson\n  } else {\n    if (moderne) return g + 'datter';              // Ols+datter = Olsdatter\n    return g + 'dotter';                           // eldre: Ols+dotter = Olsdotter\n  }\n}\n\n// ─── 1) BYGG ────────────────────────────────────────────────────────────────\n\nlet byggErSon = true;\n\nfunction oppdaterBygg() {\n  const raw = document.getElementById('byggNavn').value.trim();\n  const moderneEl = document.getElementById('byggModerne');\n  const eldreEl = document.getElementById('byggEldre');\n  const noteEl = document.getElementById('byggNote');\n\n  if (!raw) {\n    moderneEl.textContent = '—';\n    eldreEl.textContent = '—';\n    noteEl.textContent = 'Skriv inn farens fornavn for å bygge patronymet.';\n    lagre();\n    return;\n  }\n\n  const navn = tittelCase(raw);\n  const stamme = finnStamme(navn);\n\n  const moderne = byggPatronym(stamme, byggErSon, true);\n  const eldre = byggPatronym(stamme, byggErSon, false);\n\n  moderneEl.textContent = moderne;\n  eldreEl.textContent = eldre;\n\n  const kjonnOrd = byggErSon ? 'sønn' : 'datter';\n  // Var navnet kjent i tabellen?\n  let kjent = false;\n  for (const key in TABELL) { if (key.toLowerCase() === navn.toLowerCase()) { kjent = true; break; } }\n  noteEl.textContent = (kjent ? 'Stamme «' + stamme + '» fra oppslagstabellen. ' : 'Stamme «' + stamme + '» dannet med fallback-regelen. ')\n    + navn + ' sin ' + kjonnOrd + ' fikk dette patronymet.';\n\n  lagre();\n}\n\ndocument.getElementById('byggNavn').addEventListener('input', oppdaterBygg);\n\ndocument.getElementById('byggSon').addEventListener('click', function() {\n  byggErSon = true;\n  this.classList.add('active');\n  document.getElementById('byggDtr').classList.remove('active');\n  oppdaterBygg();\n});\ndocument.getElementById('byggDtr').addEventListener('click', function() {\n  byggErSon = false;\n  this.classList.add('active');\n  document.getElementById('byggSon').classList.remove('active');\n  oppdaterBygg();\n});\n\n// ─── 2) TOLK ────────────────────────────────────────────────────────────────\n\n// Endelser i prioritert rekkefølge (lengst først for å unngå feilmatch)\nconst ENDELSER = [\n  { suf: 'datter', kjonn: 'kvinne', ordform: '-datter (datter, moderne)' },\n  { suf: 'dotter', kjonn: 'kvinne', ordform: '-dotter (datter, eldre/dialektal)' },\n  { suf: 'sson',   kjonn: 'mann',   ordform: '-son (sønn, eldre/dialektal)' },\n  { suf: 'son',    kjonn: 'mann',   ordform: '-son (sønn, eldre/dialektal)' },\n  { suf: 'sen',    kjonn: 'mann',   ordform: '-sen (sønn, moderne)' },\n];\n\n// Gitt en stamme (uten endelse), finn mulige fornavn fra tabellen\nfunction fornavnFraStamme(stamme) {\n  const treff = [];\n  const sLow = stamme.toLowerCase();\n  for (const key in TABELL) {\n    if (TABELL[key].toLowerCase() === sLow) treff.push(key);\n  }\n  // Fjern duplikater og sorter\n  return Array.from(new Set(treff)).sort();\n}\n\n// Reverser fallback: stamme -> antatt fornavn (strip genitiv-s hvis lagt til)\nfunction antattFornavn(stamme) {\n  // Hvis stammen slutter på 's' og uten 's' gir et plausibelt navn, vis begge muligheter\n  if (stamme.toLowerCase().endsWith('s')) {\n    return stamme.slice(0, -1); // Peders -> Peder, Ols -> Ol (ufullstendig, men tabellen dekker vanlige)\n  }\n  return stamme;\n}\n\nfunction oppdaterTolk() {\n  const raw = document.getElementById('tolkInput').value.trim();\n  const kjonnEl = document.getElementById('tolkKjonn');\n  const farEl = document.getElementById('tolkFar');\n  const altEl = document.getElementById('tolkAlt');\n  const noteEl = document.getElementById('tolkNote');\n\n  altEl.textContent = '';\n  if (!raw) {\n    kjonnEl.textContent = '—';\n    farEl.textContent = '—';\n    noteEl.textContent = 'Skriv inn et patronym for å tolke det.';\n    lagre();\n    return;\n  }\n\n  const navn = tittelCase(raw);\n  const lower = navn.toLowerCase();\n\n  let funnet = null;\n  for (const e of ENDELSER) {\n    if (lower.endsWith(e.suf) && lower.length > e.suf.length) {\n      funnet = { ...e, stamme: navn.slice(0, navn.length - e.suf.length) };\n      break;\n    }\n  }\n\n  if (!funnet) {\n    kjonnEl.textContent = 'Ukjent';\n    farEl.textContent = '—';\n    noteEl.textContent = '«' + navn + '» ser ikke ut som et patronym (mangler -sen/-son/-datter/-dotter). '\n      + 'Kan det være et gårdsnavn eller et moderne slektsnavn?';\n    lagre();\n    return;\n  }\n\n  // Kjønn\n  kjonnEl.textContent = funnet.kjonn === 'kvinne' ? 'Kvinne (datter)' : 'Mann (sønn)';\n  kjonnEl.className = 'text-lg font-bold ' + (funnet.kjonn === 'kvinne' ? 'text-pink-700' : 'text-indigo-700');\n\n  // Farsnavn: prøv tabell-oppslag på stammen først\n  const stamme = funnet.stamme;\n  const fraTabell = fornavnFraStamme(stamme);\n\n  if (fraTabell.length > 0) {\n    farEl.textContent = fraTabell[0];\n    if (fraTabell.length > 1) {\n      altEl.textContent = 'Andre muligheter med samme stamme: ' + fraTabell.slice(1).join(', ') + '.';\n    }\n  } else {\n    const antatt = antattFornavn(stamme);\n    farEl.textContent = antatt || stamme;\n  }\n\n  noteEl.textContent = 'Tolket endelse: ' + funnet.ordform + '. Stamme «' + stamme + '». '\n    + 'Merk at samme stamme kan svare til flere fornavn (Ols → Ole eller Ola), så farsnavnet er ikke alltid entydig.';\n\n  lagre();\n}\n\ndocument.getElementById('tolkInput').addEventListener('input', oppdaterTolk);\n\n// ─── localStorage (try/catch) ───────────────────────────────────────────────\n\nfunction lagre() {\n  try {\n    localStorage.setItem('patronymikon', JSON.stringify({\n      byggNavn: document.getElementById('byggNavn').value,\n      byggErSon: byggErSon,\n      tolkInput: document.getElementById('tolkInput').value\n    }));\n  } catch (e) { /* ignorer */ }\n}\n\n(function gjenopprett() {\n  try {\n    const lagret = JSON.parse(localStorage.getItem('patronymikon'));\n    if (lagret) {\n      if (typeof lagret.byggNavn === 'string') document.getElementById('byggNavn').value = lagret.byggNavn;\n      if (typeof lagret.tolkInput === 'string') document.getElementById('tolkInput').value = lagret.tolkInput;\n      if (typeof lagret.byggErSon === 'boolean') {\n        byggErSon = lagret.byggErSon;\n        if (byggErSon) {\n          document.getElementById('byggSon').classList.add('active');\n          document.getElementById('byggDtr').classList.remove('active');\n        } else {\n          document.getElementById('byggDtr').classList.add('active');\n          document.getElementById('byggSon').classList.remove('active');\n        }\n      }\n    }\n  } catch (e) { /* ignorer */ }\n  oppdaterBygg();\n  oppdaterTolk();\n})();\n</script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Patronymikon",
    "windowTitle": "Patronymikon",
    "bundleId": "com.halisonworks.patronymikon",
    "iconPath": null
  },
  "categoryId": null,
  "source": "import",
  "createdAt": "2026-06-02T12:00:00.000Z",
  "updatedAt": "2026-06-02T12:00:00.000Z",
  "sharedAt": "2026-06-02T12:00:00.000Z"
}
