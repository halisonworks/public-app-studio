{
  "schema": "app-studio/canvas@1",
  "id": "example-gamle-maal-og-mynt",
  "name": "gamle-maal-og-mynt.html",
  "code": "<!DOCTYPE html>\n<!--\n  Gamle mål & mynt — Halison App Studio-eksempel\n\n  Konverter gamle norske mål og myntenheter — alen, fot, favn, tønne, skålpund, speciedaler, ort og skilling — til metriske enheter og 1875-kroner.\n\n  Fra Halison App Studio sitt offentlige bibliotek:\n  https://github.com/halisonworks/public-app-studio\n\n  Tillatt bruk: personlig, pedagogisk og annen ikke-kommersiell bruk. Behold denne\n  headeren og kildelenken intakt; du kan endre verktøyet, men ikke selg, kommersialiser\n  eller republiser det. Utgitt under Halison App Studio Examples License — se\n  LICENSE-filen i repoet over.\n-->\n<html lang=\"no\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Gamle mål &amp; mynt</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Inter', 'Segoe UI', sans-serif; }\n    input[type=number]::-webkit-inner-spin-button,\n    input[type=number]::-webkit-outer-spin-button { opacity: 1; }\n    .fade-in { animation: fadeIn 0.35s ease; }\n    @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }\n    .seg-btn { transition: all 0.15s ease; }\n    .seg-btn.active { background: #4f46e5; color: #fff; box-shadow: 0 1px 3px rgba(79,70,229,0.35); }\n    .row-hl { background: #eef2ff; }\n    .tabular { font-variant-numeric: tabular-nums; }\n  </style>\n</head>\n<body class=\"bg-gray-50 min-h-screen\">\n\n  <!-- Header -->\n  <header class=\"bg-white border-b border-gray-200 sticky top-0 z-30 shadow-sm\">\n    <div class=\"max-w-4xl mx-auto px-4 py-4 flex items-center justify-between gap-3\">\n      <div class=\"flex items-center gap-3\">\n        <div class=\"w-9 h-9 rounded-lg bg-indigo-600 flex items-center justify-center flex-shrink-0\">\n          <!-- linjal / vekt-ikon -->\n          <svg class=\"w-5 h-5 text-white\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M3 7l4-4 14 14-4 4L3 7z\" />\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M7 7l1.5 1.5M10 10l1.5 1.5M13 13l1.5 1.5\" />\n          </svg>\n        </div>\n        <div>\n          <h1 class=\"text-lg font-bold text-gray-900 leading-tight\">Gamle mål &amp; mynt</h1>\n          <p class=\"text-xs text-gray-500\">Gamle norske enheter til metrisk &amp; 1875-kroner</p>\n        </div>\n      </div>\n    </div>\n  </header>\n\n  <main class=\"max-w-4xl mx-auto px-4 py-8 space-y-6\">\n\n    <!-- Kategori-velger -->\n    <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-4 sm:p-5\">\n      <div id=\"catTabs\" class=\"grid grid-cols-3 sm:grid-cols-5 gap-2\">\n        <button data-cat=\"lengde\" class=\"seg-btn active text-sm font-semibold rounded-lg px-3 py-2 bg-gray-100 text-gray-700\">Lengde</button>\n        <button data-cat=\"areal\" class=\"seg-btn text-sm font-semibold rounded-lg px-3 py-2 bg-gray-100 text-gray-700\">Areal</button>\n        <button data-cat=\"hulmaal\" class=\"seg-btn text-sm font-semibold rounded-lg px-3 py-2 bg-gray-100 text-gray-700\">Hulmål</button>\n        <button data-cat=\"vekt\" class=\"seg-btn text-sm font-semibold rounded-lg px-3 py-2 bg-gray-100 text-gray-700\">Vekt</button>\n        <button data-cat=\"mynt\" class=\"seg-btn text-sm font-semibold rounded-lg px-3 py-2 bg-gray-100 text-gray-700\">Mynt</button>\n      </div>\n    </section>\n\n    <!-- Inndata -->\n    <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n      <h2 id=\"catTitle\" class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider mb-5\">Lengde</h2>\n      <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n        <div>\n          <label class=\"block text-xs font-medium text-gray-500 mb-1\">Antall</label>\n          <input id=\"amount\" type=\"number\" min=\"0\" step=\"any\" value=\"1\"\n            class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-800 text-base focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent tabular\"\n            placeholder=\"f.eks. 1\" />\n        </div>\n        <div>\n          <label class=\"block text-xs font-medium text-gray-500 mb-1\">Enhet</label>\n          <select id=\"unit\"\n            class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-800 text-base bg-white focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent\"></select>\n        </div>\n      </div>\n      <p id=\"inputSummary\" class=\"mt-4 text-sm text-gray-600\"></p>\n    </section>\n\n    <!-- Resultat -->\n    <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6 fade-in\" id=\"resultCard\">\n      <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4\">Tilsvarer</h2>\n      <div class=\"overflow-hidden rounded-xl border border-gray-200\">\n        <table class=\"w-full text-sm\">\n          <thead>\n            <tr class=\"bg-gray-50 text-gray-500 text-xs uppercase tracking-wider\">\n              <th class=\"text-left font-semibold px-4 py-2.5\">Enhet</th>\n              <th class=\"text-right font-semibold px-4 py-2.5\">Verdi</th>\n            </tr>\n          </thead>\n          <tbody id=\"resultBody\" class=\"divide-y divide-gray-100\"></tbody>\n        </table>\n      </div>\n      <p id=\"myntNote\" class=\"hidden mt-4 text-xs text-gray-500 leading-relaxed bg-indigo-50 border border-indigo-100 rounded-lg px-4 py-3\"></p>\n    </section>\n\n    <!-- Om gamle mål -->\n    <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n      <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3\">Om gamle mål</h2>\n      <ul class=\"text-sm text-gray-600 leading-relaxed space-y-2 list-disc pl-5\">\n        <li>Verdiene er <strong>standardiserte</strong> — basert på den metriske fastsettelsen av de gamle målene (etter lovene fra 1875 og 1887). De er ment som praktiske referanseverdier.</li>\n        <li>Mange gamle mål — <strong>særlig vekt og hulmål</strong> — varierte både regionalt og over tid. En tønne korn var ikke nødvendigvis lik en tønne salt, og lokale mål kunne avvike. Bruk verdiene med skjønn for eldre eller stedlige kilder.</li>\n        <li>Mynt-omregningen viser <strong>pålydende 1875-kroner</strong>, altså myntens nominelle verdi — <em>ikke</em> dagens kjøpekraft eller realverdi.</li>\n        <li><strong>Matrikkelskyld</strong> (skylddaler, mark, øre) er en historisk <em>skatteverdi</em> for en eiendom, ikke et arealmål, og inngår derfor ikke her.</li>\n      </ul>\n    </section>\n\n  </main>\n\n  <footer class=\"max-w-4xl mx-auto px-4 py-6 text-center text-xs text-gray-400\">\n    Gamle mål &amp; mynt &mdash; <a href=\"https://github.com/halisonworks/public-app-studio\" class=\"underline hover:text-indigo-500\" target=\"_blank\" rel=\"noopener\">Halison App Studio</a>\n  </footer>\n\n<script>\n// ─── Konverteringsfaktorer (alt via én basisenhet per kategori) ──────────────\n\nvar CATS = {\n  lengde: {\n    title: 'Lengde',\n    baseUnit: 'meter',\n    units: {\n      alen: 0.6275,\n      fot: 0.31375,\n      tomme: 0.0261458,\n      linje: 0.00217882,\n      kvarter: 0.156875,\n      favn: 1.8825,\n      'mil (gml. norsk)': 11295,\n      meter: 1,\n      centimeter: 0.01,\n      kilometer: 1000\n    },\n    defaultUnit: 'alen',\n    decimals: { 'tomme': 4, 'linje': 5, 'centimeter': 3, 'mil (gml. norsk)': 6, 'kilometer': 5 }\n  },\n  areal: {\n    title: 'Areal',\n    baseUnit: 'kvadratmeter',\n    units: {\n      kvadratalen: 0.39375625,\n      kvadratfot: 0.0984391,\n      'mål (dekar)': 1000,\n      ar: 100,\n      hektar: 10000,\n      kvadratmeter: 1\n    },\n    defaultUnit: 'kvadratalen',\n    decimals: { 'hektar': 5, 'mål (dekar)': 4, 'ar': 4, 'kvadratfot': 4 }\n  },\n  hulmaal: {\n    title: 'Hulmål (volum)',\n    baseUnit: 'liter',\n    units: {\n      'tønne': 139.121,\n      skjeppe: 17.3901,\n      fjerdingkar: 4.34753,\n      kanne: 1.93016,\n      pot: 0.96508,\n      liter: 1,\n      desiliter: 0.1\n    },\n    defaultUnit: 'tønne',\n    decimals: { 'tønne': 4, 'desiliter': 3 }\n  },\n  vekt: {\n    title: 'Vekt',\n    baseUnit: 'kilogram',\n    units: {\n      mark: 0.249125,\n      'skålpund (pund)': 0.49825,\n      lispund: 7.972,\n      bismerpund: 5.9824,\n      skippund: 159.44,\n      kilogram: 1,\n      gram: 0.001\n    },\n    defaultUnit: 'skålpund (pund)',\n    decimals: { 'gram': 2, 'kilogram': 4, 'skippund': 5, 'lispund': 4, 'bismerpund': 4 }\n  },\n  mynt: {\n    title: 'Mynt',\n    baseUnit: 'skilling',\n    units: {\n      'speciedaler (spd)': 120,\n      ort: 24,\n      skilling: 1\n    },\n    defaultUnit: 'speciedaler (spd)',\n    decimals: { 'speciedaler (spd)': 4, 'ort': 3 }\n  }\n};\n\n// ─── Tilstand ────────────────────────────────────────────────────────────────\n\nvar state = { cat: 'lengde', unit: CATS.lengde.defaultUnit, amount: 1 };\n\n// ─── Tallformatering ─────────────────────────────────────────────────────────\n\nfunction fmtNum(value, decimals) {\n  if (!isFinite(value)) return '–';\n  if (value === 0) return '0';\n  var abs = Math.abs(value);\n  var d;\n  if (typeof decimals === 'number') {\n    d = decimals;\n  } else if (abs >= 100) {\n    d = 2;\n  } else if (abs >= 1) {\n    d = 3;\n  } else if (abs >= 0.01) {\n    d = 4;\n  } else {\n    d = 6;\n  }\n  // Avrund, fjern unødige etterfølgende nuller\n  var rounded = Number(value.toFixed(d));\n  var s = rounded.toFixed(d);\n  if (s.indexOf('.') !== -1) {\n    s = s.replace(/0+$/, '').replace(/\\.$/, '');\n  }\n  // Norsk: komma som desimaltegn, mellomrom som tusenskille\n  var parts = s.split('.');\n  parts[0] = parts[0].replace(/\\B(?=(\\d{3})+(?!\\d))/g, ' ');\n  return parts.join(',');\n}\n\n// ─── DOM-referanser ──────────────────────────────────────────────────────────\n\nfunction el(id) { return document.getElementById(id); }\n\n// ─── Bygg enhetsliste for valgt kategori ─────────────────────────────────────\n\nfunction buildUnitOptions() {\n  var cat = CATS[state.cat];\n  var sel = el('unit');\n  sel.innerHTML = '';\n  Object.keys(cat.units).forEach(function (u) {\n    var opt = document.createElement('option');\n    opt.value = u;\n    opt.textContent = u;\n    sel.appendChild(opt);\n  });\n  sel.value = state.unit;\n}\n\n// ─── Beregn og vis ───────────────────────────────────────────────────────────\n\nfunction render() {\n  var cat = CATS[state.cat];\n  el('catTitle').textContent = cat.title;\n\n  var amount = parseFloat(String(state.amount).replace(',', '.'));\n  if (isNaN(amount)) amount = 0;\n\n  var factor = cat.units[state.unit];\n  var baseValue = amount * factor; // i basisenhet\n\n  // Inndata-oppsummering\n  el('inputSummary').textContent =\n    fmtNum(amount) + ' ' + state.unit + ' → omregnet til alle enheter under:';\n\n  // Resultattabell — alle ekvivalenter\n  var body = el('resultBody');\n  body.innerHTML = '';\n  Object.keys(cat.units).forEach(function (u) {\n    var val = baseValue / cat.units[u];\n    var dec = cat.decimals && cat.decimals[u];\n    var tr = document.createElement('tr');\n    if (u === state.unit) tr.className = 'row-hl';\n    var tdName = document.createElement('td');\n    tdName.className = 'px-4 py-2.5 text-gray-700' + (u === state.unit ? ' font-semibold text-indigo-700' : '');\n    tdName.textContent = u;\n    var tdVal = document.createElement('td');\n    tdVal.className = 'px-4 py-2.5 text-right text-gray-900 font-semibold tabular';\n    tdVal.textContent = fmtNum(val, dec);\n    tr.appendChild(tdName);\n    tr.appendChild(tdVal);\n    body.appendChild(tr);\n  });\n\n  // Mynt: legg til kroner-rad + merknad\n  var note = el('myntNote');\n  if (state.cat === 'mynt') {\n    var skilling = baseValue; // basis er skilling\n    var kroner = skilling * 4 / 120; // 1 spd = 4 kr\n    var trK = document.createElement('tr');\n    trK.className = 'bg-indigo-50';\n    var tdKn = document.createElement('td');\n    tdKn.className = 'px-4 py-2.5 text-indigo-700 font-semibold';\n    tdKn.textContent = '≈ kroner (1875)';\n    var tdKv = document.createElement('td');\n    tdKv.className = 'px-4 py-2.5 text-right text-indigo-700 font-bold tabular';\n    tdKv.textContent = fmtNum(kroner, 4) + ' kr';\n    trK.appendChild(tdKn);\n    trK.appendChild(tdKv);\n    body.appendChild(trK);\n\n    note.classList.remove('hidden');\n    note.innerHTML =\n      '1 speciedaler = 5 ort = 120 skilling, og tilsvarte 4 kroner ved myntreformen i 1875. ' +\n      'Til finregning: 1 ort = 80 øre og 1 skilling ≈ 3,33 øre. ' +\n      'Merk at den eldre <em>rigsdaler courant</em> hadde 96 skilling, og inngår ikke i tabellen over.';\n  } else {\n    note.classList.add('hidden');\n    note.innerHTML = '';\n  }\n\n  // Lagre tilstand\n  try {\n    localStorage.setItem('gamle-maal-mynt', JSON.stringify(state));\n  } catch (e) { /* ignorer */ }\n}\n\n// ─── Hendelser ───────────────────────────────────────────────────────────────\n\nfunction setCategory(cat) {\n  if (!CATS[cat]) return;\n  state.cat = cat;\n  state.unit = CATS[cat].defaultUnit;\n  // Marker aktiv fane\n  var btns = el('catTabs').querySelectorAll('button');\n  for (var i = 0; i < btns.length; i++) {\n    if (btns[i].getAttribute('data-cat') === cat) {\n      btns[i].classList.add('active');\n    } else {\n      btns[i].classList.remove('active');\n    }\n  }\n  buildUnitOptions();\n  render();\n}\n\nel('catTabs').addEventListener('click', function (ev) {\n  var btn = ev.target.closest('button[data-cat]');\n  if (btn) setCategory(btn.getAttribute('data-cat'));\n});\n\nel('unit').addEventListener('change', function () {\n  state.unit = this.value;\n  render();\n});\n\nel('amount').addEventListener('input', function () {\n  state.amount = this.value;\n  render();\n});\n\n// ─── Last fra localStorage / init ────────────────────────────────────────────\n\n(function restoreOrInit() {\n  try {\n    var saved = JSON.parse(localStorage.getItem('gamle-maal-mynt'));\n    if (saved && CATS[saved.cat] && CATS[saved.cat].units[saved.unit]) {\n      state.cat = saved.cat;\n      state.unit = saved.unit;\n      if (saved.amount !== undefined && saved.amount !== null && saved.amount !== '') {\n        state.amount = saved.amount;\n      }\n    }\n  } catch (e) { /* ignorer */ }\n\n  el('amount').value = state.amount;\n\n  // Sett riktig aktiv fane og bygg enhetsliste\n  var btns = el('catTabs').querySelectorAll('button');\n  for (var i = 0; i < btns.length; i++) {\n    if (btns[i].getAttribute('data-cat') === state.cat) {\n      btns[i].classList.add('active');\n    } else {\n      btns[i].classList.remove('active');\n    }\n  }\n  buildUnitOptions();\n  render();\n})();\n</script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Gamle mål & mynt",
    "windowTitle": "Gamle mål & mynt",
    "bundleId": "com.halisonworks.gamlemaalogmynt",
    "iconPath": null
  },
  "categoryId": null,
  "source": "import",
  "createdAt": "2026-06-02T12:00:00.000Z",
  "updatedAt": "2026-06-02T12:00:00.000Z",
  "sharedAt": "2026-06-02T12:00:00.000Z"
}
