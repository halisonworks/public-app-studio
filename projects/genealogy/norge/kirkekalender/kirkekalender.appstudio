{
  "schema": "app-studio/canvas@1",
  "id": "example-kirkekalender",
  "name": "kirkekalender.html",
  "code": "<!DOCTYPE html>\n<!--\n  Kirkeårskalender — Halison App Studio-eksempel\n\n  Regn ut påske og bevegelige helligdager, og oversett kirkekalender-datoer som «3. søndag etter påske 1763» til faktiske datoer — med riktig kalender før og etter reformen i 1700.\n\n  Fra Halison App Studio sitt offentlige bibliotek:\n  https://github.com/halisonworks/public-app-studio\n\n  Tillatt bruk: personlig, pedagogisk og annen ikke-kommersiell bruk. Behold denne\n  headeren og kildelenken intakt; du kan endre verktøyet, men ikke selg, kommersialiser\n  eller republiser det. Utgitt under Halison App Studio Examples License — se\n  LICENSE-filen i repoet over.\n-->\n<html lang=\"no\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Kirkeårskalender</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Inter', 'Segoe UI', sans-serif; }\n    .fade-in { animation: fadeIn 0.4s ease; }\n    @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }\n    .badge-jul { background: #fef3c7; color: #92400e; border: 1.5px solid #fcd34d; }\n    .badge-greg { background: #e0e7ff; color: #3730a3; border: 1.5px solid #a5b4fc; }\n    .holyrow:hover { background: #f5f3ff; }\n    input[type=number]::-webkit-inner-spin-button,\n    input[type=number]::-webkit-outer-spin-button { opacity: 1; }\n    .tabbtn { transition: all 0.15s ease; }\n  </style>\n</head>\n<body class=\"bg-gray-50 min-h-screen\">\n\n  <!-- Header -->\n  <header class=\"bg-white border-b border-gray-200 sticky top-0 z-30 shadow-sm\">\n    <div class=\"max-w-4xl mx-auto px-4 py-4 flex items-center justify-between\">\n      <div class=\"flex items-center gap-3\">\n        <div class=\"w-9 h-9 rounded-lg bg-indigo-600 flex items-center justify-center\">\n          <svg class=\"w-5 h-5 text-white\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\">\n            <rect x=\"3\" y=\"4.5\" width=\"18\" height=\"16\" rx=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" />\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M3 9h18M8 3v3M16 3v3M12 11.5v6M9 14.5h6\" />\n          </svg>\n        </div>\n        <div>\n          <h1 class=\"text-lg font-bold text-gray-900 leading-tight\">Kirkeårskalender</h1>\n          <p class=\"text-xs text-gray-500\">Påskeregning, bevegelige helligdager og kalenderreformen i 1700</p>\n        </div>\n      </div>\n      <div class=\"hidden sm:flex items-center gap-2 text-xs text-gray-400\">\n        <span class=\"px-2 py-1 rounded badge-jul font-medium\">før 1700: juliansk</span>\n        <span class=\"px-2 py-1 rounded badge-greg font-medium\">fra 1700: gregoriansk</span>\n      </div>\n    </div>\n  </header>\n\n  <main class=\"max-w-4xl mx-auto px-4 py-8 space-y-6\">\n\n    <!-- Om kirkeåret -->\n    <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n      <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3\">Om kirkeåret</h2>\n      <div class=\"text-sm text-gray-600 leading-relaxed space-y-2\">\n        <p>Kirkebøker daterte ofte hendelser etter <strong class=\"text-gray-800\">kirkeåret</strong> i stedet for med vanlig dato — for eksempel «døpt 3. søndag etter påske». De bevegelige helligdagene følger påsken, som flytter seg fra år til år, så samme kirkelige merkedag faller på ulike datoer.</p>\n        <p>Danmark-Norge gikk fra den <strong class=\"text-gray-800\">julianske</strong> til den <strong class=\"text-gray-800\">gregorianske</strong> kalenderen i år 1700: søndag <strong>18. februar 1700</strong> (juliansk) ble fulgt av torsdag <strong>1. mars 1700</strong> (gregoriansk) — altså ble 11 dager hoppet over.</p>\n        <p>I dette verktøyet vises datoer for år <strong>før 1700</strong> i juliansk kalender (slik kildene skrev dem), og for år <strong>fra og med 1700</strong> i gregoriansk kalender.</p>\n      </div>\n    </section>\n\n    <!-- Tabs -->\n    <div class=\"flex flex-wrap gap-2\">\n      <button data-tab=\"aar\" class=\"tabbtn px-4 py-2 rounded-xl text-sm font-semibold bg-indigo-600 text-white shadow-sm\">Kirkeåret for et år</button>\n      <button data-tab=\"tolk\" class=\"tabbtn px-4 py-2 rounded-xl text-sm font-semibold bg-white text-gray-600 border border-gray-200 hover:bg-gray-50\">Tolk en referanse</button>\n      <button data-tab=\"omvendt\" class=\"tabbtn px-4 py-2 rounded-xl text-sm font-semibold bg-white text-gray-600 border border-gray-200 hover:bg-gray-50\">Omvendt: dato → kirkedag</button>\n    </div>\n\n    <!-- ════════════ SEKSJON 1: KIRKEÅRET FOR ET ÅR ════════════ -->\n    <section id=\"panel-aar\" class=\"space-y-6\">\n      <div class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n        <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider mb-5\">Kirkeåret for et år</h2>\n        <div class=\"flex flex-wrap items-end gap-4\">\n          <div>\n            <label class=\"block text-xs font-medium text-gray-500 mb-1\">Årstall</label>\n            <input id=\"aarInput\" type=\"number\" min=\"1\" max=\"9999\" value=\"1763\"\n              class=\"w-40 border border-gray-300 rounded-lg px-3 py-2 text-gray-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent\" />\n          </div>\n          <p class=\"text-xs text-gray-400 pb-2\">Skriv inn et årstall for å se påskedagen og alle bevegelige helligdager.</p>\n        </div>\n        <div id=\"aarError\" class=\"hidden mt-4 bg-red-50 border border-red-200 rounded-xl px-4 py-2 text-red-700 text-sm\"></div>\n      </div>\n\n      <!-- Påske-kort -->\n      <div id=\"aarResults\" class=\"space-y-5 fade-in\">\n        <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n          <div class=\"flex flex-col sm:flex-row sm:items-center gap-4\">\n            <div class=\"flex-1\">\n              <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider mb-2\">1. påskedag</h2>\n              <p id=\"paaskeDato\" class=\"text-2xl font-bold text-indigo-700\"></p>\n              <p id=\"paaskeNote\" class=\"text-sm text-gray-500 mt-1\"></p>\n            </div>\n            <div id=\"kalenderBadge\" class=\"flex-shrink-0 px-5 py-3 rounded-xl font-bold text-sm text-center min-w-[150px]\"></div>\n          </div>\n        </section>\n\n        <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n          <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4\">Bevegelige helligdager</h2>\n          <div class=\"overflow-x-auto\">\n            <table class=\"w-full text-sm\">\n              <thead>\n                <tr class=\"text-left text-xs text-gray-400 uppercase tracking-wider border-b border-gray-200\">\n                  <th class=\"py-2 pr-4 font-semibold\">Helligdag</th>\n                  <th class=\"py-2 pr-4 font-semibold\">Dato</th>\n                  <th class=\"py-2 font-semibold text-right\">Dager fra påske</th>\n                </tr>\n              </thead>\n              <tbody id=\"helligTable\"></tbody>\n            </table>\n          </div>\n        </section>\n      </div>\n    </section>\n\n    <!-- ════════════ SEKSJON 2: TOLK EN REFERANSE ════════════ -->\n    <section id=\"panel-tolk\" class=\"space-y-6 hidden\">\n      <div class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n        <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider mb-5\">Tolk en referanse</h2>\n        <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n          <div class=\"sm:col-span-2\">\n            <label class=\"block text-xs font-medium text-gray-500 mb-1\">Type referanse</label>\n            <select id=\"tolkType\"\n              class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-800 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-400\">\n              <option value=\"paaske\">N. søndag etter påske</option>\n              <option value=\"trinitatis\">N. søndag etter trinitatis</option>\n              <option value=\"advent\">N. søndag i advent</option>\n              <option value=\"navngitt\">Navngitt helligdag</option>\n            </select>\n          </div>\n          <div id=\"tolkNWrap\">\n            <label class=\"block text-xs font-medium text-gray-500 mb-1\">Tall (N)</label>\n            <input id=\"tolkN\" type=\"number\" min=\"1\" max=\"27\" value=\"3\"\n              class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400\" />\n          </div>\n          <div id=\"tolkNavnWrap\" class=\"hidden\">\n            <label class=\"block text-xs font-medium text-gray-500 mb-1\">Helligdag</label>\n            <select id=\"tolkNavn\"\n              class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-800 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-400\"></select>\n          </div>\n          <div>\n            <label class=\"block text-xs font-medium text-gray-500 mb-1\">Årstall</label>\n            <input id=\"tolkAar\" type=\"number\" min=\"1\" max=\"9999\" value=\"1763\"\n              class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400\" />\n          </div>\n        </div>\n        <div id=\"tolkError\" class=\"hidden mt-4 bg-red-50 border border-red-200 rounded-xl px-4 py-2 text-red-700 text-sm\"></div>\n      </div>\n\n      <section id=\"tolkResult\" class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6 fade-in\">\n        <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider mb-2\">Faktisk dato</h2>\n        <p id=\"tolkRef\" class=\"text-sm text-gray-500 mb-1\"></p>\n        <p id=\"tolkDato\" class=\"text-2xl font-bold text-indigo-700\"></p>\n        <p id=\"tolkNote\" class=\"text-sm text-gray-500 mt-1\"></p>\n      </section>\n    </section>\n\n    <!-- ════════════ SEKSJON 3: OMVENDT ════════════ -->\n    <section id=\"panel-omvendt\" class=\"space-y-6 hidden\">\n      <div class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n        <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider mb-5\">Omvendt: dato → kirkedag</h2>\n        <p class=\"text-xs text-gray-400 mb-4\">Skriv inn en dato slik den står i kilden. Kalenderen velges automatisk: juliansk for år før 1700, gregoriansk fra og med 1700.</p>\n        <div class=\"grid grid-cols-2 sm:grid-cols-4 gap-4\">\n          <div>\n            <label class=\"block text-xs font-medium text-gray-500 mb-1\">Dag</label>\n            <input id=\"omvDag\" type=\"number\" min=\"1\" max=\"31\" value=\"1\"\n              class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400\" />\n          </div>\n          <div>\n            <label class=\"block text-xs font-medium text-gray-500 mb-1\">Måned</label>\n            <select id=\"omvMnd\"\n              class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-800 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-400\"></select>\n          </div>\n          <div>\n            <label class=\"block text-xs font-medium text-gray-500 mb-1\">År</label>\n            <input id=\"omvAar\" type=\"number\" min=\"1\" max=\"9999\" value=\"1763\"\n              class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400\" />\n          </div>\n          <div class=\"flex items-end\">\n            <span id=\"omvKalBadge\" class=\"px-3 py-2 rounded-lg text-xs font-semibold w-full text-center\"></span>\n          </div>\n        </div>\n        <div id=\"omvError\" class=\"hidden mt-4 bg-red-50 border border-red-200 rounded-xl px-4 py-2 text-red-700 text-sm\"></div>\n      </div>\n\n      <section id=\"omvResult\" class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6 fade-in\">\n        <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider mb-2\">Kirkelig betegnelse</h2>\n        <p id=\"omvUkedag\" class=\"text-sm text-gray-500 mb-1\"></p>\n        <p id=\"omvNavn\" class=\"text-2xl font-bold text-indigo-700\"></p>\n        <p id=\"omvNote\" class=\"text-sm text-gray-500 mt-1\"></p>\n      </section>\n    </section>\n\n  </main>\n\n  <footer class=\"max-w-4xl mx-auto px-4 py-6 text-center text-xs text-gray-400\">\n    Kirkeårskalender &mdash; <a href=\"https://github.com/halisonworks/public-app-studio\" class=\"underline hover:text-indigo-500\" target=\"_blank\" rel=\"noopener\">Halison App Studio</a>\n  </footer>\n\n<script>\n// ═══════════════════════ MOTOR ═══════════════════════\nfunction gregorianToJDN(y,m,d){const a=Math.floor((14-m)/12),yy=y+4800-a,mm=m+12*a-3;return d+Math.floor((153*mm+2)/5)+365*yy+Math.floor(yy/4)-Math.floor(yy/100)+Math.floor(yy/400)-32045;}\nfunction julianToJDN(y,m,d){const a=Math.floor((14-m)/12),yy=y+4800-a,mm=m+12*a-3;return d+Math.floor((153*mm+2)/5)+365*yy+Math.floor(yy/4)-32083;}\nfunction jdnToGregorian(J){let a=J+32044,b=Math.floor((4*a+3)/146097),c=a-Math.floor(146097*b/4);let dd=Math.floor((4*c+3)/1461),e=c-Math.floor(1461*dd/4),mm=Math.floor((5*e+2)/153);return{year:100*b+dd-4800+Math.floor(mm/10),month:mm+3-12*Math.floor(mm/10),day:e-Math.floor((153*mm+2)/5)+1};}\nfunction jdnToJulian(J){let c=J+32082,dd=Math.floor((4*c+3)/1461),e=c-Math.floor(1461*dd/4),mm=Math.floor((5*e+2)/153);return{year:dd-4800+Math.floor(mm/10),month:mm+3-12*Math.floor(mm/10),day:e-Math.floor((153*mm+2)/5)+1};}\nconst UKEDAG=['mandag','tirsdag','onsdag','torsdag','fredag','lørdag','søndag'];\nfunction ukedag(J){return UKEDAG[((J%7)+7)%7];}\n// søndag har indeks 6 i UKEDAG-tabellen ovenfor\nfunction ukedagIndex(J){return ((J%7)+7)%7;}\n// Påske: gregoriansk for år>=1700 (Norge), juliansk for år<1700.\nfunction paaskeGreg(y){const a=y%19,b=Math.floor(y/100),c=y%100,d=Math.floor(b/4),e=b%4,f=Math.floor((b+8)/25),g=Math.floor((b-f+1)/3),h=(19*a+b-d-g+15)%30,i=Math.floor(c/4),k=c%4,l=(32+2*e+2*i-h-k)%7,m=Math.floor((a+11*h+22*l)/451),month=Math.floor((h+l-7*m+114)/31),day=((h+l-7*m+114)%31)+1;return{month,day};}\nfunction paaskeJul(y){const a=y%4,b=y%7,c=y%19,d=(19*c+15)%30,e=(2*a+4*b-d+34)%7,month=Math.floor((d+e+114)/31),day=((d+e+114)%31)+1;return{month,day};}\n// 1. påskedag som JDN, i riktig kalender for året:\nfunction paaskeJDN(y){ if(y>=1700){const p=paaskeGreg(y);return gregorianToJDN(y,p.month,p.day);} else {const p=paaskeJul(y);return julianToJDN(y,p.month,p.day);} }\nfunction jdnTilDato(J,y){ return y>=1700 ? jdnToGregorian(J) : jdnToJulian(J); }   // for visning\n\n// ═══════════════════════ HJELPERE ═══════════════════════\nconst MND_NAVN = ['januar','februar','mars','april','mai','juni','juli','august','september','oktober','november','desember'];\n\nfunction fmtDato(J, aar){\n  const d = jdnTilDato(J, aar);\n  return d.day + '. ' + MND_NAVN[d.month-1] + ' ' + d.year + ' (' + ukedag(J) + ')';\n}\nfunction kalenderNavn(aar){ return aar >= 1700 ? 'gregoriansk' : 'juliansk'; }\n\n// Bevegelige helligdager: offset i dager fra 1. påskedag (=0)\n// Faste navngitte helligdager + de spesielle «N. etter»-typene håndteres separat.\nconst NAVNGITTE = [\n  { navn: 'Septuagesima (9. søndag før påske)', off: -63 },\n  { navn: 'Seksagesima (8. søndag før påske)', off: -56 },\n  { navn: 'Fastelavnssøndag', off: -49 },\n  { navn: 'Askeonsdag', off: -46 },\n  { navn: '1. søndag i faste', off: -42 },\n  { navn: 'Midtfaste (4. søndag i faste)', off: -21 },\n  { navn: 'Palmesøndag', off: -7 },\n  { navn: 'Skjærtorsdag', off: -3 },\n  { navn: 'Langfredag', off: -2 },\n  { navn: 'Påskeaften', off: -1 },\n  { navn: '1. påskedag', off: 0 },\n  { navn: '2. påskedag', off: 1 },\n  { navn: 'Kristi himmelfartsdag', off: 39 },\n  { navn: 'Søndag før pinse', off: 42 },\n  { navn: '1. pinsedag', off: 49 },\n  { navn: '2. pinsedag', off: 50 },\n  { navn: 'Treenighetssøndag', off: 56 }\n];\n\n// Full liste for tabellen i seksjon 1 (sortert etter offset, inkl. «N. etter»-eksempler)\nfunction byggHelligListe(){\n  const liste = [];\n  NAVNGITTE.forEach(h => liste.push({ navn: h.navn, off: h.off }));\n  // N. søndag etter påske: 1..5 (offset 7*N)\n  for(let n=1;n<=5;n++) liste.push({ navn: n + '. søndag etter påske', off: 7*n });\n  // N. søndag etter trinitatis: 1..24 (offset 49 + 7*N) — vis et utvalg\n  for(let n=1;n<=24;n++) liste.push({ navn: n + '. søndag etter trinitatis', off: 49 + 7*n });\n  // Fjern duplikater på offset+navn, sorter på offset\n  liste.sort((a,b)=> a.off - b.off || a.navn.localeCompare(b.navn));\n  return liste;\n}\n\n// Advent: 1. søndag i advent = 4. søndag før 1. juledag (25. des).\n// Finn siste søndag på/før 24. des, deretter tell tilbake.\nfunction adventJDN(N, aar){\n  const jul = (aar>=1700) ? gregorianToJDN(aar,12,25) : julianToJDN(aar,12,25);\n  // siste søndag på/før 24. des: søndag har ukedagIndex 6.\n  let j = jul - 1; // 24. desember\n  while(ukedagIndex(j) !== 6) j--;   // gå bakover til søndag\n  // j er nå 4. søndag i advent (søndagen rett før jul, eller på julaften hvis søndag)\n  // 1. søndag i advent = denne − 7*(4−N)? Nei: j er SISTE (4.) søndag i advent.\n  // N. søndag i advent = j − 7*(4 − N)\n  return j - 7*(4 - N);\n}\n\n// ═══════════════════════ SEKSJON 1 ═══════════════════════\nfunction renderAar(){\n  const errEl = document.getElementById('aarError');\n  const resEl = document.getElementById('aarResults');\n  const raw = document.getElementById('aarInput').value;\n  const y = parseInt(raw, 10);\n  if(!raw || isNaN(y) || y < 1 || y > 9999){\n    errEl.textContent = 'Skriv inn et gyldig årstall mellom 1 og 9999.';\n    errEl.classList.remove('hidden');\n    resEl.classList.add('opacity-30','pointer-events-none');\n    return;\n  }\n  errEl.classList.add('hidden');\n  resEl.classList.remove('opacity-30','pointer-events-none');\n\n  const pJDN = paaskeJDN(y);\n  document.getElementById('paaskeDato').textContent = fmtDato(pJDN, y);\n  document.getElementById('paaskeNote').textContent =\n    'Påskedagen er regnet ut med ' + kalenderNavn(y) + ' påskeregning for året ' + y + '.';\n  const badge = document.getElementById('kalenderBadge');\n  if(y >= 1700){\n    badge.className = 'flex-shrink-0 px-5 py-3 rounded-xl font-bold text-sm text-center min-w-[150px] badge-greg';\n    badge.textContent = 'Gregoriansk kalender';\n  } else {\n    badge.className = 'flex-shrink-0 px-5 py-3 rounded-xl font-bold text-sm text-center min-w-[150px] badge-jul';\n    badge.textContent = 'Juliansk kalender';\n  }\n\n  const tbody = document.getElementById('helligTable');\n  tbody.innerHTML = '';\n  byggHelligListe().forEach(h => {\n    const J = pJDN + h.off;\n    const tr = document.createElement('tr');\n    tr.className = 'holyrow border-b border-gray-100 last:border-0';\n    const offTxt = (h.off > 0 ? '+' : '') + h.off;\n    tr.innerHTML =\n      '<td class=\"py-2 pr-4 text-gray-800 font-medium\">' + h.navn + '</td>' +\n      '<td class=\"py-2 pr-4 text-gray-600\">' + fmtDato(J, y) + '</td>' +\n      '<td class=\"py-2 text-right text-gray-400 tabular-nums\">' + offTxt + '</td>';\n    tbody.appendChild(tr);\n  });\n\n  save();\n}\n\n// ═══════════════════════ SEKSJON 2 ═══════════════════════\nfunction fyllNavngittDropdown(){\n  const sel = document.getElementById('tolkNavn');\n  sel.innerHTML = '';\n  NAVNGITTE.forEach((h, idx) => {\n    const o = document.createElement('option');\n    o.value = String(idx);\n    o.textContent = h.navn;\n    sel.appendChild(o);\n  });\n}\n\nfunction oppdaterTolkFelter(){\n  const type = document.getElementById('tolkType').value;\n  document.getElementById('tolkNWrap').classList.toggle('hidden', type === 'navngitt');\n  document.getElementById('tolkNavnWrap').classList.toggle('hidden', type !== 'navngitt');\n}\n\nfunction renderTolk(){\n  const errEl = document.getElementById('tolkError');\n  const resEl = document.getElementById('tolkResult');\n  const type = document.getElementById('tolkType').value;\n  const yRaw = document.getElementById('tolkAar').value;\n  const y = parseInt(yRaw, 10);\n\n  function feil(msg){\n    errEl.textContent = msg; errEl.classList.remove('hidden');\n    resEl.classList.add('opacity-30','pointer-events-none');\n  }\n\n  if(!yRaw || isNaN(y) || y < 1 || y > 9999) return feil('Skriv inn et gyldig årstall mellom 1 og 9999.');\n\n  let J, refTekst;\n\n  if(type === 'navngitt'){\n    const idx = parseInt(document.getElementById('tolkNavn').value, 10);\n    const h = NAVNGITTE[idx];\n    if(!h) return feil('Velg en helligdag.');\n    J = paaskeJDN(y) + h.off;\n    refTekst = h.navn + ' ' + y;\n  } else {\n    const nRaw = document.getElementById('tolkN').value;\n    const n = parseInt(nRaw, 10);\n    if(!nRaw || isNaN(n) || n < 1) return feil('Skriv inn et gyldig tall N (1 eller mer).');\n    if(type === 'paaske'){\n      if(n > 5) return feil('«N. søndag etter påske» går vanligvis fra 1 til 5 (deretter kommer pinse).');\n      J = paaskeJDN(y) + 7*n;\n      refTekst = n + '. søndag etter påske ' + y;\n    } else if(type === 'trinitatis'){\n      if(n > 27) return feil('«N. søndag etter trinitatis» går maksimalt til omtrent 27.');\n      J = paaskeJDN(y) + 49 + 7*n;\n      refTekst = n + '. søndag etter trinitatis ' + y;\n    } else { // advent\n      if(n > 4) return feil('Det er kun 4 søndager i advent.');\n      J = adventJDN(n, y);\n      refTekst = n + '. søndag i advent ' + y;\n    }\n  }\n\n  errEl.classList.add('hidden');\n  resEl.classList.remove('opacity-30','pointer-events-none');\n  document.getElementById('tolkRef').textContent = refTekst + ' tilsvarer:';\n  document.getElementById('tolkDato').textContent = fmtDato(J, y);\n  document.getElementById('tolkNote').textContent =\n    'Datoen vises i ' + kalenderNavn(y) + ' kalender (slik den ville stått i kilden for år ' + y + ').';\n\n  save();\n}\n\n// ═══════════════════════ SEKSJON 3 ═══════════════════════\nfunction fyllMaanedDropdown(id){\n  const sel = document.getElementById(id);\n  sel.innerHTML = '';\n  MND_NAVN.forEach((m, idx) => {\n    const o = document.createElement('option');\n    o.value = String(idx+1);\n    o.textContent = (idx+1) + '. ' + m;\n    sel.appendChild(o);\n  });\n}\n\nfunction dagerIMaaned(aar, m){\n  // Skuddårsregel: juliansk hvis år<1700, gregoriansk ellers.\n  const skudd = aar < 1700\n    ? (aar % 4 === 0)\n    : (aar % 4 === 0 && (aar % 100 !== 0 || aar % 400 === 0));\n  return [31, skudd?29:28, 31,30,31,30,31,31,30,31,30,31][m-1];\n}\n\nfunction renderOmvendt(){\n  const errEl = document.getElementById('omvError');\n  const resEl = document.getElementById('omvResult');\n  const d = parseInt(document.getElementById('omvDag').value, 10);\n  const m = parseInt(document.getElementById('omvMnd').value, 10);\n  const yRaw = document.getElementById('omvAar').value;\n  const y = parseInt(yRaw, 10);\n\n  const kalBadge = document.getElementById('omvKalBadge');\n\n  function feil(msg){\n    errEl.textContent = msg; errEl.classList.remove('hidden');\n    resEl.classList.add('opacity-30','pointer-events-none');\n  }\n\n  if(!yRaw || isNaN(y) || y < 1 || y > 9999){\n    kalBadge.className = 'px-3 py-2 rounded-lg text-xs font-semibold w-full text-center bg-gray-100 text-gray-400';\n    kalBadge.textContent = '—';\n    return feil('Skriv inn et gyldig årstall mellom 1 og 9999.');\n  }\n\n  if(y >= 1700){\n    kalBadge.className = 'px-3 py-2 rounded-lg text-xs font-semibold w-full text-center badge-greg';\n    kalBadge.textContent = 'gregoriansk';\n  } else {\n    kalBadge.className = 'px-3 py-2 rounded-lg text-xs font-semibold w-full text-center badge-jul';\n    kalBadge.textContent = 'juliansk';\n  }\n\n  if(isNaN(d) || d < 1 || isNaN(m) || m < 1 || m > 12) return feil('Velg en gyldig dag og måned.');\n  const maxDag = dagerIMaaned(y, m);\n  if(d > maxDag) return feil('Ugyldig dato: ' + MND_NAVN[m-1] + ' ' + y + ' har bare ' + maxDag + ' dager.');\n\n  // Den «glemte» perioden i 1700: 19.–28. februar 1700 (juliansk) finnes ikke som gregoriansk.\n  // Vi tolker innskrevne datoer i den kalenderen som gjelder for året, så det er konsistent.\n\n  errEl.classList.add('hidden');\n  resEl.classList.remove('opacity-30','pointer-events-none');\n\n  const J = (y >= 1700) ? gregorianToJDN(y, m, d) : julianToJDN(y, m, d);\n  document.getElementById('omvUkedag').textContent =\n    'Datoen ' + d + '. ' + MND_NAVN[m-1] + ' ' + y + ' var en ' + ukedag(J) + '.';\n\n  // Bygg en oppslagstabell over alle kirkedager dette året (offset → navn)\n  const pJDN = paaskeJDN(y);\n  const treff = [];\n  byggHelligListe().forEach(h => {\n    if(pJDN + h.off === J) treff.push(h.navn);\n  });\n  // Advent (1.-4.)\n  for(let n=1;n<=4;n++){\n    if(adventJDN(n, y) === J) treff.push(n + '. søndag i advent');\n  }\n\n  const navnEl = document.getElementById('omvNavn');\n  const noteEl = document.getElementById('omvNote');\n\n  if(treff.length > 0){\n    navnEl.textContent = treff.join(' / ');\n    noteEl.textContent = 'Denne datoen er en kjent merkedag i kirkeåret for ' + y + '.';\n  } else if(ukedagIndex(J) === 6){\n    // Søndag uten eget navn: prøv å beskrive som N. etter trinitatis eller N. etter påske.\n    const dagerEtterPaaske = J - pJDN;\n    let beskr = null;\n    if(dagerEtterPaaske >= 56 && (dagerEtterPaaske - 49) % 7 === 0){\n      const n = (dagerEtterPaaske - 49) / 7;\n      if(n >= 1 && n <= 27) beskr = n + '. søndag etter trinitatis';\n    }\n    if(!beskr && dagerEtterPaaske > 0 && dagerEtterPaaske < 49 && dagerEtterPaaske % 7 === 0){\n      const n = dagerEtterPaaske / 7;\n      beskr = n + '. søndag etter påske';\n    }\n    if(beskr){\n      navnEl.textContent = beskr;\n      noteEl.textContent = 'En søndag i kirkeåret, regnet ut fra påsken (' + dagerEtterPaaske + ' dager etter 1. påskedag).';\n    } else {\n      navnEl.textContent = 'Søndag (ingen navngitt merkedag)';\n      noteEl.textContent = 'Datoen er en søndag, men faller utenfor de typiske «etter påske / etter trinitatis»-tellingene.';\n    }\n  } else {\n    navnEl.textContent = 'Ingen kjent kirkedag';\n    noteEl.textContent = 'Denne datoen sammenfaller ikke med en bevegelig helligdag i ' + y + '. Den var en ' + ukedag(J) + '.';\n  }\n\n  save();\n}\n\n// ═══════════════════════ TABS ═══════════════════════\nfunction visTab(tab){\n  ['aar','tolk','omvendt'].forEach(t => {\n    document.getElementById('panel-' + t).classList.toggle('hidden', t !== tab);\n  });\n  document.querySelectorAll('.tabbtn').forEach(btn => {\n    const aktiv = btn.dataset.tab === tab;\n    btn.className = 'tabbtn px-4 py-2 rounded-xl text-sm font-semibold ' +\n      (aktiv ? 'bg-indigo-600 text-white shadow-sm'\n             : 'bg-white text-gray-600 border border-gray-200 hover:bg-gray-50');\n  });\n  save();\n}\n\n// ═══════════════════════ LAGRING ═══════════════════════\nfunction gjeldendeTab(){\n  if(!document.getElementById('panel-tolk').classList.contains('hidden')) return 'tolk';\n  if(!document.getElementById('panel-omvendt').classList.contains('hidden')) return 'omvendt';\n  return 'aar';\n}\n\nfunction save(){\n  try {\n    localStorage.setItem('kirkekalender', JSON.stringify({\n      tab: gjeldendeTab(),\n      aar: document.getElementById('aarInput').value,\n      tolkType: document.getElementById('tolkType').value,\n      tolkN: document.getElementById('tolkN').value,\n      tolkNavn: document.getElementById('tolkNavn').value,\n      tolkAar: document.getElementById('tolkAar').value,\n      omvDag: document.getElementById('omvDag').value,\n      omvMnd: document.getElementById('omvMnd').value,\n      omvAar: document.getElementById('omvAar').value\n    }));\n  } catch(e){ /* ignore */ }\n}\n\nfunction restore(){\n  try {\n    const s = JSON.parse(localStorage.getItem('kirkekalender'));\n    if(s){\n      if(s.aar) document.getElementById('aarInput').value = s.aar;\n      if(s.tolkType) document.getElementById('tolkType').value = s.tolkType;\n      if(s.tolkN) document.getElementById('tolkN').value = s.tolkN;\n      if(s.tolkNavn) document.getElementById('tolkNavn').value = s.tolkNavn;\n      if(s.tolkAar) document.getElementById('tolkAar').value = s.tolkAar;\n      if(s.omvDag) document.getElementById('omvDag').value = s.omvDag;\n      if(s.omvMnd) document.getElementById('omvMnd').value = s.omvMnd;\n      if(s.omvAar) document.getElementById('omvAar').value = s.omvAar;\n      return s.tab || 'aar';\n    }\n  } catch(e){ /* ignore */ }\n  return 'aar';\n}\n\n// ═══════════════════════ INIT ═══════════════════════\nfyllNavngittDropdown();\nfyllMaanedDropdown('omvMnd');\n\ndocument.querySelectorAll('.tabbtn').forEach(btn => {\n  btn.addEventListener('click', () => visTab(btn.dataset.tab));\n});\n\n['aarInput'].forEach(id =>\n  document.getElementById(id).addEventListener('input', renderAar));\n\n['tolkType','tolkN','tolkNavn','tolkAar'].forEach(id =>\n  document.getElementById(id).addEventListener('input', () => { oppdaterTolkFelter(); renderTolk(); }));\ndocument.getElementById('tolkType').addEventListener('change', () => { oppdaterTolkFelter(); renderTolk(); });\n\n['omvDag','omvMnd','omvAar'].forEach(id =>\n  document.getElementById(id).addEventListener('input', renderOmvendt));\n\nconst startTab = restore();\noppdaterTolkFelter();\nrenderAar();\nrenderTolk();\nrenderOmvendt();\nvisTab(startTab);\n\n// ═══ Selvtest (kun konsoll) ═══\n(function selvtest(){\n  try {\n    const t = [];\n    const p2000 = paaskeGreg(2000); t.push(p2000.month===4 && p2000.day===23);\n    const p2024 = paaskeGreg(2024); t.push(p2024.month===3 && p2024.day===31);\n    const p1700 = paaskeGreg(1700); t.push(p1700.month===4 && p1700.day===11);\n    const himmel = paaskeJDN(2000)+39; const hd = jdnToGregorian(himmel);\n    t.push(hd.month===6 && hd.day===1 && ukedag(himmel)==='torsdag');\n    const pinse = paaskeJDN(2000)+49; const pd = jdnToGregorian(pinse);\n    t.push(pd.month===6 && pd.day===11);\n    if(t.every(Boolean)) console.log('Kirkekalender selvtest: OK');\n    else console.warn('Kirkekalender selvtest FEIL', t);\n  } catch(e){ console.warn('Selvtest-feil', e); }\n})();\n</script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Kirkeårskalender",
    "windowTitle": "Kirkeårskalender",
    "bundleId": "com.halisonworks.kirkekalender",
    "iconPath": null
  },
  "categoryId": null,
  "source": "import",
  "createdAt": "2026-06-02T12:00:00.000Z",
  "updatedAt": "2026-06-02T12:00:00.000Z",
  "sharedAt": "2026-06-02T12:00:00.000Z"
}
