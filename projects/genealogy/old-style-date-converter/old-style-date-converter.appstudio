{
  "schema": "app-studio/canvas@1",
  "id": "example-old-style-date-converter",
  "name": "old-style-date-converter.html",
  "code": "<!DOCTYPE html>\n<!--\n  Old Style / New Style Date Converter — Halison App Studio example\n\n  Convert between Julian (Old Style) and Gregorian (New Style) calendar dates, find the day of the week for any historical date, and understand double-dated years.\n\n  From the Halison App Studio public library:\n  https://github.com/halisonworks/public-app-studio\n\n  Permitted use: personal, educational, and other non-commercial use. You may\n  modify it, but keep this header and the source link intact, and do not sell,\n  commercialize, or republish it. Released under the Halison App Studio Examples\n  License — see the LICENSE file in the repository above.\n-->\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Old Style / New Style Date Converter</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Inter', 'Segoe UI', sans-serif; }\n    input[type=number]::-webkit-inner-spin-button,\n    input[type=number]::-webkit-outer-spin-button { opacity: 1; }\n    .fade-in { animation: fadeIn 0.4s ease; }\n    @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }\n    .seg { transition: all 0.15s ease; }\n    .seg-active { background: #4f46e5; color: #fff; box-shadow: 0 1px 2px rgba(0,0,0,0.1); }\n    .seg-idle { background: transparent; color: #4b5563; }\n  </style>\n</head>\n<body class=\"bg-gray-50 min-h-screen\">\n\n  <!-- Header -->\n  <header class=\"bg-white border-b border-gray-200 sticky top-0 z-30 shadow-sm\">\n    <div class=\"max-w-3xl mx-auto px-4 py-4 flex items-center gap-3\">\n      <div class=\"w-9 h-9 rounded-lg bg-indigo-600 flex items-center justify-center flex-shrink-0\">\n        <svg class=\"w-5 h-5 text-white\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z\" />\n        </svg>\n      </div>\n      <div>\n        <h1 class=\"text-lg font-bold text-gray-900 leading-tight\">Old Style / New Style Date Converter</h1>\n        <p class=\"text-xs text-gray-500\">Julian &harr; Gregorian, day of the week, and double dating for genealogy</p>\n      </div>\n    </div>\n  </header>\n\n  <main class=\"max-w-3xl mx-auto px-4 py-8 space-y-6\">\n\n    <!-- ── 1. CONVERT ──────────────────────────────────────────────────────── -->\n    <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n      <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider mb-1\">1 &middot; Convert a date</h2>\n      <p class=\"text-xs text-gray-500 mb-5\">Enter a date and tell us which calendar it is recorded in. We show the equivalent date in the other calendar.</p>\n\n      <div class=\"grid grid-cols-3 gap-3 mb-4\">\n        <div>\n          <label class=\"block text-xs font-medium text-gray-500 mb-1\">Day</label>\n          <input id=\"c_day\" type=\"number\" min=\"1\" max=\"31\" value=\"11\"\n            class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent\" />\n        </div>\n        <div>\n          <label class=\"block text-xs font-medium text-gray-500 mb-1\">Month</label>\n          <select id=\"c_month\" class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-800 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent\"></select>\n        </div>\n        <div>\n          <label class=\"block text-xs font-medium text-gray-500 mb-1\">Year</label>\n          <input id=\"c_year\" type=\"number\" value=\"1732\"\n            class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent\" />\n        </div>\n      </div>\n\n      <label class=\"block text-xs font-medium text-gray-500 mb-1.5\">This date is recorded in</label>\n      <div class=\"inline-flex rounded-lg border border-gray-200 bg-gray-100 p-1 mb-4\" role=\"radiogroup\">\n        <button type=\"button\" data-cal=\"julian\" class=\"c-cal seg seg-active rounded-md px-4 py-1.5 text-sm font-medium\">Old Style / Julian</button>\n        <button type=\"button\" data-cal=\"gregorian\" class=\"c-cal seg seg-idle rounded-md px-4 py-1.5 text-sm font-medium\">New Style / Gregorian</button>\n      </div>\n\n      <div id=\"c_error\" class=\"hidden bg-red-50 border border-red-200 rounded-xl px-4 py-2.5 text-red-700 text-sm flex items-center gap-2 mb-4\">\n        <svg class=\"w-4 h-4 flex-shrink-0\" fill=\"currentColor\" viewBox=\"0 0 20 20\"><path fill-rule=\"evenodd\" d=\"M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z\" clip-rule=\"evenodd\"/></svg>\n        <span id=\"c_error_text\"></span>\n      </div>\n\n      <div id=\"c_result\" class=\"fade-in\">\n        <div class=\"rounded-xl bg-indigo-50 border border-indigo-100 p-5 mb-4\">\n          <div class=\"text-xs text-indigo-500 font-medium uppercase tracking-wide mb-1\">Equivalent in the other calendar</div>\n          <div id=\"c_converted\" class=\"text-2xl font-bold text-indigo-800 leading-snug\">—</div>\n          <div id=\"c_original\" class=\"text-sm text-indigo-600 mt-1\">—</div>\n        </div>\n        <div class=\"grid grid-cols-1 sm:grid-cols-3 gap-3\">\n          <div class=\"bg-white rounded-xl border border-gray-200 p-4\">\n            <div class=\"text-xs text-gray-500 font-medium mb-1\">Day of the week</div>\n            <div id=\"c_weekday\" class=\"text-lg font-bold text-gray-800\">—</div>\n            <div class=\"text-xs text-gray-400 mt-0.5\">same physical day in both</div>\n          </div>\n          <div class=\"bg-white rounded-xl border border-gray-200 p-4\">\n            <div class=\"text-xs text-gray-500 font-medium mb-1\">Julian Day Number</div>\n            <div id=\"c_jdn\" class=\"text-lg font-bold text-gray-800\">—</div>\n            <div class=\"text-xs text-gray-400 mt-0.5\">astronomical day count</div>\n          </div>\n          <div class=\"bg-white rounded-xl border border-gray-200 p-4\">\n            <div class=\"text-xs text-gray-500 font-medium mb-1\">Calendar gap</div>\n            <div id=\"c_gap\" class=\"text-lg font-bold text-gray-800\">—</div>\n            <div class=\"text-xs text-gray-400 mt-0.5\">days between OS and NS</div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- ── 2. DAY OF THE WEEK ──────────────────────────────────────────────── -->\n    <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n      <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider mb-1\">2 &middot; Day of the week</h2>\n      <p class=\"text-xs text-gray-500 mb-5\">Find the weekday for any historical date. For British or American records dated before 14 September 1752, use the <strong>Old Style / Julian</strong> option.</p>\n\n      <div class=\"grid grid-cols-3 gap-3 mb-4\">\n        <div>\n          <label class=\"block text-xs font-medium text-gray-500 mb-1\">Day</label>\n          <input id=\"w_day\" type=\"number\" min=\"1\" max=\"31\" value=\"2\"\n            class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent\" />\n        </div>\n        <div>\n          <label class=\"block text-xs font-medium text-gray-500 mb-1\">Month</label>\n          <select id=\"w_month\" class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-800 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent\"></select>\n        </div>\n        <div>\n          <label class=\"block text-xs font-medium text-gray-500 mb-1\">Year</label>\n          <input id=\"w_year\" type=\"number\" value=\"1752\"\n            class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent\" />\n        </div>\n      </div>\n\n      <label class=\"block text-xs font-medium text-gray-500 mb-1.5\">Calendar of this date</label>\n      <div class=\"inline-flex rounded-lg border border-gray-200 bg-gray-100 p-1 mb-4\" role=\"radiogroup\">\n        <button type=\"button\" data-cal=\"julian\" class=\"w-cal seg seg-active rounded-md px-4 py-1.5 text-sm font-medium\">Old Style / Julian</button>\n        <button type=\"button\" data-cal=\"gregorian\" class=\"w-cal seg seg-idle rounded-md px-4 py-1.5 text-sm font-medium\">New Style / Gregorian</button>\n      </div>\n\n      <div id=\"w_error\" class=\"hidden bg-red-50 border border-red-200 rounded-xl px-4 py-2.5 text-red-700 text-sm flex items-center gap-2 mb-4\">\n        <svg class=\"w-4 h-4 flex-shrink-0\" fill=\"currentColor\" viewBox=\"0 0 20 20\"><path fill-rule=\"evenodd\" d=\"M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z\" clip-rule=\"evenodd\"/></svg>\n        <span id=\"w_error_text\"></span>\n      </div>\n\n      <div id=\"w_result\" class=\"fade-in flex flex-col sm:flex-row sm:items-center gap-4\">\n        <div class=\"flex-shrink-0 px-8 py-5 rounded-2xl bg-indigo-600 text-white text-center min-w-[180px]\">\n          <div id=\"w_weekday\" class=\"text-2xl font-bold leading-tight\">—</div>\n        </div>\n        <div class=\"text-sm text-gray-600\">\n          <span id=\"w_full\" class=\"font-semibold text-gray-800\">—</span>\n          <span id=\"w_jdn_note\" class=\"block text-xs text-gray-400 mt-1\"></span>\n        </div>\n      </div>\n    </section>\n\n    <!-- ── 3. DOUBLE DATING ────────────────────────────────────────────────── -->\n    <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n      <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider mb-1\">3 &middot; Double dating helper</h2>\n      <p class=\"text-xs text-gray-500 mb-5\">Enter a date in the <strong>Julian</strong> calendar. Dates from 1 January to 24 March fell in the old English civil year that had not yet rolled over, so records often write them with a split year such as <em>1731/32</em>.</p>\n\n      <div class=\"grid grid-cols-3 gap-3 mb-4\">\n        <div>\n          <label class=\"block text-xs font-medium text-gray-500 mb-1\">Day</label>\n          <input id=\"d_day\" type=\"number\" min=\"1\" max=\"31\" value=\"11\"\n            class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent\" />\n        </div>\n        <div>\n          <label class=\"block text-xs font-medium text-gray-500 mb-1\">Month</label>\n          <select id=\"d_month\" class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-800 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent\"></select>\n        </div>\n        <div>\n          <label class=\"block text-xs font-medium text-gray-500 mb-1\">Year</label>\n          <input id=\"d_year\" type=\"number\" value=\"1732\"\n            class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent\" />\n        </div>\n      </div>\n\n      <label class=\"flex items-start gap-2 mb-4 text-sm text-gray-600 cursor-pointer select-none\">\n        <input id=\"d_ladyday\" type=\"checkbox\" class=\"mt-0.5 h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-400\" />\n        <span>My source already uses the historical year start (year begins on 25 March / Lady Day), so the year I typed is the <em>old-style</em> year number.</span>\n      </label>\n\n      <div id=\"d_error\" class=\"hidden bg-red-50 border border-red-200 rounded-xl px-4 py-2.5 text-red-700 text-sm flex items-center gap-2 mb-4\">\n        <svg class=\"w-4 h-4 flex-shrink-0\" fill=\"currentColor\" viewBox=\"0 0 20 20\"><path fill-rule=\"evenodd\" d=\"M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z\" clip-rule=\"evenodd\"/></svg>\n        <span id=\"d_error_text\"></span>\n      </div>\n\n      <div id=\"d_result\" class=\"fade-in rounded-xl border border-gray-200 p-5\">\n        <div id=\"d_inwindow\">\n          <div class=\"text-xs text-gray-500 font-medium uppercase tracking-wide mb-1\">Double-dated historical form</div>\n          <div id=\"d_form\" class=\"text-2xl font-bold text-indigo-800\">—</div>\n          <p id=\"d_explain\" class=\"text-sm text-gray-600 mt-2 leading-relaxed\"></p>\n        </div>\n      </div>\n    </section>\n\n    <!-- ── ABOUT / BACKGROUND ──────────────────────────────────────────────── -->\n    <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n      <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4\">About &amp; background</h2>\n      <div class=\"space-y-3 text-sm text-gray-600 leading-relaxed\">\n        <p>\n          For centuries Europe used the <strong>Julian calendar</strong> (the <em>Old Style</em>, or OS). Because the Julian year is slightly too long, the calendar slowly drifted out of step with the seasons. The <strong>Gregorian calendar</strong> (the <em>New Style</em>, or NS) corrected this. Catholic countries adopted it in <strong>1582</strong>, but Britain and its colonies held out until <strong>September 1752</strong>.\n        </p>\n        <p>\n          When Britain switched, it had to drop <strong>11 days</strong> to catch up: <strong>Wednesday 2 September 1752</strong> was immediately followed by <strong>Thursday 14 September 1752</strong>. No days went missing physically — only the labels changed.\n        </p>\n        <p>\n          Separately, England's <strong>civil year began on 25 March</strong> (Lady Day), not 1 January, until 1752. So a date such as 11 February that we would call 1732 was, at the time, still written as part of <strong>1731</strong>. To avoid confusion, historians and registers often <strong>double date</strong> these dates between 1 January and 24 March — for example <strong>11 February 1731/32</strong>.\n        </p>\n        <p class=\"text-xs text-gray-500 bg-gray-50 border border-gray-200 rounded-lg px-4 py-3\">\n          <strong class=\"text-gray-700\">For understanding historical records.</strong> This tool uses one consistent Julian Day Number engine and the <em>proleptic</em> Julian and Gregorian calendars (extending each backward beyond its real-world adoption). Different regions changed over on different dates, so always interpret a source against the calendar actually in use where and when it was written. Years are treated as astronomical-style continuous numbers; there is no year 0 in the historical record, so take great care with dates around 1 BC / AD 1.\n        </p>\n      </div>\n    </section>\n\n  </main>\n\n  <footer class=\"max-w-3xl mx-auto px-4 py-6 text-center text-xs text-gray-400\">\n    Old Style / New Style Date Converter &mdash; <a href=\"https://github.com/halisonworks/public-app-studio\" class=\"underline hover:text-indigo-500\" target=\"_blank\" rel=\"noopener\">Halison App Studio</a>\n  </footer>\n\n<script>\n// ─── Julian Day Number engine (transcribed exactly; integer / floor math) ────\n\nfunction gregorianToJDN(y,m,d){\n  const a=Math.floor((14-m)/12), yy=y+4800-a, mm=m+12*a-3;\n  return d+Math.floor((153*mm+2)/5)+365*yy+Math.floor(yy/4)-Math.floor(yy/100)+Math.floor(yy/400)-32045;\n}\nfunction julianToJDN(y,m,d){\n  const a=Math.floor((14-m)/12), yy=y+4800-a, mm=m+12*a-3;\n  return d+Math.floor((153*mm+2)/5)+365*yy+Math.floor(yy/4)-32083;\n}\nfunction jdnToGregorian(J){\n  let a=J+32044, b=Math.floor((4*a+3)/146097), c=a-Math.floor(146097*b/4);\n  let dd=Math.floor((4*c+3)/1461), e=c-Math.floor(1461*dd/4), mm=Math.floor((5*e+2)/153);\n  const day=e-Math.floor((153*mm+2)/5)+1, month=mm+3-12*Math.floor(mm/10), year=100*b+dd-4800+Math.floor(mm/10);\n  return {year,month,day};\n}\nfunction jdnToJulian(J){\n  let c=J+32082, dd=Math.floor((4*c+3)/1461), e=c-Math.floor(1461*dd/4), mm=Math.floor((5*e+2)/153);\n  const day=e-Math.floor((153*mm+2)/5)+1, month=mm+3-12*Math.floor(mm/10), year=dd-4800+Math.floor(mm/10);\n  return {year,month,day};\n}\n// Day of week: JDN 0 was a Monday. weekday index (0=Mon..6=Sun) = ((J % 7)+7)%7\nconst WEEKDAYS=['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'];\nfunction weekday(J){ return WEEKDAYS[((J%7)+7)%7]; }\n\n// ─── Helpers ─────────────────────────────────────────────────────────────────\n\nconst MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];\n\n// Round-trip validity check: convert to JDN and back; if it differs, the date\n// (e.g. 31 February) does not exist in that calendar.\nfunction isValidDate(cal, y, m, d) {\n  if (!Number.isInteger(y) || !Number.isInteger(m) || !Number.isInteger(d)) return false;\n  if (m < 1 || m > 12 || d < 1 || d > 31) return false;\n  const J = cal === 'julian' ? julianToJDN(y, m, d) : gregorianToJDN(y, m, d);\n  const back = cal === 'julian' ? jdnToJulian(J) : jdnToGregorian(J);\n  return back.year === y && back.month === m && back.day === d;\n}\n\nfunction fmtDate(parts, styleLabel) {\n  return parts.day + ' ' + MONTHS[parts.month - 1] + ' ' + parts.year + (styleLabel ? ' (' + styleLabel + ')' : '');\n}\n\nfunction readDate(prefix) {\n  const day = parseInt(document.getElementById(prefix + '_day').value, 10);\n  const month = parseInt(document.getElementById(prefix + '_month').value, 10);\n  const year = parseInt(document.getElementById(prefix + '_year').value, 10);\n  return { day, month, year };\n}\n\nfunction showError(prefix, msg, resultId) {\n  const box = document.getElementById(prefix + '_error');\n  document.getElementById(prefix + '_error_text').textContent = msg;\n  box.classList.remove('hidden');\n  document.getElementById(resultId).classList.add('opacity-30', 'pointer-events-none');\n}\nfunction clearError(prefix, resultId) {\n  document.getElementById(prefix + '_error').classList.add('hidden');\n  document.getElementById(resultId).classList.remove('opacity-30', 'pointer-events-none');\n}\n\n// Track which calendar each segmented control has selected.\nconst calState = { c: 'julian', w: 'julian' };\n\n// ─── Populate month dropdowns ────────────────────────────────────────────────\n\n['c', 'w', 'd'].forEach(prefix => {\n  const sel = document.getElementById(prefix + '_month');\n  MONTHS.forEach((name, i) => {\n    const opt = document.createElement('option');\n    opt.value = i + 1;\n    opt.textContent = name;\n    sel.appendChild(opt);\n  });\n});\n// Defaults: Convert -> February, Day of week -> September, Double -> February\ndocument.getElementById('c_month').value = 2;\ndocument.getElementById('w_month').value = 9;\ndocument.getElementById('d_month').value = 2;\n\n// ─── Section 1: Convert ──────────────────────────────────────────────────────\n\nfunction runConvert() {\n  const { day, month, year } = readDate('c');\n  const cal = calState.c;\n  if ([day, month, year].some(v => Number.isNaN(v))) {\n    showError('c', 'Please fill in a full day, month, and year.', 'c_result');\n    return;\n  }\n  if (!isValidDate(cal, year, month, day)) {\n    showError('c', day + ' ' + MONTHS[month - 1] + ' ' + year + ' is not a real date in the ' +\n      (cal === 'julian' ? 'Julian' : 'Gregorian') + ' calendar.', 'c_result');\n    return;\n  }\n  clearError('c', 'c_result');\n\n  const J = cal === 'julian' ? julianToJDN(year, month, day) : gregorianToJDN(year, month, day);\n  const other = cal === 'julian' ? jdnToGregorian(J) : jdnToJulian(J);\n  const otherLabel = cal === 'julian' ? 'New Style' : 'Old Style';\n  const thisLabel = cal === 'julian' ? 'Old Style' : 'New Style';\n\n  // Gap = Gregorian JDN minus Julian JDN for the SAME y/m/d numbers,\n  // i.e. how many days NS is ahead of OS for this date.\n  const gap = gregorianToJDN(year, month, day) - julianToJDN(year, month, day);\n\n  document.getElementById('c_converted').textContent = fmtDate(other, otherLabel);\n  document.getElementById('c_original').textContent =\n    'You entered ' + fmtDate({ day, month, year }, thisLabel) + '.';\n  document.getElementById('c_weekday').textContent = weekday(J);\n  document.getElementById('c_jdn').textContent = J.toLocaleString('en-US');\n  document.getElementById('c_gap').textContent = gap + (Math.abs(gap) === 1 ? ' day' : ' days');\n\n  persist();\n}\n\n// ─── Section 2: Day of the week ──────────────────────────────────────────────\n\nfunction runWeekday() {\n  const { day, month, year } = readDate('w');\n  const cal = calState.w;\n  if ([day, month, year].some(v => Number.isNaN(v))) {\n    showError('w', 'Please fill in a full day, month, and year.', 'w_result');\n    return;\n  }\n  if (!isValidDate(cal, year, month, day)) {\n    showError('w', day + ' ' + MONTHS[month - 1] + ' ' + year + ' is not a real date in the ' +\n      (cal === 'julian' ? 'Julian' : 'Gregorian') + ' calendar.', 'w_result');\n    return;\n  }\n  clearError('w', 'w_result');\n\n  const J = cal === 'julian' ? julianToJDN(year, month, day) : gregorianToJDN(year, month, day);\n  const label = cal === 'julian' ? 'Old Style' : 'New Style';\n\n  document.getElementById('w_weekday').textContent = weekday(J);\n  document.getElementById('w_full').textContent = fmtDate({ day, month, year }, label);\n  document.getElementById('w_jdn_note').textContent = 'Julian Day Number ' + J.toLocaleString('en-US') + '.';\n\n  persist();\n}\n\n// ─── Section 3: Double dating ────────────────────────────────────────────────\n\nfunction runDouble() {\n  const { day, month, year } = readDate('d');\n  const ladyday = document.getElementById('d_ladyday').checked;\n  if ([day, month, year].some(v => Number.isNaN(v))) {\n    showError('d', 'Please fill in a full day, month, and year.', 'd_result');\n    return;\n  }\n  if (!isValidDate('julian', year, month, day)) {\n    showError('d', day + ' ' + MONTHS[month - 1] + ' ' + year + ' is not a real date in the Julian calendar.', 'd_result');\n    return;\n  }\n  clearError('d', 'd_result');\n\n  // In the window 1 Jan .. 24 Mar inclusive?\n  const inWindow = (month === 1) || (month === 2) || (month === 3 && day <= 24);\n\n  const form = document.getElementById('d_form');\n  const explain = document.getElementById('d_explain');\n  const head = document.querySelector('#d_inwindow .text-xs');\n\n  if (!inWindow) {\n    head.textContent = 'Outside the double-dating window';\n    form.textContent = fmtDate({ day, month, year }, null);\n    explain.innerHTML = 'This date falls between 25 March and 31 December, so the old English civil year and the modern year agree. No double dating is needed — the year is simply <strong>' + year + '</strong>.';\n    persist();\n    return;\n  }\n\n  head.textContent = 'Double-dated historical form';\n\n  // Determine the two adjacent year numbers.\n  // Modern (New Year = 1 Jan) year and the old civil (Lady Day) year differ by 1\n  // in this window: old civil year = modern year - 1.\n  let modernYear, oldYear;\n  if (ladyday) {\n    // The typed year is already the OLD civil-year number.\n    oldYear = year;\n    modernYear = year + 1;\n  } else {\n    // The typed year is the MODERN year number.\n    modernYear = year;\n    oldYear = year - 1;\n  }\n\n  // Build \"1731/32\" style: old year, slash, last two digits of modern year.\n  const twoDigit = ('0' + (modernYear % 100)).slice(-2);\n  const dual = oldYear + '/' + twoDigit;\n\n  form.textContent = day + ' ' + MONTHS[month - 1] + ' ' + dual;\n  explain.innerHTML =\n    'Under the old English civil calendar the year number had not yet rolled over on this date — the new year did not begin until 25 March (Lady Day). ' +\n    'A contemporary register would have recorded the year as <strong>' + oldYear + '</strong>, while by our modern reckoning (new year on 1 January) it is <strong>' + modernYear + '</strong>. ' +\n    'Writing it as <strong>' + dual + '</strong> makes both readings clear.';\n\n  persist();\n}\n\n// ─── Segmented (radio) controls ──────────────────────────────────────────────\n\nfunction wireSegments(cls, key, onChange) {\n  const buttons = Array.from(document.querySelectorAll('.' + cls));\n  buttons.forEach(btn => {\n    btn.addEventListener('click', () => {\n      calState[key] = btn.dataset.cal;\n      buttons.forEach(b => {\n        const active = b === btn;\n        b.classList.toggle('seg-active', active);\n        b.classList.toggle('seg-idle', !active);\n      });\n      onChange();\n    });\n  });\n}\nwireSegments('c-cal', 'c', runConvert);\nwireSegments('w-cal', 'w', runWeekday);\n\n// ─── Persistence ─────────────────────────────────────────────────────────────\n\nfunction persist() {\n  try {\n    localStorage.setItem('osns_converter', JSON.stringify({\n      c: { ...readDate('c'), cal: calState.c },\n      w: { ...readDate('w'), cal: calState.w },\n      d: { ...readDate('d'), ladyday: document.getElementById('d_ladyday').checked }\n    }));\n  } catch (e) { /* ignore */ }\n}\n\nfunction setSegment(cls, key, cal) {\n  calState[key] = cal;\n  document.querySelectorAll('.' + cls).forEach(b => {\n    const active = b.dataset.cal === cal;\n    b.classList.toggle('seg-active', active);\n    b.classList.toggle('seg-idle', !active);\n  });\n}\n\nfunction restore() {\n  try {\n    const saved = JSON.parse(localStorage.getItem('osns_converter'));\n    if (!saved) return;\n    if (saved.c) {\n      document.getElementById('c_day').value = saved.c.day;\n      document.getElementById('c_month').value = saved.c.month;\n      document.getElementById('c_year').value = saved.c.year;\n      if (saved.c.cal) setSegment('c-cal', 'c', saved.c.cal);\n    }\n    if (saved.w) {\n      document.getElementById('w_day').value = saved.w.day;\n      document.getElementById('w_month').value = saved.w.month;\n      document.getElementById('w_year').value = saved.w.year;\n      if (saved.w.cal) setSegment('w-cal', 'w', saved.w.cal);\n    }\n    if (saved.d) {\n      document.getElementById('d_day').value = saved.d.day;\n      document.getElementById('d_month').value = saved.d.month;\n      document.getElementById('d_year').value = saved.d.year;\n      document.getElementById('d_ladyday').checked = !!saved.d.ladyday;\n    }\n  } catch (e) { /* ignore */ }\n}\n\n// ─── Wire inputs ─────────────────────────────────────────────────────────────\n\n['c_day', 'c_month', 'c_year'].forEach(id => document.getElementById(id).addEventListener('input', runConvert));\n['w_day', 'w_month', 'w_year'].forEach(id => document.getElementById(id).addEventListener('input', runWeekday));\n['d_day', 'd_month', 'd_year', 'd_ladyday'].forEach(id => document.getElementById(id).addEventListener('input', runDouble));\n\n// ─── Init ────────────────────────────────────────────────────────────────────\n\nrestore();\nrunConvert();\nrunWeekday();\nrunDouble();\n</script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Old Style / New Style Date Converter",
    "windowTitle": "Old Style / New Style Date Converter",
    "bundleId": "com.halisonworks.oldstyledateconverter",
