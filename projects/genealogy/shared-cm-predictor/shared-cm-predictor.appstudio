{
  "schema": "app-studio/canvas@1",
  "id": "example-shared-cm-predictor",
  "name": "shared-cm-predictor.html",
  "code": "<!DOCTYPE html>\n<!--\n  Shared cM Relationship Predictor — Halison App Studio example\n\n  Enter the total shared centimorgans (cM) for a DNA match and see which family relationships are statistically plausible.\n\n  From the Halison App Studio public library:\n  https://github.com/halisonworks/public-app-studio\n\n  Permitted use: personal, educational, and other non-commercial use. You may\n  modify it, but keep this header and the source link intact, and do not sell,\n  commercialize, or republish it. Released under the Halison App Studio Examples\n  License — see the LICENSE file in the repository above.\n-->\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Shared cM Relationship Predictor</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Inter', 'Segoe UI', sans-serif; }\n    input[type=number]::-webkit-inner-spin-button,\n    input[type=number]::-webkit-outer-spin-button { opacity: 1; }\n    input[type=range] { accent-color: #4f46e5; }\n    .fade-in { animation: fadeIn 0.4s ease; }\n    @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }\n    .cluster-card { transition: box-shadow 0.2s ease, border-color 0.2s ease; }\n    .bar-fill { transition: width 0.5s cubic-bezier(0.4,0,0.2,1), left 0.5s cubic-bezier(0.4,0,0.2,1); }\n    .marker { transition: left 0.5s cubic-bezier(0.4,0,0.2,1); }\n    .badge-best { background: #e0e7ff; color: #3730a3; border: 1.5px solid #a5b4fc; }\n    .badge-in { background: #d1fae5; color: #065f46; border: 1.5px solid #6ee7b7; }\n    .badge-out { background: #fef3c7; color: #92400e; border: 1.5px solid #fcd34d; }\n  </style>\n</head>\n<body class=\"bg-gray-50 min-h-screen\">\n\n  <!-- Header -->\n  <header class=\"bg-white border-b border-gray-200 sticky top-0 z-30 shadow-sm\">\n    <div class=\"max-w-4xl mx-auto px-4 py-4 flex items-center gap-3\">\n      <div class=\"w-9 h-9 rounded-lg bg-indigo-600 flex items-center justify-center flex-shrink-0\">\n        <!-- Inline DNA double-helix icon -->\n        <svg class=\"w-5 h-5 text-white\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\">\n          <path d=\"M6 3c0 4.5 12 4.5 12 9s-12 4.5-12 9\" />\n          <path d=\"M18 3c0 4.5-12 4.5-12 9s12 4.5 12 9\" />\n          <path d=\"M7.5 5h9M7.5 19h9M6.3 8.2h11.4M6.3 15.8h11.4\" />\n        </svg>\n      </div>\n      <div>\n        <h1 class=\"text-lg font-bold text-gray-900 leading-tight\">Shared cM Relationship Predictor</h1>\n        <p class=\"text-xs text-gray-500\">Which family relationships fit a DNA match's shared centimorgans</p>\n      </div>\n    </div>\n  </header>\n\n  <main class=\"max-w-4xl mx-auto px-4 py-8 space-y-6\">\n\n    <!-- Input Section -->\n    <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n      <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider mb-5\">DNA Match</h2>\n\n      <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n        <!-- Total shared cM -->\n        <div class=\"space-y-4\">\n          <div>\n            <label for=\"cmInput\" class=\"block text-xs font-medium text-gray-500 mb-1\">Total shared cM (autosomal)</label>\n            <input id=\"cmInput\" type=\"number\" min=\"0\" max=\"3700\" step=\"1\" value=\"866\"\n              class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-800 text-lg font-semibold focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent\"\n              placeholder=\"e.g. 866\" />\n          </div>\n          <input id=\"cmSlider\" type=\"range\" min=\"0\" max=\"3700\" step=\"1\" value=\"866\" class=\"w-full\" />\n          <div class=\"flex justify-between text-[10px] text-gray-400 -mt-2\">\n            <span>0</span><span>Distant</span><span>Close</span><span>3700</span>\n          </div>\n        </div>\n\n        <!-- Largest segment (informational) -->\n        <div class=\"space-y-2\">\n          <label for=\"segInput\" class=\"block text-xs font-medium text-gray-500 mb-1\">\n            Largest segment in cM\n            <span class=\"text-gray-400 font-normal\">(optional, informational)</span>\n          </label>\n          <input id=\"segInput\" type=\"number\" min=\"0\" step=\"1\"\n            class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent\"\n            placeholder=\"e.g. 120\" />\n          <p class=\"text-xs text-gray-400 leading-relaxed\">\n            A large single segment can hint a closer relationship even at modest total cM; a match made of many tiny\n            segments leans more distant. This value is shown for context only and does not change the prediction.\n          </p>\n        </div>\n      </div>\n    </section>\n\n    <!-- Error Banner -->\n    <div id=\"errorBanner\" class=\"hidden bg-red-50 border border-red-200 rounded-xl px-5 py-3 text-red-700 text-sm flex items-center gap-2\">\n      <svg class=\"w-4 h-4 flex-shrink-0\" fill=\"currentColor\" viewBox=\"0 0 20 20\"><path fill-rule=\"evenodd\" d=\"M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z\" clip-rule=\"evenodd\"/></svg>\n      <span id=\"errorText\"></span>\n    </div>\n\n    <div id=\"resultsSection\" class=\"space-y-6 fade-in\">\n\n      <!-- Most likely headline -->\n      <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n        <div class=\"flex flex-col sm:flex-row sm:items-center gap-4\">\n          <div class=\"flex-1\">\n            <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider mb-2\">Most likely relationship</h2>\n            <p id=\"bestLabel\" class=\"text-xl font-bold text-gray-800 leading-snug\"></p>\n            <p id=\"bestSub\" class=\"text-sm text-gray-500 mt-1\"></p>\n          </div>\n          <div id=\"bestBadge\" class=\"flex-shrink-0 px-5 py-3 rounded-xl font-bold text-sm text-center min-w-[150px]\"></div>\n        </div>\n        <div id=\"zeroNote\" class=\"hidden mt-4 bg-amber-50 border border-amber-200 rounded-lg px-4 py-3 text-xs text-amber-800 leading-relaxed\">\n          <strong>0 cM does not rule out a relationship.</strong> Many real 3rd cousins and almost all relationships\n          more distant than that share <em>no</em> detectable DNA at all. A result of 0 cM means &ldquo;not detectably\n          related,&rdquo; not &ldquo;not related.&rdquo;\n        </div>\n      </section>\n\n      <!-- Plausible clusters -->\n      <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n        <div class=\"flex items-center justify-between mb-1\">\n          <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider\">Plausible relationship clusters</h2>\n          <span id=\"clusterCount\" class=\"text-xs text-gray-400 font-medium\"></span>\n        </div>\n        <p class=\"text-xs text-gray-400 mb-5\">Sorted by how close your value sits to each cluster's average. The bar plots the observed range; the dot is the average, the line is your value.</p>\n        <div id=\"clusterList\" class=\"space-y-4\"></div>\n      </section>\n\n      <!-- About / Important caveats -->\n      <section class=\"bg-indigo-50 rounded-2xl border border-indigo-200 p-6\">\n        <div class=\"flex items-start gap-3\">\n          <svg class=\"w-5 h-5 text-indigo-600 flex-shrink-0 mt-0.5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\" />\n          </svg>\n          <div class=\"text-sm text-indigo-900 leading-relaxed space-y-2\">\n            <p class=\"font-bold text-base text-indigo-900\">About &amp; important caveats</p>\n            <p>\n              These figures are based on the publicly published <strong>Shared cM Project (v4)</strong> by\n              Blaine Bettinger, as presented by <strong>DNA Painter</strong> &mdash; the crowd-sourced\n              <em>average</em> and <em>observed ranges</em> of total shared autosomal centimorgans for each\n              relationship.\n            </p>\n            <ul class=\"list-disc pl-5 space-y-1\">\n              <li>Values are <strong>total autosomal cM</strong> &mdash; a sum of shared DNA, <em>not</em> a percentage.</li>\n              <li>The ranges <strong>overlap heavily</strong>. A single cM total almost never points to one relationship.</li>\n              <li>cM alone <strong>cannot prove</strong> a specific relationship. You also need <strong>X-DNA</strong>,\n                  <strong>segment counts</strong>, family <strong>trees</strong>, and <strong>known relatives</strong> to triangulate.</li>\n              <li>Half, &ldquo;removed,&rdquo; and multi-generation relationships routinely share the same band, which is\n                  why they are grouped together here.</li>\n              <li>This tool is an <strong>educational approximation</strong>, not professional or legal genealogical advice.</li>\n            </ul>\n          </div>\n        </div>\n      </section>\n\n      <!-- Source note -->\n      <section class=\"bg-gray-50 rounded-xl border border-gray-200 px-5 py-4 text-xs text-gray-500 leading-relaxed\">\n        <strong class=\"text-gray-700\">Data source:</strong> Approximate Shared cM Project v4 figures (Blaine Bettinger / DNA Painter),\n        total autosomal cM. Averages and observed [min&ndash;max] ranges are reproduced for educational use. For serious\n        casework, consult the interactive Shared cM tool at DNA Painter and a qualified genealogist.\n      </section>\n\n    </div>\n  </main>\n\n  <footer class=\"max-w-4xl mx-auto px-4 py-6 text-center text-xs text-gray-400\">\n    Shared cM Relationship Predictor &mdash; <a href=\"https://github.com/halisonworks/public-app-studio\" class=\"underline hover:text-indigo-500\" target=\"_blank\" rel=\"noopener\">Halison App Studio</a>\n  </footer>\n\n<script>\n// ─── Dataset (approximate Shared cM Project v4, total autosomal cM) ───────────\nconst DATA = [\n {label:'Identical twin', avg:3475, min:2376, max:3720},\n {label:'Parent / Child', avg:3485, min:3330, max:3720},\n {label:'Full sibling', avg:2613, min:1613, max:3488},\n {label:'Grandparent / Grandchild · Aunt/Uncle · Niece/Nephew · Half-sibling', avg:1759, min:1160, max:2436},\n {label:'1st cousin · Great-grandparent · Great-aunt/uncle · Half-aunt/uncle · Half-niece/nephew', avg:866, min:396, max:1397},\n {label:'1st cousin once removed · Half 1st cousin · Great-great-grandparent', avg:433, min:102, max:980},\n {label:'2nd cousin · 1st cousin twice removed · Half 1st cousin once removed', avg:229, min:41, max:592},\n {label:'2nd cousin once removed · Half 2nd cousin', avg:122, min:14, max:353},\n {label:'3rd cousin · 2nd cousin twice removed', avg:73, min:0, max:217},\n {label:'3rd cousin once removed · Half 3rd cousin', avg:48, min:0, max:192},\n {label:'4th cousin', avg:35, min:0, max:139},\n {label:'4th cousin once removed', avg:28, min:0, max:126},\n {label:'5th cousin', avg:25, min:0, max:117},\n {label:'6th–8th cousin (distant)', avg:14, min:0, max:71}\n];\n\n// ─── DOM refs ─────────────────────────────────────────────────────────────────\nconst cmInput   = document.getElementById('cmInput');\nconst cmSlider  = document.getElementById('cmSlider');\nconst segInput  = document.getElementById('segInput');\nconst errBanner = document.getElementById('errorBanner');\nconst errText   = document.getElementById('errorText');\nconst bestLabel = document.getElementById('bestLabel');\nconst bestSub   = document.getElementById('bestSub');\nconst bestBadge = document.getElementById('bestBadge');\nconst zeroNote  = document.getElementById('zeroNote');\nconst clusterList  = document.getElementById('clusterList');\nconst clusterCount = document.getElementById('clusterCount');\nconst resultsSection = document.getElementById('resultsSection');\n\n// ─── Helpers ──────────────────────────────────────────────────────────────────\nfunction fmt(n) { return Math.round(n).toLocaleString('en-US'); }\nfunction escapeHtml(s) {\n  return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\n}\n// Split a clustered label on the middot into individual relationship chips.\nfunction splitLabel(label) {\n  return label.split('·').map(s => s.trim()).filter(Boolean);\n}\n\n// Render a single cluster card.\nfunction renderCard(d, cm, opts) {\n  const within = cm >= d.min && cm <= d.max;\n  const chips = splitLabel(d.label)\n    .map(c => `<span class=\"inline-block bg-gray-100 text-gray-700 text-xs font-medium rounded-md px-2 py-0.5\">${escapeHtml(c)}</span>`)\n    .join(' ');\n\n  // Bar geometry: scale 0..max of this cluster's own observed window.\n  const span = Math.max(d.max - d.min, 1);\n  const avgPct = ((d.avg - d.min) / span) * 100;\n  const userPctRaw = ((cm - d.min) / span) * 100;\n  const userPct = Math.max(0, Math.min(100, userPctRaw));\n  const userInBar = cm >= d.min && cm <= d.max;\n\n  const stateBadge = within\n    ? '<span class=\"badge-in text-[10px] font-bold rounded-full px-2 py-0.5\">In range</span>'\n    : '<span class=\"badge-out text-[10px] font-bold rounded-full px-2 py-0.5\">Outside range</span>';\n  const bestTag = opts.isBest\n    ? '<span class=\"badge-best text-[10px] font-bold rounded-full px-2 py-0.5\">Most likely</span>'\n    : '';\n\n  const userMarker = userInBar\n    ? `<div class=\"marker absolute top-1/2 -translate-y-1/2 w-0.5 h-7 bg-indigo-700 rounded\" style=\"left:calc(${userPct}% - 1px)\" title=\"Your value\"></div>`\n    : '';\n\n  return `\n    <div class=\"cluster-card rounded-xl border ${opts.isBest ? 'border-indigo-300 bg-indigo-50/40 shadow-sm' : 'border-gray-200 bg-white'} p-4\">\n      <div class=\"flex flex-wrap items-center gap-2 mb-2\">\n        ${bestTag}${stateBadge}\n        <span class=\"ml-auto text-xs text-gray-400\">avg <strong class=\"text-gray-600\">${fmt(d.avg)}</strong> cM · range <strong class=\"text-gray-600\">${fmt(d.min)}–${fmt(d.max)}</strong></span>\n      </div>\n      <div class=\"flex flex-wrap gap-1.5 mb-3\">${chips}</div>\n      <div class=\"relative h-5 rounded-full bg-gradient-to-r from-indigo-100 via-indigo-200 to-indigo-100 overflow-visible\">\n        <div class=\"absolute top-1/2 -translate-y-1/2 -translate-x-1/2 w-2.5 h-2.5 rounded-full bg-indigo-500 ring-2 ring-white\" style=\"left:${avgPct}%\" title=\"Average\"></div>\n        ${userMarker}\n      </div>\n      <div class=\"flex justify-between text-[10px] text-gray-400 mt-1\">\n        <span>${fmt(d.min)}</span>\n        <span>avg ${fmt(d.avg)}</span>\n        <span>${fmt(d.max)}</span>\n      </div>\n      ${!userInBar ? `<p class=\"text-[11px] text-amber-700 mt-1\">Your ${fmt(cm)} cM falls ${cm < d.min ? 'below' : 'above'} this cluster's observed window.</p>` : ''}\n    </div>`;\n}\n\n// ─── Main update ──────────────────────────────────────────────────────────────\nfunction update() {\n  let cm = parseFloat(cmInput.value);\n\n  // Validation\n  if (isNaN(cm)) {\n    errText.textContent = 'Enter a total shared cM value between 0 and 3700.';\n    errBanner.classList.remove('hidden');\n    resultsSection.classList.add('opacity-30', 'pointer-events-none');\n    return;\n  }\n  if (cm < 0) cm = 0;\n  if (cm > 3700) cm = 3700;\n  errBanner.classList.add('hidden');\n  resultsSection.classList.remove('opacity-30', 'pointer-events-none');\n\n  // Clusters whose observed range contains the value.\n  const inRange = DATA.filter(d => cm >= d.min && cm <= d.max)\n                      .sort((a, b) => Math.abs(a.avg - cm) - Math.abs(b.avg - cm));\n\n  let best, bestIsOutside = false;\n  if (inRange.length > 0) {\n    best = inRange[0];\n  } else {\n    // Nothing contains it — nearest by distance to range.\n    bestIsOutside = true;\n    best = DATA.slice().sort((a, b) => {\n      const da = cm < a.min ? a.min - cm : cm - a.max;\n      const db = cm < b.min ? b.min - cm : cm - b.max;\n      return da - db;\n    })[0];\n  }\n\n  // Headline\n  if (bestIsOutside) {\n    bestLabel.textContent = best.label;\n    bestSub.textContent = `Your ${fmt(cm)} cM is outside every observed range. This is the closest published cluster (average ${fmt(best.avg)} cM, range ${fmt(best.min)}–${fmt(best.max)}).`;\n    bestBadge.className = 'flex-shrink-0 px-5 py-3 rounded-xl font-bold text-sm text-center min-w-[150px] badge-out';\n    bestBadge.textContent = 'Outside observed ranges — closest match';\n  } else {\n    bestLabel.textContent = best.label;\n    const others = inRange.length - 1;\n    bestSub.textContent = `Your ${fmt(cm)} cM sits closest to this cluster's average of ${fmt(best.avg)} cM`\n      + (others > 0 ? `, but ${others} other cluster${others > 1 ? 's' : ''} also statistically fit.` : '. No other cluster fits this value.');\n    bestBadge.className = 'flex-shrink-0 px-5 py-3 rounded-xl font-bold text-sm text-center min-w-[150px] badge-best';\n    bestBadge.textContent = 'Best statistical fit';\n  }\n\n  // Zero note\n  if (cm === 0) zeroNote.classList.remove('hidden');\n  else zeroNote.classList.add('hidden');\n\n  // Cards: in-range clusters (closest avg first). If none, show the closest cluster.\n  const cards = bestIsOutside ? [best] : inRange;\n  clusterCount.textContent = bestIsOutside\n    ? 'no exact matches'\n    : `${cards.length} cluster${cards.length > 1 ? 's' : ''} fit`;\n\n  clusterList.innerHTML = cards\n    .map((d, i) => renderCard(d, cm, { isBest: d === best }))\n    .join('');\n\n  // Persist\n  try {\n    localStorage.setItem('sharedcm', JSON.stringify({ cm: cmInput.value, seg: segInput.value }));\n  } catch (e) { /* ignore */ }\n}\n\n// ─── Sync input + slider ──────────────────────────────────────────────────────\nfunction syncFromInput() {\n  let v = parseFloat(cmInput.value);\n  if (!isNaN(v)) {\n    if (v < 0) v = 0; if (v > 3700) v = 3700;\n    cmSlider.value = v;\n  }\n  update();\n}\nfunction syncFromSlider() {\n  cmInput.value = cmSlider.value;\n  update();\n}\n\ncmInput.addEventListener('input', syncFromInput);\ncmSlider.addEventListener('input', syncFromSlider);\nsegInput.addEventListener('input', update);\n\n// ─── Restore / init ───────────────────────────────────────────────────────────\n(function restoreOrInit() {\n  try {\n    const saved = JSON.parse(localStorage.getItem('sharedcm'));\n    if (saved) {\n      if (saved.cm !== undefined && saved.cm !== '') { cmInput.value = saved.cm; cmSlider.value = saved.cm; }\n      if (saved.seg !== undefined) segInput.value = saved.seg;\n    }\n  } catch (e) { /* ignore */ }\n  update();\n})();\n</script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Shared cM Relationship Predictor",
    "windowTitle": "Shared cM Relationship Predictor",
    "bundleId": "com.halisonworks.sharedcmpredictor",
    "iconPath": null
  },
  "categoryId": null,
  "source": "import",
  "createdAt": "2026-06-02T12:00:00.000Z",
  "updatedAt": "2026-06-02T12:00:00.000Z",
  "sharedAt": "2026-06-02T12:00:00.000Z"
}
