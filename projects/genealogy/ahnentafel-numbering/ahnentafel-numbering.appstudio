{
  "schema": "app-studio/canvas@1",
  "id": "example-ahnentafel-numbering",
  "name": "ahnentafel-numbering.html",
  "code": "<!DOCTYPE html>\n<!--\n  Ahnentafel Number Tool — Halison App Studio example\n\n  Decode a Sosa-Stradonitz ahnentafel number into the exact ancestral path (and back), and generate a numbered ancestor chart.\n\n  From the Halison App Studio public library:\n  https://github.com/halisonworks/public-app-studio\n\n  Permitted use: personal, educational, and other non-commercial use. You may\n  modify it, but keep this header and the source link intact, and do not sell,\n  commercialize, or republish it. Released under the Halison App Studio Examples\n  License — see the LICENSE file in the repository above.\n-->\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Ahnentafel Number Tool</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Inter', 'Segoe UI', sans-serif; }\n    input[type=number]::-webkit-inner-spin-button,\n    input[type=number]::-webkit-outer-spin-button { opacity: 1; }\n    .fade-in { animation: fadeIn 0.4s ease; }\n    @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }\n    .bit-lead { background: #4338ca; color: #fff; }\n    .bit-f { background: #dbeafe; color: #1e40af; border: 1px solid #93c5fd; }\n    .bit-m { background: #fce7f3; color: #9d174b; border: 1px solid #f9a8d4; }\n    .bit-cell { display: inline-flex; flex-direction: column; align-items: center; gap: 2px;\n      padding: 6px 9px; border-radius: 8px; font-family: 'Menlo', ui-monospace, monospace;\n      font-weight: 700; font-size: 15px; min-width: 30px; }\n    .bit-cell small { font-size: 9px; font-weight: 600; opacity: 0.85; }\n    .path-link { background: #eef2ff; color: #4338ca; padding: 2px 8px; border-radius: 6px; font-weight: 600; }\n    .sex-m { color: #2563eb; }\n    .sex-f { color: #db2777; }\n    .gen-row:nth-child(even) { background: #fafafa; }\n    .chart-num { font-variant-numeric: tabular-nums; }\n  </style>\n</head>\n<body class=\"bg-gray-50 min-h-screen\">\n\n  <!-- Header -->\n  <header class=\"bg-white border-b border-gray-200 sticky top-0 z-30 shadow-sm\">\n    <div class=\"max-w-4xl mx-auto px-4 py-4 flex items-center gap-3\">\n      <div class=\"w-9 h-9 rounded-lg bg-indigo-600 flex items-center justify-center flex-shrink-0\">\n        <svg class=\"w-5 h-5 text-white\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\">\n          <circle cx=\"12\" cy=\"5\" r=\"2.2\" />\n          <circle cx=\"6\" cy=\"18\" r=\"2.2\" />\n          <circle cx=\"18\" cy=\"18\" r=\"2.2\" />\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 7.2v3.3M12 10.5H6v5.3M12 10.5h6v5.3\" />\n        </svg>\n      </div>\n      <div>\n        <h1 class=\"text-lg font-bold text-gray-900 leading-tight\">Ahnentafel Number Tool</h1>\n        <p class=\"text-xs text-gray-500\">Sosa-Stradonitz ancestor numbering — decode, encode &amp; chart</p>\n      </div>\n    </div>\n  </header>\n\n  <main class=\"max-w-4xl mx-auto px-4 py-8 space-y-6\">\n\n    <!-- ───────────── DECODE ───────────── -->\n    <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n      <div class=\"flex items-center gap-2 mb-5\">\n        <span class=\"w-6 h-6 rounded-md bg-indigo-100 text-indigo-700 flex items-center justify-center text-xs font-bold\">1</span>\n        <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider\">Decode a number</h2>\n      </div>\n\n      <div class=\"grid grid-cols-1 sm:grid-cols-[1fr_auto] gap-4 items-end\">\n        <div>\n          <label class=\"block text-xs font-medium text-gray-500 mb-1\">Ahnentafel number</label>\n          <input id=\"decodeInput\" type=\"text\" inputmode=\"numeric\" value=\"11\"\n            class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-800 text-lg font-semibold focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent\"\n            placeholder=\"e.g. 11\" />\n        </div>\n        <div class=\"flex flex-wrap gap-2\">\n          <button data-decode=\"1\" class=\"quick-btn text-xs px-3 py-2 rounded-lg bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium\">1</button>\n          <button data-decode=\"4\" class=\"quick-btn text-xs px-3 py-2 rounded-lg bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium\">4</button>\n          <button data-decode=\"11\" class=\"quick-btn text-xs px-3 py-2 rounded-lg bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium\">11</button>\n          <button data-decode=\"22\" class=\"quick-btn text-xs px-3 py-2 rounded-lg bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium\">22</button>\n          <button data-decode=\"1024\" class=\"quick-btn text-xs px-3 py-2 rounded-lg bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium\">1024</button>\n        </div>\n      </div>\n\n      <!-- Decode error -->\n      <div id=\"decodeError\" class=\"hidden mt-4 bg-red-50 border border-red-200 rounded-xl px-5 py-3 text-red-700 text-sm flex items-center gap-2\">\n        <svg class=\"w-4 h-4 flex-shrink-0\" fill=\"currentColor\" viewBox=\"0 0 20 20\"><path fill-rule=\"evenodd\" d=\"M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z\" clip-rule=\"evenodd\"/></svg>\n        <span id=\"decodeErrorText\"></span>\n      </div>\n\n      <!-- Decode results -->\n      <div id=\"decodeResults\" class=\"mt-6 space-y-5 fade-in\">\n\n        <!-- Headline relationship -->\n        <div class=\"rounded-xl bg-indigo-50 border border-indigo-100 p-5\">\n          <div class=\"text-xs text-indigo-500 font-semibold uppercase tracking-wider mb-1\">Person #<span id=\"dNum\">11</span></div>\n          <p id=\"dRelationship\" class=\"text-2xl font-bold text-gray-900 capitalize\"></p>\n          <p id=\"dChain\" class=\"text-sm text-gray-600 mt-1\"></p>\n        </div>\n\n        <!-- Facts grid -->\n        <div class=\"grid grid-cols-2 md:grid-cols-4 gap-4\">\n          <div class=\"bg-white rounded-xl border border-gray-200 p-4 shadow-sm\">\n            <div class=\"text-xs text-gray-500 font-medium mb-1\">Generation</div>\n            <div id=\"dGen\" class=\"text-2xl font-bold text-gray-800\">—</div>\n            <div id=\"dGenLabel\" class=\"text-xs text-gray-400 mt-0.5\">—</div>\n          </div>\n          <div class=\"bg-white rounded-xl border border-gray-200 p-4 shadow-sm\">\n            <div class=\"text-xs text-gray-500 font-medium mb-1\">Sex</div>\n            <div id=\"dSex\" class=\"text-2xl font-bold text-gray-800\">—</div>\n            <div class=\"text-xs text-gray-400 mt-0.5\">even = male, odd = female</div>\n          </div>\n          <div class=\"bg-white rounded-xl border border-gray-200 p-4 shadow-sm\">\n            <div class=\"text-xs text-gray-500 font-medium mb-1\">Father (2n)</div>\n            <div id=\"dFather\" class=\"text-2xl font-bold text-gray-800\">—</div>\n            <div class=\"text-xs text-gray-400 mt-0.5\">this person's father</div>\n          </div>\n          <div class=\"bg-white rounded-xl border border-gray-200 p-4 shadow-sm\">\n            <div class=\"text-xs text-gray-500 font-medium mb-1\">Mother (2n+1)</div>\n            <div id=\"dMother\" class=\"text-2xl font-bold text-gray-800\">—</div>\n            <div class=\"text-xs text-gray-400 mt-0.5\">this person's mother</div>\n          </div>\n        </div>\n\n        <!-- Binary breakdown -->\n        <div class=\"bg-gray-50 rounded-xl border border-gray-200 p-5\">\n          <div class=\"text-xs text-gray-500 font-semibold uppercase tracking-wider mb-3\">Binary path</div>\n          <div id=\"dBinary\" class=\"flex flex-wrap items-center gap-2\"></div>\n          <p class=\"text-xs text-gray-500 mt-3 leading-relaxed\">\n            The leading <span class=\"font-semibold text-indigo-700\">1</span> is the subject. Each remaining bit is a step away from you:\n            <span class=\"font-semibold sex-m\">0 = father</span>, <span class=\"font-semibold sex-f\">1 = mother</span>, read left to right.\n          </p>\n        </div>\n      </div>\n    </section>\n\n    <!-- ───────────── ENCODE ───────────── -->\n    <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n      <div class=\"flex items-center gap-2 mb-5\">\n        <span class=\"w-6 h-6 rounded-md bg-indigo-100 text-indigo-700 flex items-center justify-center text-xs font-bold\">2</span>\n        <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider\">Build a path → get the number</h2>\n      </div>\n\n      <div class=\"flex flex-wrap gap-2 mb-5\">\n        <button id=\"encFather\" class=\"flex-1 min-w-[120px] px-4 py-2.5 rounded-lg bg-blue-50 hover:bg-blue-100 text-blue-700 font-semibold text-sm border border-blue-200 transition\">\n          + Father <span class=\"text-xs font-normal text-blue-400\">(×2)</span>\n        </button>\n        <button id=\"encMother\" class=\"flex-1 min-w-[120px] px-4 py-2.5 rounded-lg bg-pink-50 hover:bg-pink-100 text-pink-700 font-semibold text-sm border border-pink-200 transition\">\n          + Mother <span class=\"text-xs font-normal text-pink-400\">(×2+1)</span>\n        </button>\n        <button id=\"encUndo\" class=\"px-4 py-2.5 rounded-lg bg-gray-100 hover:bg-gray-200 text-gray-600 font-semibold text-sm border border-gray-200 transition\">Undo</button>\n        <button id=\"encReset\" class=\"px-4 py-2.5 rounded-lg bg-gray-100 hover:bg-gray-200 text-gray-600 font-semibold text-sm border border-gray-200 transition\">Reset</button>\n      </div>\n\n      <div class=\"rounded-xl border border-gray-200 p-5 bg-gray-50 mb-4\">\n        <div class=\"text-xs text-gray-500 font-semibold uppercase tracking-wider mb-2\">Path from subject</div>\n        <div id=\"encChain\" class=\"flex flex-wrap items-center gap-1.5 text-sm\"></div>\n      </div>\n\n      <div class=\"grid grid-cols-3 gap-4\">\n        <div class=\"bg-white rounded-xl border border-gray-200 p-4 shadow-sm text-center\">\n          <div class=\"text-xs text-gray-500 font-medium mb-1\">Ahnentafel #</div>\n          <div id=\"encNum\" class=\"text-3xl font-bold text-indigo-700\">1</div>\n        </div>\n        <div class=\"bg-white rounded-xl border border-gray-200 p-4 shadow-sm text-center\">\n          <div class=\"text-xs text-gray-500 font-medium mb-1\">Generation</div>\n          <div id=\"encGen\" class=\"text-3xl font-bold text-gray-800\">1</div>\n        </div>\n        <div class=\"bg-white rounded-xl border border-gray-200 p-4 shadow-sm text-center\">\n          <div class=\"text-xs text-gray-500 font-medium mb-1\">Sex</div>\n          <div id=\"encSex\" class=\"text-3xl font-bold text-gray-800\">—</div>\n        </div>\n      </div>\n    </section>\n\n    <!-- ───────────── CHART ───────────── -->\n    <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n      <div class=\"flex items-center justify-between flex-wrap gap-3 mb-5\">\n        <div class=\"flex items-center gap-2\">\n          <span class=\"w-6 h-6 rounded-md bg-indigo-100 text-indigo-700 flex items-center justify-center text-xs font-bold\">3</span>\n          <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider\">Ancestor chart</h2>\n        </div>\n        <div class=\"flex items-center gap-2\">\n          <label class=\"text-xs text-gray-500 font-medium\">Generations</label>\n          <input id=\"chartGens\" type=\"number\" min=\"1\" max=\"8\" value=\"4\"\n            class=\"w-20 border border-gray-300 rounded-md px-2 py-1.5 text-sm text-gray-700 text-center focus:outline-none focus:ring-2 focus:ring-indigo-400\" />\n        </div>\n      </div>\n      <div id=\"chartBody\" class=\"space-y-6\"></div>\n    </section>\n\n    <!-- ───────────── ABOUT ───────────── -->\n    <section class=\"bg-gray-50 rounded-2xl border border-gray-200 p-6\">\n      <h2 class=\"text-sm font-semibold text-gray-700 uppercase tracking-wider mb-3\">About — how ahnentafel numbering works</h2>\n      <div class=\"text-sm text-gray-600 leading-relaxed space-y-3\">\n        <p>\n          An <strong>ahnentafel</strong> (German for \"ancestor table\"), also called the\n          <strong>Sosa-Stradonitz system</strong>, assigns a single number to every ancestor of one starting person.\n        </p>\n        <ul class=\"list-disc pl-5 space-y-1.5\">\n          <li><strong>#1 is the subject</strong> — the person whose ancestry is being charted (the <em>de cujus</em>).</li>\n          <li>A person numbered <strong>n</strong> has <strong>father 2n</strong> and <strong>mother 2n+1</strong>.</li>\n          <li>Every man is <strong>even</strong> and every woman is <strong>odd</strong> — the only exception is #1, who may be either.</li>\n          <li>The generation is <code class=\"bg-white px-1 py-0.5 rounded border border-gray-200\">floor(log₂(n)) + 1</code>: #1 is gen 1, #2–3 are gen 2, #4–7 are gen 3, and so on.</li>\n          <li>Write <strong>n</strong> in binary and drop the leading 1; the remaining bits spell the path from the subject, where <span class=\"font-semibold sex-m\">0 = father</span> and <span class=\"font-semibold sex-f\">1 = mother</span>, read left to right.</li>\n        </ul>\n        <p class=\"text-xs text-gray-500\">\n          Example: 11 in binary is <code class=\"bg-white px-1 py-0.5 rounded border border-gray-200\">1011</code>. Drop the leading 1 to get\n          <code class=\"bg-white px-1 py-0.5 rounded border border-gray-200\">011</code> → father, mother, mother → \"your father's mother's mother\", i.e. a maternal great-grandmother on the paternal side.\n        </p>\n      </div>\n    </section>\n\n  </main>\n\n  <footer class=\"max-w-4xl mx-auto px-4 py-6 text-center text-xs text-gray-400\">\n    Ahnentafel Number Tool &mdash; <a href=\"https://github.com/halisonworks/public-app-studio\" class=\"underline hover:text-indigo-500\" target=\"_blank\" rel=\"noopener\">Halison App Studio</a>\n  </footer>\n\n<script>\n// ─── Core ahnentafel logic ──────────────────────────────────────────────────\n\n// Generation: #1 -> 1, #2-3 -> 2, #4-7 -> 3, ...\nfunction generation(n){ return Math.floor(Math.log2(n)) + 1; } // n>=1\n\n// Path bits: binary of n without the leading '1'. 0 -> father, 1 -> mother.\nfunction pathBits(n){\n  return n <= 1 ? [] : n.toString(2).slice(1).split('').map(b => b === '0' ? 'father' : 'mother');\n}\n\n// Chain text from the subject, e.g. ['father','mother','father'] -> \"father's mother's father\"\nfunction chainText(bits){\n  if (bits.length === 0) return 'the subject (you)';\n  return bits.map((b, i) => i < bits.length - 1 ? b + \"'s\" : b).join(' ');\n}\n\n// grandTerm(gen) with sex: gen2 -> father/mother; gen3 -> grandfather/grandmother;\n// gen>=4 -> ('great-' * (gen-3)) + grandfather/grandmother.\nfunction grandTerm(gen, isMale){\n  if (gen <= 1) return 'the subject';\n  if (gen === 2) return isMale ? 'father' : 'mother';\n  var base = isMale ? 'grandfather' : 'grandmother';\n  if (gen === 3) return base;\n  return 'great-'.repeat(gen - 3) + base;\n}\n\n// Relationship label for n>=2, optionally with a paternal/maternal qualifier\n// derived from the first path bit (father side / mother side).\nfunction relationshipLabel(n){\n  if (n === 1) return 'the subject';\n  var gen = generation(n);\n  var isMale = (n % 2 === 0);\n  var term = grandTerm(gen, isMale);\n  if (gen === 2) return term;                 // father / mother\n  var bits = pathBits(n);\n  var side = bits[0] === 'father' ? 'paternal ' : 'maternal ';\n  return side + term;\n}\n\n// ─── Helpers ────────────────────────────────────────────────────────────────\n\nfunction isMaleNum(n){ return n === 1 ? null : (n % 2 === 0); }\nfunction fmt(n){ return n.toLocaleString('en-US'); }\n\n// MAX number we treat as exact (Number safe range). 2^53.\nvar MAX_SAFE = 9007199254740991;\n\n// ─── DECODE ─────────────────────────────────────────────────────────────────\n\nvar decodeInput = document.getElementById('decodeInput');\nvar decodeError = document.getElementById('decodeError');\nvar decodeErrorText = document.getElementById('decodeErrorText');\nvar decodeResults = document.getElementById('decodeResults');\n\nfunction showDecodeError(msg){\n  decodeErrorText.textContent = msg;\n  decodeError.classList.remove('hidden');\n  decodeResults.classList.add('opacity-30', 'pointer-events-none');\n}\n\nfunction decode(){\n  var raw = (decodeInput.value || '').trim().replace(/[\\s,]/g, '');\n  if (raw === ''){ showDecodeError('Enter an ahnentafel number (1 or greater).'); return; }\n  if (!/^\\d+$/.test(raw)){ showDecodeError('Use whole numbers only — no letters or symbols.'); return; }\n  var n = Number(raw);\n  if (n < 1){ showDecodeError('Ahnentafel numbers start at 1 (the subject).'); return; }\n  if (n > MAX_SAFE){ showDecodeError('That number is too large to compute exactly (max ' + fmt(MAX_SAFE) + ', ~53 generations).'); return; }\n\n  decodeError.classList.add('hidden');\n  decodeResults.classList.remove('opacity-30', 'pointer-events-none');\n\n  var gen = generation(n);\n  var bits = pathBits(n);\n  var male = isMaleNum(n);\n\n  document.getElementById('dNum').textContent = fmt(n);\n\n  // Relationship headline\n  var rel = relationshipLabel(n);\n  document.getElementById('dRelationship').textContent = rel;\n\n  // Chain\n  var chainEl = document.getElementById('dChain');\n  if (n === 1){\n    chainEl.textContent = 'This is you — the starting point of the chart.';\n  } else {\n    chainEl.innerHTML = 'Path from you: <span class=\"path-link\">your ' + chainText(bits) + '</span>';\n  }\n\n  // Generation label\n  var genLabels = { 1: 'the subject', 2: 'parents', 3: 'grandparents', 4: 'great-grandparents' };\n  var genLabel;\n  if (genLabels[gen]) genLabel = genLabels[gen];\n  else genLabel = 'great-'.repeat(gen - 3) + 'grandparents';\n  document.getElementById('dGen').textContent = gen;\n  document.getElementById('dGenLabel').textContent = genLabel;\n\n  // Sex\n  var sexEl = document.getElementById('dSex');\n  if (male === null){ sexEl.textContent = '—'; sexEl.className = 'text-2xl font-bold text-gray-800'; }\n  else if (male){ sexEl.textContent = 'Male'; sexEl.className = 'text-2xl font-bold sex-m'; }\n  else { sexEl.textContent = 'Female'; sexEl.className = 'text-2xl font-bold sex-f'; }\n\n  // Parents\n  var fatherN = 2 * n;\n  var motherN = 2 * n + 1;\n  if (fatherN > MAX_SAFE){\n    document.getElementById('dFather').textContent = '∞';\n    document.getElementById('dMother').textContent = '∞';\n  } else {\n    document.getElementById('dFather').textContent = fmt(fatherN);\n    document.getElementById('dMother').textContent = fmt(motherN);\n  }\n\n  // Binary breakdown\n  var binStr = n.toString(2);\n  var binEl = document.getElementById('dBinary');\n  binEl.innerHTML = '';\n  for (var i = 0; i < binStr.length; i++){\n    var cell = document.createElement('span');\n    cell.className = 'bit-cell';\n    var digit = binStr[i];\n    var top = document.createElement('span');\n    top.textContent = digit;\n    var label = document.createElement('small');\n    if (i === 0){ cell.classList.add('bit-lead'); label.textContent = 'you'; }\n    else if (digit === '0'){ cell.classList.add('bit-f'); label.textContent = 'father'; }\n    else { cell.classList.add('bit-m'); label.textContent = 'mother'; }\n    cell.appendChild(top);\n    cell.appendChild(label);\n    binEl.appendChild(cell);\n  }\n\n  saveState();\n}\n\ndecodeInput.addEventListener('input', decode);\ndocument.querySelectorAll('.quick-btn').forEach(function(btn){\n  btn.addEventListener('click', function(){\n    decodeInput.value = btn.getAttribute('data-decode');\n    decode();\n  });\n});\n\n// ─── ENCODE ─────────────────────────────────────────────────────────────────\n\nvar encSteps = []; // array of 'father' | 'mother'\n\nfunction encNumber(){\n  var n = 1;\n  for (var i = 0; i < encSteps.length; i++){\n    n = encSteps[i] === 'father' ? 2 * n : 2 * n + 1;\n  }\n  return n;\n}\n\nfunction renderEncode(){\n  var n = encNumber();\n  var gen = generation(n);\n  var male = isMaleNum(n);\n\n  document.getElementById('encNum').textContent = fmt(n);\n  document.getElementById('encGen').textContent = gen;\n\n  var sexEl = document.getElementById('encSex');\n  if (male === null){ sexEl.textContent = '—'; sexEl.className = 'text-3xl font-bold text-gray-800'; }\n  else if (male){ sexEl.textContent = 'M'; sexEl.className = 'text-3xl font-bold sex-m'; }\n  else { sexEl.textContent = 'F'; sexEl.className = 'text-3xl font-bold sex-f'; }\n\n  // Chain\n  var chainEl = document.getElementById('encChain');\n  chainEl.innerHTML = '';\n  var subj = document.createElement('span');\n  subj.className = 'path-link';\n  subj.textContent = 'Subject';\n  chainEl.appendChild(subj);\n  for (var i = 0; i < encSteps.length; i++){\n    var arrow = document.createElement('span');\n    arrow.className = 'text-gray-300';\n    arrow.textContent = '→';\n    chainEl.appendChild(arrow);\n    var step = document.createElement('span');\n    step.className = encSteps[i] === 'father' ? 'path-link sex-m' : 'path-link sex-f';\n    step.style.background = encSteps[i] === 'father' ? '#dbeafe' : '#fce7f3';\n    step.textContent = encSteps[i] === 'father' ? 'Father' : 'Mother';\n    chainEl.appendChild(step);\n  }\n  if (encSteps.length === 0){\n    var hint = document.createElement('span');\n    hint.className = 'text-gray-400 text-xs ml-1';\n    hint.textContent = '(click Father / Mother to build a path)';\n    chainEl.appendChild(hint);\n  }\n\n  // Disable add buttons if next step would exceed safe range\n  var atLimit = (2 * n + 1) > MAX_SAFE;\n  document.getElementById('encFather').disabled = atLimit;\n  document.getElementById('encMother').disabled = atLimit;\n  document.getElementById('encFather').classList.toggle('opacity-40', atLimit);\n  document.getElementById('encMother').classList.toggle('opacity-40', atLimit);\n\n  saveState();\n}\n\ndocument.getElementById('encFather').addEventListener('click', function(){ encSteps.push('father'); renderEncode(); });\ndocument.getElementById('encMother').addEventListener('click', function(){ encSteps.push('mother'); renderEncode(); });\ndocument.getElementById('encUndo').addEventListener('click', function(){ encSteps.pop(); renderEncode(); });\ndocument.getElementById('encReset').addEventListener('click', function(){ encSteps = []; renderEncode(); });\n\n// ─── CHART ──────────────────────────────────────────────────────────────────\n\nvar chartGens = document.getElementById('chartGens');\nvar chartBody = document.getElementById('chartBody');\n\nfunction renderChart(){\n  var g = parseInt(chartGens.value, 10);\n  if (isNaN(g) || g < 1) g = 1;\n  if (g > 8) g = 8;\n\n  chartBody.innerHTML = '';\n\n  var genLabels = { 1: 'Subject', 2: 'Parents', 3: 'Grandparents', 4: 'Great-grandparents' };\n\n  for (var gen = 1; gen <= g; gen++){\n    var start = Math.pow(2, gen - 1);\n    var end = Math.pow(2, gen) - 1;\n\n    var wrap = document.createElement('div');\n\n    var head = document.createElement('div');\n    head.className = 'flex items-baseline gap-2 mb-2';\n    var hLabel = genLabels[gen] || ('great-'.repeat(gen - 3) + 'grandparents');\n    head.innerHTML = '<span class=\"text-sm font-bold text-gray-800 capitalize\">Generation ' + gen + ' — ' + hLabel + '</span>' +\n      '<span class=\"text-xs text-gray-400\">#' + fmt(start) + (start === end ? '' : '–' + fmt(end)) + '</span>';\n    wrap.appendChild(head);\n\n    var list = document.createElement('div');\n    list.className = 'rounded-xl border border-gray-200 overflow-hidden';\n\n    for (var num = start; num <= end; num++){\n      var row = document.createElement('div');\n      row.className = 'gen-row flex items-center gap-3 px-4 py-2 border-b border-gray-100 last:border-b-0';\n\n      var male = isMaleNum(num);\n      var numBadgeClass = 'bg-gray-100 text-gray-600';\n      if (male === true) numBadgeClass = 'bg-blue-50 text-blue-700';\n      else if (male === false) numBadgeClass = 'bg-pink-50 text-pink-700';\n\n      var rel = relationshipLabel(num);\n      var bits = pathBits(num);\n      var chain = num === 1 ? 'you' : 'your ' + chainText(bits);\n\n      row.innerHTML =\n        '<span class=\"chart-num inline-flex items-center justify-center min-w-[2.5rem] px-2 py-1 rounded-md text-sm font-bold ' + numBadgeClass + '\">' + fmt(num) + '</span>' +\n        '<span class=\"flex-1 min-w-0\">' +\n          '<span class=\"text-sm font-semibold text-gray-800 capitalize\">' + rel + '</span>' +\n          '<span class=\"block text-xs text-gray-400 truncate\">' + chain + '</span>' +\n        '</span>';\n      list.appendChild(row);\n    }\n\n    wrap.appendChild(list);\n    chartBody.appendChild(wrap);\n  }\n\n  saveState();\n}\n\nchartGens.addEventListener('input', renderChart);\n\n// ─── Persistence ────────────────────────────────────────────────────────────\n\nfunction saveState(){\n  try {\n    localStorage.setItem('ahnentafel', JSON.stringify({\n      decode: decodeInput.value,\n      encSteps: encSteps,\n      chartGens: chartGens.value\n    }));\n  } catch(e){ /* ignore */ }\n}\n\n(function restoreOrInit(){\n  try {\n    var saved = JSON.parse(localStorage.getItem('ahnentafel'));\n    if (saved){\n      if (typeof saved.decode === 'string' && saved.decode !== '') decodeInput.value = saved.decode;\n      if (Array.isArray(saved.encSteps)) encSteps = saved.encSteps.filter(function(s){ return s === 'father' || s === 'mother'; });\n      if (saved.chartGens) chartGens.value = saved.chartGens;\n    }\n  } catch(e){ /* ignore */ }\n  decode();\n  renderEncode();\n  renderChart();\n})();\n</script>\n</body>\n</html>\n",
