{
  "schema": "app-studio/canvas@1",
  "id": "example-relationship-calculator",
  "name": "relationship-calculator.html",
  "code": "<!DOCTYPE html>\n<!--\n  Relationship Calculator — Halison App Studio example\n\n  Work out how two relatives are related (e.g. \"second cousins once removed\") from how many generations each is below their common ancestor.\n\n  From the Halison App Studio public library:\n  https://github.com/halisonworks/public-app-studio\n\n  Permitted use: personal, educational, and other non-commercial use. You may\n  modify it, but keep this header and the source link intact, and do not sell,\n  commercialize, or republish it. Released under the Halison App Studio Examples\n  License — see the LICENSE file in the repository above.\n-->\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Relationship Calculator</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Inter', 'Segoe UI', sans-serif; }\n    input[type=number]::-webkit-inner-spin-button,\n    input[type=number]::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }\n    input[type=number] { -moz-appearance: textfield; }\n    .fade-in { animation: fadeIn 0.4s ease; }\n    @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }\n    .tooltip { position: relative; }\n    .tooltip:hover .tooltip-text { display: block; }\n    .tooltip-text { display: none; position: absolute; bottom: 125%; left: 50%; transform: translateX(-50%);\n      background: #1e293b; color: #f8fafc; font-size: 11px; padding: 5px 9px; border-radius: 5px;\n      width: max-content; max-width: 220px; white-space: normal; z-index: 50; pointer-events: none;\n      font-weight: 400; line-height: 1.35; text-align: center; }\n    .tooltip-text::after { content: ''; position: absolute; top: 100%; left: 50%; transform: translateX(-50%);\n      border: 5px solid transparent; border-top-color: #1e293b; }\n    .ladder-node { transition: all 0.3s ease; }\n  </style>\n</head>\n<body class=\"bg-gray-50 min-h-screen\">\n\n  <!-- Header -->\n  <header class=\"bg-white border-b border-gray-200 sticky top-0 z-30 shadow-sm\">\n    <div class=\"max-w-4xl mx-auto px-4 py-4 flex items-center gap-3\">\n      <div class=\"w-9 h-9 rounded-lg bg-indigo-600 flex items-center justify-center flex-shrink-0\">\n        <svg class=\"w-5 h-5 text-white\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\">\n          <circle cx=\"12\" cy=\"5\" r=\"2.2\" />\n          <circle cx=\"6\" cy=\"18\" r=\"2.2\" />\n          <circle cx=\"18\" cy=\"18\" r=\"2.2\" />\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 7.2v3.3M12 10.5L6 15.8M12 10.5l6 5.3\" />\n        </svg>\n      </div>\n      <div>\n        <h1 class=\"text-lg font-bold text-gray-900 leading-tight\">Relationship Calculator</h1>\n        <p class=\"text-xs text-gray-500\">Name the family tie between two relatives from their common ancestor</p>\n      </div>\n    </div>\n  </header>\n\n  <main class=\"max-w-4xl mx-auto px-4 py-8 space-y-6\">\n\n    <!-- Input Section -->\n    <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n      <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider mb-2\">Describe the two people</h2>\n      <p class=\"text-sm text-gray-500 mb-5\">\n        First find the <strong class=\"text-gray-700\">Most Recent Common Ancestor (MRCA)</strong> the two people share.\n        Then count how many generations each person is <em>below</em> that ancestor.\n      </p>\n\n      <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n\n        <!-- Person 1 -->\n        <div class=\"rounded-xl border-2 border-blue-200 p-5 space-y-3\">\n          <div class=\"flex items-center gap-2\">\n            <span class=\"w-7 h-7 rounded-full bg-blue-100 text-blue-700 flex items-center justify-center font-bold text-sm\">1</span>\n            <span class=\"font-semibold text-gray-800\">Person 1</span>\n          </div>\n          <label class=\"block text-xs font-medium text-gray-500 leading-snug\">\n            Generations from the common ancestor down to Person&nbsp;1\n            <span class=\"block text-[11px] text-gray-400 mt-0.5\">0 = Person 1 <em>is</em> the common ancestor · 1 = child · 2 = grandchild · …</span>\n          </label>\n          <div class=\"flex items-center gap-2\">\n            <button type=\"button\" data-step=\"g1\" data-dir=\"-1\" class=\"stepper w-9 h-9 rounded-lg border border-gray-300 text-gray-600 font-bold text-lg flex items-center justify-center hover:bg-gray-100 active:bg-gray-200 select-none\">−</button>\n            <input id=\"g1\" type=\"number\" min=\"0\" max=\"15\" step=\"1\" value=\"2\"\n              class=\"w-full text-center border border-gray-300 rounded-lg px-3 py-2 text-gray-800 text-lg font-bold focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-transparent\" />\n            <button type=\"button\" data-step=\"g1\" data-dir=\"1\" class=\"stepper w-9 h-9 rounded-lg border border-gray-300 text-gray-600 font-bold text-lg flex items-center justify-center hover:bg-gray-100 active:bg-gray-200 select-none\">+</button>\n          </div>\n          <div id=\"g1Label\" class=\"text-xs text-blue-600 font-medium\"></div>\n        </div>\n\n        <!-- Person 2 -->\n        <div class=\"rounded-xl border-2 border-indigo-200 p-5 space-y-3\">\n          <div class=\"flex items-center gap-2\">\n            <span class=\"w-7 h-7 rounded-full bg-indigo-100 text-indigo-700 flex items-center justify-center font-bold text-sm\">2</span>\n            <span class=\"font-semibold text-gray-800\">Person 2</span>\n          </div>\n          <label class=\"block text-xs font-medium text-gray-500 leading-snug\">\n            Generations from the common ancestor down to Person&nbsp;2\n            <span class=\"block text-[11px] text-gray-400 mt-0.5\">0 = Person 2 <em>is</em> the common ancestor · 1 = child · 2 = grandchild · …</span>\n          </label>\n          <div class=\"flex items-center gap-2\">\n            <button type=\"button\" data-step=\"g2\" data-dir=\"-1\" class=\"stepper w-9 h-9 rounded-lg border border-gray-300 text-gray-600 font-bold text-lg flex items-center justify-center hover:bg-gray-100 active:bg-gray-200 select-none\">−</button>\n            <input id=\"g2\" type=\"number\" min=\"0\" max=\"15\" step=\"1\" value=\"2\"\n              class=\"w-full text-center border border-gray-300 rounded-lg px-3 py-2 text-gray-800 text-lg font-bold focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent\" />\n            <button type=\"button\" data-step=\"g2\" data-dir=\"1\" class=\"stepper w-9 h-9 rounded-lg border border-gray-300 text-gray-600 font-bold text-lg flex items-center justify-center hover:bg-gray-100 active:bg-gray-200 select-none\">+</button>\n          </div>\n          <div id=\"g2Label\" class=\"text-xs text-indigo-600 font-medium\"></div>\n        </div>\n\n      </div>\n\n      <!-- Presets -->\n      <div class=\"mt-6\">\n        <div class=\"text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2\">Quick presets</div>\n        <div id=\"presets\" class=\"flex flex-wrap gap-2\"></div>\n      </div>\n    </section>\n\n    <!-- Results Section -->\n    <div id=\"resultsSection\" class=\"space-y-5 fade-in\">\n\n      <!-- Verdict Card -->\n      <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n        <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4\">Relationship</h2>\n        <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n          <div class=\"rounded-xl bg-blue-50 border border-blue-100 px-5 py-4\">\n            <div class=\"text-xs text-blue-600 font-medium mb-1\">Person 2 is Person 1's</div>\n            <div id=\"forwardText\" class=\"text-2xl font-bold text-blue-800 leading-tight\">—</div>\n          </div>\n          <div class=\"rounded-xl bg-indigo-50 border border-indigo-100 px-5 py-4\">\n            <div class=\"text-xs text-indigo-600 font-medium mb-1\">Person 1 is Person 2's</div>\n            <div id=\"reverseText\" class=\"text-2xl font-bold text-indigo-800 leading-tight\">—</div>\n          </div>\n        </div>\n        <p id=\"explainText\" class=\"text-sm text-gray-600 mt-4 leading-relaxed\"></p>\n      </section>\n\n      <!-- Degree of Kinship -->\n      <section class=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n        <div class=\"bg-white rounded-xl border border-gray-200 p-4 shadow-sm\">\n          <div class=\"text-xs text-gray-500 font-medium mb-1 tooltip\">\n            Civil degree of kinship\n            <span class=\"tooltip-text\">Civil (Roman) law: g1 + g2 — count every step up to the common ancestor and back down.</span>\n          </div>\n          <div id=\"civilDegree\" class=\"text-2xl font-bold text-gray-800\">—</div>\n          <div class=\"text-xs text-gray-400 mt-0.5\">g1 + g2 (steps up then down)</div>\n        </div>\n        <div class=\"bg-white rounded-xl border border-gray-200 p-4 shadow-sm\">\n          <div class=\"text-xs text-gray-500 font-medium mb-1 tooltip\">\n            Canon-law degree\n            <span class=\"tooltip-text\">Canon (Church) law: max(g1, g2) — the longer of the two lines down from the common ancestor.</span>\n          </div>\n          <div id=\"canonDegree\" class=\"text-2xl font-bold text-gray-800\">—</div>\n          <div class=\"text-xs text-gray-400 mt-0.5\">max(g1, g2) (longer line)</div>\n        </div>\n        <p class=\"sm:col-span-2 text-xs text-gray-500 leading-relaxed\">\n          Two legal traditions count kinship differently. <strong class=\"text-gray-600\">Civil law</strong> adds both lines together;\n          <strong class=\"text-gray-600\">canon law</strong> takes only the longer line. Both are measured from the most recent common ancestor.\n        </p>\n      </section>\n\n      <!-- Descent Ladder Visual -->\n      <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n        <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider mb-5\">Descent from the common ancestor</h2>\n        <div id=\"ladder\" class=\"flex flex-col items-center\"></div>\n      </section>\n\n    </div>\n\n    <!-- About / How it works -->\n    <section class=\"bg-gray-50 rounded-xl border border-gray-200 px-5 py-4 text-xs text-gray-500 leading-relaxed space-y-2\">\n      <p><strong class=\"text-gray-700\">About / How it works.</strong>\n        Every blood relationship can be described by a single shared ancestor — the\n        <strong class=\"text-gray-600\">Most Recent Common Ancestor (MRCA)</strong>. To use this tool, first identify that ancestor,\n        then count how many generations each person sits below them.</p>\n      <p>From those two counts the relationship follows a simple rule. If one count is 0, the people are in a\n        direct line (parent/child, grandparent/grandchild, …). If both are 1, they are siblings. Otherwise the\n        smaller count sets the <em>cousin degree</em> (first, second, …) and the difference between the counts is\n        how many times they are <em>removed</em>. When the smaller count is 1 you get aunt/uncle and niece/nephew ties.</p>\n      <p>The \"degree of kinship\" is shown two ways: the <strong class=\"text-gray-600\">civil (Roman) degree</strong> counts every\n        step up to the ancestor and back down (g1 + g2), while the <strong class=\"text-gray-600\">canon (Church) degree</strong>\n        counts only the longer line (max of g1, g2).</p>\n    </section>\n\n  </main>\n\n  <footer class=\"max-w-4xl mx-auto px-4 py-6 text-center text-xs text-gray-400\">\n    Relationship Calculator &mdash; <a href=\"https://github.com/halisonworks/public-app-studio\" class=\"underline hover:text-indigo-500\" target=\"_blank\" rel=\"noopener\">Halison App Studio</a>\n  </footer>\n\n<script>\n// ─── Relationship algorithm (transcribed exactly) ───────────────────────────\n\nfunction ordinal(n){ // 1->first, 2->second, ...\n  const names=['zeroth','first','second','third','fourth','fifth','sixth','seventh','eighth','ninth','tenth','eleventh','twelfth','thirteenth','fourteenth','fifteenth'];\n  return names[n] || (n+'th');\n}\nfunction timesRemoved(r){ // r>=0\n  if(r===0) return '';\n  if(r===1) return 'once removed';\n  if(r===2) return 'twice removed';\n  if(r===3) return 'three times removed';\n  return r+' times removed';\n}\n// prefix for \"grand\"/\"great-grand\" chains. levels: 0 -> '', 1 -> 'grand', 2 -> 'great-grand', n -> ('great-'*(n-1))+'grand'\nfunction grandPrefix(levels){\n  if(levels<=0) return '';\n  if(levels===1) return 'grand';\n  return 'great-'.repeat(levels-1)+'grand';\n}\n\n// Returns {forward, reverse, explain} for person2 relative to person1 (forward) and person1 relative to person2 (reverse).\nfunction relationship(g1, g2){\n  if(g1===0 && g2===0) return {forward:'the same person', reverse:'the same person', explain:'Both are the common ancestor.'};\n  // Direct line: one of them IS the common ancestor\n  if(g1===0 || g2===0){\n    const d = Math.max(g1,g2);           // generations apart\n    // ancestor side vs descendant side\n    const ancFirst = (g1===0);           // is Person 1 the ancestor?\n    // ancestor term: d=1 parent, d=2 grandparent, d>=3 great-...-grandparent\n    const ancTerm = (d===1?'parent':(grandPrefix(d-1)+'parent'));\n    const descTerm = (d===1?'child':(grandPrefix(d-1)+'child'));\n    return {\n      forward: ancFirst ? descTerm : ancTerm,   // Person 2 relative to Person 1\n      reverse: ancFirst ? ancTerm : descTerm,\n      explain: 'One is a direct ancestor of the other, '+d+' generation(s) apart.'\n    };\n  }\n  const minG=Math.min(g1,g2), removed=Math.abs(g1-g2);\n  if(minG===1){\n    if(removed===0) return {forward:'sibling', reverse:'sibling', explain:'They share both/one parent — full or half siblings.'};\n    // avuncular. The person CLOSER to the ancestor (smaller g) is the aunt/uncle; the farther one is niece/nephew.\n    // grand level = removed-1: removed=1 -> aunt/uncle ; removed=2 -> grand-aunt/uncle ; removed=3 -> great-grand-aunt/uncle\n    const pre = grandPrefix(removed-1);\n    const auntUncle = (pre?pre+'-':'')+'aunt/uncle';\n    const nieceNephew = (pre?pre+'-':'')+'niece/nephew';\n    const p1IsCloser = g1<g2;\n    return {\n      forward: p1IsCloser ? nieceNephew : auntUncle,  // person2 relative to person1\n      reverse: p1IsCloser ? auntUncle : nieceNephew,\n      explain: 'One is a sibling of the other’s ancestor.'\n    };\n  }\n  // Cousins\n  const degree=minG-1; // 1=first cousin\n  const tr=timesRemoved(removed);\n  const base=ordinal(degree)+' cousin'+(removed>0?' '+tr:'');\n  return {forward:base, reverse:base, explain:'They share a common ancestor through cousin lines.'};\n}\n\n// ─── Helpers for plain-English ancestor description ─────────────────────────\n\n// A person g generations below the ancestor: how the ancestor relates to that person.\n// g=1 -> \"parent\", g=2 -> \"grandparent\", g=3 -> \"great-grandparent\", ...\nfunction ancestorTermFor(g){\n  if(g===0) return 'self';\n  if(g===1) return 'parent';\n  return grandPrefix(g-1)+'parent';\n}\n\n// Capitalise first letter\nfunction cap(s){ return s ? s.charAt(0).toUpperCase()+s.slice(1) : s; }\n\n// ─── DOM refs ───────────────────────────────────────────────────────────────\n\nconst g1Input = document.getElementById('g1');\nconst g2Input = document.getElementById('g2');\nconst out = id => document.getElementById(id);\n\nconst STORAGE_KEY = 'relcalc';\n\nconst PRESETS = [\n  { name: 'Siblings', g1: 1, g2: 1 },\n  { name: 'First cousins', g1: 2, g2: 2 },\n  { name: 'Second cousins', g1: 3, g2: 3 },\n  { name: 'Parent & child', g1: 0, g2: 1 },\n  { name: 'Grandparent & grandchild', g1: 0, g2: 2 },\n  { name: 'Aunt/uncle & niece/nephew', g1: 1, g2: 2 },\n  { name: 'First cousins once removed', g1: 2, g2: 3 },\n  { name: 'Great-grandparent', g1: 0, g2: 3 },\n];\n\n// ─── Render presets ─────────────────────────────────────────────────────────\n\n(function buildPresets(){\n  const wrap = document.getElementById('presets');\n  PRESETS.forEach(p => {\n    const btn = document.createElement('button');\n    btn.type = 'button';\n    btn.className = 'preset-btn text-xs font-medium px-3 py-1.5 rounded-full border border-gray-300 text-gray-600 bg-white hover:bg-indigo-50 hover:border-indigo-300 hover:text-indigo-700 transition';\n    btn.textContent = p.name;\n    btn.addEventListener('click', () => {\n      g1Input.value = p.g1;\n      g2Input.value = p.g2;\n      calculate();\n    });\n    wrap.appendChild(btn);\n  });\n})();\n\n// ─── Steppers ───────────────────────────────────────────────────────────────\n\ndocument.querySelectorAll('.stepper').forEach(b => {\n  b.addEventListener('click', () => {\n    const input = document.getElementById(b.dataset.step);\n    const dir = parseInt(b.dataset.dir, 10);\n    let v = clampG(parseInt(input.value, 10));\n    v = clampG(v + dir);\n    input.value = v;\n    calculate();\n  });\n});\n\nfunction clampG(v){\n  if(isNaN(v)) v = 0;\n  if(v < 0) v = 0;\n  if(v > 15) v = 15;\n  return v;\n}\n\n// ─── Per-person label (e.g. \"grandchild of the common ancestor\") ────────────\n\nfunction personDescription(g){\n  if(g===0) return 'is the common ancestor';\n  if(g===1) return 'is a child of the common ancestor';\n  if(g===2) return 'is a grandchild of the common ancestor';\n  return 'is a ' + grandPrefix(g-1) + 'child of the common ancestor';\n}\n\n// ─── Descent ladder visual ──────────────────────────────────────────────────\n\nfunction descentLabel(g){\n  if(g===0) return 'is the ancestor';\n  if(g===1) return 'child';\n  if(g===2) return 'grandchild';\n  return grandPrefix(g-1)+'child';\n}\n\nfunction buildLadder(g1, g2){\n  const ladder = document.getElementById('ladder');\n  ladder.innerHTML = '';\n\n  // Shared common-ancestor node\n  const anc = document.createElement('div');\n  anc.className = 'ladder-node mb-2 px-4 py-2 rounded-xl bg-gray-800 text-white text-sm font-semibold shadow-sm';\n  anc.textContent = 'Common ancestor';\n  ladder.appendChild(anc);\n\n  // Connector down to the split\n  const connector = document.createElement('div');\n  connector.className = 'w-px h-4 bg-gray-300';\n  ladder.appendChild(connector);\n\n  // Two columns\n  const cols = document.createElement('div');\n  cols.className = 'grid grid-cols-2 gap-8 sm:gap-16 w-full max-w-md';\n\n  cols.appendChild(buildColumn(1, g1, 'blue'));\n  cols.appendChild(buildColumn(2, g2, 'indigo'));\n\n  ladder.appendChild(cols);\n}\n\nfunction buildColumn(personNum, g, color){\n  const col = document.createElement('div');\n  col.className = 'flex flex-col items-center gap-1';\n\n  const accentBg = color === 'blue' ? 'bg-blue-100' : 'bg-indigo-100';\n  const accentText = color === 'blue' ? 'text-blue-700' : 'text-indigo-700';\n  const accentBorder = color === 'blue' ? 'border-blue-300' : 'border-indigo-300';\n  const finalBg = color === 'blue' ? 'bg-blue-600' : 'bg-indigo-600';\n  const rungColor = 'bg-gray-300';\n\n  if(g === 0){\n    // Person IS the common ancestor\n    const node = document.createElement('div');\n    node.className = 'ladder-node px-3 py-2 rounded-lg ' + finalBg + ' text-white text-xs font-bold text-center shadow-sm';\n    node.textContent = 'Person ' + personNum + ' (the ancestor)';\n    col.appendChild(node);\n    return col;\n  }\n\n  // g rungs of descent, last node = the person\n  for(let i = 1; i <= g; i++){\n    // rung connector\n    const rung = document.createElement('div');\n    rung.className = 'w-px h-4 ' + rungColor;\n    col.appendChild(rung);\n\n    const isPerson = (i === g);\n    const node = document.createElement('div');\n    if(isPerson){\n      node.className = 'ladder-node px-3 py-2 rounded-lg ' + finalBg + ' text-white text-xs font-bold text-center shadow-sm';\n      node.textContent = 'Person ' + personNum;\n    } else {\n      node.className = 'ladder-node px-3 py-1.5 rounded-lg ' + accentBg + ' ' + accentText + ' border ' + accentBorder + ' text-[11px] font-medium text-center';\n      node.textContent = ordinalGenLabel(i);\n    }\n    col.appendChild(node);\n  }\n\n  // caption\n  const cap = document.createElement('div');\n  cap.className = 'mt-1 text-[11px] ' + accentText + ' font-medium text-center';\n  cap.textContent = g + ' gen · ' + descentLabel(g);\n  col.appendChild(cap);\n\n  return col;\n}\n\nfunction ordinalGenLabel(i){\n  if(i===1) return 'child';\n  if(i===2) return 'grandchild';\n  return grandPrefix(i-1)+'child';\n}\n\n// ─── Main calculation ────────────────────────────────────────────────────────\n\nfunction calculate(){\n  const g1 = clampG(parseInt(g1Input.value, 10));\n  const g2 = clampG(parseInt(g2Input.value, 10));\n  // normalise the visible inputs to the clamped values\n  if(String(g1) !== g1Input.value) g1Input.value = g1;\n  if(String(g2) !== g2Input.value) g2Input.value = g2;\n\n  out('g1Label').textContent = 'Person 1 ' + personDescription(g1) + '.';\n  out('g2Label').textContent = 'Person 2 ' + personDescription(g2) + '.';\n\n  const rel = relationship(g1, g2);\n\n  out('forwardText').textContent = cap(rel.forward);\n  out('reverseText').textContent = cap(rel.reverse);\n\n  // Plain-English explanation referencing the shared ancestor.\n  let explain = rel.explain;\n  if(!(g1===0 && g2===0)){\n    const t1 = ancestorTermFor(g1);\n    const t2 = ancestorTermFor(g2);\n    if(g1 > 0 && g2 > 0){\n      explain += ' The common ancestor is Person 1’s ' + t1 + ' and Person 2’s ' + t2 + '.';\n    } else if(g1 === 0 && g2 > 0){\n      explain += ' Person 1 is Person 2’s ' + t2 + '.';\n    } else if(g2 === 0 && g1 > 0){\n      explain += ' Person 2 is Person 1’s ' + t1 + '.';\n    }\n  }\n  out('explainText').textContent = explain;\n\n  // Degrees of kinship\n  out('civilDegree').textContent = (g1 + g2);\n  out('canonDegree').textContent = Math.max(g1, g2);\n\n  // Visual ladder\n  buildLadder(g1, g2);\n\n  // Persist\n  try {\n    localStorage.setItem(STORAGE_KEY, JSON.stringify({ g1, g2 }));\n  } catch(e) { /* ignore */ }\n}\n\n// ─── Event listeners ─────────────────────────────────────────────────────────\n\n[g1Input, g2Input].forEach(el => {\n  el.addEventListener('input', calculate);\n  el.addEventListener('change', calculate);\n});\n\n// ─── Load from localStorage ───────────────────────────────────────────────────\n\n(function restoreOrInit(){\n  try {\n    const saved = JSON.parse(localStorage.getItem(STORAGE_KEY));\n    if(saved && typeof saved.g1 !== 'undefined' && typeof saved.g2 !== 'undefined'){\n      g1Input.value = clampG(parseInt(saved.g1, 10));\n      g2Input.value = clampG(parseInt(saved.g2, 10));\n    }\n  } catch(e) { /* ignore */ }\n  calculate();\n})();\n</script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Relationship Calculator",
    "windowTitle": "Relationship Calculator",
    "bundleId": "com.halisonworks.relationshipcalculator",
    "iconPath": null
  },
  "categoryId": null,
  "source": "import",
  "createdAt": "2026-06-02T12:00:00.000Z",
  "updatedAt": "2026-06-02T12:00:00.000Z",
  "sharedAt": "2026-06-02T12:00:00.000Z"
}
