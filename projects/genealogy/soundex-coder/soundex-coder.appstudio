{
  "schema": "app-studio/canvas@1",
  "id": "example-soundex-coder",
  "name": "soundex-coder.html",
  "code": "<!DOCTYPE html>\n<!--\n  Soundex Surname Coder — Halison App Studio example\n\n  Compute the American Soundex code for surnames the way U.S. census and immigration indexes do, and check whether two spellings share a code.\n\n  From the Halison App Studio public library:\n  https://github.com/halisonworks/public-app-studio\n\n  Permitted use: personal, educational, and other non-commercial use. You may\n  modify it, but keep this header and the source link intact, and do not sell,\n  commercialize, or republish it. Released under the Halison App Studio Examples\n  License — see the LICENSE file in the repository above.\n-->\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Soundex Surname Coder</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Inter', 'Segoe UI', sans-serif; }\n    .fade-in { animation: fadeIn 0.4s ease; }\n    @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }\n    .mono { font-family: ui-monospace, 'SFMono-Regular', 'Consolas', monospace; }\n    .step-letter { transition: background 0.2s ease; }\n    .group-pill { font-variant-numeric: tabular-nums; }\n  </style>\n</head>\n<body class=\"bg-gray-50 min-h-screen\">\n\n  <!-- Header -->\n  <header class=\"bg-white border-b border-gray-200 sticky top-0 z-30 shadow-sm\">\n    <div class=\"max-w-4xl mx-auto px-4 py-4 flex items-center justify-between\">\n      <div class=\"flex items-center gap-3\">\n        <div class=\"w-9 h-9 rounded-lg bg-indigo-600 flex items-center justify-center\">\n          <svg class=\"w-5 h-5 text-white\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M3 7h4l2 10h6l2-7H7M9 21a1 1 0 100-2 1 1 0 000 2zm0 0M16 21a1 1 0 100-2 1 1 0 000 2z\" />\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M14 3l2 2-2 2M16 5h-4\" />\n          </svg>\n        </div>\n        <div>\n          <h1 class=\"text-lg font-bold text-gray-900 leading-tight\">Soundex Surname Coder</h1>\n          <p class=\"text-xs text-gray-500\">American Soundex for census, immigration &amp; naturalization indexes</p>\n        </div>\n      </div>\n    </div>\n  </header>\n\n  <main class=\"max-w-4xl mx-auto px-4 py-8 space-y-6\">\n\n    <!-- MAIN: single surname coder -->\n    <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n      <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider mb-5\">Code a surname</h2>\n      <div class=\"grid grid-cols-1 sm:grid-cols-[1fr_auto] gap-6 items-center\">\n        <div>\n          <label class=\"block text-xs font-medium text-gray-500 mb-1 uppercase tracking-wider\">Surname</label>\n          <input id=\"mainName\" type=\"text\" autocomplete=\"off\" spellcheck=\"false\" value=\"Robert\"\n            class=\"w-full border border-gray-300 rounded-lg px-3 py-2.5 text-gray-800 text-lg focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent\"\n            placeholder=\"e.g. Washington\" />\n          <p class=\"text-xs text-gray-400 mt-1.5\">Letters only; spaces, apostrophes and hyphens are ignored.</p>\n        </div>\n        <div class=\"flex flex-col items-center justify-center\">\n          <span class=\"text-xs font-medium text-gray-500 uppercase tracking-wider mb-1.5\">Soundex code</span>\n          <div id=\"mainBadge\" class=\"mono text-3xl font-bold tracking-widest px-6 py-3 rounded-xl bg-indigo-50 text-indigo-700 border-2 border-indigo-200 min-w-[140px] text-center\">—</div>\n        </div>\n      </div>\n\n      <!-- Step-by-step breakdown -->\n      <div class=\"mt-6\">\n        <h3 class=\"text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3\">Step-by-step breakdown</h3>\n        <div id=\"breakdownLetters\" class=\"flex flex-wrap gap-2 mb-4\"></div>\n        <ol id=\"breakdownSteps\" class=\"space-y-1.5 text-sm text-gray-600 list-none\"></ol>\n      </div>\n    </section>\n\n    <!-- COMPARE: two surnames -->\n    <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n      <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider mb-5\">Compare two spellings</h2>\n      <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-5\">\n        <div>\n          <label class=\"block text-xs font-medium text-gray-500 mb-1 uppercase tracking-wider\">Surname 1</label>\n          <input id=\"cmpA\" type=\"text\" autocomplete=\"off\" spellcheck=\"false\" value=\"Smith\"\n            class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent\"\n            placeholder=\"e.g. Smith\" />\n          <div class=\"mt-2 flex items-center gap-2\">\n            <span class=\"text-xs text-gray-400\">codes as</span>\n            <span id=\"cmpCodeA\" class=\"mono text-sm font-bold text-gray-700 px-2 py-0.5 rounded bg-gray-100\">—</span>\n          </div>\n        </div>\n        <div>\n          <label class=\"block text-xs font-medium text-gray-500 mb-1 uppercase tracking-wider\">Surname 2</label>\n          <input id=\"cmpB\" type=\"text\" autocomplete=\"off\" spellcheck=\"false\" value=\"Smyth\"\n            class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent\"\n            placeholder=\"e.g. Smyth\" />\n          <div class=\"mt-2 flex items-center gap-2\">\n            <span class=\"text-xs text-gray-400\">codes as</span>\n            <span id=\"cmpCodeB\" class=\"mono text-sm font-bold text-gray-700 px-2 py-0.5 rounded bg-gray-100\">—</span>\n          </div>\n        </div>\n      </div>\n      <div id=\"cmpResult\" class=\"mt-5 px-5 py-3 rounded-xl font-semibold text-sm flex items-center gap-2\"></div>\n    </section>\n\n    <!-- BATCH: variant list -->\n    <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n      <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider mb-2\">Batch: spelling variants</h2>\n      <p class=\"text-xs text-gray-500 mb-4\">Paste surname spelling variants, one per line. Names sharing a Soundex code are grouped &mdash; those would appear together in a Soundex index.</p>\n      <textarea id=\"batchInput\" rows=\"7\" spellcheck=\"false\"\n        class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-800 text-sm mono focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent\"\n        placeholder=\"Smith&#10;Smyth&#10;Smithe&#10;Schmidt\"></textarea>\n\n      <div class=\"mt-5 grid grid-cols-1 md:grid-cols-2 gap-5\">\n        <div>\n          <h3 class=\"text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2\">Names &amp; codes</h3>\n          <div class=\"overflow-hidden rounded-lg border border-gray-200\">\n            <table class=\"w-full text-sm\">\n              <thead>\n                <tr class=\"bg-gray-50 text-gray-500 text-xs uppercase tracking-wider\">\n                  <th class=\"text-left font-medium px-3 py-2\">Surname</th>\n                  <th class=\"text-left font-medium px-3 py-2\">Soundex</th>\n                </tr>\n              </thead>\n              <tbody id=\"batchTable\"></tbody>\n            </table>\n          </div>\n        </div>\n        <div>\n          <h3 class=\"text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2\">Grouped by code</h3>\n          <div id=\"batchGroups\" class=\"space-y-3\"></div>\n        </div>\n      </div>\n    </section>\n\n    <!-- ABOUT -->\n    <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n      <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4\">About / How Soundex works</h2>\n      <div class=\"text-sm text-gray-600 leading-relaxed space-y-4\">\n        <p>\n          <strong class=\"text-gray-800\">Soundex</strong> is a phonetic index that groups surnames that sound alike but are spelled\n          differently. The U.S. National Archives (NARA) used it to index the <strong class=\"text-gray-800\">1880, 1900, 1910 and 1920\n          federal censuses</strong>, and the same coding underpins many immigration, naturalization and passenger-list indexes. To find an\n          ancestor in those microfilmed indexes you look up the surname's Soundex code rather than its spelling.\n        </p>\n        <p>This tool implements the <strong class=\"text-gray-800\">standard American Soundex</strong> (the NARA rules), not the Daitch&ndash;Mokotoff Soundex used for Eastern European and Jewish surnames.</p>\n\n        <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-5 my-2\">\n          <div class=\"bg-gray-50 rounded-xl border border-gray-200 p-4\">\n            <h3 class=\"text-xs font-semibold text-gray-700 uppercase tracking-wider mb-2\">Coding rules</h3>\n            <ol class=\"list-decimal list-inside space-y-1 text-xs text-gray-600\">\n              <li>Keep the <strong>first letter</strong> of the surname.</li>\n              <li>Assign digits to the remaining letters:</li>\n            </ol>\n            <table class=\"w-full text-xs mono mt-2 mb-2\">\n              <tbody class=\"text-gray-600\">\n                <tr><td class=\"py-0.5 w-6 font-bold text-indigo-700\">1</td><td>B F P V</td></tr>\n                <tr><td class=\"py-0.5 font-bold text-indigo-700\">2</td><td>C G J K Q S X Z</td></tr>\n                <tr><td class=\"py-0.5 font-bold text-indigo-700\">3</td><td>D T</td></tr>\n                <tr><td class=\"py-0.5 font-bold text-indigo-700\">4</td><td>L</td></tr>\n                <tr><td class=\"py-0.5 font-bold text-indigo-700\">5</td><td>M N</td></tr>\n                <tr><td class=\"py-0.5 font-bold text-indigo-700\">6</td><td>R</td></tr>\n              </tbody>\n            </table>\n            <ol class=\"list-decimal list-inside space-y-1 text-xs text-gray-600\" start=\"3\">\n              <li>The vowels <strong>A E I O U</strong> and <strong>Y</strong> are not coded, but they <em>do</em> separate two consonants &mdash; so the same digit on either side of a vowel is coded twice.</li>\n              <li><strong>H</strong> and <strong>W</strong> are skipped without separating: two equal digits on either side of an H or W are still coded only once.</li>\n              <li>Collapse adjacent letters with the same digit (including a first letter sharing the next letter's digit) into a single digit.</li>\n              <li>Append zeros, then truncate so the code is exactly one letter + three digits, e.g. <span class=\"mono font-semibold\">W252</span>.</li>\n            </ol>\n          </div>\n\n          <div class=\"bg-gray-50 rounded-xl border border-gray-200 p-4\">\n            <h3 class=\"text-xs font-semibold text-gray-700 uppercase tracking-wider mb-2\">Self-test (canonical NARA cases)</h3>\n            <p class=\"text-xs text-gray-500 mb-2\">These run live on page load to confirm the coder is correct.</p>\n            <div id=\"selfTest\" class=\"mono text-xs space-y-0.5\"></div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n  </main>\n\n  <footer class=\"max-w-4xl mx-auto px-4 py-6 text-center text-xs text-gray-400\">\n    Soundex Surname Coder &mdash; <a href=\"https://github.com/halisonworks/public-app-studio\" class=\"underline hover:text-indigo-500\" target=\"_blank\" rel=\"noopener\">Halison App Studio</a>\n  </footer>\n\n<script>\n// ─── American Soundex (NARA rules) ──────────────────────────────────────────\n\n// Returns a 4-char code like \"R163\". Non-letters ignored. Empty/garbage -> ''.\nfunction soundex(nameRaw){\n  const s = (nameRaw||'').toUpperCase().replace(/[^A-Z]/g,'');\n  if(!s) return '';\n  const code = ch => {\n    if('BFPV'.includes(ch)) return '1';\n    if('CGJKQSXZ'.includes(ch)) return '2';\n    if('DT'.includes(ch)) return '3';\n    if(ch==='L') return '4';\n    if('MN'.includes(ch)) return '5';\n    if(ch==='R') return '6';\n    return '0'; // A E I O U Y, and H W -> 0 (but H/W are special, see below)\n  };\n  const first = s[0];\n  let result = first;\n  let prev = code(first); // digit of first letter, used to suppress an immediate duplicate\n  for(let i=1;i<s.length;i++){\n    const ch = s[i];\n    const d = code(ch);\n    if(ch==='H' || ch==='W'){\n      // H and W do NOT get coded and do NOT reset prev: a digit on each side of\n      // H/W is treated as adjacent (coded once). So DO NOT update prev.\n      continue;\n    }\n    if(d!=='0'){\n      if(d!==prev){ result += d; }\n      // if d===prev (adjacent same digit) -> skip (collapse)\n    }\n    // vowels (A E I O U Y) have d==='0': they DON'T get coded but they DO reset\n    // prev so the same digit on either side codes twice.\n    prev = d; // for vowels d='0' (reset); for coded consonant set prev=d\n    if(result.length>=4) break;\n  }\n  return (result + '000').slice(0,4);\n}\n\n// Detailed trace for the step-by-step breakdown (mirrors soundex()).\nfunction soundexTrace(nameRaw){\n  const cleaned = (nameRaw||'').toUpperCase().replace(/[^A-Z]/g,'');\n  if(!cleaned) return { code:'', cleaned:'', letters:[], notes:[] };\n  const code = ch => {\n    if('BFPV'.includes(ch)) return '1';\n    if('CGJKQSXZ'.includes(ch)) return '2';\n    if('DT'.includes(ch)) return '3';\n    if(ch==='L') return '4';\n    if('MN'.includes(ch)) return '5';\n    if(ch==='R') return '6';\n    return '0';\n  };\n  const letters = [];\n  const notes = [];\n  const first = cleaned[0];\n  let result = first;\n  let prev = code(first);\n  letters.push({ ch:first, kind:'first', digit:null });\n  notes.push('Keep the first letter <b>' + first + '</b>.');\n  for(let i=1;i<cleaned.length;i++){\n    const ch = cleaned[i];\n    const d = code(ch);\n    if(ch==='H' || ch==='W'){\n      letters.push({ ch, kind:'hw', digit:'—' });\n      notes.push('<b>' + ch + '</b> &rarr; skipped (bridges across, so equal digits on each side still code once).');\n      continue;\n    }\n    if(d==='0'){\n      letters.push({ ch, kind:'vowel', digit:'—' });\n      notes.push('<b>' + ch + '</b> &rarr; vowel, not coded (but separates the next consonant).');\n      prev = d;\n      continue;\n    }\n    // coded consonant\n    if(d===prev){\n      letters.push({ ch, kind:'collapse', digit:d });\n      notes.push('<b>' + ch + '</b> &rarr; <b>' + d + '</b>, but same digit as the previous coded letter &rarr; collapsed (not added).');\n    } else if(result.length>=4){\n      letters.push({ ch, kind:'overflow', digit:d });\n      notes.push('<b>' + ch + '</b> &rarr; <b>' + d + '</b>, but code already has 3 digits &rarr; truncated.');\n    } else {\n      result += d;\n      letters.push({ ch, kind:'coded', digit:d });\n      notes.push('<b>' + ch + '</b> &rarr; <b>' + d + '</b>, added.');\n    }\n    prev = d;\n  }\n  const padded = (result + '000').slice(0,4);\n  notes.push('Zero-pad and truncate to one letter + three digits &rarr; <b>' + padded + '</b>.');\n  return { code: padded, cleaned, letters, notes };\n}\n\n// ─── DOM helpers ────────────────────────────────────────────────────────────\n\nconst $ = id => document.getElementById(id);\n\nconst KIND_STYLE = {\n  first:    'bg-indigo-600 text-white border-indigo-700',\n  coded:    'bg-indigo-50 text-indigo-700 border-indigo-200',\n  collapse: 'bg-amber-50 text-amber-700 border-amber-200',\n  overflow: 'bg-gray-100 text-gray-400 border-gray-200 line-through',\n  vowel:    'bg-gray-50 text-gray-400 border-gray-200',\n  hw:       'bg-gray-50 text-gray-400 border-gray-200 italic'\n};\n\n// ─── MAIN ───────────────────────────────────────────────────────────────────\n\nfunction renderMain(){\n  const raw = $('mainName').value;\n  const t = soundexTrace(raw);\n  const badge = $('mainBadge');\n  badge.textContent = t.code || '—';\n\n  const lettersEl = $('breakdownLetters');\n  const stepsEl = $('breakdownSteps');\n  lettersEl.innerHTML = '';\n  stepsEl.innerHTML = '';\n\n  if(!t.cleaned){\n    lettersEl.innerHTML = '<span class=\"text-sm text-gray-400\">Type a surname to see the breakdown.</span>';\n    return;\n  }\n\n  t.letters.forEach(L => {\n    const cls = KIND_STYLE[L.kind] || KIND_STYLE.coded;\n    const tile = document.createElement('div');\n    tile.className = 'step-letter flex flex-col items-center justify-center w-11 rounded-lg border px-2 py-1.5 ' + cls;\n    tile.innerHTML =\n      '<span class=\"mono text-lg font-bold leading-none\">' + L.ch + '</span>' +\n      '<span class=\"mono text-[11px] leading-none mt-1 opacity-80\">' + (L.kind==='first' ? 'keep' : (L.digit ?? '')) + '</span>';\n    lettersEl.appendChild(tile);\n  });\n\n  t.notes.forEach((n, i) => {\n    const li = document.createElement('li');\n    li.className = 'flex gap-2';\n    li.innerHTML = '<span class=\"mono text-xs text-gray-400 w-5 flex-shrink-0\">' + (i+1) + '.</span><span>' + n + '</span>';\n    stepsEl.appendChild(li);\n  });\n}\n\n// ─── COMPARE ────────────────────────────────────────────────────────────────\n\nfunction renderCompare(){\n  const a = $('cmpA').value, b = $('cmpB').value;\n  const ca = soundex(a), cb = soundex(b);\n  $('cmpCodeA').textContent = ca || '—';\n  $('cmpCodeB').textContent = cb || '—';\n\n  const box = $('cmpResult');\n  if(!ca || !cb){\n    box.className = 'mt-5 px-5 py-3 rounded-xl font-semibold text-sm flex items-center gap-2 bg-gray-100 text-gray-500';\n    box.innerHTML = '<span>Enter two surnames to compare their Soundex codes.</span>';\n    return;\n  }\n  if(ca === cb){\n    box.className = 'mt-5 px-5 py-3 rounded-xl font-semibold text-sm flex items-center gap-2 bg-emerald-50 text-emerald-700 border border-emerald-200';\n    box.innerHTML = '<svg class=\"w-4 h-4 flex-shrink-0\" fill=\"currentColor\" viewBox=\"0 0 20 20\"><path fill-rule=\"evenodd\" d=\"M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z\" clip-rule=\"evenodd\"/></svg>' +\n      '<span>Same Soundex code <span class=\"mono\">' + ca + '</span> &mdash; these spellings would appear together in a Soundex index.</span>';\n  } else {\n    box.className = 'mt-5 px-5 py-3 rounded-xl font-semibold text-sm flex items-center gap-2 bg-rose-50 text-rose-700 border border-rose-200';\n    box.innerHTML = '<svg class=\"w-4 h-4 flex-shrink-0\" fill=\"currentColor\" viewBox=\"0 0 20 20\"><path fill-rule=\"evenodd\" d=\"M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z\" clip-rule=\"evenodd\"/></svg>' +\n      '<span>Different codes &mdash; <span class=\"mono\">' + ca + '</span> vs <span class=\"mono\">' + cb + '</span>. They would be filed separately.</span>';\n  }\n}\n\n// ─── BATCH ──────────────────────────────────────────────────────────────────\n\nconst GROUP_PALETTE = [\n  'bg-indigo-50 text-indigo-700 border-indigo-200',\n  'bg-emerald-50 text-emerald-700 border-emerald-200',\n  'bg-amber-50 text-amber-700 border-amber-200',\n  'bg-sky-50 text-sky-700 border-sky-200',\n  'bg-rose-50 text-rose-700 border-rose-200',\n  'bg-violet-50 text-violet-700 border-violet-200',\n  'bg-teal-50 text-teal-700 border-teal-200',\n  'bg-orange-50 text-orange-700 border-orange-200'\n];\n\nfunction renderBatch(){\n  const lines = $('batchInput').value.split('\\n')\n    .map(l => l.trim())\n    .filter(l => l.length > 0);\n\n  const table = $('batchTable');\n  const groupsEl = $('batchGroups');\n  table.innerHTML = '';\n  groupsEl.innerHTML = '';\n\n  if(lines.length === 0){\n    table.innerHTML = '<tr><td colspan=\"2\" class=\"px-3 py-4 text-center text-gray-400 text-xs\">No names yet.</td></tr>';\n    groupsEl.innerHTML = '<p class=\"text-xs text-gray-400\">Groups appear here once you add names.</p>';\n    return;\n  }\n\n  // Build code -> list, and assign a colour per code that is shared.\n  const byCode = {};\n  const order = [];\n  lines.forEach(name => {\n    const c = soundex(name) || '∅';\n    if(!byCode[c]){ byCode[c] = []; order.push(c); }\n    byCode[c].push(name);\n  });\n\n  // Colour map: only codes shared by 2+ names get a highlight colour.\n  const colourMap = {};\n  let ci = 0;\n  order.forEach(c => {\n    if(byCode[c].length > 1 && c !== '∅'){\n      colourMap[c] = GROUP_PALETTE[ci % GROUP_PALETTE.length];\n      ci++;\n    }\n  });\n\n  // Table rows (in input order).\n  lines.forEach(name => {\n    const c = soundex(name) || '∅';\n    const tr = document.createElement('tr');\n    tr.className = 'border-t border-gray-100';\n    const codeCls = colourMap[c]\n      ? 'mono font-bold px-2 py-0.5 rounded border ' + colourMap[c]\n      : 'mono font-bold text-gray-700';\n    tr.innerHTML =\n      '<td class=\"px-3 py-2 text-gray-800\">' + escapeHtml(name) + '</td>' +\n      '<td class=\"px-3 py-2\"><span class=\"' + codeCls + '\">' + (c === '∅' ? '—' : c) + '</span></td>';\n    table.appendChild(tr);\n  });\n\n  // Groups: shared codes first, then singletons.\n  const shared = order.filter(c => byCode[c].length > 1 && c !== '∅');\n  const singles = order.filter(c => !(byCode[c].length > 1 && c !== '∅'));\n\n  shared.forEach(c => {\n    const card = document.createElement('div');\n    card.className = 'rounded-xl border p-3 ' + colourMap[c];\n    const names = byCode[c].map(n => '<span class=\"bg-white/70 rounded px-2 py-0.5 text-xs font-medium text-gray-700 border border-white\">' + escapeHtml(n) + '</span>').join(' ');\n    card.innerHTML =\n      '<div class=\"flex items-center justify-between mb-2\">' +\n        '<span class=\"group-pill mono font-bold text-sm\">' + c + '</span>' +\n        '<span class=\"text-xs font-medium opacity-70\">' + byCode[c].length + ' spellings share this index slot</span>' +\n      '</div>' +\n      '<div class=\"flex flex-wrap gap-1.5\">' + names + '</div>';\n    groupsEl.appendChild(card);\n  });\n\n  if(singles.length){\n    const all = [];\n    singles.forEach(c => byCode[c].forEach(n => all.push({ n, c })));\n    const card = document.createElement('div');\n    card.className = 'rounded-xl border border-gray-200 bg-gray-50 p-3';\n    const items = all.map(o =>\n      '<span class=\"bg-white rounded px-2 py-0.5 text-xs text-gray-600 border border-gray-200\">' +\n      escapeHtml(o.n) + ' <span class=\"mono text-gray-400\">' + (o.c === '∅' ? '—' : o.c) + '</span></span>'\n    ).join(' ');\n    card.innerHTML =\n      '<div class=\"text-xs font-medium text-gray-500 mb-2 uppercase tracking-wider\">Unique codes (no match in this list)</div>' +\n      '<div class=\"flex flex-wrap gap-1.5\">' + items + '</div>';\n    groupsEl.appendChild(card);\n  }\n}\n\nfunction escapeHtml(s){\n  return String(s).replace(/[&<>\"']/g, ch => ({\n    '&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'\n  }[ch]));\n}\n\n// ─── Self-test (canonical NARA cases) ───────────────────────────────────────\n\nfunction runSelfTest(){\n  const cases = [\n    ['Robert','R163'], ['Rupert','R163'], ['Rubin','R150'],\n    ['Ashcraft','A261'], ['Ashcroft','A261'], ['Tymczak','T522'],\n    ['Pfister','P236'], ['Honeyman','H555'], ['Washington','W252'],\n    ['Lee','L000'], ['Gutierrez','G362'], ['Jackson','J250'],\n    ['VanDeusen','V532']\n  ];\n  const el = $('selfTest');\n  el.innerHTML = '';\n  let allPass = true;\n  cases.forEach(([name, expect]) => {\n    const got = soundex(name);\n    const ok = got === expect;\n    if(!ok) allPass = false;\n    const row = document.createElement('div');\n    row.className = 'flex items-center gap-2';\n    row.innerHTML =\n      '<span class=\"' + (ok ? 'text-emerald-600' : 'text-rose-600') + ' font-bold w-3\">' + (ok ? '✓' : '✗') + '</span>' +\n      '<span class=\"text-gray-600 w-24\">' + name + '</span>' +\n      '<span class=\"' + (ok ? 'text-gray-700' : 'text-rose-600 font-bold') + '\">' + got + '</span>' +\n      (ok ? '' : '<span class=\"text-gray-400\">(expected ' + expect + ')</span>');\n    el.appendChild(row);\n  });\n  const summary = document.createElement('div');\n  summary.className = 'mt-2 pt-2 border-t border-gray-200 font-semibold ' + (allPass ? 'text-emerald-600' : 'text-rose-600');\n  summary.textContent = allPass ? 'All ' + cases.length + ' cases pass.' : 'Some cases failed — see above.';\n  el.appendChild(summary);\n}\n\n// ─── Persistence ────────────────────────────────────────────────────────────\n\nconst LS_KEY = 'soundex-coder';\n\nfunction save(){\n  try {\n    localStorage.setItem(LS_KEY, JSON.stringify({\n      main: $('mainName').value,\n      cmpA: $('cmpA').value,\n      cmpB: $('cmpB').value,\n      batch: $('batchInput').value\n    }));\n  } catch(e) { /* ignore */ }\n}\n\nfunction restore(){\n  try {\n    const saved = JSON.parse(localStorage.getItem(LS_KEY));\n    if(saved){\n      if(typeof saved.main === 'string') $('mainName').value = saved.main;\n      if(typeof saved.cmpA === 'string') $('cmpA').value = saved.cmpA;\n      if(typeof saved.cmpB === 'string') $('cmpB').value = saved.cmpB;\n      if(typeof saved.batch === 'string') $('batchInput').value = saved.batch;\n    } else {\n      $('batchInput').value = 'Smith\\nSmyth\\nSmithe\\nSchmidt\\nSmythe\\nSnead';\n    }\n  } catch(e) {\n    $('batchInput').value = 'Smith\\nSmyth\\nSmithe\\nSchmidt\\nSmythe\\nSnead';\n  }\n}\n\nfunction renderAll(){\n  renderMain();\n  renderCompare();\n  renderBatch();\n  save();\n}\n\n// ─── Wiring ─────────────────────────────────────────────────────────────────\n\n['mainName','cmpA','cmpB','batchInput'].forEach(id => {\n  $(id).addEventListener('input', renderAll);\n});\n\nrestore();\nrunSelfTest();\nrenderAll();\n</script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Soundex Surname Coder",
    "windowTitle": "Soundex Surname Coder",
    "bundleId": "com.halisonworks.soundexcoder",
    "iconPath": null
  },
