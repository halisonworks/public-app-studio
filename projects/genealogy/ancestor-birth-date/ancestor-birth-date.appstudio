{
  "schema": "app-studio/canvas@1",
  "id": "example-ancestor-birth-date",
  "name": "ancestor-birth-date.html",
  "code": "<!DOCTYPE html>\n<!--\n  Age & Birth-Date Calculator — Halison App Studio example\n\n  Compute a birth date from a death date and an age at death (\"aged 67 years 4 months 11 days\"), and other date arithmetic genealogists need.\n\n  From the Halison App Studio public library:\n  https://github.com/halisonworks/public-app-studio\n\n  Permitted use: personal, educational, and other non-commercial use. You may\n  modify it, but keep this header and the source link intact, and do not sell,\n  commercialize, or republish it. Released under the Halison App Studio Examples\n  License — see the LICENSE file in the repository above.\n-->\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Age &amp; Birth-Date Calculator</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Inter', 'Segoe UI', sans-serif; }\n    input[type=number]::-webkit-inner-spin-button,\n    input[type=number]::-webkit-outer-spin-button { opacity: 1; }\n    .fade-in { animation: fadeIn 0.4s ease; }\n    @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }\n    .tab-btn { transition: all 0.15s ease; }\n    .tab-btn.active { background: #ffffff; color: #4338ca; box-shadow: 0 1px 2px rgba(0,0,0,0.06); }\n    .tab-btn:not(.active) { color: #6b7280; }\n    .badge-ok { background: #d1fae5; color: #065f46; border: 1.5px solid #6ee7b7; }\n    .badge-warn { background: #fef3c7; color: #92400e; border: 1.5px solid #fcd34d; }\n    .tooltip { position: relative; }\n    .tooltip:hover .tooltip-text { display: block; }\n    .tooltip-text { display: none; position: absolute; bottom: 125%; left: 50%; transform: translateX(-50%);\n      background: #1e293b; color: #f8fafc; font-size: 11px; padding: 4px 8px; border-radius: 5px;\n      white-space: nowrap; z-index: 50; pointer-events: none; }\n    .tooltip-text::after { content: ''; position: absolute; top: 100%; left: 50%; transform: translateX(-50%);\n      border: 5px solid transparent; border-top-color: #1e293b; }\n  </style>\n</head>\n<body class=\"bg-gray-50 min-h-screen\">\n\n  <!-- Header -->\n  <header class=\"bg-white border-b border-gray-200 sticky top-0 z-30 shadow-sm\">\n    <div class=\"max-w-4xl mx-auto px-4 py-4 flex items-center gap-3\">\n      <div class=\"w-9 h-9 rounded-lg bg-indigo-600 flex items-center justify-center\">\n        <svg class=\"w-5 h-5 text-white\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z\" />\n        </svg>\n      </div>\n      <div>\n        <h1 class=\"text-lg font-bold text-gray-900 leading-tight\">Age &amp; Birth-Date Calculator</h1>\n        <p class=\"text-xs text-gray-500\">Birth dates, exact ages, and census windows for genealogists</p>\n      </div>\n    </div>\n  </header>\n\n  <main class=\"max-w-4xl mx-auto px-4 py-8 space-y-6\">\n\n    <!-- Tabs / segmented control -->\n    <div class=\"bg-gray-100 rounded-xl p-1 flex flex-col sm:flex-row gap-1 text-sm font-semibold\">\n      <button data-tab=\"birth\" class=\"tab-btn active flex-1 rounded-lg px-3 py-2 text-center\">Birth date from death + age</button>\n      <button data-tab=\"between\" class=\"tab-btn flex-1 rounded-lg px-3 py-2 text-center\">Exact age between two dates</button>\n      <button data-tab=\"census\" class=\"tab-btn flex-1 rounded-lg px-3 py-2 text-center\">Census age &rarr; birth-year range</button>\n    </div>\n\n    <!-- Error Banner -->\n    <div id=\"errorBanner\" class=\"hidden bg-red-50 border border-red-200 rounded-xl px-5 py-3 text-red-700 text-sm flex items-center gap-2\">\n      <svg class=\"w-4 h-4 flex-shrink-0\" fill=\"currentColor\" viewBox=\"0 0 20 20\"><path fill-rule=\"evenodd\" d=\"M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z\" clip-rule=\"evenodd\"/></svg>\n      <span id=\"errorText\"></span>\n    </div>\n\n    <!-- ───────────────────────── MODE 1: BIRTH FROM DEATH + AGE ───────────────────────── -->\n    <div id=\"tab-birth\" class=\"space-y-6\">\n\n      <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n        <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider mb-5\">Death date</h2>\n        <div class=\"grid grid-cols-3 gap-4\">\n          <div>\n            <label class=\"block text-xs font-medium text-gray-500 mb-1\">Day</label>\n            <input id=\"b_dDay\" type=\"number\" min=\"1\" max=\"31\" value=\"14\"\n              class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent\" placeholder=\"1–31\" />\n          </div>\n          <div>\n            <label class=\"block text-xs font-medium text-gray-500 mb-1\">Month</label>\n            <select id=\"b_dMonth\" class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-800 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-400\"></select>\n          </div>\n          <div>\n            <label class=\"block text-xs font-medium text-gray-500 mb-1\">Year</label>\n            <input id=\"b_dYear\" type=\"number\" value=\"1888\"\n              class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent\" placeholder=\"e.g. 1888\" />\n          </div>\n        </div>\n\n        <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider mt-6 mb-2\">Age at death</h2>\n        <p class=\"text-xs text-gray-400 mb-4\">As written on the record, e.g. \"aged 67 years 4 months 11 days\". Months and days default to 0.</p>\n        <div class=\"grid grid-cols-3 gap-4\">\n          <div>\n            <label class=\"block text-xs font-medium text-gray-500 mb-1\">Years</label>\n            <input id=\"b_ay\" type=\"number\" min=\"0\" value=\"67\"\n              class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent\" placeholder=\"0\" />\n          </div>\n          <div>\n            <label class=\"block text-xs font-medium text-gray-500 mb-1\">Months</label>\n            <input id=\"b_am\" type=\"number\" min=\"0\" value=\"4\"\n              class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent\" placeholder=\"0\" />\n          </div>\n          <div>\n            <label class=\"block text-xs font-medium text-gray-500 mb-1\">Days</label>\n            <input id=\"b_ad\" type=\"number\" min=\"0\" value=\"11\"\n              class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent\" placeholder=\"0\" />\n          </div>\n        </div>\n      </section>\n\n      <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6 fade-in\">\n        <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4\">Computed birth date</h2>\n        <div class=\"flex flex-col sm:flex-row sm:items-center gap-4\">\n          <div class=\"flex-1\">\n            <p id=\"b_long\" class=\"text-3xl font-bold text-indigo-700 leading-tight\">—</p>\n            <p id=\"b_iso\" class=\"text-sm text-gray-500 mt-1 font-mono\">—</p>\n            <p id=\"b_dow\" class=\"text-sm text-gray-500 mt-0.5\">—</p>\n          </div>\n          <div id=\"b_flag\" class=\"hidden flex-shrink-0 px-4 py-3 rounded-xl font-semibold text-sm text-center badge-warn max-w-[220px]\"></div>\n        </div>\n        <p class=\"text-xs text-gray-400 mt-4 leading-relaxed\">Gravestone and death-record ages are frequently rounded or approximate. Treat the computed birth date as an estimate to confirm against a baptism or birth record.</p>\n      </section>\n    </div>\n\n    <!-- ───────────────────────── MODE 2: EXACT AGE BETWEEN TWO DATES ───────────────────────── -->\n    <div id=\"tab-between\" class=\"space-y-6 hidden\">\n      <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n        <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n          <div class=\"rounded-xl border-2 border-gray-200 p-5 space-y-4\">\n            <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider\">Date A &middot; earlier (birth)</h2>\n            <div class=\"grid grid-cols-3 gap-3\">\n              <div>\n                <label class=\"block text-xs font-medium text-gray-500 mb-1\">Day</label>\n                <input id=\"e_aDay\" type=\"number\" min=\"1\" max=\"31\" value=\"3\"\n                  class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent\" />\n              </div>\n              <div>\n                <label class=\"block text-xs font-medium text-gray-500 mb-1\">Month</label>\n                <select id=\"e_aMonth\" class=\"w-full border border-gray-300 rounded-lg px-2 py-2 text-gray-800 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-400\"></select>\n              </div>\n              <div>\n                <label class=\"block text-xs font-medium text-gray-500 mb-1\">Year</label>\n                <input id=\"e_aYear\" type=\"number\" value=\"1821\"\n                  class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent\" />\n              </div>\n            </div>\n          </div>\n          <div class=\"rounded-xl border-2 border-indigo-200 p-5 space-y-4\">\n            <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider\">Date B &middot; later (death / census)</h2>\n            <div class=\"grid grid-cols-3 gap-3\">\n              <div>\n                <label class=\"block text-xs font-medium text-gray-500 mb-1\">Day</label>\n                <input id=\"e_bDay\" type=\"number\" min=\"1\" max=\"31\" value=\"14\"\n                  class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent\" />\n              </div>\n              <div>\n                <label class=\"block text-xs font-medium text-gray-500 mb-1\">Month</label>\n                <select id=\"e_bMonth\" class=\"w-full border border-gray-300 rounded-lg px-2 py-2 text-gray-800 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-400\"></select>\n              </div>\n              <div>\n                <label class=\"block text-xs font-medium text-gray-500 mb-1\">Year</label>\n                <input id=\"e_bYear\" type=\"number\" value=\"1888\"\n                  class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent\" />\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6 fade-in\">\n        <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4\">Exact age</h2>\n        <p id=\"e_long\" class=\"text-3xl font-bold text-indigo-700 leading-tight mb-4\">—</p>\n        <div class=\"grid grid-cols-2 md:grid-cols-4 gap-4\">\n          <div class=\"bg-gray-50 rounded-xl border border-gray-200 p-4\">\n            <div class=\"text-xs text-gray-500 font-medium mb-1\">Years</div>\n            <div id=\"e_y\" class=\"text-2xl font-bold text-gray-800\">—</div>\n          </div>\n          <div class=\"bg-gray-50 rounded-xl border border-gray-200 p-4\">\n            <div class=\"text-xs text-gray-500 font-medium mb-1\">Months</div>\n            <div id=\"e_m\" class=\"text-2xl font-bold text-gray-800\">—</div>\n          </div>\n          <div class=\"bg-gray-50 rounded-xl border border-gray-200 p-4\">\n            <div class=\"text-xs text-gray-500 font-medium mb-1\">Days</div>\n            <div id=\"e_d\" class=\"text-2xl font-bold text-gray-800\">—</div>\n          </div>\n          <div class=\"bg-gray-50 rounded-xl border border-gray-200 p-4\">\n            <div class=\"text-xs text-gray-500 font-medium mb-1\">Total days</div>\n            <div id=\"e_total\" class=\"text-2xl font-bold text-gray-800\">—</div>\n          </div>\n        </div>\n        <div class=\"grid grid-cols-2 gap-4 mt-4\">\n          <div class=\"bg-gray-50 rounded-xl border border-gray-200 p-4\">\n            <div class=\"text-xs text-gray-500 font-medium mb-1\">Total weeks</div>\n            <div id=\"e_weeks\" class=\"text-2xl font-bold text-gray-800\">—</div>\n          </div>\n          <div class=\"bg-indigo-50 rounded-xl border border-indigo-200 p-4\">\n            <div class=\"text-xs text-indigo-600 font-medium mb-1\">Stated age (whole years)</div>\n            <div id=\"e_stated\" class=\"text-2xl font-bold text-indigo-700\">—</div>\n          </div>\n        </div>\n      </section>\n    </div>\n\n    <!-- ───────────────────────── MODE 3: CENSUS AGE → BIRTH-YEAR RANGE ───────────────────────── -->\n    <div id=\"tab-census\" class=\"space-y-6 hidden\">\n      <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n        <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider mb-5\">Census / enumeration date</h2>\n        <div class=\"grid grid-cols-3 gap-4\">\n          <div>\n            <label class=\"block text-xs font-medium text-gray-500 mb-1\">Day</label>\n            <input id=\"c_day\" type=\"number\" min=\"1\" max=\"31\" value=\"7\"\n              class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent\" />\n          </div>\n          <div>\n            <label class=\"block text-xs font-medium text-gray-500 mb-1\">Month</label>\n            <select id=\"c_month\" class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-800 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-400\"></select>\n          </div>\n          <div>\n            <label class=\"block text-xs font-medium text-gray-500 mb-1\">Year</label>\n            <input id=\"c_year\" type=\"number\" value=\"1881\"\n              class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent\" />\n          </div>\n        </div>\n\n        <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider mt-6 mb-2\">Stated age</h2>\n        <div class=\"grid grid-cols-3 gap-4\">\n          <div>\n            <label class=\"block text-xs font-medium text-gray-500 mb-1\">Age in whole years</label>\n            <input id=\"c_age\" type=\"number\" min=\"0\" value=\"34\"\n              class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent\" />\n          </div>\n        </div>\n      </section>\n\n      <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6 fade-in\">\n        <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4\">Birth window</h2>\n        <p class=\"text-sm text-gray-600 mb-4\">A person stated as age <span id=\"c_ageEcho\" class=\"font-semibold\">N</span> on the enumeration date was born within this window:</p>\n        <div class=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n          <div class=\"bg-gray-50 rounded-xl border border-gray-200 p-4\">\n            <div class=\"text-xs text-gray-500 font-medium mb-1\">Born after (exclusive)</div>\n            <div id=\"c_after\" class=\"text-xl font-bold text-gray-800\">—</div>\n          </div>\n          <div class=\"bg-gray-50 rounded-xl border border-gray-200 p-4\">\n            <div class=\"text-xs text-gray-500 font-medium mb-1\">Born on or before (inclusive)</div>\n            <div id=\"c_before\" class=\"text-xl font-bold text-gray-800\">—</div>\n          </div>\n        </div>\n        <div class=\"bg-indigo-50 rounded-xl border border-indigo-200 p-4 mt-4\">\n          <div class=\"text-xs text-indigo-600 font-medium mb-1\">Most likely birth year</div>\n          <div id=\"c_likely\" class=\"text-2xl font-bold text-indigo-700\">—</div>\n        </div>\n        <p class=\"text-xs text-gray-400 mt-4 leading-relaxed\">Enumeration-date conventions vary: some censuses record age as of a fixed reference night (e.g. UK census night), others as of the day the household was visited. A stated whole-year age implies the birthday had already occurred on or before that date, giving a roughly one-year window.</p>\n      </section>\n    </div>\n\n    <!-- About / Notes (shared) -->\n    <section class=\"bg-gray-50 rounded-xl border border-gray-200 px-5 py-4 text-xs text-gray-500 leading-relaxed space-y-2\">\n      <p><strong class=\"text-gray-700\">About this calculator.</strong> Birth dates are found by calendar subtraction: days are subtracted first (borrowing whole calendar months at their real length), then months, then years. This mirrors how a \"67 years 4 months 11 days\" age was originally counted, rather than relying on automatic date overflow.</p>\n      <p><strong class=\"text-gray-700\">Month lengths &amp; leap years.</strong> Borrowing uses the actual length of each month, with the Gregorian leap rule (divisible by 4, except centuries not divisible by 400). If a borrowed result lands on a day that does not exist in the target month, it is clamped to the last day and the result is flagged as approximate.</p>\n      <p><strong class=\"text-gray-700\">Old Style dates (pre-1752).</strong> Britain and its colonies used the Julian calendar with a 25 March new year until 1752. Day-of-week and exact spans for early dates may differ from the historical record; treat pre-1752 results with caution and note the calendar in use on the source.</p>\n      <p><strong class=\"text-gray-700\">Approximate ages.</strong> Gravestone, obituary, and census ages are often rounded. Always confirm a computed birth date against a primary birth or baptism record.</p>\n    </section>\n\n  </main>\n\n  <footer class=\"max-w-4xl mx-auto px-4 py-6 text-center text-xs text-gray-400\">\n    Age &amp; Birth-Date Calculator &mdash; <a href=\"https://github.com/halisonworks/public-app-studio\" class=\"underline hover:text-indigo-500\" target=\"_blank\" rel=\"noopener\">Halison App Studio</a>\n  </footer>\n\n<script>\n// ─── Date helpers ─────────────────────────────────────────────────────────────\n\nvar MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];\n\nfunction isLeap(y) {\n  return (y % 4 === 0 && y % 100 !== 0) || (y % 400 === 0);\n}\n\nfunction daysInMonth(m, y) {\n  // m is 1–12\n  var lengths = [31, isLeap(y) ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];\n  return lengths[m - 1];\n}\n\nfunction validDate(d, m, y) {\n  if (!Number.isFinite(d) || !Number.isFinite(m) || !Number.isFinite(y)) return false;\n  if (m < 1 || m > 12) return false;\n  if (d < 1 || d > daysInMonth(m, y)) return false;\n  return true;\n}\n\nfunction longDate(d, m, y) {\n  return d + ' ' + MONTHS[m - 1] + ' ' + y;\n}\n\nfunction isoDate(d, m, y) {\n  var pad = function (n, w) { var s = String(Math.abs(n)); while (s.length < w) s = '0' + s; return (n < 0 ? '-' : '') + s; };\n  return pad(y, 4) + '-' + pad(m, 2) + '-' + pad(d, 2);\n}\n\n// Day of week via a Julian-Day-Number style calc (proleptic Gregorian).\nvar DOW = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];\nfunction dayOfWeek(d, m, y) {\n  // Sakamoto's algorithm (Gregorian).\n  var t = [0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4];\n  var yy = y;\n  if (m < 3) yy -= 1;\n  var w = (yy + Math.floor(yy / 4) - Math.floor(yy / 100) + Math.floor(yy / 400) + t[m - 1] + d) % 7;\n  w = ((w % 7) + 7) % 7;\n  return DOW[w];\n}\n\n// Days since a fixed epoch (proleptic Gregorian) for total-day spans.\nfunction toDayNumber(d, m, y) {\n  var a = Math.floor((14 - m) / 12);\n  var yy = y + 4800 - a;\n  var mm = m + 12 * a - 3;\n  return d + Math.floor((153 * mm + 2) / 5) + 365 * yy + Math.floor(yy / 4) - Math.floor(yy / 100) + Math.floor(yy / 400) - 32045;\n}\n\n// ─── Core: birth from death + age (explicit borrow) ──────────────────────────\n\nfunction birthFromAge(Y, M, D, ay, am, ad) {\n  var approximate = false;\n  var day = D - ad;\n  var month = M;\n  var year = Y;\n\n  // 1. Borrow days using real month lengths.\n  while (day < 1) {\n    month -= 1;\n    if (month < 1) { month += 12; year -= 1; }\n    day += daysInMonth(month, year);\n  }\n\n  // 2. Subtract months.\n  month -= am;\n  while (month < 1) { month += 12; year -= 1; }\n\n  // 3. Subtract years.\n  year -= ay;\n\n  // 4. Clamp overlong day, flag approximate.\n  var maxDay = daysInMonth(month, year);\n  if (day > maxDay) { day = maxDay; approximate = true; }\n\n  return { d: day, m: month, y: year, approximate: approximate };\n}\n\n// ─── Core: exact Y/M/D between two dates (borrow in reverse) ──────────────────\n\nfunction diffYMD(d1, m1, y1, d2, m2, y2) {\n  // Assumes date2 >= date1.\n  var day = d2 - d1;\n  var month = m2 - m1;\n  var year = y2 - y1;\n\n  if (day < 0) {\n    month -= 1;\n    // borrow days from the month preceding date2's month\n    var bm = m2 - 1, by = y2;\n    if (bm < 1) { bm += 12; by -= 1; }\n    day += daysInMonth(bm, by);\n  }\n  if (month < 0) {\n    year -= 1;\n    month += 12;\n  }\n  return { y: year, m: month, d: day };\n}\n\n// ─── Formatting ───────────────────────────────────────────────────────────────\n\nfunction plural(n, word) { return n + ' ' + word + (n === 1 ? '' : 's'); }\n\nfunction ymdPhrase(y, m, d) {\n  var parts = [];\n  if (y) parts.push(plural(y, 'year'));\n  if (m) parts.push(plural(m, 'month'));\n  if (d || parts.length === 0) parts.push(plural(d, 'day'));\n  return parts.join(', ');\n}\n\nfunction fmtNum(n) { return n.toLocaleString('en-US'); }\n\n// ─── DOM helpers ──────────────────────────────────────────────────────────────\n\nfunction out(id) { return document.getElementById(id); }\n\nfunction fillMonths(sel, selected) {\n  for (var i = 1; i <= 12; i++) {\n    var o = document.createElement('option');\n    o.value = String(i);\n    o.textContent = i + ' — ' + MONTHS[i - 1];\n    if (i === selected) o.selected = true;\n    sel.appendChild(o);\n  }\n}\n\nfunction intVal(id) { return parseInt(out(id).value, 10); }\n\nfunction showError(msg) {\n  out('errorText').textContent = msg;\n  out('errorBanner').classList.remove('hidden');\n}\nfunction clearError() {\n  out('errorBanner').classList.add('hidden');\n}\n\n// ─── Tabs ─────────────────────────────────────────────────────────────────────\n\nvar currentTab = 'birth';\nfunction setTab(tab) {\n  currentTab = tab;\n  var tabs = ['birth', 'between', 'census'];\n  tabs.forEach(function (t) {\n    out('tab-' + t).classList.toggle('hidden', t !== tab);\n  });\n  document.querySelectorAll('.tab-btn').forEach(function (btn) {\n    btn.classList.toggle('active', btn.getAttribute('data-tab') === tab);\n  });\n  save();\n  recalc();\n}\n\ndocument.querySelectorAll('.tab-btn').forEach(function (btn) {\n  btn.addEventListener('click', function () { setTab(btn.getAttribute('data-tab')); });\n});\n\n// ─── Calculations per tab ─────────────────────────────────────────────────────\n\nfunction calcBirth() {\n  var D = intVal('b_dDay'), M = intVal('b_dMonth'), Y = intVal('b_dYear');\n  var ay = parseInt(out('b_ay').value, 10) || 0;\n  var am = parseInt(out('b_am').value, 10) || 0;\n  var ad = parseInt(out('b_ad').value, 10) || 0;\n\n  if (!validDate(D, M, Y)) { showError('Death date is not a real calendar date (check the day for that month and year).'); return false; }\n  if (ay < 0 || am < 0 || ad < 0) { showError('Age cannot be negative.'); return false; }\n\n  var b = birthFromAge(Y, M, D, ay, am, ad);\n  out('b_long').textContent = longDate(b.d, b.m, b.y);\n  out('b_iso').textContent = isoDate(b.d, b.m, b.y);\n  out('b_dow').textContent = b.y >= 1 ? dayOfWeek(b.d, b.m, b.y) + ' (Gregorian)' : '';\n\n  var flag = out('b_flag');\n  if (b.approximate) {\n    flag.classList.remove('hidden');\n    flag.textContent = 'Approximate — day clamped to month end after borrowing.';\n  } else {\n    flag.classList.add('hidden');\n  }\n  return true;\n}\n\nfunction calcBetween() {\n  var d1 = intVal('e_aDay'), m1 = intVal('e_aMonth'), y1 = intVal('e_aYear');\n  var d2 = intVal('e_bDay'), m2 = intVal('e_bMonth'), y2 = intVal('e_bYear');\n\n  if (!validDate(d1, m1, y1)) { showError('Date A is not a real calendar date.'); return false; }\n  if (!validDate(d2, m2, y2)) { showError('Date B is not a real calendar date.'); return false; }\n\n  var n1 = toDayNumber(d1, m1, y1);\n  var n2 = toDayNumber(d2, m2, y2);\n  if (n2 < n1) { showError('Date B (later) must be on or after Date A (earlier).'); return false; }\n\n  var r = diffYMD(d1, m1, y1, d2, m2, y2);\n  var totalDays = n2 - n1;\n  var totalWeeks = Math.floor(totalDays / 7);\n\n  out('e_long').textContent = ymdPhrase(r.y, r.m, r.d);\n  out('e_y').textContent = fmtNum(r.y);\n  out('e_m').textContent = fmtNum(r.m);\n  out('e_d').textContent = fmtNum(r.d);\n  out('e_total').textContent = fmtNum(totalDays);\n  out('e_weeks').textContent = fmtNum(totalWeeks);\n  out('e_stated').textContent = fmtNum(r.y);\n  return true;\n}\n\nfunction calcCensus() {\n  var d = intVal('c_day'), m = intVal('c_month'), y = intVal('c_year');\n  var age = parseInt(out('c_age').value, 10);\n\n  if (!validDate(d, m, y)) { showError('Census date is not a real calendar date.'); return false; }\n  if (!Number.isFinite(age) || age < 0) { showError('Stated age must be 0 or more.'); return false; }\n\n  // Born on or before: census date minus `age` years.\n  var beforeY = y - age;\n  // Born after (exclusive): census date minus (age + 1) years.\n  var afterY = y - age - 1;\n\n  // Handle 29 Feb edge: clamp day for the target year/month.\n  function clampDate(dd, mm, yy) {\n    var max = daysInMonth(mm, yy);\n    return { d: Math.min(dd, max), m: mm, y: yy };\n  }\n  var before = clampDate(d, m, beforeY);\n  var after = clampDate(d, m, afterY);\n\n  out('c_ageEcho').textContent = age;\n  out('c_after').textContent = longDate(after.d, after.m, after.y);\n  out('c_before').textContent = longDate(before.d, before.m, before.y);\n\n  // Most likely birth year: the window spans two calendar years; the larger\n  // portion typically falls in (census year - age - 1) for births later in the\n  // calendar year, but the headline figure genealogists quote is census year - age.\n  out('c_likely').textContent = afterY + '–' + beforeY;\n  return true;\n}\n\nfunction recalc() {\n  clearError();\n  var ok = true;\n  if (currentTab === 'birth') ok = calcBirth();\n  else if (currentTab === 'between') ok = calcBetween();\n  else if (currentTab === 'census') ok = calcCensus();\n  if (ok) save();\n}\n\n// ─── Persistence ──────────────────────────────────────────────────────────────\n\nvar FIELD_IDS = [\n  'b_dDay','b_dMonth','b_dYear','b_ay','b_am','b_ad',\n  'e_aDay','e_aMonth','e_aYear','e_bDay','e_bMonth','e_bYear',\n  'c_day','c_month','c_year','c_age'\n];\n\nfunction save() {\n  try {\n    var data = { tab: currentTab };\n    FIELD_IDS.forEach(function (id) { data[id] = out(id).value; });\n    localStorage.setItem('genealogyAgeCalc', JSON.stringify(data));\n  } catch (e) { /* ignore */ }\n}\n\nfunction restore() {\n  try {\n    var saved = JSON.parse(localStorage.getItem('genealogyAgeCalc'));\n    if (saved) {\n      FIELD_IDS.forEach(function (id) {\n        if (saved[id] !== undefined && saved[id] !== null) out(id).value = saved[id];\n      });\n      if (saved.tab) currentTab = saved.tab;\n    }\n  } catch (e) { /* ignore */ }\n}\n\n// ─── Init ─────────────────────────────────────────────────────────────────────\n\nfillMonths(out('b_dMonth'), 3);\nfillMonths(out('e_aMonth'), 1);\nfillMonths(out('e_bMonth'), 3);\nfillMonths(out('c_month'), 4);\n\nrestore();\n\nFIELD_IDS.forEach(function (id) {\n  out(id).addEventListener('input', recalc);\n  out(id).addEventListener('change', recalc);\n});\n\nsetTab(currentTab);\n</script>\n</body>\n</html>\n",
