{
  "schema": "app-studio/canvas@1",
  "id": "example-pomodoro-timer",
  "name": "pomodoro-timer.html",
  "code": "<!DOCTYPE html>\n<!--\n  Pomodoro Timer — Halison App Studio example\n\n  A focus timer with work and break cycles, a circular countdown, adjustable\n  durations, and a daily session count. Saves your settings to the browser.\n\n  From the Halison App Studio public library:\n  https://github.com/halisonworks/public-app-studio\n\n  Permitted use: personal, educational, and other non-commercial use. You may\n  modify it, but keep this header and the source link intact, and do not sell,\n  commercialize, or republish it. Released under the Halison App Studio Examples\n  License — see the LICENSE file in the repository above.\n-->\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Pomodoro Timer</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <script>\n    tailwind.config = {\n      theme: {\n        extend: {\n          colors: {\n            pomored: { DEFAULT: '#e05c5c', dark: '#c94a4a' },\n            pomegreen: { DEFAULT: '#4caf82', dark: '#3a9068' },\n            pomoblue: { DEFAULT: '#4c8faf', dark: '#3a7a96' },\n            surface: '#1e1e2e',\n            panel: '#2a2a3e',\n            border: '#3a3a52',\n            text: '#e8e8f0',\n            muted: '#8888a8',\n          }\n        }\n      }\n    };\n  </script>\n  <style>\n    body { background-color: #1e1e2e; color: #e8e8f0; font-family: 'Segoe UI', system-ui, sans-serif; }\n    .ring-track { stroke: #3a3a52; }\n    .ring-progress { transition: stroke-dashoffset 0.5s linear; transform-origin: center; transform: rotate(-90deg); }\n    .phase-work .ring-progress { stroke: #e05c5c; }\n    .phase-short .ring-progress { stroke: #4caf82; }\n    .phase-long .ring-progress { stroke: #4c8faf; }\n    .phase-work .phase-badge { background-color: #e05c5c22; color: #e05c5c; border: 1px solid #e05c5c55; }\n    .phase-short .phase-badge { background-color: #4caf8222; color: #4caf82; border: 1px solid #4caf8255; }\n    .phase-long .phase-badge { background-color: #4c8faf22; color: #4c8faf; border: 1px solid #4c8faf55; }\n    .phase-work .timer-text { color: #e05c5c; }\n    .phase-short .timer-text { color: #4caf82; }\n    .phase-long .timer-text { color: #4c8faf; }\n    .btn-primary { background-color: #e05c5c; }\n    .btn-primary:hover { background-color: #c94a4a; }\n    .phase-short .btn-primary { background-color: #4caf82; }\n    .phase-short .btn-primary:hover { background-color: #3a9068; }\n    .phase-long .btn-primary { background-color: #4c8faf; }\n    .phase-long .btn-primary:hover { background-color: #3a7a96; }\n    input[type=range] { accent-color: #e05c5c; }\n    input[type=number] { background-color: #2a2a3e; border: 1px solid #3a3a52; color: #e8e8f0; border-radius: 0.375rem; padding: 0.375rem 0.5rem; width: 5rem; text-align: center; }\n    input[type=number]:focus { outline: none; border-color: #e05c5c; }\n    .dot-indicator { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }\n    .dot-done { background-color: #e05c5c; }\n    .dot-pending { background-color: #3a3a52; }\n    .settings-panel { background-color: #2a2a3e; border: 1px solid #3a3a52; border-radius: 1rem; }\n    details summary { cursor: pointer; user-select: none; list-style: none; }\n    details summary::-webkit-details-marker { display: none; }\n    details[open] .chevron { transform: rotate(180deg); }\n    .chevron { transition: transform 0.2s; display: inline-block; }\n  </style>\n</head>\n<body class=\"min-h-screen flex flex-col items-center justify-center p-4\">\n\n  <div id=\"app\" class=\"phase-work w-full max-w-sm flex flex-col items-center gap-6\">\n\n    <!-- Title -->\n    <h1 class=\"text-2xl font-semibold tracking-widest uppercase text-muted\">Pomodoro</h1>\n\n    <!-- Phase badge -->\n    <span id=\"phaseBadge\" class=\"phase-badge text-xs font-semibold uppercase tracking-widest px-3 py-1 rounded-full\">Focus</span>\n\n    <!-- Circular ring + timer -->\n    <div class=\"relative flex items-center justify-center\" style=\"width:240px;height:240px;\">\n      <svg width=\"240\" height=\"240\" viewBox=\"0 0 240 240\" class=\"absolute inset-0\">\n        <circle class=\"ring-track\" cx=\"120\" cy=\"120\" r=\"108\" fill=\"none\" stroke-width=\"10\"/>\n        <circle id=\"ringProgress\" class=\"ring-progress\" cx=\"120\" cy=\"120\" r=\"108\" fill=\"none\" stroke-width=\"10\"\n          stroke-linecap=\"round\"\n          stroke-dasharray=\"678.58\"\n          stroke-dashoffset=\"0\"/>\n      </svg>\n      <div class=\"flex flex-col items-center z-10\">\n        <span id=\"timerDisplay\" class=\"timer-text text-6xl font-mono font-bold tabular-nums\">25:00</span>\n        <span id=\"sessionDots\" class=\"flex gap-1 mt-3\"></span>\n      </div>\n    </div>\n\n    <!-- Controls -->\n    <div class=\"flex gap-3\">\n      <button id=\"btnStartPause\"\n        class=\"btn-primary text-white font-semibold px-8 py-3 rounded-xl text-lg shadow transition-colors\">\n        Start\n      </button>\n      <button id=\"btnReset\"\n        class=\"bg-panel border border-border text-muted hover:text-text hover:border-muted font-semibold px-5 py-3 rounded-xl text-lg transition-colors\">\n        Reset\n      </button>\n    </div>\n\n    <!-- Today's sessions count -->\n    <div class=\"flex items-center gap-2 text-sm text-muted\">\n      <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-4 h-4\" viewBox=\"0 0 20 20\" fill=\"currentColor\">\n        <path fill-rule=\"evenodd\" d=\"M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z\" clip-rule=\"evenodd\"/>\n      </svg>\n      <span>Today: <span id=\"sessionsCount\" class=\"font-semibold text-text\">0</span> focus sessions completed</span>\n    </div>\n\n    <!-- Settings accordion -->\n    <details class=\"settings-panel w-full p-4\" id=\"settingsDetails\">\n      <summary class=\"flex items-center justify-between text-sm font-semibold text-muted uppercase tracking-widest\">\n        <span>Settings</span>\n        <span class=\"chevron text-muted\">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-4 h-4\" viewBox=\"0 0 20 20\" fill=\"currentColor\">\n            <path fill-rule=\"evenodd\" d=\"M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z\" clip-rule=\"evenodd\"/>\n          </svg>\n        </span>\n      </summary>\n      <div class=\"mt-4 flex flex-col gap-4\">\n        <div class=\"grid grid-cols-3 gap-3 text-center text-xs text-muted uppercase tracking-wide\">\n          <span>Focus</span>\n          <span>Short break</span>\n          <span>Long break</span>\n        </div>\n        <div class=\"grid grid-cols-3 gap-3 text-center\">\n          <div class=\"flex flex-col items-center gap-1\">\n            <input type=\"number\" id=\"setWork\" min=\"1\" max=\"120\" value=\"25\" />\n            <span class=\"text-xs text-muted\">min</span>\n          </div>\n          <div class=\"flex flex-col items-center gap-1\">\n            <input type=\"number\" id=\"setShort\" min=\"1\" max=\"60\" value=\"5\" />\n            <span class=\"text-xs text-muted\">min</span>\n          </div>\n          <div class=\"flex flex-col items-center gap-1\">\n            <input type=\"number\" id=\"setLong\" min=\"1\" max=\"120\" value=\"15\" />\n            <span class=\"text-xs text-muted\">min</span>\n          </div>\n        </div>\n        <div class=\"border-t border-border pt-3 flex flex-col gap-2\">\n          <label class=\"flex items-center gap-2 cursor-pointer text-sm text-muted\">\n            <input type=\"checkbox\" id=\"setSound\" checked class=\"w-4 h-4 accent-pomored rounded\" />\n            <span>Play beep at phase end</span>\n          </label>\n          <button id=\"btnApply\"\n            class=\"mt-1 w-full bg-panel border border-border hover:border-muted text-text text-sm font-semibold py-2 rounded-lg transition-colors\">\n            Apply\n          </button>\n          <button id=\"btnResetSessions\"\n            class=\"w-full text-muted text-xs hover:text-text py-1 transition-colors\">\n            Reset today's session count\n          </button>\n        </div>\n      </div>\n    </details>\n\n  </div>\n\n  <script>\n    (function () {\n      'use strict';\n\n      // ── Constants ──────────────────────────────────────────────────────────\n      var RING_RADIUS = 108;\n      var RING_CIRCUMFERENCE = 2 * Math.PI * RING_RADIUS; // ≈ 678.58\n      var STORAGE_KEY = 'pomodoro_v1';\n      var TODAY_KEY = 'pomodoro_today_v1';\n\n      // ── State ──────────────────────────────────────────────────────────────\n      var settings = { work: 25, short: 5, long: 15, sound: true };\n      var PHASES = ['work', 'short', 'long'];\n      // cycle: 4 work sessions then 1 long break; between works → short break\n      var currentPhase = 'work'; // 'work' | 'short' | 'long'\n      var workSessionsInCycle = 0; // counts work sessions completed in current cycle\n      var totalSeconds = 0;\n      var remainingSeconds = 0;\n      var running = false;\n      var intervalId = null;\n      var todaySessions = 0;\n      var todayDate = '';\n\n      // ── DOM ────────────────────────────────────────────────────────────────\n      var app = document.getElementById('app');\n      var phaseBadge = document.getElementById('phaseBadge');\n      var ringProgress = document.getElementById('ringProgress');\n      var timerDisplay = document.getElementById('timerDisplay');\n      var sessionDots = document.getElementById('sessionDots');\n      var sessionsCount = document.getElementById('sessionsCount');\n      var btnStartPause = document.getElementById('btnStartPause');\n      var btnReset = document.getElementById('btnReset');\n      var setWork = document.getElementById('setWork');\n      var setShort = document.getElementById('setShort');\n      var setLong = document.getElementById('setLong');\n      var setSound = document.getElementById('setSound');\n      var btnApply = document.getElementById('btnApply');\n      var btnResetSessions = document.getElementById('btnResetSessions');\n\n      // ── Persistence ────────────────────────────────────────────────────────\n      function loadStorage() {\n        try {\n          var raw = localStorage.getItem(STORAGE_KEY);\n          if (raw) {\n            var parsed = JSON.parse(raw);\n            if (parsed.work) settings.work = Math.max(1, Math.min(120, parseInt(parsed.work, 10) || 25));\n            if (parsed.short) settings.short = Math.max(1, Math.min(60, parseInt(parsed.short, 10) || 5));\n            if (parsed.long) settings.long = Math.max(1, Math.min(120, parseInt(parsed.long, 10) || 15));\n            settings.sound = parsed.sound !== false;\n          }\n        } catch (e) { /* ignore */ }\n\n        try {\n          var todayRaw = localStorage.getItem(TODAY_KEY);\n          var todayStr = new Date().toISOString().slice(0, 10);\n          if (todayRaw) {\n            var t = JSON.parse(todayRaw);\n            if (t.date === todayStr) {\n              todaySessions = parseInt(t.count, 10) || 0;\n              todayDate = todayStr;\n            } else {\n              todaySessions = 0;\n              todayDate = todayStr;\n            }\n          } else {\n            todaySessions = 0;\n            todayDate = todayStr;\n          }\n        } catch (e) {\n          todaySessions = 0;\n          todayDate = new Date().toISOString().slice(0, 10);\n        }\n      }\n\n      function saveSettings() {\n        try {\n          localStorage.setItem(STORAGE_KEY, JSON.stringify(settings));\n        } catch (e) { /* ignore */ }\n      }\n\n      function saveTodaySessions() {\n        try {\n          var todayStr = new Date().toISOString().slice(0, 10);\n          // If the date rolled over, reset\n          if (todayStr !== todayDate) {\n            todaySessions = 0;\n            todayDate = todayStr;\n          }\n          localStorage.setItem(TODAY_KEY, JSON.stringify({ date: todayDate, count: todaySessions }));\n        } catch (e) { /* ignore */ }\n      }\n\n      // ── Audio beep ─────────────────────────────────────────────────────────\n      function playBeep() {\n        if (!settings.sound) return;\n        try {\n          var AudioCtx = window.AudioContext || window.webkitAudioContext;\n          if (!AudioCtx) return;\n          var ctx = new AudioCtx();\n          function tone(freq, startTime, duration, gain) {\n            var osc = ctx.createOscillator();\n            var gainNode = ctx.createGain();\n            osc.connect(gainNode);\n            gainNode.connect(ctx.destination);\n            osc.type = 'sine';\n            osc.frequency.setValueAtTime(freq, startTime);\n            gainNode.gain.setValueAtTime(gain, startTime);\n            gainNode.gain.exponentialRampToValueAtTime(0.001, startTime + duration);\n            osc.start(startTime);\n            osc.stop(startTime + duration);\n          }\n          var now = ctx.currentTime;\n          tone(880, now, 0.25, 0.4);\n          tone(1100, now + 0.28, 0.2, 0.3);\n          tone(1320, now + 0.52, 0.35, 0.25);\n          // close after sounds finish\n          setTimeout(function () { try { ctx.close(); } catch (e) { /* ignore */ } }, 1200);\n        } catch (e) { /* ignore */ }\n      }\n\n      // ── Timer logic ────────────────────────────────────────────────────────\n      function phaseDuration(phase) {\n        if (phase === 'work') return settings.work * 60;\n        if (phase === 'short') return settings.short * 60;\n        return settings.long * 60;\n      }\n\n      function phaseLabel(phase) {\n        if (phase === 'work') return 'Focus';\n        if (phase === 'short') return 'Short Break';\n        return 'Long Break';\n      }\n\n      function phaseCssClass(phase) {\n        if (phase === 'work') return 'phase-work';\n        if (phase === 'short') return 'phase-short';\n        return 'phase-long';\n      }\n\n      function formatTime(sec) {\n        var m = Math.floor(sec / 60);\n        var s = sec % 60;\n        return (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;\n      }\n\n      function updateRing() {\n        var fraction = totalSeconds > 0 ? remainingSeconds / totalSeconds : 1;\n        var offset = RING_CIRCUMFERENCE * (1 - fraction);\n        ringProgress.setAttribute('stroke-dashoffset', offset.toFixed(2));\n      }\n\n      function updateDots() {\n        sessionDots.innerHTML = '';\n        for (var i = 0; i < 4; i++) {\n          var dot = document.createElement('span');\n          dot.className = 'dot-indicator ' + (i < workSessionsInCycle ? 'dot-done' : 'dot-pending');\n          sessionDots.appendChild(dot);\n        }\n      }\n\n      function updateUI() {\n        var label = formatTime(remainingSeconds);\n        timerDisplay.textContent = label;\n        document.title = label + ' — ' + phaseLabel(currentPhase) + ' | Pomodoro';\n        updateRing();\n        updateDots();\n        phaseBadge.textContent = phaseLabel(currentPhase);\n        // Remove old phase classes\n        app.classList.remove('phase-work', 'phase-short', 'phase-long');\n        app.classList.add(phaseCssClass(currentPhase));\n        sessionsCount.textContent = todaySessions;\n        btnStartPause.textContent = running ? 'Pause' : (remainingSeconds < totalSeconds ? 'Resume' : 'Start');\n      }\n\n      function syncInputsToSettings() {\n        setWork.value = settings.work;\n        setShort.value = settings.short;\n        setLong.value = settings.long;\n        setSound.checked = settings.sound;\n      }\n\n      function initPhase(phase) {\n        currentPhase = phase;\n        totalSeconds = phaseDuration(phase);\n        remainingSeconds = totalSeconds;\n        running = false;\n        clearTimer();\n        updateUI();\n      }\n\n      function clearTimer() {\n        if (intervalId !== null) {\n          clearInterval(intervalId);\n          intervalId = null;\n        }\n      }\n\n      function tick() {\n        if (remainingSeconds <= 0) {\n          clearTimer();\n          running = false;\n          onPhaseEnd();\n          return;\n        }\n        remainingSeconds--;\n        updateUI();\n      }\n\n      function onPhaseEnd() {\n        playBeep();\n        if (currentPhase === 'work') {\n          workSessionsInCycle++;\n          todaySessions++;\n          saveTodaySessions();\n          if (workSessionsInCycle >= 4) {\n            workSessionsInCycle = 0;\n            initPhase('long');\n          } else {\n            initPhase('short');\n          }\n        } else {\n          initPhase('work');\n        }\n        // Auto-advance: start next phase automatically\n        startTimer();\n      }\n\n      function startTimer() {\n        if (running) return;\n        running = true;\n        intervalId = setInterval(tick, 1000);\n        updateUI();\n      }\n\n      function pauseTimer() {\n        running = false;\n        clearTimer();\n        updateUI();\n      }\n\n      function resetTimer() {\n        clearTimer();\n        running = false;\n        initPhase(currentPhase);\n        updateUI();\n      }\n\n      // ── Event handlers ─────────────────────────────────────────────────────\n      btnStartPause.addEventListener('click', function () {\n        if (running) {\n          pauseTimer();\n        } else {\n          startTimer();\n        }\n      });\n\n      btnReset.addEventListener('click', function () {\n        resetTimer();\n      });\n\n      btnApply.addEventListener('click', function () {\n        var w = parseInt(setWork.value, 10);\n        var s = parseInt(setShort.value, 10);\n        var l = parseInt(setLong.value, 10);\n        if (!isNaN(w) && w >= 1 && w <= 120) settings.work = w;\n        if (!isNaN(s) && s >= 1 && s <= 60) settings.short = s;\n        if (!isNaN(l) && l >= 1 && l <= 120) settings.long = l;\n        settings.sound = setSound.checked;\n        saveSettings();\n        syncInputsToSettings();\n        // Re-init current phase with new duration only if timer not running\n        if (!running) {\n          totalSeconds = phaseDuration(currentPhase);\n          remainingSeconds = totalSeconds;\n          updateUI();\n        }\n        // Close the settings panel\n        document.getElementById('settingsDetails').removeAttribute('open');\n      });\n\n      btnResetSessions.addEventListener('click', function () {\n        todaySessions = 0;\n        saveTodaySessions();\n        updateUI();\n      });\n\n      // ── Init ───────────────────────────────────────────────────────────────\n      loadStorage();\n      syncInputsToSettings();\n      ringProgress.setAttribute('stroke-dasharray', RING_CIRCUMFERENCE.toFixed(2));\n      workSessionsInCycle = 0;\n      initPhase('work');\n\n    }());\n  </script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Pomodoro Timer",
    "windowTitle": "Pomodoro Timer",
    "bundleId": "com.halisonworks.pomodorotimer",
    "iconPath": null
  },
  "categoryId": null,
  "source": "import",
  "createdAt": "2026-06-02T12:00:00.000Z",
  "updatedAt": "2026-06-02T12:00:00.000Z",
  "sharedAt": "2026-06-02T12:00:00.000Z"
}
