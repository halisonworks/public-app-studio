{
  "schema": "app-studio/canvas@1",
  "id": "example-invoice-generator",
  "name": "invoice-generator.html",
  "code": "<!DOCTYPE html>\n<!--\n  Invoice Generator — Halison App Studio example\n\n  Build a clean invoice: your details, the client's, line items with live totals,\n  tax and currency. Saves to your browser; print-friendly via App Studio's Print.\n\n  From the Halison App Studio public library:\n  https://github.com/halisonworks/public-app-studio\n\n  Permitted use: personal, educational, and other non-commercial use. You may\n  modify it, but keep this header and the source link intact, and do not sell,\n  commercialize, or republish it. Released under the Halison App Studio Examples\n  License — see the LICENSE file in the repository above.\n-->\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Invoice Generator</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    @media print {\n      .no-print { display: none !important; }\n      body { background: white !important; }\n      #invoice-wrapper {\n        box-shadow: none !important;\n        border: none !important;\n        margin: 0 !important;\n        padding: 0 !important;\n      }\n      #app-shell { padding: 0 !important; background: white !important; }\n    }\n    [contenteditable]:focus { outline: 2px solid #6366f1; border-radius: 2px; }\n    [contenteditable]:empty:before { content: attr(data-placeholder); color: #9ca3af; }\n    input[type=\"number\"]::-webkit-inner-spin-button,\n    input[type=\"number\"]::-webkit-outer-spin-button { opacity: 1; }\n  </style>\n</head>\n<body class=\"bg-gray-100 min-h-screen\" id=\"app-shell\">\n\n  <!-- Top toolbar (no-print) -->\n  <div class=\"no-print sticky top-0 z-10 bg-white border-b border-gray-200 shadow-sm\">\n    <div class=\"max-w-4xl mx-auto px-4 py-3 flex flex-wrap items-center gap-3\">\n      <span class=\"font-semibold text-indigo-600 text-lg tracking-tight\">Invoice Generator</span>\n      <div class=\"flex items-center gap-2 ml-auto flex-wrap\">\n        <!-- Currency -->\n        <label class=\"text-sm text-gray-600 font-medium\">Currency:</label>\n        <select id=\"currency-select\"\n          class=\"text-sm border border-gray-300 rounded px-2 py-1 focus:outline-none focus:ring-2 focus:ring-indigo-400 bg-white\">\n          <option value=\"kr\">kr (NOK)</option>\n          <option value=\"$\">$ (USD)</option>\n          <option value=\"€\">€ (EUR)</option>\n          <option value=\"£\">£ (GBP)</option>\n          <option value=\"SEK\">SEK</option>\n          <option value=\"DKK\">DKK</option>\n        </select>\n        <!-- VAT -->\n        <label class=\"text-sm text-gray-600 font-medium ml-2\">Tax / VAT:</label>\n        <select id=\"vat-select\"\n          class=\"text-sm border border-gray-300 rounded px-2 py-1 focus:outline-none focus:ring-2 focus:ring-indigo-400 bg-white\">\n          <option value=\"0\">0 %</option>\n          <option value=\"5\">5 %</option>\n          <option value=\"10\">10 %</option>\n          <option value=\"12\">12 %</option>\n          <option value=\"15\">15 %</option>\n          <option value=\"20\">20 %</option>\n          <option value=\"25\" selected>25 %</option>\n        </select>\n        <!-- Clear button -->\n        <button id=\"btn-clear\"\n          class=\"ml-2 text-sm px-3 py-1.5 bg-red-50 hover:bg-red-100 text-red-600 border border-red-200 rounded font-medium transition\">\n          New Invoice\n        </button>\n      </div>\n    </div>\n  </div>\n\n  <!-- Main area -->\n  <div class=\"max-w-4xl mx-auto px-4 py-8\">\n    <div id=\"invoice-wrapper\"\n      class=\"bg-white rounded-xl shadow-lg border border-gray-200 overflow-hidden\">\n\n      <!-- Invoice header band -->\n      <div class=\"bg-indigo-700 px-8 py-6 flex flex-col sm:flex-row sm:items-start gap-4\">\n        <div class=\"flex-1\">\n          <div\n            id=\"business-name\"\n            contenteditable=\"true\"\n            data-placeholder=\"Your Business Name\"\n            data-key=\"businessName\"\n            class=\"text-2xl font-bold text-white focus:bg-indigo-600 focus:rounded px-1 -ml-1 min-w-[180px] block\">\n          </div>\n          <div\n            id=\"business-address\"\n            contenteditable=\"true\"\n            data-placeholder=\"123 Main Street, Oslo, Norway\"\n            data-key=\"businessAddress\"\n            class=\"text-indigo-200 text-sm mt-1 whitespace-pre-wrap focus:bg-indigo-600 focus:rounded px-1 -ml-1 block\">\n          </div>\n          <div\n            id=\"business-email\"\n            contenteditable=\"true\"\n            data-placeholder=\"hello@yourbusiness.no\"\n            data-key=\"businessEmail\"\n            class=\"text-indigo-200 text-sm mt-0.5 focus:bg-indigo-600 focus:rounded px-1 -ml-1 block\">\n          </div>\n        </div>\n        <div class=\"text-right\">\n          <div class=\"text-indigo-100 text-xs uppercase tracking-widest font-semibold mb-1\">Invoice</div>\n          <div class=\"flex items-center justify-end gap-2\">\n            <span class=\"text-indigo-200 text-sm\">#</span>\n            <input id=\"invoice-number\" type=\"text\" data-key=\"invoiceNumber\"\n              placeholder=\"2025-001\"\n              class=\"bg-indigo-600 text-white text-sm font-semibold rounded px-2 py-0.5 w-28 text-right border border-indigo-400 focus:outline-none focus:ring-2 focus:ring-white placeholder-indigo-300\" />\n          </div>\n        </div>\n      </div>\n\n      <!-- Dates + client block -->\n      <div class=\"px-8 py-6 grid grid-cols-1 sm:grid-cols-2 gap-8 border-b border-gray-100\">\n        <!-- Bill to -->\n        <div>\n          <div class=\"text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2\">Bill To</div>\n          <div\n            id=\"client-name\"\n            contenteditable=\"true\"\n            data-placeholder=\"Acme AS\"\n            data-key=\"clientName\"\n            class=\"font-semibold text-gray-800 text-base focus:outline-none focus:bg-indigo-50 focus:rounded px-1 -ml-1 block\">\n          </div>\n          <div\n            id=\"client-address\"\n            contenteditable=\"true\"\n            data-placeholder=\"456 Client Road, Bergen, Norway\"\n            data-key=\"clientAddress\"\n            class=\"text-gray-500 text-sm mt-1 whitespace-pre-wrap focus:outline-none focus:bg-indigo-50 focus:rounded px-1 -ml-1 block\">\n          </div>\n        </div>\n        <!-- Dates -->\n        <div class=\"flex flex-col gap-3 sm:items-end\">\n          <div class=\"flex items-center gap-3\">\n            <label class=\"text-xs font-semibold text-gray-400 uppercase tracking-wider w-24 text-right\">Issue Date</label>\n            <input id=\"issue-date\" type=\"date\" data-key=\"issueDate\"\n              class=\"text-sm border border-gray-200 rounded px-2 py-1 focus:outline-none focus:ring-2 focus:ring-indigo-400\" />\n          </div>\n          <div class=\"flex items-center gap-3\">\n            <label class=\"text-xs font-semibold text-gray-400 uppercase tracking-wider w-24 text-right\">Due Date</label>\n            <input id=\"due-date\" type=\"date\" data-key=\"dueDate\"\n              class=\"text-sm border border-gray-200 rounded px-2 py-1 focus:outline-none focus:ring-2 focus:ring-indigo-400\" />\n          </div>\n        </div>\n      </div>\n\n      <!-- Line items -->\n      <div class=\"px-8 pt-6 pb-2\">\n        <table class=\"w-full text-sm\" id=\"line-items-table\">\n          <thead>\n            <tr class=\"border-b-2 border-gray-200 text-left\">\n              <th class=\"pb-2 font-semibold text-gray-500 uppercase tracking-wider text-xs w-full\">Description</th>\n              <th class=\"pb-2 font-semibold text-gray-500 uppercase tracking-wider text-xs text-right whitespace-nowrap pr-4\">Qty</th>\n              <th class=\"pb-2 font-semibold text-gray-500 uppercase tracking-wider text-xs text-right whitespace-nowrap pr-4\">Unit Price</th>\n              <th class=\"pb-2 font-semibold text-gray-500 uppercase tracking-wider text-xs text-right whitespace-nowrap\">Amount</th>\n              <th class=\"pb-2 no-print w-8\"></th>\n            </tr>\n          </thead>\n          <tbody id=\"line-items-body\">\n            <!-- rows injected by JS -->\n          </tbody>\n        </table>\n\n        <!-- Add row button -->\n        <div class=\"no-print mt-3 mb-4\">\n          <button id=\"btn-add-row\"\n            class=\"flex items-center gap-1.5 text-sm text-indigo-600 hover:text-indigo-800 font-medium border border-dashed border-indigo-300 hover:border-indigo-500 rounded px-3 py-1.5 transition\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-4 w-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 4v16m8-8H4\"/>\n            </svg>\n            Add line item\n          </button>\n        </div>\n      </div>\n\n      <!-- Totals -->\n      <div class=\"px-8 pb-8\">\n        <div class=\"flex justify-end\">\n          <div class=\"w-full sm:w-72 border-t border-gray-200 pt-4 space-y-2\">\n            <div class=\"flex justify-between text-sm text-gray-600\">\n              <span>Subtotal</span>\n              <span id=\"subtotal-display\" class=\"font-medium tabular-nums\">kr 0.00</span>\n            </div>\n            <div class=\"flex justify-between text-sm text-gray-600\">\n              <span id=\"tax-label\">VAT (25 %)</span>\n              <span id=\"tax-display\" class=\"font-medium tabular-nums\">kr 0.00</span>\n            </div>\n            <div class=\"flex justify-between text-base font-bold text-gray-800 border-t border-gray-300 pt-2 mt-2\">\n              <span>Total</span>\n              <span id=\"total-display\" class=\"tabular-nums text-indigo-700\">kr 0.00</span>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Notes / payment info -->\n      <div class=\"px-8 pb-8 border-t border-gray-100 pt-6\">\n        <div class=\"text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2\">Notes &amp; Payment Info</div>\n        <div\n          id=\"notes\"\n          contenteditable=\"true\"\n          data-placeholder=\"Bank: Nordea — Account: 1234.56.78901 — Please reference invoice number when paying. Thank you for your business!\"\n          data-key=\"notes\"\n          class=\"text-sm text-gray-600 min-h-[48px] whitespace-pre-wrap focus:outline-none focus:bg-indigo-50 focus:rounded px-1 -ml-1 block\">\n        </div>\n      </div>\n\n      <!-- Footer band -->\n      <div class=\"bg-gray-50 border-t border-gray-200 px-8 py-4 text-center text-xs text-gray-400\">\n        <span id=\"footer-business-name\"></span> &mdash; Thank you for your business.\n      </div>\n\n    </div><!-- /invoice-wrapper -->\n  </div><!-- /main area -->\n\n<script>\n(function () {\n  'use strict';\n\n  // ── State ──────────────────────────────────────────────────────────────────\n  var DEFAULT_LINES = [\n    { desc: 'Web Design & Development', qty: 1, price: 15000 },\n    { desc: 'SEO Audit & Recommendations', qty: 3, price: 2500 },\n    { desc: 'Monthly Maintenance (hours)', qty: 5, price: 850 }\n  ];\n\n  var state = {\n    businessName: 'Freelance Studio AS',\n    businessAddress: 'Storgata 12, 0155 Oslo\\nNorway',\n    businessEmail: 'post@freelancestudio.no',\n    clientName: 'Acme Solutions AS',\n    clientAddress: 'Drammensveien 45\\n0271 Oslo, Norway',\n    invoiceNumber: '2025-001',\n    issueDate: '',\n    dueDate: '',\n    notes: 'Bank: DNB — Account: 1503.25.48720\\nPlease reference the invoice number when paying. Thank you for your business!',\n    currency: 'kr',\n    vatRate: 25,\n    lines: JSON.parse(JSON.stringify(DEFAULT_LINES))\n  };\n\n  // Set default dates (today + 30 days)\n  var today = new Date();\n  var due = new Date(today);\n  due.setDate(due.getDate() + 30);\n  function fmtDate(d) {\n    var mm = ('0' + (d.getMonth() + 1)).slice(-2);\n    var dd = ('0' + d.getDate()).slice(-2);\n    return d.getFullYear() + '-' + mm + '-' + dd;\n  }\n  state.issueDate = fmtDate(today);\n  state.dueDate = fmtDate(due);\n\n  // ── LocalStorage ──────────────────────────────────────────────────────────\n  var LS_KEY = 'invoice-generator-v1';\n\n  function saveState() {\n    try { localStorage.setItem(LS_KEY, JSON.stringify(state)); } catch(e) {}\n  }\n\n  function loadState() {\n    try {\n      var raw = localStorage.getItem(LS_KEY);\n      if (!raw) return;\n      var saved = JSON.parse(raw);\n      Object.assign(state, saved);\n    } catch(e) {}\n  }\n\n  // ── DOM refs ──────────────────────────────────────────────────────────────\n  var elBusinessName    = document.getElementById('business-name');\n  var elBusinessAddress = document.getElementById('business-address');\n  var elBusinessEmail   = document.getElementById('business-email');\n  var elClientName      = document.getElementById('client-name');\n  var elClientAddress   = document.getElementById('client-address');\n  var elInvoiceNumber   = document.getElementById('invoice-number');\n  var elIssueDate       = document.getElementById('issue-date');\n  var elDueDate         = document.getElementById('due-date');\n  var elNotes           = document.getElementById('notes');\n  var elCurrency        = document.getElementById('currency-select');\n  var elVat             = document.getElementById('vat-select');\n  var elBody            = document.getElementById('line-items-body');\n  var elSubtotal        = document.getElementById('subtotal-display');\n  var elTaxDisplay      = document.getElementById('tax-display');\n  var elTotal           = document.getElementById('total-display');\n  var elTaxLabel        = document.getElementById('tax-label');\n  var elFooterName      = document.getElementById('footer-business-name');\n  var btnAddRow         = document.getElementById('btn-add-row');\n  var btnClear          = document.getElementById('btn-clear');\n\n  // ── Helpers ───────────────────────────────────────────────────────────────\n  function fmt(n) {\n    var sym = state.currency;\n    var num = n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });\n    return sym + ' ' + num;\n  }\n\n  // ── Render line items ─────────────────────────────────────────────────────\n  function renderLines() {\n    elBody.innerHTML = '';\n    state.lines.forEach(function (line, idx) {\n      var tr = document.createElement('tr');\n      tr.className = 'border-b border-gray-100 group';\n      tr.dataset.idx = idx;\n\n      var amount = (parseFloat(line.qty) || 0) * (parseFloat(line.price) || 0);\n\n      tr.innerHTML =\n        '<td class=\"py-2 pr-3\">' +\n          '<input type=\"text\" placeholder=\"Service or product description\" value=\"' + escHtml(line.desc) + '\" ' +\n                 'data-field=\"desc\" data-idx=\"' + idx + '\" ' +\n                 'class=\"w-full border-0 border-b border-transparent focus:border-indigo-400 focus:outline-none bg-transparent text-gray-700 text-sm py-0.5\" />' +\n        '</td>' +\n        '<td class=\"py-2 pr-4 text-right\">' +\n          '<input type=\"number\" min=\"0\" step=\"0.01\" value=\"' + line.qty + '\" ' +\n                 'data-field=\"qty\" data-idx=\"' + idx + '\" ' +\n                 'class=\"w-16 border-0 border-b border-transparent focus:border-indigo-400 focus:outline-none bg-transparent text-gray-700 text-sm text-right py-0.5\" />' +\n        '</td>' +\n        '<td class=\"py-2 pr-4 text-right\">' +\n          '<input type=\"number\" min=\"0\" step=\"0.01\" value=\"' + line.price + '\" ' +\n                 'data-field=\"price\" data-idx=\"' + idx + '\" ' +\n                 'class=\"w-24 border-0 border-b border-transparent focus:border-indigo-400 focus:outline-none bg-transparent text-gray-700 text-sm text-right py-0.5\" />' +\n        '</td>' +\n        '<td class=\"py-2 text-right text-gray-800 font-medium tabular-nums whitespace-nowrap amount-cell\">' +\n          fmt(amount) +\n        '</td>' +\n        '<td class=\"py-2 pl-2 no-print\">' +\n          '<button data-remove=\"' + idx + '\" ' +\n                  'class=\"opacity-0 group-hover:opacity-100 text-gray-300 hover:text-red-500 transition text-lg leading-none\" ' +\n                  'title=\"Remove row\">&times;</button>' +\n        '</td>';\n\n      elBody.appendChild(tr);\n    });\n\n    updateTotals();\n  }\n\n  function escHtml(s) {\n    return String(s)\n      .replace(/&/g, '&amp;')\n      .replace(/\"/g, '&quot;')\n      .replace(/</g, '&lt;')\n      .replace(/>/g, '&gt;');\n  }\n\n  // ── Update totals ─────────────────────────────────────────────────────────\n  function updateTotals() {\n    var subtotal = state.lines.reduce(function (acc, l) {\n      return acc + (parseFloat(l.qty) || 0) * (parseFloat(l.price) || 0);\n    }, 0);\n    var vatRate = parseFloat(state.vatRate) || 0;\n    var taxAmt = subtotal * vatRate / 100;\n    var total = subtotal + taxAmt;\n\n    elSubtotal.textContent = fmt(subtotal);\n    elTaxDisplay.textContent = fmt(taxAmt);\n    elTotal.textContent = fmt(total);\n    elTaxLabel.textContent = 'VAT (' + vatRate + ' %)';\n\n    // Also update amount cells without full re-render\n    var amtCells = elBody.querySelectorAll('.amount-cell');\n    amtCells.forEach(function (cell, idx) {\n      var l = state.lines[idx];\n      if (l) {\n        cell.textContent = fmt((parseFloat(l.qty) || 0) * (parseFloat(l.price) || 0));\n      }\n    });\n  }\n\n  // ── Populate fields from state ─────────────────────────────────────────────\n  function populateFields() {\n    elBusinessName.textContent    = state.businessName;\n    elBusinessAddress.textContent = state.businessAddress;\n    elBusinessEmail.textContent   = state.businessEmail;\n    elClientName.textContent      = state.clientName;\n    elClientAddress.textContent   = state.clientAddress;\n    elNotes.textContent           = state.notes;\n    elInvoiceNumber.value         = state.invoiceNumber;\n    elIssueDate.value             = state.issueDate;\n    elDueDate.value               = state.dueDate;\n    elCurrency.value              = state.currency;\n    elVat.value                   = String(state.vatRate);\n    elFooterName.textContent      = state.businessName;\n    renderLines();\n  }\n\n  // ── Bind contenteditable fields ───────────────────────────────────────────\n  function bindContentEditable(el) {\n    el.addEventListener('input', function () {\n      var key = el.dataset.key;\n      state[key] = el.textContent;\n      if (key === 'businessName') elFooterName.textContent = el.textContent;\n      saveState();\n    });\n  }\n\n  [elBusinessName, elBusinessAddress, elBusinessEmail, elClientName, elClientAddress, elNotes]\n    .forEach(bindContentEditable);\n\n  // ── Bind simple inputs ─────────────────────────────────────────────────────\n  function bindInput(el, key) {\n    el.addEventListener('input', function () {\n      state[key] = el.value;\n      saveState();\n    });\n  }\n  bindInput(elInvoiceNumber, 'invoiceNumber');\n  bindInput(elIssueDate, 'issueDate');\n  bindInput(elDueDate, 'dueDate');\n\n  elCurrency.addEventListener('change', function () {\n    state.currency = elCurrency.value;\n    updateTotals();\n    saveState();\n  });\n\n  elVat.addEventListener('change', function () {\n    state.vatRate = parseFloat(elVat.value);\n    updateTotals();\n    saveState();\n  });\n\n  // ── Line item delegation ───────────────────────────────────────────────────\n  elBody.addEventListener('input', function (e) {\n    var el = e.target;\n    var idx = parseInt(el.dataset.idx, 10);\n    var field = el.dataset.field;\n    if (isNaN(idx) || !field) return;\n    if (field === 'desc') {\n      state.lines[idx].desc = el.value;\n    } else if (field === 'qty') {\n      state.lines[idx].qty = el.value;\n    } else if (field === 'price') {\n      state.lines[idx].price = el.value;\n    }\n    updateTotals();\n    saveState();\n  });\n\n  elBody.addEventListener('click', function (e) {\n    var btn = e.target.closest('[data-remove]');\n    if (!btn) return;\n    var idx = parseInt(btn.dataset.remove, 10);\n    if (isNaN(idx)) return;\n    state.lines.splice(idx, 1);\n    renderLines();\n    saveState();\n  });\n\n  btnAddRow.addEventListener('click', function () {\n    state.lines.push({ desc: '', qty: 1, price: 0 });\n    renderLines();\n    saveState();\n    // Focus new description field\n    var rows = elBody.querySelectorAll('tr');\n    var lastRow = rows[rows.length - 1];\n    if (lastRow) {\n      var inp = lastRow.querySelector('input[data-field=\"desc\"]');\n      if (inp) inp.focus();\n    }\n  });\n\n  // ── Clear / New Invoice ────────────────────────────────────────────────────\n  btnClear.addEventListener('click', function () {\n    if (!confirm('Start a new invoice? All current data will be cleared.')) return;\n    var newToday = new Date();\n    var newDue = new Date(newToday);\n    newDue.setDate(newDue.getDate() + 30);\n    state.businessName    = '';\n    state.businessAddress = '';\n    state.businessEmail   = '';\n    state.clientName      = '';\n    state.clientAddress   = '';\n    state.invoiceNumber   = '';\n    state.issueDate       = fmtDate(newToday);\n    state.dueDate         = fmtDate(newDue);\n    state.notes           = '';\n    state.currency        = 'kr';\n    state.vatRate         = 25;\n    state.lines           = [{ desc: '', qty: 1, price: 0 }];\n    saveState();\n    populateFields();\n  });\n\n  // ── Boot ───────────────────────────────────────────────────────────────────\n  loadState();\n  populateFields();\n\n})();\n</script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Invoice Generator",
    "windowTitle": "Invoice Generator",
    "bundleId": "com.halisonworks.invoicegenerator",
    "iconPath": null
  },
  "categoryId": null,
  "source": "import",
  "createdAt": "2026-06-02T12:00:00.000Z",
  "updatedAt": "2026-06-02T12:00:00.000Z",
  "sharedAt": "2026-06-02T12:00:00.000Z"
}
