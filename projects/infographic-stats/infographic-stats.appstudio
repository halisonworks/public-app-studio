{
  "schema": "app-studio/canvas@1",
  "id": "example-infographic-stats",
  "name": "infographic-stats.html",
  "code": "<!DOCTYPE html>\n<!--\n  Infographic Stats — Halison App Studio example\n\n  An editable key-stats infographic: big numbers with animated bars/rings and a\n  mini chart, with editable values and accent color. Built to screenshot and\n  share. Saves to your browser.\n\n  From the Halison App Studio public library:\n  https://github.com/halisonworks/public-app-studio\n\n  Permitted use: personal, educational, and other non-commercial use. You may\n  modify it, but keep this header and the source link intact, and do not sell,\n  commercialize, or republish it. Released under the Halison App Studio Examples\n  License — see the LICENSE file in the repository above.\n-->\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Infographic Stats — App Studio</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    /* Base */\n    *, *::before, *::after { box-sizing: border-box; }\n\n    :root {\n      --accent: #6366f1;\n      --accent-light: #a5b4fc;\n      --accent-dark: #4338ca;\n      --bg-card: #1e1e2e;\n      --bg-page: #13131f;\n      --text-primary: #f1f5f9;\n      --text-muted: #94a3b8;\n    }\n\n    body {\n      background: var(--bg-page);\n      color: var(--text-primary);\n      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;\n      min-height: 100vh;\n    }\n\n    /* Ring */\n    .ring-track {\n      fill: none;\n      stroke: rgba(255,255,255,0.08);\n    }\n\n    .ring-fill {\n      fill: none;\n      stroke: var(--accent);\n      stroke-linecap: round;\n      /* dashoffset is animated from full -> target via the keyframe below */\n      animation: ringFill 1.2s cubic-bezier(0.4,0,0.2,1) forwards;\n      transition: stroke 0.4s;\n    }\n\n    @keyframes ringFill {\n      from { stroke-dashoffset: var(--ring-full); }\n      to   { stroke-dashoffset: var(--ring-offset); }\n    }\n\n    .ring-pct {\n      font-size: 0.78rem;\n      font-weight: 700;\n      fill: var(--text-primary);\n    }\n\n    /* Horizontal stat bar (track + proportional fill) */\n    @keyframes barGrow {\n      from { width: 0; }\n      to   { width: var(--bar-w); }\n    }\n\n    .stat-bar-track {\n      width: 100%;\n      height: 10px;\n      background: rgba(255,255,255,0.08);\n      border-radius: 999px;\n      overflow: hidden;\n    }\n\n    .stat-bar-fill {\n      height: 100%;\n      background: var(--accent);\n      border-radius: 999px;\n      width: var(--bar-w);\n      animation: barGrow 1.2s cubic-bezier(0.4,0,0.2,1) forwards;\n      transition: background 0.4s;\n    }\n\n    /* Chart bar animation */\n    @keyframes chartBarGrow {\n      from { height: 0; }\n      to   { height: var(--chart-h); }\n    }\n\n    .chart-bar {\n      background: var(--accent);\n      border-radius: 4px 4px 0 0;\n      animation: chartBarGrow 1.4s cubic-bezier(0.4,0,0.2,1) forwards;\n      transition: background 0.4s;\n      width: 100%;\n    }\n\n    /* Panel */\n    .controls-panel {\n      background: #1a1a2e;\n      border-left: 1px solid rgba(255,255,255,0.07);\n    }\n\n    .ctrl-label {\n      font-size: 0.7rem;\n      text-transform: uppercase;\n      letter-spacing: 0.08em;\n      color: var(--text-muted);\n      margin-bottom: 3px;\n    }\n\n    .ctrl-input {\n      background: #0f0f1a;\n      border: 1px solid rgba(255,255,255,0.1);\n      border-radius: 6px;\n      color: var(--text-primary);\n      font-size: 0.82rem;\n      padding: 5px 8px;\n      width: 100%;\n      outline: none;\n      transition: border-color 0.2s;\n    }\n\n    .ctrl-input:focus {\n      border-color: var(--accent);\n    }\n\n    /* Infographic card */\n    .info-card {\n      background: linear-gradient(135deg, #1e1e2e 0%, #181825 100%);\n      border: 1px solid rgba(255,255,255,0.06);\n      border-radius: 16px;\n      overflow: hidden;\n    }\n\n    .stat-block {\n      background: rgba(255,255,255,0.03);\n      border: 1px solid rgba(255,255,255,0.07);\n      border-radius: 12px;\n      padding: 18px 16px 14px;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      gap: 8px;\n      transition: border-color 0.3s;\n    }\n\n    .stat-block:hover {\n      border-color: rgba(255,255,255,0.15);\n    }\n\n    .stat-number {\n      font-size: 1.9rem;\n      font-weight: 800;\n      letter-spacing: -0.03em;\n      line-height: 1;\n      color: var(--text-primary);\n    }\n\n    .stat-label {\n      font-size: 0.72rem;\n      text-transform: uppercase;\n      letter-spacing: 0.1em;\n      color: var(--text-muted);\n      text-align: center;\n    }\n\n    .bar-wrapper {\n      width: 100%;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      gap: 6px;\n      min-height: 56px;\n      padding: 0 4px;\n    }\n\n    .bar-pct {\n      font-size: 0.72rem;\n      font-weight: 700;\n      color: var(--accent);\n      transition: color 0.4s;\n    }\n\n    /* Headline gradient */\n    .headline-gradient {\n      background: linear-gradient(90deg, #f1f5f9 0%, var(--accent-light) 100%);\n      -webkit-background-clip: text;\n      -webkit-text-fill-color: transparent;\n      background-clip: text;\n      transition: background 0.4s;\n    }\n\n    /* Divider */\n    .divider {\n      height: 1px;\n      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);\n    }\n\n    /* Color swatch */\n    input[type=\"color\"] {\n      -webkit-appearance: none;\n      appearance: none;\n      width: 100%;\n      height: 32px;\n      border: 1px solid rgba(255,255,255,0.12);\n      border-radius: 6px;\n      padding: 2px;\n      background: #0f0f1a;\n      cursor: pointer;\n    }\n\n    input[type=\"color\"]::-webkit-color-swatch-wrapper { padding: 0; }\n    input[type=\"color\"]::-webkit-color-swatch { border: none; border-radius: 4px; }\n\n    /* Scrollbar */\n    ::-webkit-scrollbar { width: 6px; }\n    ::-webkit-scrollbar-track { background: transparent; }\n    ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 3px; }\n\n    /* Accent badge */\n    .accent-badge {\n      display: inline-block;\n      background: var(--accent);\n      color: #fff;\n      font-size: 0.6rem;\n      font-weight: 700;\n      letter-spacing: 0.12em;\n      text-transform: uppercase;\n      padding: 2px 8px;\n      border-radius: 999px;\n      transition: background 0.4s;\n    }\n\n    /* Chart axis label */\n    .axis-label {\n      font-size: 0.65rem;\n      color: var(--text-muted);\n      text-align: center;\n    }\n  </style>\n</head>\n<body class=\"flex flex-col min-h-screen\">\n\n  <!-- Top bar -->\n  <header class=\"flex items-center gap-3 px-5 py-3 border-b border-white/5 bg-black/20\">\n    <div class=\"flex items-center gap-2\">\n      <svg width=\"22\" height=\"22\" viewBox=\"0 0 22 22\" fill=\"none\">\n        <rect width=\"22\" height=\"22\" rx=\"6\" fill=\"var(--accent)\"/>\n        <rect x=\"5\" y=\"11\" width=\"3\" height=\"6\" rx=\"1.5\" fill=\"white\"/>\n        <rect x=\"9.5\" y=\"7\" width=\"3\" height=\"10\" rx=\"1.5\" fill=\"white\"/>\n        <rect x=\"14\" y=\"4\" width=\"3\" height=\"13\" rx=\"1.5\" fill=\"white\"/>\n      </svg>\n      <span class=\"text-sm font-semibold text-white/80\">Infographic Stats</span>\n    </div>\n    <span class=\"text-white/20 text-xs\">|</span>\n    <span class=\"text-xs text-white/40\">App Studio</span>\n    <div class=\"ml-auto text-xs text-white/25\">Edit values in the panel →</div>\n  </header>\n\n  <!-- Main layout -->\n  <div class=\"flex flex-1 overflow-hidden\">\n\n    <!-- Infographic area -->\n    <main class=\"flex-1 overflow-y-auto p-5 lg:p-8 flex items-start justify-center\">\n      <div id=\"infographic\" class=\"info-card w-full max-w-2xl shadow-2xl\">\n\n        <!-- Header section -->\n        <div class=\"px-8 pt-8 pb-6\">\n          <div class=\"flex items-center justify-between mb-3\">\n            <span id=\"display-badge\" class=\"accent-badge\">2026 Product Report</span>\n            <span class=\"text-xs text-white/25 font-mono\">Q2 · 2026</span>\n          </div>\n          <h1 id=\"display-headline\" class=\"headline-gradient text-3xl font-extrabold leading-tight mb-1\">\n            Growth at a Glance\n          </h1>\n          <p id=\"display-subtitle\" class=\"text-white/50 text-sm\">\n            Key performance metrics across all product lines — Jan to Jun 2026\n          </p>\n        </div>\n\n        <div class=\"divider mx-6\"></div>\n\n        <!-- Stat blocks grid -->\n        <div id=\"stat-grid\" class=\"grid grid-cols-2 sm:grid-cols-3 gap-3 px-6 pt-6 pb-2\">\n          <!-- Populated by JS -->\n        </div>\n\n        <div class=\"divider mx-6 mt-6\"></div>\n\n        <!-- Mini bar chart -->\n        <div class=\"px-6 pt-6 pb-8\">\n          <h2 class=\"text-xs font-semibold uppercase tracking-widest text-white/40 mb-6\">\n            Category Breakdown\n          </h2>\n          <div id=\"chart-area\" class=\"flex items-end gap-4\">\n            <!-- Populated by JS -->\n          </div>\n        </div>\n\n        <!-- Footer -->\n        <div class=\"px-8 py-4 bg-white/[0.02] border-t border-white/5 flex items-center justify-between\">\n          <span class=\"text-xs text-white/20\">halison.works · App Studio</span>\n          <span id=\"display-footer-year\" class=\"text-xs text-white/20 font-mono\">2026</span>\n        </div>\n      </div>\n    </main>\n\n    <!-- Controls panel -->\n    <aside class=\"controls-panel w-64 overflow-y-auto p-4 flex flex-col gap-4 shrink-0\">\n\n      <div>\n        <div class=\"ctrl-label text-xs font-bold text-white/60 mb-2 flex items-center gap-1\">\n          <svg width=\"11\" height=\"11\" viewBox=\"0 0 11 11\" fill=\"currentColor\"><path d=\"M5.5 0L7 4H11L7.8 6.5L9 11L5.5 8.5L2 11L3.2 6.5L0 4H4L5.5 0Z\"/></svg>\n          Appearance\n        </div>\n        <div class=\"ctrl-label\">Accent Color</div>\n        <input type=\"color\" id=\"ctrl-accent\" value=\"#6366f1\" />\n      </div>\n\n      <div class=\"divider\"></div>\n\n      <div>\n        <div class=\"ctrl-label text-xs font-bold text-white/60 mb-2\">Header</div>\n        <div class=\"ctrl-label\">Badge text</div>\n        <input class=\"ctrl-input mb-2\" id=\"ctrl-badge\" type=\"text\" maxlength=\"30\" />\n        <div class=\"ctrl-label\">Headline</div>\n        <input class=\"ctrl-input mb-2\" id=\"ctrl-headline\" type=\"text\" maxlength=\"50\" />\n        <div class=\"ctrl-label\">Subtitle</div>\n        <input class=\"ctrl-input\" id=\"ctrl-subtitle\" type=\"text\" maxlength=\"80\" />\n      </div>\n\n      <div class=\"divider\"></div>\n\n      <div>\n        <div class=\"ctrl-label text-xs font-bold text-white/60 mb-2\">Stat Blocks</div>\n        <div id=\"stat-controls\" class=\"flex flex-col gap-3\">\n          <!-- Populated by JS -->\n        </div>\n      </div>\n\n      <div class=\"divider\"></div>\n\n      <div>\n        <div class=\"ctrl-label text-xs font-bold text-white/60 mb-2\">Chart Categories</div>\n        <div id=\"chart-controls\" class=\"flex flex-col gap-3\">\n          <!-- Populated by JS -->\n        </div>\n      </div>\n\n      <div class=\"mt-auto pt-2\">\n        <button id=\"btn-reset\" class=\"w-full text-xs text-white/30 hover:text-white/60 py-2 transition-colors\">\n          Reset to defaults\n        </button>\n      </div>\n    </aside>\n  </div>\n\n  <script>\n    // ── Default state ─────────────────────────────────────────────────────────\n    var DEFAULTS = {\n      accent: '#6366f1',\n      badge: '2026 Product Report',\n      headline: 'Growth at a Glance',\n      subtitle: 'Key performance metrics across all product lines — Jan to Jun 2026',\n      stats: [\n        { value: '4.2M',  pct: 84, label: 'Active Users',      type: 'ring' },\n        { value: '+127%', pct: 72, label: 'Revenue Growth',     type: 'ring' },\n        { value: '98.6%', pct: 99, label: 'Uptime SLA',         type: 'bar'  },\n        { value: '12.4K', pct: 62, label: 'Enterprise Clients', type: 'ring' },\n        { value: '3.8s',  pct: 38, label: 'Avg. Load Time',     type: 'bar'  },\n        { value: '41',    pct: 82, label: 'NPS Score',           type: 'ring' }\n      ],\n      chart: [\n        { label: 'Core',      pct: 90 },\n        { label: 'API',       pct: 75 },\n        { label: 'Mobile',    pct: 60 },\n        { label: 'Analytics', pct: 48 },\n        { label: 'Support',   pct: 35 }\n      ]\n    };\n\n    var STORAGE_KEY = 'infographic-stats-v2';\n\n    // ── State ─────────────────────────────────────────────────────────────────\n    function loadState() {\n      try {\n        var raw = localStorage.getItem(STORAGE_KEY);\n        if (raw) return JSON.parse(raw);\n      } catch(e) {}\n      return JSON.parse(JSON.stringify(DEFAULTS));\n    }\n\n    function saveState(state) {\n      try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch(e) {}\n    }\n\n    var state = loadState();\n\n    // ── CSS variable helpers ──────────────────────────────────────────────────\n    function hexToRgb(hex) {\n      var r = parseInt(hex.slice(1,3),16);\n      var g = parseInt(hex.slice(3,5),16);\n      var b = parseInt(hex.slice(5,7),16);\n      return { r:r, g:g, b:b };\n    }\n\n    function lightenHex(hex, factor) {\n      var c = hexToRgb(hex);\n      var r = Math.round(c.r + (255 - c.r) * factor);\n      var g = Math.round(c.g + (255 - c.g) * factor);\n      var b = Math.round(c.b + (255 - c.b) * factor);\n      return 'rgb(' + r + ',' + g + ',' + b + ')';\n    }\n\n    function darkenHex(hex, factor) {\n      var c = hexToRgb(hex);\n      var r = Math.round(c.r * (1 - factor));\n      var g = Math.round(c.g * (1 - factor));\n      var b = Math.round(c.b * (1 - factor));\n      return 'rgb(' + r + ',' + g + ',' + b + ')';\n    }\n\n    function applyAccent(accent) {\n      document.documentElement.style.setProperty('--accent', accent);\n      document.documentElement.style.setProperty('--accent-light', lightenHex(accent, 0.4));\n      document.documentElement.style.setProperty('--accent-dark', darkenHex(accent, 0.2));\n    }\n\n    // ── Ring SVG builder ──────────────────────────────────────────────────────\n    function buildRing(pct) {\n      var p = Math.min(100, Math.max(0, pct));\n      var size = 60;\n      var stroke = 6;\n      var c = size / 2;\n      var r = (size - stroke) / 2;\n      var circ = 2 * Math.PI * r;\n      // dashoffset target: full circumference at 0%, 0 at 100%\n      var offset = circ * (1 - p / 100);\n      var svg = '<svg width=\"' + size + '\" height=\"' + size + '\" viewBox=\"0 0 ' + size + ' ' + size + '\">'\n        + '<circle class=\"ring-track\" cx=\"' + c + '\" cy=\"' + c + '\" r=\"' + r + '\" stroke-width=\"' + stroke + '\"/>'\n        + '<circle class=\"ring-fill\" cx=\"' + c + '\" cy=\"' + c + '\" r=\"' + r + '\" stroke-width=\"' + stroke + '\"'\n        + ' stroke-dasharray=\"' + circ + '\"'\n        + ' stroke-dashoffset=\"' + offset + '\"'\n        + ' style=\"--ring-full:' + circ + '; --ring-offset:' + offset + ';\"'\n        + ' transform=\"rotate(-90 ' + c + ' ' + c + ')\"/>'\n        + '<text class=\"ring-pct\" x=\"' + c + '\" y=\"' + c + '\" text-anchor=\"middle\" dominant-baseline=\"central\">' + p + '%</text>'\n        + '</svg>';\n      return svg;\n    }\n\n    // ── Horizontal bar builder (track + proportional fill) ──────────────────────\n    function buildBar(pct) {\n      var p = Math.min(100, Math.max(0, pct));\n      return '<div class=\"bar-wrapper\">'\n        + '<div class=\"stat-bar-track\"><div class=\"stat-bar-fill\" style=\"--bar-w:' + p + '%\"></div></div>'\n        + '<div class=\"bar-pct\">' + p + '%</div>'\n        + '</div>';\n    }\n\n    // ── Render infographic ────────────────────────────────────────────────────\n    function renderInfograhic() {\n      applyAccent(state.accent);\n\n      document.getElementById('display-badge').textContent = state.badge;\n      document.getElementById('display-headline').textContent = state.headline;\n      document.getElementById('display-subtitle').textContent = state.subtitle;\n\n      // Stat grid\n      var grid = document.getElementById('stat-grid');\n      grid.innerHTML = '';\n      state.stats.forEach(function(s) {\n        var visual = s.type === 'ring' ? buildRing(s.pct) : buildBar(s.pct);\n        var block = document.createElement('div');\n        block.className = 'stat-block';\n        block.innerHTML = '<div class=\"stat-number\">' + escHtml(s.value) + '</div>'\n          + visual\n          + '<div class=\"stat-label\">' + escHtml(s.label) + '</div>';\n        grid.appendChild(block);\n      });\n\n      // Chart\n      var chart = document.getElementById('chart-area');\n      chart.innerHTML = '';\n      var maxPct = 0;\n      state.chart.forEach(function(c) { if (c.pct > maxPct) maxPct = c.pct; });\n\n      var TRACK_H = 120;\n      state.chart.forEach(function(c) {\n        var p = Math.min(100, Math.max(1, c.pct));\n        var barH = Math.max(8, Math.round(TRACK_H * p / 100));\n        var col = document.createElement('div');\n        col.className = 'flex flex-col items-center gap-1 flex-1';\n        col.innerHTML = '<div class=\"w-full flex items-end justify-center\" style=\"height:' + TRACK_H + 'px\">'\n          + '<div class=\"chart-bar\" style=\"--chart-h:' + barH + 'px; height:' + barH + 'px\"></div>'\n          + '</div>'\n          + '<div class=\"axis-label\">' + escHtml(c.label) + '</div>'\n          + '<div class=\"text-xs font-bold\" style=\"color:var(--accent)\">' + p + '%</div>';\n        chart.appendChild(col);\n      });\n    }\n\n    // ── Render controls ───────────────────────────────────────────────────────\n    function renderControls() {\n      document.getElementById('ctrl-accent').value = state.accent;\n      document.getElementById('ctrl-badge').value = state.badge;\n      document.getElementById('ctrl-headline').value = state.headline;\n      document.getElementById('ctrl-subtitle').value = state.subtitle;\n\n      // Stat controls\n      var sc = document.getElementById('stat-controls');\n      sc.innerHTML = '';\n      state.stats.forEach(function(s, i) {\n        var wrap = document.createElement('div');\n        wrap.className = 'rounded-lg bg-white/[0.03] p-2 flex flex-col gap-1.5';\n        wrap.innerHTML = '<div class=\"flex gap-1\">'\n          + '<div class=\"flex-1\">'\n          + '<div class=\"ctrl-label\">Value</div>'\n          + '<input class=\"ctrl-input\" data-stat=\"' + i + '\" data-field=\"value\" type=\"text\" maxlength=\"12\" value=\"' + escAttr(s.value) + '\">'\n          + '</div>'\n          + '<div style=\"width:48px\">'\n          + '<div class=\"ctrl-label\">%</div>'\n          + '<input class=\"ctrl-input\" data-stat=\"' + i + '\" data-field=\"pct\" type=\"number\" min=\"1\" max=\"100\" value=\"' + s.pct + '\">'\n          + '</div>'\n          + '</div>'\n          + '<div>'\n          + '<div class=\"ctrl-label\">Label</div>'\n          + '<input class=\"ctrl-input\" data-stat=\"' + i + '\" data-field=\"label\" type=\"text\" maxlength=\"24\" value=\"' + escAttr(s.label) + '\">'\n          + '</div>'\n          + '<div>'\n          + '<div class=\"ctrl-label\">Visual</div>'\n          + '<select class=\"ctrl-input\" data-stat=\"' + i + '\" data-field=\"type\">'\n          + '<option value=\"ring\"' + (s.type==='ring'?' selected':'') + '>Ring</option>'\n          + '<option value=\"bar\"' + (s.type==='bar'?' selected':'') + '>Bar</option>'\n          + '</select>'\n          + '</div>';\n        sc.appendChild(wrap);\n      });\n\n      // Chart controls\n      var cc = document.getElementById('chart-controls');\n      cc.innerHTML = '';\n      state.chart.forEach(function(c, i) {\n        var wrap = document.createElement('div');\n        wrap.className = 'flex gap-1';\n        wrap.innerHTML = '<div class=\"flex-1\">'\n          + '<div class=\"ctrl-label\">Label</div>'\n          + '<input class=\"ctrl-input\" data-chart=\"' + i + '\" data-field=\"label\" type=\"text\" maxlength=\"14\" value=\"' + escAttr(c.label) + '\">'\n          + '</div>'\n          + '<div style=\"width:48px\">'\n          + '<div class=\"ctrl-label\">%</div>'\n          + '<input class=\"ctrl-input\" data-chart=\"' + i + '\" data-field=\"pct\" type=\"number\" min=\"1\" max=\"100\" value=\"' + c.pct + '\">'\n          + '</div>';\n        cc.appendChild(wrap);\n      });\n\n      attachControlListeners();\n    }\n\n    // ── Event listeners ───────────────────────────────────────────────────────\n    function attachControlListeners() {\n      // Stat inputs\n      var statInputs = document.querySelectorAll('[data-stat]');\n      statInputs.forEach(function(el) {\n        el.addEventListener('input', function() {\n          var i = parseInt(this.getAttribute('data-stat'));\n          var field = this.getAttribute('data-field');\n          var val = this.value;\n          if (field === 'pct') {\n            val = Math.min(100, Math.max(1, parseInt(val) || 1));\n          }\n          state.stats[i][field] = val;\n          saveState(state);\n          renderInfograhic();\n        });\n      });\n\n      // Chart inputs\n      var chartInputs = document.querySelectorAll('[data-chart]');\n      chartInputs.forEach(function(el) {\n        el.addEventListener('input', function() {\n          var i = parseInt(this.getAttribute('data-chart'));\n          var field = this.getAttribute('data-field');\n          var val = this.value;\n          if (field === 'pct') {\n            val = Math.min(100, Math.max(1, parseInt(val) || 1));\n          }\n          state.chart[i][field] = val;\n          saveState(state);\n          renderInfograhic();\n        });\n      });\n    }\n\n    // ── Top-level control bindings ────────────────────────────────────────────\n    function bindTopControls() {\n      document.getElementById('ctrl-accent').addEventListener('input', function() {\n        state.accent = this.value;\n        saveState(state);\n        renderInfograhic();\n      });\n\n      document.getElementById('ctrl-badge').addEventListener('input', function() {\n        state.badge = this.value;\n        saveState(state);\n        document.getElementById('display-badge').textContent = this.value;\n      });\n\n      document.getElementById('ctrl-headline').addEventListener('input', function() {\n        state.headline = this.value;\n        saveState(state);\n        document.getElementById('display-headline').textContent = this.value;\n      });\n\n      document.getElementById('ctrl-subtitle').addEventListener('input', function() {\n        state.subtitle = this.value;\n        saveState(state);\n        document.getElementById('display-subtitle').textContent = this.value;\n      });\n\n      document.getElementById('btn-reset').addEventListener('click', function() {\n        if (confirm('Reset all values to defaults?')) {\n          state = JSON.parse(JSON.stringify(DEFAULTS));\n          saveState(state);\n          renderInfograhic();\n          renderControls();\n        }\n      });\n    }\n\n    // ── Utilities ─────────────────────────────────────────────────────────────\n    function escHtml(str) {\n      return String(str)\n        .replace(/&/g,'&amp;')\n        .replace(/</g,'&lt;')\n        .replace(/>/g,'&gt;');\n    }\n\n    function escAttr(str) {\n      return String(str)\n        .replace(/&/g,'&amp;')\n        .replace(/\"/g,'&quot;');\n    }\n\n    // ── Boot ──────────────────────────────────────────────────────────────────\n    renderInfograhic();\n    renderControls();\n    bindTopControls();\n  </script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Infographic Stats",
    "windowTitle": "Infographic Stats",
    "bundleId": "com.halisonworks.infographicstats",
    "iconPath": null
  },
  "categoryId": null,
  "source": "import",
  "createdAt": "2026-06-02T12:00:00.000Z",
  "updatedAt": "2026-06-02T12:00:00.000Z",
  "sharedAt": "2026-06-02T12:00:00.000Z"
}
