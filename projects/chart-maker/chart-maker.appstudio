{
  "schema": "app-studio/canvas@1",
  "id": "example-chart-maker",
  "name": "chart-maker.html",
  "code": "<!DOCTYPE html>\n<!--\n  Chart Maker — Halison App Studio example\n\n  Paste data or fill a table, pick bar/line/donut, set a title and color, and get\n  a clean hand-rolled SVG chart. Saves to your browser; capture with PNG export.\n\n  From the Halison App Studio public library:\n  https://github.com/halisonworks/public-app-studio\n\n  Permitted use: personal, educational, and other non-commercial use. You may\n  modify it, but keep this header and the source link intact, and do not sell,\n  commercialize, or republish it. Released under the Halison App Studio Examples\n  License — see the LICENSE file in the repository above.\n-->\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Chart Maker — App Studio</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n\n    :root {\n      --accent: #6366f1;\n      --bg-page: #0f0f1a;\n      --bg-card: #1a1a2e;\n      --bg-input: #12121e;\n      --border: #2a2a45;\n      --text-primary: #f1f5f9;\n      --text-muted: #94a3b8;\n      --text-dim: #64748b;\n    }\n\n    body {\n      background: var(--bg-page);\n      color: var(--text-primary);\n      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;\n      min-height: 100vh;\n    }\n\n    input, textarea, select {\n      background: var(--bg-input);\n      color: var(--text-primary);\n      border: 1px solid var(--border);\n      border-radius: 6px;\n      outline: none;\n      transition: border-color 0.15s;\n    }\n    input:focus, textarea:focus, select:focus {\n      border-color: var(--accent);\n    }\n\n    .card {\n      background: var(--bg-card);\n      border: 1px solid var(--border);\n      border-radius: 12px;\n    }\n\n    /* Tab buttons */\n    .tab-btn {\n      padding: 6px 14px;\n      border-radius: 6px;\n      font-size: 13px;\n      font-weight: 500;\n      cursor: pointer;\n      transition: all 0.15s;\n      border: 1px solid transparent;\n      color: var(--text-muted);\n      background: transparent;\n    }\n    .tab-btn.active {\n      background: var(--accent);\n      color: #fff;\n      border-color: var(--accent);\n    }\n    .tab-btn:not(.active):hover {\n      border-color: var(--border);\n      color: var(--text-primary);\n    }\n\n    /* Chart type selector */\n    .chart-type-btn {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      gap: 6px;\n      padding: 10px 14px;\n      border-radius: 8px;\n      cursor: pointer;\n      border: 1px solid var(--border);\n      background: var(--bg-input);\n      color: var(--text-muted);\n      font-size: 12px;\n      font-weight: 500;\n      transition: all 0.15s;\n    }\n    .chart-type-btn.active {\n      border-color: var(--accent);\n      color: var(--text-primary);\n      background: rgba(99,102,241,0.15);\n    }\n    .chart-type-btn:hover:not(.active) {\n      border-color: #44446a;\n      color: var(--text-primary);\n    }\n\n    /* Table */\n    .data-table {\n      width: 100%;\n      border-collapse: collapse;\n      font-size: 13px;\n    }\n    .data-table th {\n      text-align: left;\n      color: var(--text-dim);\n      font-weight: 500;\n      padding: 6px 8px;\n      border-bottom: 1px solid var(--border);\n    }\n    .data-table td {\n      padding: 3px 4px;\n    }\n    .data-table input {\n      width: 100%;\n      padding: 5px 8px;\n      font-size: 13px;\n    }\n\n    .btn-icon {\n      width: 28px;\n      height: 28px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      border-radius: 6px;\n      cursor: pointer;\n      border: 1px solid var(--border);\n      background: var(--bg-input);\n      color: var(--text-muted);\n      font-size: 16px;\n      line-height: 1;\n      transition: all 0.15s;\n    }\n    .btn-icon:hover { color: var(--text-primary); border-color: #44446a; }\n    .btn-icon.danger:hover { color: #f87171; border-color: #f87171; }\n\n    .btn-add {\n      display: flex;\n      align-items: center;\n      gap: 6px;\n      padding: 6px 12px;\n      border-radius: 6px;\n      font-size: 13px;\n      font-weight: 500;\n      cursor: pointer;\n      border: 1px dashed var(--border);\n      background: transparent;\n      color: var(--text-muted);\n      transition: all 0.15s;\n    }\n    .btn-add:hover { color: var(--text-primary); border-color: #44446a; }\n\n    /* SVG chart */\n    #chart-svg text { font-family: 'Segoe UI', system-ui, sans-serif; }\n\n    /* Paste area */\n    #paste-area {\n      width: 100%;\n      resize: vertical;\n      padding: 10px 12px;\n      font-size: 13px;\n      font-family: 'Cascadia Code', 'Fira Code', monospace;\n      line-height: 1.6;\n      min-height: 160px;\n    }\n\n    /* Color swatch strip */\n    .color-swatch {\n      width: 24px;\n      height: 24px;\n      border-radius: 50%;\n      cursor: pointer;\n      border: 2px solid transparent;\n      transition: border-color 0.1s, transform 0.1s;\n      flex-shrink: 0;\n    }\n    .color-swatch.selected {\n      border-color: #fff;\n      transform: scale(1.2);\n    }\n\n    /* Error / empty state */\n    .state-msg {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      gap: 8px;\n      color: var(--text-dim);\n      font-size: 14px;\n      height: 100%;\n      min-height: 200px;\n    }\n    .state-msg svg { opacity: 0.3; }\n\n    /* Scrollbar */\n    ::-webkit-scrollbar { width: 6px; height: 6px; }\n    ::-webkit-scrollbar-track { background: transparent; }\n    ::-webkit-scrollbar-thumb { background: #2a2a45; border-radius: 3px; }\n  </style>\n</head>\n<body>\n\n<div class=\"max-w-6xl mx-auto px-4 py-6\">\n\n  <!-- Header -->\n  <div class=\"mb-6\">\n    <h1 class=\"text-2xl font-bold text-white tracking-tight\">Chart Maker</h1>\n    <p class=\"text-sm mt-1\" style=\"color:var(--text-muted)\">Paste data or edit the table — get a clean SVG chart instantly.</p>\n  </div>\n\n  <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-6\">\n\n    <!-- LEFT PANEL: controls -->\n    <div class=\"flex flex-col gap-4\">\n\n      <!-- Title + color -->\n      <div class=\"card p-4 flex flex-col gap-3\">\n        <div>\n          <label class=\"block text-xs font-semibold mb-1\" style=\"color:var(--text-muted)\">CHART TITLE</label>\n          <input id=\"chart-title\" type=\"text\" placeholder=\"Monthly Revenue 2024\"\n            class=\"w-full px-3 py-2 text-sm\" />\n        </div>\n        <div>\n          <label class=\"block text-xs font-semibold mb-2\" style=\"color:var(--text-muted)\">ACCENT COLOR</label>\n          <div class=\"flex items-center gap-3 flex-wrap\">\n            <div id=\"swatches\" class=\"flex gap-2 flex-wrap\"></div>\n            <input id=\"custom-color\" type=\"color\" value=\"#6366f1\"\n              title=\"Custom color\"\n              style=\"width:28px;height:28px;border:none;background:none;cursor:pointer;padding:0;\" />\n          </div>\n        </div>\n      </div>\n\n      <!-- Chart type -->\n      <div class=\"card p-4\">\n        <label class=\"block text-xs font-semibold mb-3\" style=\"color:var(--text-muted)\">CHART TYPE</label>\n        <div class=\"flex gap-3\" id=\"chart-type-btns\">\n\n          <button class=\"chart-type-btn active\" data-type=\"bar\">\n            <svg width=\"32\" height=\"24\" viewBox=\"0 0 32 24\" fill=\"currentColor\">\n              <rect x=\"1\" y=\"10\" width=\"6\" height=\"14\" rx=\"1\" opacity=\".9\"/>\n              <rect x=\"9\" y=\"4\" width=\"6\" height=\"20\" rx=\"1\" opacity=\".9\"/>\n              <rect x=\"17\" y=\"7\" width=\"6\" height=\"17\" rx=\"1\" opacity=\".9\"/>\n              <rect x=\"25\" y=\"1\" width=\"6\" height=\"23\" rx=\"1\" opacity=\".9\"/>\n            </svg>\n            Bar\n          </button>\n\n          <button class=\"chart-type-btn\" data-type=\"line\">\n            <svg width=\"32\" height=\"24\" viewBox=\"0 0 32 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <polyline points=\"1,20 9,12 17,15 25,4 31,7\"/>\n              <circle cx=\"1\" cy=\"20\" r=\"2\" fill=\"currentColor\" stroke=\"none\"/>\n              <circle cx=\"9\" cy=\"12\" r=\"2\" fill=\"currentColor\" stroke=\"none\"/>\n              <circle cx=\"17\" cy=\"15\" r=\"2\" fill=\"currentColor\" stroke=\"none\"/>\n              <circle cx=\"25\" cy=\"4\" r=\"2\" fill=\"currentColor\" stroke=\"none\"/>\n              <circle cx=\"31\" cy=\"7\" r=\"2\" fill=\"currentColor\" stroke=\"none\"/>\n            </svg>\n            Line\n          </button>\n\n          <button class=\"chart-type-btn\" data-type=\"donut\">\n            <svg width=\"32\" height=\"24\" viewBox=\"0 0 32 24\" fill=\"none\">\n              <circle cx=\"16\" cy=\"12\" r=\"10\" stroke=\"currentColor\" stroke-width=\"2\" opacity=\".3\"/>\n              <path d=\"M16 2 A10 10 0 0 1 26 12\" stroke=\"currentColor\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n              <path d=\"M26 12 A10 10 0 0 1 10 21.66\" stroke=\"currentColor\" stroke-width=\"5\" stroke-linecap=\"round\" opacity=\".7\"/>\n              <circle cx=\"16\" cy=\"12\" r=\"5\" fill=\"#1a1a2e\"/>\n            </svg>\n            Donut\n          </button>\n\n        </div>\n      </div>\n\n      <!-- Data input: tabs -->\n      <div class=\"card p-4 flex flex-col gap-3\">\n        <div class=\"flex items-center justify-between\">\n          <label class=\"text-xs font-semibold\" style=\"color:var(--text-muted)\">DATA</label>\n          <div class=\"flex gap-1\">\n            <button class=\"tab-btn active\" id=\"tab-table\" onclick=\"switchTab('table')\">Table</button>\n            <button class=\"tab-btn\" id=\"tab-paste\" onclick=\"switchTab('paste')\">Paste CSV</button>\n          </div>\n        </div>\n\n        <!-- Table view -->\n        <div id=\"panel-table\">\n          <div style=\"overflow-x:auto;\">\n            <table class=\"data-table\">\n              <thead>\n                <tr>\n                  <th style=\"width:55%\">Label</th>\n                  <th style=\"width:35%\">Value</th>\n                  <th style=\"width:10%\"></th>\n                </tr>\n              </thead>\n              <tbody id=\"table-body\"></tbody>\n            </table>\n          </div>\n          <button class=\"btn-add mt-3\" onclick=\"addRow()\">\n            <svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"currentColor\"><path d=\"M7 1v12M1 7h12\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/></svg>\n            Add row\n          </button>\n        </div>\n\n        <!-- Paste view -->\n        <div id=\"panel-paste\" style=\"display:none;\">\n          <textarea id=\"paste-area\" placeholder=\"Jan, 42000&#10;Feb, 51000&#10;Mar, 47800&#10;&#10;Also supports: &quot;Label: value&quot; or tab-separated columns.\"></textarea>\n          <p class=\"text-xs mt-2\" style=\"color:var(--text-dim)\">One row per line. Comma, tab, colon, or space-separated. Header rows are ignored.</p>\n          <div id=\"paste-error\" class=\"text-xs mt-1\" style=\"color:#f87171;display:none;\"></div>\n        </div>\n      </div>\n\n    </div>\n\n    <!-- RIGHT PANEL: chart output -->\n    <div class=\"card p-5 flex flex-col\" style=\"min-height:480px;\">\n      <div id=\"chart-title-display\" class=\"text-base font-semibold mb-4 text-center\" style=\"color:var(--text-primary);min-height:24px;\"></div>\n      <div id=\"chart-container\" class=\"flex-1 flex items-center justify-center\" style=\"min-height:360px;\">\n        <!-- SVG rendered here -->\n      </div>\n    </div>\n\n  </div>\n</div>\n\n<script>\n// ─── State ───────────────────────────────────────────────────────────────────\n\nconst SAMPLE = [\n  { label: 'January',   value: 42000 },\n  { label: 'February',  value: 51300 },\n  { label: 'March',     value: 47800 },\n  { label: 'April',     value: 56200 },\n  { label: 'May',       value: 63100 },\n  { label: 'June',      value: 71500 },\n  { label: 'July',      value: 68900 },\n  { label: 'August',    value: 74200 },\n];\n\nconst SWATCHES = [\n  '#6366f1', // indigo\n  '#8b5cf6', // violet\n  '#ec4899', // pink\n  '#f43f5e', // rose\n  '#f97316', // orange\n  '#eab308', // yellow\n  '#22c55e', // green\n  '#06b6d4', // cyan\n  '#3b82f6', // blue\n];\n\nlet state = {\n  title: 'Monthly Revenue 2024',\n  chartType: 'bar',\n  accent: '#6366f1',\n  rows: SAMPLE.map(r => ({ ...r })),\n  activeTab: 'table',\n};\n\nfunction loadFromStorage() {\n  try {\n    const raw = localStorage.getItem('chart-maker-state');\n    if (!raw) return;\n    const saved = JSON.parse(raw);\n    if (saved.title !== undefined) state.title = saved.title;\n    if (saved.chartType) state.chartType = saved.chartType;\n    if (saved.accent) state.accent = saved.accent;\n    if (Array.isArray(saved.rows) && saved.rows.length > 0) state.rows = saved.rows;\n  } catch(e) {}\n}\n\nfunction saveToStorage() {\n  try {\n    localStorage.setItem('chart-maker-state', JSON.stringify({\n      title: state.title,\n      chartType: state.chartType,\n      accent: state.accent,\n      rows: state.rows,\n    }));\n  } catch(e) {}\n}\n\n// ─── Init ─────────────────────────────────────────────────────────────────────\n\nloadFromStorage();\nbuildSwatches();\nsyncUI();\nrenderTable();\nrenderChart();\n\n// ─── Swatches ─────────────────────────────────────────────────────────────────\n\nfunction buildSwatches() {\n  const container = document.getElementById('swatches');\n  container.innerHTML = '';\n  SWATCHES.forEach(color => {\n    const s = document.createElement('div');\n    s.className = 'color-swatch' + (state.accent === color ? ' selected' : '');\n    s.style.background = color;\n    s.title = color;\n    s.addEventListener('click', () => {\n      state.accent = color;\n      document.getElementById('custom-color').value = color;\n      updateSwatchSelection();\n      renderChart();\n      saveToStorage();\n    });\n    container.appendChild(s);\n  });\n}\n\nfunction updateSwatchSelection() {\n  document.querySelectorAll('.color-swatch').forEach((s, i) => {\n    s.classList.toggle('selected', SWATCHES[i] === state.accent);\n  });\n}\n\ndocument.getElementById('custom-color').addEventListener('input', e => {\n  state.accent = e.target.value;\n  updateSwatchSelection();\n  renderChart();\n  saveToStorage();\n});\n\n// ─── Title field ──────────────────────────────────────────────────────────────\n\nconst titleInput = document.getElementById('chart-title');\ntitleInput.addEventListener('input', () => {\n  state.title = titleInput.value;\n  document.getElementById('chart-title-display').textContent = state.title;\n  saveToStorage();\n});\n\n// ─── Chart type buttons ───────────────────────────────────────────────────────\n\ndocument.getElementById('chart-type-btns').addEventListener('click', e => {\n  const btn = e.target.closest('[data-type]');\n  if (!btn) return;\n  state.chartType = btn.dataset.type;\n  document.querySelectorAll('.chart-type-btn').forEach(b => b.classList.toggle('active', b === btn));\n  renderChart();\n  saveToStorage();\n});\n\n// ─── Tab switch ───────────────────────────────────────────────────────────────\n\nfunction switchTab(tab) {\n  state.activeTab = tab;\n  document.getElementById('panel-table').style.display = tab === 'table' ? '' : 'none';\n  document.getElementById('panel-paste').style.display = tab === 'paste' ? '' : 'none';\n  document.getElementById('tab-table').classList.toggle('active', tab === 'table');\n  document.getElementById('tab-paste').classList.toggle('active', tab === 'paste');\n  if (tab === 'paste') {\n    // Sync textarea from rows\n    document.getElementById('paste-area').value = state.rows.map(r => `${r.label}, ${r.value}`).join('\\n');\n  }\n}\n\n// ─── Paste parsing ────────────────────────────────────────────────────────────\n\ndocument.getElementById('paste-area').addEventListener('input', parsePaste);\n\nfunction parsePaste() {\n  const raw = document.getElementById('paste-area').value;\n  const errEl = document.getElementById('paste-error');\n  const lines = raw.split('\\n').map(l => l.trim()).filter(l => l.length > 0);\n  const rows = [];\n\n  for (const line of lines) {\n    // Try comma, tab, colon, semicolon then last-resort space before trailing number\n    let parts = null;\n    if (line.includes(',')) parts = line.split(',');\n    else if (line.includes('\\t')) parts = line.split('\\t');\n    else if (line.includes(';')) parts = line.split(';');\n    else if (line.includes(':')) parts = line.split(':');\n    else {\n      // space split — label is everything except trailing numeric token\n      const m = line.match(/^(.+?)\\s+([-\\d.,]+)\\s*$/);\n      if (m) parts = [m[1], m[2]];\n    }\n\n    if (!parts || parts.length < 2) continue;\n    const label = parts[0].trim();\n    const valStr = parts[parts.length - 1].replace(/,/g, '').trim();\n    const value = parseFloat(valStr);\n    if (!label) continue;\n    // Skip if it looks like a header (value not numeric)\n    if (isNaN(value)) continue;\n    rows.push({ label, value });\n  }\n\n  if (rows.length === 0 && raw.trim().length > 0) {\n    errEl.textContent = 'Could not parse any rows. Try: \"Label, 123\" per line.';\n    errEl.style.display = '';\n  } else {\n    errEl.style.display = 'none';\n  }\n\n  if (rows.length > 0) {\n    state.rows = rows;\n    renderTable();\n    renderChart();\n    saveToStorage();\n  }\n}\n\n// ─── Table ────────────────────────────────────────────────────────────────────\n\nfunction renderTable() {\n  const tbody = document.getElementById('table-body');\n  tbody.innerHTML = '';\n  state.rows.forEach((row, i) => {\n    const tr = document.createElement('tr');\n    tr.innerHTML = `\n      <td><input type=\"text\" value=\"${escHtml(row.label)}\" data-i=\"${i}\" data-field=\"label\" /></td>\n      <td><input type=\"number\" value=\"${row.value}\" data-i=\"${i}\" data-field=\"value\" step=\"any\" /></td>\n      <td>\n        <button class=\"btn-icon danger\" data-action=\"del\" data-i=\"${i}\" title=\"Remove row\">×</button>\n      </td>\n    `;\n    tbody.appendChild(tr);\n  });\n}\n\ndocument.getElementById('table-body').addEventListener('input', e => {\n  const el = e.target;\n  const i = +el.dataset.i;\n  const field = el.dataset.field;\n  if (field === 'label') state.rows[i].label = el.value;\n  if (field === 'value') state.rows[i].value = parseFloat(el.value) || 0;\n  renderChart();\n  saveToStorage();\n});\n\ndocument.getElementById('table-body').addEventListener('click', e => {\n  const btn = e.target.closest('[data-action=\"del\"]');\n  if (!btn) return;\n  const i = +btn.dataset.i;\n  if (state.rows.length <= 1) return; // keep at least one\n  state.rows.splice(i, 1);\n  renderTable();\n  renderChart();\n  saveToStorage();\n});\n\nfunction addRow() {\n  state.rows.push({ label: 'New', value: 0 });\n  renderTable();\n  renderChart();\n  saveToStorage();\n}\n\n// ─── Sync UI from state ───────────────────────────────────────────────────────\n\nfunction syncUI() {\n  document.getElementById('chart-title').value = state.title;\n  document.getElementById('chart-title-display').textContent = state.title;\n  document.getElementById('custom-color').value = state.accent;\n  document.querySelectorAll('.chart-type-btn').forEach(b => {\n    b.classList.toggle('active', b.dataset.type === state.chartType);\n  });\n  updateSwatchSelection();\n}\n\n// ─── Chart rendering ──────────────────────────────────────────────────────────\n\nfunction renderChart() {\n  const container = document.getElementById('chart-container');\n  const rows = state.rows.filter(r => r.label && !isNaN(r.value));\n  if (rows.length === 0) {\n    container.innerHTML = `<div class=\"state-msg\">\n      <svg width=\"48\" height=\"48\" viewBox=\"0 0 48 48\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\">\n        <rect x=\"8\" y=\"8\" width=\"32\" height=\"32\" rx=\"4\"/>\n        <path d=\"M16 28v4M24 20v12M32 24v8\"/>\n      </svg>\n      <span>Add some data to see your chart</span>\n    </div>`;\n    return;\n  }\n\n  let svg = '';\n  if (state.chartType === 'bar') svg = renderBar(rows);\n  else if (state.chartType === 'line') svg = renderLine(rows);\n  else if (state.chartType === 'donut') svg = renderDonut(rows);\n\n  container.innerHTML = svg;\n}\n\n// ── Shared helpers ────────────────────────────────────────────────────────────\n\nfunction escHtml(s) {\n  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;');\n}\n\nfunction hexToRgba(hex, alpha) {\n  const r = parseInt(hex.slice(1,3),16);\n  const g = parseInt(hex.slice(3,5),16);\n  const b = parseInt(hex.slice(5,7),16);\n  return `rgba(${r},${g},${b},${alpha})`;\n}\n\nfunction niceMax(v) {\n  if (v <= 0) return 10;\n  const mag = Math.pow(10, Math.floor(Math.log10(v)));\n  const norm = v / mag;\n  let nice = norm <= 1 ? 1 : norm <= 2 ? 2 : norm <= 5 ? 5 : 10;\n  return nice * mag;\n}\n\nfunction formatNum(v) {\n  if (Math.abs(v) >= 1e6) return (v/1e6).toFixed(1).replace(/\\.0$/,'') + 'M';\n  if (Math.abs(v) >= 1e3) return (v/1e3).toFixed(1).replace(/\\.0$/,'') + 'k';\n  return String(Math.round(v * 100) / 100);\n}\n\nfunction lighten(hex, amount) {\n  // Blend hex toward white\n  const r = parseInt(hex.slice(1,3),16);\n  const g = parseInt(hex.slice(3,5),16);\n  const b = parseInt(hex.slice(5,7),16);\n  const rr = Math.round(r + (255-r)*amount);\n  const gg = Math.round(g + (255-g)*amount);\n  const bb = Math.round(b + (255-b)*amount);\n  return `#${rr.toString(16).padStart(2,'0')}${gg.toString(16).padStart(2,'0')}${bb.toString(16).padStart(2,'0')}`;\n}\n\n// ── Bar chart ─────────────────────────────────────────────────────────────────\n\nfunction renderBar(rows) {\n  const W = 540, H = 340;\n  const pad = { top: 20, right: 24, bottom: 60, left: 58 };\n  const chartW = W - pad.left - pad.right;\n  const chartH = H - pad.top - pad.bottom;\n\n  const vals = rows.map(r => r.value);\n  const minVal = Math.min(0, ...vals);\n  const maxVal = niceMax(Math.max(...vals));\n  const range = maxVal - minVal;\n\n  const barGap = 0.25;\n  const barW = (chartW / rows.length) * (1 - barGap);\n  const barStep = chartW / rows.length;\n\n  // Y-axis ticks\n  const tickCount = 5;\n  const ticks = [];\n  for (let i = 0; i <= tickCount; i++) {\n    ticks.push(minVal + (range / tickCount) * i);\n  }\n\n  const yScale = v => chartH - ((v - minVal) / range) * chartH;\n  const accent = state.accent;\n  const accentFade = hexToRgba(accent, 0.18);\n\n  let paths = '';\n\n  // Grid lines\n  ticks.forEach(t => {\n    const y = yScale(t);\n    paths += `<line x1=\"0\" y1=\"${y.toFixed(1)}\" x2=\"${chartW}\" y2=\"${y.toFixed(1)}\" stroke=\"#ffffff\" stroke-opacity=\"0.06\" stroke-dasharray=\"4 3\"/>`;\n    paths += `<text x=\"-10\" y=\"${(y+4).toFixed(1)}\" text-anchor=\"end\" fill=\"#64748b\" font-size=\"11\">${formatNum(t)}</text>`;\n  });\n\n  // Zero line\n  if (minVal < 0) {\n    const y0 = yScale(0);\n    paths += `<line x1=\"0\" y1=\"${y0.toFixed(1)}\" x2=\"${chartW}\" y2=\"${y0.toFixed(1)}\" stroke=\"#ffffff\" stroke-opacity=\"0.25\"/>`;\n  }\n\n  // Bars\n  rows.forEach((row, i) => {\n    const x = i * barStep + (barStep - barW) / 2;\n    const y0 = yScale(Math.max(0, minVal));\n    const y1 = yScale(row.value);\n    const barH = Math.abs(y0 - y1);\n    const barY = Math.min(y0, y1);\n\n    // Shadow / glow\n    paths += `<rect x=\"${x.toFixed(1)}\" y=\"${barY.toFixed(1)}\" width=\"${barW.toFixed(1)}\" height=\"${barH.toFixed(1)}\" rx=\"3\" fill=\"${accentFade}\"/>`;\n    paths += `<rect x=\"${(x+1).toFixed(1)}\" y=\"${(barY+1).toFixed(1)}\" width=\"${(barW-2).toFixed(1)}\" height=\"${(barH-1).toFixed(1)}\" rx=\"3\" fill=\"${accent}\"/>`;\n\n    // Value label on top\n    if (barH > 16) {\n      paths += `<text x=\"${(x + barW/2).toFixed(1)}\" y=\"${(barY - 5).toFixed(1)}\" text-anchor=\"middle\" fill=\"${lighten(accent, 0.5)}\" font-size=\"11\" font-weight=\"600\">${formatNum(row.value)}</text>`;\n    }\n\n    // X label\n    const labelY = chartH + 18;\n    const label = row.label.length > 10 ? row.label.slice(0,9)+'…' : row.label;\n    paths += `<text x=\"${(x + barW/2).toFixed(1)}\" y=\"${labelY}\" text-anchor=\"middle\" fill=\"#94a3b8\" font-size=\"11\">${escHtml(label)}</text>`;\n  });\n\n  // Axes\n  paths += `<line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"${chartH}\" stroke=\"#334155\" stroke-width=\"1\"/>`;\n  paths += `<line x1=\"0\" y1=\"${chartH}\" x2=\"${chartW}\" y2=\"${chartH}\" stroke=\"#334155\" stroke-width=\"1\"/>`;\n\n  return `<svg viewBox=\"0 0 ${W} ${H}\" style=\"width:100%;height:auto;max-height:380px;\" xmlns=\"http://www.w3.org/2000/svg\">\n    <g transform=\"translate(${pad.left},${pad.top})\">${paths}</g>\n  </svg>`;\n}\n\n// ── Line chart ────────────────────────────────────────────────────────────────\n\nfunction renderLine(rows) {\n  const W = 540, H = 340;\n  const pad = { top: 24, right: 24, bottom: 60, left: 58 };\n  const chartW = W - pad.left - pad.right;\n  const chartH = H - pad.top - pad.bottom;\n\n  const vals = rows.map(r => r.value);\n  const minVal = Math.min(0, ...vals);\n  const maxVal = niceMax(Math.max(...vals));\n  const range = maxVal - minVal;\n\n  const tickCount = 5;\n  const ticks = [];\n  for (let i = 0; i <= tickCount; i++) {\n    ticks.push(minVal + (range / tickCount) * i);\n  }\n\n  const xScale = i => (i / (rows.length - 1)) * chartW;\n  const yScale = v => chartH - ((v - minVal) / range) * chartH;\n  const accent = state.accent;\n\n  let parts = '';\n\n  // Grid\n  ticks.forEach(t => {\n    const y = yScale(t);\n    parts += `<line x1=\"0\" y1=\"${y.toFixed(1)}\" x2=\"${chartW}\" y2=\"${y.toFixed(1)}\" stroke=\"#ffffff\" stroke-opacity=\"0.06\" stroke-dasharray=\"4 3\"/>`;\n    parts += `<text x=\"-10\" y=\"${(y+4).toFixed(1)}\" text-anchor=\"end\" fill=\"#64748b\" font-size=\"11\">${formatNum(t)}</text>`;\n  });\n\n  // Area fill\n  let areaPath = `M ${xScale(0).toFixed(1)},${chartH}`;\n  rows.forEach((row, i) => {\n    areaPath += ` L ${xScale(i).toFixed(1)},${yScale(row.value).toFixed(1)}`;\n  });\n  areaPath += ` L ${chartW.toFixed(1)},${chartH} Z`;\n  parts += `<path d=\"${areaPath}\" fill=\"${accent}\" fill-opacity=\"0.12\"/>`;\n\n  // Line\n  let linePath = '';\n  rows.forEach((row, i) => {\n    const x = xScale(i).toFixed(1);\n    const y = yScale(row.value).toFixed(1);\n    linePath += i === 0 ? `M ${x},${y}` : ` L ${x},${y}`;\n  });\n  parts += `<path d=\"${linePath}\" fill=\"none\" stroke=\"${accent}\" stroke-width=\"2.5\" stroke-linejoin=\"round\" stroke-linecap=\"round\"/>`;\n\n  // Dots + labels\n  rows.forEach((row, i) => {\n    const x = xScale(i);\n    const y = yScale(row.value);\n    parts += `<circle cx=\"${x.toFixed(1)}\" cy=\"${y.toFixed(1)}\" r=\"4\" fill=\"${accent}\" stroke=\"#1a1a2e\" stroke-width=\"2\"/>`;\n    // Value above dot\n    parts += `<text x=\"${x.toFixed(1)}\" y=\"${(y - 10).toFixed(1)}\" text-anchor=\"middle\" fill=\"${lighten(accent, 0.5)}\" font-size=\"11\" font-weight=\"600\">${formatNum(row.value)}</text>`;\n    // X label\n    const label = row.label.length > 10 ? row.label.slice(0,9)+'…' : row.label;\n    parts += `<text x=\"${x.toFixed(1)}\" y=\"${(chartH + 18)}\" text-anchor=\"middle\" fill=\"#94a3b8\" font-size=\"11\">${escHtml(label)}</text>`;\n  });\n\n  // Axes\n  parts += `<line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"${chartH}\" stroke=\"#334155\" stroke-width=\"1\"/>`;\n  parts += `<line x1=\"0\" y1=\"${chartH}\" x2=\"${chartW}\" y2=\"${chartH}\" stroke=\"#334155\" stroke-width=\"1\"/>`;\n\n  return `<svg viewBox=\"0 0 ${W} ${H}\" style=\"width:100%;height:auto;max-height:380px;\" xmlns=\"http://www.w3.org/2000/svg\">\n    <g transform=\"translate(${pad.left},${pad.top})\">${parts}</g>\n  </svg>`;\n}\n\n// ── Donut chart ───────────────────────────────────────────────────────────────\n\nfunction renderDonut(rows) {\n  const W = 540, H = 340;\n  const cx = 180, cy = H / 2, outerR = 120, innerR = 70;\n  const accent = state.accent;\n\n  // Palette: generate shades from accent\n  function generatePalette(n) {\n    const base = [\n      accent,\n      lighten(accent, 0.2),\n      lighten(accent, 0.38),\n      lighten(accent, 0.52),\n      lighten(accent, 0.63),\n      lighten(accent, 0.72),\n      lighten(accent, 0.80),\n    ];\n    // Also add some desaturation-like variants using opacity layering\n    const extra = [\n      hexToRgba(accent, 1),\n      hexToRgba(lighten(accent, 0.25), 1),\n    ];\n    const all = [...base];\n    while (all.length < n) all.push(...base);\n    return all.slice(0, n);\n  }\n\n  const positiveRows = rows.filter(r => r.value > 0);\n  if (positiveRows.length === 0) {\n    return `<svg viewBox=\"0 0 ${W} ${H}\" style=\"width:100%;height:auto;max-height:380px;\" xmlns=\"http://www.w3.org/2000/svg\">\n      <text x=\"${W/2}\" y=\"${H/2}\" text-anchor=\"middle\" fill=\"#64748b\" font-size=\"14\">No positive values to display</text>\n    </svg>`;\n  }\n\n  const total = positiveRows.reduce((s, r) => s + r.value, 0);\n  const palette = generatePalette(positiveRows.length);\n\n  let slices = '';\n  let legendItems = '';\n  let startAngle = -Math.PI / 2; // start from top\n\n  positiveRows.forEach((row, i) => {\n    const fraction = row.value / total;\n    const sweep = fraction * 2 * Math.PI;\n    const endAngle = startAngle + sweep;\n    const large = sweep > Math.PI ? 1 : 0;\n\n    const x1 = (cx + outerR * Math.cos(startAngle)).toFixed(2);\n    const y1 = (cy + outerR * Math.sin(startAngle)).toFixed(2);\n    const x2 = (cx + outerR * Math.cos(endAngle)).toFixed(2);\n    const y2 = (cy + outerR * Math.sin(endAngle)).toFixed(2);\n    const ix1 = (cx + innerR * Math.cos(endAngle)).toFixed(2);\n    const iy1 = (cy + innerR * Math.sin(endAngle)).toFixed(2);\n    const ix2 = (cx + innerR * Math.cos(startAngle)).toFixed(2);\n    const iy2 = (cy + innerR * Math.sin(startAngle)).toFixed(2);\n\n    const color = palette[i % palette.length];\n    slices += `<path d=\"M ${x1},${y1} A ${outerR},${outerR} 0 ${large},1 ${x2},${y2} L ${ix1},${iy1} A ${innerR},${innerR} 0 ${large},0 ${ix2},${iy2} Z\" fill=\"${color}\" stroke=\"#1a1a2e\" stroke-width=\"1.5\"/>`;\n\n    // Percentage label on slice (only if big enough)\n    if (fraction > 0.06) {\n      const midAngle = startAngle + sweep / 2;\n      const labelR = (outerR + innerR) / 2;\n      const lx = (cx + labelR * Math.cos(midAngle)).toFixed(1);\n      const ly = (cy + labelR * Math.sin(midAngle) + 4).toFixed(1);\n      slices += `<text x=\"${lx}\" y=\"${ly}\" text-anchor=\"middle\" fill=\"#fff\" font-size=\"11\" font-weight=\"700\">${(fraction*100).toFixed(1)}%</text>`;\n    }\n\n    // Legend\n    const lx = 330;\n    const ly = 40 + i * 30;\n    const labelText = row.label.length > 18 ? row.label.slice(0,17)+'…' : row.label;\n    legendItems += `<rect x=\"${lx}\" y=\"${ly - 10}\" width=\"12\" height=\"12\" rx=\"2\" fill=\"${color}\"/>`;\n    legendItems += `<text x=\"${lx + 18}\" y=\"${ly}\" fill=\"#e2e8f0\" font-size=\"12\">${escHtml(labelText)}</text>`;\n    legendItems += `<text x=\"${W - 10}\" y=\"${ly}\" text-anchor=\"end\" fill=\"#94a3b8\" font-size=\"12\">${formatNum(row.value)}</text>`;\n\n    startAngle = endAngle;\n  });\n\n  // Center text\n  const centerTotal = formatNum(total);\n  slices += `<text x=\"${cx}\" y=\"${cy - 8}\" text-anchor=\"middle\" fill=\"#94a3b8\" font-size=\"12\">Total</text>`;\n  slices += `<text x=\"${cx}\" y=\"${cy + 14}\" text-anchor=\"middle\" fill=\"${lighten(accent, 0.4)}\" font-size=\"18\" font-weight=\"700\">${centerTotal}</text>`;\n\n  return `<svg viewBox=\"0 0 ${W} ${H}\" style=\"width:100%;height:auto;max-height:380px;\" xmlns=\"http://www.w3.org/2000/svg\">\n    ${slices}\n    ${legendItems}\n  </svg>`;\n}\n</script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Chart Maker",
    "windowTitle": "Chart Maker",
    "bundleId": "com.halisonworks.chartmaker",
    "iconPath": null
  },
  "categoryId": null,
  "source": "import",
  "createdAt": "2026-06-02T12:00:00.000Z",
  "updatedAt": "2026-06-02T12:00:00.000Z",
  "sharedAt": "2026-06-02T12:00:00.000Z"
}
