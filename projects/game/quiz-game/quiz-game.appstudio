{
  "schema": "app-studio/canvas@1",
  "id": "example-quiz-game",
  "name": "quiz-game.html",
  "code": "<!DOCTYPE html>\n<!--\n  Quiz Game — Halison App Studio example\n\n  An 8-question multiple-choice quiz: instant feedback, score tracking, a best\n  score saved to your browser, keyboard answers (1–4), and play again.\n\n  From the Halison App Studio public library:\n  https://github.com/halisonworks/public-app-studio\n\n  Permitted use: personal, educational, and other non-commercial use. You may\n  modify it, but keep this header and the source link intact, and do not sell,\n  commercialize, or republish it. Released under the Halison App Studio Examples\n  License — see the LICENSE file in the repository above.\n-->\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Quiz Game</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Segoe UI', system-ui, sans-serif; }\n    .option-btn { transition: background-color 0.15s, transform 0.1s; }\n    .option-btn:not(:disabled):hover { transform: translateY(-1px); }\n    .option-btn:not(:disabled):active { transform: translateY(0); }\n    @keyframes pop-in {\n      0% { opacity: 0; transform: scale(0.94) translateY(6px); }\n      100% { opacity: 1; transform: scale(1) translateY(0); }\n    }\n    .animate-pop { animation: pop-in 0.22s ease-out both; }\n    @keyframes shake {\n      0%, 100% { transform: translateX(0); }\n      20%, 60% { transform: translateX(-6px); }\n      40%, 80% { transform: translateX(6px); }\n    }\n    .animate-shake { animation: shake 0.35s ease-in-out; }\n  </style>\n</head>\n<body class=\"min-h-screen bg-gradient-to-br from-indigo-100 via-purple-50 to-pink-100 flex items-center justify-center p-4\">\n\n  <div id=\"app\" class=\"w-full max-w-xl\"></div>\n\n  <script>\n    const QUESTIONS = [\n      {\n        q: \"Which planet in our solar system has the most moons?\",\n        options: [\"Jupiter\", \"Saturn\", \"Uranus\", \"Neptune\"],\n        correct: 1\n      },\n      {\n        q: \"What is the chemical symbol for gold?\",\n        options: [\"Go\", \"Gd\", \"Au\", \"Ag\"],\n        correct: 2\n      },\n      {\n        q: \"In which country is the ancient city of Machu Picchu located?\",\n        options: [\"Colombia\", \"Bolivia\", \"Chile\", \"Peru\"],\n        correct: 3\n      },\n      {\n        q: \"Who painted the Sistine Chapel ceiling?\",\n        options: [\"Leonardo da Vinci\", \"Raphael\", \"Michelangelo\", \"Donatello\"],\n        correct: 2\n      },\n      {\n        q: \"What is the longest river in Africa?\",\n        options: [\"Congo\", \"Niger\", \"Nile\", \"Zambezi\"],\n        correct: 2\n      },\n      {\n        q: \"In what year did the Berlin Wall fall?\",\n        options: [\"1987\", \"1989\", \"1991\", \"1993\"],\n        correct: 1\n      },\n      {\n        q: \"What is the hardest natural substance on Earth?\",\n        options: [\"Quartz\", \"Titanium\", \"Corundum\", \"Diamond\"],\n        correct: 3\n      },\n      {\n        q: \"Which country has the largest land area in the world?\",\n        options: [\"Canada\", \"United States\", \"China\", \"Russia\"],\n        correct: 3\n      }\n    ];\n\n    const BEST_KEY = \"quizgame_best\";\n\n    let state = {\n      screen: \"start\",   // \"start\" | \"question\" | \"results\"\n      current: 0,\n      score: 0,\n      answered: false,\n      chosen: -1,\n      best: parseInt(localStorage.getItem(BEST_KEY) || \"0\", 10)\n    };\n\n    function saveIfBest() {\n      if (state.score > state.best) {\n        state.best = state.score;\n        localStorage.setItem(BEST_KEY, state.best);\n      }\n    }\n\n    function render() {\n      const app = document.getElementById(\"app\");\n      if (state.screen === \"start\") {\n        app.innerHTML = renderStart();\n      } else if (state.screen === \"question\") {\n        app.innerHTML = renderQuestion();\n        attachOptionHandlers();\n      } else {\n        app.innerHTML = renderResults();\n        attachRestartHandler();\n      }\n    }\n\n    function renderStart() {\n      return `\n        <div class=\"animate-pop bg-white rounded-3xl shadow-2xl p-8 text-center\">\n          <div class=\"text-6xl mb-4\">🧠</div>\n          <h1 class=\"text-3xl font-bold text-indigo-700 mb-2\">Quiz Game</h1>\n          <p class=\"text-gray-500 mb-6\">8 general-knowledge questions — science, geography, history &amp; more.</p>\n          <div class=\"flex items-center justify-center gap-2 mb-6 text-sm text-gray-400\">\n            <span>🏆 Best score:</span>\n            <span class=\"font-semibold text-indigo-500\">${state.best} / 8</span>\n          </div>\n          <p class=\"text-xs text-gray-400 mb-6\">Tip: use keys <kbd class=\"bg-gray-100 px-1 rounded\">1</kbd>–<kbd class=\"bg-gray-100 px-1 rounded\">4</kbd> to answer</p>\n          <button id=\"start-btn\"\n            class=\"w-full bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white font-semibold text-lg py-3 rounded-2xl transition-colors\">\n            Start Quiz\n          </button>\n        </div>`;\n    }\n\n    function renderQuestion() {\n      const q = QUESTIONS[state.current];\n      const progress = state.current + 1;\n      const pct = Math.round((state.current / QUESTIONS.length) * 100);\n\n      const optionsHtml = q.options.map((opt, i) => {\n        let extra = \"bg-white border-2 border-gray-200 text-gray-800 hover:border-indigo-400 hover:bg-indigo-50\";\n        if (state.answered) {\n          if (i === q.correct) {\n            extra = \"bg-emerald-500 border-2 border-emerald-600 text-white\";\n          } else if (i === state.chosen && i !== q.correct) {\n            extra = \"bg-red-500 border-2 border-red-600 text-white animate-shake\";\n          } else {\n            extra = \"bg-gray-100 border-2 border-gray-200 text-gray-400\";\n          }\n        }\n        const disabledAttr = state.answered ? \"disabled\" : \"\";\n        return `\n          <button data-idx=\"${i}\" ${disabledAttr}\n            class=\"option-btn w-full text-left rounded-xl px-4 py-3 font-medium flex items-center gap-3 cursor-pointer disabled:cursor-default ${extra}\">\n            <span class=\"flex-shrink-0 w-7 h-7 rounded-full bg-current bg-opacity-10 flex items-center justify-center text-sm font-bold\n              ${state.answered && i === q.correct ? 'bg-white text-emerald-700' : ''}\n              ${state.answered && i === state.chosen && i !== q.correct ? 'text-red-200' : 'text-indigo-500'}\n              ${!state.answered ? 'text-indigo-400' : ''}\n            \">${i + 1}</span>\n            <span>${opt}</span>\n          </button>`;\n      }).join(\"\");\n\n      const feedbackHtml = state.answered\n        ? (state.chosen === q.correct\n            ? `<p class=\"mt-4 text-center text-emerald-600 font-semibold animate-pop\">✅ Correct!</p>`\n            : `<p class=\"mt-4 text-center text-red-500 font-semibold animate-pop\">❌ Wrong — the answer is <span class=\"underline\">${q.options[q.correct]}</span></p>`)\n        : \"\";\n\n      const nextLabel = state.current < QUESTIONS.length - 1 ? \"Next Question →\" : \"See Results →\";\n      const nextBtn = state.answered\n        ? `<button id=\"next-btn\" class=\"w-full mt-5 bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white font-semibold py-3 rounded-2xl transition-colors\">\n            ${nextLabel}\n           </button>`\n        : \"\";\n\n      return `\n        <div class=\"animate-pop bg-white rounded-3xl shadow-2xl p-7\">\n          <div class=\"flex items-center justify-between mb-3 text-sm text-gray-400 font-medium\">\n            <span>Question ${progress} / ${QUESTIONS.length}</span>\n            <span class=\"text-indigo-500 font-semibold\">Score: ${state.score}</span>\n          </div>\n          <div class=\"w-full bg-gray-100 rounded-full h-2 mb-6\">\n            <div class=\"bg-indigo-500 h-2 rounded-full transition-all duration-500\" style=\"width:${pct}%\"></div>\n          </div>\n          <p class=\"text-xl font-bold text-gray-800 mb-5 leading-snug\">${q.q}</p>\n          <div class=\"flex flex-col gap-3\">\n            ${optionsHtml}\n          </div>\n          ${feedbackHtml}\n          ${nextBtn}\n        </div>`;\n    }\n\n    function renderResults() {\n      const total = QUESTIONS.length;\n      const pct = Math.round((state.score / total) * 100);\n      let emoji = \"😐\";\n      let msg = \"Not bad — keep practising!\";\n      if (pct === 100) { emoji = \"🏆\"; msg = \"Perfect score! Outstanding!\"; }\n      else if (pct >= 75) { emoji = \"🎉\"; msg = \"Great job! You know your stuff!\"; }\n      else if (pct >= 50) { emoji = \"👍\"; msg = \"Solid effort! Room to grow.\"; }\n      else if (pct < 25) { emoji = \"📚\"; msg = \"Time to hit the books!\"; }\n\n      return `\n        <div class=\"animate-pop bg-white rounded-3xl shadow-2xl p-8 text-center\">\n          <div class=\"text-6xl mb-4\">${emoji}</div>\n          <h2 class=\"text-3xl font-bold text-indigo-700 mb-1\">Quiz Complete!</h2>\n          <p class=\"text-gray-500 mb-6\">${msg}</p>\n          <div class=\"bg-indigo-50 rounded-2xl p-5 mb-6\">\n            <p class=\"text-5xl font-extrabold text-indigo-700\">${state.score}<span class=\"text-2xl text-indigo-400\"> / ${total}</span></p>\n            <p class=\"text-gray-400 text-sm mt-1\">${pct}% correct</p>\n          </div>\n          <div class=\"flex items-center justify-center gap-2 mb-6 text-sm text-gray-400\">\n            <span>🏆 Best score:</span>\n            <span class=\"font-semibold text-indigo-500\">${state.best} / 8</span>\n          </div>\n          <button id=\"restart-btn\"\n            class=\"w-full bg-indigo-600 hover:bg-indigo-700 active:bg-indigo-800 text-white font-semibold text-lg py-3 rounded-2xl transition-colors\">\n            Play Again\n          </button>\n        </div>`;\n    }\n\n    function attachOptionHandlers() {\n      document.querySelectorAll(\".option-btn\").forEach(btn => {\n        btn.addEventListener(\"click\", () => handleAnswer(parseInt(btn.dataset.idx, 10)));\n      });\n      const startBtn = document.getElementById(\"start-btn\");\n      if (startBtn) startBtn.addEventListener(\"click\", startQuiz);\n      const nextBtn = document.getElementById(\"next-btn\");\n      if (nextBtn) nextBtn.addEventListener(\"click\", advance);\n    }\n\n    function attachRestartHandler() {\n      const btn = document.getElementById(\"restart-btn\");\n      if (btn) btn.addEventListener(\"click\", restart);\n    }\n\n    function startQuiz() {\n      state.screen = \"question\";\n      state.current = 0;\n      state.score = 0;\n      state.answered = false;\n      state.chosen = -1;\n      render();\n    }\n\n    function handleAnswer(idx) {\n      if (state.answered) return;\n      state.answered = true;\n      state.chosen = idx;\n      if (idx === QUESTIONS[state.current].correct) {\n        state.score++;\n      }\n      render();\n    }\n\n    function advance() {\n      if (!state.answered) return;\n      state.current++;\n      if (state.current >= QUESTIONS.length) {\n        saveIfBest();\n        state.screen = \"results\";\n      }\n      state.answered = false;\n      state.chosen = -1;\n      render();\n    }\n\n    function restart() {\n      state.screen = \"start\";\n      render();\n    }\n\n    document.addEventListener(\"keydown\", e => {\n      const key = e.key;\n      if (state.screen === \"start\" && (key === \"Enter\" || key === \" \")) {\n        startQuiz();\n        return;\n      }\n      if (state.screen === \"question\") {\n        if (!state.answered && [\"1\",\"2\",\"3\",\"4\"].includes(key)) {\n          handleAnswer(parseInt(key, 10) - 1);\n          return;\n        }\n        if (state.answered && (key === \"Enter\" || key === \" \" || key === \"ArrowRight\")) {\n          advance();\n          return;\n        }\n      }\n      if (state.screen === \"results\" && (key === \"Enter\" || key === \" \")) {\n        restart();\n      }\n    });\n\n    render();\n  </script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Quiz Game",
    "windowTitle": "Quiz Game",
    "bundleId": "com.halisonworks.quizgame",
    "iconPath": null
  },
  "categoryId": null,
  "source": "import",
  "createdAt": "2026-06-02T12:00:00.000Z",
  "updatedAt": "2026-06-02T12:00:00.000Z",
  "sharedAt": "2026-06-02T12:00:00.000Z"
}
