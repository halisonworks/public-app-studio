{
  "schema": "app-studio/canvas@1",
  "id": "example-runway-forecaster",
  "name": "runway-forecaster.html",
  "code": "<!DOCTYPE html>\n<!--\n  Runway Forecaster — Halison App Studio example\n\n  Project your startup's cash over 24 months: runway, zero-cash date, net burn,\n  and an optional raise. Live chart and KPIs; saves to your browser.\n\n  From the Halison App Studio public library:\n  https://github.com/halisonworks/public-app-studio\n\n  Permitted use: personal, educational, and other non-commercial use. You may\n  modify it, but keep this header and the source link intact, and do not sell,\n  commercialize, or republish it. Released under the Halison App Studio Examples\n  License — see the LICENSE file in the repository above.\n-->\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Runway Forecaster — Halison App Studio</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Inter', system-ui, sans-serif; }\n    input[type=number]::-webkit-inner-spin-button,\n    input[type=number]::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }\n    input[type=number] { -moz-appearance: textfield; }\n    .kpi-danger  { border-color: #ef4444; }\n    .kpi-warning { border-color: #f59e0b; }\n    .kpi-good    { border-color: #22c55e; }\n    .kpi-neutral { border-color: #6366f1; }\n    .chart-tooltip {\n      position: absolute;\n      background: rgba(15,23,42,0.92);\n      color: #f1f5f9;\n      border-radius: 8px;\n      padding: 8px 12px;\n      font-size: 12px;\n      pointer-events: none;\n      white-space: nowrap;\n      box-shadow: 0 4px 16px rgba(0,0,0,0.3);\n      z-index: 10;\n    }\n    .input-field {\n      background: #1e293b;\n      border: 1px solid #334155;\n      color: #f1f5f9;\n      border-radius: 8px;\n      padding: 10px 14px;\n      width: 100%;\n      font-size: 15px;\n      transition: border-color 0.15s;\n      outline: none;\n    }\n    .input-field:focus { border-color: #6366f1; box-shadow: 0 0 0 3px rgba(99,102,241,0.15); }\n    .input-label { font-size: 12px; font-weight: 600; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 6px; }\n    .section-card { background: #1e293b; border: 1px solid #334155; border-radius: 16px; padding: 24px; }\n    .kpi-card { background: #1e293b; border: 2px solid #334155; border-radius: 14px; padding: 20px 24px; }\n    .kpi-value { font-size: 30px; font-weight: 800; line-height: 1; }\n    .kpi-label { font-size: 12px; color: #94a3b8; margin-top: 6px; font-weight: 500; }\n    .kpi-sub   { font-size: 13px; color: #64748b; margin-top: 4px; }\n    select.input-field { cursor: pointer; }\n    option { background: #1e293b; }\n  </style>\n</head>\n<body class=\"bg-slate-900 text-slate-100 min-h-screen\">\n\n  <!-- Header -->\n  <header class=\"border-b border-slate-800 bg-slate-950 sticky top-0 z-20\">\n    <div class=\"max-w-6xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between\">\n      <div class=\"flex items-center gap-3\">\n        <div class=\"w-8 h-8 rounded-lg bg-indigo-600 flex items-center justify-center shrink-0\">\n          <svg width=\"18\" height=\"18\" viewBox=\"0 0 20 20\" fill=\"none\">\n            <path d=\"M3 17L7.5 10 11 14 14.5 7 17 11\" stroke=\"#fff\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n            <circle cx=\"17\" cy=\"11\" r=\"1.5\" fill=\"#fff\"/>\n          </svg>\n        </div>\n        <div>\n          <h1 class=\"font-bold text-base leading-tight text-slate-100\">Runway Forecaster</h1>\n          <p class=\"text-xs text-slate-500 leading-tight hidden sm:block\">Startup cash projection · 24 months</p>\n        </div>\n      </div>\n      <a href=\"https://github.com/halisonworks/public-app-studio\" target=\"_blank\" rel=\"noopener\"\n         class=\"text-xs text-slate-500 hover:text-indigo-400 transition-colors hidden sm:block\">\n        Halison App Studio\n      </a>\n    </div>\n  </header>\n\n  <main class=\"max-w-6xl mx-auto px-4 sm:px-6 py-8 space-y-8\">\n\n    <!-- Inputs -->\n    <div class=\"section-card\">\n      <h2 class=\"text-sm font-semibold text-slate-400 uppercase tracking-widest mb-6\">Model Inputs</h2>\n      <div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5\">\n\n        <div>\n          <div class=\"input-label\">Starting Cash ($)</div>\n          <input id=\"inp-cash\" type=\"number\" min=\"0\" step=\"1000\" class=\"input-field\" placeholder=\"500,000\" />\n        </div>\n\n        <div>\n          <div class=\"input-label\">Monthly Revenue ($)</div>\n          <input id=\"inp-revenue\" type=\"number\" min=\"0\" step=\"500\" class=\"input-field\" placeholder=\"25,000\" />\n        </div>\n\n        <div>\n          <div class=\"input-label\">Revenue Growth (%/mo)</div>\n          <input id=\"inp-growth\" type=\"number\" step=\"0.1\" class=\"input-field\" placeholder=\"5\" />\n        </div>\n\n        <div>\n          <div class=\"input-label\">Monthly Fixed Expenses ($)</div>\n          <input id=\"inp-expenses\" type=\"number\" min=\"0\" step=\"500\" class=\"input-field\" placeholder=\"60,000\" />\n        </div>\n\n        <div>\n          <div class=\"input-label\">One-Time Raise ($)</div>\n          <input id=\"inp-raise\" type=\"number\" min=\"0\" step=\"10000\" class=\"input-field\" placeholder=\"0 (optional)\" />\n        </div>\n\n        <div>\n          <div class=\"input-label\">Raise Applied at Month</div>\n          <select id=\"inp-raise-month\" class=\"input-field\">\n            <option value=\"0\">— No Raise —</option>\n          </select>\n        </div>\n\n      </div>\n    </div>\n\n    <!-- KPI Cards -->\n    <div class=\"grid grid-cols-2 lg:grid-cols-4 gap-4\" id=\"kpi-grid\">\n      <div class=\"kpi-card kpi-neutral\" id=\"kpi-runway\">\n        <div class=\"kpi-value text-indigo-400\" id=\"kpi-runway-val\">—</div>\n        <div class=\"kpi-label\">Runway</div>\n        <div class=\"kpi-sub\" id=\"kpi-runway-sub\">months remaining</div>\n      </div>\n      <div class=\"kpi-card kpi-neutral\" id=\"kpi-zero\">\n        <div class=\"kpi-value text-rose-400\" id=\"kpi-zero-val\">—</div>\n        <div class=\"kpi-label\">Zero-Cash Date</div>\n        <div class=\"kpi-sub\" id=\"kpi-zero-sub\">estimated cash-out</div>\n      </div>\n      <div class=\"kpi-card kpi-neutral\" id=\"kpi-burn\">\n        <div class=\"kpi-value text-amber-400\" id=\"kpi-burn-val\">—</div>\n        <div class=\"kpi-label\">Net Burn (Mo 1)</div>\n        <div class=\"kpi-sub\" id=\"kpi-burn-sub\">expenses − revenue</div>\n      </div>\n      <div class=\"kpi-card kpi-neutral\" id=\"kpi-breakeven\">\n        <div class=\"kpi-value text-emerald-400\" id=\"kpi-breakeven-val\">—</div>\n        <div class=\"kpi-label\">Breakeven</div>\n        <div class=\"kpi-sub\" id=\"kpi-breakeven-sub\">revenue ≥ expenses</div>\n      </div>\n    </div>\n\n    <!-- Chart -->\n    <div class=\"section-card\">\n      <div class=\"flex items-center justify-between mb-4 gap-2 flex-wrap\">\n        <h2 class=\"text-sm font-semibold text-slate-400 uppercase tracking-widest\">Cash Balance — 24 Month Projection</h2>\n        <div class=\"flex items-center gap-4 text-xs text-slate-500\">\n          <span class=\"flex items-center gap-1\"><span class=\"inline-block w-3 h-0.5 bg-indigo-500\"></span> Balance</span>\n          <span class=\"flex items-center gap-1\"><span class=\"inline-block w-3 h-0.5 bg-rose-500 border-dashed\"></span> Zero line</span>\n          <span class=\"flex items-center gap-1\"><span class=\"inline-block w-2.5 h-2.5 rounded-full bg-emerald-500\"></span> Raise</span>\n        </div>\n      </div>\n      <div id=\"chart-wrap\" class=\"relative w-full\" style=\"height:320px;\">\n        <svg id=\"chart-svg\" width=\"100%\" height=\"100%\" style=\"display:block;\"></svg>\n        <div class=\"chart-tooltip\" id=\"chart-tooltip\" style=\"display:none;\"></div>\n      </div>\n    </div>\n\n    <!-- Monthly Table -->\n    <div class=\"section-card overflow-x-auto\">\n      <h2 class=\"text-sm font-semibold text-slate-400 uppercase tracking-widest mb-4\">Month-by-Month Detail</h2>\n      <table class=\"w-full text-sm\" id=\"detail-table\">\n        <thead>\n          <tr class=\"text-slate-500 text-xs uppercase tracking-wider border-b border-slate-700\">\n            <th class=\"text-left py-2 pr-4 font-semibold\">Month</th>\n            <th class=\"text-right py-2 pr-4 font-semibold\">Revenue</th>\n            <th class=\"text-right py-2 pr-4 font-semibold\">Expenses</th>\n            <th class=\"text-right py-2 pr-4 font-semibold\">Net Burn</th>\n            <th class=\"text-right py-2 pr-4 font-semibold\">Raise</th>\n            <th class=\"text-right py-2 font-semibold\">Cash Balance</th>\n          </tr>\n        </thead>\n        <tbody id=\"table-body\"></tbody>\n      </table>\n    </div>\n\n  </main>\n\n  <footer class=\"border-t border-slate-800 mt-12 py-6 text-center text-xs text-slate-600\">\n    Runway Forecaster · <a href=\"https://github.com/halisonworks/public-app-studio\" target=\"_blank\" rel=\"noopener\" class=\"hover:text-indigo-400 transition-colors\">Halison App Studio</a> · Non-commercial use\n  </footer>\n\n  <script>\n    // ─── State & Storage ──────────────────────────────────────────────────────\n    const STORAGE_KEY = 'runway-forecaster-v1';\n    const DEFAULTS = {\n      cash:       500000,\n      revenue:    25000,\n      growth:     5,\n      expenses:   60000,\n      raise:      0,\n      raiseMonth: 0\n    };\n\n    function loadState() {\n      try {\n        const raw = localStorage.getItem(STORAGE_KEY);\n        if (raw) return Object.assign({}, DEFAULTS, JSON.parse(raw));\n      } catch(e) {}\n      return Object.assign({}, DEFAULTS);\n    }\n\n    function saveState(s) {\n      try { localStorage.setItem(STORAGE_KEY, JSON.stringify(s)); } catch(e) {}\n    }\n\n    // ─── DOM refs ─────────────────────────────────────────────────────────────\n    const $ = id => document.getElementById(id);\n    const inpCash        = $('inp-cash');\n    const inpRevenue     = $('inp-revenue');\n    const inpGrowth      = $('inp-growth');\n    const inpExpenses    = $('inp-expenses');\n    const inpRaise       = $('inp-raise');\n    const inpRaiseMonth  = $('inp-raise-month');\n\n    // ─── Populate raise-month select ─────────────────────────────────────────\n    (function buildSelect() {\n      const sel = inpRaiseMonth;\n      for (let m = 1; m <= 24; m++) {\n        const opt = document.createElement('option');\n        opt.value = m;\n        opt.textContent = 'Month ' + m;\n        sel.appendChild(opt);\n      }\n    })();\n\n    // ─── Init inputs from state ───────────────────────────────────────────────\n    const state = loadState();\n    inpCash.value       = state.cash;\n    inpRevenue.value    = state.revenue;\n    inpGrowth.value     = state.growth;\n    inpExpenses.value   = state.expenses;\n    inpRaise.value      = state.raise;\n    inpRaiseMonth.value = state.raiseMonth;\n\n    // ─── Helpers ──────────────────────────────────────────────────────────────\n    function fmtMoney(n, compact) {\n      if (compact) {\n        const abs = Math.abs(n);\n        let s;\n        if (abs >= 1e6)  s = (n / 1e6).toFixed(2).replace(/\\.?0+$/, '') + 'M';\n        else if (abs >= 1e3) s = (n / 1e3).toFixed(1).replace(/\\.?0+$/, '') + 'k';\n        else s = Math.round(n).toString();\n        return '$' + s;\n      }\n      return '$' + Math.round(n).toLocaleString('en-US');\n    }\n\n    function fmtDate(monthIndex) {\n      // monthIndex 1..24 relative to today\n      const d = new Date();\n      d.setDate(1);\n      d.setMonth(d.getMonth() + monthIndex);\n      return d.toLocaleString('en-US', { month: 'short', year: 'numeric' });\n    }\n\n    // ─── Core Forecast ────────────────────────────────────────────────────────\n    function forecast(s) {\n      const MONTHS = 24;\n      const rows = [];\n      let cash    = s.cash;\n      let revenue = s.revenue;\n\n      for (let m = 1; m <= MONTHS; m++) {\n        const expenses  = s.expenses;\n        const raise     = (s.raiseMonth === m && s.raise > 0) ? s.raise : 0;\n        const net       = revenue - expenses;          // negative = burning\n        const newCash   = cash + net + raise;\n\n        rows.push({ month: m, revenue, expenses, net, raise, cashStart: cash, cashEnd: newCash });\n        cash    = newCash;\n        revenue = revenue * (1 + s.growth / 100);\n      }\n\n      // KPIs\n      let runwayMonths   = null;\n      let zeroCashMonth  = null;\n      let breakevenMonth = null;\n\n      for (let i = 0; i < rows.length; i++) {\n        const r = rows[i];\n        if (runwayMonths === null && r.cashEnd < 0) {\n          // interpolate: how far into this month does cash hit 0?\n          const fraction = r.cashStart / (r.cashStart - r.cashEnd);\n          runwayMonths  = (i) + fraction; // months from start\n          zeroCashMonth = r.month;\n        }\n        if (breakevenMonth === null && r.revenue >= r.expenses) {\n          breakevenMonth = r.month;\n        }\n      }\n\n      const netBurnMo1 = rows[0].expenses - rows[0].revenue; // positive = burning\n\n      return { rows, runwayMonths, zeroCashMonth, breakevenMonth, netBurnMo1 };\n    }\n\n    // ─── Update KPIs ─────────────────────────────────────────────────────────\n    function updateKPIs(result) {\n      const { runwayMonths, zeroCashMonth, netBurnMo1, breakevenMonth } = result;\n\n      // Runway\n      const runwayCard = $('kpi-runway');\n      const runwayVal  = $('kpi-runway-val');\n      const runwaySub  = $('kpi-runway-sub');\n      if (runwayMonths === null) {\n        runwayVal.textContent = '24+';\n        runwaySub.textContent = 'months · still positive';\n        runwayCard.className = 'kpi-card kpi-good';\n      } else {\n        const mo = Math.floor(runwayMonths);\n        const wk = Math.round((runwayMonths - mo) * 4.33);\n        runwayVal.textContent = mo + 'mo ' + (wk > 0 ? wk + 'w' : '');\n        runwaySub.textContent = 'until cash runs out';\n        if (runwayMonths <= 3)       runwayCard.className = 'kpi-card kpi-danger';\n        else if (runwayMonths <= 9)  runwayCard.className = 'kpi-card kpi-warning';\n        else                         runwayCard.className = 'kpi-card kpi-good';\n      }\n\n      // Zero-cash date\n      const zeroVal = $('kpi-zero-val');\n      const zeroSub = $('kpi-zero-sub');\n      if (zeroCashMonth === null) {\n        zeroVal.textContent = 'None';\n        zeroSub.textContent = 'within 24 months';\n      } else {\n        zeroVal.textContent = fmtDate(zeroCashMonth);\n        zeroSub.textContent = 'projected cash-out';\n      }\n\n      // Net burn\n      const burnVal = $('kpi-burn-val');\n      const burnSub = $('kpi-burn-sub');\n      if (netBurnMo1 <= 0) {\n        burnVal.textContent = fmtMoney(Math.abs(netBurnMo1), true);\n        burnSub.textContent = 'net gain / month 1';\n        $('kpi-burn').className = 'kpi-card kpi-good';\n      } else {\n        burnVal.textContent = fmtMoney(netBurnMo1, true) + '/mo';\n        burnSub.textContent = 'net burn · month 1';\n        $('kpi-burn').className = netBurnMo1 > 30000 ? 'kpi-card kpi-danger' : 'kpi-card kpi-warning';\n      }\n\n      // Breakeven\n      const beVal = $('kpi-breakeven-val');\n      const beSub = $('kpi-breakeven-sub');\n      if (breakevenMonth === null) {\n        beVal.textContent = '>24mo';\n        beSub.textContent = 'no breakeven found';\n        $('kpi-breakeven').className = 'kpi-card kpi-warning';\n      } else if (breakevenMonth === 1) {\n        beVal.textContent = 'Now';\n        beSub.textContent = 'already profitable';\n        $('kpi-breakeven').className = 'kpi-card kpi-good';\n      } else {\n        beVal.textContent = 'Mo ' + breakevenMonth;\n        beSub.textContent = fmtDate(breakevenMonth);\n        $('kpi-breakeven').className = 'kpi-card kpi-good';\n      }\n    }\n\n    // ─── Update Table ─────────────────────────────────────────────────────────\n    function updateTable(rows) {\n      const tbody = $('table-body');\n      tbody.innerHTML = '';\n      rows.forEach(r => {\n        const cashClass = r.cashEnd < 0 ? 'text-rose-400 font-bold' :\n                          r.cashEnd < 50000 ? 'text-amber-400' : 'text-emerald-400';\n        const burnClass = r.net < 0 ? 'text-rose-400' : 'text-emerald-400';\n        const tr = document.createElement('tr');\n        tr.className = 'border-b border-slate-800 hover:bg-slate-800/40 transition-colors';\n        tr.innerHTML =\n          '<td class=\"py-2.5 pr-4 text-slate-300 font-medium\">Mo ' + r.month + ' <span class=\"text-slate-600 font-normal text-xs\">(' + fmtDate(r.month) + ')</span></td>' +\n          '<td class=\"py-2.5 pr-4 text-right text-slate-300\">' + fmtMoney(r.revenue, true) + '</td>' +\n          '<td class=\"py-2.5 pr-4 text-right text-slate-300\">' + fmtMoney(r.expenses, true) + '</td>' +\n          '<td class=\"py-2.5 pr-4 text-right ' + burnClass + '\">' + (r.net >= 0 ? '+' : '') + fmtMoney(r.net, true) + '</td>' +\n          '<td class=\"py-2.5 pr-4 text-right text-indigo-400\">' + (r.raise > 0 ? fmtMoney(r.raise, true) : '—') + '</td>' +\n          '<td class=\"py-2.5 text-right ' + cashClass + '\">' + fmtMoney(r.cashEnd, true) + '</td>';\n        tbody.appendChild(tr);\n      });\n    }\n\n    // ─── Chart ────────────────────────────────────────────────────────────────\n    function updateChart(rows, s) {\n      const wrap  = $('chart-wrap');\n      const svg   = $('chart-svg');\n      const tip   = $('chart-tooltip');\n      const W     = wrap.clientWidth  || 800;\n      const H     = wrap.clientHeight || 320;\n      const PAD   = { top: 20, right: 24, bottom: 44, left: 72 };\n      const IW    = W - PAD.left - PAD.right;\n      const IH    = H - PAD.top  - PAD.bottom;\n\n      // Data: include month 0 (starting cash) and months 1..24\n      const data = [{ month: 0, cash: s.cash }];\n      rows.forEach(r => data.push({ month: r.month, cash: r.cashEnd }));\n\n      const allCash = data.map(d => d.cash);\n      const minC    = Math.min(0, ...allCash);\n      const maxC    = Math.max(0, ...allCash);\n      const rangeC  = maxC - minC || 1;\n\n      function xOf(m)  { return PAD.left + (m / 24) * IW; }\n      function yOf(c)  { return PAD.top  + IH - ((c - minC) / rangeC) * IH; }\n\n      // Build polyline points\n      const pts = data.map(d => xOf(d.month).toFixed(1) + ',' + yOf(d.cash).toFixed(1)).join(' ');\n\n      // Area path (fill under line to zero)\n      const zeroY   = yOf(0);\n      let areaPath  = 'M ' + xOf(0).toFixed(1) + ' ' + zeroY;\n      areaPath     += ' L ' + xOf(0).toFixed(1) + ' ' + yOf(data[0].cash).toFixed(1);\n      data.forEach(d => { areaPath += ' L ' + xOf(d.month).toFixed(1) + ' ' + yOf(d.cash).toFixed(1); });\n      areaPath     += ' L ' + xOf(24).toFixed(1) + ' ' + zeroY + ' Z';\n\n      // Y-axis ticks\n      const tickCount = 5;\n      const ticks = [];\n      for (let i = 0; i <= tickCount; i++) {\n        const val = minC + (rangeC / tickCount) * i;\n        ticks.push({ val, y: yOf(val) });\n      }\n\n      // X-axis ticks every 4 months\n      const xTicks = [0, 4, 8, 12, 16, 20, 24];\n\n      // Raise marker\n      const raiseMonthNum = parseInt(s.raiseMonth) || 0;\n      const hasRaise      = raiseMonthNum > 0 && s.raise > 0;\n\n      // Build SVG\n      svg.setAttribute('viewBox', '0 0 ' + W + ' ' + H);\n\n      let html = '';\n\n      // Defs for gradient\n      html += '<defs>';\n      html += '<linearGradient id=\"areaGrad\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">';\n      html += '<stop offset=\"0%\" stop-color=\"#6366f1\" stop-opacity=\"0.3\"/>';\n      html += '<stop offset=\"100%\" stop-color=\"#6366f1\" stop-opacity=\"0.02\"/>';\n      html += '</linearGradient>';\n      html += '</defs>';\n\n      // Grid lines\n      ticks.forEach(t => {\n        html += '<line x1=\"' + PAD.left + '\" y1=\"' + t.y.toFixed(1) + '\" x2=\"' + (W - PAD.right) + '\" y2=\"' + t.y.toFixed(1) + '\" stroke=\"#1e293b\" stroke-width=\"1\"/>';\n      });\n\n      // Zero line\n      html += '<line x1=\"' + PAD.left + '\" y1=\"' + zeroY.toFixed(1) + '\" x2=\"' + (W - PAD.right) + '\" y2=\"' + zeroY.toFixed(1) + '\" stroke=\"#ef4444\" stroke-width=\"1.5\" stroke-dasharray=\"6 4\" opacity=\"0.6\"/>';\n\n      // Area fill\n      html += '<path d=\"' + areaPath + '\" fill=\"url(#areaGrad)\"/>';\n\n      // Line\n      html += '<polyline points=\"' + pts + '\" fill=\"none\" stroke=\"#6366f1\" stroke-width=\"2.5\" stroke-linejoin=\"round\" stroke-linecap=\"round\"/>';\n\n      // Raise marker vertical line\n      if (hasRaise) {\n        const rx = xOf(raiseMonthNum);\n        html += '<line x1=\"' + rx.toFixed(1) + '\" y1=\"' + PAD.top + '\" x2=\"' + rx.toFixed(1) + '\" y2=\"' + (H - PAD.bottom) + '\" stroke=\"#22c55e\" stroke-width=\"1.5\" stroke-dasharray=\"4 3\" opacity=\"0.7\"/>';\n        // Dot on line at raise month\n        const raiseRow = data.find(d => d.month === raiseMonthNum);\n        if (raiseRow) {\n          html += '<circle cx=\"' + rx.toFixed(1) + '\" cy=\"' + yOf(raiseRow.cash).toFixed(1) + '\" r=\"6\" fill=\"#22c55e\" stroke=\"#0f172a\" stroke-width=\"2\"/>';\n        }\n      }\n\n      // Y axis labels\n      ticks.forEach(t => {\n        html += '<text x=\"' + (PAD.left - 8) + '\" y=\"' + (t.y + 4).toFixed(1) + '\" text-anchor=\"end\" font-size=\"10\" fill=\"#64748b\">' + fmtMoney(t.val, true) + '</text>';\n      });\n\n      // X axis labels\n      xTicks.forEach(m => {\n        const x = xOf(m);\n        const label = m === 0 ? 'Now' : 'Mo ' + m;\n        html += '<text x=\"' + x.toFixed(1) + '\" y=\"' + (H - PAD.bottom + 18) + '\" text-anchor=\"middle\" font-size=\"10\" fill=\"#64748b\">' + label + '</text>';\n        html += '<line x1=\"' + x.toFixed(1) + '\" y1=\"' + (H - PAD.bottom) + '\" x2=\"' + x.toFixed(1) + '\" y2=\"' + (H - PAD.bottom + 5) + '\" stroke=\"#334155\" stroke-width=\"1\"/>';\n      });\n\n      // Data point dots (hidden, for tooltip hit areas)\n      data.forEach(d => {\n        html += '<circle class=\"chart-pt\" cx=\"' + xOf(d.month).toFixed(1) + '\" cy=\"' + yOf(d.cash).toFixed(1) + '\" r=\"5\" fill=\"transparent\" stroke=\"transparent\" data-month=\"' + d.month + '\" data-cash=\"' + d.cash + '\" style=\"cursor:crosshair\"/>';\n      });\n\n      // Axis lines\n      html += '<line x1=\"' + PAD.left + '\" y1=\"' + PAD.top + '\" x2=\"' + PAD.left + '\" y2=\"' + (H - PAD.bottom) + '\" stroke=\"#334155\" stroke-width=\"1\"/>';\n      html += '<line x1=\"' + PAD.left + '\" y1=\"' + (H - PAD.bottom) + '\" x2=\"' + (W - PAD.right) + '\" y2=\"' + (H - PAD.bottom) + '\" stroke=\"#334155\" stroke-width=\"1\"/>';\n\n      svg.innerHTML = html;\n\n      // Tooltip\n      svg.addEventListener('mousemove', function(e) {\n        const rect   = svg.getBoundingClientRect();\n        const mx     = e.clientX - rect.left;\n        const mo     = Math.round(((mx - PAD.left) / IW) * 24);\n        const clamped = Math.max(0, Math.min(24, mo));\n        const d = data.find(x => x.month === clamped);\n        if (!d) { tip.style.display = 'none'; return; }\n\n        const cx = xOf(d.month);\n        const cy = yOf(d.cash);\n        const label = d.month === 0 ? 'Start' : 'Month ' + d.month + ' (' + fmtDate(d.month) + ')';\n        tip.innerHTML = '<strong>' + label + '</strong><br/>Cash: ' + fmtMoney(d.cash, false);\n        if (d.month > 0) {\n          const row = rows[d.month - 1];\n          tip.innerHTML += '<br/>Net: ' + (row.net >= 0 ? '+' : '') + fmtMoney(row.net, false);\n          if (row.raise > 0) tip.innerHTML += '<br/>Raise: +' + fmtMoney(row.raise, false);\n        }\n\n        let tx = cx + 14;\n        let ty = cy - 10;\n        tip.style.display = 'block';\n        const tw = tip.offsetWidth;\n        const th = tip.offsetHeight;\n        if (tx + tw > W - PAD.right) tx = cx - tw - 14;\n        if (ty < 0) ty = cy + 14;\n        if (ty + th > H - PAD.bottom) ty = H - PAD.bottom - th;\n        tip.style.left = tx + 'px';\n        tip.style.top  = ty + 'px';\n      });\n\n      svg.addEventListener('mouseleave', () => { tip.style.display = 'none'; });\n    }\n\n    // ─── Main render loop ─────────────────────────────────────────────────────\n    function getInputs() {\n      return {\n        cash:       parseFloat(inpCash.value)       || 0,\n        revenue:    parseFloat(inpRevenue.value)    || 0,\n        growth:     parseFloat(inpGrowth.value)     || 0,\n        expenses:   parseFloat(inpExpenses.value)   || 0,\n        raise:      parseFloat(inpRaise.value)      || 0,\n        raiseMonth: parseInt(inpRaiseMonth.value)   || 0\n      };\n    }\n\n    function render() {\n      const s       = getInputs();\n      const result  = forecast(s);\n      saveState(s);\n      updateKPIs(result);\n      updateTable(result.rows);\n      updateChart(result.rows, s);\n    }\n\n    // ─── Event listeners ──────────────────────────────────────────────────────\n    [inpCash, inpRevenue, inpGrowth, inpExpenses, inpRaise, inpRaiseMonth].forEach(el => {\n      el.addEventListener('input', render);\n    });\n\n    // Redraw chart on window resize\n    let resizeTimer;\n    window.addEventListener('resize', () => {\n      clearTimeout(resizeTimer);\n      resizeTimer = setTimeout(render, 120);\n    });\n\n    // ─── Boot ─────────────────────────────────────────────────────────────────\n    render();\n  </script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Runway Forecaster",
    "windowTitle": "Runway Forecaster",
    "bundleId": "com.halisonworks.runwayforecaster",
    "iconPath": null
  },
