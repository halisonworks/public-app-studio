{
  "schema": "app-studio/canvas@1",
  "id": "example-saas-prototype",
  "name": "saas-prototype.html",
  "code": "<!DOCTYPE html>\n<!--\n  SaaS Prototype — Halison App Studio example\n\n  An interactive prototype of a project-management app: sidebar navigation, a\n  task board with movable cards across To do / Doing / Done, and a settings view.\n  Mock data, no backend — a clickable demo of an idea.\n\n  From the Halison App Studio public library:\n  https://github.com/halisonworks/public-app-studio\n\n  Permitted use: personal, educational, and other non-commercial use. You may\n  modify it, but keep this header and the source link intact, and do not sell,\n  commercialize, or republish it. Released under the Halison App Studio Examples\n  License — see the LICENSE file in the repository above.\n-->\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Flowdesk — Project Management</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <script>\n    tailwind.config = {\n      darkMode: 'class',\n      theme: {\n        extend: {\n          colors: {\n            brand: {\n              50:  '#f0f4ff',\n              100: '#e0eaff',\n              200: '#c7d7fe',\n              300: '#a5b8fd',\n              400: '#818cf8',\n              500: '#6366f1',\n              600: '#4f46e5',\n              700: '#4338ca',\n              800: '#3730a3',\n              900: '#312e81',\n            }\n          }\n        }\n      }\n    }\n  </script>\n  <style>\n    body { font-family: 'Inter', system-ui, -apple-system, sans-serif; }\n    .nav-item { transition: background 0.15s, color 0.15s; }\n    .card-drag { cursor: grab; }\n    .task-card { transition: box-shadow 0.15s, transform 0.1s; }\n    .task-card:hover { transform: translateY(-1px); }\n    .toggle-track { transition: background 0.2s; }\n    .toggle-thumb { transition: transform 0.2s; }\n  </style>\n</head>\n<body class=\"bg-gray-50 text-gray-900 dark:bg-gray-900 dark:text-gray-100 min-h-screen\">\n\n<!-- ─── App Shell ─── -->\n<div id=\"app\" class=\"flex h-screen overflow-hidden\">\n\n  <!-- ─── Sidebar ─── -->\n  <aside id=\"sidebar\" class=\"w-60 flex-shrink-0 bg-white dark:bg-gray-800 border-r border-gray-200 dark:border-gray-700 flex flex-col\">\n    <!-- Logo -->\n    <div class=\"flex items-center gap-2 px-5 py-4 border-b border-gray-100 dark:border-gray-700\">\n      <div class=\"w-8 h-8 rounded-lg bg-brand-600 flex items-center justify-center\">\n        <svg class=\"w-4 h-4 text-white\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" viewBox=\"0 0 24 24\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z\"/>\n        </svg>\n      </div>\n      <span class=\"font-semibold text-gray-900 dark:text-white text-base tracking-tight\">Flowdesk</span>\n    </div>\n\n    <!-- Workspace badge -->\n    <div class=\"px-4 py-3 border-b border-gray-100 dark:border-gray-700\">\n      <div class=\"flex items-center gap-2 px-2 py-1.5 rounded-md bg-gray-50 dark:bg-gray-700/50\">\n        <div class=\"w-6 h-6 rounded bg-brand-500 text-white text-xs font-bold flex items-center justify-center flex-shrink-0\">A</div>\n        <div class=\"min-w-0\">\n          <p id=\"sidebar-ws-name\" class=\"text-xs font-medium text-gray-800 dark:text-gray-200 truncate\">Acme Corp</p>\n          <p class=\"text-[10px] text-gray-400\">Free plan</p>\n        </div>\n      </div>\n    </div>\n\n    <!-- Nav -->\n    <nav class=\"flex-1 px-3 py-3 space-y-0.5\">\n      <button onclick=\"navigate('dashboard')\" data-view=\"dashboard\"\n        class=\"nav-item w-full flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700\">\n        <svg class=\"w-4 h-4 flex-shrink-0\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6\"/>\n        </svg>\n        Dashboard\n      </button>\n      <button onclick=\"navigate('tasks')\" data-view=\"tasks\"\n        class=\"nav-item w-full flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700\">\n        <svg class=\"w-4 h-4 flex-shrink-0\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4\"/>\n        </svg>\n        Tasks\n      </button>\n      <button onclick=\"navigate('settings')\" data-view=\"settings\"\n        class=\"nav-item w-full flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700\">\n        <svg class=\"w-4 h-4 flex-shrink-0\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z\"/>\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M15 12a3 3 0 11-6 0 3 3 0 016 0z\"/>\n        </svg>\n        Settings\n      </button>\n    </nav>\n\n    <!-- User footer -->\n    <div class=\"border-t border-gray-100 dark:border-gray-700 px-4 py-3\">\n      <div class=\"flex items-center gap-2\">\n        <div class=\"w-7 h-7 rounded-full bg-gradient-to-br from-brand-400 to-brand-600 flex items-center justify-center text-white text-xs font-semibold flex-shrink-0\">SL</div>\n        <div class=\"min-w-0 flex-1\">\n          <p class=\"text-xs font-medium text-gray-800 dark:text-gray-200 truncate\">Sarah Lin</p>\n          <p class=\"text-[10px] text-gray-400 truncate\">sarah@acme.io</p>\n        </div>\n        <span class=\"text-[10px] font-medium bg-brand-100 dark:bg-brand-900 text-brand-700 dark:text-brand-300 px-1.5 py-0.5 rounded\">Admin</span>\n      </div>\n    </div>\n  </aside>\n\n  <!-- ─── Main content ─── -->\n  <main class=\"flex-1 overflow-y-auto\">\n\n    <!-- ─── Dashboard View ─── -->\n    <div id=\"view-dashboard\" class=\"hidden p-6 max-w-6xl mx-auto\">\n      <!-- Header -->\n      <div class=\"flex items-center justify-between mb-6\">\n        <div>\n          <h1 class=\"text-xl font-semibold text-gray-900 dark:text-white\">Dashboard</h1>\n          <p class=\"text-sm text-gray-500 dark:text-gray-400 mt-0.5\">Welcome back, Sarah. Here's what's happening.</p>\n        </div>\n        <div class=\"flex items-center gap-2\">\n          <span class=\"text-xs text-gray-400\">Sprint 4 · Jun 2026</span>\n          <span class=\"inline-flex items-center gap-1 text-xs font-medium text-emerald-700 bg-emerald-50 dark:bg-emerald-900/30 dark:text-emerald-400 px-2 py-0.5 rounded-full\">\n            <span class=\"w-1.5 h-1.5 rounded-full bg-emerald-500\"></span> Active\n          </span>\n        </div>\n      </div>\n\n      <!-- Summary cards -->\n      <div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8\">\n        <div class=\"bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4\">\n          <div class=\"flex items-center justify-between mb-3\">\n            <span class=\"text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wide\">Total Tasks</span>\n            <div class=\"w-7 h-7 rounded-lg bg-brand-50 dark:bg-brand-900/30 flex items-center justify-center\">\n              <svg class=\"w-3.5 h-3.5 text-brand-600 dark:text-brand-400\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2\"/></svg>\n            </div>\n          </div>\n          <p id=\"stat-total\" class=\"text-2xl font-bold text-gray-900 dark:text-white\">14</p>\n          <p class=\"text-xs text-gray-500 dark:text-gray-400 mt-0.5\">across all columns</p>\n        </div>\n\n        <div class=\"bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4\">\n          <div class=\"flex items-center justify-between mb-3\">\n            <span class=\"text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wide\">Completed</span>\n            <div class=\"w-7 h-7 rounded-lg bg-emerald-50 dark:bg-emerald-900/30 flex items-center justify-center\">\n              <svg class=\"w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z\"/></svg>\n            </div>\n          </div>\n          <p id=\"stat-done\" class=\"text-2xl font-bold text-gray-900 dark:text-white\">5</p>\n          <p id=\"stat-done-pct\" class=\"text-xs text-emerald-600 dark:text-emerald-400 mt-0.5\">36% of total</p>\n        </div>\n\n        <div class=\"bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4\">\n          <div class=\"flex items-center justify-between mb-3\">\n            <span class=\"text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wide\">In Progress</span>\n            <div class=\"w-7 h-7 rounded-lg bg-amber-50 dark:bg-amber-900/30 flex items-center justify-center\">\n              <svg class=\"w-3.5 h-3.5 text-amber-600 dark:text-amber-400\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z\"/></svg>\n            </div>\n          </div>\n          <p id=\"stat-doing\" class=\"text-2xl font-bold text-gray-900 dark:text-white\">5</p>\n          <p class=\"text-xs text-gray-500 dark:text-gray-400 mt-0.5\">active this sprint</p>\n        </div>\n\n        <div class=\"bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-4\">\n          <div class=\"flex items-center justify-between mb-3\">\n            <span class=\"text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wide\">Team Members</span>\n            <div class=\"w-7 h-7 rounded-lg bg-violet-50 dark:bg-violet-900/30 flex items-center justify-center\">\n              <svg class=\"w-3.5 h-3.5 text-violet-600 dark:text-violet-400\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z\"/></svg>\n            </div>\n          </div>\n          <p class=\"text-2xl font-bold text-gray-900 dark:text-white\">6</p>\n          <p class=\"text-xs text-gray-500 dark:text-gray-400 mt-0.5\">2 online now</p>\n        </div>\n      </div>\n\n      <!-- Progress bar + recent activity -->\n      <div class=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        <!-- Sprint progress -->\n        <div class=\"lg:col-span-2 bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5\">\n          <h2 class=\"text-sm font-semibold text-gray-800 dark:text-gray-200 mb-4\">Sprint Progress</h2>\n          <div class=\"space-y-3\">\n            <div>\n              <div class=\"flex justify-between text-xs text-gray-500 dark:text-gray-400 mb-1\">\n                <span>To Do</span>\n                <span id=\"prog-todo\">4 tasks</span>\n              </div>\n              <div class=\"h-2 bg-gray-100 dark:bg-gray-700 rounded-full overflow-hidden\">\n                <div id=\"bar-todo\" class=\"h-2 bg-gray-300 dark:bg-gray-500 rounded-full transition-all duration-500\" style=\"width:29%\"></div>\n              </div>\n            </div>\n            <div>\n              <div class=\"flex justify-between text-xs text-gray-500 dark:text-gray-400 mb-1\">\n                <span>Doing</span>\n                <span id=\"prog-doing\">5 tasks</span>\n              </div>\n              <div class=\"h-2 bg-gray-100 dark:bg-gray-700 rounded-full overflow-hidden\">\n                <div id=\"bar-doing\" class=\"h-2 bg-amber-400 rounded-full transition-all duration-500\" style=\"width:36%\"></div>\n              </div>\n            </div>\n            <div>\n              <div class=\"flex justify-between text-xs text-gray-500 dark:text-gray-400 mb-1\">\n                <span>Done</span>\n                <span id=\"prog-done\">5 tasks</span>\n              </div>\n              <div class=\"h-2 bg-gray-100 dark:bg-gray-700 rounded-full overflow-hidden\">\n                <div id=\"bar-done\" class=\"h-2 bg-emerald-500 rounded-full transition-all duration-500\" style=\"width:36%\"></div>\n              </div>\n            </div>\n          </div>\n\n          <!-- Mini team list -->\n          <div class=\"mt-5 pt-4 border-t border-gray-100 dark:border-gray-700\">\n            <p class=\"text-xs font-medium text-gray-500 dark:text-gray-400 mb-3 uppercase tracking-wide\">Team</p>\n            <div class=\"flex flex-wrap gap-3\">\n              <div class=\"flex items-center gap-2\">\n                <div class=\"relative\"><div class=\"w-7 h-7 rounded-full bg-gradient-to-br from-brand-400 to-brand-600 flex items-center justify-center text-white text-xs font-semibold\">SL</div><span class=\"absolute -bottom-0.5 -right-0.5 w-2.5 h-2.5 rounded-full bg-emerald-400 border-2 border-white dark:border-gray-800\"></span></div>\n                <span class=\"text-xs text-gray-700 dark:text-gray-300\">Sarah L.</span>\n              </div>\n              <div class=\"flex items-center gap-2\">\n                <div class=\"relative\"><div class=\"w-7 h-7 rounded-full bg-gradient-to-br from-rose-400 to-rose-600 flex items-center justify-center text-white text-xs font-semibold\">MK</div><span class=\"absolute -bottom-0.5 -right-0.5 w-2.5 h-2.5 rounded-full bg-emerald-400 border-2 border-white dark:border-gray-800\"></span></div>\n                <span class=\"text-xs text-gray-700 dark:text-gray-300\">Marcus K.</span>\n              </div>\n              <div class=\"flex items-center gap-2\">\n                <div class=\"relative\"><div class=\"w-7 h-7 rounded-full bg-gradient-to-br from-amber-400 to-amber-600 flex items-center justify-center text-white text-xs font-semibold\">JP</div></div>\n                <span class=\"text-xs text-gray-700 dark:text-gray-300\">Jana P.</span>\n              </div>\n              <div class=\"flex items-center gap-2\">\n                <div class=\"w-7 h-7 rounded-full bg-gradient-to-br from-teal-400 to-teal-600 flex items-center justify-center text-white text-xs font-semibold\">RN</div>\n                <span class=\"text-xs text-gray-700 dark:text-gray-300\">Ravi N.</span>\n              </div>\n              <div class=\"flex items-center gap-2\">\n                <div class=\"w-7 h-7 rounded-full bg-gradient-to-br from-purple-400 to-purple-600 flex items-center justify-center text-white text-xs font-semibold\">AO</div>\n                <span class=\"text-xs text-gray-700 dark:text-gray-300\">Amy O.</span>\n              </div>\n              <div class=\"flex items-center gap-2\">\n                <div class=\"w-7 h-7 rounded-full bg-gradient-to-br from-sky-400 to-sky-600 flex items-center justify-center text-white text-xs font-semibold\">TD</div>\n                <span class=\"text-xs text-gray-700 dark:text-gray-300\">Tom D.</span>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <!-- Recent activity -->\n        <div class=\"bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5\">\n          <h2 class=\"text-sm font-semibold text-gray-800 dark:text-gray-200 mb-4\">Recent Activity</h2>\n          <ol id=\"activity-feed\" class=\"space-y-3 text-xs text-gray-600 dark:text-gray-400\">\n            <li class=\"flex gap-2\"><span class=\"mt-0.5 w-1.5 h-1.5 rounded-full bg-emerald-400 flex-shrink-0\"></span><span><strong class=\"text-gray-800 dark:text-gray-200\">Marcus</strong> moved \"API rate-limit tests\" → Done</span></li>\n            <li class=\"flex gap-2\"><span class=\"mt-0.5 w-1.5 h-1.5 rounded-full bg-brand-400 flex-shrink-0\"></span><span><strong class=\"text-gray-800 dark:text-gray-200\">Sarah</strong> moved \"Onboarding flow redesign\" → Doing</span></li>\n            <li class=\"flex gap-2\"><span class=\"mt-0.5 w-1.5 h-1.5 rounded-full bg-gray-300 flex-shrink-0\"></span><span><strong class=\"text-gray-800 dark:text-gray-200\">Jana</strong> added \"CSV export feature\"</span></li>\n            <li class=\"flex gap-2\"><span class=\"mt-0.5 w-1.5 h-1.5 rounded-full bg-emerald-400 flex-shrink-0\"></span><span><strong class=\"text-gray-800 dark:text-gray-200\">Ravi</strong> moved \"Dark mode polish\" → Done</span></li>\n            <li class=\"flex gap-2\"><span class=\"mt-0.5 w-1.5 h-1.5 rounded-full bg-amber-400 flex-shrink-0\"></span><span><strong class=\"text-gray-800 dark:text-gray-200\">Amy</strong> moved \"Billing webhook\" → Doing</span></li>\n            <li class=\"flex gap-2\"><span class=\"mt-0.5 w-1.5 h-1.5 rounded-full bg-gray-300 flex-shrink-0\"></span><span><strong class=\"text-gray-800 dark:text-gray-200\">Tom</strong> added \"Slack notification integration\"</span></li>\n          </ol>\n        </div>\n      </div>\n    </div>\n\n    <!-- ─── Tasks View ─── -->\n    <div id=\"view-tasks\" class=\"hidden p-6\">\n      <div class=\"flex items-center justify-between mb-6\">\n        <div>\n          <h1 class=\"text-xl font-semibold text-gray-900 dark:text-white\">Task Board</h1>\n          <p class=\"text-sm text-gray-500 dark:text-gray-400 mt-0.5\">Sprint 4 · Drag or use arrows to move cards</p>\n        </div>\n        <div class=\"flex items-center gap-3\">\n          <div class=\"flex items-center gap-1.5 text-xs text-gray-500 dark:text-gray-400\">\n            <span class=\"inline-flex items-center gap-1 px-2 py-0.5 rounded bg-gray-100 dark:bg-gray-700\">◀ ▶ move card</span>\n          </div>\n        </div>\n      </div>\n\n      <!-- Board columns -->\n      <div class=\"flex gap-5 overflow-x-auto pb-4\" style=\"min-height: calc(100vh - 160px)\">\n        <!-- To Do column -->\n        <div class=\"flex-1 min-w-[260px]\">\n          <div class=\"flex items-center justify-between mb-3\">\n            <div class=\"flex items-center gap-2\">\n              <span class=\"w-2.5 h-2.5 rounded-full bg-gray-400\"></span>\n              <h2 class=\"text-sm font-semibold text-gray-700 dark:text-gray-300\">To Do</h2>\n              <span id=\"count-todo\" class=\"text-xs font-medium bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-400 px-1.5 py-0.5 rounded-full\">4</span>\n            </div>\n          </div>\n          <div id=\"col-todo\" class=\"space-y-3\"></div>\n        </div>\n\n        <!-- Doing column -->\n        <div class=\"flex-1 min-w-[260px]\">\n          <div class=\"flex items-center justify-between mb-3\">\n            <div class=\"flex items-center gap-2\">\n              <span class=\"w-2.5 h-2.5 rounded-full bg-amber-400\"></span>\n              <h2 class=\"text-sm font-semibold text-gray-700 dark:text-gray-300\">Doing</h2>\n              <span id=\"count-doing\" class=\"text-xs font-medium bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-400 px-1.5 py-0.5 rounded-full\">5</span>\n            </div>\n          </div>\n          <div id=\"col-doing\" class=\"space-y-3\"></div>\n        </div>\n\n        <!-- Done column -->\n        <div class=\"flex-1 min-w-[260px]\">\n          <div class=\"flex items-center justify-between mb-3\">\n            <div class=\"flex items-center gap-2\">\n              <span class=\"w-2.5 h-2.5 rounded-full bg-emerald-500\"></span>\n              <h2 class=\"text-sm font-semibold text-gray-700 dark:text-gray-300\">Done</h2>\n              <span id=\"count-done\" class=\"text-xs font-medium bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-400 px-1.5 py-0.5 rounded-full\">5</span>\n            </div>\n          </div>\n          <div id=\"col-done\" class=\"space-y-3\"></div>\n        </div>\n      </div>\n    </div>\n\n    <!-- ─── Settings View ─── -->\n    <div id=\"view-settings\" class=\"hidden p-6 max-w-2xl mx-auto\">\n      <div class=\"mb-6\">\n        <h1 class=\"text-xl font-semibold text-gray-900 dark:text-white\">Settings</h1>\n        <p class=\"text-sm text-gray-500 dark:text-gray-400 mt-0.5\">Manage your workspace preferences</p>\n      </div>\n\n      <!-- Workspace -->\n      <section class=\"bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5 mb-5\">\n        <h2 class=\"text-sm font-semibold text-gray-800 dark:text-gray-200 mb-4\">Workspace</h2>\n        <div class=\"space-y-4\">\n          <div>\n            <label class=\"block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1\">Workspace Name</label>\n            <input id=\"ws-name-input\" type=\"text\" value=\"Acme Corp\"\n              class=\"w-full px-3 py-2 text-sm rounded-lg border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent\"\n              oninput=\"updateWorkspaceName(this.value)\">\n          </div>\n          <div>\n            <label class=\"block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1\">Workspace URL</label>\n            <div class=\"flex\">\n              <span class=\"inline-flex items-center px-3 py-2 text-xs text-gray-500 dark:text-gray-400 bg-gray-50 dark:bg-gray-600 border border-r-0 border-gray-200 dark:border-gray-600 rounded-l-lg\">flowdesk.app/</span>\n              <input id=\"ws-slug-input\" type=\"text\" value=\"acme-corp\"\n                class=\"flex-1 px-3 py-2 text-sm rounded-r-lg border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent\">\n            </div>\n          </div>\n          <div>\n            <label class=\"block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1\">Time Zone</label>\n            <select class=\"w-full px-3 py-2 text-sm rounded-lg border border-gray-200 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-brand-500\">\n              <option value=\"utc\">UTC+0 — London</option>\n              <option value=\"cet\" selected>UTC+1 — Central European Time</option>\n              <option value=\"est\">UTC-5 — Eastern Time</option>\n              <option value=\"pst\">UTC-8 — Pacific Time</option>\n            </select>\n          </div>\n          <div class=\"pt-1\">\n            <button id=\"save-btn\" onclick=\"saveSettings()\"\n              class=\"px-4 py-2 text-sm font-medium bg-brand-600 hover:bg-brand-700 text-white rounded-lg transition-colors\">\n              Save changes\n            </button>\n            <span id=\"save-feedback\" class=\"hidden ml-3 text-xs text-emerald-600 dark:text-emerald-400 font-medium\">Saved!</span>\n          </div>\n        </div>\n      </section>\n\n      <!-- Appearance -->\n      <section class=\"bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5 mb-5\">\n        <h2 class=\"text-sm font-semibold text-gray-800 dark:text-gray-200 mb-4\">Appearance</h2>\n        <div class=\"flex items-center justify-between\">\n          <div>\n            <p class=\"text-sm font-medium text-gray-800 dark:text-gray-200\">Dark Mode</p>\n            <p class=\"text-xs text-gray-500 dark:text-gray-400 mt-0.5\">Use a darker color scheme</p>\n          </div>\n          <button id=\"dark-toggle\" onclick=\"toggleDark()\" role=\"switch\" aria-checked=\"false\"\n            class=\"toggle-track relative inline-flex w-10 h-5.5 rounded-full bg-gray-200 dark:bg-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-1\"\n            style=\"width:40px;height:22px;\">\n            <span id=\"dark-thumb\" class=\"toggle-thumb absolute left-0.5 top-0.5 w-4.5 h-4.5 rounded-full bg-white shadow-sm\"\n              style=\"width:18px;height:18px;top:2px;left:2px;\"></span>\n          </button>\n        </div>\n      </section>\n\n      <!-- Notifications -->\n      <section class=\"bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5\">\n        <h2 class=\"text-sm font-semibold text-gray-800 dark:text-gray-200 mb-4\">Notifications</h2>\n        <div class=\"space-y-4\">\n          <!-- Toggle rows -->\n          <div class=\"flex items-center justify-between\">\n            <div>\n              <p class=\"text-sm font-medium text-gray-800 dark:text-gray-200\">Task assignments</p>\n              <p class=\"text-xs text-gray-500 dark:text-gray-400 mt-0.5\">When someone assigns a task to you</p>\n            </div>\n            <button onclick=\"toggleNotif(this)\" data-on=\"true\" role=\"switch\" aria-checked=\"true\"\n              class=\"toggle-track relative inline-flex rounded-full bg-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-1\"\n              style=\"width:40px;height:22px;\">\n              <span class=\"toggle-thumb absolute rounded-full bg-white shadow-sm\" style=\"width:18px;height:18px;top:2px;left:20px;\"></span>\n            </button>\n          </div>\n          <div class=\"flex items-center justify-between\">\n            <div>\n              <p class=\"text-sm font-medium text-gray-800 dark:text-gray-200\">Status updates</p>\n              <p class=\"text-xs text-gray-500 dark:text-gray-400 mt-0.5\">When tasks you own change status</p>\n            </div>\n            <button onclick=\"toggleNotif(this)\" data-on=\"true\" role=\"switch\" aria-checked=\"true\"\n              class=\"toggle-track relative inline-flex rounded-full bg-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-1\"\n              style=\"width:40px;height:22px;\">\n              <span class=\"toggle-thumb absolute rounded-full bg-white shadow-sm\" style=\"width:18px;height:18px;top:2px;left:20px;\"></span>\n            </button>\n          </div>\n          <div class=\"flex items-center justify-between\">\n            <div>\n              <p class=\"text-sm font-medium text-gray-800 dark:text-gray-200\">Sprint summaries</p>\n              <p class=\"text-xs text-gray-500 dark:text-gray-400 mt-0.5\">Weekly digest every Monday</p>\n            </div>\n            <button onclick=\"toggleNotif(this)\" data-on=\"false\" role=\"switch\" aria-checked=\"false\"\n              class=\"toggle-track relative inline-flex rounded-full bg-gray-200 dark:bg-gray-600 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-1\"\n              style=\"width:40px;height:22px;\">\n              <span class=\"toggle-thumb absolute rounded-full bg-white shadow-sm\" style=\"width:18px;height:18px;top:2px;left:2px;\"></span>\n            </button>\n          </div>\n          <div class=\"flex items-center justify-between\">\n            <div>\n              <p class=\"text-sm font-medium text-gray-800 dark:text-gray-200\">Comments &amp; mentions</p>\n              <p class=\"text-xs text-gray-500 dark:text-gray-400 mt-0.5\">Notify when someone @mentions you</p>\n            </div>\n            <button onclick=\"toggleNotif(this)\" data-on=\"true\" role=\"switch\" aria-checked=\"true\"\n              class=\"toggle-track relative inline-flex rounded-full bg-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-1\"\n              style=\"width:40px;height:22px;\">\n              <span class=\"toggle-thumb absolute rounded-full bg-white shadow-sm\" style=\"width:18px;height:18px;top:2px;left:20px;\"></span>\n            </button>\n          </div>\n          <div class=\"flex items-center justify-between\">\n            <div>\n              <p class=\"text-sm font-medium text-gray-800 dark:text-gray-200\">Marketing emails</p>\n              <p class=\"text-xs text-gray-500 dark:text-gray-400 mt-0.5\">Product news and tips</p>\n            </div>\n            <button onclick=\"toggleNotif(this)\" data-on=\"false\" role=\"switch\" aria-checked=\"false\"\n              class=\"toggle-track relative inline-flex rounded-full bg-gray-200 dark:bg-gray-600 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-1\"\n              style=\"width:40px;height:22px;\">\n              <span class=\"toggle-thumb absolute rounded-full bg-white shadow-sm\" style=\"width:18px;height:18px;top:2px;left:2px;\"></span>\n            </button>\n          </div>\n        </div>\n      </section>\n    </div>\n\n  </main>\n</div>\n\n<script>\n  // ─── State ───────────────────────────────────────────────────────────────────\n  var currentView = 'dashboard';\n  var darkMode = false;\n\n  var tasks = [\n    // To Do\n    { id: 1, col: 'todo',  title: 'CSV export feature',                 tag: 'Feature',  priority: 'medium', assignee: 'JP', color: 'amber' },\n    { id: 2, col: 'todo',  title: 'Slack notification integration',     tag: 'Feature',  priority: 'high',   assignee: 'TD', color: 'sky' },\n    { id: 3, col: 'todo',  title: 'Keyboard shortcut map',              tag: 'UX',       priority: 'low',    assignee: 'SL', color: 'brand' },\n    { id: 4, col: 'todo',  title: 'Invite team by email link',          tag: 'Feature',  priority: 'medium', assignee: 'AO', color: 'purple' },\n    // Doing\n    { id: 5, col: 'doing', title: 'Onboarding flow redesign',           tag: 'Design',   priority: 'high',   assignee: 'SL', color: 'brand' },\n    { id: 6, col: 'doing', title: 'Billing webhook handler',            tag: 'Backend',  priority: 'high',   assignee: 'MK', color: 'rose' },\n    { id: 7, col: 'doing', title: 'Mobile responsive layout',           tag: 'Frontend', priority: 'medium', assignee: 'JP', color: 'amber' },\n    { id: 8, col: 'doing', title: 'Search autocomplete',                tag: 'Frontend', priority: 'medium', assignee: 'RN', color: 'teal' },\n    { id: 9, col: 'doing', title: 'Usage analytics dashboard',          tag: 'Feature',  priority: 'low',    assignee: 'AO', color: 'purple' },\n    // Done\n    { id: 10, col: 'done', title: 'Dark mode polish',                   tag: 'Design',   priority: 'low',    assignee: 'RN', color: 'teal' },\n    { id: 11, col: 'done', title: 'API rate-limit tests',               tag: 'Backend',  priority: 'high',   assignee: 'MK', color: 'rose' },\n    { id: 12, col: 'done', title: 'User role permissions',              tag: 'Backend',  priority: 'high',   assignee: 'TD', color: 'sky' },\n    { id: 13, col: 'done', title: 'Password reset email flow',          tag: 'Feature',  priority: 'medium', assignee: 'SL', color: 'brand' },\n    { id: 14, col: 'done', title: 'Stripe subscription integration',    tag: 'Backend',  priority: 'high',   assignee: 'MK', color: 'rose' },\n  ];\n\n  var colOrder = ['todo', 'doing', 'done'];\n\n  var tagColors = {\n    'Feature':  'bg-brand-100 text-brand-700 dark:bg-brand-900/40 dark:text-brand-300',\n    'Design':   'bg-violet-100 text-violet-700 dark:bg-violet-900/40 dark:text-violet-300',\n    'Backend':  'bg-rose-100 text-rose-700 dark:bg-rose-900/40 dark:text-rose-300',\n    'Frontend': 'bg-sky-100 text-sky-700 dark:bg-sky-900/40 dark:text-sky-300',\n    'UX':       'bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300',\n  };\n\n  var priorityConfig = {\n    high:   { label: 'High',   dot: 'bg-rose-500' },\n    medium: { label: 'Med',    dot: 'bg-amber-400' },\n    low:    { label: 'Low',    dot: 'bg-emerald-400' },\n  };\n\n  var assigneeColors = {\n    SL: 'from-brand-400 to-brand-600',\n    MK: 'from-rose-400 to-rose-600',\n    JP: 'from-amber-400 to-amber-600',\n    RN: 'from-teal-400 to-teal-600',\n    AO: 'from-purple-400 to-purple-600',\n    TD: 'from-sky-400 to-sky-600',\n  };\n\n  // ─── Navigation ──────────────────────────────────────────────────────────────\n  function navigate(view) {\n    currentView = view;\n    ['dashboard', 'tasks', 'settings'].forEach(function(v) {\n      var el = document.getElementById('view-' + v);\n      if (el) el.classList.toggle('hidden', v !== view);\n    });\n    document.querySelectorAll('[data-view]').forEach(function(btn) {\n      var active = btn.dataset.view === view;\n      btn.classList.toggle('bg-brand-50', active);\n      btn.classList.toggle('dark:bg-brand-900/30', active);\n      btn.classList.toggle('text-brand-700', active);\n      btn.classList.toggle('dark:text-brand-400', active);\n      btn.classList.toggle('font-semibold', active);\n      btn.classList.toggle('text-gray-600', !active);\n      btn.classList.toggle('dark:text-gray-400', !active);\n      btn.classList.toggle('font-medium', !active);\n    });\n    if (view === 'tasks') renderBoard();\n    if (view === 'dashboard') updateDashboardStats();\n  }\n\n  // ─── Task board ──────────────────────────────────────────────────────────────\n  function renderBoard() {\n    var cols = { todo: [], doing: [], done: [] };\n    tasks.forEach(function(t) { if (cols[t.col]) cols[t.col].push(t); });\n\n    ['todo', 'doing', 'done'].forEach(function(col) {\n      var container = document.getElementById('col-' + col);\n      var countEl   = document.getElementById('count-' + col);\n      if (!container) return;\n      countEl.textContent = cols[col].length;\n      container.innerHTML = '';\n      if (cols[col].length === 0) {\n        container.innerHTML = '<div class=\"text-center py-10 text-xs text-gray-400 dark:text-gray-600 border-2 border-dashed border-gray-200 dark:border-gray-700 rounded-xl\">No tasks here</div>';\n        return;\n      }\n      cols[col].forEach(function(task) {\n        container.appendChild(buildCard(task, col));\n      });\n    });\n  }\n\n  function buildCard(task, col) {\n    var idx = colOrder.indexOf(col);\n    var canLeft  = idx > 0;\n    var canRight = idx < colOrder.length - 1;\n    var leftLabel  = idx > 0  ? '◀ ' + colLabel(colOrder[idx - 1]) : '';\n    var rightLabel = idx < 2  ? colLabel(colOrder[idx + 1]) + ' ▶' : '';\n\n    var pCfg = priorityConfig[task.priority] || priorityConfig.low;\n    var tagCls = tagColors[task.tag] || 'bg-gray-100 text-gray-600';\n    var avatarGrad = assigneeColors[task.assignee] || 'from-gray-400 to-gray-600';\n\n    var card = document.createElement('div');\n    card.className = 'task-card bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-3.5 shadow-sm';\n    card.innerHTML =\n      '<div class=\"flex items-start justify-between gap-2 mb-2\">' +\n        '<p class=\"text-sm font-medium text-gray-800 dark:text-gray-200 leading-snug flex-1\">' + escHtml(task.title) + '</p>' +\n        '<div class=\"flex-shrink-0 w-6 h-6 rounded-full bg-gradient-to-br ' + avatarGrad + ' flex items-center justify-center text-white text-[10px] font-semibold\">' + escHtml(task.assignee) + '</div>' +\n      '</div>' +\n      '<div class=\"flex items-center gap-1.5 mb-3\">' +\n        '<span class=\"text-[10px] font-medium px-1.5 py-0.5 rounded ' + tagCls + '\">' + escHtml(task.tag) + '</span>' +\n        '<span class=\"flex items-center gap-1 text-[10px] text-gray-500 dark:text-gray-400\">' +\n          '<span class=\"w-1.5 h-1.5 rounded-full ' + pCfg.dot + '\"></span>' + pCfg.label +\n        '</span>' +\n      '</div>' +\n      '<div class=\"flex items-center gap-2\">' +\n        (canLeft  ? '<button onclick=\"moveTask(' + task.id + ',\\'' + colOrder[idx - 1] + '\\')\" class=\"flex-1 text-[11px] font-medium text-gray-500 dark:text-gray-400 hover:text-brand-600 dark:hover:text-brand-400 hover:bg-gray-50 dark:hover:bg-gray-700 rounded-lg px-2 py-1 text-left border border-gray-100 dark:border-gray-700 transition-colors\">' + leftLabel + '</button>' : '<div class=\"flex-1\"></div>') +\n        (canRight ? '<button onclick=\"moveTask(' + task.id + ',\\'' + colOrder[idx + 1] + '\\')\" class=\"flex-1 text-[11px] font-medium text-gray-500 dark:text-gray-400 hover:text-brand-600 dark:hover:text-brand-400 hover:bg-gray-50 dark:hover:bg-gray-700 rounded-lg px-2 py-1 text-right border border-gray-100 dark:border-gray-700 transition-colors\">' + rightLabel + '</button>' : '<div class=\"flex-1\"></div>') +\n      '</div>';\n    return card;\n  }\n\n  function colLabel(col) {\n    return col === 'todo' ? 'To Do' : col === 'doing' ? 'Doing' : 'Done';\n  }\n\n  function moveTask(id, targetCol) {\n    var task = tasks.find(function(t) { return t.id === id; });\n    if (!task) return;\n    task.col = targetCol;\n    renderBoard();\n    updateDashboardStats();\n    addActivityItem(task, targetCol);\n  }\n\n  function addActivityItem(task, col) {\n    var feed = document.getElementById('activity-feed');\n    if (!feed) return;\n    var names = { SL: 'Sarah', MK: 'Marcus', JP: 'Jana', RN: 'Ravi', AO: 'Amy', TD: 'Tom' };\n    var dotCls = col === 'done' ? 'bg-emerald-400' : col === 'doing' ? 'bg-amber-400' : 'bg-gray-300';\n    var li = document.createElement('li');\n    li.className = 'flex gap-2';\n    li.innerHTML = '<span class=\"mt-0.5 w-1.5 h-1.5 rounded-full ' + dotCls + ' flex-shrink-0\"></span>' +\n      '<span><strong class=\"text-gray-800 dark:text-gray-200\">' + (names[task.assignee] || task.assignee) + '</strong>' +\n      ' moved \"' + escHtml(task.title) + '\" → ' + colLabel(col) + '</span>';\n    feed.prepend(li);\n    // keep feed tidy — max 8 items\n    while (feed.children.length > 8) feed.removeChild(feed.lastChild);\n  }\n\n  // ─── Dashboard stats ─────────────────────────────────────────────────────────\n  function updateDashboardStats() {\n    var counts = { todo: 0, doing: 0, done: 0 };\n    tasks.forEach(function(t) { if (counts[t.col] !== undefined) counts[t.col]++; });\n    var total = tasks.length;\n\n    var elTotal = document.getElementById('stat-total');\n    var elDone  = document.getElementById('stat-done');\n    var elDonePct = document.getElementById('stat-done-pct');\n    var elDoing = document.getElementById('stat-doing');\n    if (elTotal)   elTotal.textContent   = total;\n    if (elDone)    elDone.textContent    = counts.done;\n    if (elDonePct) elDonePct.textContent = (total ? Math.round(counts.done / total * 100) : 0) + '% of total';\n    if (elDoing)   elDoing.textContent   = counts.doing;\n\n    var progTodo  = document.getElementById('prog-todo');\n    var progDoing = document.getElementById('prog-doing');\n    var progDone  = document.getElementById('prog-done');\n    if (progTodo)  progTodo.textContent  = counts.todo  + ' task' + (counts.todo  !== 1 ? 's' : '');\n    if (progDoing) progDoing.textContent = counts.doing + ' task' + (counts.doing !== 1 ? 's' : '');\n    if (progDone)  progDone.textContent  = counts.done  + ' task' + (counts.done  !== 1 ? 's' : '');\n\n    var barTodo  = document.getElementById('bar-todo');\n    var barDoing = document.getElementById('bar-doing');\n    var barDone  = document.getElementById('bar-done');\n    if (barTodo)  barTodo.style.width  = (total ? Math.round(counts.todo  / total * 100) : 0) + '%';\n    if (barDoing) barDoing.style.width = (total ? Math.round(counts.doing / total * 100) : 0) + '%';\n    if (barDone)  barDone.style.width  = (total ? Math.round(counts.done  / total * 100) : 0) + '%';\n  }\n\n  // ─── Settings ────────────────────────────────────────────────────────────────\n  function updateWorkspaceName(val) {\n    var el = document.getElementById('sidebar-ws-name');\n    if (el) el.textContent = val || 'Untitled';\n  }\n\n  function saveSettings() {\n    var fb = document.getElementById('save-feedback');\n    if (!fb) return;\n    fb.classList.remove('hidden');\n    setTimeout(function() { fb.classList.add('hidden'); }, 2000);\n  }\n\n  function toggleDark() {\n    darkMode = !darkMode;\n    document.documentElement.classList.toggle('dark', darkMode);\n    var btn   = document.getElementById('dark-toggle');\n    var thumb = document.getElementById('dark-thumb');\n    if (btn) {\n      btn.style.background = darkMode ? '#4f46e5' : '';\n      btn.setAttribute('aria-checked', darkMode ? 'true' : 'false');\n    }\n    if (thumb) {\n      thumb.style.transform = darkMode ? 'translateX(18px)' : 'translateX(0)';\n    }\n  }\n\n  function toggleNotif(btn) {\n    var on = btn.dataset.on === 'true';\n    on = !on;\n    btn.dataset.on = on ? 'true' : 'false';\n    btn.setAttribute('aria-checked', on ? 'true' : 'false');\n    btn.style.background = on ? '#4f46e5' : '';\n    if (!on) btn.classList.add('bg-gray-200', 'dark:bg-gray-600');\n    else     btn.classList.remove('bg-gray-200', 'dark:bg-gray-600');\n    var thumb = btn.querySelector('.toggle-thumb');\n    if (thumb) thumb.style.left = on ? '20px' : '2px';\n  }\n\n  // ─── Utility ─────────────────────────────────────────────────────────────────\n  function escHtml(str) {\n    return String(str)\n      .replace(/&/g, '&amp;')\n      .replace(/</g, '&lt;')\n      .replace(/>/g, '&gt;')\n      .replace(/\"/g, '&quot;');\n  }\n\n  // ─── Boot ─────────────────────────────────────────────────────────────────────\n  navigate('dashboard');\n</script>\n</body>\n</html>\n",
