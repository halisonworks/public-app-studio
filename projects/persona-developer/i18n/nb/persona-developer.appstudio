{
  "schema": "app-studio/canvas@1",
  "id": "example-persona-developer-nb",
  "name": "persona-developer.html",
  "code": "<!DOCTYPE html>\n<!--\n  Persona-utvikler — Halison App Studio-eksempel\n\n  Et metodeverktøy for å bygge kundepersonas: demografi, geografi, psykografi og\n  atferd. Tre moduser — Læremodus, Praksismodus og Presentasjon — med maler, en\n  inspirasjons-generator og et rent persona-kort for projektor/utskrift.\n\n  Fra Halison App Studio sitt offentlige bibliotek:\n  https://github.com/halisonworks/public-app-studio\n\n  Tillatt bruk: personlig, pedagogisk og annen ikke-kommersiell bruk. Du kan\n  endre den, men behold denne headeren og kildelenken, og du må ikke selge,\n  kommersialisere eller republisere den. Utgitt under Halison App Studio\n  Examples License — se LICENSE-filen i repoet over.\n-->\n<html lang=\"no\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Persona-utvikler for Canvas</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n\n    <style>\n        body {\n            font-family: 'Inter', sans-serif;\n            background-color: #f8fafc;\n        }\n        ::-webkit-scrollbar {\n            width: 8px;\n        }\n        ::-webkit-scrollbar-track {\n            background: #f1f5f9;\n        }\n        ::-webkit-scrollbar-thumb {\n            background: #cbd5e1;\n            border-radius: 9999px;\n        }\n        ::-webkit-scrollbar-thumb:hover {\n            background: #94a3b8;\n        }\n\n        /* Print-optimalisering for å fjerne støy og isolere kun selve kortet */\n        @media print {\n            body {\n                background: #ffffff !important;\n            }\n            .no-print {\n                display: none !important;\n            }\n            .print-container {\n                display: block !important;\n                width: 100% !important;\n            }\n            .print-bg-primary {\n                background-color: #1e293b !important;\n                -webkit-print-color-adjust: exact;\n                print-color-adjust: exact;\n            }\n            .print-bg-card {\n                background-color: #ffffff !important;\n                border: 1px solid #e2e8f0 !important;\n                -webkit-print-color-adjust: exact;\n                print-color-adjust: exact;\n            }\n            .print-text-white {\n                color: #ffffff !important;\n                -webkit-print-color-adjust: exact;\n                print-color-adjust: exact;\n            }\n        }\n        .template-btn {\n            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);\n        }\n        .template-btn:hover {\n            transform: translateY(-2px);\n        }\n    </style>\n</head>\n<body class=\"min-h-screen text-slate-800 antialiased flex flex-col justify-between pb-12\">\n\n    <div class=\"max-w-6xl w-full mx-auto px-4 sm:px-6 lg:px-8 mt-6 flex-grow\">\n\n        <!-- GLOBAL HEADER (Skjules i presentasjonsmodus) -->\n        <header id=\"global-header\" class=\"mb-8 no-print flex flex-col sm:flex-row items-center justify-between gap-4 border-b border-slate-200 pb-6\">\n            <div>\n                <div class=\"flex items-center gap-2 mb-1\">\n                    <span class=\"p-1.5 bg-slate-900 text-white rounded-lg inline-flex items-center justify-center\">\n                        <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\">\n                            <path d=\"M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z\"></path>\n                        </svg>\n                    </span>\n                    <span class=\"text-xs font-bold uppercase tracking-wider text-slate-500\">LK20 Fagverktøy</span>\n                </div>\n                <h1 class=\"text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight\">Persona-utvikler</h1>\n            </div>\n            <div class=\"flex items-center gap-3\">\n                <button onclick=\"openResetModal()\" class=\"px-3.5 py-2 text-xs font-semibold text-rose-600 hover:bg-rose-50 border border-rose-200 rounded-lg transition-all flex items-center gap-1.5 shadow-sm bg-white\">\n                    <svg class=\"w-3.5 h-3.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" viewBox=\"0 0 24 24\">\n                        <path d=\"M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16\"></path>\n                    </svg>\n                    Nullstill felt\n                </button>\n            </div>\n        </header>\n\n        <!-- GLOBAL TO-LEVEL NAV (Skjules i presentasjon og utskrift) -->\n        <nav id=\"global-nav\" class=\"no-print bg-slate-100 p-1.5 rounded-xl mb-8 flex flex-wrap gap-1 border border-slate-200/60 shadow-inner\">\n            <button id=\"btn-learn\" onclick=\"switchTab('learn')\" class=\"flex-1 min-w-[120px] flex items-center justify-center gap-2 px-4 py-3 rounded-lg text-sm font-semibold transition-all duration-200 bg-white text-slate-900 shadow-sm border border-slate-200/50\">\n                1. Læremodus\n            </button>\n            <button id=\"btn-practice\" onclick=\"switchTab('practice')\" class=\"flex-1 min-w-[120px] flex items-center justify-center gap-2 px-4 py-3 rounded-lg text-sm font-semibold transition-all duration-200 text-slate-600 hover:text-slate-900\">\n                2. Praksismodus\n            </button>\n            <button id=\"btn-present\" onclick=\"switchTab('present')\" class=\"flex-1 min-w-[120px] flex items-center justify-center gap-2 px-4 py-3 rounded-lg text-sm font-semibold transition-all duration-200 text-slate-600 hover:text-slate-900 bg-indigo-50/50 text-indigo-700 hover:bg-indigo-50\">\n                3. Presentasjon\n            </button>\n        </nav>\n\n        <!-- HURTIGSTART OG MALER (Skjules i presentasjonsmodus) -->\n        <div id=\"template-section\" class=\"no-print mb-8 space-y-3\">\n            <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2\">\n                <h3 class=\"text-xs font-bold text-slate-500 uppercase tracking-widest flex items-center gap-2\">\n                    <svg class=\"w-4 h-4 text-indigo-600\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\">\n                        <path d=\"M13 10V3L4 14h7v7l9-11h-7z\"></path>\n                    </svg>\n                    Hurtigstart: Velg en målgruppe-mal eller la deg inspirere\n                </h3>\n                <button onclick=\"generateRandomPersona()\" class=\"text-xs font-bold text-indigo-700 hover:text-indigo-800 flex items-center justify-center gap-1.5 bg-indigo-100 hover:bg-indigo-200 px-3.5 py-2 rounded-lg transition-all shadow-sm\">\n                    <span>🎲</span> Inspirasjons-generator\n                </button>\n            </div>\n            <div class=\"grid grid-cols-2 md:grid-cols-4 gap-3\">\n                <button onclick=\"loadTemplate('student')\" class=\"template-btn p-3 bg-white border border-slate-200 rounded-xl text-left hover:border-indigo-400 hover:shadow-md group transition-all\">\n                    <div class=\"text-xl mb-1\">🧑‍🎓</div>\n                    <div class=\"text-[11px] font-bold text-slate-900 uppercase\">UB / Skoleelev</div>\n                    <div class=\"text-[10px] text-slate-500 line-clamp-1\">Ungdomsbedrift / Digitale trender</div>\n                </button>\n                <button onclick=\"loadTemplate('parent')\" class=\"template-btn p-3 bg-white border border-slate-200 rounded-xl text-left hover:border-emerald-400 hover:shadow-md group transition-all\">\n                    <div class=\"text-xl mb-1\">🌱</div>\n                    <div class=\"text-[11px] font-bold text-slate-900 uppercase\">Miljø-forelder</div>\n                    <div class=\"text-[10px] text-slate-500 line-clamp-1\">Bærekraft og praktisk hverdag</div>\n                </button>\n                <button onclick=\"loadTemplate('senior')\" class=\"template-btn p-3 bg-white border border-slate-200 rounded-xl text-left hover:border-amber-400 hover:shadow-md group transition-all\">\n                    <div class=\"text-xl mb-1\">👴</div>\n                    <div class=\"text-[11px] font-bold text-slate-900 uppercase\">Digital Senior</div>\n                    <div class=\"text-[10px] text-slate-500 line-clamp-1\">Forenkling og personlig service</div>\n                </button>\n                <button onclick=\"loadTemplate('b2b')\" class=\"template-btn p-3 bg-white border border-slate-200 rounded-xl text-left hover:border-slate-400 hover:shadow-md group transition-all\">\n                    <div class=\"text-xl mb-1\">💼</div>\n                    <div class=\"text-[11px] font-bold text-slate-900 uppercase\">Bedriftsleder</div>\n                    <div class=\"text-[10px] text-slate-500 line-clamp-1\">Målrettet B2B-salg og ROI</div>\n                </button>\n            </div>\n        </div>\n\n        <!-- DEL 1: LÆREMODUS -->\n        <div id=\"panel-learn\" class=\"tab-panel space-y-8\">\n            <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-8\">\n\n                <!-- Demografi, Geografi & Urbanitet -->\n                <div class=\"bg-white rounded-2xl border border-slate-200 p-6 shadow-sm space-y-6\">\n                    <div class=\"border-b border-slate-100 pb-4\">\n                        <span class=\"text-xs font-bold text-indigo-600 uppercase tracking-widest\">Del A</span>\n                        <h2 class=\"text-lg font-bold text-slate-950 mt-1\">Demografi & Geografi</h2>\n                    </div>\n                    <div class=\"bg-indigo-50/50 border-l-4 border-indigo-500 p-4 rounded-r-xl\">\n                        <p class=\"text-xs text-indigo-800 leading-relaxed\"><strong>Hva er dette?</strong> Demografi og geografi kartlegger de ytre, målbare faktaene rundt kunden din. Det gjør markedsstørrelsen enklere å beregne.</p>\n                    </div>\n                    <div class=\"space-y-4\">\n                        <div class=\"space-y-1.5\">\n                            <label class=\"text-xs font-bold text-slate-700 uppercase\">Fullt Navn</label>\n                            <input type=\"text\" data-bind=\"name\" placeholder=\"F.eks. Camilla Karrière\" class=\"w-full px-3.5 py-2.5 rounded-lg border border-slate-200 focus:border-indigo-500 text-sm outline-none transition-all\">\n                        </div>\n                        <div class=\"grid grid-cols-2 gap-4\">\n                            <div class=\"space-y-1.5\">\n                                <label class=\"text-xs font-bold text-slate-700 uppercase\">Alder</label>\n                                <input type=\"number\" data-bind=\"age\" placeholder=\"F.eks. 34\" class=\"w-full px-3.5 py-2.5 rounded-lg border border-slate-200 focus:border-indigo-500 text-sm outline-none transition-all\">\n                            </div>\n                            <div class=\"space-y-1.5\">\n                                <label class=\"text-xs font-bold text-slate-700 uppercase\">Sivilstatus</label>\n                                <input type=\"text\" data-bind=\"civil\" placeholder=\"F.eks. Samboer, 1 barn\" class=\"w-full px-3.5 py-2.5 rounded-lg border border-slate-200 focus:border-indigo-500 text-sm outline-none transition-all\">\n                            </div>\n                        </div>\n                        <div class=\"grid grid-cols-2 gap-4\">\n                            <div class=\"space-y-1.5\">\n                                <label class=\"text-xs font-bold text-slate-700 uppercase\">Yrke / Tittel</label>\n                                <input type=\"text\" data-bind=\"occupation\" placeholder=\"F.eks. Prosjektleder\" class=\"w-full px-3.5 py-2.5 rounded-lg border border-slate-200 focus:border-indigo-500 text-sm outline-none transition-all\">\n                            </div>\n                            <div class=\"space-y-1.5\">\n                                <label class=\"text-xs font-bold text-slate-700 uppercase\">Inntekt / Ressurser</label>\n                                <input type=\"text\" data-bind=\"income\" placeholder=\"F.eks. 650 000 kr\" class=\"w-full px-3.5 py-2.5 rounded-lg border border-slate-200 focus:border-indigo-500 text-sm outline-none transition-all\">\n                            </div>\n                        </div>\n                        <div class=\"grid grid-cols-2 gap-4\">\n                            <div class=\"space-y-1.5\">\n                                <label class=\"text-xs font-bold text-slate-700 uppercase\">Bosted</label>\n                                <input type=\"text\" data-bind=\"location\" placeholder=\"F.eks. Oslo\" class=\"w-full px-3.5 py-2.5 rounded-lg border border-slate-200 focus:border-indigo-500 text-sm outline-none transition-all\">\n                            </div>\n                            <div class=\"space-y-1.5\">\n                                <label class=\"text-xs font-bold text-slate-700 uppercase\">Urbanitet / Miljø</label>\n                                <input type=\"text\" data-bind=\"urbanity\" placeholder=\"F.eks. Storby / Forstad / Bygd\" class=\"w-full px-3.5 py-2.5 rounded-lg border border-slate-200 focus:border-indigo-500 text-sm outline-none transition-all\">\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Psykografi & Atferd -->\n                <div class=\"bg-white rounded-2xl border border-slate-200 p-6 shadow-sm space-y-6\">\n                    <div class=\"border-b border-slate-100 pb-4\">\n                        <span class=\"text-xs font-bold text-emerald-600 uppercase tracking-widest\">Del B</span>\n                        <h2 class=\"text-lg font-bold text-slate-950 mt-1\">Psykografi & Atferd</h2>\n                    </div>\n                    <div class=\"bg-emerald-50/50 border-l-4 border-emerald-500 p-4 rounded-r-xl\">\n                        <p class=\"text-xs text-emerald-800 leading-relaxed\"><strong>Hva er dette?</strong> Går dypere inn på *hvorfor* kunden kjøper. Kartlegg verdier, holdninger, interesser og de faktiske utfordringene de møter på i hverdagen.</p>\n                    </div>\n                    <div class=\"space-y-4\">\n                        <div class=\"space-y-1.5\">\n                            <label class=\"text-xs font-bold text-slate-700 uppercase\">Verdier, Livsstil & Bærekraft</label>\n                            <textarea data-bind=\"values\" placeholder=\"F.eks. Opptatt av økologiske råvarer, kvalitet fremfor kvantitet, og en aktiv fritid...\" class=\"w-full h-24 px-3.5 py-2 rounded-lg border border-slate-200 focus:border-emerald-500 text-sm outline-none resize-none transition-all\"></textarea>\n                            <span class=\"text-[11px] text-slate-400 block italic\">Hva slags syn har personaen på miljøvennlige produkter eller etisk handel?</span>\n                        </div>\n                        <div class=\"space-y-1.5\">\n                            <label class=\"text-xs font-bold text-slate-700 uppercase\">Kjøpsmål & Motivasjon</label>\n                            <textarea data-bind=\"motivation\" placeholder=\"F.eks. Vil ha en raskere, sunnere og mer stressfri middagsløsning for hele familien...\" class=\"w-full h-24 px-3.5 py-2 rounded-lg border border-slate-200 focus:border-emerald-500 text-sm outline-none resize-none transition-all\"></textarea>\n                        </div>\n                        <div class=\"space-y-1.5\">\n                            <label class=\"text-xs font-bold text-slate-700 uppercase\">Utfordringer (Pain Points)</label>\n                            <textarea data-bind=\"painpoints\" placeholder=\"F.eks. Føler på konstant dårlig samvittighet overfor tidsklemma og høye matvarepriser...\" class=\"w-full h-24 px-3.5 py-2 rounded-lg border border-slate-200 focus:border-emerald-500 text-sm outline-none resize-none transition-all\"></textarea>\n                        </div>\n                    </div>\n                </div>\n\n            </div>\n        </div>\n\n        <!-- DEL 2: PRAKSISMODUS (Effektivt, uten unødig tekst) -->\n        <div id=\"panel-practice\" class=\"tab-panel hidden space-y-6\">\n            <div class=\"bg-white rounded-2xl border border-slate-200 p-6 shadow-sm grid grid-cols-1 md:grid-cols-2 gap-6\">\n                <div class=\"space-y-4\">\n                    <h3 class=\"text-xs font-extrabold text-slate-400 uppercase tracking-widest border-b pb-2\">Kompakt Bakgrunnsdata</h3>\n                    <div class=\"space-y-1.5\">\n                        <label class=\"text-xs font-bold text-slate-600\">Navn</label>\n                        <input type=\"text\" data-bind=\"name\" class=\"w-full px-3 py-2 rounded-lg border border-slate-200 text-sm outline-none focus:border-indigo-500\">\n                    </div>\n                    <div class=\"grid grid-cols-2 gap-4\">\n                        <div class=\"space-y-1.5\">\n                            <label class=\"text-xs font-bold text-slate-600\">Alder</label>\n                            <input type=\"number\" data-bind=\"age\" class=\"w-full px-3 py-2 rounded-lg border border-slate-200 text-sm outline-none focus:border-indigo-500\">\n                        </div>\n                        <div class=\"space-y-1.5\">\n                            <label class=\"text-xs font-bold text-slate-600\">Sivilstatus</label>\n                            <input type=\"text\" data-bind=\"civil\" class=\"w-full px-3 py-2 rounded-lg border border-slate-200 text-sm outline-none focus:border-indigo-500\">\n                        </div>\n                    </div>\n                    <div class=\"grid grid-cols-2 gap-4\">\n                        <div class=\"space-y-1.5\">\n                            <label class=\"text-xs font-bold text-slate-600\">Yrke</label>\n                            <input type=\"text\" data-bind=\"occupation\" class=\"w-full px-3 py-2 rounded-lg border border-slate-200 text-sm outline-none focus:border-indigo-500\">\n                        </div>\n                        <div class=\"space-y-1.5\">\n                            <label class=\"text-xs font-bold text-slate-600\">Inntekt</label>\n                            <input type=\"text\" data-bind=\"income\" class=\"w-full px-3 py-2 rounded-lg border border-slate-200 text-sm outline-none focus:border-indigo-500\">\n                        </div>\n                    </div>\n                    <div class=\"grid grid-cols-2 gap-4\">\n                        <div class=\"space-y-1.5\">\n                            <label class=\"text-xs font-bold text-slate-600\">Bosted</label>\n                            <input type=\"text\" data-bind=\"location\" class=\"w-full px-3 py-2 rounded-lg border border-slate-200 text-sm outline-none focus:border-indigo-500\">\n                        </div>\n                        <div class=\"space-y-1.5\">\n                            <label class=\"text-xs font-bold text-slate-600\">Urbanitet</label>\n                            <input type=\"text\" data-bind=\"urbanity\" class=\"w-full px-3 py-2 rounded-lg border border-slate-200 text-sm outline-none focus:border-indigo-500\">\n                        </div>\n                    </div>\n                </div>\n                <div class=\"space-y-4\">\n                    <h3 class=\"text-xs font-extrabold text-slate-400 uppercase tracking-widest border-b pb-2\">Kundetankegang & Atferd</h3>\n                    <div class=\"space-y-1.5\">\n                        <label class=\"text-xs font-bold text-slate-600\">Verdier & Livsstil</label>\n                        <textarea data-bind=\"values\" rows=\"3\" class=\"w-full px-3 py-2 rounded-lg border border-slate-200 text-sm outline-none focus:border-indigo-500 resize-none\"></textarea>\n                    </div>\n                    <div class=\"space-y-1.5\">\n                        <label class=\"text-xs font-bold text-slate-600\">Kjøpsmål & Motivasjon</label>\n                        <textarea data-bind=\"motivation\" rows=\"3\" class=\"w-full px-3 py-2 rounded-lg border border-slate-200 text-sm outline-none focus:border-indigo-500 resize-none\"></textarea>\n                    </div>\n                    <div class=\"space-y-1.5\">\n                        <label class=\"text-xs font-bold text-slate-600\">Utfordringer (Pain Points)</label>\n                        <textarea data-bind=\"painpoints\" rows=\"3\" class=\"w-full px-3 py-2 rounded-lg border border-slate-200 text-sm outline-none focus:border-indigo-500 resize-none\"></textarea>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- DEL 3: PRESENTASJONSMODUS (Helt rent og frittstående grafisk kort) -->\n        <div id=\"panel-present\" class=\"tab-panel hidden\">\n            <div class=\"print-container flex justify-center py-6\">\n                <div class=\"print-bg-card bg-white w-full max-w-4xl rounded-2xl border border-slate-200 shadow-xl overflow-hidden grid grid-cols-1 md:grid-cols-12\">\n\n                    <!-- Venstre del (Farget bakgrunn, personopplysninger) -->\n                    <div class=\"print-bg-primary md:col-span-4 bg-slate-900 text-white p-8 flex flex-col items-center text-center justify-between gap-6 relative\">\n                        <div class=\"w-full space-y-4 z-10\">\n                            <!-- Profilbilde/Symbol basert på forbokstav -->\n                            <div class=\"w-24 h-24 print-bg-card bg-slate-800 rounded-2xl mx-auto flex items-center justify-center text-4xl border border-slate-700 shadow-inner select-none font-bold\" id=\"card-avatar\">👤</div>\n                            <div>\n                                <h2 class=\"text-2xl font-extrabold text-white tracking-tight\" id=\"card-name\">Camilla Karrière</h2>\n                                <p class=\"text-indigo-400 text-[10px] font-bold uppercase tracking-widest mt-1.5\" id=\"card-occupation\">Prosjektleder</p>\n                            </div>\n                        </div>\n\n                        <!-- Demografiske data -->\n                        <div class=\"w-full bg-slate-800/40 rounded-xl p-4 border border-slate-800/60 text-left text-[11px] space-y-2\">\n                            <div class=\"flex justify-between border-b border-slate-700/50 pb-1.5\">\n                                <span class=\"text-slate-400\">Alder</span>\n                                <span class=\"font-bold text-white\" id=\"card-age\">34 år</span>\n                            </div>\n                            <div class=\"flex justify-between border-b border-slate-700/50 pb-1.5\">\n                                <span class=\"text-slate-400\">Sivilstatus</span>\n                                <span class=\"font-bold text-white\" id=\"card-civil\">Samboer</span>\n                            </div>\n                            <div class=\"flex justify-between border-b border-slate-700/50 pb-1.5\">\n                                <span class=\"text-slate-400\">Inntekt</span>\n                                <span class=\"font-bold text-white\" id=\"card-income\">650k</span>\n                            </div>\n                            <div class=\"flex justify-between border-b border-slate-700/50 pb-1.5\">\n                                <span class=\"text-slate-400\">Bosted</span>\n                                <span class=\"font-bold text-white\" id=\"card-location\">Oslo</span>\n                            </div>\n                            <div class=\"flex justify-between\">\n                                <span class=\"text-slate-400\">Urbanitet</span>\n                                <span class=\"font-bold text-white\" id=\"card-urbanity\">Storby</span>\n                            </div>\n                        </div>\n\n                        <span class=\"text-[9px] text-slate-500 uppercase tracking-widest block\">Metodeverktøy • Canvas</span>\n                    </div>\n\n                    <!-- Høyre del (Innholdsklasser, hvit bakgrunn) -->\n                    <div class=\"md:col-span-8 p-8 space-y-6 bg-white text-slate-800 flex flex-col justify-between\">\n                        <div class=\"space-y-6\">\n                            <div class=\"space-y-1.5\">\n                                <h3 class=\"text-[10px] font-bold uppercase tracking-wider text-slate-400 border-b border-slate-100 pb-1\">Verdier & Livsstil</h3>\n                                <p class=\"text-sm leading-relaxed text-slate-600 whitespace-pre-line\" id=\"card-values\"></p>\n                            </div>\n                            <div class=\"space-y-1.5\">\n                                <h3 class=\"text-[10px] font-bold uppercase tracking-wider text-slate-400 border-b border-slate-100 pb-1\">Motivasjon & Kjøpsmål</h3>\n                                <p class=\"text-sm leading-relaxed text-slate-600 whitespace-pre-line\" id=\"card-motivation\"></p>\n                            </div>\n                            <div class=\"space-y-1.5\">\n                                <h3 class=\"text-[10px] font-bold uppercase tracking-wider text-slate-400 border-b border-slate-100 pb-1\">Utfordringer (Pain Points)</h3>\n                                <p class=\"text-sm leading-relaxed text-slate-600 whitespace-pre-line\" id=\"card-painpoints\"></p>\n                            </div>\n                        </div>\n                    </div>\n\n                </div>\n            </div>\n        </div>\n\n    </div>\n\n    <!-- RESET-MODAL (Sikkerhet i stedet for alert) -->\n    <div id=\"reset-modal\" class=\"no-print fixed inset-0 bg-slate-950/40 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden\">\n        <div class=\"bg-white rounded-2xl max-w-sm w-full p-6 border shadow-2xl space-y-4\">\n            <div class=\"w-12 h-12 bg-rose-50 border border-rose-200 rounded-xl flex items-center justify-center text-xl text-rose-600\">⚠️</div>\n            <div>\n                <h3 class=\"font-bold text-slate-900 text-base\">Nullstill alle data?</h3>\n                <p class=\"text-xs text-slate-500 mt-1\">Dette vil tømme all tekst, lagret progresjon og fjerne eventuelle valgte maler. Handlingen kan ikke angres.</p>\n            </div>\n            <div class=\"flex gap-2\">\n                <button onclick=\"closeResetModal()\" class=\"flex-1 py-2 text-xs font-semibold bg-slate-100 hover:bg-slate-200 rounded-lg text-slate-700 transition-all\">Avbryt</button>\n                <button onclick=\"confirmReset()\" class=\"flex-1 py-2 text-xs font-semibold text-white bg-rose-600 hover:bg-rose-700 rounded-lg transition-all\">Slett alt</button>\n            </div>\n        </div>\n    </div>\n\n    <script>\n        const personaFields = {\n            name: \"\",\n            age: \"\",\n            civil: \"\",\n            occupation: \"\",\n            income: \"\",\n            location: \"\",\n            urbanity: \"\",\n            values: \"\",\n            motivation: \"\",\n            painpoints: \"\",\n            avatar: \"👤\"\n        };\n\n        const templates = {\n            student: {\n                name: \"Markus Master\",\n                age: \"22\",\n                civil: \"Singel\",\n                occupation: \"Student / Butikkmedarbeider\",\n                income: \"11 000 / mnd (Lån/Stipend)\",\n                location: \"Trondheim\",\n                urbanity: \"Studentby / Storby\",\n                values: \"Opptatt av de nyeste trendene på TikTok, sosiale sammenkomster og billige kaffeløsninger. Handler primært brukt eller på lavprisutsalg.\",\n                motivation: \"Søker løsninger som sparer tid og penger i en travel studiehverdag. Liker lett tilgjengelig og digital kommunikasjon.\",\n                painpoints: \"Stramt budsjett, stress rundt innleveringer og en konstant følelse av tidsnød (FOMO).\"\n            },\n            parent: {\n                name: \"Bærekraftige Berit\",\n                age: \"38\",\n                civil: \"Gift, 3 barn\",\n                occupation: \"Lærer\",\n                income: \"580 000 kr / år\",\n                location: \"Lillehammer\",\n                urbanity: \"Tettsted / Forstad\",\n                values: \"Vektlegger økologiske alternativer, kildesortering og gjenbruk. Bruker mye tid på lokalidretten og utendørsaktiviteter med barna.\",\n                motivation: \"Vil gi familien en trygg og bærekraftig fremtid. Ser etter holdbare kvalitetsprodukter som tåler røff bruk.\",\n                painpoints: \"Den beryktede 'tidsklemma', høye matvarepriser og utfordringer med å finne raske, sunne middagsalternativer.\"\n            },\n            senior: {\n                name: \"Gunnar Gnist\",\n                age: \"72\",\n                civil: \"Enkemann\",\n                occupation: \"Pensjonert ingeniør\",\n                income: \"Pensjon (God råd)\",\n                location: \"Stavanger\",\n                urbanity: \"Sentrum / By\",\n                values: \"Setter stor pris på pålitelighet, punktlighet og lokal service. Leser nyheter på nettbrett, men foretrekker helgeavis på papir.\",\n                motivation: \"Ønsker å holde tett kontakt med barnebarn og ønsker smarte hjelpemidler som forenkler hverdagen uten å bli for kompliserte.\",\n                painpoints: \"Mangel på fysisk service, altfor små skriftstørrelser på skjermer, og frykt for svindel/feilklikk i nye apper.\"\n            },\n            b2b: {\n                name: \"Erik Effektiv\",\n                age: \"45\",\n                civil: \"Samboer\",\n                occupation: \"Daglig Leder\",\n                income: \"1.2 mill / år\",\n                location: \"Bærum / Oslo\",\n                urbanity: \"Urban\",\n                values: \"Verdsetter rask og direkte kommunikasjon, tidsbesparelse, ROI (avkastning) og nettverksbygging. Er opptatt av kontinuerlig vekst.\",\n                motivation: \"Søker verktøy og programvare som kan automatisere rutiner, fjerne unødvendig administrasjon og skape resultater.\",\n                painpoints: \"Ineffektive, lange møter, mangel på kvalifisert arbeidskraft og tungvinte, uoversiktlige rapporteringssystemer.\"\n            }\n        };\n\n        const randomPool = {\n            names: [\"Lise Lønn\", \"Per Post\", \"Sara Smart\", \"Tom Tidig\", \"Emma Energi\", \"Daniel Driftig\", \"Nora Nysgjerrig\"],\n            occupations: [\"Frilans designer\", \"Sykepleier\", \"Frontend-utvikler\", \"Snekker\", \"Markedsføringskonsulent\", \"Rørlegger\"],\n            locations: [\"Bergen\", \"Tromsø\", \"Kristiansand\", \"Hamar\", \"Molde\", \"Bodø\", \"Tønsberg\"],\n            urbanities: [\"Urban / Sentrum\", \"Landlig / Bygd\", \"Forstad / Boligfelt\", \"Småby\", \"Regionalt knutepunkt\"],\n            values: [\n                \"Vektlegger kortreiste produkter og etisk produksjon. Sparer til bolig.\",\n                \"Opptatt av personlig utvikling, mental helse, og kvalitetstid med venner.\",\n                \"Brenner for teknologi, gaming og smarthus-løsninger. Alltid på utkikk etter dingser.\",\n                \"Glad i naturen, fjellturer, og prøver å kutte ned på kjøttforbruket sitt.\",\n                \"Fokusert på karriere, status og luksusopplevelser. Glad i god mat og vin.\"\n            ],\n            motivations: [\n                \"Søker inspirasjon og enkle, sømløse digitale løsninger i hverdagen.\",\n                \"Vil minimere hverdagsstresset og maksimere fritiden sin.\",\n                \"Er opptatt av å spare penger og finne de aller beste tilbudene på markedet.\",\n                \"Ønsker å lære nye ferdigheter og styrke egen kompetanse.\",\n                \"Trenger et produkt som bare fungerer med én gang, uten opplæring.\"\n            ],\n            painpoints: [\n                \"Sliter med uoversiktlige og dårlig designede nettsider.\",\n                \"Synes det er vanskelig å sammenligne priser og produkter på en rettferdig måte.\",\n                \"Opplever tidsklemme og føler seg overveldet av for mange valgmuligheter.\",\n                \"Dårlig samvittighet for å ikke leve sunt eller miljøvennlig nok.\",\n                \"Irriterer seg over skjulte gebyrer og lang leveringstid.\"\n            ]\n        };\n\n        document.addEventListener(\"DOMContentLoaded\", () => {\n            loadFromLocalStorage();\n            applyStateToUI();\n            setupInteractivity();\n        });\n\n        function switchTab(tabId) {\n            // Skjul alle fanepaneler\n            document.querySelectorAll('.tab-panel').forEach(p => p.classList.add('hidden'));\n\n            // Vis det valgte panelet\n            document.getElementById(`panel-${tabId}`).classList.remove('hidden');\n\n            // Oppdater aktive navigasjonsknapper\n            const navButtons = document.querySelectorAll('#global-nav button');\n            navButtons.forEach(btn => {\n                btn.classList.remove('bg-white', 'text-slate-900', 'shadow-sm', 'border', 'border-slate-200/50');\n                btn.classList.add('text-slate-600', 'hover:text-slate-900');\n            });\n\n            const activeBtn = document.getElementById(`btn-${tabId}`);\n            if (activeBtn) {\n                activeBtn.classList.add('bg-white', 'text-slate-900', 'shadow-sm', 'border', 'border-slate-200/50');\n                activeBtn.classList.remove('text-slate-600', 'hover:text-slate-900');\n            }\n\n            const header = document.getElementById('global-header');\n            const nav = document.getElementById('global-nav');\n            const templatesSec = document.getElementById('template-section');\n\n            // Spesialbehandling av Presentasjonsmodus (100% ren visning)\n            if (tabId === 'present') {\n                if (header) header.classList.add('hidden');\n                if (nav) nav.classList.add('hidden');\n                if (templatesSec) templatesSec.classList.add('hidden');\n                showEscToast();\n            } else {\n                if (header) header.classList.remove('hidden');\n                if (nav) nav.classList.remove('hidden');\n                if (templatesSec) templatesSec.classList.remove('hidden');\n            }\n            updatePresentationCard();\n        }\n\n        function setupInteractivity() {\n            // Lytt til endringer på alle felt som har data-bind attributt\n            document.querySelectorAll('[data-bind]').forEach(input => {\n                input.addEventListener('input', e => {\n                    const key = e.target.getAttribute('data-bind');\n                    const val = e.target.value;\n\n                    // Oppdater lokal variabel\n                    personaFields[key] = val;\n\n                    // Lagre til localStorage\n                    localStorage.setItem(`persona_dev_${key}`, val);\n\n                    // Synkroniser verdiene på tvers av moduser (Læremodus <=> Praksismodus)\n                    document.querySelectorAll(`[data-bind=\"${key}\"]`).forEach(el => {\n                        if (el !== e.target) {\n                            el.value = val;\n                        }\n                    });\n\n                    updatePresentationCard();\n                });\n            });\n        }\n\n        function loadTemplate(key) {\n            const data = templates[key];\n            if (!data) return;\n\n            Object.keys(data).forEach(k => {\n                personaFields[k] = data[k];\n                localStorage.setItem(`persona_dev_${k}`, data[k]);\n            });\n\n            // Sett emoji avatar basert på malen\n            let avatarEmoji = \"👤\";\n            if (key === 'student') avatarEmoji = \"🧑‍🎓\";\n            if (key === 'parent') avatarEmoji = \"🌱\";\n            if (key === 'senior') avatarEmoji = \"👴\";\n            if (key === 'b2b') avatarEmoji = \"💼\";\n\n            personaFields.avatar = avatarEmoji;\n            localStorage.setItem(`persona_dev_avatar`, avatarEmoji);\n\n            applyStateToUI();\n        }\n\n        function generateRandomPersona() {\n            // Plukk ut tilfeldige verdier fra bassenget\n            const rName = randomPool.names[Math.floor(Math.random() * randomPool.names.length)];\n            const rAge = Math.floor(Math.random() * 60) + 18; // 18 - 78\n            const rOccupation = randomPool.occupations[Math.floor(Math.random() * randomPool.occupations.length)];\n            const rLocation = randomPool.locations[Math.floor(Math.random() * randomPool.locations.length)];\n            const rUrbanity = randomPool.urbanities[Math.floor(Math.random() * randomPool.urbanities.length)];\n            const rValues = randomPool.values[Math.floor(Math.random() * randomPool.values.length)];\n            const rMotivation = randomPool.motivations[Math.floor(Math.random() * randomPool.motivations.length)];\n            const rPainpoints = randomPool.painpoints[Math.floor(Math.random() * randomPool.painpoints.length)];\n\n            personaFields.name = rName;\n            personaFields.age = rAge.toString();\n            personaFields.civil = Math.random() > 0.5 ? \"Samboer\" : \"Singel\";\n            personaFields.occupation = rOccupation;\n            personaFields.income = (Math.floor(Math.random() * 400) + 350) + \" 000 kr / år\";\n            personaFields.location = rLocation;\n            personaFields.urbanity = rUrbanity;\n            personaFields.values = rValues;\n            personaFields.motivation = rMotivation;\n            personaFields.painpoints = rPainpoints;\n            personaFields.avatar = \"🎲\";\n\n            // Lagre alt til LocalStorage\n            Object.keys(personaFields).forEach(k => {\n                localStorage.setItem(`persona_dev_${k}`, personaFields[k]);\n            });\n\n            applyStateToUI();\n        }\n\n        function applyStateToUI() {\n            Object.keys(personaFields).forEach(key => {\n                document.querySelectorAll(`[data-bind=\"${key}\"]`).forEach(el => {\n                    el.value = personaFields[key];\n                });\n            });\n            updatePresentationCard();\n        }\n\n        function updatePresentationCard() {\n            Object.keys(personaFields).forEach(key => {\n                const el = document.getElementById(`card-${key}`);\n                if (el) {\n                    if (personaFields[key] && personaFields[key].trim() !== \"\") {\n                        el.textContent = personaFields[key];\n                        el.classList.remove('text-slate-400', 'italic');\n                    } else {\n                        // Default fallbacks dersom feltet er tomt\n                        if (key === 'name') el.textContent = \"Camilla Karrière\";\n                        else if (key === 'occupation') el.textContent = \"Prosjektleder\";\n                        else if (key === 'age') el.textContent = \"34 år\";\n                        else if (key === 'civil') el.textContent = \"Samboer\";\n                        else if (key === 'income') el.textContent = \"650 000 kr\";\n                        else if (key === 'location') el.textContent = \"Oslo\";\n                        else if (key === 'urbanity') el.textContent = \"Storby\";\n                        else {\n                            el.textContent = \"Ikke definert ennå. Gå til Lære- eller Praksismodus for å fylle ut.\";\n                            el.classList.add('text-slate-400', 'italic');\n                        }\n                    }\n                }\n            });\n\n            // Oppdater avatar\n            const avatarEl = document.getElementById('card-avatar');\n            if (avatarEl) {\n                avatarEl.textContent = personaFields.avatar || \"👤\";\n            }\n        }\n\n        function loadFromLocalStorage() {\n            Object.keys(personaFields).forEach(key => {\n                const val = localStorage.getItem(`persona_dev_${key}`);\n                if (val !== null) {\n                    personaFields[key] = val;\n                }\n            });\n        }\n\n        function showEscToast() {\n            // Fjern eventuelle eksisterende toasts\n            const oldToast = document.getElementById('esc-toast');\n            if (oldToast) oldToast.remove();\n\n            const toast = document.createElement('div');\n            toast.id = 'esc-toast';\n            toast.className = 'no-print fixed bottom-6 left-1/2 -translate-x-1/2 bg-slate-900/95 text-slate-200 px-5 py-3 rounded-xl text-xs font-semibold z-50 shadow-xl border border-slate-700/50 flex items-center gap-2 transition-all duration-300';\n            toast.innerHTML = '<span>⌨️</span> Trykk <kbd class=\"bg-slate-800 text-white px-1.5 py-0.5 rounded border border-slate-700 font-mono text-[10px]\">ESC</kbd> på tastaturet for å gå ut av presentasjon';\n            document.body.appendChild(toast);\n\n            // Fade ut etter 3.5 sekunder\n            setTimeout(() => {\n                toast.style.opacity = '0';\n                toast.style.transform = 'translate(-50%, 20px)';\n                setTimeout(() => {\n                    if (toast.parentNode) toast.remove();\n                }, 300);\n            }, 3500);\n        }\n\n        // Lytt etter ESC for å returnere til Læremodus\n        document.addEventListener('keydown', e => {\n            if (e.key === 'Escape') {\n                switchTab('learn');\n                const toast = document.getElementById('esc-toast');\n                if (toast) toast.remove();\n            }\n        });\n\n        // Håndtering av modal-basert nullstilling\n        function openResetModal() {\n            document.getElementById('reset-modal').classList.remove('hidden');\n        }\n\n        function closeResetModal() {\n            document.getElementById('reset-modal').classList.add('hidden');\n        }\n\n        function confirmReset() {\n            localStorage.clear();\n            Object.keys(personaFields).forEach(k => {\n                personaFields[k] = \"\";\n            });\n            personaFields.avatar = \"👤\";\n            applyStateToUI();\n            closeResetModal();\n        }\n    </script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Persona-utvikler",
    "windowTitle": "Persona-utvikler",
    "bundleId": "com.halisonworks.personautvikler",
    "iconPath": null
  },
  "categoryId": null,
  "source": "import",
  "createdAt": "2026-06-02T12:00:00.000Z",
  "updatedAt": "2026-06-02T12:00:00.000Z",
  "sharedAt": "2026-06-02T12:00:00.000Z"
}
