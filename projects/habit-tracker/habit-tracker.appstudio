{
  "schema": "app-studio/canvas@1",
  "id": "example-habit-tracker",
  "name": "habit-tracker.html",
  "code": "<!DOCTYPE html>\n<!--\n  Habit Tracker — Halison App Studio example\n\n  A weekly habit tracker: add habits, tick each day, and watch streaks and\n  weekly completion. Saves to your browser so it persists across sessions.\n\n  From the Halison App Studio public library:\n  https://github.com/halisonworks/public-app-studio\n\n  Permitted use: personal, educational, and other non-commercial use. You may\n  modify it, but keep this header and the source link intact, and do not sell,\n  commercialize, or republish it. Released under the Halison App Studio Examples\n  License — see the LICENSE file in the repository above.\n-->\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Habit Tracker</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Inter', system-ui, sans-serif; }\n    .day-btn { transition: background-color 0.15s, border-color 0.15s; }\n    .day-btn:hover { filter: brightness(0.95); }\n    .habit-row:nth-child(even) { background-color: #f8fafc; }\n    .habit-row:nth-child(odd)  { background-color: #ffffff; }\n    @media (max-width: 639px) {\n      .day-label { font-size: 0.6rem; }\n    }\n  </style>\n</head>\n<body class=\"bg-slate-100 min-h-screen\">\n\n  <!-- Modal overlay -->\n  <div id=\"confirmModal\" class=\"fixed inset-0 z-50 flex items-center justify-center bg-black/40 hidden\">\n    <div class=\"bg-white rounded-2xl shadow-xl p-6 w-80 max-w-full mx-4\">\n      <h2 class=\"text-lg font-semibold text-slate-800 mb-2\">Reset all habits?</h2>\n      <p class=\"text-sm text-slate-500 mb-5\">This will permanently delete all your habits and check-ins. This action cannot be undone.</p>\n      <div class=\"flex gap-3 justify-end\">\n        <button id=\"cancelReset\" class=\"px-4 py-2 rounded-lg text-sm font-medium text-slate-600 bg-slate-100 hover:bg-slate-200\">Cancel</button>\n        <button id=\"confirmReset\" class=\"px-4 py-2 rounded-lg text-sm font-medium text-white bg-red-500 hover:bg-red-600\">Reset</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- App shell -->\n  <div class=\"max-w-3xl mx-auto px-4 py-8\">\n\n    <!-- Header -->\n    <div class=\"flex items-center justify-between mb-6\">\n      <div>\n        <h1 class=\"text-2xl font-bold text-slate-800 tracking-tight\">Habit Tracker</h1>\n        <p id=\"weekLabel\" class=\"text-sm text-slate-400 mt-0.5\"></p>\n      </div>\n      <button id=\"resetBtn\" class=\"text-xs font-medium text-red-400 hover:text-red-600 border border-red-200 hover:border-red-400 rounded-lg px-3 py-1.5 transition-colors\">\n        Reset all\n      </button>\n    </div>\n\n    <!-- Add habit -->\n    <div class=\"bg-white rounded-2xl shadow-sm p-4 mb-4 flex gap-2\">\n      <input id=\"habitInput\" type=\"text\" placeholder=\"New habit (e.g. Morning run, Read 20 min…)\"\n        class=\"flex-1 rounded-lg border border-slate-200 px-3 py-2 text-sm text-slate-700 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-300\" />\n      <button id=\"addBtn\"\n        class=\"bg-indigo-500 hover:bg-indigo-600 text-white text-sm font-medium rounded-lg px-4 py-2 transition-colors whitespace-nowrap\">\n        Add\n      </button>\n    </div>\n\n    <!-- Summary bar -->\n    <div id=\"summary\" class=\"bg-indigo-50 border border-indigo-100 rounded-2xl px-5 py-3 mb-4 flex flex-wrap gap-4 text-sm text-indigo-700 hidden\">\n      <span><span class=\"font-semibold\" id=\"sumTotal\">0</span> habits</span>\n      <span>·</span>\n      <span>Avg completion this week: <span class=\"font-semibold\" id=\"sumAvg\">0%</span></span>\n      <span>·</span>\n      <span>Best streak today: <span class=\"font-semibold\" id=\"sumStreak\">0 days</span></span>\n    </div>\n\n    <!-- Habit grid -->\n    <div class=\"bg-white rounded-2xl shadow-sm overflow-hidden\">\n\n      <!-- Day header -->\n      <div id=\"dayHeader\" class=\"grid items-center border-b border-slate-100 px-4 py-2 bg-slate-50\"\n        style=\"grid-template-columns: 1fr repeat(7,2.5rem) 3.5rem 3.5rem 2rem; gap:0.25rem;\">\n        <div class=\"text-xs font-semibold text-slate-400 uppercase tracking-wide\">Habit</div>\n        <!-- Day labels injected by JS -->\n        <div class=\"text-xs font-semibold text-slate-500 text-center col-span-7 contents\" id=\"dayLabels\"></div>\n        <div class=\"text-xs font-semibold text-slate-400 text-center\">Streak</div>\n        <div class=\"text-xs font-semibold text-slate-400 text-center\">Week %</div>\n        <div></div>\n      </div>\n\n      <!-- Habit rows -->\n      <div id=\"habitList\">\n        <!-- Populated by JS -->\n      </div>\n\n      <!-- Empty state -->\n      <div id=\"emptyState\" class=\"py-12 text-center text-slate-400 text-sm\">\n        <div class=\"text-4xl mb-3\">🌱</div>\n        <p class=\"font-medium text-slate-500\">No habits yet</p>\n        <p class=\"mt-1\">Add your first habit above to get started.</p>\n      </div>\n\n    </div>\n  </div>\n\n  <script>\n    // ─── Constants ────────────────────────────────────────────────────────────\n    const STORAGE_PREFIX = 'habit_tracker_';\n    const DAYS = ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'];\n\n    // ─── State ────────────────────────────────────────────────────────────────\n    // habits: [{id, name, checks: {ISO_DATE: bool}}]\n    let habits = [];\n\n    // ─── Storage ──────────────────────────────────────────────────────────────\n    function save() {\n      localStorage.setItem(STORAGE_PREFIX + 'habits', JSON.stringify(habits));\n    }\n\n    function load() {\n      try {\n        const raw = localStorage.getItem(STORAGE_PREFIX + 'habits');\n        if (raw) habits = JSON.parse(raw);\n      } catch(e) {\n        habits = [];\n      }\n    }\n\n    // ─── Date helpers ─────────────────────────────────────────────────────────\n    // Returns YYYY-MM-DD for a given Date\n    function toISO(d) {\n      return d.toISOString().slice(0, 10);\n    }\n\n    // Get the Monday of the current week (locale-independent)\n    function getMondayOfWeek(d) {\n      const day = d.getDay(); // 0=Sun\n      const diff = (day === 0) ? -6 : 1 - day;\n      const mon = new Date(d);\n      mon.setDate(d.getDate() + diff);\n      return mon;\n    }\n\n    // Returns array of 7 Date objects Mon–Sun for the current week\n    function getWeekDates() {\n      const today = new Date();\n      const mon = getMondayOfWeek(today);\n      return Array.from({length: 7}, (_, i) => {\n        const d = new Date(mon);\n        d.setDate(mon.getDate() + i);\n        return d;\n      });\n    }\n\n    // Format \"Jun 2 – Jun 8, 2026\"\n    function formatWeekRange(dates) {\n      const fmt = (d) => d.toLocaleDateString('en-US', {month:'short', day:'numeric'});\n      return fmt(dates[0]) + ' – ' + fmt(dates[6]) + ', ' + dates[6].getFullYear();\n    }\n\n    // ─── Metrics ──────────────────────────────────────────────────────────────\n    function weekCompletion(habit, weekDates) {\n      const todayISO = toISO(new Date());\n      // Only count days up to and including today in this week\n      const countable = weekDates.filter(d => toISO(d) <= todayISO);\n      if (countable.length === 0) return 0;\n      const done = countable.filter(d => habit.checks[toISO(d)]).length;\n      return Math.round((done / countable.length) * 100);\n    }\n\n    // Consecutive streak: count back from today within week\n    function currentStreak(habit, weekDates) {\n      const todayISO = toISO(new Date());\n      // Build sorted list of days up to today\n      const past = weekDates.filter(d => toISO(d) <= todayISO).reverse();\n      let streak = 0;\n      for (const d of past) {\n        if (habit.checks[toISO(d)]) streak++;\n        else break;\n      }\n      return streak;\n    }\n\n    // ─── Render ───────────────────────────────────────────────────────────────\n    function render() {\n      const weekDates = getWeekDates();\n      const todayISO = toISO(new Date());\n\n      // Week label\n      document.getElementById('weekLabel').textContent = 'Week of ' + formatWeekRange(weekDates);\n\n      // Day header labels\n      const labelsEl = document.getElementById('dayLabels');\n      labelsEl.innerHTML = '';\n      weekDates.forEach((d, i) => {\n        const cell = document.createElement('div');\n        cell.className = 'text-xs font-medium text-slate-500 text-center day-label';\n        const iso = toISO(d);\n        if (iso === todayISO) {\n          cell.innerHTML = '<span class=\"inline-block bg-indigo-500 text-white rounded-full w-7 h-7 leading-7 text-center text-xs font-semibold\">' + DAYS[i] + '</span>';\n        } else {\n          cell.textContent = DAYS[i];\n        }\n        labelsEl.appendChild(cell);\n      });\n\n      // Habit rows\n      const listEl = document.getElementById('habitList');\n      listEl.innerHTML = '';\n\n      const emptyState = document.getElementById('emptyState');\n      const summary = document.getElementById('summary');\n\n      if (habits.length === 0) {\n        emptyState.classList.remove('hidden');\n        summary.classList.add('hidden');\n        return;\n      }\n      emptyState.classList.add('hidden');\n      summary.classList.remove('hidden');\n\n      habits.forEach((habit, idx) => {\n        const row = document.createElement('div');\n        row.className = 'habit-row grid items-center px-4 py-2.5 border-b border-slate-50 last:border-0';\n        row.style.gridTemplateColumns = '1fr repeat(7,2.5rem) 3.5rem 3.5rem 2rem';\n        row.style.gap = '0.25rem';\n\n        // Name\n        const nameCell = document.createElement('div');\n        nameCell.className = 'text-sm font-medium text-slate-700 truncate pr-2';\n        nameCell.textContent = habit.name;\n        row.appendChild(nameCell);\n\n        // Day checkboxes\n        weekDates.forEach((d) => {\n          const iso = toISO(d);\n          const isFuture = iso > todayISO;\n          const checked = !!habit.checks[iso];\n\n          const btn = document.createElement('button');\n          btn.type = 'button';\n          btn.setAttribute('aria-label', (checked ? 'Uncheck' : 'Check') + ' ' + habit.name + ' on ' + iso);\n          btn.className = 'day-btn mx-auto flex items-center justify-center w-7 h-7 rounded-full border-2 transition-all ' +\n            (isFuture\n              ? 'border-slate-200 bg-slate-50 cursor-not-allowed opacity-40'\n              : checked\n                ? 'border-indigo-400 bg-indigo-400 text-white'\n                : 'border-slate-300 bg-white hover:border-indigo-300');\n          if (!isFuture) {\n            btn.innerHTML = checked\n              ? '<svg class=\"w-3.5 h-3.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M5 13l4 4L19 7\"/></svg>'\n              : '';\n            btn.addEventListener('click', () => toggle(idx, iso));\n          }\n          row.appendChild(btn);\n        });\n\n        // Streak\n        const streak = currentStreak(habit, weekDates);\n        const streakCell = document.createElement('div');\n        streakCell.className = 'text-center text-xs font-semibold ' + (streak >= 3 ? 'text-emerald-600' : streak >= 1 ? 'text-indigo-500' : 'text-slate-400');\n        streakCell.textContent = streak > 0 ? streak + 'd' : '—';\n        row.appendChild(streakCell);\n\n        // Week %\n        const pct = weekCompletion(habit, weekDates);\n        const pctCell = document.createElement('div');\n        pctCell.className = 'text-center text-xs font-semibold ' + (pct === 100 ? 'text-emerald-600' : pct >= 50 ? 'text-indigo-500' : 'text-slate-400');\n        pctCell.textContent = pct + '%';\n        row.appendChild(pctCell);\n\n        // Delete button\n        const delBtn = document.createElement('button');\n        delBtn.type = 'button';\n        delBtn.setAttribute('aria-label', 'Delete ' + habit.name);\n        delBtn.className = 'ml-auto flex items-center justify-center w-6 h-6 rounded-full text-slate-300 hover:text-red-400 hover:bg-red-50 transition-colors';\n        delBtn.innerHTML = '<svg class=\"w-3.5 h-3.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M6 18L18 6M6 6l12 12\"/></svg>';\n        delBtn.addEventListener('click', () => deleteHabit(idx));\n        row.appendChild(delBtn);\n\n        listEl.appendChild(row);\n      });\n\n      // Summary\n      const allPct = habits.map(h => weekCompletion(h, weekDates));\n      const avgPct = habits.length ? Math.round(allPct.reduce((a,b) => a+b, 0) / habits.length) : 0;\n      const maxStreak = habits.length ? Math.max(...habits.map(h => currentStreak(h, weekDates))) : 0;\n      document.getElementById('sumTotal').textContent = habits.length;\n      document.getElementById('sumAvg').textContent = avgPct + '%';\n      document.getElementById('sumStreak').textContent = maxStreak + (maxStreak === 1 ? ' day' : ' days');\n    }\n\n    // ─── Actions ──────────────────────────────────────────────────────────────\n    function addHabit(name) {\n      name = name.trim();\n      if (!name) return;\n      habits.push({ id: Date.now().toString(), name, checks: {} });\n      save();\n      render();\n    }\n\n    function deleteHabit(idx) {\n      habits.splice(idx, 1);\n      save();\n      render();\n    }\n\n    function toggle(idx, iso) {\n      if (!habits[idx].checks) habits[idx].checks = {};\n      habits[idx].checks[iso] = !habits[idx].checks[iso];\n      save();\n      render();\n    }\n\n    function resetAll() {\n      habits = [];\n      // Clear only our keys\n      Object.keys(localStorage).forEach(k => {\n        if (k.startsWith(STORAGE_PREFIX)) localStorage.removeItem(k);\n      });\n      render();\n    }\n\n    // ─── Event listeners ──────────────────────────────────────────────────────\n    document.getElementById('addBtn').addEventListener('click', () => {\n      const input = document.getElementById('habitInput');\n      addHabit(input.value);\n      input.value = '';\n      input.focus();\n    });\n\n    document.getElementById('habitInput').addEventListener('keydown', (e) => {\n      if (e.key === 'Enter') {\n        const input = document.getElementById('habitInput');\n        addHabit(input.value);\n        input.value = '';\n      }\n    });\n\n    // Reset modal\n    document.getElementById('resetBtn').addEventListener('click', () => {\n      document.getElementById('confirmModal').classList.remove('hidden');\n    });\n    document.getElementById('cancelReset').addEventListener('click', () => {\n      document.getElementById('confirmModal').classList.add('hidden');\n    });\n    document.getElementById('confirmReset').addEventListener('click', () => {\n      document.getElementById('confirmModal').classList.add('hidden');\n      resetAll();\n    });\n    // Close modal on backdrop click\n    document.getElementById('confirmModal').addEventListener('click', (e) => {\n      if (e.target === document.getElementById('confirmModal')) {\n        document.getElementById('confirmModal').classList.add('hidden');\n      }\n    });\n\n    // ─── Boot ─────────────────────────────────────────────────────────────────\n    load();\n    render();\n  </script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Habit Tracker",
    "windowTitle": "Habit Tracker",
    "bundleId": "com.halisonworks.habittracker",
    "iconPath": null
  },
  "categoryId": null,
  "source": "import",
  "createdAt": "2026-06-02T12:00:00.000Z",
  "updatedAt": "2026-06-02T12:00:00.000Z",
