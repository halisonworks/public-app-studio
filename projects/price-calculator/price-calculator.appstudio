{
  "schema": "app-studio/canvas@1",
  "id": "example-price-calculator",
  "name": "price-calculator.html",
  "code": "<!DOCTYPE html>\n<!--\n  Interactive Price Calculator — Halison App Studio example\n\n  Interactive calculator for markup, contribution margin and VAT. School and\n  business modes, a discount simulator, break-even analysis, and a full-screen\n  presentation mode.\n\n  From the Halison App Studio public library:\n  https://github.com/halisonworks/public-app-studio\n\n  Permitted use: personal, educational, and other non-commercial use. You may\n  modify it, but keep this header and the source link intact, and do not sell,\n  commercialize, or republish it. Released under the Halison App Studio Examples\n  License — see the LICENSE file in the repository above.\n-->\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Interactive Price Calculator: Markup, Contribution & VAT</title>\n    <!-- Tailwind CSS for a modern, minimalist look -->\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        /* Custom slider thumbs in the brand colors */\n        input[type=\"range\"]::-webkit-slider-thumb {\n            background: #4f46e5;\n            cursor: pointer;\n            height: 18px;\n            width: 18px;\n            border-radius: 50%;\n            appearance: none;\n            margin-top: -5px;\n        }\n        input[type=\"range\"]::-moz-range-thumb {\n            background: #4f46e5;\n            cursor: pointer;\n            height: 18px;\n            width: 18px;\n            border-radius: 50%;\n            border: none;\n        }\n        input[type=\"range\"]::-webkit-slider-runnable-track {\n            background: #e2e8f0;\n            height: 8px;\n            border-radius: 4px;\n        }\n    </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 min-h-screen font-sans antialiased\">\n\n    <!-- ========================================== -->\n    <!-- MAIN PRICE CALCULATOR VIEW                 -->\n    <!-- ========================================== -->\n    <div id=\"main-calculator-view\" class=\"block\">\n\n        <!-- Header / navigation -->\n        <header class=\"bg-white border-b border-slate-200 py-6 px-4 sm:px-8\">\n            <div class=\"max-w-7xl mx-auto flex flex-col md:flex-row md:items-center md:justify-between gap-4\">\n                <div>\n                    <div class=\"flex items-center gap-2\">\n                        <span class=\"w-2.5 h-2.5 rounded-full bg-indigo-600\"></span>\n                        <span class=\"text-xs font-bold tracking-wider text-indigo-600 uppercase\">Sales, Service &amp; Tourism</span>\n                    </div>\n                    <h1 class=\"text-3xl font-extrabold text-slate-900 tracking-tight mt-1\">Interactive Price Calculator</h1>\n                    <p class=\"text-sm text-slate-500 mt-1\">Simulate pricing, margins, VAT and profitability in real time.</p>\n                </div>\n\n                <!-- Mode and presentation controls -->\n                <div class=\"flex flex-wrap items-center gap-3\">\n                    <button onclick=\"startPresentationMode()\" class=\"px-5 py-2.5 text-sm font-bold rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white shadow-sm transition-all focus:ring-2 focus:ring-indigo-500\">\n                        Start presentation mode\n                    </button>\n                    <div class=\"flex items-center gap-1 bg-slate-100 p-1 rounded-xl border border-slate-200\">\n                        <button id=\"btnModeStudent\" onclick=\"setMode('student')\" class=\"px-4 py-2 text-sm font-medium rounded-lg bg-white text-indigo-600 shadow-sm transition-all\">\n                            School mode\n                        </button>\n                        <button id=\"btnModeBedrift\" onclick=\"setMode('bedrift')\" class=\"px-4 py-2 text-sm font-medium rounded-lg text-slate-600 hover:text-slate-900 transition-all\">\n                            Business mode\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </header>\n\n        <!-- Main content -->\n        <main class=\"max-w-7xl mx-auto px-4 sm:px-8 py-8\">\n            <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start\">\n\n                <!-- LEFT: controls and settings (5 columns) -->\n                <div class=\"lg:col-span-5 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-6\">\n                    <div class=\"border-b border-slate-100 pb-4\">\n                        <h2 class=\"text-xl font-bold text-slate-900\">Calculator settings</h2>\n                        <p class=\"text-xs text-slate-400 mt-1\">Adjust the parameters below to see instant changes.</p>\n                    </div>\n\n                    <!-- 1. Purchase price -->\n                    <div>\n                        <label for=\"inputCost\" class=\"block text-sm font-semibold text-slate-700 mb-1\">Purchase price / cost (kr)</label>\n                        <div class=\"relative rounded-xl shadow-sm\">\n                            <input type=\"number\" id=\"inputCost\" value=\"100\" min=\"1\" step=\"any\" oninput=\"updateCalculations('cost')\" class=\"w-full pl-4 pr-12 py-3 border border-slate-300 rounded-xl text-lg font-bold text-slate-900 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all\">\n                            <div class=\"absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none\">\n                                <span class=\"text-slate-500 font-semibold text-sm\">kr</span>\n                            </div>\n                        </div>\n                        <p class=\"text-xs text-slate-400 mt-1\">The product's original purchase cost from the supplier.</p>\n                    </div>\n\n                    <!-- 2. Value Added Tax (VAT) -->\n                    <div>\n                        <label class=\"block text-sm font-semibold text-slate-700 mb-2\">Value Added Tax (VAT)</label>\n                        <div class=\"grid grid-cols-4 gap-2\">\n                            <button onclick=\"setMva(25)\" id=\"btnMva25\" class=\"py-3 px-1 text-sm font-bold rounded-xl border-2 border-indigo-600 bg-indigo-50 text-indigo-700 transition-all\">\n                                25% <span class=\"block text-[10px] font-normal text-indigo-500\">Goods</span>\n                            </button>\n                            <button onclick=\"setMva(15)\" id=\"btnMva15\" class=\"py-3 px-1 text-sm font-bold rounded-xl border border-slate-200 hover:border-slate-300 text-slate-700 bg-white transition-all\">\n                                15% <span class=\"block text-[10px] font-normal text-slate-400\">Food</span>\n                            </button>\n                            <button onclick=\"setMva(12)\" id=\"btnMva12\" class=\"py-3 px-1 text-sm font-bold rounded-xl border border-slate-200 hover:border-slate-300 text-slate-700 bg-white transition-all\">\n                                12% <span class=\"block text-[10px] font-normal text-slate-400\">Tourism</span>\n                            </button>\n                            <button onclick=\"setMva(0)\" id=\"btnMva0\" class=\"py-3 px-1 text-sm font-bold rounded-xl border border-slate-200 hover:border-slate-300 text-slate-700 bg-white transition-all\">\n                                0% <span class=\"block text-[10px] font-normal text-slate-400\">Exempt</span>\n                            </button>\n                        </div>\n                    </div>\n\n                    <!-- 3. Markup (calculated from purchase price) -->\n                    <div class=\"bg-indigo-50/40 p-5 rounded-2xl border border-indigo-100\">\n                        <div class=\"flex justify-between items-center mb-1\">\n                            <label class=\"text-sm font-bold text-indigo-900\">Markup %</label>\n                            <div class=\"relative w-28\">\n                                <input type=\"number\" id=\"inputAvanseNum\" value=\"100\" min=\"0\" max=\"1000\" oninput=\"syncFromAvanseInput()\" class=\"w-full pl-3 pr-7 py-1 text-right text-sm font-bold text-indigo-900 bg-white border border-indigo-200 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none\">\n                                <span class=\"absolute right-2.5 top-1 text-sm font-bold text-indigo-400 pointer-events-none\">%</span>\n                            </div>\n                        </div>\n                        <input type=\"range\" id=\"sliderAvanse\" min=\"0\" max=\"300\" value=\"100\" oninput=\"updateCalculations('avanse')\" class=\"w-full h-2 rounded-lg appearance-none cursor-pointer accent-indigo-600 my-4\">\n                        <div class=\"flex justify-between text-[11px] text-indigo-500 font-bold uppercase tracking-wider\">\n                            <span>0%</span>\n                            <span>100% (Double)</span>\n                            <span>200%</span>\n                            <span>300%</span>\n                        </div>\n                        <p class=\"text-xs text-indigo-700 mt-3 leading-relaxed\">The markup added to the purchase price to cover other costs and profit.</p>\n                    </div>\n\n                    <!-- 4. Contribution margin ratio (calculated from selling price) -->\n                    <div class=\"bg-emerald-50/40 p-5 rounded-2xl border border-emerald-100\">\n                        <div class=\"flex justify-between items-center mb-1\">\n                            <label class=\"text-sm font-bold text-emerald-900\">Contribution margin %</label>\n                            <div class=\"relative w-28\">\n                                <input type=\"number\" id=\"inputDGNum\" value=\"50\" min=\"0\" max=\"99\" oninput=\"syncFromDGInput()\" class=\"w-full pl-3 pr-7 py-1 text-right text-sm font-bold text-emerald-900 bg-white border border-emerald-200 rounded-lg focus:ring-2 focus:ring-emerald-500 outline-none\">\n                                <span class=\"absolute right-2.5 top-1 text-sm font-bold text-emerald-400 pointer-events-none\">%</span>\n                            </div>\n                        </div>\n                        <input type=\"range\" id=\"sliderDG\" min=\"0\" max=\"95\" value=\"50\" oninput=\"updateCalculations('dg')\" class=\"w-full h-2 rounded-lg appearance-none cursor-pointer accent-emerald-600 my-4\">\n                        <div class=\"flex justify-between text-[11px] text-emerald-500 font-bold uppercase tracking-wider\">\n                            <span>0%</span>\n                            <span>50% (Half)</span>\n                            <span>75%</span>\n                            <span>95% (Max)</span>\n                        </div>\n                        <p class=\"text-xs text-emerald-700 mt-3 leading-relaxed\">How much of the final selling price stays with the business.</p>\n                    </div>\n                </div>\n\n                <!-- RIGHT: big results and visual stack (7 columns) -->\n                <div class=\"lg:col-span-7 space-y-6\">\n\n                    <!-- Results grid -->\n                    <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n\n                        <!-- Selling price excl. VAT -->\n                        <div class=\"bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between\">\n                            <span class=\"text-xs font-bold text-slate-400 uppercase tracking-widest block\">Price excl. VAT</span>\n                            <div class=\"flex items-baseline gap-1 mt-2\">\n                                <span class=\"text-3xl font-black text-slate-900\" id=\"resPriceEx\">200.00</span>\n                                <span class=\"text-base font-bold text-slate-500\">kr</span>\n                            </div>\n                            <div class=\"text-xs text-slate-400 mt-2\">The basis for the company's accounts</div>\n                        </div>\n\n                        <!-- Contribution margin in kroner -->\n                        <div class=\"bg-white p-6 rounded-2xl border border-slate-200 shadow-sm border-l-4 border-l-emerald-500 flex flex-col justify-between\">\n                            <div class=\"flex items-center gap-1.5\">\n                                <span class=\"w-2 h-2 rounded-full bg-emerald-500\"></span>\n                                <span class=\"text-xs font-bold text-emerald-600 uppercase tracking-widest block\">Contribution margin (profit)</span>\n                            </div>\n                            <div class=\"flex items-baseline gap-1 mt-2\">\n                                <span class=\"text-3xl font-black text-emerald-700\" id=\"resDB\">100.00</span>\n                                <span class=\"text-base font-bold text-emerald-600\">kr</span>\n                            </div>\n                            <div class=\"text-xs text-emerald-500 mt-2\">The amount that covers fixed costs</div>\n                        </div>\n\n                        <!-- VAT amount -->\n                        <div class=\"bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between\">\n                            <span class=\"text-xs font-bold text-slate-400 uppercase tracking-widest block\">VAT amount (<span id=\"resMvaPercent\">25</span>%)</span>\n                            <div class=\"flex items-baseline gap-1 mt-2\">\n                                <span class=\"text-3xl font-black text-slate-900\" id=\"resMvaValue\">50.00</span>\n                                <span class=\"text-base font-bold text-slate-500\">kr</span>\n                            </div>\n                            <div class=\"text-xs text-slate-400 mt-2\">Tax passed directly to the state</div>\n                        </div>\n\n                        <!-- Selling price INCL. VAT -->\n                        <div class=\"bg-indigo-950 p-6 rounded-2xl text-white shadow-md flex flex-col justify-between\">\n                            <span class=\"text-xs font-bold text-indigo-300 uppercase tracking-widest block\">Selling price to customer (incl.)</span>\n                            <div class=\"flex items-baseline gap-1 mt-2\">\n                                <span class=\"text-3xl font-black text-white\" id=\"resPriceInc\">250.00</span>\n                                <span class=\"text-base font-bold text-indigo-200\">kr</span>\n                            </div>\n                            <div class=\"text-xs text-indigo-300 mt-2\">The price the customer pays at the register</div>\n                        </div>\n                    </div>\n\n                    <!-- Visual price breakdown (bar chart) -->\n                    <div class=\"bg-white p-6 rounded-2xl border border-slate-200 shadow-sm\">\n                        <h3 class=\"text-lg font-bold text-slate-900 mb-4\">Visual price breakdown</h3>\n\n                        <!-- Bar -->\n                        <div class=\"relative w-full h-14 rounded-xl overflow-hidden flex shadow-inner border border-slate-100\">\n                            <!-- Purchase -->\n                            <div id=\"barCost\" class=\"bg-slate-300 h-full flex items-center justify-center transition-all duration-300\" style=\"width: 40%\">\n                                <span class=\"text-xs font-bold text-slate-700 truncate px-1\">Purchase</span>\n                            </div>\n                            <!-- Margin/CM -->\n                            <div id=\"barDB\" class=\"bg-emerald-500 h-full flex items-center justify-center transition-all duration-300\" style=\"width: 40%\">\n                                <span class=\"text-xs font-bold text-white truncate px-1\">Contribution</span>\n                            </div>\n                            <!-- VAT -->\n                            <div id=\"barMva\" class=\"bg-indigo-500 h-full flex items-center justify-center transition-all duration-300\" style=\"width: 20%\">\n                                <span class=\"text-xs font-bold text-white truncate px-1\">VAT</span>\n                            </div>\n                        </div>\n\n                        <!-- Legend -->\n                        <div class=\"grid grid-cols-3 gap-3 mt-4 text-center text-xs font-bold text-slate-600\">\n                            <div class=\"p-3 bg-slate-100 rounded-xl\">\n                                <span class=\"block text-[10px] text-slate-400 uppercase tracking-wide\">Purchase share</span>\n                                <span class=\"text-base font-extrabold text-slate-700\" id=\"pctCost\">40.0%</span>\n                            </div>\n                            <div class=\"p-3 bg-emerald-50 rounded-xl text-emerald-700\">\n                                <span class=\"block text-[10px] text-emerald-400 uppercase tracking-wide\">Margin share (CM)</span>\n                                <span class=\"text-base font-extrabold text-emerald-700\" id=\"pctDB\">40.0%</span>\n                            </div>\n                            <div class=\"p-3 bg-indigo-50 rounded-xl text-indigo-700\">\n                                <span class=\"block text-[10px] text-indigo-400 uppercase tracking-wide\">VAT share</span>\n                                <span class=\"text-base font-extrabold text-indigo-700\" id=\"pctMva\">20.0%</span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <!-- SECTION: discount simulator -->\n            <section class=\"mt-8 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm\">\n                <div class=\"border-b border-slate-100 pb-4 mb-4\">\n                    <h3 class=\"text-xl font-bold text-slate-900\">Discount simulator</h3>\n                    <p class=\"text-sm text-slate-500 mt-1\">See the dramatic effect of price cuts on your contribution margin.</p>\n                </div>\n\n                <div class=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n                    <!-- 10% discount -->\n                    <div class=\"p-4 rounded-xl border border-slate-150 bg-slate-50/50\">\n                        <div class=\"flex justify-between items-center mb-2\">\n                            <span class=\"font-bold text-amber-800 text-sm\">10% discount</span>\n                            <span class=\"text-[10px] bg-amber-100 text-amber-800 px-2 py-0.5 rounded-md font-bold uppercase tracking-wider\">Minor campaign</span>\n                        </div>\n                        <div class=\"space-y-1 text-sm text-slate-600\">\n                            <div class=\"flex justify-between\">New selling price: <span class=\"font-bold text-slate-950\" id=\"r10Price\">0.00 kr</span></div>\n                            <div class=\"flex justify-between\">New contribution margin: <span class=\"font-bold text-slate-950\" id=\"r10Db\">0.00 kr</span></div>\n                            <div class=\"flex justify-between pt-2 border-t border-slate-200 mt-2 font-bold text-red-600\">Reduction in CM: <span id=\"r10Drop\" class=\"font-black\">0%</span></div>\n                        </div>\n                    </div>\n\n                    <!-- 20% discount -->\n                    <div class=\"p-4 rounded-xl border border-slate-150 bg-slate-50/50\">\n                        <div class=\"flex justify-between items-center mb-2\">\n                            <span class=\"font-bold text-orange-800 text-sm\">20% discount</span>\n                            <span class=\"text-[10px] bg-orange-100 text-orange-800 px-2 py-0.5 rounded-md font-bold uppercase tracking-wider\">Standard offer</span>\n                        </div>\n                        <div class=\"space-y-1 text-sm text-slate-600\">\n                            <div class=\"flex justify-between\">New selling price: <span class=\"font-bold text-slate-950\" id=\"r20Price\">0.00 kr</span></div>\n                            <div class=\"flex justify-between\">New contribution margin: <span class=\"font-bold text-slate-950\" id=\"r20Db\">0.00 kr</span></div>\n                            <div class=\"flex justify-between pt-2 border-t border-slate-200 mt-2 font-bold text-red-600\">Reduction in CM: <span id=\"r20Drop\" class=\"font-black\">0%</span></div>\n                        </div>\n                    </div>\n\n                    <!-- 30% discount -->\n                    <div class=\"p-4 rounded-xl border border-slate-150 bg-slate-50/50\">\n                        <div class=\"flex justify-between items-center mb-2\">\n                            <span class=\"font-bold text-red-800 text-sm\">30% discount</span>\n                            <span class=\"text-[10px] bg-red-100 text-red-800 px-2 py-0.5 rounded-md font-bold uppercase tracking-wider\">Aggressive sale</span>\n                        </div>\n                        <div class=\"space-y-1 text-sm text-slate-600\">\n                            <div class=\"flex justify-between\">New selling price: <span class=\"font-bold text-slate-950\" id=\"r30Price\">0.00 kr</span></div>\n                            <div class=\"flex justify-between\">New contribution margin: <span class=\"font-bold text-slate-950\" id=\"r30Db\">0.00 kr</span></div>\n                            <div class=\"flex justify-between pt-2 border-t border-slate-200 mt-2 font-bold text-red-600\">Reduction in CM: <span id=\"r30Drop\" class=\"font-black\">0%</span></div>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"mt-4 p-4 bg-red-50 text-red-800 text-xs sm:text-sm rounded-xl border border-red-100 leading-relaxed\">\n                    <strong>Key financial point:</strong> Discounts cut solely into your profit (the contribution margin). Since the purchase price stays the same, a discount of e.g. 20% will often wipe out all or most of your profit margin.\n                </div>\n            </section>\n\n            <!-- SCHOOL AND BUSINESS SECTIONS (controlled by the mode buttons) -->\n            <div class=\"grid grid-cols-1 md:grid-cols-2 gap-8 mt-8\">\n\n                <!-- SCHOOL MODE: theory and tasks -->\n                <div id=\"section-student-theory\" class=\"block space-y-6\">\n                    <section class=\"bg-white p-6 rounded-2xl border border-slate-200 shadow-sm h-full\">\n                        <h3 class=\"text-lg font-bold text-slate-900 mb-4 border-b border-slate-100 pb-2\">Theory corner</h3>\n                        <div class=\"space-y-4 text-sm leading-relaxed text-slate-600\">\n                            <div>\n                                <h4 class=\"font-bold text-slate-800\">Markup:</h4>\n                                <p>Markup is calculated as a percentage of the <strong>purchase price</strong>, and shows the amount the business adds to the item before VAT.</p>\n                                <p class=\"font-mono bg-slate-100 p-2 rounded-lg text-xs mt-1 text-indigo-700 font-bold\">Formula: Markup % = (Contribution margin / Purchase price) * 100</p>\n                            </div>\n                            <div>\n                                <h4 class=\"font-bold text-slate-800\">Contribution margin ratio (CM%):</h4>\n                                <p>The margin ratio shows how much of the <strong>selling price excl. VAT</strong> is left for fixed costs and profit.</p>\n                                <p class=\"font-mono bg-slate-100 p-2 rounded-lg text-xs mt-1 text-emerald-700 font-bold\">Formula: CM % = (Contribution margin / Price excl. VAT) * 100</p>\n                            </div>\n                        </div>\n                    </section>\n                </div>\n\n                <div id=\"section-student-tasks\" class=\"block\">\n                    <section class=\"bg-indigo-950 text-indigo-100 p-6 rounded-2xl shadow-sm flex flex-col justify-between h-full\">\n                        <div>\n                            <h3 class=\"text-lg font-bold text-white mb-4 border-b border-indigo-900 pb-2\">Practical student challenges</h3>\n                            <div class=\"space-y-4 text-xs sm:text-sm\">\n                                <div class=\"border-l-2 border-indigo-400 pl-3\">\n                                    <span class=\"font-bold text-white text-xs uppercase tracking-wider\">Task 1: Clothing store</span>\n                                    <p class=\"text-indigo-200 mt-1\">A jacket is purchased for 300 kr. You want a 120% markup. What is the selling price incl. 25% VAT? What is the contribution margin ratio?</p>\n                                </div>\n                                <div class=\"border-l-2 border-indigo-400 pl-3\">\n                                    <span class=\"font-bold text-white text-xs uppercase tracking-wider\">Task 2: Hotel</span>\n                                    <p class=\"text-indigo-200 mt-1\">A hotel room has cleaning and operating costs of 200 kr. The hotel requires a contribution margin ratio of 80%. What is the price to the guest (incl. 12% VAT)?</p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"mt-6 pt-3 border-t border-indigo-900 text-[11px] text-indigo-300\">\n                            Tip: Use the calculator above to test the values!\n                        </div>\n                    </section>\n                </div>\n\n                <!-- BUSINESS MODE: break-even analysis (hidden by default) -->\n                <div id=\"section-company\" class=\"md:col-span-2 hidden\">\n                    <section class=\"bg-emerald-950 text-emerald-100 p-6 rounded-2xl shadow-sm border border-emerald-900\">\n                        <div class=\"flex flex-col md:flex-row md:items-center md:justify-between gap-4 border-b border-emerald-900 pb-4 mb-4\">\n                            <div>\n                                <h3 class=\"text-xl font-bold text-white\">Break-even analysis</h3>\n                                <p class=\"text-xs text-emerald-300\">Calculate exactly how many units you must sell to cover your fixed monthly costs.</p>\n                            </div>\n                            <div class=\"w-full md:w-72\">\n                                <label for=\"inputFixedCosts\" class=\"block text-xs font-bold text-emerald-400 uppercase mb-1\">Monthly fixed costs (kr)</label>\n                                <div class=\"relative rounded-lg shadow-sm\">\n                                    <input type=\"number\" id=\"inputFixedCosts\" value=\"50000\" min=\"0\" oninput=\"calculateBreakEven()\" class=\"w-full pl-3 pr-10 py-2.5 bg-emerald-900 border border-emerald-700 rounded-lg text-sm font-bold text-white outline-none focus:ring-2 focus:ring-emerald-500\">\n                                    <div class=\"absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none\">\n                                        <span class=\"text-emerald-400 text-xs font-bold\">kr</span>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n\n                        <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n                            <div class=\"space-y-4\">\n                                <div class=\"p-4 bg-emerald-900/40 rounded-xl border border-emerald-800\">\n                                    <span class=\"text-xs uppercase text-emerald-400 block tracking-wider font-bold\">Required sales volume</span>\n                                    <div class=\"flex items-baseline gap-2 mt-1\">\n                                        <span class=\"text-4xl font-black text-white\" id=\"beVolume\">500</span>\n                                        <span class=\"text-sm font-bold text-emerald-300\">units / month</span>\n                                    </div>\n                                    <p class=\"text-xs text-emerald-300 mt-2\">The sales volume you must reach to cover your fixed operating costs.</p>\n                                </div>\n                                <div class=\"p-4 bg-emerald-900/40 rounded-xl border border-emerald-800\">\n                                    <span class=\"text-xs uppercase text-emerald-400 block tracking-wider font-bold\">Required revenue excl. VAT</span>\n                                    <div class=\"flex items-baseline gap-2 mt-1\">\n                                        <span class=\"text-3xl font-black text-white\" id=\"beRevenue\">100,000.00</span>\n                                        <span class=\"text-sm font-bold text-emerald-300\">kr / month</span>\n                                    </div>\n                                    <p class=\"text-xs text-emerald-300 mt-2\">The total (net) cash flow you must generate to break even.</p>\n                                </div>\n                            </div>\n\n                            <div class=\"bg-emerald-900/20 p-5 rounded-xl border border-emerald-800/40 text-xs sm:text-sm space-y-3 leading-relaxed\">\n                                <h4 class=\"font-bold text-white\">How adjustments affect your risk level:</h4>\n                                <p>The sales volume is determined directly by your contribution margin in kroner:</p>\n                                <ul class=\"list-disc pl-5 space-y-2 text-emerald-300\">\n                                    <li>If you <strong>increase the margin</strong>, you need to sell <strong>fewer items</strong> to cover your fixed costs.</li>\n                                    <li>If you <strong>cut prices</strong> or give discounts, the required sales volume shoots up to compensate for the lost profit.</li>\n                                </ul>\n                                <p class=\"text-xs font-mono text-emerald-400 mt-3 border-t border-emerald-900/50 pt-3\">Formula: Fixed costs / contribution margin per unit = break-even volume</p>\n                            </div>\n                        </div>\n                    </section>\n                </div>\n            </div>\n        </main>\n\n        <footer class=\"bg-white border-t border-slate-200 py-6 mt-12 text-center text-xs text-slate-400\">\n            <p>© 2026 — Interactive learning resource for Sales, Service &amp; Tourism.</p>\n        </footer>\n    </div>\n\n\n    <!-- ========================================== -->\n    <!-- FULL-SCREEN PRESENTATION MODE OVERLAY      -->\n    <!-- ========================================== -->\n    <div id=\"presentation-overlay\" class=\"hidden fixed inset-0 bg-slate-950 z-50 overflow-hidden flex flex-col justify-between p-8 sm:p-12 text-slate-100\">\n\n        <!-- Floating info toast that fades out after 5 seconds -->\n        <div id=\"pres-esc-toast\" class=\"absolute top-6 left-1/2 -translate-x-1/2 bg-indigo-600/95 text-white font-bold text-sm px-6 py-3.5 rounded-full shadow-2xl tracking-wide z-50 transition-opacity duration-1000 flex items-center gap-2 border border-indigo-500\">\n            <span class=\"inline-block w-2.5 h-2.5 rounded-full bg-emerald-400 animate-ping\"></span>\n            <span>Presentation mode active | Press the ESC key to go back</span>\n        </div>\n\n        <!-- Top bar -->\n        <div class=\"flex flex-col md:flex-row md:items-center md:justify-between border-b border-slate-800 pb-6\">\n            <div>\n                <span class=\"text-xs font-bold uppercase tracking-widest text-indigo-400\">Results and composition</span>\n                <h2 class=\"text-3xl md:text-4xl font-black tracking-tight text-white mt-1\">Price and margin breakdown</h2>\n            </div>\n            <div class=\"mt-4 md:mt-0 flex items-center gap-3\">\n                <span class=\"px-4 py-1.5 bg-indigo-950 border border-indigo-800 text-indigo-300 text-xs font-bold rounded-lg uppercase tracking-wide\">\n                    VAT rate: <span id=\"presMvaRateBadge\">25</span>%\n                </span>\n                <span class=\"px-4 py-1.5 bg-emerald-950 border border-emerald-850 text-emerald-300 text-xs font-bold rounded-lg uppercase tracking-wide\">\n                    Margin ratio: <span id=\"presDGBadge\">50</span>%\n                </span>\n            </div>\n        </div>\n\n        <!-- Giant number grid suited to projector viewing -->\n        <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 my-auto\">\n\n            <!-- Customer headline (incl. VAT) -->\n            <div class=\"bg-indigo-950/40 border border-indigo-800/80 p-8 rounded-3xl shadow-2xl flex flex-col justify-between h-48 lg:h-56\">\n                <span class=\"text-xs font-bold text-indigo-400 uppercase tracking-widest block\">Selling price to customer (incl. VAT)</span>\n                <div class=\"my-auto\">\n                    <span class=\"text-5xl lg:text-6xl font-black text-white block tracking-tight\" id=\"presPriceInc\">250.00</span>\n                    <span class=\"text-sm font-bold text-indigo-300 uppercase tracking-wider block mt-1\">kr total at register</span>\n                </div>\n            </div>\n\n            <!-- Price excl. VAT -->\n            <div class=\"bg-slate-900/60 border border-slate-800/80 p-8 rounded-3xl shadow-2xl flex flex-col justify-between h-48 lg:h-56\">\n                <span class=\"text-xs font-bold text-slate-400 uppercase tracking-widest block\">Price excl. VAT</span>\n                <div class=\"my-auto\">\n                    <span class=\"text-4xl lg:text-5xl font-black text-white block tracking-tight\" id=\"presPriceEx\">200.00</span>\n                    <span class=\"text-sm font-bold text-slate-400 uppercase tracking-wider block mt-1\">kr net revenue</span>\n                </div>\n            </div>\n\n            <!-- Contribution margin -->\n            <div class=\"bg-emerald-950/40 border border-emerald-800/80 p-8 rounded-3xl shadow-2xl flex flex-col justify-between h-48 lg:h-56\">\n                <div class=\"flex items-center gap-2\">\n                    <span class=\"w-2 h-2 rounded-full bg-emerald-500\"></span>\n                    <span class=\"text-xs font-bold text-emerald-400 uppercase tracking-widest block\">Contribution margin</span>\n                </div>\n                <div class=\"my-auto\">\n                    <span class=\"text-4xl lg:text-5xl font-black text-emerald-400 block tracking-tight\" id=\"presDB\">100.00</span>\n                    <span class=\"text-sm font-bold text-emerald-300 uppercase tracking-wider block mt-1\">kr kept by the business</span>\n                </div>\n            </div>\n\n            <!-- VAT amount -->\n            <div class=\"bg-slate-900/60 border border-slate-800/80 p-8 rounded-3xl shadow-2xl flex flex-col justify-between h-48 lg:h-56\">\n                <span class=\"text-xs font-bold text-slate-400 uppercase tracking-widest block\">Value Added Tax</span>\n                <div class=\"my-auto\">\n                    <span class=\"text-4xl lg:text-5xl font-black text-slate-200 block tracking-tight\" id=\"presMvaValue\">50.00</span>\n                    <span class=\"text-sm font-bold text-slate-400 uppercase tracking-wider block mt-1\">kr the state's share</span>\n                </div>\n            </div>\n        </div>\n\n        <!-- Enlarged color-coded bar chart for presentation -->\n        <div class=\"bg-slate-900/40 border border-slate-850 p-8 rounded-3xl\">\n            <h3 class=\"text-xs font-bold tracking-widest text-slate-400 uppercase mb-4\">Composition of the total price</h3>\n\n            <div class=\"relative w-full h-20 rounded-2xl overflow-hidden flex shadow-2xl border border-slate-800\">\n                <!-- Purchase -->\n                <div id=\"presBarCost\" class=\"bg-slate-600 h-full flex flex-col items-center justify-center transition-all duration-300\" style=\"width: 40%\">\n                    <span class=\"text-[10px] font-black uppercase text-slate-300 tracking-wider\">Purchase</span>\n                    <span class=\"text-lg font-black text-white\" id=\"presPctCost\">40.0%</span>\n                </div>\n                <!-- Margin -->\n                <div id=\"presBarDB\" class=\"bg-emerald-600 h-full flex flex-col items-center justify-center transition-all duration-300\" style=\"width: 40%\">\n                    <span class=\"text-[10px] font-black uppercase text-emerald-100 tracking-wider\">Margin (CM)</span>\n                    <span class=\"text-lg font-black text-white\" id=\"presPctDB\">40.0%</span>\n                </div>\n                <!-- VAT -->\n                <div id=\"presBarMva\" class=\"bg-indigo-600 h-full flex flex-col items-center justify-center transition-all duration-300\" style=\"width: 20%\">\n                    <span class=\"text-[10px] font-black uppercase text-indigo-100 tracking-wider\">VAT</span>\n                    <span class=\"text-lg font-black text-white\" id=\"presPctMva\">20.0%</span>\n                </div>\n            </div>\n\n            <!-- Chart legend -->\n            <div class=\"grid grid-cols-1 md:grid-cols-3 gap-4 mt-6 text-xs text-center font-bold text-slate-400\">\n                <div class=\"flex items-center justify-center gap-2\">\n                    <span class=\"w-3 h-3 rounded-full bg-slate-600\"></span>\n                    <span>Cost of goods (item cost price)</span>\n                </div>\n                <div class=\"flex items-center justify-center gap-2\">\n                    <span class=\"w-3 h-3 rounded-full bg-emerald-600\"></span>\n                    <span>Contribution margin (business profit)</span>\n                </div>\n                <div class=\"flex items-center justify-center gap-2\">\n                    <span class=\"w-3 h-3 rounded-full bg-indigo-600\"></span>\n                    <span>Value Added Tax (state levy)</span>\n                </div>\n            </div>\n        </div>\n    </div>\n\n\n    <!-- ========================================== -->\n    <!-- JAVASCRIPT LOGIC FOR THE CALCULATOR        -->\n    <!-- ========================================== -->\n    <script>\n        // State\n        let mvaRate = 25;\n        let currentMode = 'student';\n\n        // Run on startup\n        window.onload = function() {\n            updateCalculations('avanse');\n        };\n\n        // Switch between School and Business mode\n        function setMode(mode) {\n            currentMode = mode;\n            const btnStudent = document.getElementById('btnModeStudent');\n            const btnBedrift = document.getElementById('btnModeBedrift');\n\n            const sectionTheory = document.getElementById('section-student-theory');\n            const sectionTasks = document.getElementById('section-student-tasks');\n            const sectionCompany = document.getElementById('section-company');\n\n            if (mode === 'student') {\n                btnStudent.className = \"px-4 py-2 text-sm font-medium rounded-lg bg-white text-indigo-600 shadow-sm transition-all\";\n                btnBedrift.className = \"px-4 py-2 text-sm font-medium rounded-lg text-slate-600 hover:text-slate-900 transition-all\";\n\n                sectionTheory.classList.remove('hidden');\n                sectionTasks.classList.remove('hidden');\n                sectionCompany.classList.add('hidden');\n            } else {\n                btnBedrift.className = \"px-4 py-2 text-sm font-medium rounded-lg bg-white text-indigo-600 shadow-sm transition-all\";\n                btnStudent.className = \"px-4 py-2 text-sm font-medium rounded-lg text-slate-600 hover:text-slate-900 transition-all\";\n\n                sectionTheory.classList.add('hidden');\n                sectionTasks.classList.add('hidden');\n                sectionCompany.classList.remove('hidden');\n                calculateBreakEven();\n            }\n        }\n\n        // Set a new VAT rate\n        function setMva(rate) {\n            mvaRate = rate;\n\n            const mvaRates = [25, 15, 12, 0];\n            mvaRates.forEach(r => {\n                const btn = document.getElementById(`btnMva${r}`);\n                if (r === rate) {\n                    btn.className = \"py-3 px-1 text-sm font-bold rounded-xl border-2 border-indigo-600 bg-indigo-50 text-indigo-700 transition-all\";\n                } else {\n                    btn.className = \"py-3 px-1 text-sm font-bold rounded-xl border border-slate-200 hover:border-slate-300 text-slate-700 bg-white transition-all\";\n                }\n            });\n\n            updateCalculations('none');\n        }\n\n        // Handle manual entry of Markup %\n        function syncFromAvanseInput() {\n            const numVal = parseFloat(document.getElementById('inputAvanseNum').value) || 0;\n            document.getElementById('sliderAvanse').value = Math.min(numVal, 300);\n            updateCalculations('avanse');\n        }\n\n        // Handle manual entry of contribution margin %\n        function syncFromDGInput() {\n            let numVal = parseFloat(document.getElementById('inputDGNum').value) || 0;\n            if (numVal >= 100) numVal = 99.9;\n            document.getElementById('sliderDG').value = Math.min(numVal, 95);\n            updateCalculations('dg');\n        }\n\n        // The engine behind the calculations and the two-way binding\n        function updateCalculations(source) {\n            let cost = parseFloat(document.getElementById('inputCost').value);\n            if (isNaN(cost) || cost <= 0) {\n                cost = 0;\n            }\n\n            let avansePercent = parseFloat(document.getElementById('sliderAvanse').value);\n            let dgPercent = parseFloat(document.getElementById('sliderDG').value);\n\n            let priceEx = 0;\n            let dbValue = 0;\n\n            if (source === 'avanse') {\n                // Calculate from Markup %\n                priceEx = cost * (1 + (avansePercent / 100));\n                dbValue = priceEx - cost;\n\n                if (priceEx > 0) {\n                    dgPercent = (dbValue / priceEx) * 100;\n                } else {\n                    dgPercent = 0;\n                }\n\n                document.getElementById('sliderDG').value = dgPercent;\n                document.getElementById('inputDGNum').value = dgPercent.toFixed(1);\n                document.getElementById('inputAvanseNum').value = avansePercent;\n\n            } else if (source === 'dg') {\n                // Calculate from contribution margin %\n                if (dgPercent >= 100) dgPercent = 99.9;\n\n                priceEx = cost / (1 - (dgPercent / 100));\n                dbValue = priceEx - cost;\n\n                if (cost > 0) {\n                    avansePercent = (dbValue / cost) * 100;\n                } else {\n                    avansePercent = 0;\n                }\n\n                document.getElementById('sliderAvanse').value = Math.min(avansePercent, 300);\n                document.getElementById('inputAvanseNum').value = avansePercent.toFixed(1);\n                document.getElementById('inputDGNum').value = dgPercent;\n\n            } else {\n                // On startup or when only VAT/purchase price changes\n                avansePercent = parseFloat(document.getElementById('inputAvanseNum').value) || 0;\n                priceEx = cost * (1 + (avansePercent / 100));\n                dbValue = priceEx - cost;\n\n                if (priceEx > 0) {\n                    dgPercent = (dbValue / priceEx) * 100;\n                } else {\n                    dgPercent = 0;\n                }\n\n                document.getElementById('sliderDG').value = Math.min(dgPercent, 95);\n                document.getElementById('inputDGNum').value = dgPercent.toFixed(1);\n            }\n\n            // Calculate VAT and total selling price\n            let mvaValue = priceEx * (mvaRate / 100);\n            let priceInc = priceEx + mvaValue;\n\n            // Update the numbers in the UI\n            document.getElementById('resPriceEx').innerText = formatCurrency(priceEx);\n            document.getElementById('resDB').innerText = formatCurrency(dbValue);\n            document.getElementById('resMvaPercent').innerText = mvaRate;\n            document.getElementById('resMvaValue').innerText = formatCurrency(mvaValue);\n            document.getElementById('resPriceInc').innerText = formatCurrency(priceInc);\n\n            // Update the visualization (bar chart)\n            updateVisualization(cost, dbValue, mvaValue, priceInc);\n\n            // Update the discount simulator\n            updateDiscountSimulator(priceInc, cost);\n\n            // Update break-even if business mode is active\n            if (currentMode === 'bedrift') {\n                calculateBreakEven();\n            }\n        }\n\n        // Currency formatting\n        function formatCurrency(val) {\n            return val.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });\n        }\n\n        // Update the color distribution in the bar\n        function updateVisualization(cost, db, mva, total) {\n            const barCost = document.getElementById('barCost');\n            const barDB = document.getElementById('barDB');\n            const barMva = document.getElementById('barMva');\n\n            const pctCostEl = document.getElementById('pctCost');\n            const pctDBEl = document.getElementById('pctDB');\n            const pctMvaEl = document.getElementById('pctMva');\n\n            if (total <= 0) {\n                barCost.style.width = '0%';\n                barDB.style.width = '0%';\n                barMva.style.width = '0%';\n\n                pctCostEl.innerText = \"0%\";\n                pctDBEl.innerText = \"0%\";\n                pctMvaEl.innerText = \"0%\";\n                return;\n            }\n\n            const costPct = (cost / total) * 100;\n            const dbPct = (db / total) * 100;\n            const mvaPct = (mva / total) * 100;\n\n            barCost.style.width = costPct + '%';\n            barDB.style.width = dbPct + '%';\n            barMva.style.width = mvaPct + '%';\n\n            pctCostEl.innerText = costPct.toFixed(1) + '%';\n            pctDBEl.innerText = dbPct.toFixed(1) + '%';\n            pctMvaEl.innerText = mvaPct.toFixed(1) + '%';\n        }\n\n        // Calculate the discount scenarios\n        function updateDiscountSimulator(originalPriceInc, costPrice) {\n            const discountRates = [10, 20, 30];\n\n            discountRates.forEach(discount => {\n                let newPriceInc = originalPriceInc * (1 - (discount / 100));\n                let newPriceEx = newPriceInc / (1 + (mvaRate / 100));\n                let newDB = newPriceEx - costPrice;\n\n                let originalPriceEx = originalPriceInc / (1 + (mvaRate / 100));\n                let originalDB = originalPriceEx - costPrice;\n\n                let dbDropPercent = 0;\n                if (originalDB > 0) {\n                    dbDropPercent = ((originalDB - newDB) / originalDB) * 100;\n                } else if (originalDB <= 0 && newDB < originalDB) {\n                    dbDropPercent = 100;\n                }\n\n                document.getElementById(`r${discount}Price`).innerText = formatCurrency(newPriceInc) + \" kr\";\n\n                // Handle negative contribution margin (below cost)\n                const dbElement = document.getElementById(`r${discount}Db`);\n                if (newDB < 0) {\n                    dbElement.innerText = formatCurrency(newDB) + \" kr (BELOW COST)\";\n                    dbElement.className = \"font-bold text-red-600\";\n                } else {\n                    dbElement.innerText = formatCurrency(newDB) + \" kr\";\n                    dbElement.className = \"font-bold text-slate-950\";\n                }\n\n                const dropEl = document.getElementById(`r${discount}Drop`);\n                dropEl.innerText = \"-\" + dbDropPercent.toFixed(0) + \"%\";\n            });\n        }\n\n        // Calculate the break-even analysis in real time\n        function calculateBreakEven() {\n            const fixedCosts = parseFloat(document.getElementById('inputFixedCosts').value) || 0;\n            const cost = parseFloat(document.getElementById('inputCost').value) || 0;\n\n            const priceExText = document.getElementById('resPriceEx').innerText;\n            const priceEx = parseFloat(priceExText.replace(/,/g, '')) || 0;\n\n            const dbPerUnit = priceEx - cost;\n\n            const beVolumeEl = document.getElementById('beVolume');\n            const beRevenueEl = document.getElementById('beRevenue');\n\n            if (dbPerUnit <= 0) {\n                beVolumeEl.innerText = \"Infinite\";\n                beRevenueEl.innerText = \"Invalid (zero or negative margin)\";\n                return;\n            }\n\n            const reqVolume = Math.ceil(fixedCosts / dbPerUnit);\n            const reqRevenue = reqVolume * priceEx;\n\n            beVolumeEl.innerText = reqVolume.toLocaleString('en-US');\n            beRevenueEl.innerText = formatCurrency(reqRevenue);\n        }\n\n\n        // ==========================================\n        // PRESENTATION METHODS & OVERLAY CONTROL    //\n        // ==========================================\n\n        function startPresentationMode() {\n            // Read values and sync them to the presentation headlines\n            const cost = parseFloat(document.getElementById('inputCost').value) || 0;\n            const dgPercent = parseFloat(document.getElementById('inputDGNum').value) || 0;\n\n            const priceExText = document.getElementById('resPriceEx').innerText;\n            const dbText = document.getElementById('resDB').innerText;\n            const mvaText = document.getElementById('resMvaValue').innerText;\n            const priceIncText = document.getElementById('resPriceInc').innerText;\n\n            const total = parseFloat(priceIncText.replace(/,/g, '')) || 0;\n            const db = parseFloat(dbText.replace(/,/g, '')) || 0;\n            const mva = parseFloat(mvaText.replace(/,/g, '')) || 0;\n\n            // Fill in the giant headlines\n            document.getElementById('presPriceInc').innerText = priceIncText;\n            document.getElementById('presPriceEx').innerText = priceExText;\n            document.getElementById('presDB').innerText = dbText;\n            document.getElementById('presMvaValue').innerText = mvaText;\n\n            // Badges\n            document.getElementById('presMvaRateBadge').innerText = mvaRate;\n            document.getElementById('presDGBadge').innerText = dgPercent.toFixed(1);\n\n            // Update the large horizontal bar\n            const presBarCost = document.getElementById('presBarCost');\n            const presBarDB = document.getElementById('presBarDB');\n            const presBarMva = document.getElementById('presBarMva');\n\n            const presPctCost = document.getElementById('presPctCost');\n            const presPctDB = document.getElementById('presPctDB');\n            const presPctMva = document.getElementById('presPctMva');\n\n            if (total > 0) {\n                const costPct = (cost / total) * 100;\n                const dbPct = (db / total) * 100;\n                const mvaPct = (mva / total) * 100;\n\n                presBarCost.style.width = costPct + '%';\n                presBarDB.style.width = dbPct + '%';\n                presBarMva.style.width = mvaPct + '%';\n\n                presPctCost.innerText = costPct.toFixed(1) + '%';\n                presPctDB.innerText = dbPct.toFixed(1) + '%';\n                presPctMva.innerText = mvaPct.toFixed(1) + '%';\n            } else {\n                presBarCost.style.width = '0%';\n                presBarDB.style.width = '0%';\n                presBarMva.style.width = '0%';\n\n                presPctCost.innerText = '0%';\n                presPctDB.innerText = '0%';\n                presPctMva.innerText = '0%';\n            }\n\n            // Show the overlay\n            document.getElementById('presentation-overlay').classList.remove('hidden');\n\n            // Handle the info toast that auto-fades after 5 seconds\n            const toast = document.getElementById('pres-esc-toast');\n            toast.style.opacity = '1';\n\n            setTimeout(() => {\n                toast.style.opacity = '0';\n                // Prevent the user from clicking an invisible element\n                setTimeout(() => {\n                    if (toast.style.opacity === '0') {\n                        toast.classList.add('pointer-events-none');\n                    }\n                }, 1000);\n            }, 4000);\n        }\n\n        // Listen globally for the ESC key\n        window.addEventListener('keydown', function(e) {\n            if (e.key === 'Escape') {\n                const overlay = document.getElementById('presentation-overlay');\n                if (!overlay.classList.contains('hidden')) {\n                    overlay.classList.add('hidden');\n                    // Restore toast classes for the next start\n                    const toast = document.getElementById('pres-esc-toast');\n                    toast.classList.remove('pointer-events-none');\n                }\n            }\n        });\n    </script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Price Calculator",
    "windowTitle": "Interactive Price Calculator",
    "bundleId": "com.halisonworks.pricecalculator",
    "iconPath": null
  },
  "categoryId": null,
  "source": "import",
  "createdAt": "2026-06-02T12:00:00.000Z",
  "updatedAt": "2026-06-02T12:00:00.000Z",
  "sharedAt": "2026-06-02T12:00:00.000Z"
}
