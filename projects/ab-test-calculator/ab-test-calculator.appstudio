{
  "schema": "app-studio/canvas@1",
  "id": "example-ab-test-calculator",
  "name": "ab-test-calculator.html",
  "code": "<!DOCTYPE html>\n<!--\n  A/B Test Calculator — Halison App Studio example\n\n  Check if an A/B test result is statistically significant: conversion rates,\n  uplift, p-value (two-proportion z-test), confidence interval, and a verdict.\n\n  From the Halison App Studio public library:\n  https://github.com/halisonworks/public-app-studio\n\n  Permitted use: personal, educational, and other non-commercial use. You may\n  modify it, but keep this header and the source link intact, and do not sell,\n  commercialize, or republish it. Released under the Halison App Studio Examples\n  License — see the LICENSE file in the repository above.\n-->\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>A/B Test Calculator</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Inter', 'Segoe UI', sans-serif; }\n    input[type=number]::-webkit-inner-spin-button,\n    input[type=number]::-webkit-outer-spin-button { opacity: 1; }\n    .bar-track { transition: width 0.6s cubic-bezier(0.4,0,0.2,1); }\n    .fade-in { animation: fadeIn 0.4s ease; }\n    @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }\n    .badge-sig { background: #d1fae5; color: #065f46; border: 1.5px solid #6ee7b7; }\n    .badge-not { background: #fee2e2; color: #991b1b; border: 1.5px solid #fca5a5; }\n    .badge-neutral { background: #f3f4f6; color: #374151; border: 1.5px solid #d1d5db; }\n    .ci-bar { stroke: #6366f1; stroke-width: 2; }\n    .ci-cap { stroke: #6366f1; stroke-width: 2; }\n    .tooltip { position: relative; }\n    .tooltip:hover .tooltip-text { display: block; }\n    .tooltip-text { display: none; position: absolute; bottom: 125%; left: 50%; transform: translateX(-50%);\n      background: #1e293b; color: #f8fafc; font-size: 11px; padding: 4px 8px; border-radius: 5px;\n      white-space: nowrap; z-index: 50; pointer-events: none; }\n    .tooltip-text::after { content: ''; position: absolute; top: 100%; left: 50%; transform: translateX(-50%);\n      border: 5px solid transparent; border-top-color: #1e293b; }\n  </style>\n</head>\n<body class=\"bg-gray-50 min-h-screen\">\n\n  <!-- Header -->\n  <header class=\"bg-white border-b border-gray-200 sticky top-0 z-30 shadow-sm\">\n    <div class=\"max-w-4xl mx-auto px-4 py-4 flex items-center justify-between\">\n      <div class=\"flex items-center gap-3\">\n        <div class=\"w-9 h-9 rounded-lg bg-indigo-600 flex items-center justify-center\">\n          <svg class=\"w-5 h-5 text-white\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z\" />\n          </svg>\n        </div>\n        <div>\n          <h1 class=\"text-lg font-bold text-gray-900 leading-tight\">A/B Test Calculator</h1>\n          <p class=\"text-xs text-gray-500\">Statistical significance for conversion rate tests</p>\n        </div>\n      </div>\n      <div class=\"flex items-center gap-2\">\n        <label class=\"text-xs text-gray-500 font-medium mr-1\">Significance threshold</label>\n        <select id=\"sigThreshold\" class=\"text-sm border border-gray-300 rounded-md px-2 py-1.5 bg-white text-gray-700 focus:outline-none focus:ring-2 focus:ring-indigo-400\">\n          <option value=\"0.90\">90%</option>\n          <option value=\"0.95\" selected>95%</option>\n          <option value=\"0.99\">99%</option>\n        </select>\n      </div>\n    </div>\n  </header>\n\n  <main class=\"max-w-4xl mx-auto px-4 py-8 space-y-6\">\n\n    <!-- Input Section -->\n    <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n      <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider mb-5\">Test Data</h2>\n      <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n\n        <!-- Variant A -->\n        <div class=\"rounded-xl border-2 border-gray-200 p-5 space-y-4\">\n          <div class=\"flex items-center gap-2\">\n            <span class=\"w-7 h-7 rounded-full bg-blue-100 text-blue-700 flex items-center justify-center font-bold text-sm\">A</span>\n            <span class=\"font-semibold text-gray-800\">Variant A</span>\n            <span class=\"ml-auto text-xs text-gray-400 italic\">Control</span>\n          </div>\n          <div>\n            <label class=\"block text-xs font-medium text-gray-500 mb-1\">Visitors</label>\n            <input id=\"visitorsA\" type=\"number\" min=\"1\" value=\"4200\"\n              class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-800 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-transparent\"\n              placeholder=\"e.g. 4200\" />\n          </div>\n          <div>\n            <label class=\"block text-xs font-medium text-gray-500 mb-1\">Conversions</label>\n            <input id=\"conversionsA\" type=\"number\" min=\"0\" value=\"378\"\n              class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-800 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-transparent\"\n              placeholder=\"e.g. 378\" />\n          </div>\n          <div class=\"bg-blue-50 rounded-lg px-4 py-2 flex items-center justify-between\">\n            <span class=\"text-xs text-blue-600 font-medium\">Conversion rate</span>\n            <span id=\"rateA\" class=\"text-lg font-bold text-blue-700\">—</span>\n          </div>\n        </div>\n\n        <!-- Variant B -->\n        <div class=\"rounded-xl border-2 border-indigo-200 p-5 space-y-4\">\n          <div class=\"flex items-center gap-2\">\n            <span class=\"w-7 h-7 rounded-full bg-indigo-100 text-indigo-700 flex items-center justify-center font-bold text-sm\">B</span>\n            <span class=\"font-semibold text-gray-800\">Variant B</span>\n            <span class=\"ml-auto text-xs text-gray-400 italic\">Challenger</span>\n          </div>\n          <div>\n            <label class=\"block text-xs font-medium text-gray-500 mb-1\">Visitors</label>\n            <input id=\"visitorsB\" type=\"number\" min=\"1\" value=\"4050\"\n              class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent\"\n              placeholder=\"e.g. 4050\" />\n          </div>\n          <div>\n            <label class=\"block text-xs font-medium text-gray-500 mb-1\">Conversions</label>\n            <input id=\"conversionsB\" type=\"number\" min=\"0\" value=\"425\"\n              class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent\"\n              placeholder=\"e.g. 425\" />\n          </div>\n          <div class=\"bg-indigo-50 rounded-lg px-4 py-2 flex items-center justify-between\">\n            <span class=\"text-xs text-indigo-600 font-medium\">Conversion rate</span>\n            <span id=\"rateB\" class=\"text-lg font-bold text-indigo-700\">—</span>\n          </div>\n        </div>\n\n      </div>\n    </section>\n\n    <!-- Error Banner -->\n    <div id=\"errorBanner\" class=\"hidden bg-red-50 border border-red-200 rounded-xl px-5 py-3 text-red-700 text-sm flex items-center gap-2\">\n      <svg class=\"w-4 h-4 flex-shrink-0\" fill=\"currentColor\" viewBox=\"0 0 20 20\"><path fill-rule=\"evenodd\" d=\"M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z\" clip-rule=\"evenodd\"/></svg>\n      <span id=\"errorText\"></span>\n    </div>\n\n    <!-- Results Section -->\n    <div id=\"resultsSection\" class=\"space-y-5 fade-in\">\n\n      <!-- Verdict Card -->\n      <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n        <div class=\"flex flex-col sm:flex-row sm:items-center gap-4\">\n          <div class=\"flex-1\">\n            <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider mb-2\">Verdict</h2>\n            <p id=\"verdictText\" class=\"text-xl font-bold text-gray-800\"></p>\n            <p id=\"verdictSub\" class=\"text-sm text-gray-500 mt-1\"></p>\n          </div>\n          <div id=\"verdictBadge\" class=\"flex-shrink-0 px-5 py-3 rounded-xl font-bold text-base text-center min-w-[160px]\"></div>\n        </div>\n      </section>\n\n      <!-- Key Metrics Grid -->\n      <section class=\"grid grid-cols-2 md:grid-cols-4 gap-4\">\n        <div class=\"bg-white rounded-xl border border-gray-200 p-4 shadow-sm\">\n          <div class=\"text-xs text-gray-500 font-medium mb-1 tooltip\">\n            Absolute Uplift\n            <span class=\"tooltip-text\">Conversion rate B minus conversion rate A</span>\n          </div>\n          <div id=\"absUplift\" class=\"text-2xl font-bold text-gray-800\">—</div>\n          <div class=\"text-xs text-gray-400 mt-0.5\">percentage points</div>\n        </div>\n        <div class=\"bg-white rounded-xl border border-gray-200 p-4 shadow-sm\">\n          <div class=\"text-xs text-gray-500 font-medium mb-1 tooltip\">\n            Relative Uplift\n            <span class=\"tooltip-text\">Absolute uplift divided by rate A</span>\n          </div>\n          <div id=\"relUplift\" class=\"text-2xl font-bold text-gray-800\">—</div>\n          <div class=\"text-xs text-gray-400 mt-0.5\">improvement</div>\n        </div>\n        <div class=\"bg-white rounded-xl border border-gray-200 p-4 shadow-sm\">\n          <div class=\"text-xs text-gray-500 font-medium mb-1 tooltip\">\n            p-value\n            <span class=\"tooltip-text\">Two-tailed p-value from z-test. Lower = stronger evidence.</span>\n          </div>\n          <div id=\"pValue\" class=\"text-2xl font-bold text-gray-800\">—</div>\n          <div class=\"text-xs text-gray-400 mt-0.5\">two-tailed</div>\n        </div>\n        <div class=\"bg-white rounded-xl border border-gray-200 p-4 shadow-sm\">\n          <div class=\"text-xs text-gray-500 font-medium mb-1 tooltip\">\n            Confidence Level\n            <span class=\"tooltip-text\">1 minus p-value, expressed as a percentage</span>\n          </div>\n          <div id=\"confLevel\" class=\"text-2xl font-bold text-gray-800\">—</div>\n          <div class=\"text-xs text-gray-400 mt-0.5\">confidence</div>\n        </div>\n      </section>\n\n      <!-- Z-score & CI Row -->\n      <section class=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n        <div class=\"bg-white rounded-xl border border-gray-200 p-4 shadow-sm\">\n          <div class=\"text-xs text-gray-500 font-medium mb-1 tooltip\">\n            Z-score\n            <span class=\"tooltip-text\">Two-proportion z-statistic. |z| > 1.96 indicates p &lt; 0.05.</span>\n          </div>\n          <div id=\"zScore\" class=\"text-2xl font-bold text-gray-800\">—</div>\n          <div class=\"text-xs text-gray-400 mt-0.5\">standard deviations from null</div>\n        </div>\n        <div class=\"bg-white rounded-xl border border-gray-200 p-4 shadow-sm\">\n          <div class=\"text-xs text-gray-500 font-medium mb-1 tooltip\">\n            95% Confidence Interval for Difference (B − A)\n            <span class=\"tooltip-text\">Range likely to contain the true difference in conversion rates</span>\n          </div>\n          <div id=\"ciText\" class=\"text-xl font-bold text-gray-800\">—</div>\n          <div class=\"text-xs text-gray-400 mt-0.5\">absolute difference in conversion rate</div>\n        </div>\n      </section>\n\n      <!-- Visual Comparison -->\n      <section class=\"bg-white rounded-2xl shadow-sm border border-gray-200 p-6\">\n        <h2 class=\"text-sm font-semibold text-gray-500 uppercase tracking-wider mb-5\">Conversion Rate Comparison</h2>\n\n        <!-- Bar Chart with CI Whiskers -->\n        <div id=\"svgContainer\" class=\"w-full overflow-x-auto\">\n          <svg id=\"barChart\" width=\"100%\" viewBox=\"0 0 560 160\" preserveAspectRatio=\"xMidYMid meet\" class=\"block\">\n          </svg>\n        </div>\n\n        <!-- Legend -->\n        <div class=\"flex flex-wrap gap-4 mt-4 text-xs text-gray-500\">\n          <div class=\"flex items-center gap-1.5\">\n            <span class=\"w-3 h-3 rounded-sm bg-blue-400 inline-block\"></span> Variant A (Control)\n          </div>\n          <div class=\"flex items-center gap-1.5\">\n            <span class=\"w-3 h-3 rounded-sm bg-indigo-500 inline-block\"></span> Variant B (Challenger)\n          </div>\n          <div class=\"flex items-center gap-1.5\">\n            <svg width=\"20\" height=\"12\" class=\"inline-block\"><line x1=\"10\" y1=\"2\" x2=\"10\" y2=\"10\" stroke=\"#6366f1\" stroke-width=\"1.5\"/><line x1=\"4\" y1=\"2\" x2=\"16\" y2=\"2\" stroke=\"#6366f1\" stroke-width=\"1.5\"/><line x1=\"4\" y1=\"10\" x2=\"16\" y2=\"10\" stroke=\"#6366f1\" stroke-width=\"1.5\"/></svg>\n            95% confidence interval\n          </div>\n        </div>\n      </section>\n\n      <!-- Methodology Note -->\n      <section class=\"bg-gray-50 rounded-xl border border-gray-200 px-5 py-4 text-xs text-gray-500 leading-relaxed\">\n        <strong class=\"text-gray-700\">Methodology:</strong> Two-proportion z-test (large-sample approximation). P-value computed via Abramowitz &amp; Stegun erf approximation (error &lt; 1.5 × 10<sup>−7</sup>). Confidence interval uses the normal approximation for the difference of two proportions. This calculator assumes independent samples and no multiple-testing correction. Minimum recommended sample: ~100 conversions per variant.\n      </section>\n\n    </div>\n  </main>\n\n  <footer class=\"max-w-4xl mx-auto px-4 py-6 text-center text-xs text-gray-400\">\n    A/B Test Calculator &mdash; <a href=\"https://github.com/halisonworks/public-app-studio\" class=\"underline hover:text-indigo-500\" target=\"_blank\" rel=\"noopener\">Halison App Studio</a>\n  </footer>\n\n<script>\n// ─── Statistical helpers ────────────────────────────────────────────────────\n\n/**\n * Normal CDF using Abramowitz & Stegun erf approximation (formula 7.1.26).\n * Max error: 1.5e-7.\n */\nfunction erf(x) {\n  const sign = x < 0 ? -1 : 1;\n  x = Math.abs(x);\n  const t = 1.0 / (1.0 + 0.3275911 * x);\n  const y = 1.0 - (((((1.061405429 * t - 1.453152027) * t) + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t * Math.exp(-x * x);\n  return sign * y;\n}\n\nfunction normCDF(z) {\n  return 0.5 * (1.0 + erf(z / Math.SQRT2));\n}\n\n/**\n * Two-tailed p-value from z-score.\n */\nfunction twoTailP(z) {\n  return 2 * (1 - normCDF(Math.abs(z)));\n}\n\n/**\n * Inverse normal CDF (probit) — rational approximation for the CI.\n * Accurate enough for p in (0.0001, 0.9999).\n */\nfunction normInv(p) {\n  // Rational approximation (Peter J. Acklam's method)\n  const a = [-3.969683028665376e+01, 2.209460984245205e+02,\n             -2.759285104469687e+02, 1.383577518672690e+02,\n             -3.066479806614716e+01, 2.506628277459239e+00];\n  const b = [-5.447609879822406e+01, 1.615858368580409e+02,\n             -1.556989798598866e+02, 6.680131188771972e+01,\n             -1.328068155288572e+01];\n  const c = [-7.784894002430293e-03, -3.223964580411365e-01,\n             -2.400758277161838e+00, -2.549732539343734e+00,\n              4.374664141464968e+00, 2.938163982698783e+00];\n  const d = [ 7.784695709041462e-03, 3.224671290700398e-01,\n              2.445134137142996e+00, 3.754408661907416e+00];\n  const pLow = 0.02425, pHigh = 1 - pLow;\n  let q, r;\n  if (p < pLow) {\n    q = Math.sqrt(-2 * Math.log(p));\n    return (((((c[0]*q+c[1])*q+c[2])*q+c[3])*q+c[4])*q+c[5]) /\n           ((((d[0]*q+d[1])*q+d[2])*q+d[3])*q+1);\n  } else if (p <= pHigh) {\n    q = p - 0.5; r = q * q;\n    return (((((a[0]*r+a[1])*r+a[2])*r+a[3])*r+a[4])*r+a[5])*q /\n           (((((b[0]*r+b[1])*r+b[2])*r+b[3])*r+b[4])*r+1);\n  } else {\n    q = Math.sqrt(-2 * Math.log(1 - p));\n    return -(((((c[0]*q+c[1])*q+c[2])*q+c[3])*q+c[4])*q+c[5]) /\n            ((((d[0]*q+d[1])*q+d[2])*q+d[3])*q+1);\n  }\n}\n\n/**\n * Two-proportion z-score.\n */\nfunction twoProportionZ(nA, cA, nB, cB) {\n  const pA = cA / nA;\n  const pB = cB / nB;\n  const pooled = (cA + cB) / (nA + nB);\n  const se = Math.sqrt(pooled * (1 - pooled) * (1/nA + 1/nB));\n  if (se === 0) return 0;\n  return (pB - pA) / se;\n}\n\n/**\n * 95% CI for difference pB - pA (unpooled SE).\n */\nfunction diffCI(nA, cA, nB, cB, level) {\n  const pA = cA / nA;\n  const pB = cB / nB;\n  const se = Math.sqrt(pA * (1 - pA) / nA + pB * (1 - pB) / nB);\n  const z = normInv(1 - (1 - level) / 2);\n  const diff = pB - pA;\n  return { lo: diff - z * se, hi: diff + z * se, diff, se };\n}\n\n// ─── Formatting ─────────────────────────────────────────────────────────────\n\nfunction pct(x, decimals = 2) {\n  return (x * 100).toFixed(decimals) + '%';\n}\nfunction fmtDiff(x) {\n  const sign = x > 0 ? '+' : '';\n  return sign + (x * 100).toFixed(2) + ' pp';\n}\nfunction fmtRel(x) {\n  const sign = x > 0 ? '+' : '';\n  return sign + (x * 100).toFixed(1) + '%';\n}\n\n// ─── DOM refs ───────────────────────────────────────────────────────────────\n\nconst fields = {\n  vA: () => document.getElementById('visitorsA'),\n  cA: () => document.getElementById('conversionsA'),\n  vB: () => document.getElementById('visitorsB'),\n  cB: () => document.getElementById('conversionsB'),\n  threshold: () => document.getElementById('sigThreshold'),\n};\nconst out = id => document.getElementById(id);\n\n// ─── SVG bar chart ──────────────────────────────────────────────────────────\n\nfunction drawChart(pA, pB, ciLo, ciHi) {\n  const svg = document.getElementById('barChart');\n  svg.innerHTML = '';\n\n  const W = 560, H = 160;\n  const marginL = 80, marginR = 30, marginTop = 20, marginBot = 30;\n  const chartW = W - marginL - marginR;\n  const chartH = H - marginTop - marginBot;\n  const barHeight = 32;\n  const barGap = (chartH - 2 * barHeight) / 3;\n  const yA = marginTop + barGap;\n  const yB = marginTop + 2 * barGap + barHeight;\n\n  // Determine scale: go from 0 to max(pA, pB) * 1.35 + a bit for whiskers\n  const maxVal = Math.max(pA, pB, pB + (ciHi - (pB - pA))) * 1.35;\n  const scale = (v) => (v / maxVal) * chartW;\n\n  function ns(tag, attrs) {\n    const el = document.createElementNS('http://www.w3.org/2000/svg', tag);\n    for (const [k, v] of Object.entries(attrs)) el.setAttribute(k, v);\n    return el;\n  }\n\n  // Gridlines\n  const gridVals = [0, 0.25, 0.5, 0.75, 1.0].map(f => f * maxVal).filter(v => v <= maxVal);\n  for (const gv of gridVals) {\n    const gx = marginL + scale(gv);\n    svg.appendChild(ns('line', { x1: gx, y1: marginTop, x2: gx, y2: H - marginBot, stroke: '#e5e7eb', 'stroke-width': 1 }));\n    const lbl = document.createElementNS('http://www.w3.org/2000/svg', 'text');\n    lbl.setAttribute('x', gx); lbl.setAttribute('y', H - marginBot + 14);\n    lbl.setAttribute('text-anchor', 'middle'); lbl.setAttribute('font-size', '9');\n    lbl.setAttribute('fill', '#9ca3af');\n    lbl.textContent = pct(gv, 1);\n    svg.appendChild(lbl);\n  }\n\n  // Bars\n  function drawBar(y, val, color, label, rate) {\n    const w = Math.max(scale(val), 2);\n    // Bar\n    svg.appendChild(ns('rect', { x: marginL, y, width: w, height: barHeight, fill: color, rx: 4, opacity: 0.85 }));\n    // Label left\n    const lbl = document.createElementNS('http://www.w3.org/2000/svg', 'text');\n    lbl.setAttribute('x', marginL - 8); lbl.setAttribute('y', y + barHeight / 2 + 4);\n    lbl.setAttribute('text-anchor', 'end'); lbl.setAttribute('font-size', '12');\n    lbl.setAttribute('font-weight', '600'); lbl.setAttribute('fill', '#374151');\n    lbl.textContent = label;\n    svg.appendChild(lbl);\n    // Rate label inside/right of bar\n    const rlbl = document.createElementNS('http://www.w3.org/2000/svg', 'text');\n    const tx = marginL + w + 6;\n    rlbl.setAttribute('x', tx); rlbl.setAttribute('y', y + barHeight / 2 + 4);\n    rlbl.setAttribute('text-anchor', 'start'); rlbl.setAttribute('font-size', '11');\n    rlbl.setAttribute('font-weight', '700'); rlbl.setAttribute('fill', color);\n    rlbl.textContent = rate;\n    svg.appendChild(rlbl);\n  }\n\n  drawBar(yA, pA, '#60a5fa', 'A', pct(pA));\n  drawBar(yB, pB, '#6366f1', 'B', pct(pB));\n\n  // CI whisker for B (difference from A, visualized as marker on B bar)\n  // We show CI as whiskers on the B bar, centered at pB\n  const ciCenterX = marginL + scale(pB);\n  const ciLoX = marginL + scale(Math.max(pB + ciLo - (pB - pA + ciLo - ciLo), pB + (ciLo))) ;\n  // Actually: ciLo and ciHi are for the DIFFERENCE (pB - pA).\n  // pB's CI in absolute terms: pB + (ciLo - diff) = pA + ciLo ... no.\n  // CI is for (pB - pA): [ciLo, ciHi]. So pB point est ± se*z.\n  // Whisker endpoints in rate space: pA + ciLo to pA + ciHi — that's the CI for pB given pA=fixed.\n  // Better: just show whisker centered at pB, half-width = (ciHi - ciLo)/2\n  const halfCI = (ciHi - ciLo) / 2;\n  const wxLo = Math.max(marginL, marginL + scale(pB - halfCI));\n  const wxHi = Math.min(marginL + chartW, marginL + scale(pB + halfCI));\n  const wyMid = yB + barHeight / 2;\n  const capH = 8;\n\n  // Whisker line\n  svg.appendChild(ns('line', { x1: wxLo, y1: wyMid, x2: wxHi, y2: wyMid, stroke: '#c7d2fe', 'stroke-width': 2.5 }));\n  // Caps\n  svg.appendChild(ns('line', { x1: wxLo, y1: wyMid - capH/2, x2: wxLo, y2: wyMid + capH/2, stroke: '#818cf8', 'stroke-width': 2 }));\n  svg.appendChild(ns('line', { x1: wxHi, y1: wyMid - capH/2, x2: wxHi, y2: wyMid + capH/2, stroke: '#818cf8', 'stroke-width': 2 }));\n  // Center dot\n  svg.appendChild(ns('circle', { cx: ciCenterX, cy: wyMid, r: 4, fill: '#4338ca' }));\n}\n\n// ─── Main calculation ────────────────────────────────────────────────────────\n\nfunction calculate() {\n  const nA = parseInt(fields.vA().value, 10);\n  const cA = parseInt(fields.cA().value, 10);\n  const nB = parseInt(fields.vB().value, 10);\n  const cB = parseInt(fields.cB().value, 10);\n  const threshold = parseFloat(fields.threshold().value);\n  const thresholdPct = Math.round(threshold * 100);\n\n  const errBanner = out('errorBanner');\n  const errText = out('errorText');\n\n  // Validation\n  const errors = [];\n  if (!nA || nA < 1) errors.push('Variant A visitors must be at least 1.');\n  if (!nB || nB < 1) errors.push('Variant B visitors must be at least 1.');\n  if (isNaN(cA) || cA < 0) errors.push('Variant A conversions must be 0 or more.');\n  if (isNaN(cB) || cB < 0) errors.push('Variant B conversions must be 0 or more.');\n  if (cA > nA) errors.push('Variant A conversions cannot exceed visitors.');\n  if (cB > nB) errors.push('Variant B conversions cannot exceed visitors.');\n\n  if (errors.length > 0) {\n    errText.textContent = errors[0];\n    errBanner.classList.remove('hidden');\n    out('resultsSection').classList.add('opacity-30', 'pointer-events-none');\n    return;\n  }\n  errBanner.classList.add('hidden');\n  out('resultsSection').classList.remove('opacity-30', 'pointer-events-none');\n\n  const pA = cA / nA;\n  const pB = cB / nB;\n\n  // Rates\n  out('rateA').textContent = pct(pA);\n  out('rateB').textContent = pct(pB);\n\n  // Uplift\n  const absUp = pB - pA;\n  const relUp = pA !== 0 ? absUp / pA : 0;\n  const upColor = absUp > 0 ? 'text-green-600' : absUp < 0 ? 'text-red-500' : 'text-gray-700';\n  out('absUplift').className = 'text-2xl font-bold ' + upColor;\n  out('absUplift').textContent = fmtDiff(absUp);\n  out('relUplift').className = 'text-2xl font-bold ' + upColor;\n  out('relUplift').textContent = fmtRel(relUp);\n\n  // Z-score\n  const z = twoProportionZ(nA, cA, nB, cB);\n  const p = twoTailP(z);\n  const confLvl = 1 - p;\n\n  out('zScore').textContent = z.toFixed(4);\n  out('pValue').textContent = p < 0.0001 ? '< 0.0001' : p.toFixed(4);\n  out('confLevel').textContent = pct(confLvl, 1);\n\n  // CI for difference (using 95% CI always for the displayed interval)\n  const ci = diffCI(nA, cA, nB, cB, 0.95);\n  out('ciText').textContent = `[${fmtDiff(ci.lo)}, ${fmtDiff(ci.hi)}]`;\n\n  // Verdict\n  const significant = confLvl >= threshold;\n  const verdictBadge = out('verdictBadge');\n  const verdictText = out('verdictText');\n  const verdictSub = out('verdictSub');\n\n  verdictBadge.className = 'flex-shrink-0 px-5 py-3 rounded-xl font-bold text-base text-center min-w-[160px] ' +\n    (significant ? 'badge-sig' : 'badge-not');\n\n  if (significant) {\n    verdictBadge.textContent = `Significant at ${thresholdPct}%`;\n    if (absUp > 0) {\n      verdictText.textContent = `Variant B outperforms Variant A by ${fmtDiff(absUp)} (${fmtRel(relUp)})`;\n      verdictSub.textContent = `You can be ${pct(confLvl, 1)} confident this difference is real. p = ${p < 0.0001 ? '< 0.0001' : p.toFixed(4)}`;\n    } else if (absUp < 0) {\n      verdictText.textContent = `Variant A outperforms Variant B by ${fmtDiff(-absUp)} (${fmtRel(-relUp)})`;\n      verdictSub.textContent = `Variant B performs worse. Confidence: ${pct(confLvl, 1)}. p = ${p < 0.0001 ? '< 0.0001' : p.toFixed(4)}`;\n    } else {\n      verdictText.textContent = 'No difference detected between variants.';\n      verdictSub.textContent = `Conversion rates are identical.`;\n    }\n  } else {\n    verdictBadge.textContent = 'Not Yet Significant';\n    verdictText.textContent = `Results are inconclusive at the ${thresholdPct}% threshold.`;\n    verdictSub.textContent = `Current confidence: ${pct(confLvl, 1)}. p = ${p.toFixed(4)}. Collect more data before deciding.`;\n  }\n\n  // Persist to localStorage\n  try {\n    localStorage.setItem('abcalc', JSON.stringify({ nA, cA, nB, cB, threshold }));\n  } catch(e) { /* ignore */ }\n\n  // Draw chart\n  drawChart(pA, pB, ci.lo, ci.hi);\n}\n\n// ─── Event listeners ─────────────────────────────────────────────────────────\n\n['visitorsA', 'conversionsA', 'visitorsB', 'conversionsB', 'sigThreshold'].forEach(id => {\n  document.getElementById(id).addEventListener('input', calculate);\n});\n\n// ─── Load from localStorage ───────────────────────────────────────────────────\n\n(function restoreOrInit() {\n  try {\n    const saved = JSON.parse(localStorage.getItem('abcalc'));\n    if (saved) {\n      fields.vA().value = saved.nA;\n      fields.cA().value = saved.cA;\n      fields.vB().value = saved.nB;\n      fields.cB().value = saved.cB;\n      fields.threshold().value = saved.threshold || 0.95;\n    }\n  } catch(e) { /* ignore */ }\n  calculate();\n})();\n</script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "A/B Test Calculator",
    "windowTitle": "A/B Test Calculator",
    "bundleId": "com.halisonworks.abtestcalculator",
    "iconPath": null
  },
