{
  "schema": "app-studio/canvas@1",
  "id": "example-commission-calculator",
  "name": "commission-calculator.html",
  "code": "<!DOCTYPE html>\n<!--\n  Commission Calculator — Halison App Studio example\n\n  Model tiered sales commissions with quotas and accelerators: total payout,\n  effective rate, a per-tier breakdown, and a what-if slider. Saves locally.\n\n  From the Halison App Studio public library:\n  https://github.com/halisonworks/public-app-studio\n\n  Permitted use: personal, educational, and other non-commercial use. You may\n  modify it, but keep this header and the source link intact, and do not sell,\n  commercialize, or republish it. Released under the Halison App Studio Examples\n  License — see the LICENSE file in the repository above.\n-->\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Commission Calculator</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <script>\n    tailwind.config = {\n      theme: {\n        extend: {\n          colors: {\n            brand: {\n              50:  '#f0f9ff',\n              100: '#e0f2fe',\n              200: '#bae6fd',\n              300: '#7dd3fc',\n              400: '#38bdf8',\n              500: '#0ea5e9',\n              600: '#0284c7',\n              700: '#0369a1',\n              800: '#075985',\n              900: '#0c4a6e',\n            }\n          }\n        }\n      }\n    }\n  </script>\n  <style>\n    /* Custom range input styling */\n    input[type=\"range\"] {\n      -webkit-appearance: none;\n      appearance: none;\n      height: 6px;\n      border-radius: 9999px;\n      background: #e2e8f0;\n      outline: none;\n      cursor: pointer;\n    }\n    input[type=\"range\"]::-webkit-slider-thumb {\n      -webkit-appearance: none;\n      appearance: none;\n      width: 20px;\n      height: 20px;\n      border-radius: 50%;\n      background: #0284c7;\n      cursor: pointer;\n      border: 2px solid white;\n      box-shadow: 0 1px 4px rgba(0,0,0,0.25);\n      transition: background 0.15s;\n    }\n    input[type=\"range\"]::-webkit-slider-thumb:hover {\n      background: #0369a1;\n    }\n    input[type=\"range\"]::-moz-range-thumb {\n      width: 20px;\n      height: 20px;\n      border-radius: 50%;\n      background: #0284c7;\n      cursor: pointer;\n      border: 2px solid white;\n      box-shadow: 0 1px 4px rgba(0,0,0,0.25);\n    }\n    .tier-row { transition: background 0.15s; }\n    .tier-row:hover { background: #f8fafc; }\n    .number-input::-webkit-inner-spin-button,\n    .number-input::-webkit-outer-spin-button { opacity: 1; }\n    .fade-in { animation: fadeIn 0.2s ease-in; }\n    @keyframes fadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }\n    .svg-line { fill: none; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }\n    .tooltip-box {\n      position: absolute;\n      pointer-events: none;\n      background: rgba(15,23,42,0.92);\n      color: #f1f5f9;\n      font-size: 12px;\n      border-radius: 6px;\n      padding: 6px 10px;\n      white-space: nowrap;\n      box-shadow: 0 2px 8px rgba(0,0,0,0.25);\n      z-index: 10;\n      transition: opacity 0.1s;\n    }\n  </style>\n</head>\n<body class=\"bg-slate-50 min-h-screen text-slate-800 font-sans\">\n\n<!-- ═══════════════════════════════════════════ HEADER ═══════════════════════════════════════════ -->\n<header class=\"bg-brand-700 text-white shadow-md\">\n  <div class=\"max-w-5xl mx-auto px-4 py-4 flex items-center justify-between flex-wrap gap-2\">\n    <div>\n      <h1 class=\"text-xl font-bold tracking-tight\">Commission Calculator</h1>\n      <p class=\"text-brand-200 text-sm mt-0.5\">Tiered quotas, accelerators &amp; live what-if analysis</p>\n    </div>\n    <div class=\"flex items-center gap-3\">\n      <button id=\"btnMode\" class=\"text-sm bg-brand-600 hover:bg-brand-500 px-3 py-1.5 rounded-lg border border-brand-400 transition font-medium\"></button>\n      <button id=\"btnReset\" class=\"text-sm bg-white/10 hover:bg-white/20 px-3 py-1.5 rounded-lg border border-white/20 transition\">Reset Defaults</button>\n    </div>\n  </div>\n</header>\n\n<!-- ═══════════════════════════════════════════ MAIN ════════════════════════════════════════════ -->\n<main class=\"max-w-5xl mx-auto px-4 py-8 space-y-6\">\n\n  <!-- ── Row 1: Config panels ── -->\n  <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n\n    <!-- Sales Input & Quota -->\n    <section class=\"bg-white rounded-2xl shadow-sm border border-slate-100 p-5 space-y-4\">\n      <h2 class=\"font-semibold text-slate-700 text-base flex items-center gap-2\">\n        <span class=\"inline-block w-2 h-2 rounded-full bg-brand-500\"></span>\n        Sales &amp; Quota\n      </h2>\n      <div class=\"space-y-3\">\n        <div>\n          <label class=\"block text-sm font-medium text-slate-600 mb-1\">Annual Quota ($)</label>\n          <input id=\"inputQuota\" type=\"number\" min=\"0\" step=\"1000\"\n            class=\"number-input w-full border border-slate-200 rounded-lg px-3 py-2 text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-400 text-sm\" />\n        </div>\n        <div>\n          <label class=\"block text-sm font-medium text-slate-600 mb-1\">Base Salary ($) <span class=\"text-slate-400 font-normal\">(optional, for context)</span></label>\n          <input id=\"inputSalary\" type=\"number\" min=\"0\" step=\"1000\"\n            class=\"number-input w-full border border-slate-200 rounded-lg px-3 py-2 text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-400 text-sm\" />\n        </div>\n        <div>\n          <label class=\"block text-sm font-medium text-slate-600 mb-1\" id=\"labelSales\">Sales / Attainment ($)</label>\n          <input id=\"inputSales\" type=\"number\" min=\"0\" step=\"1000\"\n            class=\"number-input w-full border border-slate-200 rounded-lg px-3 py-2 text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-400 text-sm\" />\n        </div>\n\n        <!-- What-if slider -->\n        <div class=\"pt-1\">\n          <div class=\"flex justify-between text-xs text-slate-500 mb-1\">\n            <span>What-if slider</span>\n            <span id=\"sliderPct\" class=\"font-semibold text-brand-600\"></span>\n          </div>\n          <input id=\"sliderSales\" type=\"range\" min=\"0\" step=\"1000\"\n            class=\"w-full\" />\n          <div class=\"flex justify-between text-xs text-slate-400 mt-1\">\n            <span>$0</span>\n            <span id=\"sliderMax\" class=\"text-right\"></span>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- Commission Mode -->\n    <section class=\"bg-white rounded-2xl shadow-sm border border-slate-100 p-5 space-y-4\">\n      <h2 class=\"font-semibold text-slate-700 text-base flex items-center gap-2\">\n        <span class=\"inline-block w-2 h-2 rounded-full bg-emerald-500\"></span>\n        Commission Structure\n      </h2>\n\n      <!-- Flat mode -->\n      <div id=\"panelFlat\" class=\"space-y-3\">\n        <p class=\"text-sm text-slate-500\">A single percentage applied to all sales regardless of quota.</p>\n        <div>\n          <label class=\"block text-sm font-medium text-slate-600 mb-1\">Flat Commission Rate (%)</label>\n          <input id=\"inputFlatRate\" type=\"number\" min=\"0\" max=\"100\" step=\"0.1\"\n            class=\"number-input w-full border border-slate-200 rounded-lg px-3 py-2 text-slate-800 focus:outline-none focus:ring-2 focus:ring-brand-400 text-sm\" />\n        </div>\n      </div>\n\n      <!-- Tiered mode -->\n      <div id=\"panelTiered\" class=\"space-y-3 hidden\">\n        <p class=\"text-sm text-slate-500\">Each tier is defined as a % of quota. Commission rate applies only to sales within that band.</p>\n\n        <div id=\"tiersContainer\" class=\"space-y-2\"></div>\n\n        <button id=\"btnAddTier\"\n          class=\"w-full text-sm border border-dashed border-brand-300 text-brand-600 hover:bg-brand-50 rounded-lg py-2 transition font-medium\">\n          + Add Tier\n        </button>\n\n        <p class=\"text-xs text-slate-400\">Drag-to-reorder not required — tiers are sorted by threshold automatically.</p>\n      </div>\n    </section>\n  </div>\n\n  <!-- ── Row 2: Results ── -->\n  <div class=\"grid grid-cols-1 sm:grid-cols-3 gap-4 fade-in\" id=\"resultsRow\">\n    <div class=\"bg-white rounded-2xl shadow-sm border border-slate-100 p-5 text-center\">\n      <p class=\"text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1\">Total Commission</p>\n      <p id=\"resTotal\" class=\"text-3xl font-bold text-brand-700\">$0</p>\n      <p id=\"resTotalSub\" class=\"text-xs text-slate-400 mt-1\"></p>\n    </div>\n    <div class=\"bg-white rounded-2xl shadow-sm border border-slate-100 p-5 text-center\">\n      <p class=\"text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1\">Effective Rate</p>\n      <p id=\"resRate\" class=\"text-3xl font-bold text-emerald-600\">0.00%</p>\n      <p class=\"text-xs text-slate-400 mt-1\">Commission / Sales</p>\n    </div>\n    <div class=\"bg-white rounded-2xl shadow-sm border border-slate-100 p-5 text-center\">\n      <p class=\"text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1\">Attainment</p>\n      <p id=\"resAttainment\" class=\"text-3xl font-bold text-violet-600\">0%</p>\n      <p id=\"resAttainmentSub\" class=\"text-xs text-slate-400 mt-1\">of quota</p>\n    </div>\n  </div>\n\n  <!-- ── Row 3: Breakdown + Chart ── -->\n  <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n\n    <!-- Tier breakdown table -->\n    <section class=\"bg-white rounded-2xl shadow-sm border border-slate-100 p-5\">\n      <h2 class=\"font-semibold text-slate-700 text-base mb-4 flex items-center gap-2\">\n        <span class=\"inline-block w-2 h-2 rounded-full bg-violet-500\"></span>\n        Per-Tier Breakdown\n      </h2>\n      <div class=\"overflow-x-auto\">\n        <table class=\"w-full text-sm\">\n          <thead>\n            <tr class=\"border-b border-slate-100 text-left text-xs font-semibold text-slate-400 uppercase tracking-wider\">\n              <th class=\"pb-2 pr-3\">Tier</th>\n              <th class=\"pb-2 pr-3\">Range</th>\n              <th class=\"pb-2 pr-3\">Rate</th>\n              <th class=\"pb-2 pr-3\">Sales in Tier</th>\n              <th class=\"pb-2\">Commission</th>\n            </tr>\n          </thead>\n          <tbody id=\"breakdownBody\"></tbody>\n          <tfoot id=\"breakdownFoot\"></tfoot>\n        </table>\n      </div>\n    </section>\n\n    <!-- SVG Chart -->\n    <section class=\"bg-white rounded-2xl shadow-sm border border-slate-100 p-5\">\n      <h2 class=\"font-semibold text-slate-700 text-base mb-4 flex items-center gap-2\">\n        <span class=\"inline-block w-2 h-2 rounded-full bg-amber-500\"></span>\n        Commission vs. Sales\n      </h2>\n      <div class=\"relative\" id=\"chartWrap\">\n        <svg id=\"commChart\" width=\"100%\" viewBox=\"0 0 440 220\" xmlns=\"http://www.w3.org/2000/svg\"\n          class=\"w-full overflow-visible\" style=\"touch-action:none;\">\n          <defs>\n            <linearGradient id=\"areaGrad\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n              <stop offset=\"0%\" stop-color=\"#0ea5e9\" stop-opacity=\"0.18\"/>\n              <stop offset=\"100%\" stop-color=\"#0ea5e9\" stop-opacity=\"0.01\"/>\n            </linearGradient>\n          </defs>\n          <g id=\"chartGrid\"></g>\n          <g id=\"chartAxes\"></g>\n          <path id=\"chartArea\" fill=\"url(#areaGrad)\" />\n          <path id=\"chartLine\" class=\"svg-line\" stroke=\"#0284c7\" />\n          <line id=\"chartMarker\" stroke=\"#0284c7\" stroke-width=\"1.5\" stroke-dasharray=\"4,3\" opacity=\"0.7\" />\n          <circle id=\"chartDot\" r=\"5\" fill=\"#0284c7\" stroke=\"white\" stroke-width=\"2\" />\n          <g id=\"chartKinks\"></g>\n        </svg>\n        <div id=\"chartTooltip\" class=\"tooltip-box opacity-0\" style=\"left:0;top:0;\"></div>\n      </div>\n      <p class=\"text-xs text-slate-400 mt-2 text-center\">Hover or tap the chart to explore values. Kink points mark tier changes.</p>\n    </section>\n  </div>\n\n</main>\n\n<!-- ═══════════════════════════════════════════ FOOTER ══════════════════════════════════════════ -->\n<footer class=\"text-center text-xs text-slate-400 py-6 border-t border-slate-100 mt-4\">\n  Commission Calculator · Halison App Studio ·\n  <a href=\"https://github.com/halisonworks/public-app-studio\" target=\"_blank\" class=\"underline hover:text-brand-600\">Source</a>\n  · Personal &amp; educational use only\n</footer>\n\n<!-- ═══════════════════════════════════════════ SCRIPT ══════════════════════════════════════════ -->\n<script>\n(function () {\n  'use strict';\n\n  /* ─────────────── DEFAULTS ─────────────── */\n  const DEFAULTS = {\n    mode: 'tiered',           // 'tiered' | 'flat'\n    quota: 500000,\n    salary: 80000,\n    sales: 425000,\n    flatRate: 5,\n    tiers: [\n      { label: 'Below Quota',     upTo: 100,  rate: 8   },\n      { label: 'Accelerator 1',   upTo: 150,  rate: 12  },\n      { label: 'Accelerator 2',   upTo: 200,  rate: 16  },\n      { label: 'Overachievement', upTo: null, rate: 20  },\n    ]\n  };\n\n  /* ─────────────── STATE ─────────────── */\n  let state = loadState();\n\n  /* ─────────────── ELEMENTS ─────────────── */\n  const $ = id => document.getElementById(id);\n  const inputQuota     = $('inputQuota');\n  const inputSalary    = $('inputSalary');\n  const inputSales     = $('inputSales');\n  const inputFlatRate  = $('inputFlatRate');\n  const sliderSales    = $('sliderSales');\n  const sliderPct      = $('sliderPct');\n  const sliderMax      = $('sliderMax');\n  const btnMode        = $('btnMode');\n  const btnReset       = $('btnReset');\n  const btnAddTier     = $('btnAddTier');\n  const panelFlat      = $('panelFlat');\n  const panelTiered    = $('panelTiered');\n  const tiersContainer = $('tiersContainer');\n  const resTotal       = $('resTotal');\n  const resTotalSub    = $('resTotalSub');\n  const resRate        = $('resRate');\n  const resAttainment  = $('resAttainment');\n  const resAttainmentSub= $('resAttainmentSub');\n  const breakdownBody  = $('breakdownBody');\n  const breakdownFoot  = $('breakdownFoot');\n  const commChart      = $('commChart');\n  const chartLine      = $('chartLine');\n  const chartArea      = $('chartArea');\n  const chartGrid      = $('chartGrid');\n  const chartAxes      = $('chartAxes');\n  const chartMarker    = $('chartMarker');\n  const chartDot       = $('chartDot');\n  const chartKinks     = $('chartKinks');\n  const chartTooltip   = $('chartTooltip');\n  const chartWrap      = $('chartWrap');\n\n  /* ─────────────── PERSISTENCE ─────────────── */\n  function loadState() {\n    try {\n      const raw = localStorage.getItem('commCalcState');\n      if (raw) {\n        const parsed = JSON.parse(raw);\n        // Merge with defaults to handle added fields\n        return Object.assign({}, DEFAULTS, parsed, {\n          tiers: Array.isArray(parsed.tiers) && parsed.tiers.length ? parsed.tiers : DEFAULTS.tiers\n        });\n      }\n    } catch(e) {}\n    return Object.assign({}, DEFAULTS, { tiers: DEFAULTS.tiers.map(t => Object.assign({}, t)) });\n  }\n\n  function saveState() {\n    try { localStorage.setItem('commCalcState', JSON.stringify(state)); } catch(e) {}\n  }\n\n  /* ─────────────── FORMATTING ─────────────── */\n  const fmtUSD = (n, decimals=0) => new Intl.NumberFormat('en-US', {\n    style: 'currency', currency: 'USD', minimumFractionDigits: decimals, maximumFractionDigits: decimals\n  }).format(n);\n\n  const fmtNum = (n, d=0) => new Intl.NumberFormat('en-US', {\n    minimumFractionDigits: d, maximumFractionDigits: d\n  }).format(n);\n\n  /* ─────────────── COMMISSION MATH ─────────────── */\n  function calcCommission(sales, quota, tiers, mode, flatRate) {\n    if (mode === 'flat') {\n      const comm = sales * (flatRate / 100);\n      return {\n        total: comm,\n        breakdown: [{ label: 'Flat Rate', range: 'All sales', rate: flatRate, salesInTier: sales, commission: comm }]\n      };\n    }\n\n    // Sort tiers by upTo ascending (null = Infinity)\n    const sorted = tiers.slice().sort((a, b) => {\n      const aU = a.upTo === null ? Infinity : a.upTo;\n      const bU = b.upTo === null ? Infinity : b.upTo;\n      return aU - bU;\n    });\n\n    let remaining = sales;\n    let prevThreshold = 0; // in $ (absolute)\n    let total = 0;\n    const breakdown = [];\n\n    for (let i = 0; i < sorted.length; i++) {\n      const tier = sorted[i];\n      const tierUpTo  = tier.upTo === null ? Infinity : tier.upTo;\n      const tierStart = prevThreshold;                  // $ absolute\n      const tierEnd   = tierUpTo === Infinity ? Infinity : (quota * tierUpTo / 100);\n\n      if (sales <= tierStart) break; // no sales reach this tier\n\n      const salesInThisTier = Math.min(sales, tierEnd === Infinity ? sales : tierEnd) - tierStart;\n      const clipped = Math.max(0, salesInThisTier);\n      const comm = clipped * (tier.rate / 100);\n      total += comm;\n\n      const rangeLabel = tierUpTo === Infinity\n        ? `> ${fmtNum(tierStart > 0 ? (tierStart/quota*100) : 0, 0)}% of quota`\n        : `${fmtNum(tierStart/quota*100, 0)}% – ${tier.upTo}% of quota`;\n\n      breakdown.push({\n        label: tier.label || `Tier ${i+1}`,\n        range: rangeLabel,\n        rate: tier.rate,\n        salesInTier: clipped,\n        commission: comm\n      });\n\n      prevThreshold = tierEnd === Infinity ? sales : tierEnd;\n      if (prevThreshold >= sales) break;\n    }\n\n    return { total, breakdown };\n  }\n\n  /* Build an array of {x, y} commission curve points for the chart */\n  function buildCurvePoints(quota, tiers, mode, flatRate) {\n    const maxSales = quota * 2.5;\n    const steps = 300;\n    const points = [];\n    for (let i = 0; i <= steps; i++) {\n      const s = (i / steps) * maxSales;\n      const { total } = calcCommission(s, quota, tiers, mode, flatRate);\n      points.push({ x: s, y: total });\n    }\n    return points;\n  }\n\n  /* ─────────────── UI: RENDER TIERS ─────────────── */\n  function renderTiers() {\n    tiersContainer.innerHTML = '';\n    state.tiers.forEach((tier, idx) => {\n      const isLast = idx === state.tiers.length - 1;\n      const row = document.createElement('div');\n      row.className = 'tier-row flex items-center gap-2 bg-slate-50 rounded-xl px-3 py-2 border border-slate-100';\n      row.dataset.idx = idx;\n      row.innerHTML = `\n        <div class=\"flex-1 min-w-0\">\n          <input type=\"text\" value=\"${escHtml(tier.label)}\" placeholder=\"Tier name\"\n            class=\"w-full text-xs font-medium text-slate-700 bg-transparent border-none outline-none focus:ring-0 truncate\"\n            data-field=\"label\" data-idx=\"${idx}\" />\n        </div>\n        <div class=\"flex items-center gap-1 text-xs text-slate-500 whitespace-nowrap\">\n          <span>0 –</span>\n          <input type=\"number\" min=\"0\" max=\"9999\" step=\"5\"\n            value=\"${tier.upTo !== null ? tier.upTo : ''}\"\n            placeholder=\"∞\"\n            title=\"Upper % of quota (leave empty for unlimited)\"\n            class=\"number-input w-14 text-center border border-slate-200 rounded-md px-1.5 py-1 text-xs focus:outline-none focus:ring-1 focus:ring-brand-400 bg-white\"\n            data-field=\"upTo\" data-idx=\"${idx}\" />\n          <span>% quota</span>\n        </div>\n        <div class=\"flex items-center gap-1 whitespace-nowrap\">\n          <input type=\"number\" min=\"0\" max=\"100\" step=\"0.5\"\n            value=\"${tier.rate}\"\n            class=\"number-input w-14 text-center border border-slate-200 rounded-md px-1.5 py-1 text-xs focus:outline-none focus:ring-1 focus:ring-brand-400 bg-white\"\n            data-field=\"rate\" data-idx=\"${idx}\" />\n          <span class=\"text-xs text-slate-500\">%</span>\n        </div>\n        <button class=\"flex-shrink-0 text-slate-300 hover:text-red-400 transition text-lg leading-none px-1\"\n          data-action=\"delete\" data-idx=\"${idx}\" title=\"Remove tier\">×</button>\n      `;\n      tiersContainer.appendChild(row);\n    });\n\n    // Events for tier fields\n    tiersContainer.querySelectorAll('input').forEach(inp => {\n      inp.addEventListener('input', onTierFieldChange);\n    });\n    tiersContainer.querySelectorAll('[data-action=\"delete\"]').forEach(btn => {\n      btn.addEventListener('click', e => {\n        const idx = parseInt(e.currentTarget.dataset.idx);\n        if (state.tiers.length <= 1) return;\n        state.tiers.splice(idx, 1);\n        saveState();\n        renderTiers();\n        compute();\n      });\n    });\n  }\n\n  function escHtml(str) {\n    return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;');\n  }\n\n  function onTierFieldChange(e) {\n    const idx   = parseInt(e.target.dataset.idx);\n    const field = e.target.dataset.field;\n    const raw   = e.target.value;\n    if (field === 'label') {\n      state.tiers[idx].label = raw;\n    } else if (field === 'upTo') {\n      state.tiers[idx].upTo = raw === '' ? null : parseFloat(raw);\n    } else if (field === 'rate') {\n      state.tiers[idx].rate = parseFloat(raw) || 0;\n    }\n    saveState();\n    compute();\n  }\n\n  /* ─────────────── UI: SYNC INPUTS FROM STATE ─────────────── */\n  function syncInputsFromState() {\n    inputQuota.value    = state.quota;\n    inputSalary.value   = state.salary;\n    inputSales.value    = state.sales;\n    inputFlatRate.value = state.flatRate;\n\n    const sliderMaxVal = Math.max(state.quota * 2.5, state.sales * 1.2);\n    sliderSales.max = sliderMaxVal;\n    sliderSales.value = state.sales;\n    sliderMax.textContent = fmtUSD(sliderMaxVal, 0);\n\n    updateModeUI();\n    renderTiers();\n  }\n\n  function updateModeUI() {\n    if (state.mode === 'flat') {\n      btnMode.textContent = 'Switch to Tiered Mode';\n      panelFlat.classList.remove('hidden');\n      panelTiered.classList.add('hidden');\n    } else {\n      btnMode.textContent = 'Switch to Flat Rate Mode';\n      panelFlat.classList.add('hidden');\n      panelTiered.classList.remove('hidden');\n    }\n  }\n\n  /* ─────────────── COMPUTE & RENDER RESULTS ─────────────── */\n  function compute() {\n    const sales    = parseFloat(inputSales.value)    || 0;\n    const quota    = parseFloat(inputQuota.value)    || 1;\n    const salary   = parseFloat(inputSalary.value)   || 0;\n    const flatRate = parseFloat(inputFlatRate.value) || 0;\n\n    const { total, breakdown } = calcCommission(sales, quota, state.tiers, state.mode, flatRate);\n\n    const effectiveRate = sales > 0 ? (total / sales * 100) : 0;\n    const attainment    = quota > 0 ? (sales / quota * 100) : 0;\n\n    // Summary cards\n    resTotal.textContent = fmtUSD(total);\n    resTotalSub.textContent = salary > 0\n      ? `+ ${fmtUSD(salary)} base = ${fmtUSD(total + salary)} OTE`\n      : 'Total earned commission';\n    resRate.textContent     = effectiveRate.toFixed(2) + '%';\n    resAttainment.textContent = fmtNum(attainment, 1) + '%';\n    resAttainmentSub.textContent = quota > 0 ? `of ${fmtUSD(quota, 0)} quota` : 'of quota';\n\n    // Color attainment\n    if (attainment >= 100) resAttainment.className = 'text-3xl font-bold text-emerald-600';\n    else if (attainment >= 75) resAttainment.className = 'text-3xl font-bold text-amber-500';\n    else resAttainment.className = 'text-3xl font-bold text-red-500';\n\n    // Slider label\n    sliderPct.textContent = fmtNum(attainment, 1) + '% of quota';\n\n    // Breakdown table\n    let bodyHtml = '';\n    breakdown.forEach((row, i) => {\n      const tierColors = ['bg-brand-50 text-brand-700','bg-emerald-50 text-emerald-700','bg-violet-50 text-violet-700','bg-amber-50 text-amber-700','bg-rose-50 text-rose-700'];\n      const colorClass = tierColors[i % tierColors.length];\n      bodyHtml += `<tr class=\"tier-row border-b border-slate-50\">\n        <td class=\"py-2 pr-3\">\n          <span class=\"inline-block text-xs px-2 py-0.5 rounded-full font-semibold ${colorClass}\">${escHtml(row.label)}</span>\n        </td>\n        <td class=\"py-2 pr-3 text-xs text-slate-500 whitespace-nowrap\">${escHtml(row.range)}</td>\n        <td class=\"py-2 pr-3 text-xs font-semibold text-slate-700 whitespace-nowrap\">${row.rate.toFixed(1)}%</td>\n        <td class=\"py-2 pr-3 text-xs text-slate-600 whitespace-nowrap\">${fmtUSD(row.salesInTier)}</td>\n        <td class=\"py-2 text-xs font-semibold text-brand-700 whitespace-nowrap\">${fmtUSD(row.commission)}</td>\n      </tr>`;\n    });\n    breakdownBody.innerHTML = bodyHtml;\n    breakdownFoot.innerHTML = `<tr class=\"border-t-2 border-slate-200\">\n      <td colspan=\"4\" class=\"pt-2 text-xs font-bold text-slate-600 uppercase tracking-wider\">Total</td>\n      <td class=\"pt-2 text-sm font-bold text-brand-700\">${fmtUSD(total)}</td>\n    </tr>`;\n\n    // Update slider sync\n    const sliderMaxVal = Math.max(quota * 2.5, sales * 1.2, 10000);\n    sliderSales.max = sliderMaxVal;\n    sliderMax.textContent = fmtUSD(sliderMaxVal, 0);\n\n    // Chart\n    drawChart(sales, quota, state.tiers, state.mode, flatRate, total);\n  }\n\n  /* ─────────────── CHART ─────────────── */\n  const CHART_PAD = { top: 16, right: 24, bottom: 36, left: 52 };\n  const CHART_W = 440;\n  const CHART_H = 220;\n  const INNER_W = CHART_W - CHART_PAD.left - CHART_PAD.right;\n  const INNER_H = CHART_H - CHART_PAD.top  - CHART_PAD.bottom;\n\n  function makeSVGEl(tag, attrs) {\n    const el = document.createElementNS('http://www.w3.org/2000/svg', tag);\n    Object.entries(attrs).forEach(([k,v]) => el.setAttribute(k, v));\n    return el;\n  }\n\n  function drawChart(currentSales, quota, tiers, mode, flatRate, currentComm) {\n    const maxSales = Math.max(quota * 2.5, currentSales * 1.1, 10000);\n    const points   = buildCurvePoints(quota, tiers, mode, flatRate);\n    const maxComm  = Math.max(...points.map(p => p.y), 1);\n\n    const toSVG = (s, c) => ({\n      cx: CHART_PAD.left + (s / maxSales) * INNER_W,\n      cy: CHART_PAD.top  + INNER_H - (c / maxComm) * INNER_H\n    });\n\n    // Grid\n    chartGrid.innerHTML = '';\n    const yLines = 5;\n    for (let i = 0; i <= yLines; i++) {\n      const cy = CHART_PAD.top + (i / yLines) * INNER_H;\n      const val = maxComm * (1 - i / yLines);\n      const line = makeSVGEl('line', { x1: CHART_PAD.left, y1: cy, x2: CHART_PAD.left + INNER_W, y2: cy, stroke: '#e2e8f0', 'stroke-width': '1' });\n      chartGrid.appendChild(line);\n      const lbl = makeSVGEl('text', { x: CHART_PAD.left - 6, y: cy + 4, 'text-anchor': 'end', 'font-size': '9', fill: '#94a3b8' });\n      lbl.textContent = fmtUSD(val, 0).replace('$', '$').replace(/,000$/, 'k').replace(/,000,/, 'M').replace(/000$/, 'k');\n      // simpler label\n      lbl.textContent = val >= 1000000 ? '$' + (val/1000000).toFixed(1) + 'M' : val >= 1000 ? '$' + (val/1000).toFixed(0) + 'k' : '$' + val.toFixed(0);\n      chartGrid.appendChild(lbl);\n    }\n    // X axis ticks\n    const xTicks = 5;\n    for (let i = 0; i <= xTicks; i++) {\n      const s = (i / xTicks) * maxSales;\n      const cx = CHART_PAD.left + (i / xTicks) * INNER_W;\n      const lbl = makeSVGEl('text', { x: cx, y: CHART_PAD.top + INNER_H + 16, 'text-anchor': 'middle', 'font-size': '9', fill: '#94a3b8' });\n      lbl.textContent = s >= 1000000 ? '$' + (s/1000000).toFixed(1) + 'M' : s >= 1000 ? '$' + (s/1000).toFixed(0) + 'k' : '$' + s.toFixed(0);\n      chartGrid.appendChild(lbl);\n    }\n\n    // X axis label\n    const xAxisLabel = makeSVGEl('text', { x: CHART_PAD.left + INNER_W/2, y: CHART_H - 2, 'text-anchor': 'middle', 'font-size': '9', fill: '#94a3b8' });\n    xAxisLabel.textContent = 'Sales Amount';\n    chartGrid.appendChild(xAxisLabel);\n\n    // Quota line\n    if (quota > 0 && quota <= maxSales) {\n      const qx = CHART_PAD.left + (quota / maxSales) * INNER_W;\n      const qline = makeSVGEl('line', { x1: qx, y1: CHART_PAD.top, x2: qx, y2: CHART_PAD.top + INNER_H, stroke: '#f59e0b', 'stroke-width': '1.5', 'stroke-dasharray': '4,3' });\n      chartGrid.appendChild(qline);\n      const qlbl = makeSVGEl('text', { x: qx + 3, y: CHART_PAD.top + 12, 'font-size': '8', fill: '#d97706' });\n      qlbl.textContent = '100% quota';\n      chartGrid.appendChild(qlbl);\n    }\n\n    // Line path\n    const pathD = points.map((p, i) => {\n      const { cx, cy } = toSVG(p.x, p.y);\n      return (i === 0 ? 'M' : 'L') + cx.toFixed(2) + ',' + cy.toFixed(2);\n    }).join(' ');\n    chartLine.setAttribute('d', pathD);\n\n    // Area path (close below)\n    const lastPt = toSVG(points[points.length-1].x, points[points.length-1].y);\n    const firstPt = toSVG(points[0].x, 0);\n    const areaD = pathD\n      + ` L${lastPt.cx.toFixed(2)},${(CHART_PAD.top + INNER_H).toFixed(2)}`\n      + ` L${firstPt.cx.toFixed(2)},${(CHART_PAD.top + INNER_H).toFixed(2)} Z`;\n    chartArea.setAttribute('d', areaD);\n\n    // Kink markers at tier boundaries\n    chartKinks.innerHTML = '';\n    if (mode === 'tiered' && quota > 0) {\n      const sorted = tiers.slice().sort((a, b) => {\n        const aU = a.upTo === null ? Infinity : a.upTo;\n        const bU = b.upTo === null ? Infinity : b.upTo;\n        return aU - bU;\n      });\n      sorted.forEach(tier => {\n        if (tier.upTo === null) return;\n        const kinkSales = quota * tier.upTo / 100;\n        if (kinkSales > maxSales) return;\n        const { total: kinkComm } = calcCommission(kinkSales, quota, tiers, mode, flatRate);\n        const { cx, cy } = toSVG(kinkSales, kinkComm);\n        const circle = makeSVGEl('circle', { cx, cy, r: 4, fill: '#f59e0b', stroke: 'white', 'stroke-width': '1.5' });\n        chartKinks.appendChild(circle);\n      });\n    }\n\n    // Current sales marker\n    if (currentSales > 0 && currentSales <= maxSales) {\n      const { cx, cy } = toSVG(currentSales, currentComm);\n      chartMarker.setAttribute('x1', cx); chartMarker.setAttribute('y1', CHART_PAD.top);\n      chartMarker.setAttribute('x2', cx); chartMarker.setAttribute('y2', CHART_PAD.top + INNER_H);\n      chartDot.setAttribute('cx', cx); chartDot.setAttribute('cy', cy);\n    } else {\n      chartMarker.setAttribute('x1', -99); chartMarker.setAttribute('x2', -99);\n      chartDot.setAttribute('cx', -99);\n    }\n  }\n\n  /* ─────────────── CHART HOVER ─────────────── */\n  function onChartPointerMove(e) {\n    const rect = commChart.getBoundingClientRect();\n    const svgScaleX = CHART_W / rect.width;\n    const svgX = (e.clientX - rect.left) * svgScaleX;\n    const dataX = (svgX - CHART_PAD.left) / INNER_W;\n    if (dataX < 0 || dataX > 1) { chartTooltip.style.opacity = '0'; return; }\n\n    const quota    = parseFloat(inputQuota.value)    || 1;\n    const flatRate = parseFloat(inputFlatRate.value) || 0;\n    const maxSales = Math.max(quota * 2.5, (parseFloat(inputSales.value)||0) * 1.1, 10000);\n    const s = dataX * maxSales;\n    const { total: c } = calcCommission(s, quota, state.tiers, state.mode, flatRate);\n    const rate = s > 0 ? (c/s*100) : 0;\n\n    chartTooltip.innerHTML = `<strong>${fmtUSD(s, 0)}</strong> → <strong>${fmtUSD(c, 0)}</strong><br><span style=\"opacity:0.75\">Rate: ${rate.toFixed(2)}%</span>`;\n\n    const tipLeft = e.clientX - rect.left + 12;\n    const tipTop  = e.clientY - rect.top  - 10;\n    chartTooltip.style.left    = tipLeft + 'px';\n    chartTooltip.style.top     = tipTop  + 'px';\n    chartTooltip.style.opacity = '1';\n  }\n\n  commChart.addEventListener('pointermove', onChartPointerMove);\n  commChart.addEventListener('pointerleave', () => { chartTooltip.style.opacity = '0'; });\n\n  /* ─────────────── EVENT HANDLERS ─────────────── */\n  function bindInputEvent(el, stateKey, parse) {\n    el.addEventListener('input', () => {\n      state[stateKey] = parse ? parse(el.value) : el.value;\n      saveState();\n      if (stateKey === 'quota' || stateKey === 'sales') {\n        const q = parseFloat(inputQuota.value) || 1;\n        const s = parseFloat(inputSales.value) || 0;\n        const sliderMaxVal = Math.max(q * 2.5, s * 1.2, 10000);\n        sliderSales.max = sliderMaxVal;\n        sliderMax.textContent = fmtUSD(sliderMaxVal, 0);\n        if (stateKey === 'sales') sliderSales.value = s;\n      }\n      compute();\n    });\n  }\n\n  bindInputEvent(inputQuota,    'quota',    v => parseFloat(v) || 0);\n  bindInputEvent(inputSalary,   'salary',   v => parseFloat(v) || 0);\n  bindInputEvent(inputSales,    'sales',    v => parseFloat(v) || 0);\n  bindInputEvent(inputFlatRate, 'flatRate', v => parseFloat(v) || 0);\n\n  sliderSales.addEventListener('input', () => {\n    const val = parseFloat(sliderSales.value) || 0;\n    inputSales.value = val;\n    state.sales = val;\n    saveState();\n    compute();\n  });\n\n  btnMode.addEventListener('click', () => {\n    state.mode = state.mode === 'flat' ? 'tiered' : 'flat';\n    saveState();\n    updateModeUI();\n    compute();\n  });\n\n  btnReset.addEventListener('click', () => {\n    if (!confirm('Reset all settings to defaults?')) return;\n    state = Object.assign({}, DEFAULTS, { tiers: DEFAULTS.tiers.map(t => Object.assign({}, t)) });\n    saveState();\n    syncInputsFromState();\n    compute();\n  });\n\n  btnAddTier.addEventListener('click', () => {\n    state.tiers.push({ label: 'New Tier', upTo: null, rate: 10 });\n    saveState();\n    renderTiers();\n    compute();\n  });\n\n  /* ─────────────── INIT ─────────────── */\n  syncInputsFromState();\n  compute();\n\n})();\n</script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Commission Calculator",
    "windowTitle": "Commission Calculator",
    "bundleId": "com.halisonworks.commissioncalculator",
    "iconPath": null
  },
  "categoryId": null,
  "source": "import",
  "createdAt": "2026-06-02T12:00:00.000Z",
  "updatedAt": "2026-06-02T12:00:00.000Z",
  "sharedAt": "2026-06-02T12:00:00.000Z"
}
