{
  "schema": "app-studio/canvas@1",
  "id": "example-loan-amortization",
  "name": "loan-amortization.html",
  "code": "<!DOCTYPE html>\n<!--\n  Loan Amortization — Halison App Studio example\n\n  A loan/mortgage calculator: monthly payment, total interest, payoff time with\n  optional extra payments, a full schedule, and a balance chart.\n\n  From the Halison App Studio public library:\n  https://github.com/halisonworks/public-app-studio\n\n  Permitted use: personal, educational, and other non-commercial use. You may\n  modify it, but keep this header and the source link intact, and do not sell,\n  commercialize, or republish it. Released under the Halison App Studio Examples\n  License — see the LICENSE file in the repository above.\n-->\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Loan Amortization Calculator</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <script>\n    tailwind.config = {\n      theme: {\n        extend: {\n          colors: {\n            brand: {\n              50:  '#f0f4ff',\n              100: '#dde8ff',\n              200: '#c3d4ff',\n              300: '#9db6ff',\n              400: '#748eff',\n              500: '#4f65ff',\n              600: '#3a44f5',\n              700: '#2f34e0',\n              800: '#282cb5',\n              900: '#252c8e',\n            }\n          }\n        }\n      }\n    };\n  </script>\n  <style>\n    /* smooth number transitions */\n    .stat-value { transition: all 0.25s ease; }\n    /* table sticky header */\n    #schedule-wrapper { max-height: 420px; overflow-y: auto; }\n    #schedule-wrapper thead th {\n      position: sticky; top: 0; z-index: 1;\n      background: #1e1b4b;\n    }\n    /* custom scrollbar */\n    #schedule-wrapper::-webkit-scrollbar { width: 6px; }\n    #schedule-wrapper::-webkit-scrollbar-track { background: #1e1b4b; }\n    #schedule-wrapper::-webkit-scrollbar-thumb { background: #4f65ff; border-radius: 3px; }\n    /* SVG chart tooltip */\n    #chart-tooltip {\n      pointer-events: none;\n      transition: opacity 0.15s;\n    }\n    input[type=range]::-webkit-slider-thumb { cursor: pointer; }\n    /* Firefox number input spinner removal */\n    input[type=number] { -moz-appearance: textfield; }\n    input[type=number]::-webkit-inner-spin-button,\n    input[type=number]::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }\n  </style>\n</head>\n<body class=\"bg-gray-950 text-gray-100 min-h-screen font-sans antialiased\">\n\n  <!-- ───────────────────────── HEADER ───────────────────────── -->\n  <header class=\"bg-brand-900 border-b border-brand-700 shadow-lg\">\n    <div class=\"max-w-6xl mx-auto px-4 py-5 flex items-center justify-between\">\n      <div>\n        <h1 class=\"text-2xl font-bold tracking-tight text-white\">Loan Amortization Calculator</h1>\n        <p class=\"text-brand-300 text-sm mt-0.5\">Monthly payment · Total interest · Full schedule · Balance chart</p>\n      </div>\n      <div class=\"hidden sm:flex items-center gap-2 text-brand-300 text-xs\">\n        <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 8c-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4-1.79-4-4-4zm0-6C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z\"/>\n        </svg>\n        Inputs auto-saved\n      </div>\n    </div>\n  </header>\n\n  <!-- ───────────────────────── MAIN ───────────────────────── -->\n  <main class=\"max-w-6xl mx-auto px-4 py-8 space-y-8\">\n\n    <!-- INPUT PANEL -->\n    <section class=\"bg-gray-900 rounded-2xl border border-gray-800 shadow-xl p-6\">\n      <h2 class=\"text-lg font-semibold text-brand-300 mb-5 flex items-center gap-2\">\n        <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.172-8.172z\"/>\n        </svg>\n        Loan Details\n      </h2>\n\n      <div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6\">\n\n        <!-- Currency -->\n        <div class=\"flex flex-col gap-1.5\">\n          <label class=\"text-sm font-medium text-gray-300\">Currency</label>\n          <select id=\"currency\"\n            class=\"bg-gray-800 border border-gray-700 rounded-lg px-3 py-2.5 text-white focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent\">\n            <option value=\"kr\">kr — Norwegian Krone</option>\n            <option value=\"$\">$ — US Dollar</option>\n            <option value=\"€\">€ — Euro</option>\n            <option value=\"£\">£ — British Pound</option>\n            <option value=\"¥\">¥ — Japanese Yen</option>\n          </select>\n        </div>\n\n        <!-- Principal -->\n        <div class=\"flex flex-col gap-1.5\">\n          <label for=\"principal\" class=\"text-sm font-medium text-gray-300\">Loan Amount</label>\n          <div class=\"relative\">\n            <span id=\"currency-prefix-1\" class=\"absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 font-mono text-sm select-none\">kr</span>\n            <input id=\"principal\" type=\"number\" min=\"1000\" max=\"100000000\" step=\"1000\" value=\"3000000\"\n              class=\"w-full bg-gray-800 border border-gray-700 rounded-lg pl-9 pr-3 py-2.5 text-white focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent\" />\n          </div>\n          <input id=\"principal-range\" type=\"range\" min=\"50000\" max=\"10000000\" step=\"10000\" value=\"3000000\"\n            class=\"w-full accent-brand-500 mt-1\" />\n          <div class=\"flex justify-between text-xs text-gray-500\">\n            <span>50 000</span><span>10 000 000</span>\n          </div>\n        </div>\n\n        <!-- Interest Rate -->\n        <div class=\"flex flex-col gap-1.5\">\n          <label for=\"rate\" class=\"text-sm font-medium text-gray-300\">Annual Interest Rate</label>\n          <div class=\"relative\">\n            <input id=\"rate\" type=\"number\" min=\"0.01\" max=\"30\" step=\"0.01\" value=\"4.50\"\n              class=\"w-full bg-gray-800 border border-gray-700 rounded-lg pl-3 pr-8 py-2.5 text-white focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent\" />\n            <span class=\"absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm select-none\">%</span>\n          </div>\n          <input id=\"rate-range\" type=\"range\" min=\"0.25\" max=\"20\" step=\"0.05\" value=\"4.50\"\n            class=\"w-full accent-brand-500 mt-1\" />\n          <div class=\"flex justify-between text-xs text-gray-500\">\n            <span>0.25%</span><span>20%</span>\n          </div>\n        </div>\n\n        <!-- Term -->\n        <div class=\"flex flex-col gap-1.5\">\n          <label for=\"term\" class=\"text-sm font-medium text-gray-300\">Loan Term (Years)</label>\n          <div class=\"relative\">\n            <input id=\"term\" type=\"number\" min=\"1\" max=\"50\" step=\"1\" value=\"25\"\n              class=\"w-full bg-gray-800 border border-gray-700 rounded-lg pl-3 pr-14 py-2.5 text-white focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent\" />\n            <span class=\"absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm select-none\">yrs</span>\n          </div>\n          <input id=\"term-range\" type=\"range\" min=\"1\" max=\"50\" step=\"1\" value=\"25\"\n            class=\"w-full accent-brand-500 mt-1\" />\n          <div class=\"flex justify-between text-xs text-gray-500\">\n            <span>1 yr</span><span>50 yrs</span>\n          </div>\n        </div>\n\n        <!-- Start Month -->\n        <div class=\"flex flex-col gap-1.5\">\n          <label for=\"start-date\" class=\"text-sm font-medium text-gray-300\">First Payment Month</label>\n          <input id=\"start-date\" type=\"month\"\n            class=\"bg-gray-800 border border-gray-700 rounded-lg px-3 py-2.5 text-white focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent\" />\n          <p class=\"text-xs text-gray-500\">Used for schedule dates only</p>\n        </div>\n\n        <!-- Extra Payment -->\n        <div class=\"flex flex-col gap-1.5\">\n          <label for=\"extra\" class=\"text-sm font-medium text-gray-300\">Extra Monthly Payment <span class=\"text-gray-500\">(optional)</span></label>\n          <div class=\"relative\">\n            <span id=\"currency-prefix-2\" class=\"absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 font-mono text-sm select-none\">kr</span>\n            <input id=\"extra\" type=\"number\" min=\"0\" max=\"1000000\" step=\"100\" value=\"0\"\n              class=\"w-full bg-gray-800 border border-gray-700 rounded-lg pl-9 pr-3 py-2.5 text-white focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent\" />\n          </div>\n          <input id=\"extra-range\" type=\"range\" min=\"0\" max=\"50000\" step=\"100\" value=\"0\"\n            class=\"w-full accent-brand-500 mt-1\" />\n          <div class=\"flex justify-between text-xs text-gray-500\">\n            <span>0</span><span>50 000 / mo</span>\n          </div>\n        </div>\n\n      </div>\n    </section>\n\n    <!-- SUMMARY STATS -->\n    <section id=\"summary\" class=\"grid grid-cols-2 lg:grid-cols-4 gap-4\">\n\n      <div class=\"bg-brand-900 border border-brand-700 rounded-xl p-5 flex flex-col gap-1\">\n        <p class=\"text-xs text-brand-300 uppercase tracking-wider font-medium\">Monthly Payment</p>\n        <p id=\"stat-monthly\" class=\"stat-value text-2xl font-bold text-white\">—</p>\n        <p class=\"text-xs text-gray-400\">Principal + interest</p>\n      </div>\n\n      <div class=\"bg-gray-900 border border-gray-800 rounded-xl p-5 flex flex-col gap-1\">\n        <p class=\"text-xs text-gray-400 uppercase tracking-wider font-medium\">Total Interest</p>\n        <p id=\"stat-interest\" class=\"stat-value text-2xl font-bold text-red-400\">—</p>\n        <p id=\"stat-interest-pct\" class=\"text-xs text-gray-500\">— % of principal</p>\n      </div>\n\n      <div class=\"bg-gray-900 border border-gray-800 rounded-xl p-5 flex flex-col gap-1\">\n        <p class=\"text-xs text-gray-400 uppercase tracking-wider font-medium\">Total Paid</p>\n        <p id=\"stat-total\" class=\"stat-value text-2xl font-bold text-white\">—</p>\n        <p class=\"text-xs text-gray-500\">Principal + all interest</p>\n      </div>\n\n      <div class=\"bg-gray-900 border border-gray-800 rounded-xl p-5 flex flex-col gap-1\">\n        <p class=\"text-xs text-gray-400 uppercase tracking-wider font-medium\">Payoff Time</p>\n        <p id=\"stat-payoff\" class=\"stat-value text-2xl font-bold text-green-400\">—</p>\n        <p id=\"stat-saved\" class=\"text-xs text-green-500\">—</p>\n      </div>\n\n    </section>\n\n    <!-- EXTRA PAYMENT SAVINGS BANNER -->\n    <div id=\"savings-banner\" class=\"hidden bg-green-900/30 border border-green-700 rounded-xl px-5 py-4 flex items-start gap-3\">\n      <svg class=\"w-5 h-5 text-green-400 mt-0.5 flex-shrink-0\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\">\n        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z\"/>\n      </svg>\n      <p id=\"savings-text\" class=\"text-green-300 text-sm leading-relaxed\"></p>\n    </div>\n\n    <!-- CHART -->\n    <section class=\"bg-gray-900 rounded-2xl border border-gray-800 shadow-xl p-6\">\n      <h2 class=\"text-lg font-semibold text-brand-300 mb-1 flex items-center gap-2\">\n        <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z\"/>\n        </svg>\n        Balance &amp; Payment Breakdown Over Time\n      </h2>\n      <p class=\"text-xs text-gray-500 mb-4\">Hover over the chart to inspect any month</p>\n\n      <div class=\"relative\">\n        <svg id=\"chart\" viewBox=\"0 0 900 340\" class=\"w-full rounded-lg bg-gray-950\" preserveAspectRatio=\"xMidYMid meet\"\n          style=\"min-height:220px; max-height:380px;\"\n          aria-label=\"Loan balance chart\">\n          <defs>\n            <linearGradient id=\"balanceGrad\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n              <stop offset=\"0%\" stop-color=\"#4f65ff\" stop-opacity=\"0.35\"/>\n              <stop offset=\"100%\" stop-color=\"#4f65ff\" stop-opacity=\"0.02\"/>\n            </linearGradient>\n            <linearGradient id=\"extraGrad\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n              <stop offset=\"0%\" stop-color=\"#22c55e\" stop-opacity=\"0.35\"/>\n              <stop offset=\"100%\" stop-color=\"#22c55e\" stop-opacity=\"0.02\"/>\n            </linearGradient>\n            <clipPath id=\"chart-clip\">\n              <rect x=\"60\" y=\"10\" width=\"820\" height=\"270\"/>\n            </clipPath>\n          </defs>\n          <!-- grid lines rendered by JS -->\n          <g id=\"chart-grid\"></g>\n          <!-- y axis labels -->\n          <g id=\"chart-y-labels\"></g>\n          <!-- x axis labels -->\n          <g id=\"chart-x-labels\"></g>\n          <!-- interest area -->\n          <g clip-path=\"url(#chart-clip)\">\n            <path id=\"interest-area\" fill=\"#ef4444\" fill-opacity=\"0.15\" d=\"\"/>\n            <path id=\"interest-line\" fill=\"none\" stroke=\"#ef4444\" stroke-width=\"1.5\" opacity=\"0.7\" d=\"\"/>\n            <!-- base balance area (with extra) -->\n            <path id=\"balance-area-extra\" fill=\"url(#extraGrad)\" d=\"\"/>\n            <path id=\"balance-line-extra\" fill=\"none\" stroke=\"#22c55e\" stroke-width=\"2\" stroke-dasharray=\"6 3\" d=\"\"/>\n            <!-- base balance area (standard) -->\n            <path id=\"balance-area\" fill=\"url(#balanceGrad)\" d=\"\"/>\n            <path id=\"balance-line\" fill=\"none\" stroke=\"#748eff\" stroke-width=\"2.5\" d=\"\"/>\n            <!-- hover indicator -->\n            <line id=\"hover-line\" x1=\"0\" y1=\"10\" x2=\"0\" y2=\"280\" stroke=\"white\" stroke-width=\"1\" opacity=\"0\" stroke-dasharray=\"4 3\"/>\n            <circle id=\"hover-dot-balance\" r=\"5\" fill=\"#748eff\" stroke=\"white\" stroke-width=\"2\" opacity=\"0\"/>\n            <circle id=\"hover-dot-extra\" r=\"5\" fill=\"#22c55e\" stroke=\"white\" stroke-width=\"2\" opacity=\"0\"/>\n          </g>\n          <!-- axes -->\n          <line x1=\"60\" y1=\"280\" x2=\"880\" y2=\"280\" stroke=\"#374151\" stroke-width=\"1\"/>\n          <line x1=\"60\" y1=\"10\"  x2=\"60\"  y2=\"280\" stroke=\"#374151\" stroke-width=\"1\"/>\n          <!-- y axis title -->\n          <text transform=\"translate(14,180) rotate(-90)\" text-anchor=\"middle\" font-size=\"11\" fill=\"#6b7280\">Balance</text>\n          <!-- x axis title -->\n          <text x=\"470\" y=\"320\" text-anchor=\"middle\" font-size=\"11\" fill=\"#6b7280\">Year</text>\n          <!-- legend -->\n          <g transform=\"translate(70,18)\">\n            <rect x=\"0\" y=\"-8\" width=\"12\" height=\"4\" fill=\"#748eff\" rx=\"2\"/>\n            <text x=\"16\" y=\"-3\" font-size=\"11\" fill=\"#9ca3af\">Balance (standard)</text>\n            <rect x=\"155\" y=\"-8\" width=\"12\" height=\"4\" fill=\"#22c55e\" rx=\"2\"/>\n            <text x=\"171\" y=\"-3\" font-size=\"11\" fill=\"#9ca3af\">Balance (with extra)</text>\n            <rect x=\"330\" y=\"-8\" width=\"12\" height=\"4\" fill=\"#ef4444\" rx=\"2\"/>\n            <text x=\"346\" y=\"-3\" font-size=\"11\" fill=\"#9ca3af\">Cumulative interest</text>\n          </g>\n          <!-- overlay for mouse events -->\n          <rect id=\"chart-overlay\" x=\"60\" y=\"10\" width=\"820\" height=\"270\" fill=\"transparent\" style=\"cursor:crosshair\"/>\n        </svg>\n\n        <!-- Tooltip -->\n        <div id=\"chart-tooltip\"\n          class=\"absolute top-4 left-4 bg-gray-800 border border-gray-700 rounded-lg px-3 py-2 text-xs opacity-0 pointer-events-none shadow-xl min-w-[170px]\">\n          <p id=\"tt-month\" class=\"font-semibold text-white mb-1\">Month —</p>\n          <p id=\"tt-balance\" class=\"text-brand-300\">Balance: —</p>\n          <p id=\"tt-extra-balance\" class=\"text-green-400 hidden\">With extra: —</p>\n          <p id=\"tt-interest\" class=\"text-red-400\">Cum. interest: —</p>\n          <p id=\"tt-payment\" class=\"text-gray-400\">Payment: —</p>\n        </div>\n      </div>\n    </section>\n\n    <!-- AMORTIZATION SCHEDULE -->\n    <section class=\"bg-gray-900 rounded-2xl border border-gray-800 shadow-xl p-6\">\n      <div class=\"flex items-center justify-between mb-4 flex-wrap gap-3\">\n        <h2 class=\"text-lg font-semibold text-brand-300 flex items-center gap-2\">\n          <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M3 10h18M3 14h18M10 3v18M14 3v18M5 3h14a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2z\"/>\n          </svg>\n          Amortization Schedule\n        </h2>\n        <div class=\"flex items-center gap-3 text-sm\">\n          <label class=\"flex items-center gap-2 cursor-pointer select-none text-gray-300\">\n            <input id=\"toggle-extra-col\" type=\"checkbox\" class=\"accent-brand-500 w-4 h-4\" />\n            Show extra-payment column\n          </label>\n          <span id=\"schedule-row-count\" class=\"text-gray-500 text-xs\"></span>\n        </div>\n      </div>\n\n      <div id=\"schedule-wrapper\" class=\"rounded-xl overflow-hidden border border-gray-800\">\n        <table class=\"w-full text-sm border-collapse\">\n          <thead>\n            <tr class=\"text-xs text-gray-400 uppercase tracking-wider\">\n              <th class=\"px-3 py-3 text-left font-medium\">#</th>\n              <th class=\"px-3 py-3 text-left font-medium\">Date</th>\n              <th class=\"px-3 py-3 text-right font-medium\">Payment</th>\n              <th class=\"px-3 py-3 text-right font-medium\">Principal</th>\n              <th class=\"px-3 py-3 text-right font-medium\">Interest</th>\n              <th id=\"col-extra-hdr\" class=\"px-3 py-3 text-right font-medium hidden\">Extra</th>\n              <th class=\"px-3 py-3 text-right font-medium\">Balance</th>\n              <th class=\"px-3 py-3 text-right font-medium hidden sm:table-cell\">Cum. Interest</th>\n            </tr>\n          </thead>\n          <tbody id=\"schedule-body\" class=\"divide-y divide-gray-800\">\n          </tbody>\n        </table>\n      </div>\n      <p class=\"text-xs text-gray-600 mt-3\">Scroll the table to see the full schedule. Values are rounded to the nearest whole number.</p>\n    </section>\n\n  </main>\n\n  <!-- FOOTER -->\n  <footer class=\"border-t border-gray-800 mt-12 py-6 text-center text-xs text-gray-600 space-y-1\">\n    <p>Loan Amortization Calculator — <a href=\"https://github.com/halisonworks/public-app-studio\" class=\"text-brand-400 hover:text-brand-300 underline underline-offset-2\">Halison App Studio</a></p>\n    <p>Personal &amp; educational use only. Not financial advice.</p>\n  </footer>\n\n  <script>\n    // ──────────────────────────────────────────────\n    //  STATE & ELEMENTS\n    // ──────────────────────────────────────────────\n    const LS_KEY = 'loan-amortization-v1';\n\n    const els = {\n      currency:       document.getElementById('currency'),\n      principal:      document.getElementById('principal'),\n      principalRange: document.getElementById('principal-range'),\n      rate:           document.getElementById('rate'),\n      rateRange:      document.getElementById('rate-range'),\n      term:           document.getElementById('term'),\n      termRange:      document.getElementById('term-range'),\n      extra:          document.getElementById('extra'),\n      extraRange:     document.getElementById('extra-range'),\n      startDate:      document.getElementById('start-date'),\n\n      statMonthly:    document.getElementById('stat-monthly'),\n      statInterest:   document.getElementById('stat-interest'),\n      statInterestPct:document.getElementById('stat-interest-pct'),\n      statTotal:      document.getElementById('stat-total'),\n      statPayoff:     document.getElementById('stat-payoff'),\n      statSaved:      document.getElementById('stat-saved'),\n\n      savingsBanner:  document.getElementById('savings-banner'),\n      savingsText:    document.getElementById('savings-text'),\n\n      scheduleBody:   document.getElementById('schedule-body'),\n      scheduleCount:  document.getElementById('schedule-row-count'),\n      toggleExtra:    document.getElementById('toggle-extra-col'),\n      colExtraHdr:    document.getElementById('col-extra-hdr'),\n\n      currencyPrefix1:document.getElementById('currency-prefix-1'),\n      currencyPrefix2:document.getElementById('currency-prefix-2'),\n    };\n\n    // SVG chart elements\n    const chartEls = {\n      balanceLine:    document.getElementById('balance-line'),\n      balanceArea:    document.getElementById('balance-area'),\n      extraLine:      document.getElementById('balance-line-extra'),\n      extraArea:      document.getElementById('balance-area-extra'),\n      interestLine:   document.getElementById('interest-line'),\n      interestArea:   document.getElementById('interest-area'),\n      grid:           document.getElementById('chart-grid'),\n      yLabels:        document.getElementById('chart-y-labels'),\n      xLabels:        document.getElementById('chart-x-labels'),\n      hoverLine:      document.getElementById('hover-line'),\n      hoverDotBalance:document.getElementById('hover-dot-balance'),\n      hoverDotExtra:  document.getElementById('hover-dot-extra'),\n      overlay:        document.getElementById('chart-overlay'),\n      tooltip:        document.getElementById('chart-tooltip'),\n      ttMonth:        document.getElementById('tt-month'),\n      ttBalance:      document.getElementById('tt-balance'),\n      ttExtraBalance: document.getElementById('tt-extra-balance'),\n      ttInterest:     document.getElementById('tt-interest'),\n      ttPayment:      document.getElementById('tt-payment'),\n    };\n\n    // Chart dimensions (matching viewBox)\n    const CX = { left: 60, right: 880, top: 10, bottom: 280 };\n    const CW = CX.right - CX.left;   // 820\n    const CH = CX.bottom - CX.top;   // 270\n\n    // ──────────────────────────────────────────────\n    //  FORMATTING\n    // ──────────────────────────────────────────────\n    function getCurrency() { return els.currency.value; }\n\n    function fmt(n) {\n      const sym = getCurrency();\n      const rounded = Math.round(n);\n      const formatted = rounded.toLocaleString('en-US');\n      // Put symbol before or after depending on convention\n      if (sym === 'kr') return formatted + ' ' + sym;\n      return sym + formatted;\n    }\n\n    function fmtMonths(months) {\n      const y = Math.floor(months / 12);\n      const m = months % 12;\n      const parts = [];\n      if (y > 0) parts.push(y + ' yr' + (y !== 1 ? 's' : ''));\n      if (m > 0) parts.push(m + ' mo' + (m !== 1 ? 's' : ''));\n      return parts.join(' ') || '< 1 month';\n    }\n\n    // ──────────────────────────────────────────────\n    //  AMORTIZATION CORE\n    // ──────────────────────────────────────────────\n    function buildSchedule(principal, annualRate, termYears, extraMonthly) {\n      const monthlyRate = annualRate / 100 / 12;\n      const n = termYears * 12;\n\n      let basePayment;\n      if (monthlyRate === 0) {\n        basePayment = principal / n;\n      } else {\n        basePayment = principal * (monthlyRate * Math.pow(1 + monthlyRate, n)) /\n                      (Math.pow(1 + monthlyRate, n) - 1);\n      }\n\n      const schedule = [];\n      let balance = principal;\n      let cumInterest = 0;\n\n      for (let mo = 1; balance > 0.005; mo++) {\n        const interestCharge = balance * monthlyRate;\n        let principalCharge = basePayment - interestCharge;\n\n        if (principalCharge < 0) principalCharge = 0;\n\n        let extra = extraMonthly;\n        // Don't overpay in final month\n        if (principalCharge + extra > balance) {\n          extra = Math.max(0, balance - principalCharge);\n        }\n\n        const totalPayment = basePayment + extra;\n        balance = balance - principalCharge - extra;\n        if (balance < 0.005) balance = 0;\n        cumInterest += interestCharge;\n\n        schedule.push({\n          month:          mo,\n          payment:        totalPayment,\n          principalPaid:  principalCharge + extra,\n          interest:       interestCharge,\n          extra:          extra,\n          balance:        balance,\n          cumInterest:    cumInterest,\n        });\n\n        if (balance <= 0) break;\n        if (mo > 12000) break; // safety cap (1000 years)\n      }\n\n      return { basePayment, schedule };\n    }\n\n    // Build a \"no extra\" schedule too for comparison\n    function buildBaseSchedule(principal, annualRate, termYears) {\n      const monthlyRate = annualRate / 100 / 12;\n      const n = termYears * 12;\n      let basePayment;\n      if (monthlyRate === 0) {\n        basePayment = principal / n;\n      } else {\n        basePayment = principal * (monthlyRate * Math.pow(1 + monthlyRate, n)) /\n                      (Math.pow(1 + monthlyRate, n) - 1);\n      }\n      const balances = [principal];\n      let balance = principal;\n      for (let mo = 1; mo <= n && balance > 0.005; mo++) {\n        const interestCharge = balance * monthlyRate;\n        let principalCharge = basePayment - interestCharge;\n        if (principalCharge < 0) principalCharge = 0;\n        balance -= principalCharge;\n        if (balance < 0.005) balance = 0;\n        balances.push(balance);\n      }\n      return balances;\n    }\n\n    // ──────────────────────────────────────────────\n    //  CHART RENDERING\n    // ──────────────────────────────────────────────\n    function renderChart(schedule, baseBalances, principal) {\n      const totalMonths = schedule.length;\n      if (totalMonths === 0) return;\n\n      // We'll sample at most ~300 points for performance\n      const step = Math.max(1, Math.floor(totalMonths / 300));\n      const pts = [];\n      for (let i = 0; i < schedule.length; i += step) {\n        pts.push(schedule[i]);\n      }\n      // Always include last point\n      const last = schedule[schedule.length - 1];\n      if (pts[pts.length - 1] !== last) pts.push(last);\n\n      const maxVal = principal;\n      const maxInterest = schedule[schedule.length - 1].cumInterest;\n      const yMax = Math.max(maxVal, maxInterest) * 1.05;\n\n      // Helper: x position for a month index\n      function xPos(month) {\n        return CX.left + ((month - 1) / (totalMonths - 1 || 1)) * CW;\n      }\n      function yPos(val) {\n        return CX.bottom - (val / yMax) * CH;\n      }\n\n      // ── Grid lines & labels ──\n      const gridLines = 5;\n      let gridHtml = '';\n      let yLabelHtml = '';\n      for (let i = 0; i <= gridLines; i++) {\n        const val = (yMax / gridLines) * i;\n        const y = yPos(val);\n        gridHtml += `<line x1=\"${CX.left}\" y1=\"${y.toFixed(1)}\" x2=\"${CX.right}\" y2=\"${y.toFixed(1)}\" stroke=\"#1f2937\" stroke-width=\"1\"/>`;\n        yLabelHtml += `<text x=\"${CX.left - 6}\" y=\"${(y + 4).toFixed(1)}\" text-anchor=\"end\" font-size=\"10\" fill=\"#6b7280\">${shortNum(val)}</text>`;\n      }\n      chartEls.grid.innerHTML = gridHtml;\n      chartEls.yLabels.innerHTML = yLabelHtml;\n\n      // X axis: year labels\n      const totalYears = Math.ceil(totalMonths / 12);\n      const yearStep = totalYears <= 10 ? 1 : totalYears <= 30 ? 5 : 10;\n      let xLabelHtml = '';\n      for (let yr = 0; yr <= totalYears; yr += yearStep) {\n        const mo = yr * 12 + 1;\n        const x = xPos(Math.min(mo, totalMonths));\n        xLabelHtml += `<text x=\"${x.toFixed(1)}\" y=\"${CX.bottom + 16}\" text-anchor=\"middle\" font-size=\"10\" fill=\"#6b7280\">Yr ${yr}</text>`;\n      }\n      chartEls.xLabels.innerHTML = xLabelHtml;\n\n      // ── Balance line (standard/no-extra) ──\n      // Use baseBalances (includes initial balance at index 0)\n      const baseLen = baseBalances.length;\n      const baseStep = Math.max(1, Math.floor(baseLen / 300));\n      let basePts = [];\n      for (let i = 0; i < baseLen; i += baseStep) basePts.push({ month: i + 1, balance: baseBalances[i] });\n      if (basePts[basePts.length - 1].month !== baseLen) basePts.push({ month: baseLen, balance: baseBalances[baseLen - 1] });\n\n      const balancePath = basePts.map((p, i) => {\n        const x = xPos(p.month).toFixed(1);\n        const y = yPos(p.balance).toFixed(1);\n        return (i === 0 ? 'M' : 'L') + x + ' ' + y;\n      }).join(' ');\n      const balanceArea = balancePath\n        + ` L${xPos(basePts[basePts.length - 1].month).toFixed(1)} ${CX.bottom} L${CX.left} ${CX.bottom} Z`;\n\n      chartEls.balanceLine.setAttribute('d', balancePath);\n      chartEls.balanceArea.setAttribute('d', balanceArea);\n\n      // ── Extra-payment balance line ──\n      const hasExtra = schedule.some(r => r.extra > 0);\n      if (hasExtra) {\n        const extraPath = pts.map((p, i) => {\n          const x = xPos(p.month).toFixed(1);\n          const y = yPos(p.balance).toFixed(1);\n          return (i === 0 ? 'M' : 'L') + x + ' ' + y;\n        }).join(' ');\n        const extraArea = extraPath\n          + ` L${xPos(pts[pts.length - 1].month).toFixed(1)} ${CX.bottom} L${CX.left} ${CX.bottom} Z`;\n        chartEls.extraLine.setAttribute('d', extraPath);\n        chartEls.extraArea.setAttribute('d', extraArea);\n        chartEls.extraLine.style.opacity = '1';\n        chartEls.extraArea.style.opacity = '1';\n      } else {\n        chartEls.extraLine.setAttribute('d', '');\n        chartEls.extraArea.setAttribute('d', '');\n        chartEls.extraLine.style.opacity = '0';\n        chartEls.extraArea.style.opacity = '0';\n      }\n\n      // ── Cumulative interest line ──\n      const intPath = pts.map((p, i) => {\n        const x = xPos(p.month).toFixed(1);\n        const y = yPos(p.cumInterest).toFixed(1);\n        return (i === 0 ? 'M' : 'L') + x + ' ' + y;\n      }).join(' ');\n      const intArea = intPath\n        + ` L${xPos(pts[pts.length - 1].month).toFixed(1)} ${CX.bottom} L${CX.left} ${CX.bottom} Z`;\n      chartEls.interestLine.setAttribute('d', intPath);\n      chartEls.interestArea.setAttribute('d', intArea);\n\n      // ── Store data for hover ──\n      chartEls.overlay._chartData = { schedule, baseBalances, totalMonths, yMax, hasExtra };\n    }\n\n    function shortNum(n) {\n      if (n >= 1e6) return (n / 1e6).toFixed(1) + 'M';\n      if (n >= 1e3) return (n / 1e3).toFixed(0) + 'K';\n      return Math.round(n).toString();\n    }\n\n    // ── Chart hover ──\n    chartEls.overlay.addEventListener('mousemove', function(e) {\n      const data = this._chartData;\n      if (!data) return;\n\n      const svgEl = document.getElementById('chart');\n      const rect = svgEl.getBoundingClientRect();\n      // Map mouse x to SVG coordinate space\n      const svgW = 900; // viewBox width\n      const scaleX = svgW / rect.width;\n      const mouseX = (e.clientX - rect.left) * scaleX;\n\n      if (mouseX < CX.left || mouseX > CX.right) {\n        hideTooltip(); return;\n      }\n\n      const frac = (mouseX - CX.left) / CW;\n      const monthIdx = Math.round(frac * (data.totalMonths - 1));\n      const row = data.schedule[Math.max(0, Math.min(monthIdx, data.schedule.length - 1))];\n      const baseBalance = data.baseBalances[Math.min(monthIdx, data.baseBalances.length - 1)] || 0;\n\n      // Position hover line\n      const hx = (CX.left + frac * CW).toFixed(1);\n      chartEls.hoverLine.setAttribute('x1', hx);\n      chartEls.hoverLine.setAttribute('x2', hx);\n      chartEls.hoverLine.setAttribute('opacity', '0.4');\n\n      const yMax = data.yMax;\n      const yBalBase = (CX.bottom - (baseBalance / yMax) * CH).toFixed(1);\n      chartEls.hoverDotBalance.setAttribute('cx', hx);\n      chartEls.hoverDotBalance.setAttribute('cy', yBalBase);\n      chartEls.hoverDotBalance.setAttribute('opacity', '1');\n\n      if (data.hasExtra) {\n        const yBalExtra = (CX.bottom - (row.balance / yMax) * CH).toFixed(1);\n        chartEls.hoverDotExtra.setAttribute('cx', hx);\n        chartEls.hoverDotExtra.setAttribute('cy', yBalExtra);\n        chartEls.hoverDotExtra.setAttribute('opacity', '1');\n      } else {\n        chartEls.hoverDotExtra.setAttribute('opacity', '0');\n      }\n\n      // Update tooltip\n      const yr = Math.floor((row.month - 1) / 12);\n      const mo = ((row.month - 1) % 12) + 1;\n      chartEls.ttMonth.textContent = `Month ${row.month} (Yr ${yr}, Mo ${mo})`;\n      chartEls.ttBalance.textContent = `Balance: ${fmt(baseBalance)}`;\n      if (data.hasExtra) {\n        chartEls.ttExtraBalance.textContent = `With extra: ${fmt(row.balance)}`;\n        chartEls.ttExtraBalance.classList.remove('hidden');\n      } else {\n        chartEls.ttExtraBalance.classList.add('hidden');\n      }\n      chartEls.ttInterest.textContent = `Cum. interest: ${fmt(row.cumInterest)}`;\n      chartEls.ttPayment.textContent = `Payment: ${fmt(row.payment)}`;\n\n      // Position tooltip div — keep inside viewport\n      const tooltipEl = chartEls.tooltip;\n      tooltipEl.style.opacity = '1';\n      const tipLeft = (frac > 0.65) ? 'auto' : '1rem';\n      const tipRight = (frac > 0.65) ? '1rem' : 'auto';\n      tooltipEl.style.left = tipLeft;\n      tooltipEl.style.right = tipRight;\n    });\n\n    chartEls.overlay.addEventListener('mouseleave', hideTooltip);\n\n    function hideTooltip() {\n      chartEls.hoverLine.setAttribute('opacity', '0');\n      chartEls.hoverDotBalance.setAttribute('opacity', '0');\n      chartEls.hoverDotExtra.setAttribute('opacity', '0');\n      chartEls.tooltip.style.opacity = '0';\n    }\n\n    // ──────────────────────────────────────────────\n    //  SCHEDULE TABLE\n    // ──────────────────────────────────────────────\n    function getStartDate() {\n      const val = els.startDate.value;\n      if (!val) return null;\n      const [y, m] = val.split('-').map(Number);\n      return { year: y, month: m };\n    }\n\n    function formatMonthDate(startDate, monthNum) {\n      if (!startDate) return `Month ${monthNum}`;\n      let m = startDate.month - 1 + monthNum;\n      const y = startDate.year + Math.floor(m / 12);\n      m = m % 12;\n      const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];\n      return `${months[m]} ${y}`;\n    }\n\n    function renderSchedule(schedule) {\n      const showExtra = els.toggleExtra.checked;\n      els.colExtraHdr.classList.toggle('hidden', !showExtra);\n\n      const startDate = getStartDate();\n      const frag = document.createDocumentFragment();\n\n      schedule.forEach((row, i) => {\n        const tr = document.createElement('tr');\n        tr.className = i % 2 === 0\n          ? 'bg-gray-900 hover:bg-gray-800/60 transition-colors'\n          : 'bg-gray-950/50 hover:bg-gray-800/60 transition-colors';\n\n        const balanceColor = row.balance < 0.01\n          ? 'text-green-400 font-semibold'\n          : 'text-gray-100';\n\n        const extraCell = showExtra\n          ? `<td class=\"px-3 py-2 text-right text-green-400 font-mono text-xs\">${row.extra > 0 ? fmt(row.extra) : '—'}</td>`\n          : '';\n\n        tr.innerHTML = `\n          <td class=\"px-3 py-2 text-gray-500 text-xs tabular-nums\">${row.month}</td>\n          <td class=\"px-3 py-2 text-gray-400 text-xs whitespace-nowrap\">${formatMonthDate(startDate, row.month)}</td>\n          <td class=\"px-3 py-2 text-right font-mono text-xs text-gray-200\">${fmt(row.payment)}</td>\n          <td class=\"px-3 py-2 text-right font-mono text-xs text-brand-300\">${fmt(row.principalPaid)}</td>\n          <td class=\"px-3 py-2 text-right font-mono text-xs text-red-400\">${fmt(row.interest)}</td>\n          ${extraCell}\n          <td class=\"px-3 py-2 text-right font-mono text-xs ${balanceColor}\">${fmt(row.balance)}</td>\n          <td class=\"px-3 py-2 text-right font-mono text-xs text-gray-500 hidden sm:table-cell\">${fmt(row.cumInterest)}</td>\n        `;\n        frag.appendChild(tr);\n      });\n\n      els.scheduleBody.innerHTML = '';\n      els.scheduleBody.appendChild(frag);\n      els.scheduleCount.textContent = `${schedule.length} payments`;\n    }\n\n    // ──────────────────────────────────────────────\n    //  MAIN COMPUTE\n    // ──────────────────────────────────────────────\n    function compute() {\n      const principal   = Math.max(1, parseFloat(els.principal.value) || 0);\n      const annualRate  = Math.max(0, parseFloat(els.rate.value) || 0);\n      const termYears   = Math.max(1, Math.min(50, parseInt(els.term.value) || 1));\n      const extraMonthly= Math.max(0, parseFloat(els.extra.value) || 0);\n\n      const { basePayment, schedule } = buildSchedule(principal, annualRate, termYears, extraMonthly);\n      const baseBalances = buildBaseSchedule(principal, annualRate, termYears);\n\n      if (schedule.length === 0) return;\n\n      const totalMonths  = schedule.length;\n      const totalInterest= schedule[schedule.length - 1].cumInterest;\n      const totalPaid    = schedule.reduce((s, r) => s + r.payment, 0);\n      const stdMonths    = termYears * 12;\n\n      // Update stats\n      els.statMonthly.textContent  = fmt(basePayment + extraMonthly);\n      els.statInterest.textContent = fmt(totalInterest);\n      els.statInterestPct.textContent = (totalInterest / principal * 100).toFixed(1) + '% of principal';\n      els.statTotal.textContent    = fmt(totalPaid);\n      els.statPayoff.textContent   = fmtMonths(totalMonths);\n\n      const monthsSaved = stdMonths - totalMonths;\n      if (extraMonthly > 0 && monthsSaved > 0) {\n        const interestSaved = baseBalances[baseBalances.length - 1 - 1] ?? 0;\n        // compute what total interest would have been without extra\n        const stdResult = buildSchedule(principal, annualRate, termYears, 0);\n        const stdTotalInterest = stdResult.schedule[stdResult.schedule.length - 1].cumInterest;\n        const interestSavedAmt = stdTotalInterest - totalInterest;\n\n        els.statSaved.textContent = `${fmtMonths(monthsSaved)} saved`;\n        els.savingsText.textContent =\n          `By paying an extra ${fmt(extraMonthly)} per month, you pay off the loan ${fmtMonths(monthsSaved)} earlier ` +\n          `and save ${fmt(interestSavedAmt)} in interest.`;\n        els.savingsBanner.classList.remove('hidden');\n      } else {\n        els.statSaved.textContent = 'On schedule';\n        els.savingsBanner.classList.add('hidden');\n      }\n\n      // Chart\n      renderChart(schedule, baseBalances, principal);\n\n      // Table\n      renderSchedule(schedule);\n\n      // Persist\n      persistInputs();\n    }\n\n    // ──────────────────────────────────────────────\n    //  LOCAL STORAGE\n    // ──────────────────────────────────────────────\n    function persistInputs() {\n      try {\n        localStorage.setItem(LS_KEY, JSON.stringify({\n          currency:   els.currency.value,\n          principal:  els.principal.value,\n          rate:       els.rate.value,\n          term:       els.term.value,\n          extra:      els.extra.value,\n          startDate:  els.startDate.value,\n          showExtra:  els.toggleExtra.checked,\n        }));\n      } catch(e) {}\n    }\n\n    function loadInputs() {\n      try {\n        const raw = localStorage.getItem(LS_KEY);\n        if (!raw) return false;\n        const saved = JSON.parse(raw);\n        if (saved.currency)   els.currency.value   = saved.currency;\n        if (saved.principal)  { els.principal.value = saved.principal; els.principalRange.value = saved.principal; }\n        if (saved.rate)       { els.rate.value      = saved.rate;      els.rateRange.value      = saved.rate; }\n        if (saved.term)       { els.term.value      = saved.term;      els.termRange.value      = saved.term; }\n        if (saved.extra !== undefined) { els.extra.value  = saved.extra; els.extraRange.value   = saved.extra; }\n        if (saved.startDate)  els.startDate.value   = saved.startDate;\n        if (saved.showExtra !== undefined) els.toggleExtra.checked = saved.showExtra;\n        syncCurrencyPrefixes();\n        return true;\n      } catch(e) { return false; }\n    }\n\n    // ──────────────────────────────────────────────\n    //  INPUT SYNC & EVENT WIRING\n    // ──────────────────────────────────────────────\n    function syncCurrencyPrefixes() {\n      const sym = getCurrency();\n      els.currencyPrefix1.textContent = sym;\n      els.currencyPrefix2.textContent = sym;\n    }\n\n    // Two-way sync between number input and range slider\n    function linkInputRange(inputEl, rangeEl) {\n      inputEl.addEventListener('input', () => {\n        rangeEl.value = inputEl.value;\n        compute();\n      });\n      rangeEl.addEventListener('input', () => {\n        inputEl.value = rangeEl.value;\n        compute();\n      });\n    }\n\n    linkInputRange(els.principal,  els.principalRange);\n    linkInputRange(els.rate,       els.rateRange);\n    linkInputRange(els.term,       els.termRange);\n    linkInputRange(els.extra,      els.extraRange);\n\n    els.currency.addEventListener('change', () => {\n      syncCurrencyPrefixes();\n      compute();\n    });\n    els.startDate.addEventListener('change', () => compute());\n    els.toggleExtra.addEventListener('change', () => {\n      const showExtra = els.toggleExtra.checked;\n      els.colExtraHdr.classList.toggle('hidden', !showExtra);\n      // Re-render table with/without extra column\n      const principal    = Math.max(1, parseFloat(els.principal.value) || 0);\n      const annualRate   = Math.max(0, parseFloat(els.rate.value) || 0);\n      const termYears    = Math.max(1, Math.min(50, parseInt(els.term.value) || 1));\n      const extraMonthly = Math.max(0, parseFloat(els.extra.value) || 0);\n      const { schedule } = buildSchedule(principal, annualRate, termYears, extraMonthly);\n      renderSchedule(schedule);\n      persistInputs();\n    });\n\n    // ──────────────────────────────────────────────\n    //  INIT\n    // ──────────────────────────────────────────────\n    (function init() {\n      // Set default start date to next month\n      const now = new Date();\n      now.setMonth(now.getMonth() + 1);\n      const yy = now.getFullYear();\n      const mm = String(now.getMonth() + 1).padStart(2, '0');\n      els.startDate.value = `${yy}-${mm}`;\n\n      const loaded = loadInputs();\n      if (!loaded) syncCurrencyPrefixes();\n\n      compute();\n    })();\n  </script>\n\n</body>\n</html>\n",
  "packaging": {
    "appName": "Loan Amortization",
    "windowTitle": "Loan Amortization",
    "bundleId": "com.halisonworks.loanamortization",
    "iconPath": null
  },
  "categoryId": null,
  "source": "import",
  "createdAt": "2026-06-02T12:00:00.000Z",
  "updatedAt": "2026-06-02T12:00:00.000Z",
  "sharedAt": "2026-06-02T12:00:00.000Z"
}
