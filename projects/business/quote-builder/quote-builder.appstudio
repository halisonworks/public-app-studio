{
  "schema": "app-studio/canvas@1",
  "id": "example-quote-builder",
  "name": "quote-builder.html",
  "code": "<!DOCTYPE html>\n<!--\n  Quote Builder — Halison App Studio example\n\n  Build a clean sales quote/proposal: client details, line items with per-line\n  and overall discounts, tax and totals, terms. Saves locally; print-friendly.\n\n  From the Halison App Studio public library:\n  https://github.com/halisonworks/public-app-studio\n\n  Permitted use: personal, educational, and other non-commercial use. You may\n  modify it, but keep this header and the source link intact, and do not sell,\n  commercialize, or republish it. Released under the Halison App Studio Examples\n  License — see the LICENSE file in the repository above.\n-->\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Quote Builder</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    @media print {\n      .no-print { display: none !important; }\n      body { background: white !important; }\n      #quote-wrapper {\n        box-shadow: none !important;\n        border: none !important;\n        margin: 0 !important;\n        border-radius: 0 !important;\n      }\n      #app-shell { padding: 0 !important; background: white !important; }\n      .print-clean-input {\n        border: none !important;\n        background: transparent !important;\n        box-shadow: none !important;\n        padding: 0 !important;\n      }\n    }\n    [contenteditable]:focus { outline: 2px solid #0ea5e9; border-radius: 2px; }\n    [contenteditable]:empty:before { content: attr(data-placeholder); color: #9ca3af; font-style: italic; }\n    input[type=\"number\"]::-webkit-inner-spin-button,\n    input[type=\"number\"]::-webkit-outer-spin-button { opacity: 1; }\n    input[type=\"date\"]::-webkit-calendar-picker-indicator { opacity: 0.6; }\n    .badge-onetime  { background: #e0f2fe; color: #0369a1; }\n    .badge-monthly  { background: #dcfce7; color: #15803d; }\n  </style>\n</head>\n<body class=\"bg-slate-100 min-h-screen\" id=\"app-shell\">\n\n  <!-- ── Top toolbar (no-print) ──────────────────────────────────────────── -->\n  <div class=\"no-print sticky top-0 z-10 bg-white border-b border-gray-200 shadow-sm\">\n    <div class=\"max-w-5xl mx-auto px-4 py-3 flex flex-wrap items-center gap-3\">\n      <span class=\"font-semibold text-sky-600 text-lg tracking-tight\">Quote Builder</span>\n      <div class=\"flex items-center gap-2 ml-auto flex-wrap\">\n        <!-- Currency -->\n        <label class=\"text-sm text-gray-600 font-medium\">Currency:</label>\n        <select id=\"currency-select\"\n          class=\"text-sm border border-gray-300 rounded px-2 py-1 focus:outline-none focus:ring-2 focus:ring-sky-400 bg-white\">\n          <option value=\"$\">$ (USD)</option>\n          <option value=\"kr\">kr (NOK)</option>\n          <option value=\"€\">€ (EUR)</option>\n          <option value=\"£\">£ (GBP)</option>\n          <option value=\"SEK\">SEK</option>\n          <option value=\"DKK\">DKK</option>\n          <option value=\"CAD\">CAD</option>\n          <option value=\"AUD\">AUD</option>\n        </select>\n        <!-- Tax rate -->\n        <label class=\"text-sm text-gray-600 font-medium ml-2\">Tax:</label>\n        <select id=\"tax-select\"\n          class=\"text-sm border border-gray-300 rounded px-2 py-1 focus:outline-none focus:ring-2 focus:ring-sky-400 bg-white\">\n          <option value=\"0\">0 %</option>\n          <option value=\"5\">5 %</option>\n          <option value=\"6\">6 %</option>\n          <option value=\"7\">7 %</option>\n          <option value=\"8\">8 %</option>\n          <option value=\"10\">10 %</option>\n          <option value=\"12\">12 %</option>\n          <option value=\"13\">13 %</option>\n          <option value=\"15\">15 %</option>\n          <option value=\"20\">20 %</option>\n          <option value=\"21\">21 %</option>\n          <option value=\"25\">25 %</option>\n        </select>\n        <!-- New quote -->\n        <button id=\"btn-new\"\n          class=\"ml-2 text-sm px-3 py-1.5 bg-red-50 hover:bg-red-100 text-red-600 border border-red-200 rounded font-medium transition\">\n          New Quote\n        </button>\n      </div>\n    </div>\n  </div>\n\n  <!-- ── Main area ────────────────────────────────────────────────────────── -->\n  <div class=\"max-w-5xl mx-auto px-4 py-8\">\n    <div id=\"quote-wrapper\"\n      class=\"bg-white rounded-xl shadow-lg border border-gray-200 overflow-hidden\">\n\n      <!-- Header band -->\n      <div class=\"bg-sky-700 px-8 py-7 flex flex-col sm:flex-row sm:items-start gap-6\">\n        <!-- Seller info -->\n        <div class=\"flex-1\">\n          <div class=\"text-sky-200 text-xs uppercase tracking-widest font-semibold mb-2\">From</div>\n          <div\n            id=\"seller-name\"\n            contenteditable=\"true\"\n            data-placeholder=\"Your Company Name\"\n            data-key=\"sellerName\"\n            class=\"text-2xl font-bold text-white focus:bg-sky-600 focus:rounded px-1 -ml-1 min-w-[180px] block\">\n          </div>\n          <div\n            id=\"seller-address\"\n            contenteditable=\"true\"\n            data-placeholder=\"123 Business Ave, Suite 400&#10;San Francisco, CA 94105\"\n            data-key=\"sellerAddress\"\n            class=\"text-sky-200 text-sm mt-1 whitespace-pre-wrap focus:bg-sky-600 focus:rounded px-1 -ml-1 block\">\n          </div>\n          <div\n            id=\"seller-contact\"\n            contenteditable=\"true\"\n            data-placeholder=\"hello@yourcompany.com · (415) 555-0100\"\n            data-key=\"sellerContact\"\n            class=\"text-sky-200 text-sm mt-0.5 focus:bg-sky-600 focus:rounded px-1 -ml-1 block\">\n          </div>\n        </div>\n\n        <!-- Quote meta -->\n        <div class=\"sm:text-right flex flex-col gap-2 min-w-[200px]\">\n          <div class=\"text-sky-100 text-2xl font-bold uppercase tracking-widest\">Proposal</div>\n          <div class=\"flex sm:justify-end items-center gap-2\">\n            <span class=\"text-sky-300 text-sm font-medium\">Quote #</span>\n            <input id=\"quote-number\" type=\"text\" data-key=\"quoteNumber\"\n              placeholder=\"Q-2025-001\"\n              class=\"print-clean-input bg-sky-600 text-white text-sm font-semibold rounded px-2 py-0.5 w-32 text-right border border-sky-400 focus:outline-none focus:ring-2 focus:ring-white placeholder-sky-300\" />\n          </div>\n          <div class=\"flex sm:justify-end items-center gap-2\">\n            <span class=\"text-sky-300 text-xs font-medium\">Issue Date</span>\n            <input id=\"issue-date\" type=\"date\" data-key=\"issueDate\"\n              class=\"print-clean-input bg-sky-600 text-sky-100 text-xs rounded px-2 py-0.5 border border-sky-400 focus:outline-none focus:ring-2 focus:ring-white\" />\n          </div>\n          <div class=\"flex sm:justify-end items-center gap-2\">\n            <span class=\"text-sky-300 text-xs font-medium\">Valid Until</span>\n            <input id=\"valid-until\" type=\"date\" data-key=\"validUntil\"\n              class=\"print-clean-input bg-sky-600 text-sky-100 text-xs rounded px-2 py-0.5 border border-sky-400 focus:outline-none focus:ring-2 focus:ring-white\" />\n          </div>\n        </div>\n      </div>\n\n      <!-- Client block -->\n      <div class=\"px-8 py-6 grid grid-cols-1 sm:grid-cols-2 gap-8 border-b border-gray-100 bg-gray-50\">\n        <div>\n          <div class=\"text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2\">Prepared For</div>\n          <div\n            id=\"client-name\"\n            contenteditable=\"true\"\n            data-placeholder=\"Client Company, Inc.\"\n            data-key=\"clientName\"\n            class=\"font-bold text-gray-800 text-lg focus:outline-none focus:bg-sky-50 focus:rounded px-1 -ml-1 block\">\n          </div>\n          <div\n            id=\"client-contact\"\n            contenteditable=\"true\"\n            data-placeholder=\"Contact: Jane Doe · jane@client.com\"\n            data-key=\"clientContact\"\n            class=\"text-gray-500 text-sm mt-0.5 focus:outline-none focus:bg-sky-50 focus:rounded px-1 -ml-1 block\">\n          </div>\n          <div\n            id=\"client-address\"\n            contenteditable=\"true\"\n            data-placeholder=\"789 Client Blvd&#10;New York, NY 10001\"\n            data-key=\"clientAddress\"\n            class=\"text-gray-500 text-sm mt-1 whitespace-pre-wrap focus:outline-none focus:bg-sky-50 focus:rounded px-1 -ml-1 block\">\n          </div>\n        </div>\n        <div class=\"flex flex-col justify-center\">\n          <div class=\"text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2\">Prepared By</div>\n          <div\n            id=\"rep-name\"\n            contenteditable=\"true\"\n            data-placeholder=\"Alex Johnson, Account Executive\"\n            data-key=\"repName\"\n            class=\"font-semibold text-gray-700 text-sm focus:outline-none focus:bg-sky-50 focus:rounded px-1 -ml-1 block\">\n          </div>\n          <div\n            id=\"rep-contact\"\n            contenteditable=\"true\"\n            data-placeholder=\"alex@yourcompany.com · (415) 555-0101\"\n            data-key=\"repContact\"\n            class=\"text-gray-500 text-sm mt-0.5 focus:outline-none focus:bg-sky-50 focus:rounded px-1 -ml-1 block\">\n          </div>\n        </div>\n      </div>\n\n      <!-- Intro / Scope note -->\n      <div class=\"px-8 py-6 border-b border-gray-100\">\n        <div class=\"text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2\">Scope &amp; Overview</div>\n        <div\n          id=\"scope-note\"\n          contenteditable=\"true\"\n          data-placeholder=\"Describe the project scope, objectives, and what is included in this proposal...\"\n          data-key=\"scopeNote\"\n          class=\"text-sm text-gray-700 min-h-[60px] whitespace-pre-wrap leading-relaxed focus:outline-none focus:bg-sky-50 focus:rounded px-1 -ml-1 block\">\n        </div>\n      </div>\n\n      <!-- Line items -->\n      <div class=\"px-8 pt-6 pb-2\">\n        <div class=\"text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3\">Line Items</div>\n        <div class=\"overflow-x-auto\">\n          <table class=\"w-full text-sm\" id=\"line-items-table\">\n            <thead>\n              <tr class=\"border-b-2 border-gray-200 text-left\">\n                <th class=\"pb-2 font-semibold text-gray-500 uppercase tracking-wider text-xs\">Description</th>\n                <th class=\"pb-2 font-semibold text-gray-500 uppercase tracking-wider text-xs text-center no-print w-24\">Type</th>\n                <th class=\"pb-2 font-semibold text-gray-500 uppercase tracking-wider text-xs text-right pr-3 w-16\">Qty</th>\n                <th class=\"pb-2 font-semibold text-gray-500 uppercase tracking-wider text-xs text-right pr-3 w-28\">Unit Price</th>\n                <th class=\"pb-2 font-semibold text-gray-500 uppercase tracking-wider text-xs text-right pr-3 w-20\">Disc %</th>\n                <th class=\"pb-2 font-semibold text-gray-500 uppercase tracking-wider text-xs text-right w-28\">Amount</th>\n                <th class=\"pb-2 no-print w-8\"></th>\n              </tr>\n            </thead>\n            <tbody id=\"line-items-body\">\n              <!-- rows injected by JS -->\n            </tbody>\n          </table>\n        </div>\n\n        <!-- Add row button -->\n        <div class=\"no-print mt-3 mb-4 flex gap-2\">\n          <button id=\"btn-add-row\"\n            class=\"flex items-center gap-1.5 text-sm text-sky-600 hover:text-sky-800 font-medium border border-dashed border-sky-300 hover:border-sky-500 rounded px-3 py-1.5 transition\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-4 w-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 4v16m8-8H4\"/>\n            </svg>\n            Add line item\n          </button>\n        </div>\n      </div>\n\n      <!-- Totals -->\n      <div class=\"px-8 pb-8\">\n        <div class=\"flex justify-end\">\n          <div class=\"w-full sm:w-80 border-t border-gray-200 pt-4 space-y-2\">\n            <div class=\"flex justify-between text-sm text-gray-600\">\n              <span>Subtotal</span>\n              <span id=\"subtotal-display\" class=\"font-medium tabular-nums\">$ 0.00</span>\n            </div>\n            <div class=\"flex justify-between text-sm text-gray-600\">\n              <div class=\"flex items-center gap-2\">\n                <span>Overall discount</span>\n                <div class=\"no-print flex items-center gap-1\">\n                  <input id=\"overall-discount\" type=\"number\" min=\"0\" max=\"100\" step=\"0.1\" value=\"0\"\n                    class=\"w-14 text-xs border border-gray-300 rounded px-1.5 py-0.5 text-right focus:outline-none focus:ring-2 focus:ring-sky-400\" />\n                  <span class=\"text-xs text-gray-400\">%</span>\n                </div>\n                <span id=\"overall-disc-pct-label\" class=\"print-only text-xs text-gray-400\"></span>\n              </div>\n              <span id=\"overall-discount-display\" class=\"font-medium tabular-nums text-rose-600\">- $ 0.00</span>\n            </div>\n            <div class=\"flex justify-between text-sm text-gray-600\">\n              <span id=\"tax-label\">Tax (0 %)</span>\n              <span id=\"tax-display\" class=\"font-medium tabular-nums\">$ 0.00</span>\n            </div>\n            <div class=\"flex justify-between text-base font-bold text-gray-800 border-t-2 border-gray-300 pt-3 mt-2\">\n              <span>Grand Total</span>\n              <span id=\"total-display\" class=\"tabular-nums text-sky-700 text-lg\">$ 0.00</span>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Terms & conditions -->\n      <div class=\"px-8 pb-8 border-t border-gray-100 pt-6\">\n        <div class=\"text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2\">Terms &amp; Conditions</div>\n        <div\n          id=\"terms\"\n          contenteditable=\"true\"\n          data-placeholder=\"Payment terms, delivery schedule, intellectual property notes, confidentiality, etc.\"\n          data-key=\"terms\"\n          class=\"text-sm text-gray-600 min-h-[60px] whitespace-pre-wrap leading-relaxed focus:outline-none focus:bg-sky-50 focus:rounded px-1 -ml-1 block\">\n        </div>\n      </div>\n\n      <!-- Signature block -->\n      <div class=\"px-8 pb-8 border-t border-gray-100 pt-6 grid grid-cols-1 sm:grid-cols-2 gap-10\">\n        <div>\n          <div class=\"text-xs font-semibold text-gray-400 uppercase tracking-wider mb-4\">Authorized By</div>\n          <div class=\"border-b border-gray-300 pb-1 mb-1 min-h-[32px]\"></div>\n          <div class=\"text-xs text-gray-400\">Signature &amp; Date</div>\n          <div\n            id=\"auth-name\"\n            contenteditable=\"true\"\n            data-placeholder=\"Name &amp; Title\"\n            data-key=\"authName\"\n            class=\"text-sm text-gray-600 mt-2 focus:outline-none focus:bg-sky-50 focus:rounded px-1 -ml-1 block\">\n          </div>\n        </div>\n        <div>\n          <div class=\"text-xs font-semibold text-gray-400 uppercase tracking-wider mb-4\">Accepted By (Client)</div>\n          <div class=\"border-b border-gray-300 pb-1 mb-1 min-h-[32px]\"></div>\n          <div class=\"text-xs text-gray-400\">Signature &amp; Date</div>\n          <div class=\"text-sm text-gray-400 mt-2 italic\">Client signature</div>\n        </div>\n      </div>\n\n      <!-- Footer band -->\n      <div class=\"bg-gray-50 border-t border-gray-200 px-8 py-4 text-center text-xs text-gray-400\">\n        <span id=\"footer-seller-name\"></span>\n        <span id=\"footer-quote-number\"></span>\n        &mdash; This quote is valid until <span id=\"footer-valid-until\">the date shown above</span>.\n      </div>\n\n    </div><!-- /quote-wrapper -->\n  </div><!-- /main area -->\n\n<script>\n(function () {\n  'use strict';\n\n  // ── Helpers ──────────────────────────────────────────────────────────────────\n  function escHtml(s) {\n    return String(s)\n      .replace(/&/g, '&amp;')\n      .replace(/\"/g, '&quot;')\n      .replace(/</g, '&lt;')\n      .replace(/>/g, '&gt;');\n  }\n\n  function fmtDate(d) {\n    var mm = ('0' + (d.getMonth() + 1)).slice(-2);\n    var dd = ('0' + d.getDate()).slice(-2);\n    return d.getFullYear() + '-' + mm + '-' + dd;\n  }\n\n  function formatMoney(n, sym) {\n    var num = Math.abs(n).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });\n    return sym + ' ' + num;\n  }\n\n  // ── Default state ────────────────────────────────────────────────────────────\n  var today = new Date();\n  var valid = new Date(today);\n  valid.setDate(valid.getDate() + 30);\n\n  var DEFAULT_LINES = [\n    { desc: 'Enterprise Platform License (annual)', qty: 1,  price: 24000, disc: 0,  type: 'one-time' },\n    { desc: 'Onboarding & Implementation Services', qty: 1,  price: 8500,  disc: 10, type: 'one-time' },\n    { desc: 'Priority Support & Success Manager',   qty: 12, price: 750,   disc: 0,  type: 'monthly'  },\n    { desc: 'Custom API Integration (hours)',        qty: 20, price: 195,   disc: 5,  type: 'one-time' }\n  ];\n\n  var DEFAULT_STATE = {\n    sellerName:      'Acme Solutions, Inc.',\n    sellerAddress:   '500 Market Street, Suite 1200\\nSan Francisco, CA 94105',\n    sellerContact:   'sales@acmesolutions.com  ·  (415) 555-0200',\n    clientName:      'Horizon Enterprises LLC',\n    clientContact:   'Contact: Sarah Mitchell · s.mitchell@horizonent.com',\n    clientAddress:   '200 Park Avenue, 31st Floor\\nNew York, NY 10166',\n    repName:         'Jordan Park, Senior Account Executive',\n    repContact:      'jordan.park@acmesolutions.com  ·  (415) 555-0212',\n    quoteNumber:     'Q-2025-042',\n    issueDate:       fmtDate(today),\n    validUntil:      fmtDate(valid),\n    scopeNote:       'This proposal covers the full deployment of the Acme Enterprise Platform for Horizon Enterprises, including software licensing, onboarding services, and ongoing support. All work will be delivered within 60 days of signed agreement.\\n\\nPricing is fixed for the scope described. Any additional requirements will be quoted separately.',\n    terms:           'Payment: 50% upon signature, 50% upon go-live.\\nDelivery: Implementation begins within 5 business days of signed agreement.\\nLicenses are non-transferable. Annual license auto-renews unless cancelled 30 days prior.\\nThis proposal is confidential and intended solely for the named recipient.',\n    authName:        'Jordan Park, Senior Account Executive',\n    currency:        '$',\n    taxRate:         0,\n    overallDiscount: 0,\n    lines:           JSON.parse(JSON.stringify(DEFAULT_LINES))\n  };\n\n  var state = JSON.parse(JSON.stringify(DEFAULT_STATE));\n\n  // ── LocalStorage ─────────────────────────────────────────────────────────────\n  var LS_KEY = 'quote-builder-v1';\n\n  function saveState() {\n    try { localStorage.setItem(LS_KEY, JSON.stringify(state)); } catch (e) {}\n  }\n\n  function loadState() {\n    try {\n      var raw = localStorage.getItem(LS_KEY);\n      if (!raw) return;\n      var saved = JSON.parse(raw);\n      Object.assign(state, saved);\n    } catch (e) {}\n  }\n\n  // ── DOM refs ─────────────────────────────────────────────────────────────────\n  var elSellerName     = document.getElementById('seller-name');\n  var elSellerAddress  = document.getElementById('seller-address');\n  var elSellerContact  = document.getElementById('seller-contact');\n  var elClientName     = document.getElementById('client-name');\n  var elClientContact  = document.getElementById('client-contact');\n  var elClientAddress  = document.getElementById('client-address');\n  var elRepName        = document.getElementById('rep-name');\n  var elRepContact     = document.getElementById('rep-contact');\n  var elQuoteNumber    = document.getElementById('quote-number');\n  var elIssueDate      = document.getElementById('issue-date');\n  var elValidUntil     = document.getElementById('valid-until');\n  var elScopeNote      = document.getElementById('scope-note');\n  var elTerms          = document.getElementById('terms');\n  var elAuthName       = document.getElementById('auth-name');\n  var elCurrency       = document.getElementById('currency-select');\n  var elTaxSelect      = document.getElementById('tax-select');\n  var elOverallDisc    = document.getElementById('overall-discount');\n  var elBody           = document.getElementById('line-items-body');\n  var elSubtotal       = document.getElementById('subtotal-display');\n  var elOverallDiscDisplay = document.getElementById('overall-discount-display');\n  var elTaxDisplay     = document.getElementById('tax-display');\n  var elTotal          = document.getElementById('total-display');\n  var elTaxLabel       = document.getElementById('tax-label');\n  var elFooterSeller   = document.getElementById('footer-seller-name');\n  var elFooterQuote    = document.getElementById('footer-quote-number');\n  var elFooterValid    = document.getElementById('footer-valid-until');\n  var btnAddRow        = document.getElementById('btn-add-row');\n  var btnNew           = document.getElementById('btn-new');\n\n  // ── Formatting ────────────────────────────────────────────────────────────────\n  function fmt(n) {\n    return formatMoney(n, state.currency);\n  }\n\n  // ── Render line items ─────────────────────────────────────────────────────────\n  function renderLines() {\n    elBody.innerHTML = '';\n    state.lines.forEach(function (line, idx) {\n      var qty   = parseFloat(line.qty)   || 0;\n      var price = parseFloat(line.price) || 0;\n      var disc  = parseFloat(line.disc)  || 0;\n      var lineSubtotal = qty * price;\n      var lineDiscount = lineSubtotal * disc / 100;\n      var amount = lineSubtotal - lineDiscount;\n      var type = line.type || 'one-time';\n      var badgeClass = type === 'monthly' ? 'badge-monthly' : 'badge-onetime';\n      var badgeLabel = type === 'monthly' ? 'Monthly' : 'One-time';\n\n      var tr = document.createElement('tr');\n      tr.className = 'border-b border-gray-100 group hover:bg-sky-50 transition-colors';\n      tr.dataset.idx = idx;\n\n      tr.innerHTML =\n        '<td class=\"py-2.5 pr-3\">' +\n          '<input type=\"text\" placeholder=\"Service or product description\" value=\"' + escHtml(line.desc) + '\" ' +\n                 'data-field=\"desc\" data-idx=\"' + idx + '\" ' +\n                 'class=\"w-full border-0 border-b border-transparent focus:border-sky-400 focus:outline-none bg-transparent text-gray-700 text-sm py-0.5 transition-colors\" />' +\n        '</td>' +\n        '<td class=\"py-2.5 text-center no-print\">' +\n          '<button data-type-toggle=\"' + idx + '\" ' +\n                  'class=\"text-xs font-semibold px-2 py-0.5 rounded-full ' + badgeClass + ' hover:opacity-80 transition cursor-pointer\" ' +\n                  'title=\"Click to toggle One-time / Monthly\">' + badgeLabel + '</button>' +\n        '</td>' +\n        '<td class=\"py-2.5 pr-3 text-right\">' +\n          '<input type=\"number\" min=\"0\" step=\"0.01\" value=\"' + line.qty + '\" ' +\n                 'data-field=\"qty\" data-idx=\"' + idx + '\" ' +\n                 'class=\"w-14 border-0 border-b border-transparent focus:border-sky-400 focus:outline-none bg-transparent text-gray-700 text-sm text-right py-0.5 transition-colors\" />' +\n        '</td>' +\n        '<td class=\"py-2.5 pr-3 text-right\">' +\n          '<input type=\"number\" min=\"0\" step=\"0.01\" value=\"' + line.price + '\" ' +\n                 'data-field=\"price\" data-idx=\"' + idx + '\" ' +\n                 'class=\"w-24 border-0 border-b border-transparent focus:border-sky-400 focus:outline-none bg-transparent text-gray-700 text-sm text-right py-0.5 transition-colors\" />' +\n        '</td>' +\n        '<td class=\"py-2.5 pr-3 text-right\">' +\n          '<input type=\"number\" min=\"0\" max=\"100\" step=\"0.1\" value=\"' + (disc > 0 ? disc : '') + '\" placeholder=\"0\" ' +\n                 'data-field=\"disc\" data-idx=\"' + idx + '\" ' +\n                 'class=\"w-16 border-0 border-b border-transparent focus:border-sky-400 focus:outline-none bg-transparent text-gray-700 text-sm text-right py-0.5 transition-colors\" />' +\n        '</td>' +\n        '<td class=\"py-2.5 text-right text-gray-800 font-medium tabular-nums whitespace-nowrap amount-cell\">' +\n          fmt(amount) +\n        '</td>' +\n        '<td class=\"py-2.5 pl-2 no-print\">' +\n          '<button data-remove=\"' + idx + '\" ' +\n                  'class=\"opacity-0 group-hover:opacity-100 text-gray-300 hover:text-red-500 transition text-xl leading-none font-light\" ' +\n                  'title=\"Remove row\">&times;</button>' +\n        '</td>';\n\n      elBody.appendChild(tr);\n    });\n\n    updateTotals();\n  }\n\n  // ── Compute and update totals ──────────────────────────────────────────────\n  function updateTotals() {\n    // Line-level subtotals (after per-line discounts)\n    var lineDiscountTotal = 0;\n    var grossSubtotal = 0;\n    var netSubtotal = 0;\n\n    state.lines.forEach(function (l) {\n      var qty   = parseFloat(l.qty)   || 0;\n      var price = parseFloat(l.price) || 0;\n      var disc  = parseFloat(l.disc)  || 0;\n      var lineSub = qty * price;\n      var lineDisc = lineSub * disc / 100;\n      grossSubtotal += lineSub;\n      lineDiscountTotal += lineDisc;\n      netSubtotal += lineSub - lineDisc;\n    });\n\n    var overallDiscPct = parseFloat(state.overallDiscount) || 0;\n    var overallDiscAmt = netSubtotal * overallDiscPct / 100;\n    var afterDiscounts = netSubtotal - overallDiscAmt;\n\n    var taxRate = parseFloat(state.taxRate) || 0;\n    var taxAmt  = afterDiscounts * taxRate / 100;\n    var grandTotal = afterDiscounts + taxAmt;\n\n    elSubtotal.textContent = fmt(grossSubtotal);\n    elOverallDiscDisplay.textContent = lineDiscountTotal + overallDiscAmt > 0\n      ? '- ' + fmt(lineDiscountTotal + overallDiscAmt)\n      : fmt(0);\n    elTaxDisplay.textContent = fmt(taxAmt);\n    elTotal.textContent      = fmt(grandTotal);\n    elTaxLabel.textContent   = 'Tax (' + taxRate + ' %)';\n\n    // Update individual amount cells\n    var amtCells = elBody.querySelectorAll('.amount-cell');\n    amtCells.forEach(function (cell, idx) {\n      var l = state.lines[idx];\n      if (!l) return;\n      var qty   = parseFloat(l.qty)   || 0;\n      var price = parseFloat(l.price) || 0;\n      var disc  = parseFloat(l.disc)  || 0;\n      var lineSub = qty * price;\n      cell.textContent = fmt(lineSub - lineSub * disc / 100);\n    });\n  }\n\n  // ── Update footer ──────────────────────────────────────────────────────────\n  function updateFooter() {\n    elFooterSeller.textContent = state.sellerName ? state.sellerName + '  ' : '';\n    elFooterQuote.textContent  = state.quoteNumber ? '·  ' + state.quoteNumber + '  ' : '';\n    elFooterValid.textContent  = state.validUntil  || 'the date shown above';\n  }\n\n  // ── Populate fields from state ─────────────────────────────────────────────\n  function populateFields() {\n    elSellerName.textContent    = state.sellerName;\n    elSellerAddress.textContent = state.sellerAddress;\n    elSellerContact.textContent = state.sellerContact;\n    elClientName.textContent    = state.clientName;\n    elClientContact.textContent = state.clientContact;\n    elClientAddress.textContent = state.clientAddress;\n    elRepName.textContent       = state.repName;\n    elRepContact.textContent    = state.repContact;\n    elScopeNote.textContent     = state.scopeNote;\n    elTerms.textContent         = state.terms;\n    elAuthName.textContent      = state.authName;\n    elQuoteNumber.value         = state.quoteNumber;\n    elIssueDate.value           = state.issueDate;\n    elValidUntil.value          = state.validUntil;\n    elCurrency.value            = state.currency;\n    elTaxSelect.value           = String(state.taxRate);\n    elOverallDisc.value         = state.overallDiscount;\n    updateFooter();\n    renderLines();\n  }\n\n  // ── Bind contenteditable fields ───────────────────────────────────────────\n  var ceFields = [\n    elSellerName, elSellerAddress, elSellerContact,\n    elClientName, elClientContact, elClientAddress,\n    elRepName, elRepContact,\n    elScopeNote, elTerms, elAuthName\n  ];\n\n  ceFields.forEach(function (el) {\n    el.addEventListener('input', function () {\n      var key = el.dataset.key;\n      if (!key) return;\n      state[key] = el.textContent;\n      if (key === 'sellerName' || key === 'quoteNumber' || key === 'validUntil') updateFooter();\n      saveState();\n    });\n  });\n\n  // ── Bind simple inputs ─────────────────────────────────────────────────────\n  function bindInput(el, key, cb) {\n    el.addEventListener('input', function () {\n      state[key] = el.value;\n      if (cb) cb();\n      saveState();\n    });\n    el.addEventListener('change', function () {\n      state[key] = el.value;\n      if (cb) cb();\n      saveState();\n    });\n  }\n\n  bindInput(elQuoteNumber, 'quoteNumber', updateFooter);\n  bindInput(elIssueDate,   'issueDate');\n  bindInput(elValidUntil,  'validUntil',  updateFooter);\n\n  elCurrency.addEventListener('change', function () {\n    state.currency = elCurrency.value;\n    updateTotals();\n    saveState();\n  });\n\n  elTaxSelect.addEventListener('change', function () {\n    state.taxRate = parseFloat(elTaxSelect.value) || 0;\n    updateTotals();\n    saveState();\n  });\n\n  elOverallDisc.addEventListener('input', function () {\n    state.overallDiscount = parseFloat(elOverallDisc.value) || 0;\n    updateTotals();\n    saveState();\n  });\n\n  // ── Line item table delegation ─────────────────────────────────────────────\n  elBody.addEventListener('input', function (e) {\n    var el = e.target;\n    var idx = parseInt(el.dataset.idx, 10);\n    var field = el.dataset.field;\n    if (isNaN(idx) || !field) return;\n    if (field === 'desc')  state.lines[idx].desc  = el.value;\n    if (field === 'qty')   state.lines[idx].qty   = el.value;\n    if (field === 'price') state.lines[idx].price = el.value;\n    if (field === 'disc')  state.lines[idx].disc  = el.value;\n    updateTotals();\n    saveState();\n  });\n\n  elBody.addEventListener('click', function (e) {\n    // Remove row\n    var removeBtn = e.target.closest('[data-remove]');\n    if (removeBtn) {\n      var idx = parseInt(removeBtn.dataset.remove, 10);\n      if (!isNaN(idx)) {\n        state.lines.splice(idx, 1);\n        renderLines();\n        saveState();\n      }\n      return;\n    }\n    // Toggle type\n    var typeBtn = e.target.closest('[data-type-toggle]');\n    if (typeBtn) {\n      var tidx = parseInt(typeBtn.dataset.typeToggle, 10);\n      if (!isNaN(tidx)) {\n        var cur = state.lines[tidx].type || 'one-time';\n        state.lines[tidx].type = (cur === 'one-time') ? 'monthly' : 'one-time';\n        renderLines();\n        saveState();\n      }\n    }\n  });\n\n  btnAddRow.addEventListener('click', function () {\n    state.lines.push({ desc: '', qty: 1, price: 0, disc: 0, type: 'one-time' });\n    renderLines();\n    saveState();\n    var rows = elBody.querySelectorAll('tr');\n    var lastRow = rows[rows.length - 1];\n    if (lastRow) {\n      var inp = lastRow.querySelector('input[data-field=\"desc\"]');\n      if (inp) inp.focus();\n    }\n  });\n\n  // ── New Quote ──────────────────────────────────────────────────────────────\n  btnNew.addEventListener('click', function () {\n    if (!confirm('Start a new quote? All current data will be cleared.')) return;\n    var newToday = new Date();\n    var newValid = new Date(newToday);\n    newValid.setDate(newValid.getDate() + 30);\n    var fresh = JSON.parse(JSON.stringify(DEFAULT_STATE));\n    fresh.issueDate  = fmtDate(newToday);\n    fresh.validUntil = fmtDate(newValid);\n    // Increment quote number if possible\n    if (state.quoteNumber) {\n      var parts = state.quoteNumber.match(/^(.*?)(\\d+)$/);\n      if (parts) {\n        fresh.quoteNumber = parts[1] + (parseInt(parts[2], 10) + 1);\n      }\n    }\n    // Preserve seller/rep info\n    fresh.sellerName    = state.sellerName;\n    fresh.sellerAddress = state.sellerAddress;\n    fresh.sellerContact = state.sellerContact;\n    fresh.repName       = state.repName;\n    fresh.repContact    = state.repContact;\n    fresh.currency      = state.currency;\n    fresh.taxRate       = state.taxRate;\n    // Clear client + deal info\n    fresh.clientName    = '';\n    fresh.clientContact = '';\n    fresh.clientAddress = '';\n    fresh.scopeNote     = '';\n    fresh.terms         = DEFAULT_STATE.terms;\n    fresh.lines         = [{ desc: '', qty: 1, price: 0, disc: 0, type: 'one-time' }];\n    Object.assign(state, fresh);\n    populateFields();\n    saveState();\n  });\n\n  // ── Init ──────────────────────────────────────────────────────────────────\n  loadState();\n  populateFields();\n\n}());\n</script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Quote Builder",
    "windowTitle": "Quote Builder",
    "bundleId": "com.halisonworks.quotebuilder",
    "iconPath": null
  },
  "categoryId": null,
  "source": "import",
  "createdAt": "2026-06-02T12:00:00.000Z",
  "updatedAt": "2026-06-02T12:00:00.000Z",
  "sharedAt": "2026-06-02T12:00:00.000Z"
}
