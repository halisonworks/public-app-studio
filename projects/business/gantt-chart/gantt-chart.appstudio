{
  "schema": "app-studio/canvas@1",
  "id": "example-gantt-chart",
  "name": "gantt-chart.html",
  "code": "<!DOCTYPE html>\n<!--\n  Gantt Chart — Halison App Studio example\n\n  A project timeline: tasks with dates, duration, % complete and assignees, drawn\n  as bars on a scaled time grid with a \"today\" line. Saves to your browser.\n\n  From the Halison App Studio public library:\n  https://github.com/halisonworks/public-app-studio\n\n  Permitted use: personal, educational, and other non-commercial use. You may\n  modify it, but keep this header and the source link intact, and do not sell,\n  commercialize, or republish it. Released under the Halison App Studio Examples\n  License — see the LICENSE file in the repository above.\n-->\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Gantt Chart</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    * { box-sizing: border-box; }\n    body { font-family: 'Inter', system-ui, sans-serif; }\n\n    /* Timeline grid */\n    #timeline-scroll { overflow-x: auto; overflow-y: visible; }\n    .gantt-row { display: flex; align-items: center; min-height: 44px; }\n    .gantt-bar-wrap { position: relative; height: 28px; }\n    .gantt-bar-bg {\n      position: absolute; top: 0; left: 0; right: 0; bottom: 0;\n      border-radius: 6px; opacity: 0.25;\n    }\n    .gantt-bar-fill {\n      position: absolute; top: 0; left: 0; bottom: 0;\n      border-radius: 6px;\n      transition: width 0.3s ease;\n    }\n    .gantt-bar-label {\n      position: absolute; top: 50%; left: 6px;\n      transform: translateY(-50%);\n      font-size: 11px; font-weight: 600; white-space: nowrap;\n      color: white; pointer-events: none; text-shadow: 0 1px 2px rgba(0,0,0,0.4);\n    }\n    .today-line {\n      position: absolute; top: 0; bottom: 0; width: 2px;\n      background: #ef4444; z-index: 20; pointer-events: none;\n    }\n    .today-label {\n      position: absolute; top: 2px; left: 3px;\n      font-size: 10px; font-weight: 700; color: #ef4444; white-space: nowrap;\n    }\n    .day-col { border-right: 1px solid #e5e7eb; }\n    .weekend-col { background: #f9fafb; }\n    .month-header { border-right: 2px solid #d1d5db; }\n\n    /* Modal overlay */\n    #modal-overlay {\n      position: fixed; inset: 0; background: rgba(0,0,0,0.45);\n      display: flex; align-items: center; justify-content: center; z-index: 100;\n    }\n    #modal-overlay.hidden { display: none; }\n\n    /* Scrollbar styling */\n    #timeline-scroll::-webkit-scrollbar { height: 6px; }\n    #timeline-scroll::-webkit-scrollbar-track { background: #f1f5f9; }\n    #timeline-scroll::-webkit-scrollbar-thumb { background: #94a3b8; border-radius: 3px; }\n\n    .task-row-hover:hover { background: #f8fafc; }\n    input[type=\"range\"] { accent-color: #6366f1; }\n  </style>\n</head>\n<body class=\"bg-gray-50 min-h-screen\">\n\n<!-- Header -->\n<header class=\"bg-white border-b border-gray-200 px-6 py-4 flex items-center justify-between shadow-sm\">\n  <div class=\"flex items-center gap-3\">\n    <div class=\"w-8 h-8 bg-indigo-600 rounded-lg flex items-center justify-center\">\n      <svg class=\"w-4 h-4 text-white\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\">\n        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2\"/>\n      </svg>\n    </div>\n    <div>\n      <h1 class=\"text-lg font-bold text-gray-900 leading-none\">Project Timeline</h1>\n      <p class=\"text-xs text-gray-500 mt-0.5\" id=\"project-subtitle\">Loading…</p>\n    </div>\n  </div>\n  <div class=\"flex items-center gap-2\">\n    <div class=\"flex items-center bg-gray-100 rounded-lg p-1 text-sm\">\n      <button onclick=\"setView('day')\" id=\"btn-day\"\n        class=\"px-3 py-1 rounded-md font-medium transition-colors\">Day</button>\n      <button onclick=\"setView('week')\" id=\"btn-week\"\n        class=\"px-3 py-1 rounded-md font-medium transition-colors\">Week</button>\n    </div>\n    <button onclick=\"openModal(null)\"\n      class=\"flex items-center gap-1.5 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium px-3 py-2 rounded-lg transition-colors\">\n      <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\">\n        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 4v16m8-8H4\"/>\n      </svg>\n      Add Task\n    </button>\n  </div>\n</header>\n\n<!-- Main layout -->\n<div class=\"flex\" style=\"height: calc(100vh - 65px);\">\n\n  <!-- Left task list -->\n  <div class=\"bg-white border-r border-gray-200 flex-shrink-0 flex flex-col\" style=\"width:320px;\">\n    <div class=\"grid grid-cols-12 text-xs font-semibold text-gray-500 uppercase tracking-wide border-b border-gray-200 px-4 py-2 bg-gray-50\">\n      <div class=\"col-span-5\">Task</div>\n      <div class=\"col-span-3\">Assignee</div>\n      <div class=\"col-span-2 text-center\">Done</div>\n      <div class=\"col-span-2\"></div>\n    </div>\n    <div id=\"task-list\" class=\"flex-1 overflow-y-auto\"></div>\n    <div class=\"border-t border-gray-100 px-4 py-2\">\n      <p class=\"text-xs text-gray-400\" id=\"task-count\">0 tasks</p>\n    </div>\n  </div>\n\n  <!-- Right timeline -->\n  <div class=\"flex-1 flex flex-col overflow-hidden\">\n    <div id=\"timeline-scroll\" class=\"flex-1 overflow-x-auto overflow-y-auto relative\">\n      <div id=\"timeline-inner\" class=\"relative\" style=\"min-width: 100%;\">\n        <!-- Header rows injected by JS -->\n        <div id=\"timeline-header\" class=\"sticky top-0 z-10 bg-white border-b border-gray-200 shadow-sm\"></div>\n        <!-- Bar rows injected by JS -->\n        <div id=\"timeline-body\" class=\"relative\"></div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<!-- Modal -->\n<div id=\"modal-overlay\" class=\"hidden\">\n  <div class=\"bg-white rounded-2xl shadow-2xl w-full max-w-lg mx-4 overflow-hidden\">\n    <div class=\"flex items-center justify-between px-6 py-4 border-b border-gray-100\">\n      <h2 class=\"text-lg font-bold text-gray-900\" id=\"modal-title\">Add Task</h2>\n      <button onclick=\"closeModal()\" class=\"text-gray-400 hover:text-gray-600 transition-colors\">\n        <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M6 18L18 6M6 6l12 12\"/>\n        </svg>\n      </button>\n    </div>\n    <div class=\"px-6 py-5 space-y-4\">\n      <div>\n        <label class=\"block text-sm font-medium text-gray-700 mb-1\">Task name <span class=\"text-red-500\">*</span></label>\n        <input id=\"f-name\" type=\"text\" placeholder=\"e.g. Design homepage wireframes\"\n          class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500\"/>\n      </div>\n      <div class=\"grid grid-cols-2 gap-4\">\n        <div>\n          <label class=\"block text-sm font-medium text-gray-700 mb-1\">Start date <span class=\"text-red-500\">*</span></label>\n          <input id=\"f-start\" type=\"date\"\n            class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500\"/>\n        </div>\n        <div>\n          <label class=\"block text-sm font-medium text-gray-700 mb-1\">End date <span class=\"text-red-500\">*</span></label>\n          <input id=\"f-end\" type=\"date\"\n            class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500\"/>\n        </div>\n      </div>\n      <div class=\"grid grid-cols-2 gap-4\">\n        <div>\n          <label class=\"block text-sm font-medium text-gray-700 mb-1\">Assignee</label>\n          <input id=\"f-assignee\" type=\"text\" placeholder=\"e.g. Alice\"\n            class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500\"/>\n        </div>\n        <div>\n          <label class=\"block text-sm font-medium text-gray-700 mb-1\">Color</label>\n          <div class=\"flex items-center gap-2\">\n            <input id=\"f-color\" type=\"color\" value=\"#6366f1\"\n              class=\"w-10 h-9 border border-gray-300 rounded-lg cursor-pointer p-0.5\"/>\n            <div id=\"color-swatches\" class=\"flex gap-1.5\"></div>\n          </div>\n        </div>\n      </div>\n      <div>\n        <label class=\"block text-sm font-medium text-gray-700 mb-1\">\n          % Complete: <span id=\"pct-display\" class=\"text-indigo-600 font-bold\">0%</span>\n        </label>\n        <input id=\"f-pct\" type=\"range\" min=\"0\" max=\"100\" value=\"0\" step=\"5\"\n          class=\"w-full\"\n          oninput=\"document.getElementById('pct-display').textContent=this.value+'%'\"/>\n      </div>\n    </div>\n    <div class=\"flex items-center justify-between px-6 py-4 border-t border-gray-100 bg-gray-50\">\n      <button id=\"btn-delete\" onclick=\"deleteTask()\" class=\"text-sm text-red-500 hover:text-red-700 font-medium hidden transition-colors\">\n        Delete task\n      </button>\n      <div class=\"flex gap-2 ml-auto\">\n        <button onclick=\"closeModal()\" class=\"px-4 py-2 text-sm font-medium text-gray-600 hover:text-gray-800 transition-colors\">Cancel</button>\n        <button onclick=\"saveTask()\"\n          class=\"px-5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium rounded-lg transition-colors\">Save</button>\n      </div>\n    </div>\n  </div>\n</div>\n\n<script>\n// ─── Colour palette ───────────────────────────────────────────────────────────\nconst SWATCHES = ['#6366f1','#0ea5e9','#10b981','#f59e0b','#ef4444','#8b5cf6','#ec4899','#14b8a6'];\n\n// ─── Default sample tasks (dates relative to today) ──────────────────────────\nfunction buildDefaultTasks() {\n  const today = new Date();\n  today.setHours(0,0,0,0);\n  const d = (offset) => {\n    const dt = new Date(today);\n    dt.setDate(dt.getDate() + offset);\n    return dt.toISOString().slice(0,10);\n  };\n  return [\n    { id: uid(), name: 'Discovery & Requirements', start: d(-18), end: d(-11), assignee: 'Sarah K.', color: '#6366f1', pct: 100 },\n    { id: uid(), name: 'UX Wireframes & Prototypes', start: d(-14), end: d(-4),  assignee: 'Marcus T.', color: '#0ea5e9', pct: 90  },\n    { id: uid(), name: 'Frontend Development',       start: d(-8),  end: d(10),  assignee: 'Priya N.', color: '#10b981', pct: 55  },\n    { id: uid(), name: 'Backend API Integration',    start: d(-5),  end: d(12),  assignee: 'James R.', color: '#f59e0b', pct: 40  },\n    { id: uid(), name: 'QA & Testing',               start: d(8),   end: d(18),  assignee: 'Laura M.', color: '#8b5cf6', pct: 0   },\n    { id: uid(), name: 'Deployment & Launch',        start: d(17),  end: d(22),  assignee: 'Sarah K.', color: '#ef4444', pct: 0   },\n  ];\n}\n\nfunction uid() { return Math.random().toString(36).slice(2,10); }\n\n// ─── State ────────────────────────────────────────────────────────────────────\nlet tasks = [];\nlet viewMode = 'day'; // 'day' | 'week'\nlet editingId = null;\n\n// ─── Persistence ─────────────────────────────────────────────────────────────\nfunction load() {\n  try {\n    const raw = localStorage.getItem('gantt_tasks_v2');\n    tasks = raw ? JSON.parse(raw) : buildDefaultTasks();\n  } catch(e) { tasks = buildDefaultTasks(); }\n  const vm = localStorage.getItem('gantt_view');\n  if (vm === 'week') viewMode = 'week';\n}\nfunction save() {\n  localStorage.setItem('gantt_tasks_v2', JSON.stringify(tasks));\n  localStorage.setItem('gantt_view', viewMode);\n}\n\n// ─── Date helpers ─────────────────────────────────────────────────────────────\nconst DAY_MS = 86400000;\nfunction parseDate(s) { return new Date(s + 'T00:00:00'); }\nfunction fmtDate(d) { return d.toISOString().slice(0,10); }\nfunction addDays(d, n) { const r = new Date(d); r.setDate(r.getDate()+n); return r; }\nfunction daysBetween(a,b) { return Math.round((b-a)/DAY_MS); }\nfunction today() { const d = new Date(); d.setHours(0,0,0,0); return d; }\nfunction monthName(d) { return d.toLocaleString('en-US',{month:'short'}); }\nfunction dayName(d) { return d.toLocaleString('en-US',{weekday:'short'}); }\nfunction isWeekend(d) { const w = d.getDay(); return w===0||w===6; }\n\n// ─── Timeline range ───────────────────────────────────────────────────────────\nfunction getRange() {\n  if (!tasks.length) {\n    const t = today();\n    return { start: addDays(t,-7), end: addDays(t,14) };\n  }\n  let minD = parseDate(tasks[0].start);\n  let maxD = parseDate(tasks[0].end);\n  for (const t of tasks) {\n    const s = parseDate(t.start), e = parseDate(t.end);\n    if (s < minD) minD = s;\n    if (e > maxD) maxD = e;\n  }\n  // Pad 5 days each side\n  return { start: addDays(minD,-5), end: addDays(maxD,5) };\n}\n\n// ─── View toggle ──────────────────────────────────────────────────────────────\nfunction setView(v) {\n  viewMode = v;\n  save();\n  renderAll();\n}\n\n// ─── Render everything ────────────────────────────────────────────────────────\nfunction renderAll() {\n  // View buttons\n  document.getElementById('btn-day').className =\n    'px-3 py-1 rounded-md font-medium transition-colors ' +\n    (viewMode==='day' ? 'bg-white shadow text-indigo-700' : 'text-gray-500 hover:text-gray-700');\n  document.getElementById('btn-week').className =\n    'px-3 py-1 rounded-md font-medium transition-colors ' +\n    (viewMode==='week' ? 'bg-white shadow text-indigo-700' : 'text-gray-500 hover:text-gray-700');\n\n  // Subtitle\n  document.getElementById('project-subtitle').textContent =\n    tasks.length + (tasks.length===1?' task':' tasks') + ' · Today: ' + today().toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'});\n\n  renderTaskList();\n  renderTimeline();\n}\n\n// ─── Task list (left panel) ────────────────────────────────────────────────────\nfunction renderTaskList() {\n  const container = document.getElementById('task-list');\n  document.getElementById('task-count').textContent = tasks.length + (tasks.length===1?' task':' tasks');\n  if (!tasks.length) {\n    container.innerHTML = '<div class=\"p-6 text-center text-gray-400 text-sm\">No tasks yet.<br/>Click <strong>Add Task</strong> to get started.</div>';\n    return;\n  }\n  container.innerHTML = tasks.map((t,i) => {\n    const dur = daysBetween(parseDate(t.start), parseDate(t.end));\n    const initials = t.assignee ? t.assignee.split(' ').map(w=>w[0]).join('').slice(0,2).toUpperCase() : '?';\n    return `\n    <div class=\"grid grid-cols-12 items-center px-4 py-2 border-b border-gray-100 task-row-hover min-h-[44px]\" style=\"min-height:44px\">\n      <div class=\"col-span-5 flex items-center gap-2 min-w-0\">\n        <div class=\"w-2.5 h-2.5 rounded-sm flex-shrink-0\" style=\"background:${t.color}\"></div>\n        <span class=\"text-sm font-medium text-gray-800 truncate\" title=\"${esc(t.name)}\">${esc(t.name)}</span>\n      </div>\n      <div class=\"col-span-3 flex items-center gap-1 min-w-0\">\n        <div class=\"w-6 h-6 rounded-full flex items-center justify-center text-white text-xs font-bold flex-shrink-0\" style=\"background:${t.color}\">${initials}</div>\n        <span class=\"text-xs text-gray-500 truncate\" title=\"${esc(t.assignee||'')}\">${esc(t.assignee||'—')}</span>\n      </div>\n      <div class=\"col-span-2 text-center\">\n        <span class=\"text-xs font-semibold\" style=\"color:${t.color}\">${t.pct}%</span>\n      </div>\n      <div class=\"col-span-2 flex justify-end\">\n        <button onclick=\"openModal('${t.id}')\" class=\"text-gray-400 hover:text-indigo-600 transition-colors p-1 rounded\" title=\"Edit task\">\n          <svg class=\"w-3.5 h-3.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M15.232 5.232l3.536 3.536M9 11l6-6 3 3-6 6H9v-3z\"/>\n          </svg>\n        </button>\n      </div>\n    </div>`;\n  }).join('');\n}\n\nfunction esc(s) {\n  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;');\n}\n\n// ─── Timeline ─────────────────────────────────────────────────────────────────\nfunction renderTimeline() {\n  const { start, end } = getRange();\n  const headerEl = document.getElementById('timeline-header');\n  const bodyEl = document.getElementById('timeline-body');\n\n  if (viewMode === 'day') {\n    renderDayView(start, end, headerEl, bodyEl);\n  } else {\n    renderWeekView(start, end, headerEl, bodyEl);\n  }\n}\n\nconst COL_W_DAY = 36;   // px per day in day-view\nconst COL_W_WEEK = 100; // px per week in week-view\nconst ROW_H = 44;\n\nfunction renderDayView(start, end, headerEl, bodyEl) {\n  const totalDays = daysBetween(start, end) + 1;\n  const totalW = totalDays * COL_W_DAY;\n\n  // Build month segments for top header\n  let months = [];\n  let cur = new Date(start);\n  while (cur <= end) {\n    const m = cur.getMonth(), y = cur.getFullYear();\n    let count = 0;\n    while (cur <= end && cur.getMonth()===m && cur.getFullYear()===y) {\n      count++; cur = addDays(cur,1);\n    }\n    months.push({ label: monthName(new Date(y,m,1)) + ' ' + y, days: count });\n  }\n\n  // Month row\n  let monthCols = months.map(m =>\n    `<div class=\"month-header inline-flex items-center justify-center text-xs font-semibold text-gray-600 border-r-2 border-gray-300 bg-gray-50\"\n      style=\"width:${m.days*COL_W_DAY}px;height:24px;flex-shrink:0;\">${m.label}</div>`\n  ).join('');\n\n  // Day row\n  let dayCols = '';\n  let dayIdx = new Date(start);\n  for (let i=0; i<totalDays; i++) {\n    const we = isWeekend(dayIdx);\n    const isToday = fmtDate(dayIdx)===fmtDate(today());\n    dayCols += `<div class=\"day-col ${we?'weekend-col':''} inline-flex flex-col items-center justify-center flex-shrink-0 border-b border-gray-200\"\n      style=\"width:${COL_W_DAY}px;height:30px;\">\n      <span class=\"text-[9px] font-medium ${isToday?'text-red-500 font-bold':we?'text-gray-400':'text-gray-500'}\">${dayName(dayIdx)[0]}</span>\n      <span class=\"text-[9px] ${isToday?'text-red-500 font-bold':we?'text-gray-400':'text-gray-500'}\">${dayIdx.getDate()}</span>\n    </div>`;\n    dayIdx = addDays(dayIdx,1);\n  }\n\n  headerEl.innerHTML = `\n    <div style=\"width:${totalW}px;position:relative;\">\n      <div class=\"flex\" style=\"height:24px;\">${monthCols}</div>\n      <div class=\"flex\" style=\"height:30px;\">${dayCols}</div>\n    </div>`;\n\n  // Body\n  const todayOffset = daysBetween(start, today());\n  let bodyHTML = `<div style=\"width:${totalW}px;position:relative;min-height:${Math.max(tasks.length,1)*ROW_H}px;\">`;\n\n  // Column backgrounds (weekends + today)\n  for (let i=0; i<totalDays; i++) {\n    const d = addDays(start,i);\n    const isT = fmtDate(d)===fmtDate(today());\n    const isWE = isWeekend(d);\n    if (isWE || isT) {\n      bodyHTML += `<div style=\"position:absolute;left:${i*COL_W_DAY}px;top:0;width:${COL_W_DAY}px;bottom:0;\n        background:${isT?'rgba(239,68,68,0.05)':isWE?'rgba(0,0,0,0.015)':'transparent'};pointer-events:none;\"></div>`;\n    }\n  }\n\n  // Vertical grid lines\n  for (let i=0; i<=totalDays; i++) {\n    bodyHTML += `<div style=\"position:absolute;left:${i*COL_W_DAY}px;top:0;bottom:0;width:1px;background:#f0f0f0;pointer-events:none;\"></div>`;\n  }\n\n  // Task bars\n  tasks.forEach((t, idx) => {\n    const s = parseDate(t.start), e = parseDate(t.end);\n    const left = Math.max(0, daysBetween(start, s)) * COL_W_DAY;\n    const dur = Math.max(1, daysBetween(s, e) + 1);\n    const width = dur * COL_W_DAY;\n    const top = idx * ROW_H + 8;\n    const fillW = Math.round(width * t.pct / 100);\n    bodyHTML += `\n      <div class=\"gantt-bar-wrap\" style=\"position:absolute;left:${left}px;top:${top}px;width:${width}px;\" onclick=\"openModal('${t.id}')\" title=\"${esc(t.name)} (${t.pct}% complete)\">\n        <div class=\"gantt-bar-bg\" style=\"background:${t.color};\"></div>\n        <div class=\"gantt-bar-fill\" style=\"background:${t.color};width:${fillW}px;\"></div>\n        <span class=\"gantt-bar-label\">${t.pct>0?t.pct+'% · ':''} ${esc(t.name)}</span>\n      </div>`;\n  });\n\n  // Today line\n  if (todayOffset >= 0 && todayOffset < totalDays) {\n    const tx = todayOffset * COL_W_DAY + COL_W_DAY/2;\n    bodyHTML += `<div class=\"today-line\" style=\"left:${tx}px;\"><span class=\"today-label\">Today</span></div>`;\n  }\n\n  bodyHTML += '</div>';\n  bodyEl.innerHTML = bodyHTML;\n\n  // Scroll today into view\n  setTimeout(() => {\n    const scroll = document.getElementById('timeline-scroll');\n    const todayPx = todayOffset * COL_W_DAY - scroll.clientWidth/2 + COL_W_DAY/2;\n    scroll.scrollLeft = Math.max(0, todayPx);\n  }, 50);\n}\n\nfunction renderWeekView(start, end, headerEl, bodyEl) {\n  // Align start to Monday\n  const startMon = new Date(start);\n  startMon.setDate(startMon.getDate() - ((startMon.getDay()+6)%7));\n\n  const weeks = [];\n  let cur = new Date(startMon);\n  while (cur <= end) {\n    weeks.push(new Date(cur));\n    cur = addDays(cur, 7);\n  }\n  const totalW = weeks.length * COL_W_WEEK;\n\n  // Month header\n  let months = [];\n  weeks.forEach(w => {\n    const m = monthName(w) + ' ' + w.getFullYear();\n    if (!months.length || months[months.length-1].label !== m) {\n      months.push({ label: m, count: 1 });\n    } else { months[months.length-1].count++; }\n  });\n\n  const monthCols = months.map(m =>\n    `<div class=\"month-header inline-flex items-center justify-center text-xs font-semibold text-gray-600 bg-gray-50 border-r-2 border-gray-300\"\n      style=\"width:${m.count*COL_W_WEEK}px;height:24px;flex-shrink:0;\">${m.label}</div>`\n  ).join('');\n\n  const weekCols = weeks.map((w,i) => {\n    const isCurrentWeek = fmtDate(w) <= fmtDate(today()) && fmtDate(today()) <= fmtDate(addDays(w,6));\n    return `<div class=\"day-col inline-flex items-center justify-center text-xs font-medium border-b border-gray-200 flex-shrink-0\"\n      style=\"width:${COL_W_WEEK}px;height:30px;\" >\n      <span class=\"${isCurrentWeek?'text-red-500 font-bold':'text-gray-500'}\">\n        ${w.toLocaleDateString('en-US',{month:'short',day:'numeric'})} – ${addDays(w,6).toLocaleDateString('en-US',{month:'short',day:'numeric'})}\n      </span>\n    </div>`;\n  }).join('');\n\n  headerEl.innerHTML = `<div style=\"width:${totalW}px;\">\n    <div class=\"flex\" style=\"height:24px;\">${monthCols}</div>\n    <div class=\"flex\" style=\"height:30px;\">${weekCols}</div>\n  </div>`;\n\n  // Body\n  const todayWeekIdx = weeks.findIndex(w => fmtDate(w) <= fmtDate(today()) && fmtDate(today()) <= fmtDate(addDays(w,6)));\n  const totalDaysRange = daysBetween(startMon, end) + 1;\n\n  let bodyHTML = `<div style=\"width:${totalW}px;position:relative;min-height:${Math.max(tasks.length,1)*ROW_H}px;\">`;\n\n  // Grid lines\n  weeks.forEach((_,i) => {\n    bodyHTML += `<div style=\"position:absolute;left:${i*COL_W_WEEK}px;top:0;bottom:0;width:1px;background:#e5e7eb;pointer-events:none;\"></div>`;\n  });\n\n  // Current week highlight\n  if (todayWeekIdx>=0) {\n    bodyHTML += `<div style=\"position:absolute;left:${todayWeekIdx*COL_W_WEEK}px;top:0;width:${COL_W_WEEK}px;bottom:0;background:rgba(239,68,68,0.04);pointer-events:none;\"></div>`;\n  }\n\n  tasks.forEach((t, idx) => {\n    const s = parseDate(t.start), e = parseDate(t.end);\n    const leftDays = daysBetween(startMon, s);\n    const durDays = Math.max(1, daysBetween(s,e)+1);\n    const totalDaysInRange = weeks.length * 7;\n    const left = (leftDays / totalDaysInRange) * totalW;\n    const width = (durDays / totalDaysInRange) * totalW;\n    const top = idx * ROW_H + 8;\n    const fillW = Math.round(width * t.pct / 100);\n    bodyHTML += `\n      <div class=\"gantt-bar-wrap\" style=\"position:absolute;left:${Math.max(0,left)}px;top:${top}px;width:${width}px;\" onclick=\"openModal('${t.id}')\" title=\"${esc(t.name)} (${t.pct}% complete)\">\n        <div class=\"gantt-bar-bg\" style=\"background:${t.color};\"></div>\n        <div class=\"gantt-bar-fill\" style=\"background:${t.color};width:${fillW}px;\"></div>\n        <span class=\"gantt-bar-label\">${t.pct>0?t.pct+'% · ':''} ${esc(t.name)}</span>\n      </div>`;\n  });\n\n  // Today line\n  if (todayWeekIdx >= 0) {\n    const todayInWeek = (today().getDay()+6)%7; // 0=Mon\n    const tx = (todayWeekIdx + todayInWeek/7 + 0.5/7) * COL_W_WEEK;\n    bodyHTML += `<div class=\"today-line\" style=\"left:${tx}px;\"><span class=\"today-label\">Today</span></div>`;\n  }\n\n  bodyHTML += '</div>';\n  bodyEl.innerHTML = bodyHTML;\n\n  setTimeout(() => {\n    const scroll = document.getElementById('timeline-scroll');\n    const todayPx = todayWeekIdx * COL_W_WEEK - scroll.clientWidth/3;\n    scroll.scrollLeft = Math.max(0, todayPx);\n  }, 50);\n}\n\n// ─── Modal ────────────────────────────────────────────────────────────────────\nfunction openModal(id) {\n  editingId = id;\n  const overlay = document.getElementById('modal-overlay');\n  const btnDel = document.getElementById('btn-delete');\n  document.getElementById('modal-title').textContent = id ? 'Edit Task' : 'Add Task';\n  btnDel.classList.toggle('hidden', !id);\n\n  // Populate colour swatches\n  const sw = document.getElementById('color-swatches');\n  sw.innerHTML = SWATCHES.map(c =>\n    `<button onclick=\"document.getElementById('f-color').value='${c}'\" type=\"button\"\n      class=\"w-5 h-5 rounded-full border-2 border-white shadow-sm hover:scale-110 transition-transform\"\n      style=\"background:${c}\" title=\"${c}\"></button>`\n  ).join('');\n\n  if (id) {\n    const t = tasks.find(x=>x.id===id);\n    if (!t) return;\n    document.getElementById('f-name').value = t.name;\n    document.getElementById('f-start').value = t.start;\n    document.getElementById('f-end').value = t.end;\n    document.getElementById('f-assignee').value = t.assignee || '';\n    document.getElementById('f-color').value = t.color;\n    document.getElementById('f-pct').value = t.pct;\n    document.getElementById('pct-display').textContent = t.pct + '%';\n  } else {\n    document.getElementById('f-name').value = '';\n    // Default start = today, end = today + 7\n    document.getElementById('f-start').value = fmtDate(today());\n    document.getElementById('f-end').value = fmtDate(addDays(today(), 7));\n    document.getElementById('f-assignee').value = '';\n    document.getElementById('f-color').value = SWATCHES[Math.floor(Math.random()*SWATCHES.length)];\n    document.getElementById('f-pct').value = 0;\n    document.getElementById('pct-display').textContent = '0%';\n  }\n  overlay.classList.remove('hidden');\n  setTimeout(()=>document.getElementById('f-name').focus(),50);\n}\n\nfunction closeModal() {\n  document.getElementById('modal-overlay').classList.add('hidden');\n  editingId = null;\n}\n\nfunction saveTask() {\n  const name = document.getElementById('f-name').value.trim();\n  const start = document.getElementById('f-start').value;\n  const end = document.getElementById('f-end').value;\n  if (!name) { alert('Please enter a task name.'); return; }\n  if (!start || !end) { alert('Please set start and end dates.'); return; }\n  if (start > end) { alert('End date must be on or after start date.'); return; }\n\n  const task = {\n    id: editingId || uid(),\n    name,\n    start,\n    end,\n    assignee: document.getElementById('f-assignee').value.trim(),\n    color: document.getElementById('f-color').value,\n    pct: parseInt(document.getElementById('f-pct').value, 10),\n  };\n\n  if (editingId) {\n    const idx = tasks.findIndex(t=>t.id===editingId);\n    if (idx>=0) tasks[idx] = task;\n  } else {\n    tasks.push(task);\n  }\n  save();\n  closeModal();\n  renderAll();\n}\n\nfunction deleteTask() {\n  if (!editingId) return;\n  if (!confirm('Delete this task?')) return;\n  tasks = tasks.filter(t=>t.id!==editingId);\n  save();\n  closeModal();\n  renderAll();\n}\n\n// ─── Keyboard ─────────────────────────────────────────────────────────────────\ndocument.addEventListener('keydown', e => {\n  if (e.key === 'Escape') closeModal();\n  if ((e.key === 'Enter') && !document.getElementById('modal-overlay').classList.contains('hidden')) {\n    if (document.activeElement.tagName !== 'BUTTON') saveTask();\n  }\n});\n\n// Close modal on overlay click\ndocument.getElementById('modal-overlay').addEventListener('click', e => {\n  if (e.target === document.getElementById('modal-overlay')) closeModal();\n});\n\n// ─── Boot ─────────────────────────────────────────────────────────────────────\nload();\nrenderAll();\n</script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Gantt Chart",
    "windowTitle": "Gantt Chart",
    "bundleId": "com.halisonworks.ganttchart",
    "iconPath": null
