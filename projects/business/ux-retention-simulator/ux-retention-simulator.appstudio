{
  "schema": "app-studio/canvas@1",
  "id": "example-ux-retention-simulator",
  "name": "ux-retention-simulator.html",
  "code": "<!DOCTYPE html>\n<!--\n  UX Retention Simulator — Halison App Studio example\n\n  An interactive sandbox that models a 90-day user cohort's retention and\n  cumulative revenue under different UX / gamification strategies (Octalysis\n  core drives, plus loss-aversion, Zeigarnik, and variable-reward toggles).\n  Compare extractive vs empowering design, snapshot a baseline, and inspect the\n  curves and behavioral-health diagnostics.\n\n  From the Halison App Studio public library:\n  https://github.com/halisonworks/public-app-studio\n\n  Permitted use: personal, educational, and other non-commercial use. You may\n  modify it, but keep this header and the source link intact, and do not sell,\n  commercialize, or republish it. Released under the Halison App Studio Examples\n  License — see the LICENSE file in the repository above.\n-->\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>UX Retention Simulator - Sandbox Dashboard</title>\n    <!-- Tailwind CSS -->\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <!-- FontAwesome for Premium Icons -->\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\n    <!-- Google Fonts: Inter -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap\" rel=\"stylesheet\">\n    <style>\n        body {\n            font-family: 'Inter', sans-serif;\n        }\n        .mono {\n            font-family: 'JetBrains Mono', monospace;\n        }\n        /* Custom scrollbar for high-end feel */\n        ::-webkit-scrollbar {\n            width: 6px;\n            height: 6px;\n        }\n        ::-webkit-scrollbar-track {\n            background: #0f172a;\n        }\n        ::-webkit-scrollbar-thumb {\n            background: #334155;\n            border-radius: 4px;\n        }\n        ::-webkit-scrollbar-thumb:hover {\n            background: #475569;\n        }\n        /* Range slider styling */\n        input[type=\"range\"]::-webkit-slider-thumb {\n            transition: transform 0.1s ease;\n        }\n        input[type=\"range\"]::-webkit-slider-thumb:hover {\n            transform: scale(1.2);\n        }\n    </style>\n</head>\n<body class=\"bg-slate-950 text-slate-100 min-h-screen flex flex-col antialiased selection:bg-indigo-500 selection:text-white\">\n\n    <header class=\"border-b border-slate-800 bg-slate-900/60 backdrop-blur-md sticky top-0 z-50 px-6 py-4\">\n        <div class=\"max-w-7xl mx-auto flex flex-col md:flex-row md:items-center md:justify-between gap-4\">\n            <div class=\"flex items-center gap-3\">\n                <div class=\"p-2.5 bg-gradient-to-tr from-indigo-600 to-violet-500 rounded-xl shadow-lg shadow-indigo-500/10\">\n                    <i class=\"fa-solid fa-calculator text-xl text-white\"></i>\n                </div>\n                <div>\n                    <h1 class=\"text-xl font-extrabold tracking-tight bg-gradient-to-r from-white via-slate-100 to-slate-400 bg-clip-text text-transparent\">UX Retention Simulator</h1>\n                    <p class=\"text-xs text-slate-400 font-medium\">90-Day Cohort Economic Modeling & Behavioral Sandbox</p>\n                </div>\n            </div>\n            <!-- Interactive Preset Configurations -->\n            <div class=\"flex items-center gap-2 flex-wrap\">\n                <span class=\"text-xs font-semibold uppercase tracking-wider text-slate-500 mr-1\">Load Archetype:</span>\n                <button onclick=\"loadPreset('dark')\" class=\"px-3.5 py-1.5 text-xs font-semibold rounded-lg bg-rose-950/40 text-rose-400 border border-rose-900/40 hover:bg-rose-900/60 transition-all flex items-center gap-1.5\">\n                    <i class=\"fa-solid fa-skull\"></i> Extractive Archetype\n                </button>\n                <button onclick=\"loadPreset('useful')\" class=\"px-3.5 py-1.5 text-xs font-semibold rounded-lg bg-emerald-950/40 text-emerald-400 border border-emerald-900/40 hover:bg-emerald-900/60 transition-all flex items-center gap-1.5\">\n                    <i class=\"fa-solid fa-shield-halved\"></i> Empowering Archetype\n                </button>\n                <button onclick=\"loadPreset('hybrid')\" class=\"px-3.5 py-1.5 text-xs font-semibold rounded-lg bg-amber-950/40 text-amber-400 border border-amber-900/40 hover:bg-amber-900/60 transition-all flex items-center gap-1.5\">\n                    <i class=\"fa-solid fa-scale-balanced\"></i> Realist Hybrid\n                </button>\n                <button onclick=\"resetToDefault()\" class=\"px-3.5 py-1.5 text-xs font-semibold rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 transition-all\">\n                    Reset\n                </button>\n            </div>\n        </div>\n    </header>\n\n    <!-- Main Workspace Container -->\n    <main class=\"flex-1 max-w-7xl w-full mx-auto p-4 md:p-6 grid grid-cols-1 lg:grid-cols-12 gap-6\">\n\n        <div class=\"lg:col-span-5 flex flex-col gap-6\">\n\n            <!-- Panel 1: Derived Strategy & Macro Presets -->\n            <section class=\"bg-slate-900/80 border border-slate-800 rounded-2xl p-5 shadow-sm\">\n                <div class=\"flex items-center justify-between mb-4\">\n                    <h2 class=\"text-sm font-bold uppercase tracking-wider text-slate-400 flex items-center gap-2\">\n                        <i class=\"fa-solid fa-compass text-indigo-400\"></i> Mode Diagnostic\n                    </h2>\n                    <span id=\"active-philosophy-badge\" class=\"px-2.5 py-0.5 rounded-full text-[10px] font-extrabold uppercase bg-emerald-500/10 text-emerald-400 border border-emerald-500/20\">\n                        Empowering\n                    </span>\n                </div>\n\n                <!-- Macro Alignment Overrides -->\n                <div class=\"bg-slate-950 p-1.5 rounded-xl border border-slate-800 flex items-center gap-1.5 mb-5\">\n                    <button id=\"btn-strategy-dark\" onclick=\"setMacroAlignment('dark')\" class=\"flex-1 py-2 text-xs font-bold rounded-lg transition-all flex items-center justify-center gap-1.5 text-slate-400 hover:text-white\">\n                        <i class=\"fa-solid fa-biohazard\"></i> Extractive Mode\n                    </button>\n                    <button id=\"btn-strategy-useful\" onclick=\"setMacroAlignment('useful')\" class=\"flex-1 py-2 text-xs font-bold rounded-lg transition-all flex items-center justify-center gap-1.5 text-slate-400 hover:text-white\">\n                        <i class=\"fa-solid fa-spa\"></i> Empowering Mode\n                    </button>\n                </div>\n\n                <!-- Interactive Micro-Toggles mapping the Psychological Split -->\n                <div class=\"space-y-4\">\n                    <h3 class=\"text-xs font-bold text-slate-500 uppercase tracking-wider\">Cognitive Bias Architectures</h3>\n\n                    <!-- Trigger 1: Loss Aversion -->\n                    <div class=\"bg-slate-950/50 p-3.5 rounded-xl border border-slate-800/80 hover:border-slate-700/80 transition-all\">\n                        <div class=\"flex items-center justify-between gap-2 mb-2\">\n                            <span class=\"text-xs font-bold text-slate-200 flex items-center gap-1.5\">\n                                <span class=\"w-1.5 h-1.5 rounded-full bg-emerald-500\" id=\"loss-aversion-indicator\"></span>\n                                Loss Aversion\n                            </span>\n                            <span id=\"label-loss-aversion\" class=\"text-[10px] font-bold text-emerald-400 uppercase font-mono\">Grace Period</span>\n                        </div>\n                        <div class=\"flex bg-slate-900 p-1 rounded-lg border border-slate-800\">\n                            <button id=\"toggle-loss-dark\" onclick=\"setMicroTrigger('lossAversion', 'dark')\" class=\"flex-1 py-1 text-[10px] font-semibold rounded text-center transition-all text-slate-500 hover:text-slate-300\">\n                                Artificial Streak (Dark)\n                            </button>\n                            <button id=\"toggle-loss-useful\" onclick=\"setMicroTrigger('lossAversion', 'useful')\" class=\"flex-1 py-1 text-[10px] font-semibold rounded text-center transition-all bg-emerald-950/80 text-emerald-300 border border-emerald-900/40\">\n                                Grace Period (Useful)\n                            </button>\n                        </div>\n                    </div>\n\n                    <!-- Trigger 2: Zeigarnik Effect -->\n                    <div class=\"bg-slate-950/50 p-3.5 rounded-xl border border-slate-800/80 hover:border-slate-700/80 transition-all\">\n                        <div class=\"flex items-center justify-between gap-2 mb-2\">\n                            <span class=\"text-xs font-bold text-slate-200 flex items-center gap-1.5\">\n                                <span class=\"w-1.5 h-1.5 rounded-full bg-emerald-500\" id=\"zeigarnik-indicator\"></span>\n                                Zeigarnik (Incompletion)\n                            </span>\n                            <span id=\"label-zeigarnik\" class=\"text-[10px] font-bold text-emerald-400 uppercase font-mono\">Milestone</span>\n                        </div>\n                        <div class=\"flex bg-slate-900 p-1 rounded-lg border border-slate-800\">\n                            <button id=\"toggle-zeigarnik-dark\" onclick=\"setMicroTrigger('zeigarnik', 'dark')\" class=\"flex-1 py-1 text-[10px] font-semibold rounded text-center transition-all text-slate-500 hover:text-slate-300\">\n                                Infinite Loops (Dark)\n                            </button>\n                            <button id=\"toggle-zeigarnik-useful\" onclick=\"setMicroTrigger('zeigarnik', 'useful')\" class=\"flex-1 py-1 text-[10px] font-semibold rounded text-center transition-all bg-emerald-950/80 text-emerald-300 border border-emerald-900/40\">\n                                Mastery Milestone (Useful)\n                            </button>\n                        </div>\n                    </div>\n\n                    <!-- Trigger 3: Variable Rewards -->\n                    <div class=\"bg-slate-950/50 p-3.5 rounded-xl border border-slate-800/80 hover:border-slate-700/80 transition-all\">\n                        <div class=\"flex items-center justify-between gap-2 mb-2\">\n                            <span class=\"text-xs font-bold text-slate-200 flex items-center gap-1.5\">\n                                <span class=\"w-1.5 h-1.5 rounded-full bg-emerald-500\" id=\"variable-rewards-indicator\"></span>\n                                Variable Rewards Hook\n                            </span>\n                            <span id=\"label-variable-rewards\" class=\"text-[10px] font-bold text-emerald-400 uppercase font-mono\">Aha! Discovery</span>\n                        </div>\n                        <div class=\"flex bg-slate-900 p-1 rounded-lg border border-slate-800\">\n                            <button id=\"toggle-rewards-dark\" onclick=\"setMicroTrigger('variableRewards', 'dark')\" class=\"flex-1 py-1 text-[10px] font-semibold rounded text-center transition-all text-slate-500 hover:text-slate-300\">\n                                Casino Lootbox (Dark)\n                            </button>\n                            <button id=\"toggle-rewards-useful\" onclick=\"setMicroTrigger('variableRewards', 'useful')\" class=\"flex-1 py-1 text-[10px] font-semibold rounded text-center transition-all bg-emerald-950/80 text-emerald-300 border border-emerald-900/40\">\n                                \"Aha!\" Discovery (Useful)\n                            </button>\n                        </div>\n                    </div>\n\n                </div>\n            </section>\n\n            <section class=\"bg-slate-900/80 border border-slate-800 rounded-2xl p-5 shadow-sm\">\n                <div class=\"flex items-center justify-between mb-4\">\n                    <h2 class=\"text-sm font-bold uppercase tracking-wider text-slate-400 flex items-center gap-2\">\n                        <i class=\"fa-solid fa-chart-pie text-violet-400\"></i> Octalysis Core Drive Values\n                    </h2>\n                    <span class=\"text-[10px] bg-slate-850 px-2 py-0.5 border border-slate-800 rounded text-slate-400 font-mono\">Continuous Matrix</span>\n                </div>\n\n                <div class=\"space-y-5\">\n                    <!-- White Hat Group -->\n                    <div class=\"border-l-2 border-emerald-500/40 pl-3.5 space-y-3.5\">\n                        <div class=\"flex items-center justify-between text-xs font-semibold text-emerald-400\">\n                            <span>White Hat / Intrinsic Drives</span>\n                            <span class=\"text-[9px] uppercase tracking-wider text-emerald-500/80 font-mono\">Autonomy & Mastery</span>\n                        </div>\n                        <!-- Drive 1: Meaning -->\n                        <div>\n                            <div class=\"flex justify-between items-center mb-1\">\n                                <label class=\"text-[11px] font-medium text-slate-300\">1. Meaning & Calling (Narrative)</label>\n                                <span id=\"val-drive-meaning\" class=\"text-xs font-bold text-emerald-400 font-mono\">8</span>\n                            </div>\n                            <input id=\"slide-drive-meaning\" oninput=\"updateDriveValue('meaning', this.value)\" type=\"range\" min=\"0\" max=\"10\" value=\"8\" class=\"w-full h-1 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-emerald-500\">\n                        </div>\n                        <!-- Drive 2: Accomplishment -->\n                        <div>\n                            <div class=\"flex justify-between items-center mb-1\">\n                                <label class=\"text-[11px] font-medium text-slate-300\">2. Accomplishment (Mastery Milestones)</label>\n                                <span id=\"val-drive-accomplishment\" class=\"text-xs font-bold text-emerald-400 font-mono\">8</span>\n                            </div>\n                            <input id=\"slide-drive-accomplishment\" oninput=\"updateDriveValue('accomplishment', this.value)\" type=\"range\" min=\"0\" max=\"10\" value=\"8\" class=\"w-full h-1 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-emerald-500\">\n                        </div>\n                        <!-- Drive 3: Empowerment -->\n                        <div>\n                            <div class=\"flex justify-between items-center mb-1\">\n                                <label class=\"text-[11px] font-medium text-slate-300\">3. Empowerment (Feedback Loops)</label>\n                                <span id=\"val-drive-empowerment\" class=\"text-xs font-bold text-emerald-400 font-mono\">9</span>\n                            </div>\n                            <input id=\"slide-drive-empowerment\" oninput=\"updateDriveValue('empowerment', this.value)\" type=\"range\" min=\"0\" max=\"10\" value=\"9\" class=\"w-full h-1 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-emerald-500\">\n                        </div>\n                    </div>\n\n                    <!-- Neutral / Mixed Group -->\n                    <div class=\"border-l-2 border-slate-500/40 pl-3.5 space-y-3.5\">\n                        <div class=\"flex items-center justify-between text-xs font-semibold text-slate-400\">\n                            <span>Mixed Drives</span>\n                        </div>\n                        <!-- Drive 4: Ownership -->\n                        <div>\n                            <div class=\"flex justify-between items-center mb-1\">\n                                <label class=\"text-[11px] font-medium text-slate-300\">4. Ownership (Virtual Assets)</label>\n                                <span id=\"val-drive-ownership\" class=\"text-xs font-bold text-slate-300 font-mono\">4</span>\n                            </div>\n                            <input id=\"slide-drive-ownership\" oninput=\"updateDriveValue('ownership', this.value)\" type=\"range\" min=\"0\" max=\"10\" value=\"4\" class=\"w-full h-1 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-slate-400\">\n                        </div>\n                        <!-- Drive 5: Social Influence -->\n                        <div>\n                            <div class=\"flex justify-between items-center mb-1\">\n                                <label class=\"text-[11px] font-medium text-slate-300\">5. Social Influence (Relatedness)</label>\n                                <span id=\"val-drive-social\" class=\"text-xs font-bold text-slate-300 font-mono\">6</span>\n                            </div>\n                            <input id=\"slide-drive-social\" oninput=\"updateDriveValue('social', this.value)\" type=\"range\" min=\"0\" max=\"10\" value=\"6\" class=\"w-full h-1 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-slate-400\">\n                        </div>\n                    </div>\n\n                    <!-- Black Hat Group -->\n                    <div class=\"border-l-2 border-rose-500/40 pl-3.5 space-y-3.5\">\n                        <div class=\"flex items-center justify-between text-xs font-semibold text-rose-400\">\n                            <span>Black Hat / Extrinsic Drives</span>\n                            <span class=\"text-[9px] uppercase tracking-wider text-rose-500/80 font-mono\">Urgency & Friction</span>\n                        </div>\n                        <!-- Drive 6: Scarcity -->\n                        <div>\n                            <div class=\"flex justify-between items-center mb-1\">\n                                <label class=\"text-[11px] font-medium text-slate-300\">6. Scarcity & Impatience (Friction)</label>\n                                <span id=\"val-drive-scarcity\" class=\"text-xs font-bold text-rose-400 font-mono\">2</span>\n                            </div>\n                            <input id=\"slide-drive-scarcity\" oninput=\"updateDriveValue('scarcity', this.value)\" type=\"range\" min=\"0\" max=\"10\" value=\"2\" class=\"w-full h-1 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-rose-500\">\n                        </div>\n                        <!-- Drive 7: Unpredictability -->\n                        <div>\n                            <div class=\"flex justify-between items-center mb-1\">\n                                <label class=\"text-[11px] font-medium text-slate-300\">7. Unpredictability (Curiosity)</label>\n                                <span id=\"val-drive-unpredictability\" class=\"text-xs font-bold text-rose-400 font-mono\">2</span>\n                            </div>\n                            <input id=\"slide-drive-unpredictability\" oninput=\"updateDriveValue('unpredictability', this.value)\" type=\"range\" min=\"0\" max=\"10\" value=\"2\" class=\"w-full h-1 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-rose-500\">\n                        </div>\n                        <!-- Drive 8: Loss Avoidance -->\n                        <div>\n                            <div class=\"flex justify-between items-center mb-1\">\n                                <label class=\"text-[11px] font-medium text-slate-300\">8. Loss Avoidance (Friction/Fear)</label>\n                                <span id=\"val-drive-loss\" class=\"text-xs font-bold text-rose-400 font-mono\">1</span>\n                            </div>\n                            <input id=\"slide-drive-loss\" oninput=\"updateDriveValue('loss', this.value)\" type=\"range\" min=\"0\" max=\"10\" value=\"1\" class=\"w-full h-1 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-rose-500\">\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Simulation Internal Feedback Ticker -->\n                <div class=\"mt-5 p-4 rounded-xl bg-slate-950 border border-slate-800\">\n                    <div class=\"grid grid-cols-2 gap-3 text-center mb-1\">\n                        <div class=\"p-2 bg-slate-900/60 rounded-lg border border-slate-800/40\">\n                            <span class=\"block text-[9px] text-slate-500 font-bold uppercase mb-0.5\">Burnout Risk</span>\n                            <span id=\"txt-burnout-index\" class=\"text-xs font-extrabold font-mono text-emerald-400\">LOW</span>\n                        </div>\n                        <div class=\"p-2 bg-slate-900/60 rounded-lg border border-slate-800/40\">\n                            <span class=\"block text-[9px] text-slate-500 font-bold uppercase mb-0.5\">Boredom Risk</span>\n                            <span id=\"txt-boredom-index\" class=\"text-xs font-extrabold font-mono text-emerald-400\">MINIMAL</span>\n                        </div>\n                    </div>\n                </div>\n            </section>\n        </div>\n\n        <div class=\"lg:col-span-7 flex flex-col gap-6\">\n\n            <!-- Cohort KPIs -->\n            <section class=\"grid grid-cols-1 sm:grid-cols-3 gap-4\">\n\n                <!-- KPI 1: Active Retained Users -->\n                <div class=\"bg-slate-900/80 border border-slate-800 rounded-2xl p-4 flex flex-col justify-between shadow-sm relative overflow-hidden group\">\n                    <div class=\"absolute -right-2 -top-2 w-16 h-16 bg-indigo-500/5 rounded-full blur-xl\"></div>\n                    <div>\n                        <span class=\"text-[10px] font-bold uppercase tracking-wider text-slate-500 block\">Retained Cohort (Day 90)</span>\n                        <div class=\"flex items-baseline gap-2 mt-1\">\n                            <span id=\"kpi-retained\" class=\"text-2xl font-black font-mono text-white\">4,810</span>\n                            <span id=\"kpi-retained-percent\" class=\"text-xs font-semibold text-slate-400 font-mono\">(48.1%)</span>\n                        </div>\n                    </div>\n                    <span id=\"kpi-retained-note\" class=\"text-[10px] text-emerald-400 flex items-center gap-1 mt-2 font-medium\">\n                        <i class=\"fa-solid fa-circle-check\"></i> Defensive plateau established\n                    </span>\n                </div>\n\n                <!-- KPI 2: Customer Lifetime Value -->\n                <div class=\"bg-slate-900/80 border border-slate-800 rounded-2xl p-4 flex flex-col justify-between shadow-sm relative overflow-hidden group\">\n                    <div class=\"absolute -right-2 -top-2 w-16 h-16 bg-emerald-500/5 rounded-full blur-xl\"></div>\n                    <div>\n                        <span class=\"text-[10px] font-bold uppercase tracking-wider text-slate-500 block\">Accumulated Cohort Revenue</span>\n                        <div class=\"flex items-baseline gap-1 mt-1\">\n                            <span id=\"kpi-ltv\" class=\"text-2xl font-black font-mono text-emerald-400\">$324,500</span>\n                        </div>\n                    </div>\n                    <span class=\"text-[10px] text-slate-500 flex items-center gap-1 mt-2\">\n                        Per 10,000 Starting Cohort\n                    </span>\n                </div>\n\n                <!-- KPI 3: Focus Balance -->\n                <div class=\"bg-slate-900/80 border border-slate-800 rounded-2xl p-4 flex flex-col justify-between shadow-sm relative overflow-hidden group\">\n                    <div class=\"absolute -right-2 -top-2 w-16 h-16 bg-amber-500/5 rounded-full blur-xl\"></div>\n                    <div>\n                        <span class=\"text-[10px] font-bold uppercase tracking-wider text-slate-500 block\">System Momentum Focus</span>\n                        <div class=\"flex items-baseline gap-1 mt-1\">\n                            <span id=\"kpi-momentum\" class=\"text-lg font-black font-mono text-white\">MOMENTUM</span>\n                        </div>\n                    </div>\n                    <span id=\"kpi-momentum-note\" class=\"text-[10px] text-slate-400 flex items-center gap-1 mt-2 leading-tight\">\n                        Optimized for genuine user success\n                    </span>\n                </div>\n\n            </section>\n\n            <section class=\"bg-slate-900/80 border border-slate-800 rounded-2xl p-5 shadow-sm flex flex-col min-h-[380px]\">\n                <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-3\">\n                    <div>\n                        <h2 class=\"text-sm font-bold uppercase tracking-wider text-slate-400 flex items-center gap-2\">\n                            <i class=\"fa-solid fa-chart-area text-indigo-400\"></i> Active 90-Day Sandbox Simulation\n                        </h2>\n                        <p class=\"text-[11px] text-slate-500\">Visualizing 10,000 user cohort projection decay & accumulated financial return</p>\n                    </div>\n\n                    <!-- Sandbox Scenario Capturer Controls -->\n                    <div class=\"flex items-center gap-2\">\n                        <button id=\"btn-save-baseline\" onclick=\"saveBaselineScenario()\" class=\"px-2.5 py-1 text-[11px] font-bold rounded bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 flex items-center gap-1\">\n                            <i class=\"fa-solid fa-camera\"></i> Snapshot Baseline\n                        </button>\n                        <button id=\"btn-clear-baseline\" onclick=\"clearBaselineScenario()\" class=\"px-2 py-1 text-[11px] font-bold rounded bg-red-950/30 text-red-400 border border-red-900/30 hover:bg-red-900/30 hidden\">\n                            Clear Baseline\n                        </button>\n                    </div>\n                </div>\n\n                <!-- Custom Interactive SVG Chart Area -->\n                <div class=\"flex-1 relative w-full bg-slate-950 rounded-xl border border-slate-800 p-2 overflow-hidden flex flex-col justify-end min-h-[220px]\">\n\n                    <!-- SVG Chart Container -->\n                    <div class=\"relative w-full h-[240px]\" id=\"svg-chart-container\">\n                        <svg id=\"sandbox-svg\" class=\"w-full h-full\" viewBox=\"0 0 800 240\" preserveAspectRatio=\"none\">\n                            <defs>\n                                <linearGradient id=\"gradient-retention\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                                    <stop offset=\"0%\" stop-color=\"#6366f1\" stop-opacity=\"0.25\"></stop>\n                                    <stop offset=\"100%\" stop-color=\"#6366f1\" stop-opacity=\"0.01\"></stop>\n                                </linearGradient>\n                                <linearGradient id=\"gradient-ltv\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                                    <stop offset=\"0%\" stop-color=\"#10b981\" stop-opacity=\"0.2\"></stop>\n                                    <stop offset=\"100%\" stop-color=\"#10b981\" stop-opacity=\"0.01\"></stop>\n                                </linearGradient>\n                            </defs>\n\n                            <!-- Grid Lines -->\n                            <line x1=\"0\" y1=\"60\" x2=\"800\" y2=\"60\" stroke=\"#1e293b\" stroke-dasharray=\"4\" />\n                            <line x1=\"0\" y1=\"120\" x2=\"800\" y2=\"120\" stroke=\"#1e293b\" stroke-dasharray=\"4\" />\n                            <line x1=\"0\" y1=\"180\" x2=\"800\" y2=\"180\" stroke=\"#1e293b\" stroke-dasharray=\"4\" />\n\n                            <!-- Timeline Grid Columns -->\n                            <line x1=\"133\" y1=\"0\" x2=\"133\" y2=\"240\" stroke=\"#1e293b\" stroke-dasharray=\"4\" />\n                            <line x1=\"266\" y1=\"0\" x2=\"266\" y2=\"240\" stroke=\"#1e293b\" stroke-dasharray=\"4\" />\n                            <line x1=\"400\" y1=\"0\" x2=\"400\" y2=\"240\" stroke=\"#1e293b\" stroke-dasharray=\"4\" />\n                            <line x1=\"533\" y1=\"0\" x2=\"533\" y2=\"240\" stroke=\"#1e293b\" stroke-dasharray=\"4\" />\n                            <line x1=\"666\" y1=\"0\" x2=\"666\" y2=\"240\" stroke=\"#1e293b\" stroke-dasharray=\"4\" />\n\n                            <!-- Active Rendered Simulation Paths -->\n                            <path id=\"path-retention-fill\" d=\"\" fill=\"url(#gradient-retention)\" />\n                            <path id=\"path-retention-stroke\" d=\"\" fill=\"none\" stroke=\"#6366f1\" stroke-width=\"3\" stroke-linecap=\"round\" />\n\n                            <path id=\"path-ltv-fill\" d=\"\" fill=\"url(#gradient-ltv)\" />\n                            <path id=\"path-ltv-stroke\" d=\"\" fill=\"none\" stroke=\"#10b981\" stroke-width=\"2.5\" stroke-linecap=\"round\" />\n\n                            <!-- Saved Baseline Overlay Paths -->\n                            <path id=\"path-baseline-retention\" d=\"\" fill=\"none\" stroke=\"#a78bfa\" stroke-width=\"1.5\" stroke-dasharray=\"4,4\" class=\"opacity-80\" />\n                            <path id=\"path-baseline-ltv\" d=\"\" fill=\"none\" stroke=\"#34d399\" stroke-width=\"1.5\" stroke-dasharray=\"4,4\" class=\"opacity-80\" />\n\n                            <!-- Interactive Tooltip Marker -->\n                            <line id=\"interactive-cursor-line\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"240\" stroke=\"#818cf8\" stroke-width=\"1\" class=\"hidden\" />\n                            <circle id=\"interactive-cursor-dot-retention\" r=\"5\" fill=\"#6366f1\" class=\"hidden\" />\n                            <circle id=\"interactive-cursor-dot-ltv\" r=\"5\" fill=\"#10b981\" class=\"hidden\" />\n                        </svg>\n\n                        <!-- Invisible hover layer for interaction -->\n                        <div id=\"svg-hover-overlay\" class=\"absolute inset-0 z-10 cursor-crosshair\" onmousemove=\"handleChartHover(event)\" onmouseleave=\"hideChartHover()\"></div>\n                    </div>\n\n                    <!-- Custom Timeline X Axis Labels -->\n                    <div class=\"flex justify-between px-2 pt-2 border-t border-slate-900 text-[10px] text-slate-500 font-bold uppercase tracking-wider select-none font-mono\">\n                        <span>Day 0</span>\n                        <span>Day 15</span>\n                        <span>Day 30 (M1)</span>\n                        <span>Day 45</span>\n                        <span>Day 60 (M2)</span>\n                        <span>Day 75</span>\n                        <span>Day 90 (M3)</span>\n                    </div>\n                </div>\n\n                <!-- Custom Chart Interactivity Legend -->\n                <div class=\"mt-3 flex flex-col sm:flex-row sm:items-center justify-between text-[11px] text-slate-400 gap-2 border-t border-slate-800/50 pt-2.5\">\n                    <span class=\"flex items-center gap-1.5 font-medium\">\n                        <i class=\"fa-regular fa-hand-pointer text-xs text-indigo-400 animate-pulse\"></i>\n                        Hover chart to evaluate specific daily values.\n                    </span>\n                    <div class=\"flex items-center gap-3\">\n                        <span class=\"flex items-center gap-1\"><span class=\"w-2 h-2 rounded bg-indigo-500\"></span> Active Retention</span>\n                        <span class=\"flex items-center gap-1\"><span class=\"w-2 h-2 rounded bg-emerald-500\"></span> Cumulative Revenue</span>\n                        <span id=\"legend-baseline\" class=\"hidden items-center gap-1\"><span class=\"w-2.5 h-0.5 border-t-2 border-dashed border-violet-400\"></span> Saved Baseline</span>\n                    </div>\n                </div>\n                <div id=\"chart-hover-readout\" class=\"mt-2 text-xs font-mono bg-slate-950 px-3 py-2 rounded border border-slate-800/80 min-h-[32px] flex items-center justify-center text-slate-400\">\n                    Hover over the graph to dissect metrics\n                </div>\n            </section>\n\n            <section class=\"bg-slate-900/80 border border-slate-800 rounded-2xl p-5 shadow-sm\">\n                <div class=\"flex items-center justify-between mb-3.5\">\n                    <h2 class=\"text-sm font-bold uppercase tracking-wider text-slate-400 flex items-center gap-2\">\n                        <i class=\"fa-solid fa-list-check text-indigo-400\"></i> Dynamic Cohort Milestone Ledger\n                    </h2>\n                    <span class=\"text-[10px] text-slate-500 font-mono\">Updated Real-Time</span>\n                </div>\n                <div class=\"overflow-x-auto\">\n                    <table class=\"w-full text-left text-xs font-mono\">\n                        <thead>\n                            <tr class=\"border-b border-slate-800 text-slate-500 uppercase font-bold text-[9px] tracking-wider\">\n                                <th class=\"pb-2\">Milestone</th>\n                                <th class=\"pb-2\">Retained %</th>\n                                <th class=\"pb-2\">Active Cohort</th>\n                                <th class=\"pb-2\">Avg Daily Rev / User</th>\n                                <th class=\"pb-2 text-right\">Cumulative Value</th>\n                            </tr>\n                        </thead>\n                        <tbody id=\"cohort-ledger-body\" class=\"divide-y divide-slate-800/60 text-slate-300\">\n                            <!-- Dynamic Row Milestones will inject here -->\n                        </tbody>\n                    </table>\n                </div>\n            </section>\n\n            <section class=\"bg-slate-900/80 border border-slate-800 rounded-2xl p-5 shadow-sm\">\n                <h3 class=\"text-sm font-bold uppercase tracking-wider text-slate-400 mb-4 flex items-center gap-2\">\n                    <i class=\"fa-solid fa-stethoscope text-indigo-400\"></i> Real-Time Behavioral Health Diagnostics\n                </h3>\n\n                <div class=\"grid grid-cols-1 md:grid-cols-2 gap-4\" id=\"diagnostics-board\">\n                    <!-- Cards will inject via JavaScript depending on slider values -->\n                </div>\n            </section>\n\n        </div>\n    </main>\n\n    <!-- Footer Area -->\n    <footer class=\"border-t border-slate-900 bg-slate-950 py-6 px-6 text-center text-xs text-slate-600 mt-12\">\n        <p>© 2026 UX Retention Simulator. Built for high-fidelity interactive sandbox testing.</p>\n    </footer>\n\n    <script>\n        // Global Simulation State\n        let state = {\n            microTriggers: {\n                lossAversion: 'useful',   // 'dark' | 'useful'\n                zeigarnik: 'useful',      // 'dark' | 'useful'\n                variableRewards: 'useful' // 'dark' | 'useful'\n            },\n            drives: {\n                meaning: 8,\n                accomplishment: 8,\n                empowerment: 9,\n                ownership: 4,\n                social: 6,\n                scarcity: 2,\n                unpredictability: 2,\n                loss: 1\n            },\n            simulationData: {\n                days: [],\n                retention: [],\n                ltv: []\n            },\n            baselineData: null // Stores snapshot baseline for visual compare overlay\n        };\n\n        // Standard Archetypes Definition (Sliders & Toggles)\n        const archetypes = {\n            dark: {\n                microTriggers: { lossAversion: 'dark', zeigarnik: 'dark', variableRewards: 'dark' },\n                drives: { meaning: 1, accomplishment: 3, empowerment: 1, ownership: 8, social: 3, scarcity: 9, unpredictability: 10, loss: 10 }\n            },\n            useful: {\n                microTriggers: { lossAversion: 'useful', zeigarnik: 'useful', variableRewards: 'useful' },\n                drives: { meaning: 8, accomplishment: 8, empowerment: 9, ownership: 4, social: 6, scarcity: 2, unpredictability: 2, loss: 1 }\n            },\n            hybrid: {\n                microTriggers: { lossAversion: 'dark', zeigarnik: 'useful', variableRewards: 'dark' },\n                drives: { meaning: 5, accomplishment: 6, empowerment: 6, ownership: 6, social: 5, scarcity: 5, unpredictability: 5, loss: 4 }\n            }\n        };\n\n        // Window load starting layout setup\n        window.onload = function() {\n            loadPreset('useful');\n        };\n\n        // Trigger dynamic state configuration via Macro modes\n        function setMacroAlignment(paradigm) {\n            if (paradigm === 'dark') {\n                state.microTriggers = { lossAversion: 'dark', zeigarnik: 'dark', variableRewards: 'dark' };\n                // High Scarcity, Unpredictability, and Loss\n                state.drives.meaning = Math.max(0, state.drives.meaning - 4);\n                state.drives.accomplishment = Math.max(0, state.drives.accomplishment - 2);\n                state.drives.empowerment = Math.max(0, state.drives.empowerment - 4);\n                state.drives.scarcity = Math.min(10, state.drives.scarcity + 5);\n                state.drives.unpredictability = Math.min(10, state.drives.unpredictability + 5);\n                state.drives.loss = Math.min(10, state.drives.loss + 5);\n            } else {\n                state.microTriggers = { lossAversion: 'useful', zeigarnik: 'useful', variableRewards: 'useful' };\n                // High Meaning, Accomplishment, and Empowerment\n                state.drives.meaning = Math.min(10, state.drives.meaning + 4);\n                state.drives.accomplishment = Math.min(10, state.drives.accomplishment + 3);\n                state.drives.empowerment = Math.min(10, state.drives.empowerment + 4);\n                state.drives.scarcity = Math.max(0, state.drives.scarcity - 4);\n                state.drives.unpredictability = Math.max(0, state.drives.unpredictability - 4);\n                state.drives.loss = Math.max(0, state.drives.loss - 4);\n            }\n            syncSlidersToState();\n            updateUI();\n            runSimulation();\n        }\n\n        // Setup specific individual micro-triggers\n        function setMicroTrigger(triggerName, val) {\n            state.microTriggers[triggerName] = val;\n            updateUI();\n            runSimulation();\n        }\n\n        // Adjust drive slider levels dynamically\n        function updateDriveValue(driveKey, val) {\n            state.drives[driveKey] = parseInt(val);\n            document.getElementById(`val-drive-${driveKey}`).innerText = val;\n            runSimulation();\n        }\n\n        // Inject saved archetype patterns\n        function loadPreset(presetKey) {\n            const preset = archetypes[presetKey];\n            if (!preset) return;\n\n            state.microTriggers = JSON.parse(JSON.stringify(preset.microTriggers));\n            state.drives = JSON.parse(JSON.stringify(preset.drives));\n\n            syncSlidersToState();\n            updateUI();\n            runSimulation();\n        }\n\n        function resetToDefault() {\n            loadPreset('useful');\n        }\n\n        function syncSlidersToState() {\n            for (let k in state.drives) {\n                const slider = document.getElementById(`slide-drive-${k}`);\n                if (slider) slider.value = state.drives[k];\n                const display = document.getElementById(`val-drive-${k}`);\n                if (display) display.innerText = state.drives[k];\n            }\n        }\n\n        function updateUI() {\n            // Derive current philosophy classification based on current slider values\n            const whiteHatScore = (state.drives.meaning + state.drives.accomplishment + state.drives.empowerment) / 3;\n            const blackHatScore = (state.drives.scarcity + state.drives.unpredictability + state.drives.loss) / 3;\n\n            const activeBadge = document.getElementById('active-philosophy-badge');\n            const btnDark = document.getElementById('btn-strategy-dark');\n            const btnUseful = document.getElementById('btn-strategy-useful');\n\n            btnDark.className = \"flex-1 py-2 text-xs font-bold rounded-lg transition-all flex items-center justify-center gap-1.5 text-slate-400 hover:text-white\";\n            btnUseful.className = \"flex-1 py-2 text-xs font-bold rounded-lg transition-all flex items-center justify-center gap-1.5 text-slate-400 hover:text-white\";\n\n            if (blackHatScore > whiteHatScore + 1.5) {\n                activeBadge.innerText = \"Extractive Design\";\n                activeBadge.className = \"px-2.5 py-0.5 rounded-full text-[10px] font-extrabold uppercase bg-rose-500/10 text-rose-400 border border-rose-500/20\";\n                btnDark.className = \"flex-1 py-2 text-xs font-bold rounded-lg transition-all flex items-center justify-center gap-1.5 text-rose-400 bg-rose-950/40 border border-rose-900/50 shadow-sm\";\n            } else if (whiteHatScore > blackHatScore + 1.5) {\n                activeBadge.innerText = \"Empowering Design\";\n                activeBadge.className = \"px-2.5 py-0.5 rounded-full text-[10px] font-extrabold uppercase bg-emerald-500/10 text-emerald-400 border border-emerald-500/20\";\n                btnUseful.className = \"flex-1 py-2 text-xs font-bold rounded-lg transition-all flex items-center justify-center gap-1.5 text-emerald-400 bg-emerald-950/40 border border-emerald-900/50 shadow-sm\";\n            } else {\n                activeBadge.innerText = \"Balanced Hybrid\";\n                activeBadge.className = \"px-2.5 py-0.5 rounded-full text-[10px] font-extrabold uppercase bg-amber-500/10 text-amber-400 border border-amber-500/20\";\n            }\n\n            // Sync Toggle Controls Visual Appearance\n            syncToggleControlUI('lossAversion', 'toggle-loss-dark', 'toggle-loss-useful', 'loss-aversion-indicator', 'label-loss-aversion', 'Artificial Streak', 'Grace Period');\n            syncToggleControlUI('zeigarnik', 'toggle-zeigarnik-dark', 'toggle-zeigarnik-useful', 'zeigarnik-indicator', 'label-zeigarnik', 'Infinite Loop', 'Milestone');\n            syncToggleControlUI('variableRewards', 'toggle-rewards-dark', 'toggle-rewards-useful', 'variable-rewards-indicator', 'label-variable-rewards', 'Lootbox Hook', 'Aha! Discovery');\n        }\n\n        function syncToggleControlUI(stateKey, darkBtnId, usefulBtnId, indicatorId, labelId, darkLabelText, usefulLabelText) {\n            const val = state.microTriggers[stateKey];\n            const btnD = document.getElementById(darkBtnId);\n            const btnU = document.getElementById(usefulBtnId);\n            const ind = document.getElementById(indicatorId);\n            const lbl = document.getElementById(labelId);\n\n            if (!btnD || !btnU || !ind || !lbl) return;\n\n            if (val === 'dark') {\n                btnD.className = \"flex-1 py-1 text-[10px] font-semibold rounded text-center transition-all bg-rose-950/80 text-rose-300 border border-rose-900/40\";\n                btnU.className = \"flex-1 py-1 text-[10px] font-semibold rounded text-center transition-all text-slate-500 hover:text-slate-300\";\n                ind.className = \"w-1.5 h-1.5 rounded-full bg-rose-500 animate-pulse\";\n                lbl.innerText = darkLabelText;\n                lbl.className = \"text-[10px] font-bold text-rose-400 uppercase font-mono\";\n            } else {\n                btnD.className = \"flex-1 py-1 text-[10px] font-semibold rounded text-center transition-all text-slate-500 hover:text-slate-300\";\n                btnU.className = \"flex-1 py-1 text-[10px] font-semibold rounded text-center transition-all bg-emerald-950/80 text-emerald-300 border border-emerald-900/40\";\n                ind.className = \"w-1.5 h-1.5 rounded-full bg-emerald-500\";\n                lbl.innerText = usefulLabelText;\n                lbl.className = \"text-[10px] font-bold text-emerald-400 uppercase font-mono\";\n            }\n        }\n\n        function saveBaselineScenario() {\n            state.baselineData = {\n                retention: [...state.simulationData.retention],\n                ltv: [...state.simulationData.ltv]\n            };\n            document.getElementById('btn-clear-baseline').classList.remove('hidden');\n            document.getElementById('legend-baseline').classList.remove('hidden');\n            document.getElementById('legend-baseline').classList.add('flex');\n            drawChart();\n        }\n\n        function clearBaselineScenario() {\n            state.baselineData = null;\n            document.getElementById('btn-clear-baseline').classList.add('hidden');\n            document.getElementById('legend-baseline').classList.remove('flex');\n            document.getElementById('legend-baseline').classList.add('hidden');\n            drawChart();\n        }\n\n        function runSimulation() {\n            const days = [];\n            const retention = [];\n            const ltv = [];\n\n            // Calculate normalized index balances based on the Octalysis sliders\n            const whiteHatRaw = (state.drives.meaning * 1.0) + (state.drives.accomplishment * 1.0) + (state.drives.empowerment * 1.2);\n            const blackHatRaw = (state.drives.scarcity * 1.0) + (state.drives.unpredictability * 1.0) + (state.drives.loss * 1.2);\n\n            // Factor in micro-toggles\n            let microWhiteHatBonus = 0;\n            let microBlackHatBonus = 0;\n\n            if (state.microTriggers.lossAversion === 'useful') microWhiteHatBonus += 2.5; else microBlackHatBonus += 3.5;\n            if (state.microTriggers.zeigarnik === 'useful') microWhiteHatBonus += 2.5; else microBlackHatBonus += 3.5;\n            if (state.microTriggers.variableRewards === 'useful') microWhiteHatBonus += 2.5; else microBlackHatBonus += 3.5;\n\n            const finalWhiteHat = (whiteHatRaw + microWhiteHatBonus) / 4.0; // Normalized scale (roughly 0 - 10)\n            const finalBlackHat = (blackHatRaw + microBlackHatBonus) / 4.0;\n\n            // Burnout risk is driven primarily by extrinsic/black hat hooks relative to autonomy/meaning\n            let burnoutIndex = finalBlackHat - (finalWhiteHat * 0.3);\n            if (burnoutIndex < 0) burnoutIndex = 0;\n\n            // Boredom risk is high if there are sparse/no motivational vectors to complete onboarding\n            let boredomIndex = 10 - (finalWhiteHat * 0.65 + finalBlackHat * 0.35);\n            if (boredomIndex < 0) boredomIndex = 0;\n\n            // Live updates for internal risk tickers\n            const burnoutEl = document.getElementById('txt-burnout-index');\n            const boredomEl = document.getElementById('txt-boredom-index');\n\n            if (burnoutIndex > 6.0) {\n                burnoutEl.innerText = `CRITICAL (${burnoutIndex.toFixed(1)})`;\n                burnoutEl.className = \"block text-xs font-extrabold font-mono text-rose-500\";\n            } else if (burnoutIndex > 3.5) {\n                burnoutEl.innerText = `MODERATE (${burnoutIndex.toFixed(1)})`;\n                burnoutEl.className = \"block text-xs font-extrabold font-mono text-amber-500\";\n            } else {\n                burnoutEl.innerText = `LOW (${burnoutIndex.toFixed(1)})`;\n                burnoutEl.className = \"block text-xs font-extrabold font-mono text-emerald-400\";\n            }\n\n            if (boredomIndex > 6.0) {\n                boredomEl.innerText = `CRITICAL (${boredomIndex.toFixed(1)})`;\n                boredomEl.className = \"block text-xs font-extrabold font-mono text-rose-500\";\n            } else if (boredomIndex > 3.5) {\n                boredomEl.innerText = `MODERATE (${boredomIndex.toFixed(1)})`;\n                boredomEl.className = \"block text-xs font-extrabold font-mono text-amber-500\";\n            } else {\n                boredomEl.innerText = `MINIMAL (${boredomIndex.toFixed(1)})`;\n                boredomEl.className = \"block text-xs font-extrabold font-mono text-emerald-400\";\n            }\n\n            // Math Constants\n            const initialCohort = 10000;\n            let cumulativeRevenueVal = 0;\n\n            // Compute dynamic curve parameters\n            // White Hat builds a permanent \"Plateau Moat\" of loyal users\n            let plateauMoat = 0.05 + (finalWhiteHat * 0.055);\n            // Burnout degrades even the plateau moat over time\n            plateauMoat = plateauMoat * Math.max(0.1, 1.0 - (burnoutIndex * 0.12));\n\n            for (let t = 0; t <= 90; t++) {\n                days.push(t);\n\n                // Early decay velocity (affected heavily by boredom / initial drive setup)\n                let earlyRate = 0.015 + (boredomIndex * 0.0075);\n\n                // Fatigue-driven decay (grows over time, heavily accelerated by burnout index)\n                let fatigueRate = (burnoutIndex * 0.006) * (t / 90.0);\n\n                let baseDecayCurve = Math.exp(-earlyRate * t - fatigueRate * t);\n\n                // Re-introduce temporary short-term dopamine spikes for Extractive setups\n                // Peak booster element represents artificial hooks forcing DAU metrics early on\n                let dopamineBoost = 1.0;\n                if (finalBlackHat > 3.0) {\n                    let spikeAmplitude = 0.02 * finalBlackHat;\n                    dopamineBoost = 1.0 + (spikeAmplitude * Math.sin(t / 6.0) * Math.exp(-t / 25.0));\n                }\n\n                let currentRetention = (plateauMoat + (1.0 - plateauMoat) * baseDecayCurve) * dopamineBoost;\n\n                // Clamp retention boundaries\n                if (currentRetention > 1.0) currentRetention = 1.0;\n                if (currentRetention < 0.01) currentRetention = 0.01;\n\n                // Revenue Generation Calculations\n                // Extractive: Starts extremely high due to deceptive microtransactions/lootboxes, but collapses as trust drops\n                let revenuePerActiveExtractive = 0.65 * Math.exp(-t / 20.0) * (finalBlackHat / 5.0);\n\n                // Ethical Value-Based: Starts lower but scales up as user successfully achieves results/value\n                let revenuePerActiveValue = (0.08 + 0.0045 * t * finalWhiteHat) * (finalWhiteHat / 5.0);\n\n                let totalDailyRevPerActiveUser = revenuePerActiveExtractive + revenuePerActiveValue;\n                if (totalDailyRevPerActiveUser < 0.01) totalDailyRevPerActiveUser = 0.01;\n\n                let activeUsers = initialCohort * currentRetention;\n                cumulativeRevenueVal += activeUsers * totalDailyRevPerActiveUser;\n\n                retention.push(currentRetention * 100);\n                ltv.push(cumulativeRevenueVal);\n            }\n\n            state.simulationData.days = days;\n            state.simulationData.retention = retention;\n            state.simulationData.ltv = ltv;\n\n            // Sync Main Telemetry Displays\n            const finalRet = retention[90];\n            const finalLtvVal = ltv[90];\n\n            document.getElementById('kpi-retained').innerText = Math.round(initialCohort * (finalRet / 100)).toLocaleString();\n            document.getElementById('kpi-retained-percent').innerText = `(${finalRet.toFixed(1)}%)`;\n\n            const kpiRetNote = document.getElementById('kpi-retained-note');\n            if (finalRet >= 35.0) {\n                kpiRetNote.className = \"text-[10px] text-emerald-400 flex items-center gap-1 mt-2 font-medium\";\n                kpiRetNote.innerHTML = '<i class=\"fa-solid fa-circle-check\"></i> Defensive plateau established';\n            } else {\n                kpiRetNote.className = \"text-[10px] text-rose-400 flex items-center gap-1 mt-2 font-medium\";\n                kpiRetNote.innerHTML = '<i class=\"fa-solid fa-triangle-exclamation\"></i> Critical user fatigue & churn';\n            }\n\n            document.getElementById('kpi-ltv').innerText = `$${Math.round(finalLtvVal).toLocaleString()}`;\n\n            // Sync Momentum Gauge Readout\n            const momentumKpi = document.getElementById('kpi-momentum');\n            const momentumNote = document.getElementById('kpi-momentum-note');\n            if (finalWhiteHat > finalBlackHat + 1.0) {\n                momentumKpi.innerText = \"MOMENTUM\";\n                momentumKpi.className = \"text-lg font-black font-mono text-emerald-400\";\n                momentumNote.innerText = \"Optimized for authentic user success\";\n            } else if (finalBlackHat > finalWhiteHat + 1.0) {\n                momentumKpi.innerText = \"PURE MOTION\";\n                momentumKpi.className = \"text-lg font-black font-mono text-rose-500\";\n                momentumNote.innerText = \"Optimized for clicks & fake DAU cycles\";\n            } else {\n                momentumKpi.innerText = \"BALANCED FOCUS\";\n                momentumKpi.className = \"text-lg font-black font-mono text-amber-500\";\n                momentumNote.innerText = \"Hybrid mix of conversion & utility\";\n            }\n\n            // Draw Charts & Ledger tables\n            drawChart();\n            renderMilestoneLedger();\n            renderDynamicDiagnostics(finalWhiteHat, finalBlackHat, burnoutIndex, boredomIndex);\n        }\n\n        function drawChart() {\n            const svg = document.getElementById('sandbox-svg');\n            const pRetentionFill = document.getElementById('path-retention-fill');\n            const pRetentionStroke = document.getElementById('path-retention-stroke');\n            const pLtvFill = document.getElementById('path-ltv-fill');\n            const pLtvStroke = document.getElementById('path-ltv-stroke');\n\n            // Baseline Overlay Paths\n            const pBaseRet = document.getElementById('path-baseline-retention');\n            const pBaseLtv = document.getElementById('path-baseline-ltv');\n\n            const width = 800;\n            const height = 240;\n            const len = state.simulationData.days.length;\n\n            if (len === 0) return;\n\n            // Calculate adaptive scale constraints\n            let maxLtv = Math.max(...state.simulationData.ltv);\n            if (state.baselineData) {\n                maxLtv = Math.max(maxLtv, ...state.baselineData.ltv);\n            }\n            if (maxLtv === 0) maxLtv = 1;\n\n            let retentionPoints = [];\n            let ltvPoints = [];\n            let baseRetPoints = [];\n            let baseLtvPoints = [];\n\n            for (let i = 0; i < len; i++) {\n                let x = (i / (len - 1)) * width;\n\n                // Retention maps percentage 0-100 directly to coordinates\n                let yRet = height - (state.simulationData.retention[i] / 100) * height;\n                let yLtv = height - (state.simulationData.ltv[i] / maxLtv) * height;\n\n                // Restrict boundaries to stay strictly within path\n                yRet = Math.max(1, Math.min(height - 1, yRet));\n                yLtv = Math.max(1, Math.min(height - 1, yLtv));\n\n                retentionPoints.push(`${x},${yRet}`);\n                ltvPoints.push(`${x},${yLtv}`);\n\n                // Map baseline scenario overlays if saved\n                if (state.baselineData) {\n                    let yBaseRet = height - (state.baselineData.retention[i] / 100) * height;\n                    let yBaseLtv = height - (state.baselineData.ltv[i] / maxLtv) * height;\n\n                    yBaseRet = Math.max(1, Math.min(height - 1, yBaseRet));\n                    yBaseLtv = Math.max(1, Math.min(height - 1, yBaseLtv));\n\n                    baseRetPoints.push(`${x},${yBaseRet}`);\n                    baseLtvPoints.push(`${x},${yBaseLtv}`);\n                }\n            }\n\n            // Inject Active paths\n            pRetentionStroke.setAttribute('d', `M ${retentionPoints.join(' L ')}`);\n            pRetentionFill.setAttribute('d', `M 0,${height} L ${retentionPoints.join(' L ')} L ${width},${height} Z`);\n\n            pLtvStroke.setAttribute('d', `M ${ltvPoints.join(' L ')}`);\n            pLtvFill.setAttribute('d', `M 0,${height} L ${ltvPoints.join(' L ')} L ${width},${height} Z`);\n\n            // Inject or clear baseline overlays\n            if (state.baselineData && baseRetPoints.length > 0) {\n                pBaseRet.setAttribute('d', `M ${baseRetPoints.join(' L ')}`);\n                pBaseLtv.setAttribute('d', `M ${baseLtvPoints.join(' L ')}`);\n            } else {\n                pBaseRet.setAttribute('d', '');\n                pBaseLtv.setAttribute('d', '');\n            }\n        }\n\n        function handleChartHover(event) {\n            if (state.simulationData.retention.length === 0) return;\n\n            const cursorLine = document.getElementById('interactive-cursor-line');\n            const dotRetention = document.getElementById('interactive-cursor-dot-retention');\n            const dotLtv = document.getElementById('interactive-cursor-dot-ltv');\n            const hoverReadout = document.getElementById('chart-hover-readout');\n\n            const rect = event.currentTarget.getBoundingClientRect();\n            const xOffset = event.clientX - rect.left;\n\n            const svgWidth = 800;\n            const mappedX = (xOffset / rect.width) * svgWidth;\n            const dayIndex = Math.round((mappedX / svgWidth) * 90);\n\n            if (dayIndex >= 0 && dayIndex < state.simulationData.retention.length) {\n                const height = 240;\n                let maxLtv = Math.max(...state.simulationData.ltv);\n                if (state.baselineData) {\n                    maxLtv = Math.max(maxLtv, ...state.baselineData.ltv);\n                }\n\n                const dayRet = state.simulationData.retention[dayIndex];\n                const dayLtvVal = state.simulationData.ltv[dayIndex];\n\n                if (dayRet === undefined || dayLtvVal === undefined) return;\n\n                const yRet = height - (dayRet / 100) * height;\n                const yLtv = height - (dayLtvVal / maxLtv) * height;\n\n                // Move vertical line indicator\n                cursorLine.setAttribute('x1', mappedX);\n                cursorLine.setAttribute('x2', mappedX);\n                cursorLine.classList.remove('hidden');\n\n                // Move dot indicators\n                dotRetention.setAttribute('cx', mappedX);\n                dotRetention.setAttribute('cy', yRet);\n                dotRetention.classList.remove('hidden');\n\n                dotLtv.setAttribute('cx', mappedX);\n                dotLtv.setAttribute('cy', yLtv);\n                dotLtv.classList.remove('hidden');\n\n                // Generate text output\n                let str = `<span class=\"text-indigo-400 font-bold\">DAY ${dayIndex}:</span> &nbsp;` +\n                          `<span class=\"text-white\">${dayRet.toFixed(1)}% Retained</span> &nbsp;|&nbsp; ` +\n                          `<span class=\"text-emerald-400\">$${Math.round(dayLtvVal).toLocaleString()} Cumulative Value</span>`;\n\n                if (state.baselineData) {\n                    const baseRet = state.baselineData.retention[dayIndex];\n                    const baseLtv = state.baselineData.ltv[dayIndex];\n                    str += ` &nbsp;|&nbsp; <span class=\"text-violet-400 font-bold\">Baseline:</span> ` +\n                           `<span class=\"text-slate-300\">${baseRet.toFixed(1)}% / $${Math.round(baseLtv).toLocaleString()}</span>`;\n                }\n\n                hoverReadout.innerHTML = str;\n            }\n        }\n\n        function hideChartHover() {\n            document.getElementById('interactive-cursor-line').classList.add('hidden');\n            document.getElementById('interactive-cursor-dot-retention').classList.add('hidden');\n            document.getElementById('interactive-cursor-dot-ltv').classList.add('hidden');\n            document.getElementById('chart-hover-readout').innerHTML = \"Hover over the graph to dissect metrics\";\n        }\n\n        function renderMilestoneLedger() {\n            const tableBody = document.getElementById('cohort-ledger-body');\n            tableBody.innerHTML = '';\n\n            const milestones = [0, 1, 7, 15, 30, 60, 90];\n\n            milestones.forEach(day => {\n                const retRate = state.simulationData.retention[day];\n                const activeCohort = Math.round(10000 * (retRate / 100));\n                const cumulativeLtv = state.simulationData.ltv[day];\n\n                // Calculate current average active daily revenue per user\n                const whiteHatRaw = (state.drives.meaning * 1.0) + (state.drives.accomplishment * 1.0) + (state.drives.empowerment * 1.2);\n                const blackHatRaw = (state.drives.scarcity * 1.0) + (state.drives.unpredictability * 1.0) + (state.drives.loss * 1.2);\n                const finalWhiteHat = whiteHatRaw / 4.0;\n                const finalBlackHat = blackHatRaw / 4.0;\n\n                const revenuePerActiveExtractive = 0.65 * Math.exp(-day / 20.0) * (finalBlackHat / 5.0);\n                const revenuePerActiveValue = (0.08 + 0.0045 * day * finalWhiteHat) * (finalWhiteHat / 5.0);\n                const totalDailyRev = Math.max(0.01, revenuePerActiveExtractive + revenuePerActiveValue);\n\n                const row = document.createElement('tr');\n                row.className = \"hover:bg-slate-900/30 transition-all border-b border-slate-900/40\";\n                row.innerHTML = `\n                    <td class=\"py-2.5 font-bold text-slate-400\">Day ${day}</td>\n                    <td class=\"py-2.5 text-indigo-400 font-bold\">${retRate.toFixed(1)}%</td>\n                    <td class=\"py-2.5 text-slate-300\">${activeCohort.toLocaleString()}</td>\n                    <td class=\"py-2.5 text-slate-500\">$${totalDailyRev.toFixed(2)}</td>\n                    <td class=\"py-2.5 text-right text-emerald-400 font-bold\">$${Math.round(cumulativeLtv).toLocaleString()}</td>\n                `;\n                tableBody.appendChild(row);\n            });\n        }\n\n        function renderDynamicDiagnostics(W, B, burnout, boredom) {\n            const board = document.getElementById('diagnostics-board');\n            board.innerHTML = '';\n\n            // Core diagnostic rules derived dynamically\n            const diagnostics = [];\n\n            // Rule 1: Overjustification Threat\n            if (state.drives.accomplishment > 6 && state.drives.meaning < 3) {\n                diagnostics.push({\n                    title: \"Overjustification Trap\",\n                    status: \"danger\",\n                    icon: \"fa-triangle-exclamation\",\n                    desc: \"High progress triggers coupled with weak user purpose. Users are chasing short-term badges and tokens rather than experiencing genuine outcomes. Churn will accelerate once rewards stop.\"\n                });\n            } else if (state.drives.meaning >= 7) {\n                diagnostics.push({\n                    title: \"Intrinsic Value Moat\",\n                    status: \"success\",\n                    icon: \"fa-shield\",\n                    desc: \"Strong core narrative & meaning. Users value the software's role in their long-term growth and success, driving high intrinsic attachment.\"\n                });\n            }\n\n            // Rule 2: Streak Anxiety / Safety Net\n            if (state.drives.loss > 6 && state.microTriggers.lossAversion === 'dark') {\n                diagnostics.push({\n                    title: \"Extreme Streak Burnout\",\n                    status: \"danger\",\n                    icon: \"fa-heart-crack\",\n                    desc: \"Aggressive loss avoidance with zero grace periods. A single missed day entirely wipes user history. This induces initial anxiety and DAU compliance, but results in permanent departure on first failure.\"\n                });\n            } else if (state.microTriggers.lossAversion === 'useful' && state.drives.loss > 3) {\n                diagnostics.push({\n                    title: \"Resilience-Based Streak\",\n                    status: \"success\",\n                    icon: \"fa-umbrella\",\n                    desc: \"Streak-based loops backed by effort token safety nets. Prompts consistent engagement while allowing high human flexibility, strengthening habit formation.\"\n                });\n            }\n\n            // Rule 3: Gambling / Casino Hook\n            if (state.drives.unpredictability > 7 && state.microTriggers.variableRewards === 'dark') {\n                diagnostics.push({\n                    title: \"Casino-Type Decay Loop\",\n                    status: \"danger\",\n                    icon: \"fa-dice\",\n                    desc: \"Platform relies heavily on randomized microtransaction hooks. Drives immediate impulse spend and high early conversion, but rapidly erodes trust and long-term Customer Lifetime Value.\"\n                });\n            } else if (state.microTriggers.variableRewards === 'useful' && state.drives.empowerment > 6) {\n                diagnostics.push({\n                    title: \"Value Discovery Unlocks\",\n                    status: \"success\",\n                    icon: \"fa-wand-magic-sparkles\",\n                    desc: \"Variable rewards are structured as surprise capability upgrades or feature customization after genuine performance milestones. Maximizes user delight.\"\n                });\n            }\n\n            // Rule 4: Friction / Engagement Boredom\n            if (boredom > 6.0) {\n                diagnostics.push({\n                    title: \"Severe Under-Motivation\",\n                    status: \"warning\",\n                    icon: \"fa-battery-empty\",\n                    desc: \"Minimal core reward loops. Onboarding feels static, leading to heavy dropoffs in the first 7 days out of sheer user boredom.\"\n                });\n            }\n\n            // Ensure we show at least two helpful cards\n            if (diagnostics.length === 0) {\n                diagnostics.push({\n                    title: \"Balanced Hook Architecture\",\n                    status: \"success\",\n                    icon: \"fa-scale-balanced\",\n                    desc: \"Your setup achieves solid alignment. Positive, intrinsic drives are balanced against moderate curiosity hooks, avoiding rapid burnout mechanics.\"\n                });\n            }\n\n            // Render matching Cards\n            diagnostics.forEach(item => {\n                const card = document.createElement('div');\n                let colorClasses = \"bg-slate-950 border-slate-800 text-slate-300\";\n                let iconColor = \"text-indigo-400\";\n\n                if (item.status === 'danger') {\n                    colorClasses = \"bg-rose-950/20 border-rose-900/30 text-rose-200/90\";\n                    iconColor = \"text-rose-400\";\n                } else if (item.status === 'success') {\n                    colorClasses = \"bg-emerald-950/20 border-emerald-900/30 text-emerald-200/90\";\n                    iconColor = \"text-emerald-400\";\n                } else if (item.status === 'warning') {\n                    colorClasses = \"bg-amber-950/20 border-amber-900/30 text-amber-200/90\";\n                    iconColor = \"text-amber-400\";\n                }\n\n                card.className = `${colorClasses} p-4 rounded-xl border flex gap-3.5 items-start transition-all hover:scale-[1.01]`;\n                card.innerHTML = `\n                    <div class=\"p-2 bg-slate-900/80 border border-slate-800 rounded-lg ${iconColor} mt-0.5\">\n                        <i class=\"fa-solid ${item.icon} text-sm\"></i>\n                    </div>\n                    <div>\n                        <h4 class=\"text-xs font-bold uppercase tracking-wider mb-1 text-white\">${item.title}</h4>\n                        <p class=\"text-[11px] leading-relaxed text-slate-400\">${item.desc}</p>\n                    </div>\n                `;\n                board.appendChild(card);\n            });\n        }\n    </script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "UX Retention Simulator",
    "windowTitle": "UX Retention Simulator",
    "bundleId": "com.halisonworks.uxretentionsimulator",
    "iconPath": null
  },
  "categoryId": null,
