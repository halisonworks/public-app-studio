{
  "schema": "app-studio/canvas@1",
  "id": "example-trip-split",
  "name": "trip-split.html",
  "code": "<!DOCTYPE html>\n<!--\n  Trip Split — Halison App Studio example\n\n  Split shared trip costs between travellers and see the simplest set of\n  \"who owes whom\" payments to settle up. Saves to your browser.\n\n  From the Halison App Studio public library:\n  https://github.com/halisonworks/public-app-studio\n\n  Permitted use: personal, educational, and other non-commercial use. You may\n  modify it, but keep this header and the source link intact, and do not sell,\n  commercialize, or republish it. Released under the Halison App Studio Examples\n  License — see the LICENSE file in the repository above.\n-->\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Trip Split</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    * { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; overflow: hidden; }\n    body { font-family: system-ui, -apple-system, sans-serif; background: #0f172a; color: #e2e8f0; }\n\n    /* Scrollable panels */\n    .panel-scroll { overflow-y: auto; }\n    .panel-scroll::-webkit-scrollbar { width: 5px; }\n    .panel-scroll::-webkit-scrollbar-track { background: transparent; }\n    .panel-scroll::-webkit-scrollbar-thumb { background: #334155; border-radius: 10px; }\n\n    /* Card */\n    .card { background: #1e293b; border: 1px solid #334155; border-radius: 12px; }\n\n    /* Input */\n    input[type=\"text\"], input[type=\"number\"], select {\n      background: #0f172a; border: 1px solid #475569; color: #e2e8f0;\n      border-radius: 8px; padding: 8px 12px; width: 100%;\n      font-size: 0.875rem; outline: none; transition: border-color 0.15s;\n    }\n    input[type=\"text\"]:focus, input[type=\"number\"]:focus, select:focus {\n      border-color: #6366f1;\n    }\n    input[type=\"number\"] { -moz-appearance: textfield; }\n    input[type=\"number\"]::-webkit-inner-spin-button { display: none; }\n    select option { background: #1e293b; }\n\n    /* Checkbox */\n    input[type=\"checkbox\"] {\n      accent-color: #6366f1; width: 15px; height: 15px; cursor: pointer;\n    }\n\n    /* Btn */\n    .btn { border-radius: 8px; font-weight: 500; cursor: pointer; transition: all 0.15s; border: none; font-size: 0.875rem; padding: 8px 16px; display: inline-flex; align-items: center; gap: 6px; }\n    .btn-primary { background: #6366f1; color: white; }\n    .btn-primary:hover { background: #4f46e5; }\n    .btn-danger { background: #dc2626; color: white; }\n    .btn-danger:hover { background: #b91c1c; }\n    .btn-ghost { background: transparent; color: #94a3b8; border: 1px solid #334155; }\n    .btn-ghost:hover { background: #334155; color: #e2e8f0; }\n    .btn-sm { padding: 5px 10px; font-size: 0.8rem; }\n    .btn:disabled { opacity: 0.4; cursor: not-allowed; }\n\n    /* Tag/chip */\n    .chip { display: inline-flex; align-items: center; gap: 4px; background: #334155; border-radius: 99px; padding: 3px 10px; font-size: 0.75rem; color: #cbd5e1; }\n\n    /* Modal overlay */\n    .modal-bg { position: fixed; inset: 0; background: rgba(0,0,0,0.7); z-index: 50; display: flex; align-items: center; justify-content: center; }\n\n    /* Tabs */\n    .tab { cursor: pointer; padding: 8px 18px; border-radius: 8px; font-size: 0.875rem; font-weight: 500; transition: all 0.15s; color: #64748b; }\n    .tab.active { background: #6366f1; color: white; }\n    .tab:not(.active):hover { background: #1e293b; color: #e2e8f0; }\n\n    /* Amount input */\n    .amount-wrapper { position: relative; }\n    .amount-prefix { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #64748b; pointer-events: none; font-size: 0.875rem; }\n    .amount-wrapper input { padding-left: 32px; }\n\n    /* Badge */\n    .badge { display: inline-block; border-radius: 6px; padding: 2px 8px; font-size: 0.75rem; font-weight: 600; }\n    .badge-green { background: #14532d; color: #4ade80; }\n    .badge-red { background: #450a0a; color: #f87171; }\n    .badge-neutral { background: #1e3a5f; color: #93c5fd; }\n\n    /* Settle arrow */\n    .settle-arrow { color: #6366f1; font-size: 1rem; }\n\n    /* Empty state */\n    .empty-state { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; padding: 48px 24px; color: #475569; }\n    .empty-state svg { opacity: 0.4; }\n\n    /* Layout */\n    #app { display: grid; height: 100vh; grid-template-rows: auto 1fr; }\n    #main { display: grid; grid-template-columns: 320px 1fr; gap: 0; overflow: hidden; }\n    @media (max-width: 768px) {\n      #main { grid-template-columns: 1fr; grid-template-rows: auto 1fr; }\n      #sidebar { display: none; }\n      #sidebar.mobile-visible { display: flex; }\n    }\n\n    /* Expense list item hover */\n    .expense-item { transition: background 0.1s; }\n    .expense-item:hover { background: #263348; }\n\n    /* Balance bar */\n    .balance-bar-track { background: #1e293b; border-radius: 99px; height: 6px; overflow: hidden; }\n    .balance-bar-fill { height: 100%; border-radius: 99px; transition: width 0.3s; }\n  </style>\n</head>\n<body>\n\n<div id=\"app\">\n  <!-- HEADER -->\n  <header class=\"flex items-center justify-between px-5 py-3 border-b border-slate-700/60\" style=\"background:#1e293b;\">\n    <div class=\"flex items-center gap-3\">\n      <div class=\"w-8 h-8 rounded-lg bg-indigo-600 flex items-center justify-center text-white font-bold text-sm\">TS</div>\n      <div>\n        <h1 class=\"font-semibold text-white text-sm leading-tight\">Trip Split</h1>\n        <p id=\"trip-subtitle\" class=\"text-xs text-slate-400\"></p>\n      </div>\n    </div>\n    <div class=\"flex items-center gap-2\">\n      <span class=\"text-xs text-slate-500 hidden sm:block\">Currency symbol:</span>\n      <input type=\"text\" id=\"currency-input\" value=\"kr\" style=\"width:50px;text-align:center;padding:5px 8px;\" title=\"Currency symbol\" />\n      <button class=\"btn btn-ghost btn-sm\" onclick=\"openAddExpense()\">+ Expense</button>\n      <button class=\"btn btn-ghost btn-sm\" onclick=\"showResetConfirm()\">Reset</button>\n    </div>\n  </header>\n\n  <div id=\"main\">\n    <!-- SIDEBAR -->\n    <div id=\"sidebar\" class=\"flex flex-col border-r border-slate-700/60 overflow-hidden\" style=\"background:#16213a;\">\n      <!-- People section -->\n      <div class=\"p-4 border-b border-slate-700/60\">\n        <div class=\"flex items-center justify-between mb-3\">\n          <span class=\"text-xs font-semibold text-slate-400 uppercase tracking-wider\">Travellers</span>\n          <button class=\"btn btn-primary btn-sm\" onclick=\"openAddPerson()\">+ Add</button>\n        </div>\n        <div id=\"people-list\" class=\"flex flex-col gap-1\"></div>\n      </div>\n\n      <!-- Summary section -->\n      <div class=\"p-4 border-b border-slate-700/60\">\n        <div class=\"text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3\">Trip Summary</div>\n        <div class=\"flex flex-col gap-2 text-sm\">\n          <div class=\"flex justify-between\">\n            <span class=\"text-slate-400\">Total spent</span>\n            <span id=\"summary-total\" class=\"font-semibold text-white\">—</span>\n          </div>\n          <div class=\"flex justify-between\">\n            <span class=\"text-slate-400\">Fair share each</span>\n            <span id=\"summary-share\" class=\"font-semibold text-white\">—</span>\n          </div>\n          <div class=\"flex justify-between\">\n            <span class=\"text-slate-400\">Expenses</span>\n            <span id=\"summary-count\" class=\"font-semibold text-white\">0</span>\n          </div>\n        </div>\n      </div>\n\n      <!-- Balances -->\n      <div class=\"p-4 flex-1 panel-scroll\">\n        <div class=\"text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3\">Balances</div>\n        <div id=\"balances-list\" class=\"flex flex-col gap-2\"></div>\n      </div>\n    </div>\n\n    <!-- MAIN CONTENT -->\n    <div class=\"flex flex-col overflow-hidden\">\n      <!-- Tabs -->\n      <div class=\"flex items-center gap-1 p-3 border-b border-slate-700/60\" style=\"background:#16213a;\">\n        <div class=\"tab active\" onclick=\"switchTab('expenses')\" id=\"tab-expenses\">Expenses</div>\n        <div class=\"tab\" onclick=\"switchTab('settle')\" id=\"tab-settle\">Settle Up</div>\n      </div>\n\n      <!-- Expenses tab -->\n      <div id=\"pane-expenses\" class=\"flex-1 panel-scroll p-4\">\n        <div id=\"expenses-list\"></div>\n      </div>\n\n      <!-- Settle tab -->\n      <div id=\"pane-settle\" class=\"flex-1 panel-scroll p-4 hidden\">\n        <div id=\"settle-content\"></div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<!-- ============================================================ MODALS -->\n\n<!-- Add/Edit Expense Modal -->\n<div id=\"modal-expense\" class=\"modal-bg hidden\">\n  <div class=\"card p-6 w-full max-w-md mx-4\" style=\"max-height:90vh;overflow-y:auto;\">\n    <h2 id=\"modal-expense-title\" class=\"text-lg font-semibold text-white mb-5\">Add Expense</h2>\n    <div class=\"flex flex-col gap-4\">\n      <div>\n        <label class=\"block text-xs text-slate-400 mb-1\">Label</label>\n        <input type=\"text\" id=\"exp-label\" placeholder=\"e.g. Hotel, Dinner…\" />\n      </div>\n      <div>\n        <label class=\"block text-xs text-slate-400 mb-1\">Amount</label>\n        <div class=\"amount-wrapper\">\n          <span class=\"amount-prefix\" id=\"exp-currency-prefix\">kr</span>\n          <input type=\"number\" id=\"exp-amount\" placeholder=\"0\" min=\"0\" step=\"any\" />\n        </div>\n      </div>\n      <div>\n        <label class=\"block text-xs text-slate-400 mb-1\">Paid by</label>\n        <select id=\"exp-paidby\"></select>\n      </div>\n      <div>\n        <label class=\"block text-xs text-slate-400 mb-2\">Split between</label>\n        <div id=\"exp-split-checkboxes\" class=\"flex flex-col gap-2 pl-1\"></div>\n        <div class=\"flex gap-2 mt-2\">\n          <button class=\"btn btn-ghost btn-sm\" onclick=\"selectAllSplit()\">All</button>\n          <button class=\"btn btn-ghost btn-sm\" onclick=\"selectNoneSplit()\">None</button>\n        </div>\n        <p id=\"split-warning\" class=\"text-xs text-red-400 mt-1 hidden\">Select at least one person.</p>\n      </div>\n    </div>\n    <div class=\"flex gap-3 mt-6\">\n      <button class=\"btn btn-primary flex-1\" onclick=\"saveExpense()\">Save</button>\n      <button class=\"btn btn-ghost flex-1\" onclick=\"closeExpenseModal()\">Cancel</button>\n    </div>\n  </div>\n</div>\n\n<!-- Add Person Modal -->\n<div id=\"modal-person\" class=\"modal-bg hidden\">\n  <div class=\"card p-6 w-full max-w-xs mx-4\">\n    <h2 class=\"text-lg font-semibold text-white mb-4\">Add Traveller</h2>\n    <input type=\"text\" id=\"person-name-input\" placeholder=\"Name\" onkeydown=\"if(event.key==='Enter')savePerson()\" />\n    <p id=\"person-error\" class=\"text-xs text-red-400 mt-1 hidden\"></p>\n    <div class=\"flex gap-3 mt-5\">\n      <button class=\"btn btn-primary flex-1\" onclick=\"savePerson()\">Add</button>\n      <button class=\"btn btn-ghost flex-1\" onclick=\"closePersonModal()\">Cancel</button>\n    </div>\n  </div>\n</div>\n\n<!-- Reset Confirm Modal -->\n<div id=\"modal-reset\" class=\"modal-bg hidden\">\n  <div class=\"card p-6 w-full max-w-xs mx-4 text-center\">\n    <div class=\"text-4xl mb-3\">🗑️</div>\n    <h2 class=\"text-lg font-semibold text-white mb-2\">Reset everything?</h2>\n    <p class=\"text-sm text-slate-400 mb-5\">This will delete all travellers and expenses. Cannot be undone.</p>\n    <div class=\"flex gap-3\">\n      <button class=\"btn btn-danger flex-1\" onclick=\"doReset()\">Reset</button>\n      <button class=\"btn btn-ghost flex-1\" onclick=\"closeResetModal()\">Cancel</button>\n    </div>\n  </div>\n</div>\n\n<!-- Delete Expense Confirm -->\n<div id=\"modal-del-expense\" class=\"modal-bg hidden\">\n  <div class=\"card p-6 w-full max-w-xs mx-4 text-center\">\n    <h2 class=\"text-lg font-semibold text-white mb-2\">Delete expense?</h2>\n    <p id=\"del-expense-label\" class=\"text-sm text-slate-400 mb-5\"></p>\n    <div class=\"flex gap-3\">\n      <button class=\"btn btn-danger flex-1\" onclick=\"confirmDeleteExpense()\">Delete</button>\n      <button class=\"btn btn-ghost flex-1\" onclick=\"document.getElementById('modal-del-expense').classList.add('hidden')\">Cancel</button>\n    </div>\n  </div>\n</div>\n\n<!-- Delete Person Confirm -->\n<div id=\"modal-del-person\" class=\"modal-bg hidden\">\n  <div class=\"card p-6 w-full max-w-xs mx-4 text-center\">\n    <h2 class=\"text-lg font-semibold text-white mb-2\">Remove traveller?</h2>\n    <p id=\"del-person-label\" class=\"text-sm text-slate-400 mb-2\"></p>\n    <p class=\"text-xs text-amber-400 mb-5\">Expenses paid by or including this person will also be removed.</p>\n    <div class=\"flex gap-3\">\n      <button class=\"btn btn-danger flex-1\" onclick=\"confirmDeletePerson()\">Remove</button>\n      <button class=\"btn btn-ghost flex-1\" onclick=\"document.getElementById('modal-del-person').classList.add('hidden')\">Cancel</button>\n    </div>\n  </div>\n</div>\n\n<script>\n// ─── STATE ────────────────────────────────────────────────────────────────────\nconst STORAGE_KEY = 'trip-split-v1';\nlet state = { people: [], expenses: [], currency: 'kr' };\nlet editingExpenseId = null;\nlet pendingDeleteExpenseId = null;\nlet pendingDeletePersonId = null;\nlet activeTab = 'expenses';\n\n// ─── PERSISTENCE ──────────────────────────────────────────────────────────────\nfunction save() {\n  localStorage.setItem(STORAGE_KEY, JSON.stringify(state));\n}\nfunction load() {\n  try {\n    const raw = localStorage.getItem(STORAGE_KEY);\n    if (raw) state = JSON.parse(raw);\n  } catch(e) {}\n}\n\n// ─── DEFAULTS ─────────────────────────────────────────────────────────────────\nfunction seedDefaults() {\n  const ids = [uid(), uid(), uid()];\n  state.people = [\n    { id: ids[0], name: 'Anna' },\n    { id: ids[1], name: 'Ben' },\n    { id: ids[2], name: 'Cara' },\n  ];\n  state.expenses = [\n    { id: uid(), label: 'Hotel', amount: 4200, paidBy: ids[0], splitBetween: [...ids] },\n    { id: uid(), label: 'Rental car', amount: 1800, paidBy: ids[1], splitBetween: [...ids] },\n    { id: uid(), label: 'Dinner', amount: 950, paidBy: ids[2], splitBetween: [...ids] },\n  ];\n}\n\n// ─── UTILS ────────────────────────────────────────────────────────────────────\nfunction uid() { return Math.random().toString(36).slice(2) + Date.now().toString(36); }\nfunction fmt(n) {\n  const c = state.currency || 'kr';\n  const abs = Math.abs(n);\n  const s = Number.isInteger(abs) ? abs.toLocaleString() : abs.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });\n  return n < 0 ? `−${s} ${c}` : `${s} ${c}`;\n}\nfunction fmtAbs(n) {\n  const c = state.currency || 'kr';\n  const abs = Math.abs(n);\n  const s = Number.isInteger(abs) ? abs.toLocaleString() : abs.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });\n  return `${s} ${c}`;\n}\nfunction personName(id) {\n  const p = state.people.find(p => p.id === id);\n  return p ? p.name : '?';\n}\nfunction round2(n) { return Math.round(n * 100) / 100; }\n\n// ─── COMPUTATIONS ─────────────────────────────────────────────────────────────\nfunction computeBalances() {\n  const bal = {};\n  for (const p of state.people) bal[p.id] = 0;\n  for (const e of state.expenses) {\n    if (!bal.hasOwnProperty(e.paidBy)) continue;\n    const splitMembers = e.splitBetween.filter(id => bal.hasOwnProperty(id));\n    if (splitMembers.length === 0) continue;\n    const share = round2(e.amount / splitMembers.length);\n    // Paid by gets +amount, then subtracts their share\n    bal[e.paidBy] = round2(bal[e.paidBy] + e.amount);\n    for (const id of splitMembers) {\n      bal[id] = round2(bal[id] - share);\n    }\n  }\n  return bal;\n}\n\nfunction computeSettleUp(balances) {\n  // Greedy debt simplification\n  const entries = Object.entries(balances).map(([id, bal]) => ({ id, bal: round2(bal) }));\n  const payments = [];\n  const eps = 0.01;\n  let iters = 0;\n  while (iters++ < 1000) {\n    // Biggest debtor (most negative) and biggest creditor (most positive)\n    let debtor = null, creditor = null;\n    for (const e of entries) {\n      if (e.bal < -eps) {\n        if (!debtor || e.bal < debtor.bal) debtor = e;\n      }\n      if (e.bal > eps) {\n        if (!creditor || e.bal > creditor.bal) creditor = e;\n      }\n    }\n    if (!debtor || !creditor) break;\n    const amount = round2(Math.min(-debtor.bal, creditor.bal));\n    payments.push({ from: debtor.id, to: creditor.id, amount });\n    debtor.bal = round2(debtor.bal + amount);\n    creditor.bal = round2(creditor.bal - amount);\n  }\n  return payments;\n}\n\nfunction tripTotal() {\n  return state.expenses.reduce((s, e) => s + e.amount, 0);\n}\n\nfunction fairShare() {\n  if (state.people.length === 0) return 0;\n  return round2(tripTotal() / state.people.length);\n}\n\n// ─── RENDER ───────────────────────────────────────────────────────────────────\nfunction render() {\n  renderHeader();\n  renderPeople();\n  renderSummary();\n  renderBalances();\n  if (activeTab === 'expenses') renderExpenses();\n  else renderSettle();\n}\n\nfunction renderHeader() {\n  const n = state.people.length;\n  document.getElementById('trip-subtitle').textContent =\n    n === 0 ? 'No travellers yet' :\n    n === 1 ? '1 traveller' :\n    `${n} travellers · ${state.expenses.length} expense${state.expenses.length !== 1 ? 's' : ''}`;\n  document.getElementById('currency-input').value = state.currency || 'kr';\n}\n\nfunction renderPeople() {\n  const el = document.getElementById('people-list');\n  if (state.people.length === 0) {\n    el.innerHTML = '<p class=\"text-xs text-slate-500\">No travellers yet.</p>';\n    return;\n  }\n  el.innerHTML = state.people.map(p => `\n    <div class=\"flex items-center justify-between rounded-lg px-3 py-2 hover:bg-slate-700/40 transition-colors group\">\n      <div class=\"flex items-center gap-2\">\n        <div class=\"w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold text-white\" style=\"background:${avatarColor(p.id)}\">\n          ${p.name[0].toUpperCase()}\n        </div>\n        <span class=\"text-sm text-slate-200\">${escHtml(p.name)}</span>\n      </div>\n      <button class=\"btn btn-ghost btn-sm opacity-0 group-hover:opacity-100 transition-opacity\" style=\"padding:3px 7px;color:#f87171;\" onclick=\"openDeletePerson('${p.id}')\">✕</button>\n    </div>\n  `).join('');\n}\n\nfunction renderSummary() {\n  const total = tripTotal();\n  document.getElementById('summary-total').textContent = total > 0 ? fmtAbs(total) : '—';\n  document.getElementById('summary-share').textContent = state.people.length > 0 && total > 0 ? fmtAbs(fairShare()) : '—';\n  document.getElementById('summary-count').textContent = state.expenses.length;\n}\n\nfunction renderBalances() {\n  const el = document.getElementById('balances-list');\n  if (state.people.length === 0 || state.expenses.length === 0) {\n    el.innerHTML = '<p class=\"text-xs text-slate-500\">Add expenses to see balances.</p>';\n    return;\n  }\n  const bal = computeBalances();\n  const maxAbs = Math.max(1, ...Object.values(bal).map(v => Math.abs(v)));\n  el.innerHTML = state.people.map(p => {\n    const b = bal[p.id] || 0;\n    const pct = Math.min(100, Math.round(Math.abs(b) / maxAbs * 100));\n    const isPos = b > 0.005;\n    const isNeg = b < -0.005;\n    const color = isPos ? '#4ade80' : isNeg ? '#f87171' : '#94a3b8';\n    const barColor = isPos ? '#166534' : isNeg ? '#7f1d1d' : '#334155';\n    const label = isPos ? `gets back ${fmtAbs(b)}` : isNeg ? `owes ${fmtAbs(b)}` : 'settled';\n    return `\n      <div class=\"rounded-lg p-3\" style=\"background:#1e293b;\">\n        <div class=\"flex items-center justify-between mb-1\">\n          <div class=\"flex items-center gap-2\">\n            <div class=\"w-5 h-5 rounded-full flex items-center justify-center text-xs font-bold text-white\" style=\"background:${avatarColor(p.id)}\">\n              ${p.name[0].toUpperCase()}\n            </div>\n            <span class=\"text-xs font-medium text-slate-200\">${escHtml(p.name)}</span>\n          </div>\n          <span class=\"text-xs font-semibold\" style=\"color:${color}\">${b > 0.005 ? '+' : ''}${b < -0.005 ? '' : ''}${fmtAbs(b)}</span>\n        </div>\n        <div class=\"balance-bar-track\">\n          <div class=\"balance-bar-fill\" style=\"width:${pct}%;background:${barColor};\"></div>\n        </div>\n        <div class=\"text-xs mt-1\" style=\"color:#64748b\">${label}</div>\n      </div>\n    `;\n  }).join('');\n}\n\nfunction renderExpenses() {\n  const el = document.getElementById('expenses-list');\n  if (state.expenses.length === 0) {\n    el.innerHTML = `\n      <div class=\"empty-state\">\n        <svg width=\"48\" height=\"48\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" d=\"M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2\"/></svg>\n        <div class=\"text-center\">\n          <p class=\"font-medium text-slate-300\">No expenses yet</p>\n          <p class=\"text-sm mt-1\">Click <strong>+ Expense</strong> to add the first one.</p>\n        </div>\n      </div>`;\n    return;\n  }\n  el.innerHTML = state.expenses.map(e => {\n    const payer = personName(e.paidBy);\n    const splitNames = e.splitBetween.map(personName);\n    const perPerson = e.splitBetween.length > 0 ? round2(e.amount / e.splitBetween.length) : 0;\n    const isAll = e.splitBetween.length === state.people.length;\n    return `\n      <div class=\"expense-item card mb-2 px-4 py-3 flex items-start justify-between gap-3 cursor-default rounded-xl\">\n        <div class=\"flex-1 min-w-0\">\n          <div class=\"flex items-center gap-2 mb-1\">\n            <span class=\"font-medium text-white truncate\">${escHtml(e.label)}</span>\n            <span class=\"chip\">${escHtml(payer)}</span>\n          </div>\n          <div class=\"flex items-center gap-2 flex-wrap\">\n            <span class=\"text-xs text-slate-400\">Split: ${isAll ? 'everyone' : splitNames.map(escHtml).join(', ')}</span>\n            ${perPerson > 0 ? `<span class=\"text-xs text-slate-500\">· ${fmtAbs(perPerson)} each</span>` : ''}\n          </div>\n        </div>\n        <div class=\"flex flex-col items-end gap-2 shrink-0\">\n          <span class=\"font-semibold text-white\">${fmtAbs(e.amount)}</span>\n          <div class=\"flex gap-1\">\n            <button class=\"btn btn-ghost btn-sm\" onclick=\"openEditExpense('${e.id}')\">Edit</button>\n            <button class=\"btn btn-ghost btn-sm\" style=\"color:#f87171;\" onclick=\"openDeleteExpense('${e.id}')\">Del</button>\n          </div>\n        </div>\n      </div>\n    `;\n  }).join('');\n}\n\nfunction renderSettle() {\n  const el = document.getElementById('settle-content');\n  if (state.people.length < 2 || state.expenses.length === 0) {\n    el.innerHTML = `\n      <div class=\"empty-state\">\n        <svg width=\"48\" height=\"48\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" d=\"M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z\"/></svg>\n        <div class=\"text-center\">\n          <p class=\"font-medium text-slate-300\">Nothing to settle yet</p>\n          <p class=\"text-sm mt-1\">Add at least 2 travellers and some expenses first.</p>\n        </div>\n      </div>`;\n    return;\n  }\n  const bal = computeBalances();\n  const payments = computeSettleUp(bal);\n  if (payments.length === 0) {\n    el.innerHTML = `\n      <div class=\"empty-state\">\n        <div style=\"font-size:3rem\">🎉</div>\n        <div class=\"text-center\">\n          <p class=\"font-semibold text-green-400 text-lg\">All settled up!</p>\n          <p class=\"text-sm mt-1\">Everyone's balance is already zero.</p>\n        </div>\n      </div>`;\n    return;\n  }\n  const c = state.currency || 'kr';\n  el.innerHTML = `\n    <div class=\"mb-4\">\n      <h3 class=\"text-sm font-semibold text-slate-300 mb-1\">Minimal payments to settle all debts</h3>\n      <p class=\"text-xs text-slate-500\">${payments.length} payment${payments.length !== 1 ? 's' : ''} needed</p>\n    </div>\n    <div class=\"flex flex-col gap-3\">\n      ${payments.map(p => {\n        const amount = Number.isInteger(p.amount)\n          ? p.amount.toLocaleString()\n          : p.amount.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2});\n        return `\n          <div class=\"card p-4 rounded-xl flex items-center gap-4\">\n            <div class=\"flex items-center gap-2\">\n              <div class=\"w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold text-white shrink-0\" style=\"background:${avatarColor(p.from)}\">\n                ${personName(p.from)[0].toUpperCase()}\n              </div>\n              <span class=\"font-medium text-white\">${escHtml(personName(p.from))}</span>\n            </div>\n            <div class=\"flex flex-col items-center flex-1\">\n              <span class=\"text-xs text-slate-500 mb-1\">pays</span>\n              <span class=\"font-bold text-indigo-400 text-base\">${amount} ${c}</span>\n              <div class=\"flex items-center gap-1 mt-1\">\n                <div class=\"h-px flex-1 bg-indigo-800\" style=\"width:40px;\"></div>\n                <svg width=\"14\" height=\"14\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"#6366f1\" stroke-width=\"2.5\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13 7l5 5m0 0l-5 5m5-5H6\"/></svg>\n              </div>\n            </div>\n            <div class=\"flex items-center gap-2\">\n              <span class=\"font-medium text-white\">${escHtml(personName(p.to))}</span>\n              <div class=\"w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold text-white shrink-0\" style=\"background:${avatarColor(p.to)}\">\n                ${personName(p.to)[0].toUpperCase()}\n              </div>\n            </div>\n          </div>\n        `;\n      }).join('')}\n    </div>\n    <div class=\"mt-5 p-4 rounded-xl border border-slate-700/60 text-sm text-slate-400\" style=\"background:#1e293b;\">\n      After these payments, all balances will be zero.\n    </div>\n  `;\n}\n\n// ─── AVATAR COLORS ────────────────────────────────────────────────────────────\nconst AVATAR_COLORS = ['#6366f1','#8b5cf6','#ec4899','#f59e0b','#10b981','#3b82f6','#ef4444','#14b8a6'];\nconst colorCache = {};\nfunction avatarColor(id) {\n  if (!colorCache[id]) {\n    let h = 0;\n    for (let i = 0; i < id.length; i++) h = (h * 31 + id.charCodeAt(i)) >>> 0;\n    colorCache[id] = AVATAR_COLORS[h % AVATAR_COLORS.length];\n  }\n  return colorCache[id];\n}\n\n// ─── TAB SWITCHING ────────────────────────────────────────────────────────────\nfunction switchTab(tab) {\n  activeTab = tab;\n  document.getElementById('tab-expenses').classList.toggle('active', tab === 'expenses');\n  document.getElementById('tab-settle').classList.toggle('active', tab === 'settle');\n  document.getElementById('pane-expenses').classList.toggle('hidden', tab !== 'expenses');\n  document.getElementById('pane-settle').classList.toggle('hidden', tab !== 'settle');\n  if (tab === 'settle') renderSettle();\n  else renderExpenses();\n}\n\n// ─── EXPENSE MODAL ────────────────────────────────────────────────────────────\nfunction openAddExpense() {\n  editingExpenseId = null;\n  document.getElementById('modal-expense-title').textContent = 'Add Expense';\n  document.getElementById('exp-label').value = '';\n  document.getElementById('exp-amount').value = '';\n  populatePaidBySelect(null);\n  populateSplitCheckboxes([]);\n  document.getElementById('split-warning').classList.add('hidden');\n  document.getElementById('exp-currency-prefix').textContent = state.currency || 'kr';\n  document.getElementById('modal-expense').classList.remove('hidden');\n  setTimeout(() => document.getElementById('exp-label').focus(), 50);\n}\n\nfunction openEditExpense(id) {\n  const e = state.expenses.find(x => x.id === id);\n  if (!e) return;\n  editingExpenseId = id;\n  document.getElementById('modal-expense-title').textContent = 'Edit Expense';\n  document.getElementById('exp-label').value = e.label;\n  document.getElementById('exp-amount').value = e.amount;\n  populatePaidBySelect(e.paidBy);\n  populateSplitCheckboxes(e.splitBetween);\n  document.getElementById('split-warning').classList.add('hidden');\n  document.getElementById('exp-currency-prefix').textContent = state.currency || 'kr';\n  document.getElementById('modal-expense').classList.remove('hidden');\n}\n\nfunction populatePaidBySelect(selectedId) {\n  const sel = document.getElementById('exp-paidby');\n  sel.innerHTML = state.people.map(p =>\n    `<option value=\"${p.id}\" ${p.id === selectedId ? 'selected' : ''}>${escHtml(p.name)}</option>`\n  ).join('');\n}\n\nfunction populateSplitCheckboxes(selectedIds) {\n  const wrap = document.getElementById('exp-split-checkboxes');\n  const allSelected = selectedIds.length === 0; // default: select all\n  wrap.innerHTML = state.people.map(p => {\n    const checked = selectedIds.length === 0 ? true : selectedIds.includes(p.id);\n    return `\n      <label class=\"flex items-center gap-2 cursor-pointer select-none\">\n        <input type=\"checkbox\" class=\"split-cb\" value=\"${p.id}\" ${checked ? 'checked' : ''} />\n        <div class=\"w-5 h-5 rounded-full flex items-center justify-center text-xs font-bold text-white\" style=\"background:${avatarColor(p.id)}\">${p.name[0].toUpperCase()}</div>\n        <span class=\"text-sm text-slate-200\">${escHtml(p.name)}</span>\n      </label>\n    `;\n  }).join('');\n}\n\nfunction selectAllSplit() {\n  document.querySelectorAll('.split-cb').forEach(cb => cb.checked = true);\n}\nfunction selectNoneSplit() {\n  document.querySelectorAll('.split-cb').forEach(cb => cb.checked = false);\n}\n\nfunction saveExpense() {\n  const label = document.getElementById('exp-label').value.trim();\n  const amount = parseFloat(document.getElementById('exp-amount').value);\n  const paidBy = document.getElementById('exp-paidby').value;\n  const splitBetween = Array.from(document.querySelectorAll('.split-cb:checked')).map(cb => cb.value);\n\n  if (!label || isNaN(amount) || amount <= 0 || !paidBy) return;\n  if (splitBetween.length === 0) {\n    document.getElementById('split-warning').classList.remove('hidden');\n    return;\n  }\n  document.getElementById('split-warning').classList.add('hidden');\n\n  if (editingExpenseId) {\n    const idx = state.expenses.findIndex(e => e.id === editingExpenseId);\n    if (idx >= 0) state.expenses[idx] = { ...state.expenses[idx], label, amount: round2(amount), paidBy, splitBetween };\n  } else {\n    state.expenses.push({ id: uid(), label, amount: round2(amount), paidBy, splitBetween });\n  }\n  save();\n  closeExpenseModal();\n  render();\n}\n\nfunction closeExpenseModal() {\n  document.getElementById('modal-expense').classList.add('hidden');\n  editingExpenseId = null;\n}\n\n// ─── DELETE EXPENSE ───────────────────────────────────────────────────────────\nfunction openDeleteExpense(id) {\n  pendingDeleteExpenseId = id;\n  const e = state.expenses.find(x => x.id === id);\n  document.getElementById('del-expense-label').textContent = e ? `\"${e.label}\" (${fmtAbs(e.amount)})` : '';\n  document.getElementById('modal-del-expense').classList.remove('hidden');\n}\nfunction confirmDeleteExpense() {\n  if (pendingDeleteExpenseId) {\n    state.expenses = state.expenses.filter(e => e.id !== pendingDeleteExpenseId);\n    pendingDeleteExpenseId = null;\n    save();\n    render();\n  }\n  document.getElementById('modal-del-expense').classList.add('hidden');\n}\n\n// ─── PERSON MODAL ─────────────────────────────────────────────────────────────\nfunction openAddPerson() {\n  document.getElementById('person-name-input').value = '';\n  document.getElementById('person-error').classList.add('hidden');\n  document.getElementById('modal-person').classList.remove('hidden');\n  setTimeout(() => document.getElementById('person-name-input').focus(), 50);\n}\nfunction closePersonModal() {\n  document.getElementById('modal-person').classList.add('hidden');\n}\nfunction savePerson() {\n  const name = document.getElementById('person-name-input').value.trim();\n  const errEl = document.getElementById('person-error');\n  if (!name) { errEl.textContent = 'Please enter a name.'; errEl.classList.remove('hidden'); return; }\n  if (state.people.some(p => p.name.toLowerCase() === name.toLowerCase())) {\n    errEl.textContent = 'That name is already in the list.'; errEl.classList.remove('hidden'); return;\n  }\n  state.people.push({ id: uid(), name });\n  save();\n  closePersonModal();\n  render();\n}\n\n// ─── DELETE PERSON ────────────────────────────────────────────────────────────\nfunction openDeletePerson(id) {\n  pendingDeletePersonId = id;\n  const p = state.people.find(x => x.id === id);\n  document.getElementById('del-person-label').textContent = p ? `Remove \"${p.name}\" from the trip?` : '';\n  document.getElementById('modal-del-person').classList.remove('hidden');\n}\nfunction confirmDeletePerson() {\n  if (pendingDeletePersonId) {\n    state.expenses = state.expenses.filter(e =>\n      e.paidBy !== pendingDeletePersonId &&\n      e.splitBetween.includes(pendingDeletePersonId)\n        ? (e.splitBetween = e.splitBetween.filter(id => id !== pendingDeletePersonId), e.splitBetween.length > 0)\n        : true\n    );\n    // Re-filter: remove expenses whose payer was this person\n    state.expenses = state.expenses.filter(e => e.paidBy !== pendingDeletePersonId);\n    // Also clean up splitBetween\n    for (const e of state.expenses) {\n      e.splitBetween = e.splitBetween.filter(id => id !== pendingDeletePersonId);\n      if (e.splitBetween.length === 0) {\n        // remove this expense too\n      }\n    }\n    state.expenses = state.expenses.filter(e => e.splitBetween.length > 0);\n    state.people = state.people.filter(p => p.id !== pendingDeletePersonId);\n    pendingDeletePersonId = null;\n    save();\n    render();\n  }\n  document.getElementById('modal-del-person').classList.add('hidden');\n}\n\n// ─── RESET ────────────────────────────────────────────────────────────────────\nfunction showResetConfirm() { document.getElementById('modal-reset').classList.remove('hidden'); }\nfunction closeResetModal() { document.getElementById('modal-reset').classList.add('hidden'); }\nfunction doReset() {\n  state = { people: [], expenses: [], currency: state.currency || 'kr' };\n  save();\n  closeResetModal();\n  render();\n}\n\n// ─── CURRENCY ─────────────────────────────────────────────────────────────────\ndocument.getElementById('currency-input').addEventListener('input', function() {\n  state.currency = this.value.trim() || 'kr';\n  save();\n  render();\n});\n\n// ─── CLOSE MODALS ON BACKDROP CLICK ──────────────────────────────────────────\n['modal-expense','modal-person','modal-reset','modal-del-expense','modal-del-person'].forEach(id => {\n  document.getElementById(id).addEventListener('click', function(e) {\n    if (e.target === this) this.classList.add('hidden');\n  });\n});\n\n// ─── ESCAPE KEY ───────────────────────────────────────────────────────────────\ndocument.addEventListener('keydown', function(e) {\n  if (e.key === 'Escape') {\n    ['modal-expense','modal-person','modal-reset','modal-del-expense','modal-del-person'].forEach(id => {\n      document.getElementById(id).classList.add('hidden');\n    });\n  }\n});\n\n// ─── HELPERS ──────────────────────────────────────────────────────────────────\nfunction escHtml(s) {\n  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;');\n}\n\n// ─── INIT ─────────────────────────────────────────────────────────────────────\nload();\nif (state.people.length === 0 && state.expenses.length === 0) {\n  seedDefaults();\n  save();\n}\nrender();\n</script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Trip Split",
    "windowTitle": "Trip Split",
    "bundleId": "com.halisonworks.tripsplit",
    "iconPath": null
  },
  "categoryId": null,
  "source": "import",
  "createdAt": "2026-06-02T16:00:00.000Z",
  "updatedAt": "2026-06-02T16:00:00.000Z",
  "sharedAt": "2026-06-02T16:00:00.000Z"
}
