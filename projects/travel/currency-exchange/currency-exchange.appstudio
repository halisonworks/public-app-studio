{
  "schema": "app-studio/canvas@1",
  "id": "example-currency-exchange",
  "name": "currency-exchange.html",
  "code": "<!DOCTYPE html>\n<!--\n  Currency Exchange & the Spread — Halison App Studio example\n\n  A teaching tool for the Sales, Service and Tourism classroom: why you get less\n  money back than you changed. Shows mid-market rate, the buy/sell spread, and\n  fees — with editable mock rates (no live data).\n\n  From the Halison App Studio public library:\n  https://github.com/halisonworks/public-app-studio\n\n  Permitted use: personal, educational, and other non-commercial use. You may\n  modify it, but keep this header and the source link intact, and do not sell,\n  commercialize, or republish it. Released under the Halison App Studio Examples\n  License — see the LICENSE file in the repository above.\n-->\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Currency Exchange &amp; the Spread</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Inter', system-ui, -apple-system, sans-serif; background: #f8fafc; }\n\n    /* Tab underline */\n    .tab-btn { position: relative; transition: color 0.18s; }\n    .tab-btn.active { color: #2563eb; }\n    .tab-btn.active::after {\n      content: '';\n      position: absolute; bottom: -2px; left: 0; right: 0;\n      height: 3px; border-radius: 99px;\n      background: #2563eb;\n    }\n\n    /* Range slider */\n    input[type=range] { accent-color: #2563eb; cursor: pointer; }\n\n    /* Editable rate cell */\n    .rate-cell {\n      background: #f1f5f9; border: 1px solid #e2e8f0;\n      border-radius: 6px; padding: 2px 6px;\n      font-variant-numeric: tabular-nums;\n      width: 72px; text-align: right;\n      font-size: 0.85rem; font-weight: 600;\n      transition: border-color 0.15s, box-shadow 0.15s;\n    }\n    .rate-cell:focus { outline: none; border-color: #2563eb; box-shadow: 0 0 0 2px #bfdbfe; background: #fff; }\n\n    /* Bar chart */\n    .bar-wrap { height: 28px; border-radius: 6px; overflow: hidden; background: #e2e8f0; }\n    .bar-fill { height: 100%; border-radius: 6px; transition: width 0.4s ease; }\n\n    /* Present mode overlay */\n    #present-overlay {\n      display: none; position: fixed; inset: 0; z-index: 100;\n      background: #0f172a; color: #f8fafc;\n      flex-direction: column; align-items: center; justify-content: center;\n      padding: 2rem;\n    }\n    #present-overlay.active { display: flex; }\n\n    /* Tooltip */\n    .tip {\n      position: relative; cursor: help; border-bottom: 1px dashed #94a3b8;\n    }\n    .tip:hover::after {\n      content: attr(data-tip);\n      position: absolute; bottom: 125%; left: 50%; transform: translateX(-50%);\n      background: #1e293b; color: #f1f5f9; border-radius: 6px;\n      font-size: 0.7rem; padding: 5px 8px; white-space: nowrap;\n      z-index: 20; pointer-events: none;\n      box-shadow: 0 2px 8px rgba(0,0,0,0.3);\n    }\n\n    /* Number highlight */\n    .num { font-variant-numeric: tabular-nums; }\n\n    /* Card */\n    .card { background: #fff; border-radius: 12px; border: 1px solid #e2e8f0; padding: 1.25rem 1.5rem; }\n\n    /* Loss pill */\n    .loss-pill { background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; border-radius: 6px; padding: 2px 8px; font-size: 0.78rem; font-weight: 600; }\n    .gain-pill { background: #f0fdf4; color: #16a34a; border: 1px solid #bbf7d0; border-radius: 6px; padding: 2px 8px; font-size: 0.78rem; font-weight: 600; }\n\n    /* Learn accordion */\n    .accordion-panel { overflow: hidden; max-height: 0; transition: max-height 0.35s ease; }\n    .accordion-panel.open { max-height: 600px; }\n\n    /* Flag emoji sizing */\n    .flag { font-size: 1.1rem; }\n  </style>\n</head>\n<body class=\"min-h-screen flex flex-col\">\n\n<!-- ============================================================\n     PRESENT MODE OVERLAY\n     ============================================================ -->\n<div id=\"present-overlay\">\n  <button id=\"exit-present-btn\"\n    class=\"absolute top-5 right-6 text-slate-400 hover:text-white text-sm flex items-center gap-1 transition-colors\">\n    <span>✕ Exit (ESC)</span>\n  </button>\n\n  <div class=\"text-center max-w-3xl w-full\">\n    <p class=\"text-slate-400 text-sm uppercase tracking-widest mb-2\">Currency Exchange &amp; the Spread</p>\n    <div class=\"flex items-center justify-center gap-3 mb-8\">\n      <span id=\"p-flag\" class=\"text-5xl\"></span>\n      <h1 id=\"p-pair\" class=\"text-4xl font-bold text-white\">NOK / EUR</h1>\n    </div>\n\n    <div class=\"grid grid-cols-3 gap-6 mb-8\">\n      <div class=\"bg-slate-800 rounded-2xl p-5\">\n        <p class=\"text-slate-400 text-xs uppercase tracking-wide mb-1\">Mid-market rate</p>\n        <p id=\"p-mid\" class=\"text-3xl font-bold text-white num\">–</p>\n        <p class=\"text-slate-500 text-xs mt-1\">kr per 1 unit</p>\n      </div>\n      <div class=\"bg-slate-800 rounded-2xl p-5\">\n        <p class=\"text-slate-400 text-xs uppercase tracking-wide mb-1\">Bureau sell rate</p>\n        <p id=\"p-sell\" class=\"text-3xl font-bold text-amber-400 num\">–</p>\n        <p class=\"text-slate-500 text-xs mt-1\">you pay this to buy foreign</p>\n      </div>\n      <div class=\"bg-slate-800 rounded-2xl p-5\">\n        <p class=\"text-slate-400 text-xs uppercase tracking-wide mb-1\">Bureau buy rate</p>\n        <p id=\"p-buy\" class=\"text-3xl font-bold text-sky-400 num\">–</p>\n        <p class=\"text-slate-500 text-xs mt-1\">you get this when selling back</p>\n      </div>\n    </div>\n\n    <div class=\"grid grid-cols-2 gap-6 mb-8\">\n      <div class=\"bg-slate-800 rounded-2xl p-5\">\n        <p class=\"text-slate-400 text-xs uppercase tracking-wide mb-1\">Spread</p>\n        <p id=\"p-spread\" class=\"text-4xl font-bold text-rose-400 num\">–</p>\n      </div>\n      <div class=\"bg-slate-800 rounded-2xl p-5\">\n        <p class=\"text-slate-400 text-xs uppercase tracking-wide mb-1\">Round-trip loss on 5 000 kr</p>\n        <p id=\"p-loss\" class=\"text-4xl font-bold text-rose-400 num\">–</p>\n        <p id=\"p-loss-pct\" class=\"text-slate-400 text-sm mt-1 num\">–</p>\n      </div>\n    </div>\n\n    <p class=\"text-slate-500 text-xs\">Rates are editable mock data — not a live feed</p>\n  </div>\n</div>\n\n<!-- ============================================================\n     MAIN APP\n     ============================================================ -->\n<div class=\"flex flex-col min-h-screen\">\n\n  <!-- Header -->\n  <header class=\"bg-white border-b border-slate-200 px-5 py-3 flex items-center justify-between sticky top-0 z-10\">\n    <div class=\"flex items-center gap-2\">\n      <span class=\"text-xl\">💱</span>\n      <div>\n        <h1 class=\"text-base font-bold text-slate-800 leading-tight\">Currency Exchange &amp; the Spread</h1>\n        <p class=\"text-xs text-slate-500 leading-tight hidden sm:block\">Why do you always get less money back than you changed?</p>\n      </div>\n    </div>\n\n    <div class=\"flex items-center gap-3\">\n      <!-- Tabs -->\n      <nav class=\"flex gap-1 border-b-2 border-transparent\" role=\"tablist\">\n        <button id=\"tab-learn\" class=\"tab-btn active px-3 py-2 text-sm font-semibold text-slate-500 hover:text-slate-800\"\n          onclick=\"switchTab('learn')\">Learn</button>\n        <button id=\"tab-practice\" class=\"tab-btn px-3 py-2 text-sm font-semibold text-slate-500 hover:text-slate-800\"\n          onclick=\"switchTab('practice')\">Practice</button>\n      </nav>\n      <button id=\"enter-present-btn\"\n        class=\"ml-2 bg-slate-800 text-white text-xs font-semibold px-3 py-1.5 rounded-lg hover:bg-slate-700 transition-colors flex items-center gap-1\">\n        <span>📽</span> Present\n      </button>\n    </div>\n  </header>\n\n  <!-- Tab: Learn -->\n  <div id=\"tab-learn-panel\" class=\"flex-1 overflow-y-auto p-4 md:p-6 max-w-3xl mx-auto w-full\">\n\n    <!-- Intro -->\n    <div class=\"card mb-4\">\n      <h2 class=\"text-lg font-bold text-slate-800 mb-2\">Why do you always lose money at a currency exchange?</h2>\n      <p class=\"text-sm text-slate-600 leading-relaxed\">\n        Every time you exchange money — at an airport kiosk, a bank, or an ATM abroad — you lose a little.\n        Even if you change back the same amount you started with, you end up with <em>less</em> than you began with.\n        That's not a glitch. It's a built-in margin called the <strong>spread</strong>.\n      </p>\n    </div>\n\n    <!-- Accordion sections -->\n    <div class=\"space-y-3\">\n\n      <!-- 1. Mid-market rate -->\n      <div class=\"card p-0 overflow-hidden\">\n        <button class=\"w-full text-left px-5 py-4 flex items-center justify-between font-semibold text-slate-700 hover:bg-slate-50 transition-colors accordion-toggle\"\n          data-target=\"acc1\">\n          <span class=\"flex items-center gap-2\">\n            <span class=\"text-blue-500 text-lg\">①</span> The mid-market rate — the \"real\" rate\n          </span>\n          <span class=\"accordion-arrow text-slate-400 transition-transform\">▼</span>\n        </button>\n        <div id=\"acc1\" class=\"accordion-panel px-5 pb-4\">\n          <p class=\"text-sm text-slate-600 leading-relaxed mb-3\">\n            The <strong>mid-market rate</strong> (also called the interbank rate) is the midpoint between\n            the price traders are willing to buy and sell a currency for on wholesale markets.\n            It's what you see on Google or XE.com — and it's <em>not</em> the rate you get at a bureau.\n          </p>\n          <div class=\"bg-blue-50 border border-blue-200 rounded-lg p-3 text-sm\">\n            <strong>Example:</strong> The mid-market rate for EUR is <strong>11.50 kr per €1</strong>.\n            This is the \"fair\" reference price. Bureaux add a margin around it.\n          </div>\n        </div>\n      </div>\n\n      <!-- 2. Buy & sell rates -->\n      <div class=\"card p-0 overflow-hidden\">\n        <button class=\"w-full text-left px-5 py-4 flex items-center justify-between font-semibold text-slate-700 hover:bg-slate-50 transition-colors accordion-toggle\"\n          data-target=\"acc2\">\n          <span class=\"flex items-center gap-2\">\n            <span class=\"text-amber-500 text-lg\">②</span> Buy rate and sell rate\n          </span>\n          <span class=\"accordion-arrow text-slate-400 transition-transform\">▼</span>\n        </button>\n        <div id=\"acc2\" class=\"accordion-panel px-5 pb-4\">\n          <p class=\"text-sm text-slate-600 leading-relaxed mb-3\">\n            A bureau quotes two rates. <strong>Remember: the terms are from the bureau's perspective.</strong>\n          </p>\n          <div class=\"grid sm:grid-cols-2 gap-3 mb-3\">\n            <div class=\"bg-amber-50 border border-amber-200 rounded-lg p-3 text-sm\">\n              <strong class=\"text-amber-700\">Sell rate</strong><br/>\n              The bureau <em>sells</em> you foreign currency.<br/>\n              You pay <em>more</em> kr per unit than mid. This is the worse rate when you're going abroad.\n            </div>\n            <div class=\"bg-sky-50 border border-sky-200 rounded-lg p-3 text-sm\">\n              <strong class=\"text-sky-700\">Buy rate</strong><br/>\n              The bureau <em>buys</em> foreign currency back from you.<br/>\n              You receive <em>fewer</em> kr per unit than mid. This is the worse rate when you return home.\n            </div>\n          </div>\n          <p class=\"text-sm text-slate-600\">\n            With a 2.5% spread: EUR mid = 11.50 → sell rate ≈ 11.79 kr, buy rate ≈ 11.21 kr.\n          </p>\n        </div>\n      </div>\n\n      <!-- 3. The spread -->\n      <div class=\"card p-0 overflow-hidden\">\n        <button class=\"w-full text-left px-5 py-4 flex items-center justify-between font-semibold text-slate-700 hover:bg-slate-50 transition-colors accordion-toggle\"\n          data-target=\"acc3\">\n          <span class=\"flex items-center gap-2\">\n            <span class=\"text-rose-500 text-lg\">③</span> The spread — the bureau's margin\n          </span>\n          <span class=\"accordion-arrow text-slate-400 transition-transform\">▼</span>\n        </button>\n        <div id=\"acc3\" class=\"accordion-panel px-5 pb-4\">\n          <p class=\"text-sm text-slate-600 leading-relaxed mb-3\">\n            The <strong>spread</strong> is the gap between the sell rate and buy rate, expressed as a % of mid.\n            A ±2.5% spread means the bureau earns about 5% on a round trip.\n          </p>\n          <div class=\"bg-slate-50 rounded-lg p-3 text-sm font-mono text-slate-700 mb-3 space-y-1\">\n            <div>sell rate = mid × (1 + spread%)</div>\n            <div>buy rate  = mid × (1 − spread%)</div>\n            <div class=\"text-slate-400 mt-1\">e.g. 11.50 × 1.025 = 11.79 | 11.50 × 0.975 = 11.21</div>\n          </div>\n          <p class=\"text-sm text-slate-600\">\n            Airports and tourist centres often charge 3–5%. Banks are typically 1–3%.\n            Some fintech cards use the true mid-market rate with a flat fee.\n          </p>\n        </div>\n      </div>\n\n      <!-- 4. Fees & commission -->\n      <div class=\"card p-0 overflow-hidden\">\n        <button class=\"w-full text-left px-5 py-4 flex items-center justify-between font-semibold text-slate-700 hover:bg-slate-50 transition-colors accordion-toggle\"\n          data-target=\"acc4\">\n          <span class=\"flex items-center gap-2\">\n            <span class=\"text-purple-500 text-lg\">④</span> Fees and commission\n          </span>\n          <span class=\"accordion-arrow text-slate-400 transition-transform\">▼</span>\n        </button>\n        <div id=\"acc4\" class=\"accordion-panel px-5 pb-4\">\n          <p class=\"text-sm text-slate-600 leading-relaxed mb-3\">\n            On top of the spread, many bureaux charge a <strong>fixed fee</strong> (e.g. 35 kr per transaction)\n            and/or a <strong>commission %</strong> (e.g. 0.5% of the amount).\n            These hit small transactions hardest.\n          </p>\n          <div class=\"bg-purple-50 border border-purple-200 rounded-lg p-3 text-sm\">\n            Changing 500 kr with a 35 kr fee = 7% gone just in fees before the spread even applies.\n            Changing 5 000 kr = only 0.7% in fees.\n          </div>\n        </div>\n      </div>\n\n      <!-- 5. Worked example -->\n      <div class=\"card p-0 overflow-hidden\">\n        <button class=\"w-full text-left px-5 py-4 flex items-center justify-between font-semibold text-slate-700 hover:bg-slate-50 transition-colors accordion-toggle\"\n          data-target=\"acc5\">\n          <span class=\"flex items-center gap-2\">\n            <span class=\"text-green-600 text-lg\">⑤</span> Worked example — 5 000 kr to EUR and back\n          </span>\n          <span class=\"accordion-arrow text-slate-400 transition-transform\">▼</span>\n        </button>\n        <div id=\"acc5\" class=\"accordion-panel px-5 pb-4\">\n          <p class=\"text-sm text-slate-500 mb-3\">Assumptions: EUR mid = 11.50 kr, spread ±2.5%, fixed fee 30 kr.</p>\n          <div class=\"space-y-2 text-sm\">\n            <div class=\"flex justify-between bg-slate-50 rounded p-2\">\n              <span class=\"text-slate-600\">Start with</span>\n              <span class=\"font-bold num\">5 000 kr</span>\n            </div>\n            <div class=\"flex justify-between bg-amber-50 rounded p-2\">\n              <span class=\"text-amber-700\">Step 1: Buy EUR at sell rate 11.7875 kr/€ minus 30 kr fee</span>\n              <span class=\"font-bold text-amber-700 num\">≈ 420.80 €</span>\n            </div>\n            <div class=\"flex justify-between bg-sky-50 rounded p-2\">\n              <span class=\"text-sky-700\">Step 2: Sell EUR back at buy rate 11.2125 kr/€ minus 30 kr fee</span>\n              <span class=\"font-bold text-sky-700 num\">≈ 4 688 kr</span>\n            </div>\n            <div class=\"flex justify-between bg-rose-50 rounded p-2 font-bold\">\n              <span class=\"text-rose-700\">Loss (round trip)</span>\n              <span class=\"text-rose-700 num\">≈ 312 kr (6.2%)</span>\n            </div>\n            <div class=\"flex justify-between bg-slate-50 rounded p-2\">\n              <span class=\"text-slate-600\">At mid-market (no spread/fees)</span>\n              <span class=\"font-bold num\">5 000 kr</span>\n            </div>\n          </div>\n          <p class=\"text-xs text-slate-400 mt-3\">Use the Practice tab to try your own numbers.</p>\n        </div>\n      </div>\n\n      <!-- Glossary -->\n      <div class=\"card\">\n        <h3 class=\"font-bold text-slate-700 mb-3 text-sm uppercase tracking-wide\">Key Terms</h3>\n        <dl class=\"space-y-2 text-sm\">\n          <div class=\"grid grid-cols-[130px_1fr] gap-2\">\n            <dt class=\"font-semibold text-slate-700\">Mid-market rate</dt>\n            <dd class=\"text-slate-600\">The midpoint of wholesale buy/sell prices. The \"fair\" reference rate.</dd>\n          </div>\n          <div class=\"grid grid-cols-[130px_1fr] gap-2\">\n            <dt class=\"font-semibold text-slate-700\">Spread</dt>\n            <dd class=\"text-slate-600\">The % margin above and below mid that the bureau applies to buy and sell rates.</dd>\n          </div>\n          <div class=\"grid grid-cols-[130px_1fr] gap-2\">\n            <dt class=\"font-semibold text-slate-700\">Sell rate</dt>\n            <dd class=\"text-slate-600\">Rate at which the bureau sells foreign currency to you (higher than mid = worse for you).</dd>\n          </div>\n          <div class=\"grid grid-cols-[130px_1fr] gap-2\">\n            <dt class=\"font-semibold text-slate-700\">Buy rate</dt>\n            <dd class=\"text-slate-600\">Rate at which the bureau buys foreign currency from you (lower than mid = worse for you).</dd>\n          </div>\n          <div class=\"grid grid-cols-[130px_1fr] gap-2\">\n            <dt class=\"font-semibold text-slate-700\">Commission</dt>\n            <dd class=\"text-slate-600\">A % fee charged on the full transaction amount, on top of the spread.</dd>\n          </div>\n          <div class=\"grid grid-cols-[130px_1fr] gap-2\">\n            <dt class=\"font-semibold text-slate-700\">Fixed fee</dt>\n            <dd class=\"text-slate-600\">A flat kr fee per transaction, regardless of amount (hurts small transactions most).</dd>\n          </div>\n        </dl>\n      </div>\n\n    </div><!-- end accordion list -->\n  </div><!-- end learn panel -->\n\n  <!-- Tab: Practice -->\n  <div id=\"tab-practice-panel\" class=\"flex-1 overflow-y-auto p-4 md:p-6 hidden\">\n    <div class=\"max-w-5xl mx-auto grid lg:grid-cols-[1fr_1.3fr] gap-5\">\n\n      <!-- LEFT COLUMN: rates + controls -->\n      <div class=\"space-y-4\">\n\n        <!-- Rate table -->\n        <div class=\"card\">\n          <div class=\"flex items-center justify-between mb-3\">\n            <h2 class=\"font-bold text-slate-800 text-sm\">Mock Exchange Rates</h2>\n            <div class=\"flex gap-2\">\n              <span class=\"text-xs text-slate-400 italic\">kr per 1 unit — editable</span>\n              <button id=\"reset-rates-btn\" class=\"text-xs text-blue-600 hover:underline font-medium\">Reset</button>\n            </div>\n          </div>\n          <table class=\"w-full text-sm\">\n            <thead>\n              <tr class=\"text-xs text-slate-400 border-b border-slate-100\">\n                <th class=\"text-left pb-2 font-medium\">Currency</th>\n                <th class=\"text-right pb-2 font-medium\">Mid (kr)</th>\n                <th class=\"text-right pb-2 font-medium text-amber-600\">Sell</th>\n                <th class=\"text-right pb-2 font-medium text-sky-600\">Buy</th>\n              </tr>\n            </thead>\n            <tbody id=\"rate-table-body\" class=\"divide-y divide-slate-50\">\n              <!-- filled by JS -->\n            </tbody>\n          </table>\n          <p class=\"text-xs text-slate-400 mt-3 italic\">Click any mid-rate value to edit it. Sell/buy update instantly.</p>\n        </div>\n\n        <!-- Controls -->\n        <div class=\"card\">\n          <h2 class=\"font-bold text-slate-800 text-sm mb-4\">Bureau Settings</h2>\n\n          <!-- Spread slider -->\n          <div class=\"mb-4\">\n            <div class=\"flex justify-between text-sm mb-1\">\n              <label class=\"font-medium text-slate-700\">\n                <span class=\"tip\" data-tip=\"% added above and subtracted below the mid-market rate\">Spread ±</span>\n              </label>\n              <span id=\"spread-display\" class=\"font-bold text-rose-600 num\">2.5%</span>\n            </div>\n            <input id=\"spread-slider\" type=\"range\" min=\"0\" max=\"10\" step=\"0.1\" value=\"2.5\"\n              class=\"w-full h-2\" oninput=\"onControlChange()\"/>\n            <div class=\"flex justify-between text-xs text-slate-400 mt-1\">\n              <span>0% (no margin)</span><span>5% typical</span><span>10% max</span>\n            </div>\n          </div>\n\n          <!-- Fixed fee -->\n          <div class=\"mb-4\">\n            <div class=\"flex justify-between text-sm mb-1\">\n              <label class=\"font-medium text-slate-700\">Fixed fee per transaction</label>\n              <span class=\"text-xs text-slate-400\">kr</span>\n            </div>\n            <input id=\"fixed-fee\" type=\"number\" min=\"0\" max=\"500\" step=\"5\" value=\"30\"\n              class=\"w-full border border-slate-200 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-200 num\"\n              oninput=\"onControlChange()\"/>\n          </div>\n\n          <!-- Commission % -->\n          <div>\n            <div class=\"flex justify-between text-sm mb-1\">\n              <label class=\"font-medium text-slate-700\">Commission %</label>\n              <span class=\"text-xs text-slate-400\">of transaction</span>\n            </div>\n            <input id=\"commission-pct\" type=\"number\" min=\"0\" max=\"5\" step=\"0.1\" value=\"0\"\n              class=\"w-full border border-slate-200 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-200 num\"\n              oninput=\"onControlChange()\"/>\n          </div>\n        </div>\n\n      </div><!-- end left col -->\n\n      <!-- RIGHT COLUMN: converter + round-trip -->\n      <div class=\"space-y-4\">\n\n        <!-- Single conversion -->\n        <div class=\"card\">\n          <h2 class=\"font-bold text-slate-800 text-sm mb-4\">Convert</h2>\n\n          <div class=\"grid grid-cols-2 gap-3 mb-4\">\n            <!-- Currency picker -->\n            <div>\n              <label class=\"text-xs text-slate-500 font-medium block mb-1\">Currency</label>\n              <select id=\"conv-currency\"\n                class=\"w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-400 bg-white\"\n                onchange=\"onControlChange()\">\n                <!-- filled by JS -->\n              </select>\n            </div>\n            <!-- Direction -->\n            <div>\n              <label class=\"text-xs text-slate-500 font-medium block mb-1\">Direction</label>\n              <select id=\"conv-direction\"\n                class=\"w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-400 bg-white\"\n                onchange=\"onControlChange()\">\n                <option value=\"kr-to-foreign\">kr → foreign (going abroad)</option>\n                <option value=\"foreign-to-kr\">foreign → kr (coming home)</option>\n              </select>\n            </div>\n          </div>\n\n          <!-- Amount input -->\n          <div class=\"mb-4\">\n            <label class=\"text-xs text-slate-500 font-medium block mb-1\" id=\"conv-amount-label\">Amount (kr)</label>\n            <input id=\"conv-amount\" type=\"number\" min=\"1\" value=\"5000\"\n              class=\"w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-200 num text-right font-bold text-lg\"\n              oninput=\"onControlChange()\"/>\n          </div>\n\n          <!-- Results grid -->\n          <div class=\"bg-slate-50 rounded-xl p-4 space-y-2\">\n            <div class=\"flex justify-between text-sm\">\n              <span class=\"text-slate-500\">You get (at bureau rate)</span>\n              <span id=\"conv-result-bureau\" class=\"font-bold num text-slate-800\">–</span>\n            </div>\n            <div class=\"flex justify-between text-sm\">\n              <span class=\"text-slate-500\">You'd get at mid-market</span>\n              <span id=\"conv-result-mid\" class=\"font-bold num text-slate-500\">–</span>\n            </div>\n            <div class=\"border-t border-slate-200 pt-2 flex justify-between text-sm\">\n              <span class=\"text-slate-500\">Difference (bureau's margin)</span>\n              <span id=\"conv-result-diff\" class=\"font-bold num text-rose-600\">–</span>\n            </div>\n            <div class=\"text-xs text-slate-400 flex justify-between pt-1\" id=\"conv-breakdown\">\n              <span></span><span></span>\n            </div>\n          </div>\n        </div>\n\n        <!-- Round-trip demo -->\n        <div class=\"card\">\n          <div class=\"flex items-center justify-between mb-4\">\n            <h2 class=\"font-bold text-slate-800 text-sm\">Round-Trip Demo</h2>\n            <span class=\"text-xs text-slate-400\">Change X kr → foreign → kr</span>\n          </div>\n\n          <div class=\"flex items-center gap-3 mb-4\">\n            <div class=\"flex-1\">\n              <label class=\"text-xs text-slate-500 font-medium block mb-1\">Starting amount (kr)</label>\n              <input id=\"rt-amount\" type=\"number\" min=\"100\" value=\"5000\"\n                class=\"w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-400 num text-right font-bold\"\n                oninput=\"onControlChange()\"/>\n            </div>\n            <div class=\"flex-1\">\n              <label class=\"text-xs text-slate-500 font-medium block mb-1\">Currency</label>\n              <select id=\"rt-currency\"\n                class=\"w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-400 bg-white\"\n                onchange=\"onControlChange()\">\n                <!-- filled by JS -->\n              </select>\n            </div>\n          </div>\n\n          <!-- Steps -->\n          <div class=\"space-y-2 text-sm mb-4\" id=\"rt-steps\">\n            <!-- filled by JS -->\n          </div>\n\n          <!-- Bar comparison -->\n          <div class=\"space-y-2\">\n            <div>\n              <div class=\"flex justify-between text-xs text-slate-500 mb-1\">\n                <span>Mid-market (no cost)</span>\n                <span id=\"bar-mid-label\" class=\"num font-semibold\">–</span>\n              </div>\n              <div class=\"bar-wrap\">\n                <div class=\"bar-fill bg-green-400\" style=\"width:100%\"></div>\n              </div>\n            </div>\n            <div>\n              <div class=\"flex justify-between text-xs text-slate-500 mb-1\">\n                <span>What you actually get</span>\n                <span id=\"bar-actual-label\" class=\"num font-semibold text-rose-600\">–</span>\n              </div>\n              <div class=\"bar-wrap\">\n                <div id=\"bar-actual-fill\" class=\"bar-fill bg-rose-400\" style=\"width:80%\"></div>\n              </div>\n            </div>\n          </div>\n\n          <!-- Summary -->\n          <div class=\"mt-4 bg-rose-50 border border-rose-200 rounded-xl p-3 flex items-center justify-between\">\n            <div>\n              <p class=\"text-xs text-rose-700 font-medium\">Total round-trip loss</p>\n              <p class=\"text-xs text-rose-500 mt-0.5\">spread cost + 2× fixed fee + 2× commission</p>\n            </div>\n            <div class=\"text-right\">\n              <p id=\"rt-loss-kr\" class=\"text-xl font-bold text-rose-700 num\">–</p>\n              <p id=\"rt-loss-pct\" class=\"text-sm text-rose-500 num\">–</p>\n            </div>\n          </div>\n        </div>\n\n      </div><!-- end right col -->\n    </div><!-- end grid -->\n  </div><!-- end practice panel -->\n\n</div><!-- end main app -->\n\n<!-- ============================================================\n     JAVASCRIPT\n     ============================================================ -->\n<script>\n(function () {\n  'use strict';\n\n  // ── DEFAULT RATES (kr per 1 foreign unit) ──────────────────────────────────\n  const DEFAULT_RATES = [\n    { code: 'EUR', name: 'Euro',           flag: '🇪🇺', mid: 11.50 },\n    { code: 'USD', name: 'US Dollar',      flag: '🇺🇸', mid: 10.70 },\n    { code: 'GBP', name: 'British Pound',  flag: '🇬🇧', mid: 13.50 },\n    { code: 'SEK', name: 'Swedish Krona',  flag: '🇸🇪', mid: 0.99  },\n    { code: 'THB', name: 'Thai Baht',      flag: '🇹🇭', mid: 0.30  },\n  ];\n\n  const LS_KEY = 'halison_cx_rates_v1';\n\n  // ── STATE ──────────────────────────────────────────────────────────────────\n  let rates = loadRates();\n  let currentTab = 'learn';\n\n  // ── HELPERS ───────────────────────────────────────────────────────────────\n  function fmt(n, decimals) {\n    if (isNaN(n) || n === null) return '–';\n    return n.toLocaleString('en-NO', {\n      minimumFractionDigits: decimals ?? 2,\n      maximumFractionDigits: decimals ?? 2,\n    });\n  }\n\n  function fmtKr(n, decimals) {\n    return fmt(n, decimals ?? 2) + ' kr';\n  }\n\n  function spreadVal() {\n    return parseFloat(document.getElementById('spread-slider').value) / 100;\n  }\n\n  function fixedFee() {\n    return Math.max(0, parseFloat(document.getElementById('fixed-fee').value) || 0);\n  }\n\n  function commissionPct() {\n    return Math.max(0, parseFloat(document.getElementById('commission-pct').value) || 0) / 100;\n  }\n\n  function sellRate(mid) { return mid * (1 + spreadVal()); }\n  function buyRate(mid)  { return mid * (1 - spreadVal()); }\n\n  function totalFee(amountKr) {\n    return fixedFee() + amountKr * commissionPct();\n  }\n\n  // ── LOCALSTORAGE ──────────────────────────────────────────────────────────\n  function loadRates() {\n    try {\n      const saved = JSON.parse(localStorage.getItem(LS_KEY));\n      if (saved && Array.isArray(saved) && saved.length === DEFAULT_RATES.length) {\n        return DEFAULT_RATES.map((d, i) => ({ ...d, mid: saved[i] }));\n      }\n    } catch (e) { /* ignore */ }\n    return DEFAULT_RATES.map(d => ({ ...d }));\n  }\n\n  function saveRates() {\n    try {\n      localStorage.setItem(LS_KEY, JSON.stringify(rates.map(r => r.mid)));\n    } catch (e) { /* ignore */ }\n  }\n\n  // ── TAB SWITCHING ─────────────────────────────────────────────────────────\n  window.switchTab = function (tab) {\n    currentTab = tab;\n    document.getElementById('tab-learn-panel').classList.toggle('hidden', tab !== 'learn');\n    document.getElementById('tab-practice-panel').classList.toggle('hidden', tab !== 'practice');\n    document.getElementById('tab-learn').classList.toggle('active', tab === 'learn');\n    document.getElementById('tab-practice').classList.toggle('active', tab === 'practice');\n    if (tab === 'practice') onControlChange();\n  };\n\n  // ── ACCORDION ─────────────────────────────────────────────────────────────\n  document.querySelectorAll('.accordion-toggle').forEach(btn => {\n    btn.addEventListener('click', () => {\n      const target = document.getElementById(btn.dataset.target);\n      const arrow = btn.querySelector('.accordion-arrow');\n      const open = target.classList.toggle('open');\n      arrow.style.transform = open ? 'rotate(180deg)' : '';\n    });\n  });\n\n  // ── RATE TABLE ────────────────────────────────────────────────────────────\n  function buildRateTable() {\n    const tbody = document.getElementById('rate-table-body');\n    tbody.innerHTML = '';\n    const sp = spreadVal();\n    rates.forEach((r, i) => {\n      const sell = r.mid * (1 + sp);\n      const buy  = r.mid * (1 - sp);\n      const tr = document.createElement('tr');\n      tr.innerHTML = `\n        <td class=\"py-2 pr-2\">\n          <span class=\"flag\">${r.flag}</span>\n          <span class=\"font-medium text-slate-700\">${r.code}</span>\n          <span class=\"text-slate-400 text-xs hidden sm:inline ml-1\">${r.name}</span>\n        </td>\n        <td class=\"py-2 text-right\">\n          <input class=\"rate-cell num\" type=\"number\" min=\"0.01\" step=\"0.01\"\n            value=\"${r.mid.toFixed(4)}\" data-idx=\"${i}\"\n            style=\"width:80px\"/>\n        </td>\n        <td class=\"py-2 text-right font-semibold text-amber-700 num\">${fmt(sell, 4)}</td>\n        <td class=\"py-2 text-right font-semibold text-sky-700 num\">${fmt(buy, 4)}</td>\n      `;\n      tbody.appendChild(tr);\n    });\n\n    // Wire up mid rate edits\n    tbody.querySelectorAll('.rate-cell').forEach(input => {\n      input.addEventListener('input', () => {\n        const idx = parseInt(input.dataset.idx);\n        const val = parseFloat(input.value);\n        if (!isNaN(val) && val > 0) {\n          rates[idx].mid = val;\n          saveRates();\n          onControlChange();\n        }\n      });\n    });\n  }\n\n  // ── CURRENCY SELECTS ──────────────────────────────────────────────────────\n  function buildSelects() {\n    ['conv-currency', 'rt-currency'].forEach(id => {\n      const sel = document.getElementById(id);\n      const prev = sel.value;\n      sel.innerHTML = rates.map(r =>\n        `<option value=\"${r.code}\">${r.flag} ${r.code} – ${r.name}</option>`\n      ).join('');\n      if (prev) sel.value = prev;\n    });\n  }\n\n  // ── RESET RATES ───────────────────────────────────────────────────────────\n  document.getElementById('reset-rates-btn').addEventListener('click', () => {\n    rates = DEFAULT_RATES.map(d => ({ ...d }));\n    saveRates();\n    onControlChange();\n  });\n\n  // ── CONVERSION PANEL ──────────────────────────────────────────────────────\n  function updateConversion() {\n    const code = document.getElementById('conv-currency').value;\n    const dir  = document.getElementById('conv-direction').value;\n    const amtRaw = parseFloat(document.getElementById('conv-amount').value);\n    const r    = rates.find(x => x.code === code);\n    if (!r || isNaN(amtRaw) || amtRaw <= 0) return;\n\n    const label = document.getElementById('conv-amount-label');\n    if (dir === 'kr-to-foreign') {\n      label.textContent = 'Amount (kr)';\n      const amtKr = amtRaw;\n      const fee = totalFee(amtKr);\n      const netKr = amtKr - fee;\n      const foreignBureau = netKr / sellRate(r.mid);\n      const foreignMid    = amtKr / r.mid;\n      const diff = foreignBureau - foreignMid; // negative = loss\n\n      document.getElementById('conv-result-bureau').textContent = fmt(foreignBureau) + ' ' + r.code;\n      document.getElementById('conv-result-mid').textContent    = fmt(foreignMid) + ' ' + r.code;\n      document.getElementById('conv-result-diff').textContent   =\n        (diff >= 0 ? '+' : '') + fmt(diff) + ' ' + r.code;\n      document.getElementById('conv-result-diff').className =\n        'font-bold num ' + (diff < 0 ? 'text-rose-600' : 'text-green-600');\n\n      const spreadCost = foreignMid - (netKr / sellRate(r.mid));\n      const breakdownEl = document.getElementById('conv-breakdown');\n      breakdownEl.children[0].textContent =\n        `Spread cost ≈ ${fmt(spreadCost)} ${r.code}`;\n      breakdownEl.children[1].textContent =\n        `Fees = ${fmtKr(fee)} (${fmt(fee / amtKr * 100, 1)}%)`;\n\n    } else {\n      label.textContent = 'Amount (' + r.code + ')';\n      const amtForeign = amtRaw;\n      const grossKr = amtForeign * buyRate(r.mid);\n      const fee = totalFee(grossKr);\n      const netKr = grossKr - fee;\n      const midKr = amtForeign * r.mid;\n      const diff = netKr - midKr;\n\n      document.getElementById('conv-result-bureau').textContent = fmtKr(netKr);\n      document.getElementById('conv-result-mid').textContent    = fmtKr(midKr);\n      document.getElementById('conv-result-diff').textContent   =\n        (diff >= 0 ? '+' : '') + fmtKr(diff);\n      document.getElementById('conv-result-diff').className =\n        'font-bold num ' + (diff < 0 ? 'text-rose-600' : 'text-green-600');\n\n      const spreadCostKr = midKr - grossKr;\n      const breakdownEl = document.getElementById('conv-breakdown');\n      breakdownEl.children[0].textContent = `Spread cost ≈ ${fmtKr(spreadCostKr)}`;\n      breakdownEl.children[1].textContent = `Fees = ${fmtKr(fee)} (${fmt(fee / midKr * 100, 1)}%)`;\n    }\n  }\n\n  // ── ROUND-TRIP PANEL ──────────────────────────────────────────────────────\n  function updateRoundTrip() {\n    const code   = document.getElementById('rt-currency').value;\n    const startKr = parseFloat(document.getElementById('rt-amount').value);\n    const r      = rates.find(x => x.code === code);\n    if (!r || isNaN(startKr) || startKr <= 0) return;\n\n    const sp = spreadVal();\n    const ff = fixedFee();\n    const cp = commissionPct();\n\n    const sell = r.mid * (1 + sp);\n    const buy  = r.mid * (1 - sp);\n\n    // Step 1: buy foreign\n    const fee1Kr = ff + startKr * cp;\n    const netKr1 = startKr - fee1Kr;\n    const foreignAmt = netKr1 / sell;\n\n    // Step 2: sell foreign back\n    const grossKr2 = foreignAmt * buy;\n    const fee2Kr = ff + grossKr2 * cp;\n    const endKr = grossKr2 - fee2Kr;\n\n    const lossKr  = startKr - endKr;\n    const lossPct = (lossKr / startKr) * 100;\n\n    // Steps display\n    const stepsEl = document.getElementById('rt-steps');\n    stepsEl.innerHTML = `\n      <div class=\"flex justify-between bg-slate-50 rounded-lg p-2.5\">\n        <span class=\"text-slate-600\">Start with</span>\n        <span class=\"font-bold num\">${fmtKr(startKr)}</span>\n      </div>\n      <div class=\"flex justify-between bg-amber-50 border border-amber-100 rounded-lg p-2.5\">\n        <span class=\"text-amber-700\">\n          → Buy ${r.code} at sell rate ${fmt(sell, 4)}<br/>\n          <span class=\"text-xs text-amber-500\">fee: ${fmtKr(fee1Kr, 2)}</span>\n        </span>\n        <span class=\"font-bold text-amber-700 num\">${fmt(foreignAmt, 2)} ${code}</span>\n      </div>\n      <div class=\"flex justify-between bg-sky-50 border border-sky-100 rounded-lg p-2.5\">\n        <span class=\"text-sky-700\">\n          → Sell ${r.code} back at buy rate ${fmt(buy, 4)}<br/>\n          <span class=\"text-xs text-sky-500\">fee: ${fmtKr(fee2Kr, 2)}</span>\n        </span>\n        <span class=\"font-bold text-sky-700 num\">${fmtKr(grossKr2)}</span>\n      </div>\n      <div class=\"flex justify-between bg-rose-50 border border-rose-200 rounded-lg p-2.5 font-bold\">\n        <span class=\"text-rose-700\">After fees</span>\n        <span class=\"text-rose-700 num\">${fmtKr(endKr)}</span>\n      </div>\n    `;\n\n    // Bar chart\n    const pct = Math.max(0, Math.min(100, (endKr / startKr) * 100));\n    document.getElementById('bar-mid-label').textContent    = fmtKr(startKr);\n    document.getElementById('bar-actual-label').textContent = fmtKr(endKr);\n    document.getElementById('bar-actual-fill').style.width  = pct.toFixed(1) + '%';\n\n    // Summary\n    document.getElementById('rt-loss-kr').textContent  = '−' + fmtKr(lossKr);\n    document.getElementById('rt-loss-pct').textContent = '(' + fmt(lossPct, 1) + '% of ' + fmtKr(startKr) + ')';\n\n    // Update present mode\n    updatePresentMode(r, lossKr, lossPct);\n  }\n\n  // ── PRESENT MODE ──────────────────────────────────────────────────────────\n  function updatePresentMode(r, lossKr, lossPct) {\n    if (!r) return;\n    const sp = spreadVal();\n    document.getElementById('p-flag').textContent  = r.flag;\n    document.getElementById('p-pair').textContent  = 'NOK / ' + r.code;\n    document.getElementById('p-mid').textContent   = fmt(r.mid, 4) + ' kr';\n    document.getElementById('p-sell').textContent  = fmt(r.mid * (1 + sp), 4) + ' kr';\n    document.getElementById('p-buy').textContent   = fmt(r.mid * (1 - sp), 4) + ' kr';\n    document.getElementById('p-spread').textContent = '±' + fmt(sp * 100, 1) + '%';\n    document.getElementById('p-loss').textContent   = '−' + fmtKr(lossKr);\n    document.getElementById('p-loss-pct').textContent = fmt(lossPct, 1) + '% gone';\n  }\n\n  document.getElementById('enter-present-btn').addEventListener('click', () => {\n    document.getElementById('present-overlay').classList.add('active');\n    onControlChange();\n  });\n  document.getElementById('exit-present-btn').addEventListener('click', () => {\n    document.getElementById('present-overlay').classList.remove('active');\n  });\n  document.addEventListener('keydown', e => {\n    if (e.key === 'Escape') {\n      document.getElementById('present-overlay').classList.remove('active');\n    }\n  });\n\n  // ── SPREAD DISPLAY ────────────────────────────────────────────────────────\n  function updateSpreadDisplay() {\n    const pct = parseFloat(document.getElementById('spread-slider').value);\n    document.getElementById('spread-display').textContent = fmt(pct, 1) + '%';\n  }\n\n  // ── MASTER UPDATE ─────────────────────────────────────────────────────────\n  window.onControlChange = function () {\n    updateSpreadDisplay();\n    buildRateTable();\n    buildSelects();\n    updateConversion();\n    updateRoundTrip();\n  };\n\n  // ── INIT ──────────────────────────────────────────────────────────────────\n  buildSelects();\n  buildRateTable();\n  updateSpreadDisplay();\n  updateConversion();\n  updateRoundTrip();\n\n})();\n</script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Currency Exchange & the Spread",
    "windowTitle": "Currency Exchange & the Spread",
    "bundleId": "com.halisonworks.currencyexchange",
    "iconPath": null
  },
  "categoryId": null,
  "source": "import",
  "createdAt": "2026-06-02T16:00:00.000Z",
  "updatedAt": "2026-06-02T16:00:00.000Z",
  "sharedAt": "2026-06-02T16:00:00.000Z"
}
