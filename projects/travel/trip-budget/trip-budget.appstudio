{
  "schema": "app-studio/canvas@1",
  "id": "example-trip-budget",
  "name": "trip-budget.html",
  "code": "<!DOCTYPE html>\n<!--\n  Trip Budget — Halison App Studio example\n\n  Plan a trip's total cost and see it per person and per day, broken down by\n  category. Saves to your browser so it persists across sessions.\n\n  From the Halison App Studio public library:\n  https://github.com/halisonworks/public-app-studio\n\n  Permitted use: personal, educational, and other non-commercial use. You may\n  modify it, but keep this header and the source link intact, and do not sell,\n  commercialize, or republish it. Released under the Halison App Studio Examples\n  License — see the LICENSE file in the repository above.\n-->\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Trip Budget</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Inter', system-ui, -apple-system, sans-serif; }\n\n    .toggle-pill {\n      display: inline-flex;\n      align-items: center;\n      gap: 4px;\n      padding: 3px 10px 3px 6px;\n      border-radius: 9999px;\n      font-size: 0.72rem;\n      font-weight: 600;\n      cursor: pointer;\n      user-select: none;\n      transition: background 0.15s, color 0.15s, box-shadow 0.15s;\n      border: 1.5px solid transparent;\n    }\n    .toggle-pill .dot {\n      width: 8px; height: 8px;\n      border-radius: 50%;\n      background: currentColor;\n      opacity: 0.5;\n      transition: opacity 0.15s;\n    }\n    .toggle-pill.active .dot { opacity: 1; }\n\n    .pill-person { color: #6366f1; border-color: #c7d2fe; background: #eef2ff; }\n    .pill-person.active { background: #6366f1; color: #fff; border-color: #6366f1; }\n    .pill-day { color: #0891b2; border-color: #a5f3fc; background: #ecfeff; }\n    .pill-day.active { background: #0891b2; color: #fff; border-color: #0891b2; }\n\n    .cat-badge {\n      display: inline-block;\n      width: 9px; height: 9px;\n      border-radius: 50%;\n      margin-right: 5px;\n    }\n\n    .bar-segment { transition: width 0.4s ease; }\n\n    input[type=\"text\"], input[type=\"number\"] {\n      outline: none;\n    }\n    input[type=\"text\"]:focus, input[type=\"number\"]:focus {\n      box-shadow: 0 0 0 2px #6366f1;\n    }\n\n    .expense-row { transition: background 0.1s; }\n    .expense-row:hover { background: #f8fafc; }\n\n    @keyframes fadeIn {\n      from { opacity: 0; transform: translateY(6px); }\n      to   { opacity: 1; transform: translateY(0); }\n    }\n    .fade-in { animation: fadeIn 0.2s ease both; }\n\n    select:focus { outline: 2px solid #6366f1; outline-offset: 0; }\n\n    /* Scrollable expense area on small screens */\n    @media (max-height: 700px) {\n      #expense-scroll { max-height: 40vh; overflow-y: auto; }\n    }\n\n    .modal-backdrop {\n      background: rgba(0,0,0,0.4);\n      backdrop-filter: blur(2px);\n    }\n  </style>\n</head>\n<body class=\"bg-slate-100 min-h-screen\">\n\n<!-- ───────── RESET MODAL ───────── -->\n<div id=\"resetModal\" class=\"fixed inset-0 z-50 flex items-center justify-center modal-backdrop hidden\">\n  <div class=\"bg-white rounded-2xl shadow-2xl p-6 w-80 max-w-full mx-4\">\n    <h2 class=\"text-lg font-semibold text-slate-800 mb-1\">Reset everything?</h2>\n    <p class=\"text-sm text-slate-500 mb-5\">All expenses will be deleted and settings restored to defaults. This cannot be undone.</p>\n    <div class=\"flex gap-3 justify-end\">\n      <button onclick=\"closeResetModal()\" class=\"px-4 py-2 rounded-lg text-sm font-medium text-slate-600 bg-slate-100 hover:bg-slate-200 transition\">Cancel</button>\n      <button onclick=\"confirmReset()\" class=\"px-4 py-2 rounded-lg text-sm font-medium text-white bg-red-500 hover:bg-red-600 transition\">Reset</button>\n    </div>\n  </div>\n</div>\n\n<!-- ───────── MAIN LAYOUT ───────── -->\n<div class=\"max-w-5xl mx-auto px-3 py-6 space-y-4\">\n\n  <!-- HEADER -->\n  <div class=\"flex items-center justify-between gap-3 flex-wrap\">\n    <div class=\"flex items-center gap-2 min-w-0\">\n      <span class=\"text-2xl select-none\">✈️</span>\n      <input id=\"tripName\" type=\"text\"\n        class=\"text-2xl font-bold text-slate-800 bg-transparent border-b-2 border-transparent hover:border-slate-300 focus:border-indigo-500 rounded px-1 min-w-0 w-56 transition\"\n        maxlength=\"60\" placeholder=\"Trip name…\" />\n    </div>\n    <button onclick=\"openResetModal()\"\n      class=\"text-xs text-slate-400 hover:text-red-500 hover:bg-red-50 px-3 py-1.5 rounded-lg transition font-medium\">\n      Reset\n    </button>\n  </div>\n\n  <!-- TRIP SETTINGS -->\n  <div class=\"bg-white rounded-2xl shadow-sm border border-slate-100 px-5 py-4\">\n    <div class=\"grid grid-cols-2 sm:grid-cols-4 gap-4\">\n\n      <div>\n        <label class=\"block text-xs font-semibold text-slate-400 uppercase tracking-wide mb-1\">Travellers</label>\n        <input id=\"settingTravellers\" type=\"number\" min=\"1\" max=\"999\"\n          class=\"w-full border border-slate-200 rounded-lg px-3 py-2 text-slate-800 font-semibold text-sm transition\" />\n      </div>\n\n      <div>\n        <label class=\"block text-xs font-semibold text-slate-400 uppercase tracking-wide mb-1\">Days</label>\n        <input id=\"settingDays\" type=\"number\" min=\"1\" max=\"999\"\n          class=\"w-full border border-slate-200 rounded-lg px-3 py-2 text-slate-800 font-semibold text-sm transition\" />\n      </div>\n\n      <div>\n        <label class=\"block text-xs font-semibold text-slate-400 uppercase tracking-wide mb-1\">Currency</label>\n        <input id=\"settingCurrency\" type=\"text\" maxlength=\"5\"\n          class=\"w-full border border-slate-200 rounded-lg px-3 py-2 text-slate-800 font-semibold text-sm transition\" />\n      </div>\n\n      <div class=\"sm:col-span-1 flex items-end\">\n        <div class=\"text-xs text-slate-400 leading-relaxed\">\n          Mark each expense as<br>\n          <span class=\"text-indigo-500 font-semibold\">per person</span> and/or <span class=\"text-cyan-600 font-semibold\">per day</span><br>\n          to multiply automatically.\n        </div>\n      </div>\n\n    </div>\n  </div>\n\n  <!-- SUMMARY + CATEGORY BREAKDOWN (side by side on larger screens) -->\n  <div class=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n\n    <!-- Summary Panel -->\n    <div class=\"bg-white rounded-2xl shadow-sm border border-slate-100 px-5 py-4\">\n      <h2 class=\"text-xs font-semibold text-slate-400 uppercase tracking-wide mb-3\">Summary</h2>\n      <div class=\"grid grid-cols-2 gap-y-3 gap-x-4\">\n        <div>\n          <div class=\"text-xs text-slate-400 mb-0.5\">Grand total</div>\n          <div id=\"sumTotal\" class=\"text-2xl font-bold text-slate-800\">—</div>\n        </div>\n        <div>\n          <div class=\"text-xs text-slate-400 mb-0.5\">Per person</div>\n          <div id=\"sumPerPerson\" class=\"text-2xl font-bold text-indigo-600\">—</div>\n        </div>\n        <div>\n          <div class=\"text-xs text-slate-400 mb-0.5\">Per day</div>\n          <div id=\"sumPerDay\" class=\"text-xl font-semibold text-cyan-600\">—</div>\n        </div>\n        <div>\n          <div class=\"text-xs text-slate-400 mb-0.5\">Per person / day</div>\n          <div id=\"sumPerPersonDay\" class=\"text-xl font-semibold text-slate-600\">—</div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Category Breakdown -->\n    <div class=\"bg-white rounded-2xl shadow-sm border border-slate-100 px-5 py-4\">\n      <h2 class=\"text-xs font-semibold text-slate-400 uppercase tracking-wide mb-3\">By category</h2>\n      <div id=\"categoryBreakdown\" class=\"space-y-2\">\n        <div class=\"text-sm text-slate-400 italic\">No expenses yet.</div>\n      </div>\n    </div>\n\n  </div>\n\n  <!-- EXPENSES -->\n  <div class=\"bg-white rounded-2xl shadow-sm border border-slate-100\">\n\n    <!-- Expense list header -->\n    <div class=\"px-5 pt-4 pb-2 flex items-center justify-between\">\n      <h2 class=\"text-xs font-semibold text-slate-400 uppercase tracking-wide\">Expenses</h2>\n      <button onclick=\"addExpense()\"\n        class=\"flex items-center gap-1.5 text-sm font-semibold text-indigo-600 hover:text-indigo-800 hover:bg-indigo-50 px-3 py-1.5 rounded-lg transition\">\n        <svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\">\n          <path d=\"M7 1v12M1 7h12\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n        </svg>\n        Add expense\n      </button>\n    </div>\n\n    <!-- Column labels -->\n    <div class=\"hidden sm:grid grid-cols-[1fr_140px_120px_90px_36px] gap-2 px-5 pb-1 text-xs font-semibold text-slate-400 uppercase tracking-wide\">\n      <div>Label</div>\n      <div>Category</div>\n      <div>Amount</div>\n      <div>Multipliers</div>\n      <div></div>\n    </div>\n\n    <!-- Scrollable expense area -->\n    <div id=\"expense-scroll\">\n      <div id=\"expenseList\" class=\"divide-y divide-slate-100 px-2 pb-2\">\n        <!-- rows injected here -->\n      </div>\n    </div>\n\n    <!-- Empty state -->\n    <div id=\"emptyState\" class=\"hidden flex-col items-center justify-center py-12 text-center px-6\">\n      <div class=\"text-4xl mb-3 select-none\">🗺️</div>\n      <p class=\"text-slate-500 font-medium mb-1\">No expenses yet</p>\n      <p class=\"text-slate-400 text-sm mb-4\">Add your first expense to start planning your trip budget.</p>\n      <button onclick=\"addExpense()\"\n        class=\"inline-flex items-center gap-2 text-sm font-semibold text-white bg-indigo-500 hover:bg-indigo-600 px-4 py-2 rounded-lg transition\">\n        <svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\">\n          <path d=\"M7 1v12M1 7h12\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n        </svg>\n        Add expense\n      </button>\n    </div>\n\n  </div>\n\n</div><!-- /max-w-5xl -->\n\n<script>\n// ─────────────────────────────────────────────────────────────\n// CONSTANTS\n// ─────────────────────────────────────────────────────────────\nconst STORAGE_KEY = 'tripBudget_v1';\n\nconst CATEGORIES = [\n  { id: 'flights',       label: 'Flights',         color: '#6366f1' },\n  { id: 'accommodation', label: 'Accommodation',   color: '#f59e0b' },\n  { id: 'food',          label: 'Food',             color: '#10b981' },\n  { id: 'transport',     label: 'Local transport',  color: '#3b82f6' },\n  { id: 'activities',    label: 'Activities',       color: '#ec4899' },\n  { id: 'other',         label: 'Other',            color: '#94a3b8' },\n];\n\nconst CAT_MAP = Object.fromEntries(CATEGORIES.map(c => [c.id, c]));\n\nconst DEFAULT_SETTINGS = {\n  tripName:   'Summer in Europe',\n  travellers: 2,\n  days:       10,\n  currency:   'kr',\n};\n\nconst DEFAULT_EXPENSES = [\n  { id: uid(), label: 'Flights',               category: 'flights',       amount: 3200, perPerson: true,  perDay: false },\n  { id: uid(), label: 'Hotel',                 category: 'accommodation', amount: 1400, perPerson: false, perDay: true  },\n  { id: uid(), label: 'Meals',                 category: 'food',          amount: 350,  perPerson: true,  perDay: true  },\n  { id: uid(), label: 'Metro / bus pass',      category: 'transport',     amount: 80,   perPerson: true,  perDay: false },\n  { id: uid(), label: 'Museum & entry fees',   category: 'activities',    amount: 120,  perPerson: true,  perDay: false },\n  { id: uid(), label: 'Travel insurance',      category: 'other',         amount: 250,  perPerson: true,  perDay: false },\n  { id: uid(), label: 'Day trips & tours',     category: 'activities',    amount: 90,   perPerson: true,  perDay: true  },\n  { id: uid(), label: 'Snacks & coffee',       category: 'food',          amount: 40,   perPerson: true,  perDay: true  },\n];\n\n// ─────────────────────────────────────────────────────────────\n// STATE\n// ─────────────────────────────────────────────────────────────\nlet settings = { ...DEFAULT_SETTINGS };\nlet expenses  = [];\n\n// ─────────────────────────────────────────────────────────────\n// UTILS\n// ─────────────────────────────────────────────────────────────\nfunction uid() {\n  return Math.random().toString(36).slice(2, 10) + Date.now().toString(36);\n}\n\nfunction fmt(n, cur) {\n  const abs = Math.abs(n);\n  let s;\n  if (abs >= 1000000)      s = (n/1000000).toFixed(1) + 'M';\n  else if (abs >= 10000)   s = (n/1000).toFixed(1) + 'k';\n  else if (abs === 0)      s = '0';\n  else                     s = n.toLocaleString('en', { minimumFractionDigits: 0, maximumFractionDigits: 0 });\n  return (cur || settings.currency) + ' ' + s;\n}\n\nfunction effectiveTotal(exp) {\n  const t = (exp.perPerson ? settings.travellers : 1)\n          * (exp.perDay    ? settings.days       : 1)\n          * (exp.amount    || 0);\n  return t;\n}\n\nfunction grandTotal() {\n  return expenses.reduce((s, e) => s + effectiveTotal(e), 0);\n}\n\nfunction catColor(catId) {\n  return (CAT_MAP[catId] || CATEGORIES[5]).color;\n}\nfunction catLabel(catId) {\n  return (CAT_MAP[catId] || CATEGORIES[5]).label;\n}\n\n// ─────────────────────────────────────────────────────────────\n// PERSISTENCE\n// ─────────────────────────────────────────────────────────────\nfunction save() {\n  try {\n    localStorage.setItem(STORAGE_KEY, JSON.stringify({ settings, expenses }));\n  } catch(e) {}\n}\n\nfunction load() {\n  try {\n    const raw = localStorage.getItem(STORAGE_KEY);\n    if (!raw) return false;\n    const data = JSON.parse(raw);\n    if (data.settings) settings = { ...DEFAULT_SETTINGS, ...data.settings };\n    if (Array.isArray(data.expenses)) expenses = data.expenses;\n    return true;\n  } catch(e) { return false; }\n}\n\n// ─────────────────────────────────────────────────────────────\n// SETTINGS BINDING\n// ─────────────────────────────────────────────────────────────\nfunction bindSettings() {\n  const tripNameEl    = document.getElementById('tripName');\n  const travellersEl  = document.getElementById('settingTravellers');\n  const daysEl        = document.getElementById('settingDays');\n  const currencyEl    = document.getElementById('settingCurrency');\n\n  tripNameEl.value   = settings.tripName;\n  travellersEl.value = settings.travellers;\n  daysEl.value       = settings.days;\n  currencyEl.value   = settings.currency;\n\n  function onSettingChange() {\n    settings.tripName   = tripNameEl.value.trim() || 'My Trip';\n    settings.travellers = Math.max(1, parseInt(travellersEl.value) || 1);\n    settings.days       = Math.max(1, parseInt(daysEl.value) || 1);\n    settings.currency   = currencyEl.value.trim() || 'kr';\n    // sync clamped values back\n    travellersEl.value = settings.travellers;\n    daysEl.value       = settings.days;\n    save();\n    renderAll();\n  }\n\n  tripNameEl.addEventListener('input',   onSettingChange);\n  travellersEl.addEventListener('input', onSettingChange);\n  daysEl.addEventListener('input',       onSettingChange);\n  currencyEl.addEventListener('input',   onSettingChange);\n}\n\n// ─────────────────────────────────────────────────────────────\n// EXPENSE CRUD\n// ─────────────────────────────────────────────────────────────\nfunction addExpense() {\n  const newExp = {\n    id:        uid(),\n    label:     '',\n    category:  'other',\n    amount:    0,\n    perPerson: false,\n    perDay:    false,\n  };\n  expenses.push(newExp);\n  save();\n  renderExpenses();\n  updateSummary();\n  // focus the new row's label input\n  const lastRow = document.querySelector('#expenseList .expense-row:last-child');\n  if (lastRow) {\n    const inp = lastRow.querySelector('input[data-field=\"label\"]');\n    if (inp) { inp.focus(); inp.select(); }\n  }\n}\n\nfunction deleteExpense(id) {\n  expenses = expenses.filter(e => e.id !== id);\n  save();\n  renderExpenses();\n  updateSummary();\n}\n\nfunction updateExpenseField(id, field, value) {\n  const exp = expenses.find(e => e.id === id);\n  if (!exp) return;\n  exp[field] = value;\n  save();\n  // re-render the line total for this row only\n  const row = document.querySelector('[data-expense-id=\"' + id + '\"]');\n  if (row) {\n    const lineEl = row.querySelector('.line-total');\n    if (lineEl) {\n      const tot = effectiveTotal(exp);\n      lineEl.textContent = tot > 0 ? fmt(tot) : '—';\n    }\n    // update pill states\n    const ppPill = row.querySelector('.pill-person');\n    const pdPill = row.querySelector('.pill-day');\n    if (ppPill) ppPill.classList.toggle('active', exp.perPerson);\n    if (pdPill) pdPill.classList.toggle('active', exp.perDay);\n  }\n  updateSummary();\n}\n\n// ─────────────────────────────────────────────────────────────\n// BUILD CATEGORY SELECT OPTIONS\n// ─────────────────────────────────────────────────────────────\nfunction buildCatOptions(selectedId) {\n  return CATEGORIES.map(c =>\n    `<option value=\"${c.id}\" ${c.id === selectedId ? 'selected' : ''}>${c.label}</option>`\n  ).join('');\n}\n\n// ─────────────────────────────────────────────────────────────\n// RENDER EXPENSES\n// ─────────────────────────────────────────────────────────────\nfunction renderExpenses() {\n  const list      = document.getElementById('expenseList');\n  const emptyEl   = document.getElementById('emptyState');\n\n  if (expenses.length === 0) {\n    list.innerHTML = '';\n    emptyEl.classList.remove('hidden');\n    emptyEl.classList.add('flex');\n    return;\n  }\n\n  emptyEl.classList.add('hidden');\n  emptyEl.classList.remove('flex');\n\n  list.innerHTML = expenses.map(exp => {\n    const tot     = effectiveTotal(exp);\n    const totStr  = tot > 0 ? fmt(tot) : '—';\n    const color   = catColor(exp.category);\n    return `\n    <div class=\"expense-row grid grid-cols-[1fr_auto] sm:grid-cols-[1fr_140px_110px_auto_36px] items-center gap-2 px-3 py-2.5 rounded-xl fade-in\"\n         data-expense-id=\"${exp.id}\">\n\n      <!-- Label -->\n      <input type=\"text\" data-field=\"label\" maxlength=\"80\"\n        value=\"${exp.label.replace(/\"/g, '&quot;')}\"\n        placeholder=\"Expense name…\"\n        class=\"border border-slate-200 rounded-lg px-2.5 py-1.5 text-sm text-slate-800 w-full min-w-0 transition\" />\n\n      <!-- Category -->\n      <select data-field=\"category\"\n        class=\"border border-slate-200 rounded-lg px-2 py-1.5 text-sm text-slate-700 w-full transition\"\n        style=\"border-left: 3px solid ${color};\">\n        ${buildCatOptions(exp.category)}\n      </select>\n\n      <!-- Amount + line total -->\n      <div class=\"flex items-center gap-1.5\">\n        <span class=\"text-xs text-slate-400 font-medium shrink-0\">${settings.currency}</span>\n        <input type=\"number\" data-field=\"amount\" min=\"0\" step=\"0.01\"\n          value=\"${exp.amount}\"\n          placeholder=\"0\"\n          class=\"border border-slate-200 rounded-lg px-2 py-1.5 text-sm text-slate-800 w-0 flex-1 min-w-0 transition\" />\n      </div>\n\n      <!-- Multiplier pills -->\n      <div class=\"flex gap-1 flex-wrap items-center\">\n        <button type=\"button\" class=\"toggle-pill pill-person ${exp.perPerson ? 'active' : ''}\"\n          title=\"Per person (×${settings.travellers} travellers)\">\n          <span class=\"dot\"></span>×Person\n        </button>\n        <button type=\"button\" class=\"toggle-pill pill-day ${exp.perDay ? 'active' : ''}\"\n          title=\"Per day (×${settings.days} days)\">\n          <span class=\"dot\"></span>×Day\n        </button>\n        <span class=\"line-total text-xs font-bold text-slate-600 ml-1 whitespace-nowrap\">${totStr}</span>\n      </div>\n\n      <!-- Delete -->\n      <button type=\"button\" class=\"delete-btn flex items-center justify-center w-8 h-8 rounded-lg text-slate-300 hover:text-red-400 hover:bg-red-50 transition shrink-0\"\n        title=\"Delete expense\">\n        <svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\">\n          <path d=\"M2 3.5h10M5.5 3.5V2.5a.5.5 0 01.5-.5h2a.5.5 0 01.5.5v1M6 6.5v3.5M8 6.5v3.5M3 3.5l.7 7.2A.8.8 0 003.5 12h7a.8.8 0 00.8-.7L12 3.5\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n        </svg>\n      </button>\n\n    </div>`;\n  }).join('');\n\n  // Attach event listeners\n  list.querySelectorAll('.expense-row').forEach(row => {\n    const id = row.dataset.expenseId;\n\n    row.querySelector('input[data-field=\"label\"]').addEventListener('input', e => {\n      updateExpenseField(id, 'label', e.target.value);\n    });\n\n    row.querySelector('select[data-field=\"category\"]').addEventListener('change', e => {\n      const color2 = catColor(e.target.value);\n      e.target.style.borderLeft = '3px solid ' + color2;\n      updateExpenseField(id, 'category', e.target.value);\n    });\n\n    row.querySelector('input[data-field=\"amount\"]').addEventListener('input', e => {\n      const v = parseFloat(e.target.value);\n      updateExpenseField(id, 'amount', isNaN(v) ? 0 : v);\n    });\n\n    row.querySelector('.pill-person').addEventListener('click', () => {\n      const exp = expenses.find(e => e.id === id);\n      if (exp) updateExpenseField(id, 'perPerson', !exp.perPerson);\n    });\n\n    row.querySelector('.pill-day').addEventListener('click', () => {\n      const exp = expenses.find(e => e.id === id);\n      if (exp) updateExpenseField(id, 'perDay', !exp.perDay);\n    });\n\n    row.querySelector('.delete-btn').addEventListener('click', () => {\n      deleteExpense(id);\n    });\n  });\n}\n\n// ─────────────────────────────────────────────────────────────\n// UPDATE SUMMARY + BREAKDOWN\n// ─────────────────────────────────────────────────────────────\nfunction updateSummary() {\n  const total = grandTotal();\n  const pax   = settings.travellers;\n  const days  = settings.days;\n  const cur   = settings.currency;\n\n  document.getElementById('sumTotal').textContent        = expenses.length ? fmt(total, cur) : '—';\n  document.getElementById('sumPerPerson').textContent    = expenses.length ? fmt(total / pax, cur) : '—';\n  document.getElementById('sumPerDay').textContent       = expenses.length ? fmt(total / days, cur) : '—';\n  document.getElementById('sumPerPersonDay').textContent = expenses.length ? fmt(total / pax / days, cur) : '—';\n\n  renderCategoryBreakdown(total, cur);\n}\n\nfunction renderCategoryBreakdown(total, cur) {\n  const bd = document.getElementById('categoryBreakdown');\n\n  if (!expenses.length || total === 0) {\n    bd.innerHTML = '<div class=\"text-sm text-slate-400 italic\">No expenses yet.</div>';\n    return;\n  }\n\n  // Accumulate per category\n  const catTotals = {};\n  CATEGORIES.forEach(c => { catTotals[c.id] = 0; });\n  expenses.forEach(e => {\n    catTotals[e.category] = (catTotals[e.category] || 0) + effectiveTotal(e);\n  });\n\n  // Sort by amount descending, skip empty\n  const rows = CATEGORIES\n    .filter(c => catTotals[c.id] > 0)\n    .sort((a, b) => catTotals[b.id] - catTotals[a.id]);\n\n  bd.innerHTML = rows.map(c => {\n    const amt  = catTotals[c.id];\n    const pct  = total > 0 ? (amt / total * 100) : 0;\n    const w    = Math.max(pct, 2).toFixed(1);\n    return `\n    <div class=\"space-y-0.5\">\n      <div class=\"flex items-center justify-between text-xs\">\n        <span class=\"flex items-center font-medium text-slate-700\">\n          <span class=\"cat-badge\" style=\"background:${c.color}\"></span>\n          ${c.label}\n        </span>\n        <span class=\"text-slate-500 font-medium tabular-nums\">${fmt(amt, cur)} <span class=\"text-slate-400\">(${pct.toFixed(0)}%)</span></span>\n      </div>\n      <div class=\"h-2 bg-slate-100 rounded-full overflow-hidden\">\n        <div class=\"h-full rounded-full bar-segment\" style=\"width:${w}%; background:${c.color};\"></div>\n      </div>\n    </div>`;\n  }).join('');\n}\n\n// ─────────────────────────────────────────────────────────────\n// FULL RENDER\n// ─────────────────────────────────────────────────────────────\nfunction renderAll() {\n  renderExpenses();\n  updateSummary();\n}\n\n// ─────────────────────────────────────────────────────────────\n// RESET MODAL\n// ─────────────────────────────────────────────────────────────\nfunction openResetModal() {\n  document.getElementById('resetModal').classList.remove('hidden');\n}\n\nfunction closeResetModal() {\n  document.getElementById('resetModal').classList.add('hidden');\n}\n\nfunction confirmReset() {\n  settings = { ...DEFAULT_SETTINGS };\n  expenses = DEFAULT_EXPENSES.map(e => ({ ...e, id: uid() }));\n  save();\n  closeResetModal();\n  // Re-bind settings fields\n  document.getElementById('tripName').value          = settings.tripName;\n  document.getElementById('settingTravellers').value = settings.travellers;\n  document.getElementById('settingDays').value       = settings.days;\n  document.getElementById('settingCurrency').value   = settings.currency;\n  renderAll();\n}\n\n// Close modal on backdrop click\ndocument.getElementById('resetModal').addEventListener('click', function(e) {\n  if (e.target === this) closeResetModal();\n});\n\n// ─────────────────────────────────────────────────────────────\n// INIT\n// ─────────────────────────────────────────────────────────────\n(function init() {\n  const hadData = load();\n  if (!hadData) {\n    expenses = DEFAULT_EXPENSES.map(e => ({ ...e, id: uid() }));\n    save();\n  }\n  bindSettings();\n  renderAll();\n})();\n</script>\n</body>\n</html>\n",
