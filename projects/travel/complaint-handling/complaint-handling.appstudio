{
  "schema": "app-studio/canvas@1",
  "id": "example-complaint-handling",
  "name": "complaint-handling.html",
  "code": "<!DOCTYPE html>\n<!--\n  Complaint & Conflict Handling — Halison App Studio example\n\n  A service-recovery trainer for the Sales, Service and Tourism classroom: learn\n  a de-escalation model, then practise on branching customer-complaint scenarios\n  where your choices change the outcome. Fully offline — no AI, scripted\n  branches.\n\n  From the Halison App Studio public library:\n  https://github.com/halisonworks/public-app-studio\n\n  Permitted use: personal, educational, and other non-commercial use. You may\n  modify it, but keep this header and the source link intact, and do not sell,\n  commercialize, or republish it. Released under the Halison App Studio Examples\n  License — see the LICENSE file in the repository above.\n-->\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Complaint &amp; Conflict Handling</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Inter', system-ui, -apple-system, sans-serif; }\n\n    /* Mood meter fill animation */\n    .mood-bar-fill { transition: width 0.5s ease, background-color 0.5s ease; }\n\n    /* Tab underline animation */\n    .tab-btn { position: relative; }\n    .tab-btn.active::after {\n      content: '';\n      position: absolute;\n      bottom: -2px; left: 0; right: 0; height: 3px;\n      border-radius: 2px;\n      background: #2563eb;\n    }\n\n    /* Card hover */\n    .option-card {\n      transition: transform 0.15s ease, box-shadow 0.15s ease;\n      cursor: pointer;\n    }\n    .option-card:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0,0,0,0.12); }\n    .option-card:active { transform: translateY(0); }\n\n    /* Present mode */\n    #present-overlay {\n      display: none;\n      position: fixed; inset: 0;\n      background: #0f172a;\n      z-index: 100;\n      overflow-y: auto;\n    }\n    #present-overlay.active { display: flex; flex-direction: column; }\n\n    /* Fade-in for nodes */\n    .node-enter { animation: fadeSlide 0.3s ease forwards; }\n    @keyframes fadeSlide {\n      from { opacity: 0; transform: translateY(8px); }\n      to   { opacity: 1; transform: translateY(0); }\n    }\n\n    /* Score badge pulse */\n    @keyframes pop { 0%,100%{transform:scale(1)} 50%{transform:scale(1.25)} }\n    .score-pop { animation: pop 0.35s ease; }\n\n    /* Accordion */\n    .accordion-body { max-height: 0; overflow: hidden; transition: max-height 0.35s ease; }\n    .accordion-body.open { max-height: 800px; }\n\n    /* scrollbar */\n    ::-webkit-scrollbar { width: 6px; }\n    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }\n\n    /* Prevent horizontal overflow */\n    html, body { overflow-x: hidden; max-width: 100vw; }\n  </style>\n</head>\n<body class=\"bg-slate-50 min-h-screen text-slate-800\">\n\n<!-- ===================== MAIN SHELL ===================== -->\n<div id=\"app\" class=\"flex flex-col min-h-screen\">\n\n  <!-- Header -->\n  <header class=\"bg-white border-b border-slate-200 px-4 py-3 flex items-center justify-between sticky top-0 z-10\">\n    <div class=\"flex items-center gap-3\">\n      <span class=\"text-2xl select-none\">🛎️</span>\n      <div>\n        <h1 class=\"text-base font-bold text-slate-900 leading-tight\">Complaint &amp; Conflict Handling</h1>\n        <p class=\"text-xs text-slate-500\">Sales, Service &amp; Tourism · Service Recovery Trainer</p>\n      </div>\n    </div>\n    <div class=\"flex items-center gap-2\">\n      <span id=\"score-badge\" class=\"bg-blue-100 text-blue-800 text-xs font-semibold px-3 py-1 rounded-full\">Best: —</span>\n      <button id=\"present-btn\" class=\"text-xs bg-slate-800 text-white px-3 py-1.5 rounded-lg hover:bg-slate-700 transition-colors\">Present</button>\n    </div>\n  </header>\n\n  <!-- Tab bar -->\n  <nav class=\"bg-white border-b border-slate-200 px-4 flex gap-1\">\n    <button class=\"tab-btn active text-sm font-medium py-3 px-4 text-blue-700\" data-tab=\"learn\">Learn</button>\n    <button class=\"tab-btn text-sm font-medium py-3 px-4 text-slate-500 hover:text-slate-700\" data-tab=\"practice\">Practice</button>\n    <button class=\"tab-btn text-sm font-medium py-3 px-4 text-slate-500 hover:text-slate-700\" data-tab=\"present-setup\">Present</button>\n  </nav>\n\n  <!-- Tab content -->\n  <main class=\"flex-1 overflow-y-auto\">\n\n    <!-- ==================== LEARN TAB ==================== -->\n    <div id=\"tab-learn\" class=\"tab-panel max-w-3xl mx-auto px-4 py-6 space-y-6\">\n\n      <!-- Intro card -->\n      <div class=\"bg-blue-700 rounded-2xl p-6 text-white\">\n        <p class=\"text-xs font-semibold uppercase tracking-widest opacity-75 mb-1\">Why it matters</p>\n        <h2 class=\"text-xl font-bold mb-2\">Complaints are opportunities</h2>\n        <p class=\"text-sm opacity-90 leading-relaxed\">Studies show that a customer whose complaint is handled <em>well</em> can become more loyal than a customer who never had a problem at all. This is called the <strong>service recovery paradox</strong>. Your response in the first 30 seconds often determines the outcome.</p>\n      </div>\n\n      <!-- LAST Model -->\n      <section>\n        <h2 class=\"text-lg font-bold mb-3 text-slate-900\">The LAST Model</h2>\n        <p class=\"text-sm text-slate-600 mb-4\">A four-step de-escalation framework used in hospitality worldwide.</p>\n        <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n          <div class=\"bg-white rounded-xl border border-slate-200 p-4 flex gap-3 items-start\">\n            <span class=\"text-2xl font-black text-blue-600 leading-none mt-0.5\">L</span>\n            <div>\n              <p class=\"font-semibold text-slate-800\">Listen</p>\n              <p class=\"text-sm text-slate-600 mt-0.5\">Give the customer your full attention. Let them finish without interrupting. Nod. Use their name. Your body language signals that you take them seriously.</p>\n            </div>\n          </div>\n          <div class=\"bg-white rounded-xl border border-slate-200 p-4 flex gap-3 items-start\">\n            <span class=\"text-2xl font-black text-amber-500 leading-none mt-0.5\">A</span>\n            <div>\n              <p class=\"font-semibold text-slate-800\">Acknowledge &amp; Apologise</p>\n              <p class=\"text-sm text-slate-600 mt-0.5\">Validate their feelings first, then apologise for the inconvenience — even if it was not directly your fault. \"I completely understand how frustrating this must be.\"</p>\n            </div>\n          </div>\n          <div class=\"bg-white rounded-xl border border-slate-200 p-4 flex gap-3 items-start\">\n            <span class=\"text-2xl font-black text-green-600 leading-none mt-0.5\">S</span>\n            <div>\n              <p class=\"font-semibold text-slate-800\">Solve</p>\n              <p class=\"text-sm text-slate-600 mt-0.5\">Offer a concrete remedy. Where possible, give the customer a choice between two or more options — this restores their sense of control. Commit to a timeline.</p>\n            </div>\n          </div>\n          <div class=\"bg-white rounded-xl border border-slate-200 p-4 flex gap-3 items-start\">\n            <span class=\"text-2xl font-black text-purple-600 leading-none mt-0.5\">T</span>\n            <div>\n              <p class=\"font-semibold text-slate-800\">Thank</p>\n              <p class=\"text-sm text-slate-600 mt-0.5\">Thank the customer for bringing it to your attention. This reinforces that feedback is welcome and turns a negative ending into a positive one.</p>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <!-- De-escalation principles (accordion) -->\n      <section>\n        <h2 class=\"text-lg font-bold mb-3 text-slate-900\">De-escalation Principles</h2>\n        <div class=\"space-y-2\" id=\"deesc-accordion\">\n          <div class=\"bg-white rounded-xl border border-slate-200 overflow-hidden\">\n            <button class=\"accordion-trigger w-full text-left px-4 py-3 flex justify-between items-center font-medium text-sm text-slate-800 hover:bg-slate-50\">\n              <span>🧘 Stay calm — even when the customer is not</span>\n              <span class=\"accordion-icon text-slate-400 text-xs\">▼</span>\n            </button>\n            <div class=\"accordion-body px-4 pb-4 text-sm text-slate-600 space-y-1\">\n              <p>Your tone sets the ceiling for the conversation. Speak slowly and softly. If you feel defensive, breathe before answering. A calm voice is contagious — most customers will mirror it within a minute.</p>\n            </div>\n          </div>\n          <div class=\"bg-white rounded-xl border border-slate-200 overflow-hidden\">\n            <button class=\"accordion-trigger w-full text-left px-4 py-3 flex justify-between items-center font-medium text-sm text-slate-800 hover:bg-slate-50\">\n              <span>🚫 Don't get defensive or make excuses</span>\n              <span class=\"accordion-icon text-slate-400 text-xs\">▼</span>\n            </button>\n            <div class=\"accordion-body px-4 pb-4 text-sm text-slate-600 space-y-1\">\n              <p>\"That's not our policy\" or \"It's not my fault\" are de-escalation killers. Even if the customer is wrong, defending the institution first makes them feel dismissed. Acknowledge first, explain later — and only briefly.</p>\n            </div>\n          </div>\n          <div class=\"bg-white rounded-xl border border-slate-200 overflow-hidden\">\n            <button class=\"accordion-trigger w-full text-left px-4 py-3 flex justify-between items-center font-medium text-sm text-slate-800 hover:bg-slate-50\">\n              <span>💛 Acknowledge feelings before facts</span>\n              <span class=\"accordion-icon text-slate-400 text-xs\">▼</span>\n            </button>\n            <div class=\"accordion-body px-4 pb-4 text-sm text-slate-600 space-y-1\">\n              <p>Emotions must be addressed before logic can land. \"I hear how frustrated you are\" opens a door; \"Actually, the booking clearly states…\" slams it. Acknowledge first, then move to facts and solutions.</p>\n            </div>\n          </div>\n          <div class=\"bg-white rounded-xl border border-slate-200 overflow-hidden\">\n            <button class=\"accordion-trigger w-full text-left px-4 py-3 flex justify-between items-center font-medium text-sm text-slate-800 hover:bg-slate-50\">\n              <span>🤝 Take personal ownership</span>\n              <span class=\"accordion-icon text-slate-400 text-xs\">▼</span>\n            </button>\n            <div class=\"accordion-body px-4 pb-4 text-sm text-slate-600 space-y-1\">\n              <p>Say \"I will sort this out\" rather than \"Someone will call you back.\" Taking personal responsibility — even for systemic issues — signals to the customer that a real person cares. If you need to escalate, stay the point of contact.</p>\n            </div>\n          </div>\n          <div class=\"bg-white rounded-xl border border-slate-200 overflow-hidden\">\n            <button class=\"accordion-trigger w-full text-left px-4 py-3 flex justify-between items-center font-medium text-sm text-slate-800 hover:bg-slate-50\">\n              <span>🔁 Follow up</span>\n              <span class=\"accordion-icon text-slate-400 text-xs\">▼</span>\n            </button>\n            <div class=\"accordion-body px-4 pb-4 text-sm text-slate-600 space-y-1\">\n              <p>A follow-up — even a brief one — transforms \"resolved\" into \"impressed.\" Check back within the agreed timeframe, confirm the fix worked, and ask if anything else is needed. This is often what converts a complainer into a loyal regular.</p>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <!-- Prevention -->\n      <section>\n        <h2 class=\"text-lg font-bold mb-3 text-slate-900\">Conflict Prevention</h2>\n        <div class=\"bg-white rounded-xl border border-slate-200 p-4 space-y-3\">\n          <p class=\"text-sm text-slate-600\">Most complaints stem from unmet expectations — not bad service. Prevention is better than cure.</p>\n          <div class=\"grid grid-cols-1 sm:grid-cols-3 gap-3 text-sm\">\n            <div class=\"bg-slate-50 rounded-lg p-3\">\n              <p class=\"font-semibold text-slate-800 mb-1\">Set clear expectations</p>\n              <p class=\"text-slate-600 text-xs\">Tell guests what's included, what's not, check-in times, cancellation terms — proactively, at booking, and at arrival.</p>\n            </div>\n            <div class=\"bg-slate-50 rounded-lg p-3\">\n              <p class=\"font-semibold text-slate-800 mb-1\">Communicate early</p>\n              <p class=\"text-slate-600 text-xs\">If something will go wrong (delay, shortage, change) — call/message before the customer finds out on their own. Control the narrative.</p>\n            </div>\n            <div class=\"bg-slate-50 rounded-lg p-3\">\n              <p class=\"font-semibold text-slate-800 mb-1\">Invite feedback</p>\n              <p class=\"text-slate-600 text-xs\">Guests who feel heard are less likely to escalate. A simple \"Is everything to your satisfaction?\" at mid-stay catches problems while they're still fixable.</p>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <!-- Service Recovery Paradox -->\n      <section>\n        <div class=\"bg-amber-50 border border-amber-200 rounded-xl p-4\">\n          <p class=\"text-sm font-bold text-amber-900 mb-1\">The Service Recovery Paradox</p>\n          <p class=\"text-sm text-amber-800 leading-relaxed\">Research (Hart, Heskett &amp; Sasser, 1990) found that customers who experience a service failure but receive an <em>excellent</em> recovery often report <strong>higher satisfaction and loyalty</strong> than customers who never had a problem. A complaint handled brilliantly is free marketing.</p>\n        </div>\n      </section>\n\n      <!-- Escalation guide -->\n      <section>\n        <h2 class=\"text-lg font-bold mb-3 text-slate-900\">When to Escalate</h2>\n        <div class=\"bg-white rounded-xl border border-slate-200 overflow-hidden\">\n          <table class=\"w-full text-sm\">\n            <thead class=\"bg-slate-50\">\n              <tr>\n                <th class=\"text-left px-4 py-2 text-slate-700 font-semibold\">Situation</th>\n                <th class=\"text-left px-4 py-2 text-slate-700 font-semibold\">Action</th>\n              </tr>\n            </thead>\n            <tbody class=\"divide-y divide-slate-100\">\n              <tr><td class=\"px-4 py-2 text-slate-700\">Minor complaint, within your authority to fix</td><td class=\"px-4 py-2 text-slate-600\">Handle yourself — don't pass it on unnecessarily</td></tr>\n              <tr><td class=\"px-4 py-2 text-slate-700\">Compensation or refund above your limit</td><td class=\"px-4 py-2 text-slate-600\">Involve a supervisor; stay present and introduce them</td></tr>\n              <tr><td class=\"px-4 py-2 text-slate-700\">Customer is verbally abusive or threatening</td><td class=\"px-4 py-2 text-slate-600\">Calmly involve security/manager; safety first</td></tr>\n              <tr><td class=\"px-4 py-2 text-slate-700\">Situation involves legal liability or press risk</td><td class=\"px-4 py-2 text-slate-600\">Escalate immediately; don't speculate or promise</td></tr>\n              <tr><td class=\"px-4 py-2 text-slate-700\">Emergency (medical, fire, safety)</td><td class=\"px-4 py-2 text-slate-600\">Follow emergency protocol; call services first, service second</td></tr>\n            </tbody>\n          </table>\n        </div>\n      </section>\n\n      <!-- CTA to Practice -->\n      <div class=\"text-center py-4\">\n        <button class=\"bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-3 rounded-xl transition-colors\" onclick=\"switchTab('practice')\">Try the Scenarios →</button>\n      </div>\n    </div><!-- /tab-learn -->\n\n\n    <!-- ==================== PRACTICE TAB ==================== -->\n    <div id=\"tab-practice\" class=\"tab-panel hidden max-w-3xl mx-auto px-4 py-6\">\n\n      <!-- Scenario selection screen -->\n      <div id=\"scenario-select\">\n        <h2 class=\"text-lg font-bold mb-1 text-slate-900\">Choose a Scenario</h2>\n        <p class=\"text-sm text-slate-500 mb-4\">Each scenario is 3–4 decision points. Your choices affect the customer's mood and your score.</p>\n        <div class=\"grid gap-4\" id=\"scenario-cards\"></div>\n      </div>\n\n      <!-- Active scenario screen -->\n      <div id=\"scenario-active\" class=\"hidden\">\n\n        <!-- Scenario header -->\n        <div class=\"flex items-center justify-between mb-4\">\n          <button id=\"back-to-select\" class=\"text-sm text-blue-600 hover:underline flex items-center gap-1\">← Scenarios</button>\n          <span id=\"scenario-label\" class=\"text-xs font-semibold text-slate-500 uppercase tracking-widest\"></span>\n          <div class=\"text-sm font-semibold text-slate-700\">Score: <span id=\"live-score\">0</span></div>\n        </div>\n\n        <!-- Mood meter -->\n        <div class=\"bg-white rounded-xl border border-slate-200 p-3 mb-4\">\n          <div class=\"flex justify-between items-center mb-1.5\">\n            <span class=\"text-xs text-slate-500\">Customer Mood</span>\n            <span id=\"mood-label\" class=\"text-sm font-semibold\">😤 Upset</span>\n          </div>\n          <div class=\"w-full bg-slate-100 rounded-full h-3\">\n            <div id=\"mood-bar\" class=\"mood-bar-fill h-3 rounded-full bg-red-400\" style=\"width:30%\"></div>\n          </div>\n        </div>\n\n        <!-- Node content -->\n        <div id=\"node-content\" class=\"node-enter\"></div>\n\n      </div><!-- /scenario-active -->\n\n    </div><!-- /tab-practice -->\n\n\n    <!-- ==================== PRESENT SETUP TAB ==================== -->\n    <div id=\"tab-present-setup\" class=\"tab-panel hidden max-w-3xl mx-auto px-4 py-6\">\n      <h2 class=\"text-lg font-bold mb-1\">Present Mode</h2>\n      <p class=\"text-sm text-slate-500 mb-5\">Project a scenario for class discussion — big text, one decision at a time. Press <kbd class=\"bg-slate-200 px-1.5 py-0.5 rounded text-xs font-mono\">ESC</kbd> or the Exit button to return.</p>\n      <div class=\"grid gap-4\" id=\"present-scenario-cards\"></div>\n    </div>\n\n  </main><!-- /main -->\n</div><!-- /app -->\n\n\n<!-- ==================== PRESENT OVERLAY ==================== -->\n<div id=\"present-overlay\">\n  <div class=\"flex-1 flex flex-col p-6 sm:p-10 max-w-4xl mx-auto w-full\">\n\n    <!-- Present header -->\n    <div class=\"flex justify-between items-center mb-6\">\n      <div>\n        <p id=\"p-scenario-name\" class=\"text-blue-400 text-sm font-semibold uppercase tracking-widest\"></p>\n        <h2 class=\"text-white text-xl font-bold mt-0.5\">Customer Complaint Scenario</h2>\n      </div>\n      <div class=\"flex items-center gap-3\">\n        <!-- Mood in present mode -->\n        <div class=\"flex items-center gap-2 bg-slate-800 rounded-xl px-4 py-2\">\n          <span class=\"text-xs text-slate-400\">Mood:</span>\n          <span id=\"p-mood-label\" class=\"text-white font-semibold text-sm\">😤</span>\n          <div class=\"w-24 bg-slate-700 rounded-full h-2\">\n            <div id=\"p-mood-bar\" class=\"mood-bar-fill h-2 rounded-full bg-red-400\" style=\"width:30%\"></div>\n          </div>\n        </div>\n        <button id=\"exit-present\" class=\"text-slate-400 hover:text-white text-sm border border-slate-600 px-3 py-1.5 rounded-lg transition-colors\">Exit (ESC)</button>\n      </div>\n    </div>\n\n    <!-- Present node content -->\n    <div id=\"p-node-content\" class=\"flex-1\"></div>\n\n  </div>\n</div><!-- /present-overlay -->\n\n\n<script>\n/* ============================================================\n   DATA — Branching scenario trees\n   mood: 0–100 (100 = delighted, 0 = furious)\n   Each option: { text, feedback, scoreΔ, moodΔ, next }\n   Terminal nodes have outcomes array instead of options.\n============================================================ */\nconst SCENARIOS = [\n  {\n    id: 'hotel-overbook',\n    emoji: '🏨',\n    title: 'Hotel Overbooking',\n    subtitle: 'A guest arrives at 11 PM with a confirmed booking. There are no rooms.',\n    difficulty: 'Intermediate',\n    diffColor: 'amber',\n    startMood: 30,\n    startNode: 'n1',\n    nodes: {\n      n1: {\n        situation: \"It's 11 PM. Mr. Hansen walks up to the front desk, visibly tired after a long flight. He has a printed confirmation for a double room. You pull up his booking — and your heart sinks. The hotel is fully booked; his room was accidentally double-assigned and the other guest has already checked in.\",\n        customer: \"\\\"I have a confirmed reservation. Right here. I flew six hours and I just need a room.\\\"\",\n        options: [\n          {\n            text: \"Apologise sincerely and take immediate ownership: \\\"Mr. Hansen, I'm so sorry — this is entirely our mistake and I'm going to fix it for you right now.\\\"\",\n            quality: 'good',\n            feedback: \"Excellent. Taking ownership without defensiveness immediately reduces tension. Mr. Hansen can see you're on his side. This is the LAST model's Acknowledge step in action.\",\n            scoreΔ: 3, moodΔ: 25, next: 'n2a'\n          },\n          {\n            text: \"Explain the situation factually: \\\"Our system shows an overbooking error. I'll need to check what options are available.\\\"\",\n            quality: 'neutral',\n            feedback: \"Factual, but it feels cold and bureaucratic at 11 PM. No acknowledgment of his feelings. He hears 'system error' and thinks 'not my problem, fix it.' You get points for accuracy, not warmth.\",\n            scoreΔ: 1, moodΔ: 0, next: 'n2b'\n          },\n          {\n            text: \"Tell him there must be a misunderstanding and ask him to double-check his booking dates.\",\n            quality: 'bad',\n            feedback: \"Shifting blame to the guest is a serious error. He has a printed confirmation. Implying he made a mistake will immediately escalate the conflict and destroy trust.\",\n            scoreΔ: -2, moodΔ: -20, next: 'n2c'\n          }\n        ]\n      },\n      n2a: {\n        situation: \"Mr. Hansen nods, visibly relieved that you're not arguing. Now he wants to know what you're going to do.\",\n        customer: \"\\\"Okay. So what happens now? I need somewhere to sleep tonight.\\\"\",\n        options: [\n          {\n            text: \"\\\"I've already called the Radisson two blocks away — they have a room. We'll cover your first night there, arrange a taxi, and upgrade you to a suite here tomorrow at no charge.\\\"\",\n            quality: 'good',\n            feedback: \"This is textbook service recovery. You've solved the immediate problem, absorbed the cost, and added a sweetener. Mr. Hansen now has a story to tell friends — about how well you handled it.\",\n            scoreΔ: 4, moodΔ: 30, next: 'n3a'\n          },\n          {\n            text: \"\\\"I'll call around some nearby hotels and find you a room. It may take a few minutes.\\\"\",\n            quality: 'neutral',\n            feedback: \"Reasonable, but vague. 'A few minutes' at 11 PM is stressful. Offer a seat, a drink, a concrete timeline. Taking initiative beats asking him to wait in uncertainty.\",\n            scoreΔ: 1, moodΔ: 5, next: 'n3b'\n          },\n          {\n            text: \"\\\"I'm afraid all nearby hotels are probably full too. I'll note your complaint and the manager will call you tomorrow.\\\"\",\n            quality: 'bad',\n            feedback: \"Completely inadequate. 'Probably' is speculation, and pushing the problem to tomorrow abandons a guest at 11 PM. This guarantees a scathing online review.\",\n            scoreΔ: -3, moodΔ: -25, next: 'n3c'\n          }\n        ]\n      },\n      n2b: {\n        situation: \"Mr. Hansen is getting visibly frustrated by the clinical tone. He raises his voice slightly.\",\n        customer: \"\\\"I don't care about your system. I just need a room. What are you actually going to DO?\\\"\",\n        options: [\n          {\n            text: \"Step up emotionally: \\\"You're absolutely right, Mr. Hansen — I apologise for how I phrased that. Let me find you a solution right now.\\\"\",\n            quality: 'good',\n            feedback: \"Good recovery! You recognised the emotional gap and corrected course. Acknowledging the misstep shows self-awareness and earns back some goodwill.\",\n            scoreΔ: 2, moodΔ: 15, next: 'n3b'\n          },\n          {\n            text: \"\\\"I'm finding the options now. Please bear with me.\\\"\",\n            quality: 'neutral',\n            feedback: \"Functional, but still emotionally flat. He needs to feel helped, not processed. At least you're moving forward.\",\n            scoreΔ: 1, moodΔ: 0, next: 'n3b'\n          },\n          {\n            text: \"\\\"Sir, I need you to calm down so I can help you.\\\"\",\n            quality: 'bad',\n            feedback: \"Never tell a frustrated guest to 'calm down' — it always backfires. It invalidates their (justified) feelings and sounds condescending. This will escalate the situation significantly.\",\n            scoreΔ: -3, moodΔ: -20, next: 'n3c'\n          }\n        ]\n      },\n      n2c: {\n        situation: \"Mr. Hansen is now clearly angry. He slaps the confirmation print-out on the desk.\",\n        customer: \"\\\"It says right here: tonight's date. I am NOT leaving this lobby.\\\"\",\n        options: [\n          {\n            text: \"Immediately change tack: \\\"You're completely right, Mr. Hansen — I sincerely apologise. The error is entirely on our side. Let me make this right immediately.\\\"\",\n            quality: 'good',\n            feedback: \"A full reversal and genuine apology can still recover the situation, but you've already dug a hole. The guest's trust is damaged but repairable if you now deliver a concrete solution.\",\n            scoreΔ: 2, moodΔ: 10, next: 'n3b'\n          },\n          {\n            text: \"Call your manager over without saying anything more.\",\n            quality: 'neutral',\n            feedback: \"Escalating after a misstep is appropriate, but abandoning the interaction silently feels dismissive. Introduce your manager, stay present, and brief them before the guest has to repeat everything.\",\n            scoreΔ: 0, moodΔ: -5, next: 'n3c'\n          },\n          {\n            text: \"\\\"I understand you're upset, but there's no need to raise your voice.\\\"\",\n            quality: 'bad',\n            feedback: \"Moralising about his tone after you implied he was wrong compounds the error. He hasn't been rude — he's justifiably angry. This prioritises your comfort over his problem.\",\n            scoreΔ: -2, moodΔ: -15, next: 'n3c'\n          }\n        ]\n      },\n      n3a: {\n        situation: \"Mr. Hansen seems genuinely impressed by the quick, concrete offer. He pauses, then nods.\",\n        customer: \"\\\"Alright. I appreciate that. And the upgrade tomorrow — can I check in early?\\\"\",\n        options: [\n          {\n            text: \"\\\"Absolutely — I'll flag your reservation for an early 10 AM check-in and leave a welcome note with a breakfast voucher. Here's my direct number if anything else comes up.\\\"\",\n            quality: 'good',\n            feedback: \"Perfect close. Early check-in, a tangible perk, and personal contact details complete the service recovery arc. This is the LAST model's Thank step — and then some.\",\n            scoreΔ: 3, moodΔ: 15, next: 'outcome-great'\n          },\n          {\n            text: \"\\\"I can't promise early check-in, but I'll add a note to try. The taxi should be here in 10 minutes.\\\"\",\n            quality: 'neutral',\n            feedback: \"Honest, but 'I'll try' after all the assurances sounds slightly deflating. A small gift (breakfast voucher, room upgrade to superior rather than just standard suite) would have sealed it better.\",\n            scoreΔ: 1, moodΔ: 5, next: 'outcome-good'\n          },\n          {\n            text: \"\\\"Check-in is normally 3 PM but I'll pass the message along.\\\"\",\n            quality: 'bad',\n            feedback: \"After everything, quoting standard policy feels tone-deaf. He's had a terrible night because of your hotel's error. A bit of discretion and generosity here would cost very little.\",\n            scoreΔ: -1, moodΔ: -10, next: 'outcome-ok'\n          }\n        ]\n      },\n      n3b: {\n        situation: \"You've located a nearby hotel with an available room, but it's a 3-star and Mr. Hansen booked a 4-star here.\",\n        customer: \"\\\"A 3-star? I booked a 4-star. This isn't acceptable.\\\"\",\n        options: [\n          {\n            text: \"\\\"You're right — this isn't the standard you booked. We'll cover your night there, give you a full refund for tonight, and I'd like to offer you a complimentary night on your next stay here.\\\"\",\n            quality: 'good',\n            feedback: \"Acknowledging the downgrade, absorbing the cost, and adding a future incentive is the right move. The customer's legitimate expectation is validated.\",\n            scoreΔ: 3, moodΔ: 20, next: 'outcome-good'\n          },\n          {\n            text: \"\\\"It's the best available at this hour. We'll cover the difference in price.\\\"\",\n            quality: 'neutral',\n            feedback: \"Fair and financially correct, but impersonal. Covering the difference is the bare minimum — at least you're doing it, but there's no gesture of goodwill for the inconvenience.\",\n            scoreΔ: 1, moodΔ: 5, next: 'outcome-ok'\n          },\n          {\n            text: \"\\\"At this hour your options are limited. I suggest you take it.\\\"\",\n            quality: 'bad',\n            feedback: \"This response oozes impatience. It's dismissive and practically tells the guest to be grateful for a lesser product. Almost certain to produce a 1-star review.\",\n            scoreΔ: -2, moodΔ: -20, next: 'outcome-poor'\n          }\n        ]\n      },\n      n3c: {\n        situation: \"Mr. Hansen has had enough. He's filming the interaction on his phone and threatening to call the tourism board.\",\n        customer: \"\\\"I want the manager. NOW. And I'm posting this online.\\\"\",\n        options: [\n          {\n            text: \"\\\"Of course. I'll get the manager immediately. I want to apologise again — you have every right to be upset and we should have handled this better from the start.\\\"\",\n            quality: 'good',\n            feedback: \"Humble, non-defensive, and prompt escalation. You can't fully undo the damage, but you're ending on a professional note. The manager now has a fighting chance.\",\n            scoreΔ: 1, moodΔ: 5, next: 'outcome-poor'\n          },\n          {\n            text: \"Get the manager without comment.\",\n            quality: 'neutral',\n            feedback: \"At least you're not making it worse. Silent escalation is better than continued damage, but offers no bridge to the guest.\",\n            scoreΔ: 0, moodΔ: 0, next: 'outcome-poor'\n          },\n          {\n            text: \"\\\"Recording staff without consent may not be legal, sir.\\\"\",\n            quality: 'bad',\n            feedback: \"Threatening legal action against a justified, upset guest is catastrophic. This will guarantee a viral post and potential legal involvement. Never do this.\",\n            scoreΔ: -4, moodΔ: -20, next: 'outcome-terrible'\n          }\n        ]\n      },\n      'outcome-great': {\n        outcome: true,\n        emoji: '🌟',\n        title: 'Excellent Recovery!',\n        color: 'green',\n        description: \"Mr. Hansen checks into the alternative hotel, returns the next morning to a suite, and later leaves a glowing review mentioning you by name. He books again within three months.\",\n        debrief: \"You applied the full LAST model: you Listened, Acknowledged his frustration without defensiveness, Solved the problem proactively with concrete options, and Thanked him — going beyond what was required. This is the service recovery paradox in action.\"\n      },\n      'outcome-good': {\n        outcome: true,\n        emoji: '😊',\n        title: 'Good Recovery',\n        color: 'blue',\n        description: \"Mr. Hansen is not delighted, but he's no longer angry. He accepts the solution and checks out without incident. He leaves a 3-star review: 'Problem occurred but staff handled it reasonably.'\",\n        debrief: \"You mostly followed the LAST model but missed opportunities to add warmth and a goodwill gesture. The Solve step was adequate; the Acknowledge and Thank steps were incomplete. A small extra — early check-in, voucher — would have converted this to an excellent outcome.\"\n      },\n      'outcome-ok': {\n        outcome: true,\n        emoji: '😐',\n        title: 'Resolved — Barely',\n        color: 'amber',\n        description: \"Mr. Hansen leaves with a working solution but is visibly unimpressed. He doesn't leave a review, but he doesn't return either.\",\n        debrief: \"The problem was technically solved, but the emotional journey was poor. You applied Solve but skipped meaningful Acknowledge and Thank moments. Competent isn't memorable — and in hospitality, memorable (either way) drives decisions.\"\n      },\n      'outcome-poor': {\n        outcome: true,\n        emoji: '😠',\n        title: 'Escalated',\n        color: 'red',\n        description: \"The manager had to step in. Mr. Hansen accepts the final solution grudgingly. He posts a 2-star review: 'Overbooking disaster — staff were unhelpful, manager eventually sorted it.'\",\n        debrief: \"Several missteps compounded each other. Defensiveness, failure to acknowledge, or dismissive language pushed the customer past the point where front-line recovery was possible. Review where the LAST model's Listen and Acknowledge steps were skipped.\"\n      },\n      'outcome-terrible': {\n        outcome: true,\n        emoji: '💥',\n        title: 'Crisis',\n        color: 'red',\n        description: \"The clip goes viral on social media. The hotel's reputation takes a serious hit. This is used as a training case for what NOT to do.\",\n        debrief: \"Threatening a guest or telling them to 'calm down' during a justified complaint are the two biggest escalation triggers in hospitality. Safety, dignity, and humility must come first — always.\"\n      }\n    }\n  },\n\n  {\n    id: 'cancelled-tour',\n    emoji: '⛵',\n    title: 'Cancelled Excursion',\n    subtitle: 'A boat tour is cancelled due to weather. Guests have been waiting on the pier for 90 minutes.',\n    difficulty: 'Beginner',\n    diffColor: 'green',\n    startMood: 35,\n    startNode: 'n1',\n    nodes: {\n      n1: {\n        situation: \"It's 9:30 AM. A group of 12 guests has been standing on the pier since 8:00 AM, waiting for their booked sunset — err, morning — fjord cruise. You've just received the captain's call: strong winds make sailing unsafe, and the trip is cancelled. The guests see you approaching and their mood is already tipping.\",\n        customer: \"\\\"Finally! What's going on? We've been standing here for ninety minutes in the cold. Is this thing happening or not?\\\"\",\n        options: [\n          {\n            text: \"Walk up, make eye contact with the group, and say clearly: \\\"I have an update from the captain — for your safety, today's trip has been cancelled. I'm genuinely sorry you've been waiting so long without information. Let me explain everything and sort out next steps for you.\\\"\",\n            quality: 'good',\n            feedback: \"Direct, empathetic, and takes responsibility for the communication failure (they waited 90 mins with no info). Naming the reason (safety) and the authority (captain) legitimises the decision without sounding bureaucratic.\",\n            scoreΔ: 3, moodΔ: 20, next: 'n2a'\n          },\n          {\n            text: \"\\\"I'm sorry, the trip is cancelled — bad weather. You'll get a full refund.\\\"\",\n            quality: 'neutral',\n            feedback: \"Technically sufficient, but the delivery is abrupt. After 90 minutes in the cold, guests need to feel acknowledged before they receive information. Lead with empathy, then facts.\",\n            scoreΔ: 1, moodΔ: 5, next: 'n2b'\n          },\n          {\n            text: \"\\\"The captain says it's too windy. There's really nothing we can do — it's weather.\\\"\",\n            quality: 'bad',\n            feedback: \"'Nothing we can do' is a red flag phrase. Weather is not in your control, but the response absolutely is. This sounds like you're washing your hands of responsibility. Guests will feel abandoned.\",\n            scoreΔ: -2, moodΔ: -15, next: 'n2c'\n          }\n        ]\n      },\n      n2a: {\n        situation: \"The guests are disappointed but listening. One of them, a woman named Mrs. Sørensen, steps forward as spokesperson.\",\n        customer: \"\\\"Thank you for telling us. But we leave tomorrow — this was our only chance for the fjord. Can you do anything about that?\\\"\",\n        options: [\n          {\n            text: \"\\\"I completely understand — this was likely the highlight of your trip and I'm so sorry it didn't work out. Here are your options: a full refund, or I can try to book you on tomorrow morning's first departure before your flight — what time do you leave?\\\"\",\n            quality: 'good',\n            feedback: \"Validating the emotional weight (\\\"highlight of your trip\\\"), then offering a choice. The follow-up question shows genuine interest rather than a scripted response. This is the Solve step done with care.\",\n            scoreΔ: 4, moodΔ: 25, next: 'n3a'\n          },\n          {\n            text: \"\\\"We can refund you or rebook you on the next available date.\\\"\",\n            quality: 'neutral',\n            feedback: \"Functional, but robotic. You haven't acknowledged the significance of the loss for her. The next available date may be useless if they leave tomorrow — probe before offering it.\",\n            scoreΔ: 1, moodΔ: 5, next: 'n3b'\n          },\n          {\n            text: \"\\\"Unfortunately we can't control the weather. A refund will be processed within 5–7 business days.\\\"\",\n            quality: 'bad',\n            feedback: \"Hiding behind weather and quoting a refund timeline is dismissive. She's not asking for a refund — she wants the experience. You didn't even try to solve the real problem.\",\n            scoreΔ: -2, moodΔ: -20, next: 'n3c'\n          }\n        ]\n      },\n      n2b: {\n        situation: \"The group is quiet but clearly deflated. A man at the back calls out:\",\n        customer: \"\\\"Just a refund? We've been standing here for ninety minutes! Is that it?\\\"\",\n        options: [\n          {\n            text: \"\\\"You're right — the lack of communication was our failure and I apologise for that specifically. Let me see what I can do beyond the refund to make this right.\\\"\",\n            quality: 'good',\n            feedback: \"Distinguishing between the weather (not your fault) and the 90-minute communication failure (your fault) shows honest accountability. Offering to go beyond a refund changes the dynamic.\",\n            scoreΔ: 3, moodΔ: 20, next: 'n3a'\n          },\n          {\n            text: \"\\\"I understand the frustration. Let me also check if there are any alternative activities available today.\\\"\",\n            quality: 'neutral',\n            feedback: \"A reasonable recovery move. You're not taking full ownership of the communication failure, but you are trying to create value. Better than nothing.\",\n            scoreΔ: 1, moodΔ: 10, next: 'n3b'\n          },\n          {\n            text: \"\\\"Weather cancellations are covered in the booking terms. Your refund will come automatically.\\\"\",\n            quality: 'bad',\n            feedback: \"Quoting booking terms to an upset guest is almost always counterproductive. Even if you're right, it sounds like you're hiding behind fine print. Feelings before facts.\",\n            scoreΔ: -2, moodΔ: -20, next: 'n3c'\n          }\n        ]\n      },\n      n2c: {\n        situation: \"Several guests are openly frustrated. One of them starts scrolling a review site on his phone.\",\n        customer: \"\\\"This is unprofessional. We've been ignored for 90 minutes and now you say there's 'nothing you can do'?\\\"\",\n        options: [\n          {\n            text: \"\\\"He's right — the way this was communicated was unacceptable and that's on us. I want to personally apologise and find you a solution.\\\"\",\n            quality: 'good',\n            feedback: \"A full acknowledgment of the communication failure redirects the energy productively. Third-person ('he's right') shows you're listening, not just defending.\",\n            scoreΔ: 2, moodΔ: 15, next: 'n3b'\n          },\n          {\n            text: \"\\\"I can hear how frustrated you are. Let me focus on what I CAN do for you — a refund and options for rebooking.\\\"\",\n            quality: 'neutral',\n            feedback: \"Pivoting to solutions is good, but not acknowledging the communication failure first feels like you're glossing over a legitimate grievance.\",\n            scoreΔ: 1, moodΔ: 5, next: 'n3c'\n          },\n          {\n            text: \"\\\"We notified everyone by SMS this morning.\\\"\",\n            quality: 'bad',\n            feedback: \"If they're standing on the pier, the SMS clearly didn't reach everyone — or came too late. Saying this makes you look out of touch and dismissive of what they're experiencing right in front of you.\",\n            scoreΔ: -3, moodΔ: -20, next: 'n3c'\n          }\n        ]\n      },\n      n3a: {\n        situation: \"Mrs. Sørensen checks her itinerary. Their ferry leaves at 11 AM tomorrow — there's a 7 AM departure that could work.\",\n        customer: \"\\\"7 AM could work. But will the weather be better?\\\"\",\n        options: [\n          {\n            text: \"\\\"I've just spoken with the captain — tomorrow's forecast looks calm. I'll book you on the 7 AM, waive the rebooking fee, and send you a confirmation now. If it's cancelled again you'll get a full refund, no questions.\\\"\",\n            quality: 'good',\n            feedback: \"Checking with the captain first, waiving fees, and giving a clear safety net transforms a disappointment into anticipation. The group has something to look forward to.\",\n            scoreΔ: 4, moodΔ: 20, next: 'outcome-great'\n          },\n          {\n            text: \"\\\"I can't promise weather, but the forecast looks better. I'll book you provisionally.\\\"\",\n            quality: 'neutral',\n            feedback: \"Honest about uncertainty, but 'provisionally' sounds uncommitted. Clarify the cancellation terms so they know they're protected if it happens again.\",\n            scoreΔ: 1, moodΔ: 5, next: 'outcome-good'\n          },\n          {\n            text: \"\\\"Forecasts aren't reliable. I'd suggest the refund to be safe.\\\"\",\n            quality: 'bad',\n            feedback: \"Discouraging a rebooking when the guest specifically wants the experience misses the point entirely. You're solving for your convenience, not theirs.\",\n            scoreΔ: -1, moodΔ: -10, next: 'outcome-ok'\n          }\n        ]\n      },\n      n3b: {\n        situation: \"You offer a refund plus a 20% voucher for a future trip. Most guests accept, but Mrs. Sørensen shakes her head.\",\n        customer: \"\\\"A voucher is useless if we're not coming back. Can you find us something to do in town today instead?\\\"\",\n        options: [\n          {\n            text: \"\\\"Absolutely — let me call ahead to the kayak centre and the coastal walk guide. I'll try to get you a group slot this afternoon and sort out a transfer.\\\"\",\n            quality: 'good',\n            feedback: \"Taking active ownership of finding an alternative — rather than listing options and leaving it to her — is the difference between service and service recovery.\",\n            scoreΔ: 3, moodΔ: 20, next: 'outcome-good'\n          },\n          {\n            text: \"\\\"There's a coastal walking trail and a kayak hire nearby — I can give you the contact details.\\\"\",\n            quality: 'neutral',\n            feedback: \"Helpful but passive. You're giving her homework. Taking one more step — calling ahead, confirming availability — shows you're invested.\",\n            scoreΔ: 1, moodΔ: 5, next: 'outcome-ok'\n          },\n          {\n            text: \"\\\"I'm afraid alternative activities aren't really our area — we're a boat tour operator.\\\"\",\n            quality: 'bad',\n            feedback: \"Guests don't care about your operational remit. 'Not our area' sounds like a refusal to help. In service, your area is whatever the guest needs right now.\",\n            scoreΔ: -2, moodΔ: -15, next: 'outcome-poor'\n          }\n        ]\n      },\n      n3c: {\n        situation: \"Three guests are now posting reviews in real time. One asks to speak to a manager.\",\n        customer: \"\\\"I want a full refund AND compensation for our time. This is completely unprofessional.\\\"\",\n        options: [\n          {\n            text: \"\\\"A full refund is absolutely the right outcome here. I'll also arrange a 30% discount on a future booking and log the communication failure formally so it doesn't happen to the next group.\\\"\",\n            quality: 'good',\n            feedback: \"Conceding the refund quickly, adding a future discount, and promising systemic improvement shows you take the feedback seriously. The systemic fix comment addresses the 'nothing you can do' impression.\",\n            scoreΔ: 2, moodΔ: 10, next: 'outcome-poor'\n          },\n          {\n            text: \"\\\"I'll process a full refund immediately. I'm sorry this happened.\\\"\",\n            quality: 'neutral',\n            feedback: \"Bare minimum but at least you're not escalating further. The damage is done; at least you're ending cleanly.\",\n            scoreΔ: 0, moodΔ: 0, next: 'outcome-poor'\n          },\n          {\n            text: \"\\\"Compensation for time isn't something we offer — the refund is the standard procedure.\\\"\",\n            quality: 'bad',\n            feedback: \"At this point, hiding behind procedure will make the reviews far more negative. Some goodwill gesture — even small — would have been a better business decision than being technically correct.\",\n            scoreΔ: -2, moodΔ: -15, next: 'outcome-terrible'\n          }\n        ]\n      },\n      'outcome-great': {\n        outcome: true,\n        emoji: '⭐',\n        title: 'Turned Around',\n        color: 'green',\n        description: \"The group does the 7 AM cruise the next morning in perfect weather. Mrs. Sørensen posts a photo and writes: 'Cancellation turned into the best morning of the trip — staff were brilliant.'\",\n        debrief: \"You acknowledged the failure, solved the real problem (the experience, not just the refund), and followed up with concrete action. The service recovery paradox delivered exactly what it promised.\"\n      },\n      'outcome-good': {\n        outcome: true,\n        emoji: '😊',\n        title: 'Mostly Recovered',\n        color: 'blue',\n        description: \"Most guests leave satisfied with the alternatives or rebooking. A few write neutral reviews. No viral complaints.\",\n        debrief: \"Good recovery with room to improve. You solved the practical problem but missed some opportunities to validate feelings and take extra initiative. Practice the Acknowledge step more deliberately.\"\n      },\n      'outcome-ok': {\n        outcome: true,\n        emoji: '😐',\n        title: 'Acceptable',\n        color: 'amber',\n        description: \"Guests leave with refunds. Some are fine, a few are disappointed. One 2-star review mentions 'poor communication on the day.'\",\n        debrief: \"You handled the logistics but not the emotional journey. The 90-minute wait without communication was never properly acknowledged. Prevention tip: a quick SMS and a visible staff member on the pier from the start would have prevented most of this.\"\n      },\n      'outcome-poor': {\n        outcome: true,\n        emoji: '😠',\n        title: 'Damaged',\n        color: 'red',\n        description: \"Several 2-star reviews are posted. The company's booking rate dips for two weeks.\",\n        debrief: \"The communication failure at the pier was the real complaint — not the weather. When guests feel ignored and then given boilerplate responses, they react with public criticism. The LAST model's Listen and Acknowledge steps were skipped or done poorly here.\"\n      },\n      'outcome-terrible': {\n        outcome: true,\n        emoji: '💥',\n        title: 'Reputation Damage',\n        color: 'red',\n        description: \"A 1-star post with photos goes viral locally. The tourism board contacts the company for a comment.\",\n        debrief: \"When guests film and post on location, hiding behind policy is the worst possible response. Humility and a genuine goodwill gesture — even a small one — would have changed the outcome at almost zero cost.\"\n      }\n    }\n  },\n\n  {\n    id: 'billing-dispute',\n    emoji: '💳',\n    title: 'Billing Dispute',\n    subtitle: 'An angry returning customer insists she was overcharged. The charge appears correct in the system.',\n    difficulty: 'Advanced',\n    diffColor: 'red',\n    startMood: 20,\n    startNode: 'n1',\n    nodes: {\n      n1: {\n        situation: \"Ms. Lindqvist, a loyal customer who has stayed three times before, storms up to the reception desk of your boutique hotel. She holds up her phone showing her bank app. The charge on her account is NOK 1,840 more than she expected. You check the system: the charge reflects the agreed rate plus a city tax that was listed in the booking confirmation but not prominently displayed.\",\n        customer: \"\\\"I want to know why you charged me NOK 1,840 more than agreed. I've stayed here THREE times. Do you think I don't know what I booked?\\\"\",\n        options: [\n          {\n            text: \"\\\"Ms. Lindqvist, thank you for coming to me directly. I can see why this is alarming. Let me pull up your full booking right now and walk through it with you together.\\\"\",\n            quality: 'good',\n            feedback: \"Thanking her for coming to you (not complaining online), staying calm, and proposing a joint review invites collaboration rather than confrontation. You're not defending or conceding — you're investigating together.\",\n            scoreΔ: 3, moodΔ: 20, next: 'n2a'\n          },\n          {\n            text: \"\\\"I'm sorry you feel that way. The charge is based on your booking. Let me print the breakdown.\\\"\",\n            quality: 'neutral',\n            feedback: \"'I'm sorry you feel that way' is a passive-aggressive non-apology that experienced guests recognise immediately. It implies the problem is her perception, not a real issue. Ditch that phrase entirely.\",\n            scoreΔ: 0, moodΔ: -10, next: 'n2b'\n          },\n          {\n            text: \"\\\"Our records show the charge is correct. The city tax is stated in the confirmation email.\\\"\",\n            quality: 'bad',\n            feedback: \"Immediately telling a loyal customer she's wrong — especially before investigating — is defensive and dismissive. Even if you're right, this approach will escalate the situation.\",\n            scoreΔ: -2, moodΔ: -20, next: 'n2c'\n          }\n        ]\n      },\n      n2a: {\n        situation: \"You open the booking together. The NOK 1,840 is the city tax for 4 nights — it was in the confirmation email, but buried in a table at the bottom. Ms. Lindqvist had not noticed it.\",\n        customer: \"\\\"Well... it's there. But it's completely hidden. I've never paid this before — or maybe I just never noticed. I feel foolish now.\\\"\",\n        options: [\n          {\n            text: \"\\\"Please don't feel foolish — we should have made that much clearer. The tax came into effect last year and we haven't updated how prominently it's displayed. I'll flag that to our team. The charge itself is correct, but I want to thank you for raising it — this will help future guests.\\\"\",\n            quality: 'good',\n            feedback: \"Validating her feelings ('don't feel foolish'), taking institutional responsibility for the poor presentation, confirming the charge honestly, and turning it into a constructive outcome is masterful. She leaves with dignity intact.\",\n            scoreΔ: 4, moodΔ: 30, next: 'n3a'\n          },\n          {\n            text: \"\\\"The charge is correct as you can see. I hope that clarifies it.\\\"\",\n            quality: 'neutral',\n            feedback: \"Technically correct but cold. She just admitted she felt foolish — a moment of warmth and some acknowledgment of the poor formatting would have sealed a positive outcome. You left her with nothing.\",\n            scoreΔ: 1, moodΔ: -5, next: 'n3b'\n          },\n          {\n            text: \"\\\"Yes — it's right there in the email. You should have read it more carefully.\\\"\",\n            quality: 'bad',\n            feedback: \"Telling a loyal customer she 'should have read it more carefully' is condescending and will destroy the relationship. Even if she missed it, the presentation was clearly insufficient.\",\n            scoreΔ: -4, moodΔ: -30, next: 'n3c'\n          }\n        ]\n      },\n      n2b: {\n        situation: \"Ms. Lindqvist is not mollified. She points at specific line items on the printout.\",\n        customer: \"\\\"This tax — I never paid this before. Either you overcharged me or someone changed the rate without telling me.\\\"\",\n        options: [\n          {\n            text: \"\\\"That's a fair question. This city tax was introduced last year — it wasn't charged on your earlier stays. I should have made that clearer. Let me show you the booking email where it appears.\\\"\",\n            quality: 'good',\n            feedback: \"Explaining the timeline proactively (it's new, not a mistake) removes the suspicion of error or fraud. Being transparent about when and why it changed keeps trust intact.\",\n            scoreΔ: 3, moodΔ: 20, next: 'n3a'\n          },\n          {\n            text: \"\\\"The rates can change year to year. Your current confirmation shows the correct amount.\\\"\",\n            quality: 'neutral',\n            feedback: \"True, but vague. 'Rates can change' without explaining WHY or WHEN sounds evasive. More specific information would prevent the next question.\",\n            scoreΔ: 1, moodΔ: 0, next: 'n3b'\n          },\n          {\n            text: \"\\\"I assure you everything is correct. Our billing system is very reliable.\\\"\",\n            quality: 'bad',\n            feedback: \"Telling a guest to trust your system rather than engaging with her specific concern is dismissive. She's not questioning the system — she's questioning the transparency of the communication.\",\n            scoreΔ: -2, moodΔ: -15, next: 'n3c'\n          }\n        ]\n      },\n      n2c: {\n        situation: \"Ms. Lindqvist's anger is now fully activated. She crosses her arms.\",\n        customer: \"\\\"So you're saying I'm wrong? I've spent over NOK 20,000 here in the last two years. Is this how you treat loyal customers?\\\"\",\n        options: [\n          {\n            text: \"\\\"That's not what I meant at all — and you're right to call that out. You ARE a valued guest and I handled that badly. Let me start over: can we look at this together?\\\"\",\n            quality: 'good',\n            feedback: \"A genuine reset and apology for YOUR communication style, separate from the billing question. This shows emotional intelligence and keeps the conversation productive.\",\n            scoreΔ: 2, moodΔ: 15, next: 'n3a'\n          },\n          {\n            text: \"\\\"I appreciate your loyalty. Let me review the charge in more detail.\\\"\",\n            quality: 'neutral',\n            feedback: \"An acknowledgment without a genuine apology for being dismissive. Better than nothing, but she needed to feel heard — not processed.\",\n            scoreΔ: 1, moodΔ: 5, next: 'n3b'\n          },\n          {\n            text: \"\\\"Loyalty doesn't change what the booking says. Let me print the confirmation for you.\\\"\",\n            quality: 'bad',\n            feedback: \"Using loyalty as a transactional card she can't play is patronising. This escalates from a billing query to a relationship rupture.\",\n            scoreΔ: -3, moodΔ: -20, next: 'n3c'\n          }\n        ]\n      },\n      n3a: {\n        situation: \"Ms. Lindqvist is calmer and agrees the charge seems correct, but she's disappointed the tax wasn't communicated clearly when she booked.\",\n        customer: \"\\\"Fine. I accept it. But I would have liked to know upfront. I nearly cancelled my next booking over this.\\\"\",\n        options: [\n          {\n            text: \"\\\"That would have been a real shame — and a wake-up call we needed. I'm going to personally note this in your profile so at your next booking we proactively remind you of all charges. And thank you, sincerely — this conversation will make us better.\\\"\",\n            quality: 'good',\n            feedback: \"Personalising the remedy (a note in her profile), expressing genuine gratitude, and treating her feedback as a gift completes the LAST model perfectly. She leaves feeling like a VIP, not a complainant.\",\n            scoreΔ: 4, moodΔ: 20, next: 'outcome-great'\n          },\n          {\n            text: \"\\\"I'll pass the feedback on about making the tax more visible. Thank you for letting us know.\\\"\",\n            quality: 'neutral',\n            feedback: \"A reasonable close, but impersonal. The promise is vague ('pass it on') and she's not given any concrete reason to return. Good enough, but not memorable.\",\n            scoreΔ: 1, moodΔ: 5, next: 'outcome-good'\n          },\n          {\n            text: \"\\\"We'll look into how it's displayed. Have a good stay.\\\"\",\n            quality: 'bad',\n            feedback: \"This non-commit after a tense exchange lands badly. 'We'll look into it' without any specifics, followed by a cheerful send-off, feels insincere.\",\n            scoreΔ: -1, moodΔ: -5, next: 'outcome-ok'\n          }\n        ]\n      },\n      n3b: {\n        situation: \"Ms. Lindqvist accepts that the charge is correct but is still cool. She asks whether any goodwill is offered given her loyalty.\",\n        customer: \"\\\"I've never questioned a bill here before. Is there anything you can do to acknowledge that this could have been communicated better?\\\"\",\n        options: [\n          {\n            text: \"\\\"Absolutely. I'd like to offer you a complimentary upgrade on your next stay and a welcome drink tonight. You deserve better transparency from us and I want to show that.\\\"\",\n            quality: 'good',\n            feedback: \"A concrete, personalised goodwill gesture paired with an honest admission. The upgrade costs little but communicates: 'you matter here.' This is relationship-repair done well.\",\n            scoreΔ: 3, moodΔ: 20, next: 'outcome-good'\n          },\n          {\n            text: \"\\\"I can offer you a loyalty discount on your next stay.\\\"\",\n            quality: 'neutral',\n            feedback: \"A discount is something — but it feels formulaic. It doesn't address the personal relationship or the specific communication failure she flagged.\",\n            scoreΔ: 1, moodΔ: 5, next: 'outcome-ok'\n          },\n          {\n            text: \"\\\"I'm afraid we can't offer compensation when the billing was correct.\\\"\",\n            quality: 'bad',\n            feedback: \"She's not claiming an error — she's asking for recognition of a poor experience with a loyal customer. Refusing on a technicality ends the loyalty relationship.\",\n            scoreΔ: -2, moodΔ: -15, next: 'outcome-poor'\n          }\n        ]\n      },\n      n3c: {\n        situation: \"Ms. Lindqvist announces she is cancelling her future booking and will not return. She takes a photo of the charges.\",\n        customer: \"\\\"I've been a loyal customer for two years. I'll find somewhere that actually values that.\\\"\",\n        options: [\n          {\n            text: \"\\\"I understand — and I'm genuinely sorry we got to this point. If you'd give me one moment, I'd like to involve our manager to see if we can do something meaningful to keep your trust.\\\"\",\n            quality: 'good',\n            feedback: \"Even at this late stage, a genuine apology and an escalation with intent (not just reflex) can sometimes save a relationship. You're at least ending with humility.\",\n            scoreΔ: 1, moodΔ: 5, next: 'outcome-poor'\n          },\n          {\n            text: \"\\\"I'm sorry to hear that. I hope you'll reconsider.\\\"\",\n            quality: 'neutral',\n            feedback: \"Too passive. 'I hope you'll reconsider' without any action makes it sound like you want the problem to go away, not the customer to stay.\",\n            scoreΔ: 0, moodΔ: 0, next: 'outcome-poor'\n          },\n          {\n            text: \"\\\"That's your right. The charges were all correct.\\\"\",\n            quality: 'bad',\n            feedback: \"Ending with 'the charges were correct' as she walks away is the worst possible send-off. You're right about the billing and wrong about everything else.\",\n            scoreΔ: -3, moodΔ: -15, next: 'outcome-terrible'\n          }\n        ]\n      },\n      'outcome-great': {\n        outcome: true,\n        emoji: '🌟',\n        title: 'Loyalty Strengthened',\n        color: 'green',\n        description: \"Ms. Lindqvist books her fourth stay the same week and mentions in her review: 'A misunderstanding about billing was handled with such care that I trust this hotel completely.'\",\n        debrief: \"You never got defensive, you investigated together, you took responsibility for the presentation failure (not the billing), and you ended with a personal touch. This is the service recovery paradox at its most powerful — a near-crisis became a loyalty moment.\"\n      },\n      'outcome-good': {\n        outcome: true,\n        emoji: '😊',\n        title: 'Trust Maintained',\n        color: 'blue',\n        description: \"Ms. Lindqvist accepts the explanation and the gesture. She keeps her future booking. She doesn't leave a review.\",\n        debrief: \"Good recovery. You handled the billing question correctly and offered something concrete. Missing piece: the emotional acknowledgment of the unclear tax communication. Mentioning proactive improvement (updating the display) would have been the final touch.\"\n      },\n      'outcome-ok': {\n        outcome: true,\n        emoji: '😐',\n        title: 'Survived',\n        color: 'amber',\n        description: \"Ms. Lindqvist accepts the explanation grudgingly. She is not warm at check-out. You're not sure she'll return.\",\n        debrief: \"The charge was correct and she accepts it, but the emotional journey was unsatisfying. The LAST model's Acknowledge step was weak throughout. A loyal customer who feels patronised will quietly defect — there's no public complaint, just silence.\"\n      },\n      'outcome-poor': {\n        outcome: true,\n        emoji: '😠',\n        title: 'Loyalty Lost',\n        color: 'red',\n        description: \"Ms. Lindqvist cancels her future booking. The hotel loses a NOK 20,000+ relationship.\",\n        debrief: \"This outcome shows that even when you're technically right, how you deliver that information determines the outcome. A loyal customer who feels dismissed will leave quietly. The billing was correct; the relationship management was not.\"\n      },\n      'outcome-terrible': {\n        outcome: true,\n        emoji: '💥',\n        title: 'Relationship Ruptured',\n        color: 'red',\n        description: \"Ms. Lindqvist posts a detailed 1-star review specifically about the attitude at the front desk. Several potential guests cite it as a reason for choosing a competitor.\",\n        debrief: \"Being correct about billing while being dismissive about feelings is a losing combination. A loyal customer who storms out with a photo of the charges is a reputational risk. The LAST model exists precisely to prevent this.\"\n      }\n    }\n  }\n];\n\n/* ============================================================\n   STATE\n============================================================ */\nconst state = {\n  tab: 'learn',\n  scenario: null,\n  nodeId: null,\n  mood: 50,\n  score: 0,\n  maxScore: 0,\n  history: [],           // array of {nodeId, choiceIdx, quality}\n  presentScenario: null,\n  presentNodeId: null,\n  presentMood: 50,\n  bestScores: JSON.parse(localStorage.getItem('complaint_best_scores') || '{}')\n};\n\n/* ============================================================\n   MOOD HELPERS\n============================================================ */\nfunction clamp(v, lo, hi) { return Math.max(lo, Math.min(hi, v)); }\n\nfunction moodMeta(mood) {\n  if (mood >= 80) return { emoji: '😄', label: 'Delighted', color: '#22c55e' };\n  if (mood >= 60) return { emoji: '🙂', label: 'Satisfied', color: '#84cc16' };\n  if (mood >= 45) return { emoji: '😐', label: 'Neutral', color: '#eab308' };\n  if (mood >= 30) return { emoji: '😟', label: 'Upset', color: '#f97316' };\n  if (mood >= 15) return { emoji: '😠', label: 'Angry', color: '#ef4444' };\n  return { emoji: '🤬', label: 'Furious', color: '#991b1b' };\n}\n\nfunction updateMoodUI(mood, barId, labelId) {\n  const m = moodMeta(mood);\n  const bar = document.getElementById(barId);\n  const lbl = document.getElementById(labelId);\n  if (bar) { bar.style.width = mood + '%'; bar.style.backgroundColor = m.color; }\n  if (lbl) lbl.textContent = m.emoji + ' ' + m.label;\n}\n\n/* ============================================================\n   SCORE HELPERS\n============================================================ */\nfunction saveBestScore(scenarioId, score) {\n  if (!state.bestScores[scenarioId] || score > state.bestScores[scenarioId]) {\n    state.bestScores[scenarioId] = score;\n    localStorage.setItem('complaint_best_scores', JSON.stringify(state.bestScores));\n  }\n  updateGlobalBadge();\n}\n\nfunction updateGlobalBadge() {\n  const vals = Object.values(state.bestScores);\n  if (vals.length === 0) return;\n  const total = vals.reduce((a, b) => a + b, 0);\n  const badge = document.getElementById('score-badge');\n  if (badge) badge.textContent = 'Best: ' + total + ' pts';\n}\n\n/* ============================================================\n   TAB SWITCHING\n============================================================ */\nfunction switchTab(tab) {\n  state.tab = tab;\n  document.querySelectorAll('.tab-panel').forEach(p => p.classList.add('hidden'));\n  document.getElementById('tab-' + tab).classList.remove('hidden');\n  document.querySelectorAll('.tab-btn').forEach(b => {\n    const isActive = b.dataset.tab === tab;\n    b.classList.toggle('active', isActive);\n    b.classList.toggle('text-blue-700', isActive);\n    b.classList.toggle('text-slate-500', !isActive);\n  });\n}\n\ndocument.querySelectorAll('.tab-btn').forEach(btn => {\n  btn.addEventListener('click', () => switchTab(btn.dataset.tab));\n});\n\nwindow.switchTab = switchTab;\n\n/* ============================================================\n   ACCORDION\n============================================================ */\ndocument.querySelectorAll('.accordion-trigger').forEach(btn => {\n  btn.addEventListener('click', () => {\n    const body = btn.nextElementSibling;\n    const icon = btn.querySelector('.accordion-icon');\n    const isOpen = body.classList.contains('open');\n    body.classList.toggle('open', !isOpen);\n    if (icon) icon.textContent = isOpen ? '▼' : '▲';\n  });\n});\n\n/* ============================================================\n   SCENARIO SELECTION — build cards\n============================================================ */\nfunction buildScenarioCards(containerId, onSelect) {\n  const container = document.getElementById(containerId);\n  if (!container) return;\n  container.innerHTML = '';\n  SCENARIOS.forEach(sc => {\n    const best = state.bestScores[sc.id];\n    const diffColors = { green: 'bg-green-100 text-green-800', amber: 'bg-amber-100 text-amber-800', red: 'bg-red-100 text-red-800' };\n    const dc = diffColors[sc.diffColor] || 'bg-slate-100 text-slate-800';\n    const card = document.createElement('div');\n    card.className = 'bg-white rounded-xl border border-slate-200 p-4 cursor-pointer hover:border-blue-300 hover:shadow-md transition-all flex gap-4 items-start';\n    card.innerHTML = `\n      <span class=\"text-3xl\">${sc.emoji}</span>\n      <div class=\"flex-1 min-w-0\">\n        <div class=\"flex flex-wrap items-center gap-2 mb-1\">\n          <h3 class=\"font-bold text-slate-800\">${sc.title}</h3>\n          <span class=\"text-xs px-2 py-0.5 rounded-full font-medium ${dc}\">${sc.difficulty}</span>\n          ${best !== undefined ? `<span class=\"text-xs px-2 py-0.5 rounded-full bg-blue-100 text-blue-800 font-medium\">Best: ${best} pts</span>` : ''}\n        </div>\n        <p class=\"text-sm text-slate-600\">${sc.subtitle}</p>\n      </div>\n      <span class=\"text-slate-400 text-xl self-center\">›</span>\n    `;\n    card.addEventListener('click', () => onSelect(sc));\n    container.appendChild(card);\n  });\n}\n\nbuildScenarioCards('scenario-cards', startScenario);\nbuildScenarioCards('present-scenario-cards', startPresent);\n\n/* ============================================================\n   PRACTICE — start / render\n============================================================ */\nfunction startScenario(sc) {\n  state.scenario = sc;\n  state.nodeId = sc.startNode;\n  state.mood = sc.startMood;\n  state.score = 0;\n  state.history = [];\n\n  document.getElementById('scenario-select').classList.add('hidden');\n  document.getElementById('scenario-active').classList.remove('hidden');\n  document.getElementById('scenario-label').textContent = sc.title;\n  document.getElementById('live-score').textContent = '0';\n\n  updateMoodUI(state.mood, 'mood-bar', 'mood-label');\n  renderNode();\n}\n\nfunction renderNode() {\n  const sc = state.scenario;\n  const node = sc.nodes[state.nodeId];\n  const container = document.getElementById('node-content');\n  container.innerHTML = '';\n  container.className = 'node-enter';\n  // Re-trigger animation\n  void container.offsetWidth;\n\n  if (node.outcome) {\n    renderOutcome(node, container);\n  } else {\n    renderDecision(node, container);\n  }\n}\n\nfunction renderDecision(node, container) {\n  const html = `\n    <div class=\"bg-slate-800 rounded-xl p-4 mb-4 text-white text-sm leading-relaxed\">\n      <p class=\"text-xs text-slate-400 uppercase tracking-widest font-semibold mb-2\">Situation</p>\n      <p>${escHtml(node.situation)}</p>\n    </div>\n    <div class=\"bg-blue-50 border border-blue-200 rounded-xl p-4 mb-4\">\n      <p class=\"text-xs text-blue-600 uppercase tracking-widest font-semibold mb-1\">Customer says:</p>\n      <p class=\"text-sm text-blue-900 italic\">${escHtml(node.customer)}</p>\n    </div>\n    <p class=\"text-xs text-slate-500 font-semibold uppercase tracking-widest mb-3\">How do you respond?</p>\n    <div class=\"space-y-3\" id=\"options-list\"></div>\n  `;\n  container.innerHTML = html;\n\n  const optList = document.getElementById('options-list');\n  node.options.forEach((opt, idx) => {\n    const card = document.createElement('div');\n    card.className = 'option-card bg-white rounded-xl border border-slate-200 p-4 text-sm';\n    card.innerHTML = `\n      <span class=\"inline-block text-xs font-bold text-slate-400 mb-1\">Option ${idx + 1}</span>\n      <p class=\"text-slate-800\">${escHtml(opt.text)}</p>\n    `;\n    card.addEventListener('click', () => chooseOption(idx));\n    optList.appendChild(card);\n  });\n}\n\nfunction chooseOption(idx) {\n  const sc = state.scenario;\n  const node = sc.nodes[state.nodeId];\n  const opt = node.options[idx];\n\n  state.mood = clamp(state.mood + opt.moodΔ, 0, 100);\n  state.score += opt.scoreΔ;\n  state.history.push({ nodeId: state.nodeId, choiceIdx: idx, quality: opt.quality });\n\n  updateMoodUI(state.mood, 'mood-bar', 'mood-label');\n  document.getElementById('live-score').textContent = state.score;\n\n  // Show feedback overlay\n  showFeedback(opt, () => {\n    state.nodeId = opt.next;\n    renderNode();\n  });\n}\n\nfunction showFeedback(opt, onContinue) {\n  const qColors = { good: 'border-green-400 bg-green-50', neutral: 'border-amber-400 bg-amber-50', bad: 'border-red-400 bg-red-50' };\n  const qLabels = { good: '✓ Good choice', neutral: '→ Neutral', bad: '✗ Escalates conflict' };\n  const qLabel = { good: 'text-green-800', neutral: 'text-amber-800', bad: 'text-red-800' };\n  const col = qColors[opt.quality] || 'border-slate-300 bg-slate-50';\n  const lbl = qLabels[opt.quality] || '';\n  const lblCol = qLabel[opt.quality] || 'text-slate-800';\n\n  const overlay = document.createElement('div');\n  overlay.className = 'fixed inset-0 bg-black/50 z-50 flex items-end sm:items-center justify-center p-4';\n  overlay.innerHTML = `\n    <div class=\"bg-white rounded-2xl w-full max-w-lg shadow-2xl border-2 ${col} overflow-hidden\">\n      <div class=\"p-5\">\n        <p class=\"text-xs font-bold uppercase tracking-widest ${lblCol} mb-2\">${lbl}</p>\n        <p class=\"text-sm text-slate-700 leading-relaxed\">${escHtml(opt.feedback)}</p>\n      </div>\n      <div class=\"border-t border-slate-100 p-4\">\n        <button class=\"w-full bg-slate-800 text-white rounded-xl py-2.5 text-sm font-semibold hover:bg-slate-700 transition-colors\" id=\"feedback-continue\">Continue →</button>\n      </div>\n    </div>\n  `;\n  document.body.appendChild(overlay);\n  document.getElementById('feedback-continue').addEventListener('click', () => {\n    document.body.removeChild(overlay);\n    onContinue();\n  });\n}\n\nfunction renderOutcome(node, container) {\n  const sc = state.scenario;\n  saveBestScore(sc.id, state.score);\n\n  const colMap = {\n    green: { bg: 'bg-green-50', border: 'border-green-300', title: 'text-green-800', text: 'text-green-700' },\n    blue:  { bg: 'bg-blue-50',  border: 'border-blue-300',  title: 'text-blue-800',  text: 'text-blue-700'  },\n    amber: { bg: 'bg-amber-50', border: 'border-amber-300', title: 'text-amber-800', text: 'text-amber-700' },\n    red:   { bg: 'bg-red-50',   border: 'border-red-300',   title: 'text-red-800',   text: 'text-red-700'   }\n  };\n  const c = colMap[node.color] || colMap.blue;\n\n  // Build quality summary\n  const good  = state.history.filter(h => h.quality === 'good').length;\n  const neut  = state.history.filter(h => h.quality === 'neutral').length;\n  const bad   = state.history.filter(h => h.quality === 'bad').length;\n\n  container.innerHTML = `\n    <div class=\"${c.bg} border ${c.border} rounded-2xl p-5 mb-4\">\n      <div class=\"flex items-center gap-3 mb-3\">\n        <span class=\"text-4xl\">${node.emoji}</span>\n        <div>\n          <p class=\"text-xs font-bold uppercase tracking-widest ${c.title} opacity-70\">Outcome</p>\n          <h3 class=\"text-xl font-bold ${c.title}\">${escHtml(node.title)}</h3>\n        </div>\n      </div>\n      <p class=\"text-sm ${c.text} leading-relaxed mb-3\">${escHtml(node.description)}</p>\n      <div class=\"flex gap-3 text-xs font-semibold\">\n        <span class=\"bg-green-100 text-green-800 px-2 py-1 rounded-full\">✓ ${good} good</span>\n        <span class=\"bg-amber-100 text-amber-800 px-2 py-1 rounded-full\">→ ${neut} neutral</span>\n        <span class=\"bg-red-100 text-red-800 px-2 py-1 rounded-full\">✗ ${bad} poor</span>\n        <span class=\"bg-slate-100 text-slate-800 px-2 py-1 rounded-full\">Score: ${state.score}</span>\n      </div>\n    </div>\n    <div class=\"bg-slate-800 rounded-xl p-4 mb-5 text-white text-sm leading-relaxed\">\n      <p class=\"text-xs text-slate-400 uppercase tracking-widest font-semibold mb-2\">LAST Model Debrief</p>\n      <p>${escHtml(node.debrief)}</p>\n    </div>\n    <div class=\"flex flex-wrap gap-3\">\n      <button id=\"retry-btn\" class=\"flex-1 min-w-0 bg-blue-600 hover:bg-blue-700 text-white font-semibold px-4 py-2.5 rounded-xl text-sm transition-colors\">↩ Try Again</button>\n      <button id=\"other-btn\" class=\"flex-1 min-w-0 bg-slate-100 hover:bg-slate-200 text-slate-800 font-semibold px-4 py-2.5 rounded-xl text-sm transition-colors\">Other Scenarios</button>\n    </div>\n  `;\n\n  document.getElementById('retry-btn').addEventListener('click', () => startScenario(sc));\n  document.getElementById('other-btn').addEventListener('click', () => {\n    document.getElementById('scenario-active').classList.add('hidden');\n    document.getElementById('scenario-select').classList.remove('hidden');\n    buildScenarioCards('scenario-cards', startScenario);\n  });\n}\n\ndocument.getElementById('back-to-select').addEventListener('click', () => {\n  document.getElementById('scenario-active').classList.add('hidden');\n  document.getElementById('scenario-select').classList.remove('hidden');\n  buildScenarioCards('scenario-cards', startScenario);\n});\n\n/* ============================================================\n   PRESENT MODE\n============================================================ */\nfunction startPresent(sc) {\n  state.presentScenario = sc;\n  state.presentNodeId = sc.startNode;\n  state.presentMood = sc.startMood;\n\n  document.getElementById('p-scenario-name').textContent = sc.title;\n  updateMoodUI(state.presentMood, 'p-mood-bar', 'p-mood-label');\n\n  renderPresentNode();\n\n  const overlay = document.getElementById('present-overlay');\n  overlay.classList.add('active');\n}\n\nfunction renderPresentNode() {\n  const sc = state.presentScenario;\n  const node = sc.nodes[state.presentNodeId];\n  const container = document.getElementById('p-node-content');\n  container.innerHTML = '';\n\n  if (node.outcome) {\n    renderPresentOutcome(node, container);\n    return;\n  }\n\n  const optionLabels = ['A', 'B', 'C'];\n  const html = `\n    <div class=\"bg-slate-700 rounded-2xl p-5 mb-5\">\n      <p class=\"text-xs text-slate-400 uppercase tracking-widest font-semibold mb-3\">Situation</p>\n      <p class=\"text-slate-100 text-base leading-relaxed\">${escHtml(node.situation)}</p>\n    </div>\n    <div class=\"bg-blue-900 border border-blue-700 rounded-2xl p-4 mb-5\">\n      <p class=\"text-xs text-blue-400 uppercase tracking-widest font-semibold mb-1\">Customer says:</p>\n      <p class=\"text-blue-100 text-base italic\">${escHtml(node.customer)}</p>\n    </div>\n    <p class=\"text-sm text-slate-400 font-semibold uppercase tracking-widest mb-4\">What do you do?</p>\n    <div class=\"space-y-3\" id=\"p-options-list\"></div>\n    <div id=\"p-reveal-area\" class=\"mt-4\"></div>\n  `;\n  container.innerHTML = html;\n\n  const optList = document.getElementById('p-options-list');\n  node.options.forEach((opt, idx) => {\n    const card = document.createElement('div');\n    card.className = 'bg-slate-700 border border-slate-600 rounded-xl p-4 cursor-pointer hover:border-blue-400 transition-colors';\n    card.setAttribute('data-opt-idx', idx);\n    card.innerHTML = `\n      <div class=\"flex gap-3 items-start\">\n        <span class=\"text-blue-400 font-black text-lg leading-none mt-0.5\">${optionLabels[idx]}</span>\n        <p class=\"text-slate-100 text-sm leading-relaxed\">${escHtml(opt.text)}</p>\n      </div>\n    `;\n    card.addEventListener('click', () => revealPresentFeedback(idx, node));\n    optList.appendChild(card);\n  });\n}\n\nfunction revealPresentFeedback(idx, node) {\n  const opt = node.options[idx];\n  state.presentMood = clamp(state.presentMood + opt.moodΔ, 0, 100);\n  updateMoodUI(state.presentMood, 'p-mood-bar', 'p-mood-label');\n\n  const qColors = { good: 'border-green-500 bg-green-900', neutral: 'border-amber-500 bg-amber-900', bad: 'border-red-500 bg-red-900' };\n  const qLabels = { good: '✓ Good choice', neutral: '→ Neutral', bad: '✗ Escalates conflict' };\n  const col = qColors[opt.quality] || 'border-slate-500 bg-slate-800';\n  const lbl = qLabels[opt.quality] || '';\n\n  // Highlight selected option\n  document.querySelectorAll('#p-options-list > div').forEach((el, i) => {\n    if (i === idx) {\n      el.classList.add('border-blue-400', 'ring-2', 'ring-blue-400');\n    } else {\n      el.classList.add('opacity-40');\n    }\n  });\n\n  const revealArea = document.getElementById('p-reveal-area');\n  revealArea.innerHTML = `\n    <div class=\"rounded-xl border-2 ${col} p-4 mb-4\">\n      <p class=\"text-xs font-bold uppercase tracking-widest text-white opacity-80 mb-1\">${lbl}</p>\n      <p class=\"text-white text-sm leading-relaxed\">${escHtml(opt.feedback)}</p>\n    </div>\n    <button id=\"p-continue-btn\" class=\"w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 rounded-xl text-sm transition-colors\">Next →</button>\n  `;\n  document.getElementById('p-continue-btn').addEventListener('click', () => {\n    state.presentNodeId = opt.next;\n    renderPresentNode();\n  });\n}\n\nfunction renderPresentOutcome(node, container) {\n  const colMap = {\n    green: 'border-green-500 bg-green-900',\n    blue:  'border-blue-500 bg-blue-900',\n    amber: 'border-amber-500 bg-amber-900',\n    red:   'border-red-500 bg-red-900'\n  };\n  const c = colMap[node.color] || colMap.blue;\n  container.innerHTML = `\n    <div class=\"border-2 ${c} rounded-2xl p-6 mb-5\">\n      <div class=\"flex items-center gap-3 mb-3\">\n        <span class=\"text-5xl\">${node.emoji}</span>\n        <div>\n          <p class=\"text-xs font-bold uppercase tracking-widest text-white opacity-70\">Outcome</p>\n          <h3 class=\"text-2xl font-bold text-white\">${escHtml(node.title)}</h3>\n        </div>\n      </div>\n      <p class=\"text-slate-200 leading-relaxed mb-4\">${escHtml(node.description)}</p>\n      <div class=\"bg-black/20 rounded-xl p-4\">\n        <p class=\"text-xs text-slate-400 uppercase tracking-widest font-semibold mb-2\">LAST Model Debrief</p>\n        <p class=\"text-slate-200 text-sm leading-relaxed\">${escHtml(node.debrief)}</p>\n      </div>\n    </div>\n    <div class=\"flex flex-wrap gap-3\">\n      <button id=\"p-restart-btn\" class=\"flex-1 bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 rounded-xl text-sm transition-colors\">↩ Restart Scenario</button>\n      <button id=\"p-exit-btn\" class=\"flex-1 bg-slate-700 hover:bg-slate-600 text-white font-semibold py-3 rounded-xl text-sm transition-colors\">Exit Present Mode</button>\n    </div>\n  `;\n  document.getElementById('p-restart-btn').addEventListener('click', () => {\n    state.presentNodeId = state.presentScenario.startNode;\n    state.presentMood = state.presentScenario.startMood;\n    updateMoodUI(state.presentMood, 'p-mood-bar', 'p-mood-label');\n    renderPresentNode();\n  });\n  document.getElementById('p-exit-btn').addEventListener('click', exitPresent);\n}\n\nfunction exitPresent() {\n  document.getElementById('present-overlay').classList.remove('active');\n}\n\ndocument.getElementById('exit-present').addEventListener('click', exitPresent);\n\ndocument.addEventListener('keydown', e => {\n  if (e.key === 'Escape') {\n    const overlay = document.getElementById('present-overlay');\n    if (overlay.classList.contains('active')) exitPresent();\n  }\n});\n\n// Present button from header — goes to present-setup tab\ndocument.getElementById('present-btn').addEventListener('click', () => switchTab('present-setup'));\n\n/* ============================================================\n   HTML ESCAPE HELPER\n============================================================ */\nfunction escHtml(str) {\n  return String(str)\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .replace(/\"/g, '&quot;');\n}\n\n/* ============================================================\n   INIT\n============================================================ */\nupdateGlobalBadge();\n</script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Complaint & Conflict Handling",
    "windowTitle": "Complaint & Conflict Handling",
    "bundleId": "com.halisonworks.complainthandling",
    "iconPath": null
  },
