{
  "schema": "app-studio/canvas@1",
  "id": "example-itinerary",
  "name": "itinerary.html",
  "code": "<!DOCTYPE html>\n<!--\n  Itinerary — Halison App Studio example\n\n  A day-by-day trip planner: build each day of your trip as a timeline of\n  activities with times, places, and notes. Saves to your browser.\n\n  From the Halison App Studio public library:\n  https://github.com/halisonworks/public-app-studio\n\n  Permitted use: personal, educational, and other non-commercial use. You may\n  modify it, but keep this header and the source link intact, and do not sell,\n  commercialize, or republish it. Released under the Halison App Studio Examples\n  License — see the LICENSE file in the repository above.\n-->\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Itinerary Planner</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Segoe UI', system-ui, sans-serif; }\n\n    /* Timeline vertical line */\n    .timeline-track {\n      position: relative;\n    }\n    .timeline-track::before {\n      content: '';\n      position: absolute;\n      left: 23px;\n      top: 0;\n      bottom: 0;\n      width: 2px;\n      background: #e2e8f0;\n      z-index: 0;\n    }\n\n    /* Activity dot */\n    .activity-dot {\n      position: relative;\n      z-index: 1;\n      flex-shrink: 0;\n      width: 48px;\n      display: flex;\n      align-items: flex-start;\n      justify-content: center;\n      padding-top: 2px;\n    }\n\n    /* Subtle scrollbar */\n    ::-webkit-scrollbar { width: 6px; height: 6px; }\n    ::-webkit-scrollbar-track { background: transparent; }\n    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }\n\n    /* Activity type colors */\n    .type-travel  { background: #dbeafe; color: #1e40af; border-color: #93c5fd; }\n    .type-food    { background: #fef3c7; color: #92400e; border-color: #fcd34d; }\n    .type-sight   { background: #d1fae5; color: #065f46; border-color: #6ee7b7; }\n    .type-stay    { background: #ede9fe; color: #5b21b6; border-color: #c4b5fd; }\n    .type-other   { background: #f1f5f9; color: #475569; border-color: #cbd5e1; }\n\n    /* Edit form */\n    .edit-form { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 0.75rem; }\n\n    /* Modal backdrop */\n    .modal-backdrop {\n      position: fixed; inset: 0;\n      background: rgba(0,0,0,0.45);\n      z-index: 50;\n      display: flex; align-items: center; justify-content: center;\n    }\n\n    /* Category badge pill */\n    .cat-pill {\n      display: inline-flex; align-items: center; gap: 4px;\n      font-size: 0.7rem; font-weight: 600;\n      padding: 1px 8px; border-radius: 9999px; border-width: 1px;\n      white-space: nowrap;\n    }\n\n    input[type=\"date\"]::-webkit-calendar-picker-indicator {\n      opacity: 0.7; cursor: pointer;\n    }\n\n    /* Day column sticky header */\n    .day-header-sticky {\n      position: sticky; top: 0; z-index: 10;\n    }\n\n    /* No scrollbar in day list when many days */\n    .days-scroll { overflow-y: auto; }\n\n    /* Compact summary strip */\n    .summary-bar { background: #1e293b; color: #e2e8f0; }\n\n    /* Drag handle cursor */\n    .drag-handle { cursor: grab; }\n\n    /* Activity card hover */\n    .activity-card { transition: box-shadow 0.15s; }\n    .activity-card:hover { box-shadow: 0 2px 12px rgba(0,0,0,0.09); }\n\n    /* Responsive layout: single column on small, two-pane on md+ */\n    @media (min-width: 768px) {\n      #layout { display: grid; grid-template-columns: 260px 1fr; }\n    }\n    @media (max-width: 767px) {\n      #layout { display: block; }\n      #day-sidebar { border-right: none; border-bottom: 1px solid #e2e8f0; }\n    }\n  </style>\n</head>\n<body class=\"bg-slate-100 min-h-screen flex flex-col\" style=\"height:100vh; overflow:hidden;\">\n\n<!-- ===== TOP BAR ===== -->\n<header class=\"bg-slate-900 text-white flex-shrink-0 shadow-lg\">\n  <div class=\"max-w-screen-xl mx-auto px-4 py-3 flex flex-wrap items-center gap-3\">\n    <!-- App icon + title -->\n    <div class=\"flex items-center gap-2 mr-2\">\n      <span style=\"font-size:1.5rem;\">🗺️</span>\n      <span class=\"text-xl font-bold tracking-tight\">Itinerary</span>\n    </div>\n\n    <!-- Trip name -->\n    <input id=\"tripName\" type=\"text\" maxlength=\"80\" placeholder=\"Trip name…\"\n      oninput=\"saveTrip()\"\n      class=\"flex-1 min-w-[140px] max-w-xs bg-slate-700 text-white placeholder-slate-400 rounded-lg px-3 py-1.5 text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n\n    <!-- Start date -->\n    <label class=\"text-xs text-slate-400 flex items-center gap-1.5 whitespace-nowrap\">\n      <span>Start</span>\n      <input id=\"startDate\" type=\"date\"\n        oninput=\"saveTrip(); renderDays();\"\n        class=\"bg-slate-700 text-white rounded-lg px-2 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n    </label>\n\n    <!-- Summary strip inline -->\n    <div id=\"topSummary\" class=\"ml-auto text-xs text-slate-400 hidden md:flex items-center gap-4\"></div>\n\n    <!-- Reset button -->\n    <button onclick=\"confirmReset()\"\n      class=\"ml-1 px-3 py-1.5 rounded-lg bg-slate-700 hover:bg-red-800 text-slate-300 hover:text-white text-xs transition-colors\">\n      Reset\n    </button>\n  </div>\n</header>\n\n<!-- ===== MAIN LAYOUT ===== -->\n<div id=\"layout\" class=\"flex-1 overflow-hidden\" style=\"min-height:0;\">\n\n  <!-- ---- DAY SIDEBAR ---- -->\n  <aside id=\"day-sidebar\" class=\"bg-white border-r border-slate-200 flex flex-col overflow-hidden\">\n    <!-- sidebar header -->\n    <div class=\"px-3 py-2 border-b border-slate-100 flex items-center justify-between flex-shrink-0\">\n      <span class=\"text-xs font-semibold text-slate-500 uppercase tracking-wide\">Days</span>\n      <div class=\"flex gap-1\">\n        <button onclick=\"addDay()\"\n          title=\"Add a day\"\n          class=\"px-2 py-1 rounded bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold transition-colors\">+ Day</button>\n        <button onclick=\"removeLastDay()\"\n          title=\"Remove last day\"\n          class=\"px-2 py-1 rounded bg-slate-200 hover:bg-red-100 hover:text-red-700 text-slate-600 text-xs font-semibold transition-colors\">−</button>\n      </div>\n    </div>\n\n    <!-- day list -->\n    <div id=\"dayList\" class=\"flex-1 overflow-y-auto py-1\"></div>\n\n    <!-- summary at bottom of sidebar -->\n    <div id=\"sidebarSummary\" class=\"border-t border-slate-100 px-3 py-2 text-xs text-slate-500 flex-shrink-0\"></div>\n  </aside>\n\n  <!-- ---- DAY DETAIL PANE ---- -->\n  <main id=\"dayDetail\" class=\"flex-1 overflow-y-auto bg-slate-50\">\n    <!-- filled by renderDetail() -->\n  </main>\n</div>\n\n<!-- ===== RESET MODAL ===== -->\n<div id=\"resetModal\" class=\"modal-backdrop hidden\">\n  <div class=\"bg-white rounded-2xl shadow-2xl max-w-sm w-full mx-4 p-6\">\n    <h2 class=\"text-lg font-bold text-slate-800 mb-2\">Reset all data?</h2>\n    <p class=\"text-sm text-slate-500 mb-5\">This will permanently delete your trip, all days, and all activities. This cannot be undone.</p>\n    <div class=\"flex gap-3 justify-end\">\n      <button onclick=\"closeModal()\"\n        class=\"px-4 py-2 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-semibold transition-colors\">Cancel</button>\n      <button onclick=\"doReset()\"\n        class=\"px-4 py-2 rounded-lg bg-red-600 hover:bg-red-700 text-white text-sm font-semibold transition-colors\">Yes, reset</button>\n    </div>\n  </div>\n</div>\n\n<!-- ===== MOVE-ACTIVITY MODAL ===== -->\n<div id=\"moveModal\" class=\"modal-backdrop hidden\">\n  <div class=\"bg-white rounded-2xl shadow-2xl max-w-xs w-full mx-4 p-6\">\n    <h2 class=\"text-base font-bold text-slate-800 mb-3\">Move activity to day…</h2>\n    <div id=\"moveDayList\" class=\"flex flex-col gap-2 max-h-64 overflow-y-auto mb-4\"></div>\n    <button onclick=\"closeMoveModal()\"\n      class=\"w-full px-4 py-2 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-semibold transition-colors\">Cancel</button>\n  </div>\n</div>\n\n<script>\n/* ================================================================\n   DATA MODEL\n   trip: { name, startDate, days: [ { id, activities: [...] } ] }\n   activity: { id, time, title, location, type, notes }\n   ================================================================ */\n\nconst TYPES = {\n  travel:  { label: 'Travel',        emoji: '✈️' },\n  food:    { label: 'Food & Drink',   emoji: '🍽️' },\n  sight:   { label: 'Sightseeing',   emoji: '🏛️' },\n  stay:    { label: 'Accommodation', emoji: '🏨' },\n  other:   { label: 'Other',         emoji: '📌' },\n};\n\nconst STORAGE_KEY = 'itinerary_v1';\n\n/* ---- State ---- */\nlet trip = null;\nlet selectedDayIdx = 0;\nlet pendingMoveActivity = null; // { dayIdx, activityId }\n\n/* ================================================================\n   PERSISTENCE\n   ================================================================ */\nfunction loadTrip() {\n  try {\n    const raw = localStorage.getItem(STORAGE_KEY);\n    if (raw) { trip = JSON.parse(raw); return; }\n  } catch(e) {}\n  trip = defaultTrip();\n}\n\nfunction saveTrip() {\n  // Pull header values into trip object\n  const nameEl = document.getElementById('tripName');\n  const dateEl = document.getElementById('startDate');\n  if (nameEl) trip.name = nameEl.value;\n  if (dateEl) trip.startDate = dateEl.value;\n  localStorage.setItem(STORAGE_KEY, JSON.stringify(trip));\n}\n\n/* ================================================================\n   DEFAULT / STARTER TRIP\n   ================================================================ */\nfunction defaultTrip() {\n  // A 3-day city trip to Rome — gives the user a realistic starting point\n  const startDate = '2024-09-12';\n  return {\n    name: 'Rome City Break',\n    startDate,\n    days: [\n      {\n        id: uid(),\n        activities: [\n          { id: uid(), time: '09:30', title: 'Fly to Rome (FCO)', location: 'Fiumicino Airport', type: 'travel', notes: 'Flight FR1234. Check-in online.' },\n          { id: uid(), time: '13:00', title: 'Transfer to hotel', location: 'Roma Termini', type: 'travel', notes: 'Take the Leonardo Express (32 min).' },\n          { id: uid(), time: '14:30', title: 'Check in', location: 'Hotel Artemide, Via Nazionale', type: 'stay', notes: 'Early check-in requested.' },\n          { id: uid(), time: '17:00', title: 'Evening stroll — Trevi Fountain', location: 'Piazza di Trevi', type: 'sight', notes: 'Visit before sunset, less crowded.' },\n          { id: uid(), time: '19:30', title: 'Dinner at Tonnarello', location: 'Trastevere', type: 'food', notes: 'Cacio e pepe. Book ahead.' },\n        ]\n      },\n      {\n        id: uid(),\n        activities: [\n          { id: uid(), time: '08:30', title: 'Breakfast at the hotel', location: 'Hotel Artemide', type: 'food', notes: '' },\n          { id: uid(), time: '10:00', title: 'Vatican Museums & Sistine Chapel', location: 'Vatican City', type: 'sight', notes: 'Pre-booked skip-the-line ticket.' },\n          { id: uid(), time: '13:30', title: 'Lunch near St Peter\\'s', location: 'Borgo Pio', type: 'food', notes: 'Budget ~€15 pp.' },\n          { id: uid(), time: '15:00', title: 'St Peter\\'s Basilica', location: 'Vatican City', type: 'sight', notes: 'Climb the dome for panoramic views.' },\n          { id: uid(), time: '19:00', title: 'Aperitivo', location: 'Prati neighbourhood', type: 'food', notes: '' },\n        ]\n      },\n      {\n        id: uid(),\n        activities: [\n          { id: uid(), time: '09:00', title: 'Colosseum & Roman Forum', location: 'Piazza del Colosseo', type: 'sight', notes: 'Combo ticket covers Palatine Hill.' },\n          { id: uid(), time: '13:00', title: 'Lunch at Roscioli', location: 'Via dei Giubbonari', type: 'food', notes: 'Famous for salumi and cheese.' },\n          { id: uid(), time: '15:00', title: 'Piazza Navona & Campo de\\' Fiori', location: 'Historic centre', type: 'sight', notes: '' },\n          { id: uid(), time: '17:30', title: 'Check out & transfer to airport', location: 'Fiumicino Airport', type: 'travel', notes: 'Allow 90 min for transfer.' },\n          { id: uid(), time: '20:45', title: 'Fly home', location: 'Fiumicino Airport (FCO)', type: 'travel', notes: '' },\n        ]\n      }\n    ]\n  };\n}\n\n/* ================================================================\n   UTILITIES\n   ================================================================ */\nfunction uid() {\n  return Date.now().toString(36) + Math.random().toString(36).slice(2, 7);\n}\n\nfunction dayLabel(trip, idx) {\n  if (!trip.startDate) return `Day ${idx + 1}`;\n  try {\n    // Parse the date as local to avoid UTC-offset day shift\n    const [y, m, d] = trip.startDate.split('-').map(Number);\n    const base = new Date(y, m - 1, d);\n    base.setDate(base.getDate() + idx);\n    const weekday = base.toLocaleDateString('en-GB', { weekday: 'short' });\n    const dateStr = base.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });\n    return `${weekday} ${dateStr}`;\n  } catch(e) {\n    return `Day ${idx + 1}`;\n  }\n}\n\nfunction sortActivities(acts) {\n  return [...acts].sort((a, b) => {\n    if (!a.time && !b.time) return 0;\n    if (!a.time) return 1;\n    if (!b.time) return -1;\n    return a.time.localeCompare(b.time);\n  });\n}\n\nfunction typeCss(type) {\n  const map = {\n    travel: 'type-travel',\n    food:   'type-food',\n    sight:  'type-sight',\n    stay:   'type-stay',\n    other:  'type-other',\n  };\n  return map[type] || 'type-other';\n}\n\nfunction countByType(days) {\n  const counts = {};\n  for (const t of Object.keys(TYPES)) counts[t] = 0;\n  for (const day of days) {\n    for (const act of day.activities) {\n      if (counts[act.type] !== undefined) counts[act.type]++;\n      else counts.other = (counts.other || 0) + 1;\n    }\n  }\n  return counts;\n}\n\nfunction escapeHtml(str) {\n  if (!str) return '';\n  return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;');\n}\n\n/* ================================================================\n   TRIP-LEVEL ACTIONS\n   ================================================================ */\nfunction addDay() {\n  trip.days.push({ id: uid(), activities: [] });\n  saveTrip();\n  selectedDayIdx = trip.days.length - 1;\n  renderDays();\n  renderDetail();\n  updateSummary();\n}\n\nfunction removeLastDay() {\n  if (trip.days.length === 0) return;\n  if (!confirm(`Remove Day ${trip.days.length}? All activities in that day will be lost.`)) return;\n  trip.days.pop();\n  if (selectedDayIdx >= trip.days.length) selectedDayIdx = Math.max(0, trip.days.length - 1);\n  saveTrip();\n  renderDays();\n  renderDetail();\n  updateSummary();\n}\n\n/* ================================================================\n   ACTIVITY ACTIONS\n   ================================================================ */\nfunction addActivity(dayIdx) {\n  const day = trip.days[dayIdx];\n  if (!day) return;\n  const newAct = { id: uid(), time: '', title: '', location: '', type: 'sight', notes: '' };\n  day.activities.push(newAct);\n  saveTrip();\n  renderDetail();\n  // Auto-open edit form for the new activity\n  setTimeout(() => openEditForm(dayIdx, newAct.id), 30);\n}\n\nfunction deleteActivity(dayIdx, actId) {\n  const day = trip.days[dayIdx];\n  if (!day) return;\n  day.activities = day.activities.filter(a => a.id !== actId);\n  saveTrip();\n  renderDetail();\n  updateSummary();\n}\n\nfunction moveActivityUp(dayIdx, actId) {\n  const day = trip.days[dayIdx];\n  const sorted = sortActivities(day.activities);\n  const idx = sorted.findIndex(a => a.id === actId);\n  if (idx <= 0) return;\n  // Swap times if both have times, else swap positions in the raw array\n  const rawIdx = day.activities.findIndex(a => a.id === actId);\n  const prevId = sorted[idx - 1].id;\n  const prevRawIdx = day.activities.findIndex(a => a.id === prevId);\n  const tmp = day.activities[rawIdx];\n  day.activities[rawIdx] = day.activities[prevRawIdx];\n  day.activities[prevRawIdx] = tmp;\n  saveTrip();\n  renderDetail();\n}\n\nfunction moveActivityDown(dayIdx, actId) {\n  const day = trip.days[dayIdx];\n  const sorted = sortActivities(day.activities);\n  const idx = sorted.findIndex(a => a.id === actId);\n  if (idx < 0 || idx >= sorted.length - 1) return;\n  const rawIdx = day.activities.findIndex(a => a.id === actId);\n  const nextId = sorted[idx + 1].id;\n  const nextRawIdx = day.activities.findIndex(a => a.id === nextId);\n  const tmp = day.activities[rawIdx];\n  day.activities[rawIdx] = day.activities[nextRawIdx];\n  day.activities[nextRawIdx] = tmp;\n  saveTrip();\n  renderDetail();\n}\n\nfunction saveActivityFromForm(dayIdx, actId) {\n  const day = trip.days[dayIdx];\n  const act = day.activities.find(a => a.id === actId);\n  if (!act) return;\n  act.time     = document.getElementById(`f-time-${actId}`)?.value || '';\n  act.title    = document.getElementById(`f-title-${actId}`)?.value || '';\n  act.location = document.getElementById(`f-loc-${actId}`)?.value || '';\n  act.type     = document.getElementById(`f-type-${actId}`)?.value || 'other';\n  act.notes    = document.getElementById(`f-notes-${actId}`)?.value || '';\n  saveTrip();\n  renderDetail();\n  updateSummary();\n}\n\nfunction openEditForm(dayIdx, actId) {\n  // Show the inline form for a specific activity\n  const el = document.getElementById(`edit-${actId}`);\n  if (el) {\n    el.classList.remove('hidden');\n    el.querySelector(`#f-title-${actId}`)?.focus();\n  }\n}\n\nfunction closeEditForm(actId) {\n  const el = document.getElementById(`edit-${actId}`);\n  if (el) el.classList.add('hidden');\n}\n\n/* ================================================================\n   MOVE TO ANOTHER DAY\n   ================================================================ */\nfunction openMoveModal(dayIdx, actId) {\n  pendingMoveActivity = { dayIdx, actId };\n  const container = document.getElementById('moveDayList');\n  container.innerHTML = '';\n  trip.days.forEach((day, i) => {\n    if (i === dayIdx) return;\n    const label = `Day ${i + 1} — ${dayLabel(trip, i)}`;\n    const btn = document.createElement('button');\n    btn.className = 'px-3 py-2 rounded-lg bg-slate-100 hover:bg-blue-50 hover:text-blue-700 text-sm text-left transition-colors';\n    btn.textContent = label;\n    btn.onclick = () => { doMoveActivity(i); };\n    container.appendChild(btn);\n  });\n  if (trip.days.length <= 1) {\n    container.innerHTML = '<p class=\"text-sm text-slate-400\">No other days to move to.</p>';\n  }\n  document.getElementById('moveModal').classList.remove('hidden');\n}\n\nfunction doMoveActivity(targetDayIdx) {\n  if (!pendingMoveActivity) return;\n  const { dayIdx, actId } = pendingMoveActivity;\n  const fromDay = trip.days[dayIdx];\n  const toDay   = trip.days[targetDayIdx];\n  const actIdx  = fromDay.activities.findIndex(a => a.id === actId);\n  if (actIdx < 0) { closeMoveModal(); return; }\n  const [act] = fromDay.activities.splice(actIdx, 1);\n  toDay.activities.push(act);\n  saveTrip();\n  closeMoveModal();\n  renderDetail();\n  updateSummary();\n}\n\nfunction closeMoveModal() {\n  pendingMoveActivity = null;\n  document.getElementById('moveModal').classList.add('hidden');\n}\n\n/* ================================================================\n   RESET\n   ================================================================ */\nfunction confirmReset() {\n  document.getElementById('resetModal').classList.remove('hidden');\n}\nfunction closeModal() {\n  document.getElementById('resetModal').classList.add('hidden');\n}\nfunction doReset() {\n  localStorage.removeItem(STORAGE_KEY);\n  trip = defaultTrip();\n  selectedDayIdx = 0;\n  closeModal();\n  initUI();\n}\n\n/* ================================================================\n   RENDER: DAY SIDEBAR\n   ================================================================ */\nfunction renderDays() {\n  const container = document.getElementById('dayList');\n  if (!container) return;\n  container.innerHTML = '';\n  trip.days.forEach((day, i) => {\n    const isSelected = i === selectedDayIdx;\n    const label = dayLabel(trip, i);\n    const actCount = day.activities.length;\n    const btn = document.createElement('button');\n    btn.className = [\n      'w-full text-left px-3 py-2 flex items-center justify-between gap-2 transition-colors',\n      isSelected\n        ? 'bg-blue-600 text-white'\n        : 'hover:bg-slate-100 text-slate-700'\n    ].join(' ');\n    btn.innerHTML = `\n      <span class=\"font-medium text-sm truncate\">Day ${i + 1}<span class=\"font-normal ml-1 opacity-75 text-xs\">${escapeHtml(label)}</span></span>\n      <span class=\"flex-shrink-0 text-xs px-1.5 py-0.5 rounded-full ${isSelected ? 'bg-blue-500 text-blue-100' : 'bg-slate-200 text-slate-500'}\">${actCount}</span>\n    `;\n    btn.onclick = () => { selectedDayIdx = i; renderDays(); renderDetail(); };\n    container.appendChild(btn);\n  });\n  if (trip.days.length === 0) {\n    container.innerHTML = '<p class=\"text-xs text-slate-400 px-3 py-4\">No days yet. Add a day to start.</p>';\n  }\n}\n\n/* ================================================================\n   RENDER: SUMMARY\n   ================================================================ */\nfunction updateSummary() {\n  const totalDays = trip.days.length;\n  const totalActs = trip.days.reduce((s, d) => s + d.activities.length, 0);\n  const counts = countByType(trip.days);\n\n  // Top bar summary\n  const topEl = document.getElementById('topSummary');\n  if (topEl) {\n    const parts = [];\n    parts.push(`<span>${totalDays} day${totalDays !== 1 ? 's' : ''}</span>`);\n    parts.push(`<span>${totalActs} activit${totalActs !== 1 ? 'ies' : 'y'}</span>`);\n    for (const [type, cnt] of Object.entries(counts)) {\n      if (cnt > 0) {\n        parts.push(`<span>${TYPES[type]?.emoji || '📌'} ${cnt}</span>`);\n      }\n    }\n    topEl.innerHTML = parts.join('<span class=\"text-slate-600\">·</span>');\n  }\n\n  // Sidebar summary\n  const sEl = document.getElementById('sidebarSummary');\n  if (sEl) {\n    const lines = [];\n    for (const [type, cnt] of Object.entries(counts)) {\n      if (cnt > 0) lines.push(`${TYPES[type]?.emoji} ${TYPES[type]?.label}: ${cnt}`);\n    }\n    sEl.innerHTML = lines.join('<br>') || '<span class=\"text-slate-400\">No activities yet.</span>';\n  }\n}\n\n/* ================================================================\n   RENDER: DAY DETAIL PANE\n   ================================================================ */\nfunction renderDetail() {\n  const pane = document.getElementById('dayDetail');\n  if (!pane) return;\n\n  if (trip.days.length === 0) {\n    pane.innerHTML = `\n      <div class=\"flex flex-col items-center justify-center h-full py-24 text-slate-400\">\n        <div class=\"text-5xl mb-4\">🗺️</div>\n        <p class=\"text-lg font-semibold text-slate-500\">No days yet</p>\n        <p class=\"text-sm mt-1\">Click <strong>+ Day</strong> to start building your itinerary.</p>\n      </div>`;\n    return;\n  }\n\n  const dayIdx = selectedDayIdx;\n  const day = trip.days[dayIdx];\n  if (!day) { selectedDayIdx = 0; renderDetail(); return; }\n\n  const label = dayLabel(trip, dayIdx);\n  const sorted = sortActivities(day.activities);\n\n  let html = `\n    <div class=\"max-w-2xl mx-auto px-4 py-6\">\n      <!-- Day heading -->\n      <div class=\"flex items-center justify-between mb-5\">\n        <div>\n          <h2 class=\"text-xl font-bold text-slate-800\">Day ${dayIdx + 1} <span class=\"text-slate-400 font-normal text-base ml-1\">${escapeHtml(label)}</span></h2>\n          <p class=\"text-xs text-slate-400 mt-0.5\">${sorted.length} activit${sorted.length !== 1 ? 'ies' : 'y'}</p>\n        </div>\n        <button onclick=\"addActivity(${dayIdx})\"\n          class=\"px-3 py-1.5 rounded-lg bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold transition-colors flex items-center gap-1\">\n          + Add activity\n        </button>\n      </div>\n\n      <!-- Timeline -->\n      <div class=\"timeline-track\">`;\n\n  if (sorted.length === 0) {\n    html += `\n        <div class=\"ml-12 flex flex-col items-center justify-center py-12 rounded-xl border-2 border-dashed border-slate-200 text-slate-400\">\n          <span class=\"text-3xl mb-2\">🗓️</span>\n          <p class=\"text-sm font-medium\">No activities yet</p>\n          <p class=\"text-xs mt-1\">Hit <strong>+ Add activity</strong> to fill this day.</p>\n        </div>`;\n  } else {\n    sorted.forEach((act, actSortIdx) => {\n      const typeInfo = TYPES[act.type] || TYPES.other;\n      const cssClass = typeCss(act.type);\n      const isFirst = actSortIdx === 0;\n      const isLast  = actSortIdx === sorted.length - 1;\n\n      html += `\n        <!-- Activity -->\n        <div class=\"flex gap-0 mb-4 activity-card\" id=\"card-${escapeHtml(act.id)}\">\n\n          <!-- Dot column -->\n          <div class=\"activity-dot\">\n            <span class=\"text-lg leading-none\" style=\"margin-top:2px;\">${typeInfo.emoji}</span>\n          </div>\n\n          <!-- Card -->\n          <div class=\"flex-1 bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden ml-1\">\n\n            <!-- Card header: summary row -->\n            <div class=\"px-4 py-3 flex items-start gap-3\">\n              <div class=\"flex-1 min-w-0\">\n                <div class=\"flex items-center gap-2 flex-wrap\">\n                  ${act.time ? `<span class=\"text-xs font-mono text-slate-500 bg-slate-100 px-2 py-0.5 rounded\">${escapeHtml(act.time)}</span>` : ''}\n                  <span class=\"cat-pill ${cssClass}\">${typeInfo.emoji} ${typeInfo.label}</span>\n                </div>\n                <p class=\"font-semibold text-slate-800 mt-1 leading-tight ${!act.title ? 'text-slate-400 italic' : ''}\">${act.title ? escapeHtml(act.title) : 'Untitled activity'}</p>\n                ${act.location ? `<p class=\"text-xs text-slate-500 mt-0.5 flex items-center gap-1\"><span>📍</span>${escapeHtml(act.location)}</p>` : ''}\n                ${act.notes ? `<p class=\"text-xs text-slate-500 mt-1 line-clamp-2\">${escapeHtml(act.notes)}</p>` : ''}\n              </div>\n\n              <!-- Action buttons -->\n              <div class=\"flex items-center gap-1 flex-shrink-0 mt-0.5\">\n                <button onclick=\"moveActivityUp(${dayIdx}, '${act.id}')\" title=\"Move up\"\n                  ${isFirst ? 'disabled' : ''}\n                  class=\"p-1 rounded hover:bg-slate-100 text-slate-400 hover:text-slate-600 disabled:opacity-25 disabled:cursor-not-allowed transition-colors text-sm\">▲</button>\n                <button onclick=\"moveActivityDown(${dayIdx}, '${act.id}')\" title=\"Move down\"\n                  ${isLast ? 'disabled' : ''}\n                  class=\"p-1 rounded hover:bg-slate-100 text-slate-400 hover:text-slate-600 disabled:opacity-25 disabled:cursor-not-allowed transition-colors text-sm\">▼</button>\n                <button onclick=\"openMoveModal(${dayIdx}, '${act.id}')\" title=\"Move to another day\"\n                  class=\"p-1 rounded hover:bg-slate-100 text-slate-400 hover:text-blue-600 transition-colors text-sm\" title=\"Move to another day\">↗</button>\n                <button onclick=\"openEditForm(${dayIdx}, '${act.id}')\" title=\"Edit\"\n                  class=\"p-1.5 rounded hover:bg-blue-50 text-slate-400 hover:text-blue-700 transition-colors text-sm\">✏️</button>\n                <button onclick=\"deleteActivity(${dayIdx}, '${act.id}')\" title=\"Delete\"\n                  class=\"p-1.5 rounded hover:bg-red-50 text-slate-400 hover:text-red-600 transition-colors text-sm\">🗑️</button>\n              </div>\n            </div>\n\n            <!-- Inline edit form (hidden by default) -->\n            <div id=\"edit-${act.id}\" class=\"hidden edit-form mx-3 mb-3 px-4 py-3\">\n              <div class=\"grid grid-cols-2 gap-3 mb-3\">\n                <div>\n                  <label class=\"text-xs font-semibold text-slate-500 block mb-1\">Time</label>\n                  <input id=\"f-time-${act.id}\" type=\"time\" value=\"${escapeHtml(act.time)}\"\n                    class=\"w-full border border-slate-200 rounded-lg px-2 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n                </div>\n                <div>\n                  <label class=\"text-xs font-semibold text-slate-500 block mb-1\">Type</label>\n                  <select id=\"f-type-${act.id}\"\n                    class=\"w-full border border-slate-200 rounded-lg px-2 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\">\n                    ${Object.entries(TYPES).map(([k,v]) =>\n                      `<option value=\"${k}\" ${act.type === k ? 'selected' : ''}>${v.emoji} ${v.label}</option>`\n                    ).join('')}\n                  </select>\n                </div>\n              </div>\n              <div class=\"mb-3\">\n                <label class=\"text-xs font-semibold text-slate-500 block mb-1\">Title <span class=\"text-red-400\">*</span></label>\n                <input id=\"f-title-${act.id}\" type=\"text\" value=\"${escapeHtml(act.title)}\" placeholder=\"What are you doing?\"\n                  class=\"w-full border border-slate-200 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n              </div>\n              <div class=\"mb-3\">\n                <label class=\"text-xs font-semibold text-slate-500 block mb-1\">Location</label>\n                <input id=\"f-loc-${act.id}\" type=\"text\" value=\"${escapeHtml(act.location)}\" placeholder=\"Where?\"\n                  class=\"w-full border border-slate-200 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400\" />\n              </div>\n              <div class=\"mb-3\">\n                <label class=\"text-xs font-semibold text-slate-500 block mb-1\">Notes</label>\n                <textarea id=\"f-notes-${act.id}\" rows=\"2\" placeholder=\"Optional notes…\"\n                  class=\"w-full border border-slate-200 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400 resize-none\">${escapeHtml(act.notes)}</textarea>\n              </div>\n              <div class=\"flex gap-2 justify-end\">\n                <button onclick=\"closeEditForm('${act.id}')\"\n                  class=\"px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-600 text-sm font-semibold transition-colors\">Cancel</button>\n                <button onclick=\"saveActivityFromForm(${dayIdx}, '${act.id}')\"\n                  class=\"px-3 py-1.5 rounded-lg bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold transition-colors\">Save</button>\n              </div>\n            </div>\n\n          </div>\n        </div>`;\n    });\n  }\n\n  html += `\n      </div>\n      <!-- Add button at bottom -->\n      <div class=\"mt-4 flex justify-center\">\n        <button onclick=\"addActivity(${dayIdx})\"\n          class=\"px-4 py-2 rounded-xl border-2 border-dashed border-slate-300 hover:border-blue-400 hover:text-blue-600 text-slate-400 text-sm font-medium transition-colors\">\n          + Add activity to Day ${dayIdx + 1}\n        </button>\n      </div>\n    </div>`;\n\n  pane.innerHTML = html;\n}\n\n/* ================================================================\n   INIT\n   ================================================================ */\nfunction initUI() {\n  // Set header inputs from trip\n  const nameEl = document.getElementById('tripName');\n  const dateEl = document.getElementById('startDate');\n  if (nameEl) nameEl.value = trip.name || '';\n  if (dateEl) dateEl.value = trip.startDate || '';\n\n  renderDays();\n  renderDetail();\n  updateSummary();\n}\n\n/* ================================================================\n   BOOT\n   ================================================================ */\nloadTrip();\n// DOM ready\ndocument.addEventListener('DOMContentLoaded', initUI);\n// If DOMContentLoaded already fired (inline script at end of body)\nif (document.readyState !== 'loading') initUI();\n\n/* Close modals on backdrop click */\ndocument.addEventListener('click', function(e) {\n  const resetModal = document.getElementById('resetModal');\n  const moveModal  = document.getElementById('moveModal');\n  if (e.target === resetModal) closeModal();\n  if (e.target === moveModal)  closeMoveModal();\n});\n</script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Itinerary",
    "windowTitle": "Itinerary",
    "bundleId": "com.halisonworks.itinerary",
    "iconPath": null
  },
  "categoryId": null,
  "source": "import",
  "createdAt": "2026-06-02T16:00:00.000Z",
  "updatedAt": "2026-06-02T16:00:00.000Z",
