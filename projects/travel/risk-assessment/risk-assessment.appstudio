{
  "schema": "app-studio/canvas@1",
  "id": "example-risk-assessment",
  "name": "risk-assessment.html",
  "code": "<!DOCTYPE html>\n<!--\n  Risk Assessment — Halison App Studio example\n\n  An HMS-style risk-matrix builder for the Sales, Service and Tourism classroom:\n  rate each hazard by likelihood and consequence, see it land on a colour-coded\n  5x5 matrix, add measures, and watch the residual risk drop. Saves to your\n  browser.\n\n  From the Halison App Studio public library:\n  https://github.com/halisonworks/public-app-studio\n\n  Permitted use: personal, educational, and other non-commercial use. You may\n  modify it, but keep this header and the source link intact, and do not sell,\n  commercialize, or republish it. Released under the Halison App Studio Examples\n  License — see the LICENSE file in the repository above.\n-->\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Risk Assessment</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    * { box-sizing: border-box; }\n    body {\n      font-family: 'Inter', system-ui, -apple-system, sans-serif;\n      background: #f8fafc;\n      margin: 0; padding: 0;\n      min-height: 100vh;\n      overflow-x: hidden;\n    }\n\n    /* ---- Risk zone colours ---- */\n    .zone-low    { background: #22c55e; }\n    .zone-medium { background: #eab308; }\n    .zone-high   { background: #ef4444; }\n    .zone-low-text    { color: #15803d; }\n    .zone-medium-text { color: #854d0e; }\n    .zone-high-text   { color: #991b1b; }\n    .zone-low-bg    { background: #dcfce7; border-color: #86efac; }\n    .zone-medium-bg { background: #fef9c3; border-color: #fde047; }\n    .zone-high-bg   { background: #fee2e2; border-color: #fca5a5; }\n\n    /* ---- Matrix grid ---- */\n    .matrix-grid {\n      display: grid;\n      grid-template-columns: 2.5rem repeat(5, 1fr);\n      grid-template-rows: repeat(5, 1fr) 2rem;\n      gap: 2px;\n      aspect-ratio: 1;\n      max-width: 420px;\n      width: 100%;\n    }\n    .matrix-cell {\n      border-radius: 4px;\n      position: relative;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      min-height: 44px;\n      transition: transform 0.1s;\n    }\n    .matrix-cell:hover { transform: scale(1.05); z-index: 10; }\n    .matrix-axis-label {\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 0.65rem;\n      font-weight: 700;\n      color: #64748b;\n      text-align: center;\n      line-height: 1.1;\n    }\n    .matrix-axis-label.row-label { writing-mode: initial; }\n    .matrix-corner { background: transparent; }\n\n    /* hazard dot */\n    .h-dot {\n      width: 22px; height: 22px;\n      border-radius: 50%;\n      border: 2px solid rgba(255,255,255,0.8);\n      display: flex; align-items: center; justify-content: center;\n      font-size: 0.6rem; font-weight: 700; color: #fff;\n      cursor: pointer;\n      position: absolute;\n      box-shadow: 0 1px 4px rgba(0,0,0,0.25);\n      transition: transform 0.15s;\n      z-index: 5;\n    }\n    .h-dot:hover { transform: scale(1.25); z-index: 20; }\n    .h-dot-multi {\n      font-size: 0.55rem;\n      width: 26px; height: 26px;\n    }\n\n    /* ---- Tabs ---- */\n    .tab-btn {\n      padding: 8px 20px;\n      border-radius: 8px 8px 0 0;\n      font-weight: 600;\n      font-size: 0.875rem;\n      cursor: pointer;\n      border: none;\n      background: transparent;\n      color: #64748b;\n      transition: background 0.15s, color 0.15s;\n    }\n    .tab-btn.active {\n      background: #fff;\n      color: #1e293b;\n      box-shadow: 0 -2px 0 0 #6366f1 inset;\n    }\n    .tab-btn:hover:not(.active) { background: #e2e8f0; color: #334155; }\n\n    /* ---- Cards ---- */\n    .card {\n      background: #fff;\n      border-radius: 12px;\n      border: 1px solid #e2e8f0;\n      padding: 1.25rem;\n    }\n\n    /* ---- Form inputs ---- */\n    input[type=\"text\"], input[type=\"number\"], select, textarea {\n      border: 1.5px solid #cbd5e1;\n      border-radius: 8px;\n      padding: 6px 10px;\n      font-size: 0.875rem;\n      width: 100%;\n      outline: none;\n      background: #fff;\n      transition: border-color 0.15s;\n    }\n    input:focus, select:focus, textarea:focus { border-color: #6366f1; }\n\n    /* ---- Slider ---- */\n    input[type=\"range\"] {\n      -webkit-appearance: none;\n      height: 6px;\n      border-radius: 9999px;\n      background: #e2e8f0;\n      outline: none;\n      width: 100%;\n    }\n    input[type=\"range\"]::-webkit-slider-thumb {\n      -webkit-appearance: none;\n      width: 18px; height: 18px;\n      border-radius: 50%;\n      background: #6366f1;\n      cursor: pointer;\n      border: 2px solid #fff;\n      box-shadow: 0 0 0 2px #6366f1;\n    }\n\n    /* ---- Badge ---- */\n    .risk-badge {\n      display: inline-flex;\n      align-items: center;\n      gap: 4px;\n      padding: 2px 10px;\n      border-radius: 9999px;\n      font-size: 0.75rem;\n      font-weight: 700;\n      border: 1.5px solid transparent;\n    }\n\n    /* ---- Hazard card ---- */\n    .hazard-card {\n      border: 1.5px solid #e2e8f0;\n      border-radius: 10px;\n      background: #fff;\n      transition: border-color 0.15s, box-shadow 0.15s;\n    }\n    .hazard-card:hover { border-color: #a5b4fc; box-shadow: 0 2px 8px rgba(99,102,241,0.08); }\n\n    /* ---- Present mode ---- */\n    #present-overlay {\n      display: none;\n      position: fixed;\n      inset: 0;\n      background: #0f172a;\n      z-index: 100;\n      overflow: auto;\n    }\n    #present-overlay.active { display: flex; flex-direction: column; }\n\n    /* ---- Arrow (initial → residual) ---- */\n    .arrow-indicator {\n      display: inline-flex;\n      align-items: center;\n      gap: 4px;\n      font-size: 0.75rem;\n      font-weight: 600;\n    }\n\n    /* ---- Learn accordions ---- */\n    .learn-section summary {\n      cursor: pointer;\n      list-style: none;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 12px 16px;\n      font-weight: 600;\n      font-size: 0.9rem;\n      color: #1e293b;\n      border-radius: 8px;\n      background: #f8fafc;\n      transition: background 0.15s;\n    }\n    .learn-section summary:hover { background: #f1f5f9; }\n    .learn-section summary::after {\n      content: '▾';\n      font-size: 1rem;\n      color: #94a3b8;\n      transition: transform 0.2s;\n    }\n    .learn-section[open] summary::after { transform: rotate(180deg); }\n    .learn-section summary::-webkit-details-marker { display: none; }\n    .learn-section .learn-body {\n      padding: 14px 16px;\n      font-size: 0.875rem;\n      color: #334155;\n      line-height: 1.7;\n    }\n\n    /* ---- Hierarchy ---- */\n    .hierarchy-item {\n      display: flex;\n      align-items: flex-start;\n      gap: 12px;\n      padding: 10px 0;\n      border-bottom: 1px solid #f1f5f9;\n    }\n    .hierarchy-item:last-child { border-bottom: none; }\n    .hierarchy-num {\n      width: 28px; height: 28px;\n      border-radius: 50%;\n      background: #6366f1;\n      color: #fff;\n      font-weight: 700;\n      font-size: 0.8rem;\n      display: flex; align-items: center; justify-content: center;\n      flex-shrink: 0;\n    }\n\n    /* ---- Tooltip on matrix cell ---- */\n    .cell-tooltip {\n      display: none;\n      position: absolute;\n      bottom: calc(100% + 4px);\n      left: 50%;\n      transform: translateX(-50%);\n      background: #1e293b;\n      color: #fff;\n      font-size: 0.7rem;\n      padding: 4px 8px;\n      border-radius: 6px;\n      white-space: nowrap;\n      z-index: 50;\n      pointer-events: none;\n    }\n    .h-dot:hover .cell-tooltip { display: block; }\n\n    /* ---- Modal ---- */\n    .modal-overlay {\n      display: none;\n      position: fixed;\n      inset: 0;\n      background: rgba(15,23,42,0.6);\n      z-index: 200;\n      align-items: center;\n      justify-content: center;\n    }\n    .modal-overlay.open { display: flex; }\n\n    /* scrollbar thin */\n    ::-webkit-scrollbar { width: 6px; height: 6px; }\n    ::-webkit-scrollbar-track { background: transparent; }\n    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 9999px; }\n\n    /* ---- Empty state ---- */\n    .empty-state { text-align: center; padding: 48px 24px; color: #94a3b8; }\n    .empty-state svg { margin: 0 auto 12px; display: block; }\n\n    /* ---- Measure chip ---- */\n    .measure-chip {\n      display: inline-flex; align-items: center; gap: 4px;\n      background: #ede9fe; color: #5b21b6;\n      border-radius: 9999px;\n      padding: 2px 10px;\n      font-size: 0.72rem;\n      font-weight: 600;\n    }\n\n    /* ---- Responsive present matrix ---- */\n    .present-matrix-grid {\n      display: grid;\n      grid-template-columns: 2rem repeat(5, 1fr);\n      grid-template-rows: repeat(5, 1fr) 2rem;\n      gap: 3px;\n      width: min(480px, 90vw);\n      height: min(480px, 90vw);\n    }\n\n    /* present cell */\n    .present-cell {\n      border-radius: 4px;\n      position: relative;\n      display: flex; align-items: center; justify-content: center;\n    }\n\n    @media (max-width: 640px) {\n      .matrix-grid { max-width: 100%; }\n      .tab-btn { padding: 8px 12px; font-size: 0.8rem; }\n    }\n  </style>\n</head>\n<body>\n\n<!-- ===== PRESENT OVERLAY ===== -->\n<div id=\"present-overlay\" role=\"dialog\" aria-modal=\"true\" aria-label=\"Present mode\">\n  <div class=\"flex items-center justify-between px-6 py-4 border-b border-slate-700\">\n    <div class=\"flex items-center gap-3\">\n      <span class=\"text-2xl font-bold text-white\">Risk Assessment</span>\n      <span class=\"text-slate-400 text-sm font-medium\">Present Mode</span>\n    </div>\n    <button onclick=\"closePresent()\" class=\"text-slate-400 hover:text-white transition-colors text-sm flex items-center gap-2\">\n      <span>ESC to exit</span>\n      <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-5 h-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M6 18L18 6M6 6l12 12\"/></svg>\n    </button>\n  </div>\n  <div class=\"flex flex-col lg:flex-row gap-8 p-6 flex-1 overflow-auto items-start justify-center\">\n    <!-- Matrix -->\n    <div>\n      <p class=\"text-slate-400 text-xs font-semibold uppercase tracking-wider mb-3\">5×5 Risk Matrix</p>\n      <div id=\"present-matrix-container\"></div>\n      <div class=\"flex gap-4 mt-3\">\n        <span class=\"flex items-center gap-1 text-slate-300 text-xs\"><span class=\"w-3 h-3 rounded zone-low inline-block\"></span> Low (1–4)</span>\n        <span class=\"flex items-center gap-1 text-slate-300 text-xs\"><span class=\"w-3 h-3 rounded zone-medium inline-block\"></span> Medium (5–12)</span>\n        <span class=\"flex items-center gap-1 text-slate-300 text-xs\"><span class=\"w-3 h-3 rounded zone-high inline-block\"></span> High (15–25)</span>\n      </div>\n    </div>\n    <!-- Top risks -->\n    <div class=\"flex-1 min-w-0\" style=\"max-width:420px\">\n      <p class=\"text-slate-400 text-xs font-semibold uppercase tracking-wider mb-3\">Top Risks (sorted by initial score)</p>\n      <div id=\"present-risk-list\" class=\"space-y-2\"></div>\n    </div>\n  </div>\n</div>\n\n<!-- ===== RESET MODAL ===== -->\n<div id=\"reset-modal\" class=\"modal-overlay\">\n  <div class=\"card max-w-sm w-full mx-4\" style=\"border-radius:16px;\">\n    <div class=\"flex items-center gap-3 mb-3\">\n      <span class=\"text-2xl\">⚠️</span>\n      <h3 class=\"font-bold text-lg text-slate-800\">Reset all hazards?</h3>\n    </div>\n    <p class=\"text-slate-500 text-sm mb-5\">This will permanently delete all hazards and measures and restore the three seeded examples. This cannot be undone.</p>\n    <div class=\"flex gap-3 justify-end\">\n      <button onclick=\"closeResetModal()\" class=\"px-4 py-2 rounded-lg border border-slate-200 text-slate-600 text-sm font-semibold hover:bg-slate-50 transition-colors\">Cancel</button>\n      <button onclick=\"confirmReset()\" class=\"px-4 py-2 rounded-lg bg-red-500 hover:bg-red-600 text-white text-sm font-semibold transition-colors\">Reset</button>\n    </div>\n  </div>\n</div>\n\n<!-- ===== HAZARD EDIT MODAL ===== -->\n<div id=\"edit-modal\" class=\"modal-overlay\">\n  <div class=\"card w-full mx-4 overflow-y-auto\" style=\"max-width:560px; max-height:90vh; border-radius:16px;\">\n    <div class=\"flex items-center justify-between mb-4\">\n      <h3 id=\"edit-modal-title\" class=\"font-bold text-lg text-slate-800\">Edit Hazard</h3>\n      <button onclick=\"closeEditModal()\" class=\"text-slate-400 hover:text-slate-700\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-5 h-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M6 18L18 6M6 6l12 12\"/></svg>\n      </button>\n    </div>\n    <form id=\"edit-form\" onsubmit=\"saveHazard(event)\">\n      <div class=\"space-y-4\">\n        <div>\n          <label class=\"block text-xs font-semibold text-slate-600 mb-1\">Hazard / risk description *</label>\n          <input type=\"text\" id=\"ef-name\" placeholder=\"e.g. Slippery hotel lobby floor\" required maxlength=\"100\" />\n        </div>\n        <div>\n          <label class=\"block text-xs font-semibold text-slate-600 mb-1\">Area / location</label>\n          <input type=\"text\" id=\"ef-area\" placeholder=\"e.g. Hotel lobby, Reception, Tour bus\" maxlength=\"60\" />\n        </div>\n        <div class=\"grid grid-cols-2 gap-4\">\n          <div>\n            <label class=\"block text-xs font-semibold text-slate-600 mb-2\">\n              Likelihood: <span id=\"ef-l-val\" class=\"text-indigo-600\">—</span>\n            </label>\n            <input type=\"range\" id=\"ef-likelihood\" min=\"1\" max=\"5\" value=\"2\"\n              oninput=\"updateSliderLabels()\" />\n            <div class=\"flex justify-between text-xs text-slate-400 mt-1\">\n              <span>1 Very unlikely</span><span>5 Almost certain</span>\n            </div>\n          </div>\n          <div>\n            <label class=\"block text-xs font-semibold text-slate-600 mb-2\">\n              Consequence: <span id=\"ef-c-val\" class=\"text-indigo-600\">—</span>\n            </label>\n            <input type=\"range\" id=\"ef-consequence\" min=\"1\" max=\"5\" value=\"2\"\n              oninput=\"updateSliderLabels()\" />\n            <div class=\"flex justify-between text-xs text-slate-400 mt-1\">\n              <span>1 Negligible</span><span>5 Catastrophic</span>\n            </div>\n          </div>\n        </div>\n        <!-- Preview score -->\n        <div id=\"ef-score-preview\" class=\"p-3 rounded-lg border text-sm font-semibold text-center transition-all\"></div>\n        <!-- Measures -->\n        <div class=\"border-t pt-4\">\n          <label class=\"block text-xs font-semibold text-slate-600 mb-1\">Measures (one per line)</label>\n          <textarea id=\"ef-measures\" rows=\"3\" placeholder=\"e.g. Anti-slip mats installed&#10;Wet floor signs used&#10;Staff briefing on spill protocol\" style=\"resize:vertical;\"></textarea>\n          <p class=\"text-xs text-slate-400 mt-1\">Describe what controls are in place or planned.</p>\n        </div>\n        <!-- Residual -->\n        <div id=\"residual-section\" class=\"space-y-3\">\n          <p class=\"text-xs font-semibold text-slate-600 uppercase tracking-wide\">Residual risk after measures</p>\n          <div class=\"grid grid-cols-2 gap-4\">\n            <div>\n              <label class=\"block text-xs font-semibold text-slate-600 mb-2\">\n                Residual likelihood: <span id=\"ef-rl-val\" class=\"text-purple-600\">—</span>\n              </label>\n              <input type=\"range\" id=\"ef-r-likelihood\" min=\"1\" max=\"5\" value=\"2\"\n                oninput=\"updateSliderLabels()\" />\n            </div>\n            <div>\n              <label class=\"block text-xs font-semibold text-slate-600 mb-2\">\n                Residual consequence: <span id=\"ef-rc-val\" class=\"text-purple-600\">—</span>\n              </label>\n              <input type=\"range\" id=\"ef-r-consequence\" min=\"1\" max=\"5\" value=\"2\"\n                oninput=\"updateSliderLabels()\" />\n            </div>\n          </div>\n          <div id=\"ef-residual-preview\" class=\"p-3 rounded-lg border text-sm font-semibold text-center transition-all\"></div>\n        </div>\n      </div>\n      <div class=\"flex justify-end gap-3 mt-6\">\n        <button type=\"button\" onclick=\"closeEditModal()\" class=\"px-4 py-2 rounded-lg border border-slate-200 text-slate-600 text-sm font-semibold hover:bg-slate-50 transition-colors\">Cancel</button>\n        <button type=\"submit\" class=\"px-5 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold transition-colors\">Save hazard</button>\n      </div>\n    </form>\n  </div>\n</div>\n\n<!-- ===== MAIN APP ===== -->\n<div class=\"min-h-screen flex flex-col\">\n  <!-- Header -->\n  <header class=\"bg-white border-b border-slate-200 px-4 sm:px-6 py-3 flex items-center justify-between flex-wrap gap-3\">\n    <div class=\"flex items-center gap-3\">\n      <div class=\"w-9 h-9 rounded-lg bg-indigo-600 flex items-center justify-center flex-shrink-0\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-5 h-5 text-white\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z\"/>\n        </svg>\n      </div>\n      <div>\n        <h1 class=\"font-bold text-slate-800 text-base leading-tight\">Risk Assessment</h1>\n        <p class=\"text-xs text-slate-500\">Sales, Service &amp; Tourism · HMS</p>\n      </div>\n    </div>\n    <div class=\"flex items-center gap-2\">\n      <button onclick=\"openPresent()\" class=\"flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-900 text-white text-xs font-semibold transition-colors\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-3.5 h-3.5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z\"/></svg>\n        Present\n      </button>\n      <button onclick=\"openResetModal()\" class=\"px-3 py-1.5 rounded-lg border border-slate-200 text-slate-500 text-xs font-semibold hover:bg-slate-50 transition-colors\">Reset</button>\n    </div>\n  </header>\n\n  <!-- Tabs -->\n  <div class=\"bg-slate-100 border-b border-slate-200 px-4 sm:px-6 pt-3 flex gap-1\">\n    <button class=\"tab-btn active\" id=\"tab-learn\" onclick=\"switchTab('learn')\">Learn</button>\n    <button class=\"tab-btn\" id=\"tab-practice\" onclick=\"switchTab('practice')\">Practice</button>\n  </div>\n\n  <!-- Tab panels -->\n  <div class=\"flex-1 overflow-auto\">\n\n    <!-- ============= LEARN TAB ============= -->\n    <div id=\"panel-learn\" class=\"max-w-3xl mx-auto px-4 sm:px-6 py-6 space-y-4\">\n\n      <!-- Hero -->\n      <div class=\"card\">\n        <div class=\"flex items-start gap-4\">\n          <div class=\"text-4xl flex-shrink-0\">🛡️</div>\n          <div>\n            <h2 class=\"font-bold text-xl text-slate-800 mb-1\">What is Risk Assessment?</h2>\n            <p class=\"text-slate-600 text-sm leading-relaxed\">\n              In <strong>Health, Safety and Environment (HMS)</strong> work, a risk assessment helps you identify hazards, understand how dangerous they are, and decide what to do about them. The classic formula is:\n            </p>\n            <div class=\"mt-3 inline-flex items-center gap-2 bg-indigo-50 border border-indigo-200 rounded-lg px-4 py-2\">\n              <span class=\"text-indigo-700 font-mono font-bold text-base\">Risk = Likelihood × Consequence</span>\n            </div>\n            <p class=\"text-slate-600 text-sm mt-3 leading-relaxed\">\n              A rare event with a <em>catastrophic</em> outcome can still carry <em>high</em> risk — the matrix makes this visible.\n              After you add control measures, you re-score the hazard to get the <strong>residual risk</strong>.\n            </p>\n          </div>\n        </div>\n      </div>\n\n      <!-- Scales -->\n      <details class=\"learn-section card p-0 overflow-hidden\" open>\n        <summary>The 1–5 Scales: Likelihood and Consequence</summary>\n        <div class=\"learn-body\">\n          <div class=\"grid sm:grid-cols-2 gap-4\">\n            <div>\n              <p class=\"font-semibold text-slate-700 mb-2\">Likelihood (probability)</p>\n              <div class=\"space-y-1.5\">\n                <div class=\"flex items-center gap-2\"><span class=\"w-6 h-6 rounded bg-green-100 text-green-700 flex items-center justify-center text-xs font-bold flex-shrink-0\">1</span><span class=\"text-sm\"><strong>Very unlikely</strong> — Could happen but rarely does (e.g. once every few years)</span></div>\n                <div class=\"flex items-center gap-2\"><span class=\"w-6 h-6 rounded bg-lime-100 text-lime-700 flex items-center justify-center text-xs font-bold flex-shrink-0\">2</span><span class=\"text-sm\"><strong>Unlikely</strong> — Known to happen occasionally</span></div>\n                <div class=\"flex items-center gap-2\"><span class=\"w-6 h-6 rounded bg-yellow-100 text-yellow-700 flex items-center justify-center text-xs font-bold flex-shrink-0\">3</span><span class=\"text-sm\"><strong>Possible</strong> — Could happen; similar events are known</span></div>\n                <div class=\"flex items-center gap-2\"><span class=\"w-6 h-6 rounded bg-orange-100 text-orange-700 flex items-center justify-center text-xs font-bold flex-shrink-0\">4</span><span class=\"text-sm\"><strong>Likely</strong> — Will probably happen; has happened before</span></div>\n                <div class=\"flex items-center gap-2\"><span class=\"w-6 h-6 rounded bg-red-100 text-red-700 flex items-center justify-center text-xs font-bold flex-shrink-0\">5</span><span class=\"text-sm\"><strong>Almost certain</strong> — Expected to happen repeatedly</span></div>\n              </div>\n            </div>\n            <div>\n              <p class=\"font-semibold text-slate-700 mb-2\">Consequence (severity)</p>\n              <div class=\"space-y-1.5\">\n                <div class=\"flex items-center gap-2\"><span class=\"w-6 h-6 rounded bg-green-100 text-green-700 flex items-center justify-center text-xs font-bold flex-shrink-0\">1</span><span class=\"text-sm\"><strong>Negligible</strong> — No injury; minor inconvenience</span></div>\n                <div class=\"flex items-center gap-2\"><span class=\"w-6 h-6 rounded bg-lime-100 text-lime-700 flex items-center justify-center text-xs font-bold flex-shrink-0\">2</span><span class=\"text-sm\"><strong>Minor</strong> — First-aid treatment; slight disruption</span></div>\n                <div class=\"flex items-center gap-2\"><span class=\"w-6 h-6 rounded bg-yellow-100 text-yellow-700 flex items-center justify-center text-xs font-bold flex-shrink-0\">3</span><span class=\"text-sm\"><strong>Moderate</strong> — Medical treatment; temporary harm</span></div>\n                <div class=\"flex items-center gap-2\"><span class=\"w-6 h-6 rounded bg-orange-100 text-orange-700 flex items-center justify-center text-xs font-bold flex-shrink-0\">4</span><span class=\"text-sm\"><strong>Serious</strong> — Hospitalisation; lasting injury</span></div>\n                <div class=\"flex items-center gap-2\"><span class=\"w-6 h-6 rounded bg-red-100 text-red-700 flex items-center justify-center text-xs font-bold flex-shrink-0\">5</span><span class=\"text-sm\"><strong>Catastrophic</strong> — Death or permanent severe disability</span></div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </details>\n\n      <!-- Matrix explanation -->\n      <details class=\"learn-section card p-0 overflow-hidden\" open>\n        <summary>The 5×5 Matrix &amp; Risk Zones</summary>\n        <div class=\"learn-body\">\n          <p class=\"mb-3\">Multiply Likelihood × Consequence to get the risk <strong>score</strong> (1–25). The score falls into one of three zones:</p>\n          <div class=\"flex flex-col sm:flex-row gap-3 mb-4\">\n            <div class=\"flex-1 zone-low-bg border rounded-lg p-3 text-center\">\n              <div class=\"font-bold zone-low-text text-base\">Low</div>\n              <div class=\"zone-low-text text-xs font-semibold\">Score 1–4</div>\n              <div class=\"text-slate-600 text-xs mt-1\">Acceptable. Monitor and maintain controls.</div>\n            </div>\n            <div class=\"flex-1 zone-medium-bg border rounded-lg p-3 text-center\">\n              <div class=\"font-bold zone-medium-text text-base\">Medium</div>\n              <div class=\"zone-medium-text text-xs font-semibold\">Score 5–12</div>\n              <div class=\"text-slate-600 text-xs mt-1\">Act to reduce risk. Assign responsibility &amp; deadline.</div>\n            </div>\n            <div class=\"flex-1 zone-high-bg border rounded-lg p-3 text-center\">\n              <div class=\"font-bold zone-high-text text-base\">High</div>\n              <div class=\"zone-high-text text-xs font-semibold\">Score 15–25</div>\n              <div class=\"text-slate-600 text-xs mt-1\">Immediate action required or stop the activity.</div>\n            </div>\n          </div>\n          <p class=\"text-xs text-slate-500\">Note: score 13 and 14 don't exist in this scale (4×4=16, so products jump from 12 to 15). The banding is: 1–4 = Low, 5–12 = Medium, 15–25 = High.</p>\n        </div>\n      </details>\n\n      <!-- Hierarchy -->\n      <details class=\"learn-section card p-0 overflow-hidden\">\n        <summary>Hierarchy of Measures</summary>\n        <div class=\"learn-body\">\n          <p class=\"mb-3\">When you choose controls to reduce risk, always try the most effective options first. Work down this hierarchy:</p>\n          <div>\n            <div class=\"hierarchy-item\">\n              <div class=\"hierarchy-num\">1</div>\n              <div><strong class=\"text-slate-800\">Eliminate</strong> — Remove the hazard entirely. Can you stop doing the task, or change the process so the hazard no longer exists?</div>\n            </div>\n            <div class=\"hierarchy-item\">\n              <div class=\"hierarchy-num\" style=\"background:#8b5cf6\">2</div>\n              <div><strong class=\"text-slate-800\">Substitute</strong> — Replace the hazard with something less dangerous (e.g. swap a chemical cleaner for a safer product).</div>\n            </div>\n            <div class=\"hierarchy-item\">\n              <div class=\"hierarchy-num\" style=\"background:#0891b2\">3</div>\n              <div><strong class=\"text-slate-800\">Technical / Engineering</strong> — Add physical barriers, guards, improved drainage, ventilation or other engineered controls.</div>\n            </div>\n            <div class=\"hierarchy-item\">\n              <div class=\"hierarchy-num\" style=\"background:#d97706\">4</div>\n              <div><strong class=\"text-slate-800\">Administrative / Procedures</strong> — Safe work instructions, training, supervision, signage, shift limits, lone-worker check-ins.</div>\n            </div>\n            <div class=\"hierarchy-item\">\n              <div class=\"hierarchy-num\" style=\"background:#64748b\">5</div>\n              <div><strong class=\"text-slate-800\">PPE</strong> — Personal Protective Equipment (gloves, hi-vis, hard hat). Always the <em>last resort</em> — it doesn't remove the hazard.</div>\n            </div>\n          </div>\n          <p class=\"text-xs text-slate-500 mt-3\">Measures reduce <em>likelihood</em> (e.g. training, barriers) and/or <em>consequence</em> (e.g. PPE, emergency procedures). After measures, re-score to find the <strong>residual risk</strong>.</p>\n        </div>\n      </details>\n\n      <!-- Worked examples -->\n      <details class=\"learn-section card p-0 overflow-hidden\">\n        <summary>Worked Examples from Travel &amp; Service</summary>\n        <div class=\"learn-body space-y-4\">\n\n          <div class=\"border rounded-lg p-4 bg-slate-50\">\n            <p class=\"font-semibold text-slate-800 mb-2\">🏨 Slippery hotel lobby floor</p>\n            <div class=\"grid sm:grid-cols-3 gap-2 text-sm\">\n              <div><span class=\"text-xs font-semibold text-slate-500 block\">Initial risk</span>Likelihood 4 × Consequence 3 = <strong class=\"zone-medium-text\">12 Medium</strong></div>\n              <div><span class=\"text-xs font-semibold text-slate-500 block\">Measures</span>Anti-slip matting (technical), wet floor signs (admin), staff spill-response procedure (admin)</div>\n              <div><span class=\"text-xs font-semibold text-slate-500 block\">Residual risk</span>Likelihood 2 × Consequence 3 = <strong class=\"zone-low-text\">6 Medium → 2×2=4 Low after further improvement</strong></div>\n            </div>\n          </div>\n\n          <div class=\"border rounded-lg p-4 bg-slate-50\">\n            <p class=\"font-semibold text-slate-800 mb-2\">🌙 Lone worker at reception overnight</p>\n            <div class=\"grid sm:grid-cols-3 gap-2 text-sm\">\n              <div><span class=\"text-xs font-semibold text-slate-500 block\">Initial risk</span>Likelihood 2 × Consequence 4 = <strong class=\"zone-medium-text\">8 Medium</strong></div>\n              <div><span class=\"text-xs font-semibold text-slate-500 block\">Measures</span>Regular check-in procedure (admin), panic button / duress alarm (technical), CCTV (technical)</div>\n              <div><span class=\"text-xs font-semibold text-slate-500 block\">Residual risk</span>Likelihood 2 × Consequence 2 = <strong class=\"zone-low-text\">4 Low</strong></div>\n            </div>\n          </div>\n\n          <div class=\"border rounded-lg p-4 bg-slate-50\">\n            <p class=\"font-semibold text-slate-800 mb-2\">🌿 Guest allergic reaction on a tour</p>\n            <div class=\"grid sm:grid-cols-3 gap-2 text-sm\">\n              <div><span class=\"text-xs font-semibold text-slate-500 block\">Initial risk</span>Likelihood 2 × Consequence 5 = <strong class=\"zone-high-text\">10 Medium (close to High)</strong></div>\n              <div><span class=\"text-xs font-semibold text-slate-500 block\">Measures</span>Pre-tour allergy questionnaire (admin), guide carries EpiPen (PPE/admin), first-aid trained guide (admin)</div>\n              <div><span class=\"text-xs font-semibold text-slate-500 block\">Residual risk</span>Likelihood 1 × Consequence 4 = <strong class=\"zone-medium-text\">4 Low</strong></div>\n            </div>\n          </div>\n        </div>\n      </details>\n\n      <div class=\"text-center pb-4\">\n        <button onclick=\"switchTab('practice')\" class=\"px-5 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold transition-colors\">\n          Go to Practice →\n        </button>\n      </div>\n    </div>\n\n    <!-- ============= PRACTICE TAB ============= -->\n    <div id=\"panel-practice\" class=\"hidden\">\n      <div class=\"max-w-6xl mx-auto px-4 sm:px-6 py-6\">\n        <div class=\"flex flex-col xl:flex-row gap-6\">\n\n          <!-- LEFT: Matrix + register -->\n          <div class=\"flex-1 min-w-0 space-y-5\">\n\n            <!-- Matrix card -->\n            <div class=\"card\">\n              <div class=\"flex items-center justify-between mb-3\">\n                <h2 class=\"font-bold text-slate-800\">Risk Matrix</h2>\n                <div class=\"flex gap-3 text-xs text-slate-500\">\n                  <span class=\"flex items-center gap-1\"><span class=\"w-3 h-3 rounded zone-low inline-block\"></span>Low</span>\n                  <span class=\"flex items-center gap-1\"><span class=\"w-3 h-3 rounded zone-medium inline-block\"></span>Medium</span>\n                  <span class=\"flex items-center gap-1\"><span class=\"w-3 h-3 rounded zone-high inline-block\"></span>High</span>\n                </div>\n              </div>\n              <!-- Legend helper -->\n              <div class=\"flex gap-4 mb-3\">\n                <span class=\"flex items-center gap-1.5 text-xs text-slate-500\">\n                  <span class=\"w-4 h-4 rounded-full bg-indigo-500 border-2 border-white inline-block\" style=\"box-shadow:0 0 0 2px #6366f1\"></span>Initial risk\n                </span>\n                <span class=\"flex items-center gap-1.5 text-xs text-slate-500\">\n                  <span class=\"w-4 h-4 rounded-full bg-purple-400 border-2 border-white inline-block opacity-80\" style=\"box-shadow:0 0 0 2px #a855f7\"></span>Residual risk\n                </span>\n              </div>\n              <div id=\"matrix-container\" class=\"flex justify-center\">\n                <!-- matrix rendered by JS -->\n              </div>\n            </div>\n\n            <!-- Hazard register -->\n            <div class=\"card\">\n              <div class=\"flex items-center justify-between mb-3 flex-wrap gap-2\">\n                <h2 class=\"font-bold text-slate-800\">Hazard Register</h2>\n                <span class=\"text-xs text-slate-400\">Sorted highest risk first</span>\n              </div>\n              <div id=\"hazard-register\"></div>\n            </div>\n          </div>\n\n          <!-- RIGHT: Add hazard panel -->\n          <div class=\"xl:w-80 flex-shrink-0\">\n            <div class=\"card sticky top-4\">\n              <h2 class=\"font-bold text-slate-800 mb-4\">Add Hazard</h2>\n              <div class=\"space-y-3\">\n                <div>\n                  <label class=\"block text-xs font-semibold text-slate-600 mb-1\">Hazard / risk *</label>\n                  <input type=\"text\" id=\"add-name\" placeholder=\"e.g. Wet tour bus steps\" maxlength=\"100\" />\n                </div>\n                <div>\n                  <label class=\"block text-xs font-semibold text-slate-600 mb-1\">Area / location</label>\n                  <input type=\"text\" id=\"add-area\" placeholder=\"e.g. Bus entrance\" maxlength=\"60\" />\n                </div>\n                <div>\n                  <label class=\"block text-xs font-semibold text-slate-600 mb-2\">\n                    Likelihood: <span id=\"add-l-val\" class=\"text-indigo-600 font-bold\">—</span>\n                  </label>\n                  <input type=\"range\" id=\"add-likelihood\" min=\"1\" max=\"5\" value=\"2\" oninput=\"updateAddSliders()\" />\n                  <div class=\"flex justify-between text-xs text-slate-400 mt-0.5\">\n                    <span>1 Very unlikely</span><span>5 Almost certain</span>\n                  </div>\n                </div>\n                <div>\n                  <label class=\"block text-xs font-semibold text-slate-600 mb-2\">\n                    Consequence: <span id=\"add-c-val\" class=\"text-indigo-600 font-bold\">—</span>\n                  </label>\n                  <input type=\"range\" id=\"add-consequence\" min=\"1\" max=\"5\" value=\"2\" oninput=\"updateAddSliders()\" />\n                  <div class=\"flex justify-between text-xs text-slate-400 mt-0.5\">\n                    <span>1 Negligible</span><span>5 Catastrophic</span>\n                  </div>\n                </div>\n                <div id=\"add-score-preview\" class=\"p-3 rounded-lg border text-sm font-semibold text-center transition-all\"></div>\n                <button onclick=\"addHazard()\" class=\"w-full py-2.5 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold transition-colors\">\n                  + Add to register\n                </button>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n  </div><!-- end tab panels -->\n</div><!-- end main app -->\n\n<script>\n// ============================================================\n// DATA MODEL\n// ============================================================\nconst STORAGE_KEY = 'halisonRiskAssessment_v1';\n\nconst SEED_HAZARDS = [\n  {\n    id: 'seed-1',\n    name: 'Slippery hotel lobby floor',\n    area: 'Hotel lobby',\n    likelihood: 4,\n    consequence: 3,\n    measures: 'Anti-slip matting installed at entrance\\nWet floor signs deployed during cleaning\\nStaff spill-response procedure in place',\n    rLikelihood: 2,\n    rConsequence: 3\n  },\n  {\n    id: 'seed-2',\n    name: 'Lone worker at reception overnight',\n    area: 'Reception desk',\n    likelihood: 2,\n    consequence: 4,\n    measures: 'Regular 2-hour check-in with duty manager\\nPanic button / duress alarm installed\\nCCTV coverage of all entrances',\n    rLikelihood: 2,\n    rConsequence: 2\n  },\n  {\n    id: 'seed-3',\n    name: 'Guest allergic reaction on guided tour',\n    area: 'Tour (outdoor)',\n    likelihood: 2,\n    consequence: 5,\n    measures: 'Pre-tour allergy questionnaire for all guests\\nTour guide carries EpiPen and first-aid kit\\nGuide holds current first-aid certificate',\n    rLikelihood: 1,\n    rConsequence: 4\n  }\n];\n\nfunction loadHazards() {\n  try {\n    const raw = localStorage.getItem(STORAGE_KEY);\n    if (raw) {\n      const data = JSON.parse(raw);\n      if (Array.isArray(data) && data.length > 0) return data;\n    }\n  } catch(e) {}\n  return JSON.parse(JSON.stringify(SEED_HAZARDS));\n}\n\nfunction saveHazards() {\n  localStorage.setItem(STORAGE_KEY, JSON.stringify(hazards));\n}\n\nlet hazards = loadHazards();\n\n// ============================================================\n// SCORING\n// ============================================================\nfunction score(l, c) { return l * c; }\n\nfunction zone(s) {\n  if (s <= 4) return 'low';\n  if (s <= 12) return 'medium';\n  return 'high';\n}\n\nfunction zoneLabel(s) {\n  const z = zone(s);\n  return z.charAt(0).toUpperCase() + z.slice(1);\n}\n\nfunction zoneBadgeClass(s) {\n  const z = zone(s);\n  if (z === 'low') return 'zone-low-bg zone-low-text';\n  if (z === 'medium') return 'zone-medium-bg zone-medium-text';\n  return 'zone-high-bg zone-high-text';\n}\n\nfunction zoneDotBg(s) {\n  const z = zone(s);\n  if (z === 'low') return '#22c55e';\n  if (z === 'medium') return '#eab308';\n  return '#ef4444';\n}\n\nconst LIKELIHOOD_LABELS = ['', 'Very unlikely', 'Unlikely', 'Possible', 'Likely', 'Almost certain'];\nconst CONSEQUENCE_LABELS = ['', 'Negligible', 'Minor', 'Moderate', 'Serious', 'Catastrophic'];\n\n// ============================================================\n// MATRIX CELL COLOURS\n// ============================================================\nfunction cellZone(l, c) {\n  // l = likelihood row (1=bottom), c = consequence col (1=left)\n  return zone(l * c);\n}\n\nfunction cellBg(l, c) {\n  const z = cellZone(l, c);\n  if (z === 'low') return '#bbf7d0';\n  if (z === 'medium') return '#fef08a';\n  return '#fecaca';\n}\n\n// ============================================================\n// RENDER MATRIX\n// ============================================================\nfunction buildMatrix(containerId, small) {\n  const container = document.getElementById(containerId);\n  if (!container) return;\n\n  // Build grid: rows=likelihood 5→1 (top=5), cols=consequence 1→5\n  let html = '';\n  const clsGrid = small ? 'present-matrix-grid' : 'matrix-grid';\n  html += `<div class=\"${clsGrid}\">`;\n\n  // Rows: likelihood 5 down to 1\n  for (let l = 5; l >= 1; l--) {\n    // Row label\n    html += `<div class=\"matrix-axis-label row-label\" style=\"font-size:0.6rem;line-height:1;text-align:right;padding-right:3px;color:${small?'#94a3b8':'#64748b'}\">${l}<br><span style=\"font-size:0.5rem\">${LIKELIHOOD_LABELS[l].split(' ')[0]}</span></div>`;\n    // Cells: consequence 1→5\n    for (let c = 1; c <= 5; c++) {\n      const s = l * c;\n      const bg = cellBg(l, c);\n      const cellId = small ? '' : `id=\"cell-${l}-${c}\"`;\n      const cellCls = small ? 'present-cell' : 'matrix-cell';\n      html += `<div ${cellId} class=\"${cellCls}\" style=\"background:${bg};\" data-l=\"${l}\" data-c=\"${c}\">`;\n      // Score label (small)\n      if (!small) {\n        html += `<span style=\"font-size:0.6rem;color:rgba(0,0,0,0.25);font-weight:700;pointer-events:none;user-select:none\">${s}</span>`;\n      }\n      // Hazard dots inserted by JS\n      html += `</div>`;\n    }\n  }\n\n  // Bottom row: consequence labels\n  html += `<div class=\"matrix-axis-label\" style=\"font-size:0.55rem;color:${small?'#94a3b8':'#64748b'}\">Con↓<br>Like→</div>`;\n  for (let c = 1; c <= 5; c++) {\n    html += `<div class=\"matrix-axis-label\" style=\"font-size:0.6rem;color:${small?'#94a3b8':'#64748b'};line-height:1\">${c}<br><span style=\"font-size:0.5rem\">${CONSEQUENCE_LABELS[c].split(' ')[0]}</span></div>`;\n  }\n\n  html += `</div>`;\n\n  // Axis titles\n  if (!small) {\n    html = `\n      <div style=\"display:flex;flex-direction:column;align-items:center;gap:2px;width:100%\">\n        <div style=\"writing-mode:vertical-lr;transform:rotate(180deg);font-size:0.65rem;font-weight:700;color:#64748b;letter-spacing:0.05em;margin-bottom:4px;align-self:flex-start;margin-left:0\">LIKELIHOOD →</div>\n        <div style=\"display:flex;align-items:flex-end;gap:2px;width:100%\">\n          ${html}\n        </div>\n        <div style=\"font-size:0.65rem;font-weight:700;color:#64748b;letter-spacing:0.05em;margin-top:2px\">CONSEQUENCE →</div>\n      </div>`;\n  }\n\n  container.innerHTML = html;\n  plotDots(containerId, small);\n}\n\nfunction plotDots(containerId, small) {\n  // Clear existing dots\n  const container = document.getElementById(containerId);\n  if (!container) return;\n  container.querySelectorAll('.h-dot').forEach(el => el.remove());\n\n  if (small) {\n    // For present mode: find cells by position\n    plotDotsPresent(containerId);\n    return;\n  }\n\n  // Group hazards by initial cell\n  const cellMap = {};\n  hazards.forEach(h => {\n    const key = `${h.likelihood}-${h.consequence}`;\n    if (!cellMap[key]) cellMap[key] = [];\n    cellMap[key].push(h);\n  });\n\n  Object.entries(cellMap).forEach(([key, hs]) => {\n    const [l, c] = key.split('-').map(Number);\n    const cellEl = document.getElementById(`cell-${l}-${c}`);\n    if (!cellEl) return;\n\n    const count = hs.length;\n    hs.forEach((h, idx) => {\n      const initScore = score(h.likelihood, h.consequence);\n      const dot = document.createElement('div');\n      dot.className = 'h-dot' + (count > 1 ? ' h-dot-multi' : '');\n      dot.style.background = '#6366f1';\n      dot.style.border = '2px solid rgba(255,255,255,0.85)';\n      // Offset multiple dots\n      if (count > 1) {\n        const angle = (idx / count) * 2 * Math.PI;\n        const r = 8;\n        dot.style.transform = `translate(${Math.cos(angle)*r}px, ${Math.sin(angle)*r}px)`;\n      }\n      dot.title = h.name;\n      dot.innerHTML = `<span class=\"cell-tooltip\">${h.name}</span>${count > 1 ? count : ''}`;\n      dot.onclick = (e) => { e.stopPropagation(); openEditModal(h.id); };\n      cellEl.appendChild(dot);\n\n      // Residual dot (if measures exist and residual ≠ initial)\n      const rL = h.rLikelihood || h.likelihood;\n      const rC = h.rConsequence || h.consequence;\n      if (rL !== h.likelihood || rC !== h.consequence) {\n        const rScore = score(rL, rC);\n        const rCellEl = document.getElementById(`cell-${rL}-${rC}`);\n        if (rCellEl) {\n          const rDot = document.createElement('div');\n          rDot.className = 'h-dot';\n          rDot.style.background = '#a855f7';\n          rDot.style.border = '2px solid rgba(255,255,255,0.85)';\n          rDot.style.opacity = '0.75';\n          rDot.style.width = '16px';\n          rDot.style.height = '16px';\n          rDot.innerHTML = `<span class=\"cell-tooltip\">${h.name} (residual)</span>`;\n          rDot.onclick = (e) => { e.stopPropagation(); openEditModal(h.id); };\n          rCellEl.appendChild(rDot);\n        }\n      }\n    });\n  });\n}\n\nfunction plotDotsPresent(containerId) {\n  const container = document.getElementById(containerId);\n  if (!container) return;\n  const grid = container.querySelector('.present-matrix-grid');\n  if (!grid) return;\n\n  // cells: grid children; layout: col0=labels, col1-5=consequence 1-5; row0-4=likelihood 5-1, row5=labels\n  hazards.forEach(h => {\n    const l = h.likelihood;\n    const c = h.consequence;\n    // row index: l=5 → row 0, l=1 → row 4\n    const rowIdx = 5 - l;\n    // col index: c=1 → col 1\n    const colIdx = c;\n    // grid is 6 cols × 6 rows\n    const cellIdx = rowIdx * 6 + colIdx;\n    const cells = grid.querySelectorAll('.present-cell');\n    // cells array maps only to present-cells (not axis divs), rebuild mapping\n    const allChildren = Array.from(grid.children);\n    // row rowIdx, col colIdx (0-indexed in 6-col grid)\n    const linearIdx = rowIdx * 6 + colIdx;\n    const cellEl = allChildren[linearIdx];\n    if (!cellEl) return;\n\n    const dot = document.createElement('div');\n    dot.style.cssText = 'width:14px;height:14px;border-radius:50%;background:#6366f1;border:2px solid rgba(255,255,255,0.9);position:absolute;z-index:5;';\n    dot.title = h.name;\n    cellEl.style.position = 'relative';\n    cellEl.appendChild(dot);\n  });\n}\n\n// ============================================================\n// RENDER HAZARD REGISTER\n// ============================================================\nfunction renderRegister() {\n  const el = document.getElementById('hazard-register');\n  if (!el) return;\n\n  if (hazards.length === 0) {\n    el.innerHTML = `\n      <div class=\"empty-state\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-12 h-12 text-slate-300\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" d=\"M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z\"/>\n        </svg>\n        <p class=\"font-semibold text-slate-400 mt-2\">No hazards yet</p>\n        <p class=\"text-sm text-slate-300 mt-1\">Use the panel on the right to add your first hazard.</p>\n      </div>`;\n    return;\n  }\n\n  const sorted = [...hazards].sort((a, b) => score(b.likelihood, b.consequence) - score(a.likelihood, a.consequence));\n\n  el.innerHTML = sorted.map(h => {\n    const iScore = score(h.likelihood, h.consequence);\n    const rL = h.rLikelihood || h.likelihood;\n    const rC = h.rConsequence || h.consequence;\n    const rScore = score(rL, rC);\n    const hasMeasures = h.measures && h.measures.trim().length > 0;\n    const measureList = hasMeasures ? h.measures.split('\\n').filter(m => m.trim()) : [];\n    const residualChanged = rL !== h.likelihood || rC !== h.consequence;\n\n    return `\n    <div class=\"hazard-card mb-3\">\n      <div class=\"p-3\">\n        <div class=\"flex items-start gap-3\">\n          <!-- Risk score circle -->\n          <div class=\"flex-shrink-0 w-11 h-11 rounded-full flex items-center justify-center font-bold text-white text-base\" style=\"background:${zoneDotBg(iScore)}\">\n            ${iScore}\n          </div>\n          <div class=\"flex-1 min-w-0\">\n            <div class=\"flex items-start justify-between gap-2 flex-wrap\">\n              <div>\n                <p class=\"font-semibold text-slate-800 text-sm leading-tight\">${escHtml(h.name)}</p>\n                ${h.area ? `<p class=\"text-xs text-slate-400 mt-0.5\">${escHtml(h.area)}</p>` : ''}\n              </div>\n              <div class=\"flex items-center gap-2 flex-shrink-0\">\n                <button onclick=\"openEditModal('${h.id}')\" class=\"text-slate-400 hover:text-indigo-600 transition-colors\" title=\"Edit\">\n                  <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-4 h-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z\"/></svg>\n                </button>\n                <button onclick=\"deleteHazard('${h.id}')\" class=\"text-slate-400 hover:text-red-500 transition-colors\" title=\"Delete\">\n                  <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-4 h-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16\"/></svg>\n                </button>\n              </div>\n            </div>\n            <!-- Scores row -->\n            <div class=\"flex items-center gap-2 mt-2 flex-wrap\">\n              <span class=\"risk-badge ${zoneBadgeClass(iScore)}\">\n                L${h.likelihood}×C${h.consequence} = ${iScore} ${zoneLabel(iScore)}\n              </span>\n              ${residualChanged ? `\n                <span class=\"text-slate-400 text-xs\">→</span>\n                <span class=\"risk-badge ${zoneBadgeClass(rScore)} opacity-90\">\n                  Residual L${rL}×C${rC} = ${rScore} ${zoneLabel(rScore)}\n                </span>\n              ` : ''}\n            </div>\n            ${measureList.length > 0 ? `\n              <div class=\"mt-2 flex flex-wrap gap-1\">\n                ${measureList.map(m => `<span class=\"measure-chip\">${escHtml(m)}</span>`).join('')}\n              </div>\n            ` : ''}\n          </div>\n        </div>\n      </div>\n    </div>`;\n  }).join('');\n}\n\n// ============================================================\n// RENDER PRESENT MODE\n// ============================================================\nfunction renderPresent() {\n  buildMatrix('present-matrix-container', true);\n\n  const listEl = document.getElementById('present-risk-list');\n  if (!listEl) return;\n\n  const sorted = [...hazards].sort((a, b) => score(b.likelihood, b.consequence) - score(a.likelihood, a.consequence));\n\n  if (sorted.length === 0) {\n    listEl.innerHTML = '<p class=\"text-slate-500 text-sm\">No hazards added yet.</p>';\n    return;\n  }\n\n  listEl.innerHTML = sorted.map((h, idx) => {\n    const iScore = score(h.likelihood, h.consequence);\n    const rL = h.rLikelihood || h.likelihood;\n    const rC = h.rConsequence || h.consequence;\n    const rScore = score(rL, rC);\n    const residualChanged = rL !== h.likelihood || rC !== h.consequence;\n    const zBg = zoneDotBg(iScore);\n\n    return `\n    <div style=\"background:#1e293b;border-radius:10px;padding:10px 12px;display:flex;align-items:center;gap:12px;\">\n      <div style=\"width:36px;height:36px;border-radius:50%;background:${zBg};display:flex;align-items:center;justify-content:center;font-weight:700;color:#fff;font-size:0.9rem;flex-shrink:0\">${iScore}</div>\n      <div style=\"flex:1;min-width:0\">\n        <p style=\"font-weight:600;color:#f1f5f9;font-size:0.85rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis\">${escHtml(h.name)}</p>\n        <p style=\"color:#94a3b8;font-size:0.72rem;margin-top:1px\">${escHtml(h.area || '')}${h.area ? ' · ' : ''}L${h.likelihood} × C${h.consequence}${residualChanged ? ` → Residual ${rScore}` : ''}</p>\n      </div>\n    </div>`;\n  }).join('');\n}\n\n// ============================================================\n// FULL RENDER\n// ============================================================\nfunction render() {\n  buildMatrix('matrix-container', false);\n  renderRegister();\n  updateAddSliders();\n}\n\n// ============================================================\n// TABS\n// ============================================================\nfunction switchTab(tab) {\n  document.getElementById('panel-learn').classList.toggle('hidden', tab !== 'learn');\n  document.getElementById('panel-practice').classList.toggle('hidden', tab !== 'practice');\n  document.getElementById('tab-learn').classList.toggle('active', tab === 'learn');\n  document.getElementById('tab-practice').classList.toggle('active', tab === 'practice');\n  if (tab === 'practice') render();\n}\n\n// ============================================================\n// ADD HAZARD (quick panel)\n// ============================================================\nfunction updateAddSliders() {\n  const l = parseInt(document.getElementById('add-likelihood').value);\n  const c = parseInt(document.getElementById('add-consequence').value);\n  document.getElementById('add-l-val').textContent = `${l} – ${LIKELIHOOD_LABELS[l]}`;\n  document.getElementById('add-c-val').textContent = `${c} – ${CONSEQUENCE_LABELS[c]}`;\n  const s = score(l, c);\n  const preview = document.getElementById('add-score-preview');\n  preview.className = `p-3 rounded-lg border text-sm font-semibold text-center transition-all ${zoneBadgeClass(s)}`;\n  preview.textContent = `Score: ${s} — ${zoneLabel(s)} risk`;\n}\n\nfunction addHazard() {\n  const name = document.getElementById('add-name').value.trim();\n  if (!name) { document.getElementById('add-name').focus(); return; }\n  const l = parseInt(document.getElementById('add-likelihood').value);\n  const c = parseInt(document.getElementById('add-consequence').value);\n  const h = {\n    id: 'h-' + Date.now() + '-' + Math.random().toString(36).slice(2,6),\n    name,\n    area: document.getElementById('add-area').value.trim(),\n    likelihood: l,\n    consequence: c,\n    measures: '',\n    rLikelihood: l,\n    rConsequence: c\n  };\n  hazards.push(h);\n  saveHazards();\n  document.getElementById('add-name').value = '';\n  document.getElementById('add-area').value = '';\n  render();\n}\n\n// ============================================================\n// EDIT MODAL\n// ============================================================\nlet editingId = null;\n\nfunction openEditModal(id) {\n  editingId = id;\n  const h = hazards.find(x => x.id === id);\n  if (!h) return;\n  document.getElementById('edit-modal-title').textContent = 'Edit Hazard';\n  document.getElementById('ef-name').value = h.name;\n  document.getElementById('ef-area').value = h.area || '';\n  document.getElementById('ef-likelihood').value = h.likelihood;\n  document.getElementById('ef-consequence').value = h.consequence;\n  document.getElementById('ef-measures').value = h.measures || '';\n  document.getElementById('ef-r-likelihood').value = h.rLikelihood || h.likelihood;\n  document.getElementById('ef-r-consequence').value = h.rConsequence || h.consequence;\n  updateSliderLabels();\n  document.getElementById('edit-modal').classList.add('open');\n  document.getElementById('ef-name').focus();\n}\n\nfunction closeEditModal() {\n  editingId = null;\n  document.getElementById('edit-modal').classList.remove('open');\n}\n\nfunction saveHazard(e) {\n  e.preventDefault();\n  const name = document.getElementById('ef-name').value.trim();\n  if (!name) return;\n  if (editingId) {\n    const idx = hazards.findIndex(x => x.id === editingId);\n    if (idx >= 0) {\n      hazards[idx] = {\n        ...hazards[idx],\n        name,\n        area: document.getElementById('ef-area').value.trim(),\n        likelihood: parseInt(document.getElementById('ef-likelihood').value),\n        consequence: parseInt(document.getElementById('ef-consequence').value),\n        measures: document.getElementById('ef-measures').value.trim(),\n        rLikelihood: parseInt(document.getElementById('ef-r-likelihood').value),\n        rConsequence: parseInt(document.getElementById('ef-r-consequence').value)\n      };\n    }\n  }\n  saveHazards();\n  closeEditModal();\n  render();\n}\n\nfunction updateSliderLabels() {\n  const l = parseInt(document.getElementById('ef-likelihood').value);\n  const c = parseInt(document.getElementById('ef-consequence').value);\n  const rl = parseInt(document.getElementById('ef-r-likelihood').value);\n  const rc = parseInt(document.getElementById('ef-r-consequence').value);\n  document.getElementById('ef-l-val').textContent = `${l} – ${LIKELIHOOD_LABELS[l]}`;\n  document.getElementById('ef-c-val').textContent = `${c} – ${CONSEQUENCE_LABELS[c]}`;\n  document.getElementById('ef-rl-val').textContent = `${rl} – ${LIKELIHOOD_LABELS[rl]}`;\n  document.getElementById('ef-rc-val').textContent = `${rc} – ${CONSEQUENCE_LABELS[rc]}`;\n\n  const s = score(l, c);\n  const rs = score(rl, rc);\n  const preview = document.getElementById('ef-score-preview');\n  preview.className = `p-3 rounded-lg border text-sm font-semibold text-center transition-all ${zoneBadgeClass(s)}`;\n  preview.textContent = `Initial score: ${s} — ${zoneLabel(s)} risk`;\n\n  const rPreview = document.getElementById('ef-residual-preview');\n  rPreview.className = `p-3 rounded-lg border text-sm font-semibold text-center transition-all ${zoneBadgeClass(rs)}`;\n  rPreview.textContent = `Residual score: ${rs} — ${zoneLabel(rs)} risk`;\n}\n\n// ============================================================\n// DELETE\n// ============================================================\nfunction deleteHazard(id) {\n  hazards = hazards.filter(h => h.id !== id);\n  saveHazards();\n  render();\n}\n\n// ============================================================\n// RESET\n// ============================================================\nfunction openResetModal() {\n  document.getElementById('reset-modal').classList.add('open');\n}\nfunction closeResetModal() {\n  document.getElementById('reset-modal').classList.remove('open');\n}\nfunction confirmReset() {\n  hazards = JSON.parse(JSON.stringify(SEED_HAZARDS));\n  saveHazards();\n  closeResetModal();\n  render();\n}\n\n// ============================================================\n// PRESENT MODE\n// ============================================================\nfunction openPresent() {\n  renderPresent();\n  document.getElementById('present-overlay').classList.add('active');\n  document.body.style.overflow = 'hidden';\n}\nfunction closePresent() {\n  document.getElementById('present-overlay').classList.remove('active');\n  document.body.style.overflow = '';\n}\ndocument.addEventListener('keydown', e => {\n  if (e.key === 'Escape') closePresent();\n});\n\n// ============================================================\n// UTILS\n// ============================================================\nfunction escHtml(str) {\n  return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;');\n}\n\n// ============================================================\n// INIT\n// ============================================================\ndocument.addEventListener('DOMContentLoaded', () => {\n  updateAddSliders();\n  updateSliderLabels();\n  // Practice tab renders lazily; Learn is default\n});\n</script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Risk Assessment",
    "windowTitle": "Risk Assessment",
    "bundleId": "com.halisonworks.riskassessment",
    "iconPath": null
  },
  "categoryId": null,
  "source": "import",
  "createdAt": "2026-06-02T16:00:00.000Z",
  "updatedAt": "2026-06-02T16:00:00.000Z",
  "sharedAt": "2026-06-02T16:00:00.000Z"
}
