{
  "schema": "app-studio/canvas@1",
  "id": "example-timezones-flight",
  "name": "timezones-flight.html",
  "code": "<!DOCTYPE html>\n<!--\n  Time Zones & Flight — Halison App Studio example\n\n  A world clock plus a flight-arrival calculator: enter a departure time and a\n  flight duration and see the local arrival time across time zones, layovers\n  included. Saved cities persist in your browser.\n\n  From the Halison App Studio public library:\n  https://github.com/halisonworks/public-app-studio\n\n  Permitted use: personal, educational, and other non-commercial use. You may\n  modify it, but keep this header and the source link intact, and do not sell,\n  commercialize, or republish it. Released under the Halison App Studio Examples\n  License — see the LICENSE file in the repository above.\n-->\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Time Zones &amp; Flight — App Studio</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Segoe UI', system-ui, sans-serif; }\n\n    /* Clock ticks */\n    @keyframes pulse-dot { 0%,100%{opacity:1} 50%{opacity:0.2} }\n    .blink { animation: pulse-dot 1s ease-in-out infinite; }\n\n    /* Tab styling */\n    .tab-btn { transition: background 0.15s, color 0.15s; }\n    .tab-btn.active { background: #1e3a5f; color: #fff; }\n    .tab-btn:not(.active) { background: #e2e8f0; color: #334155; }\n\n    /* Clock card */\n    .city-card { transition: box-shadow 0.15s; }\n    .city-card:hover { box-shadow: 0 4px 18px rgba(30,58,95,0.15); }\n\n    /* Pill tags */\n    .tz-pill {\n      font-size: 0.72rem; padding: 2px 7px;\n      border-radius: 999px; font-weight: 600; letter-spacing: 0.02em;\n    }\n\n    /* Flight result highlight */\n    .result-highlight { background: linear-gradient(135deg,#0f2944 0%,#1e4976 100%); }\n\n    /* Inputs */\n    select, input[type=\"date\"], input[type=\"time\"], input[type=\"number\"] {\n      appearance: none; -webkit-appearance: none;\n    }\n    input[type=\"number\"]::-webkit-inner-spin-button,\n    input[type=\"number\"]::-webkit-outer-spin-button { opacity: 1; }\n\n    /* Scrollable city picker */\n    #city-picker-list { max-height: 280px; overflow-y: auto; }\n\n    /* Info banner */\n    .dst-note { font-size: 0.75rem; }\n\n    @media (max-width: 640px) {\n      .clock-time { font-size: 1.5rem; }\n    }\n  </style>\n</head>\n<body class=\"bg-slate-100 min-h-screen flex flex-col\">\n\n<!-- ===== HEADER ===== -->\n<header class=\"bg-[#0f2944] text-white shadow-lg\">\n  <div class=\"max-w-5xl mx-auto px-4 py-4 flex items-center gap-3\">\n    <div class=\"text-3xl select-none\">🌍</div>\n    <div>\n      <h1 class=\"text-xl sm:text-2xl font-bold leading-tight\">Time Zones &amp; Flight</h1>\n      <p class=\"text-blue-300 text-sm\">World clock + flight-arrival calculator</p>\n    </div>\n    <div class=\"ml-auto text-right hidden sm:block\">\n      <div id=\"utc-clock\" class=\"text-lg font-mono font-bold text-blue-200\"></div>\n      <div class=\"text-xs text-blue-400\">UTC</div>\n    </div>\n  </div>\n</header>\n\n<!-- ===== TABS ===== -->\n<div class=\"bg-[#162e4d] border-b border-[#1e3a5f]\">\n  <div class=\"max-w-5xl mx-auto px-4 flex gap-1 pt-2 pb-0\">\n    <button id=\"tab-clock\" onclick=\"switchTab('clock')\" class=\"tab-btn active rounded-t-lg px-5 py-2 text-sm font-semibold\">\n      🕐 World Clock\n    </button>\n    <button id=\"tab-flight\" onclick=\"switchTab('flight')\" class=\"tab-btn rounded-t-lg px-5 py-2 text-sm font-semibold\">\n      ✈️ Flight Calculator\n    </button>\n  </div>\n</div>\n\n<!-- ===== DST NOTE ===== -->\n<div class=\"bg-amber-50 border-b border-amber-200\">\n  <div class=\"max-w-5xl mx-auto px-4 py-1.5 dst-note text-amber-800\">\n    ⚠️ Fixed UTC offsets are used — daylight saving time is <strong>not</strong> applied. Times are approximate.\n  </div>\n</div>\n\n<!-- ===== MAIN ===== -->\n<main class=\"max-w-5xl mx-auto px-4 py-6 flex-1 w-full\">\n\n  <!-- ======= CLOCK TAB ======= -->\n  <section id=\"pane-clock\">\n\n    <!-- Top bar -->\n    <div class=\"flex flex-wrap items-center justify-between gap-3 mb-5\">\n      <h2 class=\"text-lg font-bold text-slate-800\">Your Cities</h2>\n      <button onclick=\"openCityPicker()\" class=\"bg-[#1e3a5f] hover:bg-[#265080] text-white px-4 py-2 rounded-lg text-sm font-semibold flex items-center gap-1.5 transition\">\n        <span class=\"text-base\">+</span> Add / Remove Cities\n      </button>\n    </div>\n\n    <!-- City clock cards -->\n    <div id=\"clock-cards\" class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4\"></div>\n\n    <!-- Empty state -->\n    <div id=\"clock-empty\" class=\"hidden text-center py-16 text-slate-400\">\n      <div class=\"text-5xl mb-3\">🌐</div>\n      <p class=\"text-lg font-medium\">No cities selected.</p>\n      <p class=\"text-sm mt-1\">Click <strong>Add / Remove Cities</strong> to get started.</p>\n    </div>\n\n  </section>\n\n  <!-- ======= FLIGHT TAB ======= -->\n  <section id=\"pane-flight\" class=\"hidden\">\n\n    <div class=\"grid lg:grid-cols-2 gap-6\">\n\n      <!-- INPUTS -->\n      <div class=\"bg-white rounded-xl shadow p-5 border border-slate-200 space-y-5\">\n        <h2 class=\"text-lg font-bold text-[#0f2944]\">Flight Details</h2>\n\n        <!-- Departure -->\n        <fieldset class=\"space-y-2\">\n          <legend class=\"font-semibold text-slate-700 text-sm uppercase tracking-wide mb-1\">Departure</legend>\n          <div class=\"grid grid-cols-2 gap-2\">\n            <div>\n              <label class=\"text-xs text-slate-500 block mb-1\">City</label>\n              <select id=\"dep-city\" onchange=\"calcFlight()\" class=\"w-full border border-slate-300 rounded-lg px-3 py-2 text-sm bg-white focus:ring-2 focus:ring-blue-400 outline-none\"></select>\n            </div>\n            <div>\n              <label class=\"text-xs text-slate-500 block mb-1\">Date</label>\n              <input id=\"dep-date\" type=\"date\" onchange=\"calcFlight()\" class=\"w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-400 outline-none\" />\n            </div>\n          </div>\n          <div>\n            <label class=\"text-xs text-slate-500 block mb-1\">Local departure time</label>\n            <input id=\"dep-time\" type=\"time\" onchange=\"calcFlight()\" class=\"w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-400 outline-none\" />\n          </div>\n        </fieldset>\n\n        <!-- Flight duration -->\n        <fieldset class=\"space-y-2\">\n          <legend class=\"font-semibold text-slate-700 text-sm uppercase tracking-wide mb-1\">Flight Duration</legend>\n          <div class=\"grid grid-cols-2 gap-2\">\n            <div>\n              <label class=\"text-xs text-slate-500 block mb-1\">Hours</label>\n              <input id=\"dur-h\" type=\"number\" min=\"0\" max=\"24\" value=\"10\" onchange=\"calcFlight()\" class=\"w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-400 outline-none\" />\n            </div>\n            <div>\n              <label class=\"text-xs text-slate-500 block mb-1\">Minutes</label>\n              <input id=\"dur-m\" type=\"number\" min=\"0\" max=\"59\" value=\"30\" onchange=\"calcFlight()\" class=\"w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-400 outline-none\" />\n            </div>\n          </div>\n        </fieldset>\n\n        <!-- Layover -->\n        <fieldset class=\"space-y-2\">\n          <legend class=\"font-semibold text-slate-700 text-sm uppercase tracking-wide mb-1\">Layover (optional)</legend>\n          <div class=\"grid grid-cols-2 gap-2\">\n            <div>\n              <label class=\"text-xs text-slate-500 block mb-1\">Hours</label>\n              <input id=\"lay-h\" type=\"number\" min=\"0\" max=\"48\" value=\"1\" onchange=\"calcFlight()\" class=\"w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-400 outline-none\" />\n            </div>\n            <div>\n              <label class=\"text-xs text-slate-500 block mb-1\">Minutes</label>\n              <input id=\"lay-m\" type=\"number\" min=\"0\" max=\"59\" value=\"30\" onchange=\"calcFlight()\" class=\"w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-400 outline-none\" />\n            </div>\n          </div>\n          <div>\n            <label class=\"text-xs text-slate-500 block mb-1\">Layover city (label only)</label>\n            <select id=\"lay-city\" onchange=\"calcFlight()\" class=\"w-full border border-slate-300 rounded-lg px-3 py-2 text-sm bg-white focus:ring-2 focus:ring-blue-400 outline-none\"></select>\n          </div>\n        </fieldset>\n\n        <!-- Arrival city -->\n        <fieldset class=\"space-y-2\">\n          <legend class=\"font-semibold text-slate-700 text-sm uppercase tracking-wide mb-1\">Arrival</legend>\n          <div>\n            <label class=\"text-xs text-slate-500 block mb-1\">City</label>\n            <select id=\"arr-city\" onchange=\"calcFlight()\" class=\"w-full border border-slate-300 rounded-lg px-3 py-2 text-sm bg-white focus:ring-2 focus:ring-blue-400 outline-none\"></select>\n          </div>\n        </fieldset>\n\n      </div>\n\n      <!-- RESULTS -->\n      <div class=\"space-y-4\">\n\n        <!-- Main result card -->\n        <div id=\"result-card\" class=\"result-highlight rounded-xl shadow-lg p-6 text-white\">\n          <div class=\"text-blue-300 text-sm font-semibold uppercase tracking-wide mb-3\">Arrival</div>\n          <div id=\"res-arrival-time\" class=\"text-4xl sm:text-5xl font-bold font-mono mb-1\">—</div>\n          <div id=\"res-arrival-date\" class=\"text-blue-200 text-base mb-4\">—</div>\n          <div id=\"res-day-diff\" class=\"text-sm font-medium mb-4\"></div>\n          <div id=\"res-plain\" class=\"bg-white/10 rounded-lg p-3 text-sm leading-relaxed text-blue-100 italic\"></div>\n        </div>\n\n        <!-- Breakdown table -->\n        <div class=\"bg-white rounded-xl shadow p-5 border border-slate-200\">\n          <h3 class=\"font-bold text-slate-700 mb-3 text-sm uppercase tracking-wide\">Time Zone Breakdown</h3>\n          <table class=\"w-full text-sm\">\n            <tbody id=\"tz-breakdown\" class=\"divide-y divide-slate-100\"></tbody>\n          </table>\n        </div>\n\n        <!-- Travel time summary -->\n        <div id=\"travel-summary\" class=\"bg-slate-50 border border-slate-200 rounded-xl p-4 text-sm text-slate-600 space-y-1\"></div>\n\n      </div>\n    </div>\n\n  </section>\n\n</main>\n\n<!-- ===== CITY PICKER MODAL ===== -->\n<div id=\"modal-overlay\" onclick=\"closeCityPicker()\" class=\"hidden fixed inset-0 bg-black/50 z-40 flex items-center justify-center p-4\">\n  <div onclick=\"event.stopPropagation()\" class=\"bg-white rounded-2xl shadow-2xl w-full max-w-md max-h-[90vh] flex flex-col z-50\">\n    <div class=\"px-5 py-4 border-b border-slate-100 flex items-center justify-between\">\n      <h2 class=\"text-lg font-bold text-slate-800\">Select Cities</h2>\n      <button onclick=\"closeCityPicker()\" class=\"text-slate-400 hover:text-slate-700 text-2xl leading-none\">&times;</button>\n    </div>\n    <div class=\"px-4 py-2\">\n      <input id=\"city-search\" oninput=\"filterCities()\" placeholder=\"Search city…\" class=\"w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-400 outline-none\" />\n    </div>\n    <div id=\"city-picker-list\" class=\"flex-1 overflow-y-auto px-3 pb-3 space-y-1\"></div>\n    <div class=\"px-5 py-3 border-t border-slate-100 flex justify-end\">\n      <button onclick=\"closeCityPicker()\" class=\"bg-[#1e3a5f] hover:bg-[#265080] text-white px-5 py-2 rounded-lg text-sm font-semibold transition\">Done</button>\n    </div>\n  </div>\n</div>\n\n<!-- ===== SCRIPT ===== -->\n<script>\n'use strict';\n\n/* -------------------------------------------------------\n   CITY TABLE — fixed UTC offsets (DST not applied)\n   ------------------------------------------------------- */\nconst CITIES = [\n  { name: 'Oslo',         country: 'Norway',      offset: 1,    flag: '🇳🇴' },\n  { name: 'London',       country: 'UK',           offset: 0,    flag: '🇬🇧' },\n  { name: 'Reykjavik',    country: 'Iceland',      offset: 0,    flag: '🇮🇸' },\n  { name: 'Lisbon',       country: 'Portugal',     offset: 0,    flag: '🇵🇹' },\n  { name: 'Paris',        country: 'France',       offset: 1,    flag: '🇫🇷' },\n  { name: 'Berlin',       country: 'Germany',      offset: 1,    flag: '🇩🇪' },\n  { name: 'Rome',         country: 'Italy',        offset: 1,    flag: '🇮🇹' },\n  { name: 'Cairo',        country: 'Egypt',        offset: 2,    flag: '🇪🇬' },\n  { name: 'Cape Town',    country: 'South Africa', offset: 2,    flag: '🇿🇦' },\n  { name: 'Istanbul',     country: 'Turkey',       offset: 3,    flag: '🇹🇷' },\n  { name: 'Nairobi',      country: 'Kenya',        offset: 3,    flag: '🇰🇪' },\n  { name: 'Dubai',        country: 'UAE',          offset: 4,    flag: '🇦🇪' },\n  { name: 'Mumbai',       country: 'India',        offset: 5.5,  flag: '🇮🇳' },\n  { name: 'Dhaka',        country: 'Bangladesh',   offset: 6,    flag: '🇧🇩' },\n  { name: 'Bangkok',      country: 'Thailand',     offset: 7,    flag: '🇹🇭' },\n  { name: 'Singapore',    country: 'Singapore',    offset: 8,    flag: '🇸🇬' },\n  { name: 'Kuala Lumpur', country: 'Malaysia',     offset: 8,    flag: '🇲🇾' },\n  { name: 'Beijing',      country: 'China',        offset: 8,    flag: '🇨🇳' },\n  { name: 'Tokyo',        country: 'Japan',        offset: 9,    flag: '🇯🇵' },\n  { name: 'Sydney',       country: 'Australia',    offset: 10,   flag: '🇦🇺' },\n  { name: 'Auckland',     country: 'New Zealand',  offset: 12,   flag: '🇳🇿' },\n  { name: 'São Paulo',    country: 'Brazil',       offset: -3,   flag: '🇧🇷' },\n  { name: 'New York',     country: 'USA',          offset: -5,   flag: '🇺🇸' },\n  { name: 'Chicago',      country: 'USA',          offset: -6,   flag: '🇺🇸' },\n  { name: 'Denver',       country: 'USA',          offset: -7,   flag: '🇺🇸' },\n  { name: 'Los Angeles',  country: 'USA',          offset: -8,   flag: '🇺🇸' },\n  { name: 'Anchorage',    country: 'USA',          offset: -9,   flag: '🇺🇸' },\n  { name: 'Honolulu',     country: 'USA',          offset: -10,  flag: '🇺🇸' },\n];\n\n/* Default selected cities */\nconst DEFAULT_SELECTED = ['Oslo', 'London', 'New York', 'Dubai', 'Bangkok', 'Tokyo'];\nconst LS_KEY = 'tz_selected_cities';\n\n/* -------------------------------------------------------\n   STATE\n   ------------------------------------------------------- */\nlet selectedCities = loadSelected();\nlet clockInterval = null;\n\n/* -------------------------------------------------------\n   PERSISTENCE\n   ------------------------------------------------------- */\nfunction loadSelected() {\n  try {\n    const raw = localStorage.getItem(LS_KEY);\n    if (raw) {\n      const arr = JSON.parse(raw);\n      if (Array.isArray(arr) && arr.length > 0) return arr;\n    }\n  } catch (e) {}\n  return [...DEFAULT_SELECTED];\n}\n\nfunction saveSelected() {\n  try { localStorage.setItem(LS_KEY, JSON.stringify(selectedCities)); } catch (e) {}\n}\n\n/* -------------------------------------------------------\n   HELPERS\n   ------------------------------------------------------- */\nfunction pad2(n) { return String(n).padStart(2, '0'); }\n\nfunction offsetLabel(off) {\n  const sign = off >= 0 ? '+' : '−';\n  const abs = Math.abs(off);\n  const h = Math.floor(abs);\n  const m = Math.round((abs - h) * 60);\n  return `UTC${sign}${pad2(h)}${m > 0 ? ':' + pad2(m) : ''}`;\n}\n\nfunction cityByName(name) {\n  return CITIES.find(c => c.name === name);\n}\n\n/** Return local Date object for a city given its UTC offset */\nfunction cityLocalDate(city) {\n  const now = new Date();\n  const utcMs = now.getTime() + now.getTimezoneOffset() * 60000;\n  return new Date(utcMs + city.offset * 3600000);\n}\n\n/** HH:MM:SS string for a Date */\nfunction timeStr(d) {\n  return `${pad2(d.getHours())}:${pad2(d.getMinutes())}:${pad2(d.getSeconds())}`;\n}\n\n/** Short day name for a Date */\nfunction dayStr(d) {\n  return d.toLocaleDateString('en-US', { weekday: 'short' });\n}\n\n/** Date string like \"Mon 2 Jun\" */\nfunction dateLong(d) {\n  return d.toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short' });\n}\n\n/** Day difference label vs user's local date */\nfunction dayDiffLabel(cityDate) {\n  const localNow = new Date();\n  const localDay = new Date(localNow.getFullYear(), localNow.getMonth(), localNow.getDate()).getTime();\n  const cityDay  = new Date(cityDate.getFullYear(), cityDate.getMonth(), cityDate.getDate()).getTime();\n  const diff = Math.round((cityDay - localDay) / 86400000);\n  if (diff === 0) return null;\n  if (diff === 1) return '+1 day';\n  if (diff === -1) return '−1 day';\n  return `${diff > 0 ? '+' : ''}${diff} days`;\n}\n\n/* -------------------------------------------------------\n   TABS\n   ------------------------------------------------------- */\nfunction switchTab(tab) {\n  document.getElementById('pane-clock').classList.toggle('hidden', tab !== 'clock');\n  document.getElementById('pane-flight').classList.toggle('hidden', tab !== 'flight');\n  document.getElementById('tab-clock').classList.toggle('active', tab === 'clock');\n  document.getElementById('tab-flight').classList.toggle('active', tab === 'flight');\n}\n\n/* -------------------------------------------------------\n   CLOCK TAB\n   ------------------------------------------------------- */\nfunction renderClockCards() {\n  const container = document.getElementById('clock-cards');\n  const empty = document.getElementById('clock-empty');\n  container.innerHTML = '';\n\n  if (selectedCities.length === 0) {\n    empty.classList.remove('hidden');\n    return;\n  }\n  empty.classList.add('hidden');\n\n  selectedCities.forEach(name => {\n    const city = cityByName(name);\n    if (!city) return;\n    const d = cityLocalDate(city);\n\n    const offLabel = offsetLabel(city.offset);\n    const dayDiff = dayDiffLabel(d);\n\n    const card = document.createElement('div');\n    card.className = 'city-card bg-white rounded-xl shadow border border-slate-200 p-4 flex flex-col gap-2';\n    card.innerHTML = `\n      <div class=\"flex items-center justify-between\">\n        <div class=\"flex items-center gap-2\">\n          <span class=\"text-2xl\">${city.flag}</span>\n          <div>\n            <div class=\"font-bold text-slate-800 leading-tight\">${city.name}</div>\n            <div class=\"text-xs text-slate-400\">${city.country}</div>\n          </div>\n        </div>\n        <button onclick=\"removeCity('${city.name}')\" title=\"Remove\" class=\"text-slate-300 hover:text-red-400 transition text-lg leading-none\">&times;</button>\n      </div>\n      <div class=\"flex items-end justify-between\">\n        <div class=\"clock-time font-mono font-bold text-2xl text-[#0f2944]\" id=\"clock-${city.name.replace(/\\s/g,'_')}\">${timeStr(d)}</div>\n        <div class=\"text-right\">\n          <span class=\"tz-pill bg-blue-100 text-blue-700\">${offLabel}</span>\n          ${dayDiff ? `<span class=\"tz-pill bg-amber-100 text-amber-700 ml-1\">${dayDiff}</span>` : ''}\n        </div>\n      </div>\n      <div class=\"text-xs text-slate-500\">${dateLong(d)}</div>\n    `;\n    container.appendChild(card);\n  });\n}\n\nfunction tickClocks() {\n  selectedCities.forEach(name => {\n    const city = cityByName(name);\n    if (!city) return;\n    const el = document.getElementById('clock-' + city.name.replace(/\\s/g,'_'));\n    if (el) el.textContent = timeStr(cityLocalDate(city));\n  });\n\n  // UTC clock in header\n  const now = new Date();\n  document.getElementById('utc-clock').textContent =\n    `${pad2(now.getUTCHours())}:${pad2(now.getUTCMinutes())}:${pad2(now.getUTCSeconds())}`;\n}\n\nfunction removeCity(name) {\n  selectedCities = selectedCities.filter(n => n !== name);\n  saveSelected();\n  renderClockCards();\n  updatePickerList();\n}\n\n/* -------------------------------------------------------\n   CITY PICKER MODAL\n   ------------------------------------------------------- */\nfunction openCityPicker() {\n  document.getElementById('city-search').value = '';\n  updatePickerList();\n  document.getElementById('modal-overlay').classList.remove('hidden');\n}\n\nfunction closeCityPicker() {\n  document.getElementById('modal-overlay').classList.add('hidden');\n}\n\nfunction filterCities() {\n  updatePickerList(document.getElementById('city-search').value.toLowerCase());\n}\n\nfunction updatePickerList(filter = '') {\n  const list = document.getElementById('city-picker-list');\n  list.innerHTML = '';\n  CITIES.filter(c => !filter || c.name.toLowerCase().includes(filter) || c.country.toLowerCase().includes(filter))\n    .forEach(c => {\n      const checked = selectedCities.includes(c.name);\n      const row = document.createElement('label');\n      row.className = 'flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50 cursor-pointer text-sm select-none';\n      row.innerHTML = `\n        <input type=\"checkbox\" ${checked ? 'checked' : ''} onchange=\"toggleCity('${c.name}', this.checked)\"\n          class=\"w-4 h-4 rounded text-blue-600 cursor-pointer\" />\n        <span class=\"text-lg\">${c.flag}</span>\n        <span class=\"flex-1 font-medium text-slate-700\">${c.name}</span>\n        <span class=\"text-xs text-slate-400\">${c.country}</span>\n        <span class=\"tz-pill bg-slate-100 text-slate-500\">${offsetLabel(c.offset)}</span>\n      `;\n      list.appendChild(row);\n    });\n}\n\nfunction toggleCity(name, checked) {\n  if (checked && !selectedCities.includes(name)) {\n    selectedCities.push(name);\n  } else if (!checked) {\n    selectedCities = selectedCities.filter(n => n !== name);\n  }\n  saveSelected();\n  renderClockCards();\n}\n\n/* -------------------------------------------------------\n   FLIGHT CALCULATOR\n   ------------------------------------------------------- */\nfunction populateCityDropdowns() {\n  const selects = ['dep-city', 'arr-city', 'lay-city'];\n  selects.forEach(id => {\n    const sel = document.getElementById(id);\n    sel.innerHTML = '';\n    CITIES.forEach(c => {\n      const opt = document.createElement('option');\n      opt.value = c.name;\n      opt.textContent = `${c.flag} ${c.name} (${offsetLabel(c.offset)})`;\n      sel.appendChild(opt);\n    });\n  });\n\n  // Defaults: Oslo → Bangkok, layover at Dubai\n  document.getElementById('dep-city').value = 'Oslo';\n  document.getElementById('arr-city').value = 'Bangkok';\n  document.getElementById('lay-city').value = 'Dubai';\n\n  // Default date = today, time = 07:15\n  const today = new Date();\n  const yyyy = today.getFullYear();\n  const mm = pad2(today.getMonth() + 1);\n  const dd = pad2(today.getDate());\n  document.getElementById('dep-date').value = `${yyyy}-${mm}-${dd}`;\n  document.getElementById('dep-time').value = '07:15';\n}\n\nfunction getNum(id) {\n  return Math.max(0, parseInt(document.getElementById(id).value) || 0);\n}\n\nfunction calcFlight() {\n  const depCityName = document.getElementById('dep-city').value;\n  const arrCityName = document.getElementById('arr-city').value;\n  const layCityName = document.getElementById('lay-city').value;\n  const depDateStr  = document.getElementById('dep-date').value;\n  const depTimeStr  = document.getElementById('dep-time').value;\n  const durH = getNum('dur-h');\n  const durM = getNum('dur-m');\n  const layH = getNum('lay-h');\n  const layM = getNum('lay-m');\n\n  const depCity = cityByName(depCityName);\n  const arrCity = cityByName(arrCityName);\n  const layCity = cityByName(layCityName);\n\n  if (!depCity || !arrCity || !depDateStr || !depTimeStr) return;\n\n  // Parse departure local time → UTC\n  // dep local = depDate + depTime in depCity's offset zone\n  const [yyyy, mon, day] = depDateStr.split('-').map(Number);\n  const [hh, mmm] = depTimeStr.split(':').map(Number);\n\n  // Departure as a UTC epoch:\n  // UTC = local - offset\n  const depLocalMinutes = hh * 60 + mmm;\n  const depOffsetMinutes = depCity.offset * 60;\n  const flightMinutes = durH * 60 + durM;\n  const layoverMinutes = layH * 60 + layM;\n  const totalAirMinutes = flightMinutes + layoverMinutes;\n\n  // Build departure UTC date\n  const depUTC = new Date(Date.UTC(yyyy, mon - 1, day, hh, mmm, 0));\n  depUTC.setUTCMinutes(depUTC.getUTCMinutes() - depOffsetMinutes);\n\n  // Arrival UTC\n  const arrUTC = new Date(depUTC.getTime() + totalAirMinutes * 60000);\n\n  // Arrival local in arrival city\n  const arrOffsetMinutes = arrCity.offset * 60;\n  const arrLocal = new Date(arrUTC.getTime() + arrOffsetMinutes * 60000);\n\n  // Day difference in local calendar days\n  const depLocalDate = new Date(Date.UTC(yyyy, mon - 1, day));\n  const arrLocalDate = new Date(Date.UTC(\n    arrLocal.getUTCFullYear(), arrLocal.getUTCMonth(), arrLocal.getUTCDate()\n  ));\n  const dayDiff = Math.round((arrLocalDate - depLocalDate) / 86400000);\n\n  // Departure local date object (for display)\n  const depLocalDisplay = new Date(depUTC.getTime() + depOffsetMinutes * 60000);\n\n  // ---- Render result card ----\n  const arrTimeStr = `${pad2(arrLocal.getUTCHours())}:${pad2(arrLocal.getUTCMinutes())}`;\n  const arrDateStr = arrLocal.toLocaleDateString('en-GB', {\n    weekday: 'long', day: 'numeric', month: 'long', year: 'numeric',\n    timeZone: 'UTC'\n  });\n\n  document.getElementById('res-arrival-time').textContent = arrTimeStr;\n  document.getElementById('res-arrival-date').textContent = arrDateStr;\n\n  // Day difference badge\n  const dayDiffEl = document.getElementById('res-day-diff');\n  if (dayDiff === 0) {\n    dayDiffEl.innerHTML = '<span class=\"bg-green-500/30 text-green-200 rounded-full px-3 py-0.5 text-xs font-semibold\">Same calendar day as departure</span>';\n  } else if (dayDiff === 1) {\n    dayDiffEl.innerHTML = '<span class=\"bg-amber-500/30 text-amber-200 rounded-full px-3 py-0.5 text-xs font-semibold\">+1 day — you land the next day</span>';\n  } else if (dayDiff > 1) {\n    dayDiffEl.innerHTML = `<span class=\"bg-amber-500/30 text-amber-200 rounded-full px-3 py-0.5 text-xs font-semibold\">+${dayDiff} days</span>`;\n  } else if (dayDiff < 0) {\n    dayDiffEl.innerHTML = `<span class=\"bg-purple-500/30 text-purple-200 rounded-full px-3 py-0.5 text-xs font-semibold\">${dayDiff} day${Math.abs(dayDiff)>1?'s':''} — local clock appears to go back!</span>`;\n  }\n\n  // Plain-language description\n  const arrHour = arrLocal.getUTCHours();\n  const timeOfDayStr = arrHour < 6 ? 'in the early hours of' :\n                       arrHour < 12 ? 'in the morning on' :\n                       arrHour < 17 ? 'in the afternoon on' :\n                       arrHour < 21 ? 'in the evening on' : 'late at night on';\n  const totalH = Math.floor(totalAirMinutes / 60);\n  const totalM = totalAirMinutes % 60;\n  const durationStr = `${totalH}h${totalM > 0 ? ' ' + totalM + 'm' : ''}`;\n  const hasLayover = (layH + layM) > 0;\n\n  let plain = `You land at ${arrTimeStr} ${timeOfDayStr} ${arrDateStr} in ${arrCityName}`;\n  if (dayDiff !== 0) {\n    plain += ` — ${Math.abs(dayDiff)} calendar day${Math.abs(dayDiff)>1?'s':''} ${dayDiff>0?'after':'before'} you depart from ${depCityName}`;\n  }\n  plain += `. Total journey: ${durationStr}${hasLayover ? ` (including ${layH}h${layM>0?' '+layM+'m':''} layover in ${layCityName})` : ''}.`;\n\n  // Crossing-midnight / clock curiosity note\n  const depOffset = depCity.offset;\n  const arrOffset = arrCity.offset;\n  const offsetDiff = arrOffset - depOffset;\n  if (dayDiff < 0) {\n    plain += ` Because ${arrCityName} is ${Math.abs(offsetDiff)}h behind ${depCityName}, the local clock shows an earlier time even though real time passed.`;\n  } else if (dayDiff > 0 && flightMinutes < 600) {\n    plain += ` The date change is mainly due to crossing time zones, not just a very long flight.`;\n  }\n\n  document.getElementById('res-plain').textContent = plain;\n\n  // ---- Breakdown table ----\n  const depUTCStr = `${pad2(depUTC.getUTCHours())}:${pad2(depUTC.getUTCMinutes())} UTC, ${depUTC.toLocaleDateString('en-GB',{weekday:'short',day:'numeric',month:'short',timeZone:'UTC'})}`;\n  const arrUTCStr = `${pad2(arrUTC.getUTCHours())}:${pad2(arrUTC.getUTCMinutes())} UTC, ${arrUTC.toLocaleDateString('en-GB',{weekday:'short',day:'numeric',month:'short',timeZone:'UTC'})}`;\n\n  const depLocalStr = `${pad2(depLocalDisplay.getUTCHours())}:${pad2(depLocalDisplay.getUTCMinutes())} (${depCityName})`;\n\n  const rows = [\n    ['Departure (local)', depLocalStr, depCity.flag],\n    ['Departure offset',  offsetLabel(depCity.offset), '🌐'],\n    ['Departure (UTC)',   depUTCStr, '⏱️'],\n    ['Flight time',       `${durH}h ${pad2(durM)}m`, '✈️'],\n    hasLayover ? ['Layover', `${layH}h ${pad2(layM)}m in ${layCityName} ${layCity.flag}`, '🔁'] : null,\n    ['Total air time',    `${totalH}h ${pad2(totalAirMinutes % 60)}m`, '⏳'],\n    ['Arrival (UTC)',     arrUTCStr, '⏱️'],\n    ['Arrival offset',    offsetLabel(arrCity.offset), '🌐'],\n    ['Arrival (local)',   `${arrTimeStr} (${arrCityName})`, arrCity.flag],\n  ].filter(Boolean);\n\n  document.getElementById('tz-breakdown').innerHTML = rows.map(([label, value, icon]) => `\n    <tr class=\"text-sm\">\n      <td class=\"py-1.5 text-slate-500 pr-2\">${icon} ${label}</td>\n      <td class=\"py-1.5 font-mono font-semibold text-slate-800 text-right\">${value}</td>\n    </tr>\n  `).join('');\n\n  // Travel summary\n  document.getElementById('travel-summary').innerHTML = `\n    <div class=\"flex gap-2 flex-wrap\">\n      <span class=\"inline-flex items-center gap-1 bg-blue-100 text-blue-800 rounded-full px-3 py-1 text-xs font-semibold\">✈️ Flight: ${durH}h ${pad2(durM)}m</span>\n      ${hasLayover ? `<span class=\"inline-flex items-center gap-1 bg-amber-100 text-amber-800 rounded-full px-3 py-1 text-xs font-semibold\">🔁 Layover: ${layH}h ${pad2(layM)}m</span>` : ''}\n      <span class=\"inline-flex items-center gap-1 bg-emerald-100 text-emerald-800 rounded-full px-3 py-1 text-xs font-semibold\">⏳ Total: ${totalH}h ${pad2(totalAirMinutes % 60)}m</span>\n      <span class=\"inline-flex items-center gap-1 bg-purple-100 text-purple-800 rounded-full px-3 py-1 text-xs font-semibold\">🌐 TZ shift: ${offsetDiff >= 0 ? '+' : ''}${offsetDiff}h</span>\n    </div>\n  `;\n}\n\n/* -------------------------------------------------------\n   INIT\n   ------------------------------------------------------- */\nfunction init() {\n  populateCityDropdowns();\n  renderClockCards();\n  calcFlight();\n\n  // Tick every second\n  function tick() {\n    tickClocks();\n  }\n  tick();\n  setInterval(tick, 1000);\n}\n\ndocument.addEventListener('DOMContentLoaded', init);\n</script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Time Zones & Flight",
    "windowTitle": "Time Zones & Flight",
    "bundleId": "com.halisonworks.timezonesflight",
    "iconPath": null
  },
