{
  "schema": "app-studio/canvas@1",
  "id": "example-color-palette",
  "name": "color-palette.html",
  "code": "<!DOCTYPE html>\n<!--\n  Color Palette Generator — Halison App Studio example\n\n  Generate harmonious color palettes: lock the colors you like, reroll the rest,\n  and click a swatch to copy its hex.\n\n  From the Halison App Studio public library:\n  https://github.com/halisonworks/public-app-studio\n\n  Permitted use: personal, educational, and other non-commercial use. You may\n  modify it, but keep this header and the source link intact, and do not sell,\n  commercialize, or republish it. Released under the Halison App Studio Examples\n  License — see the LICENSE file in the repository above.\n-->\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Color Palette Generator</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { height: 100dvh; overflow: hidden; }\n    .swatch-transition { transition: transform 0.15s ease, box-shadow 0.15s ease; }\n    .swatch-transition:hover { transform: scaleY(1.03); box-shadow: 0 8px 30px rgba(0,0,0,0.25); }\n    .lock-btn { transition: opacity 0.2s ease, background 0.2s ease; }\n    .copied-toast {\n      animation: fadeInOut 1.2s ease forwards;\n    }\n    @keyframes fadeInOut {\n      0%   { opacity: 0; transform: translateY(4px); }\n      15%  { opacity: 1; transform: translateY(0); }\n      75%  { opacity: 1; }\n      100% { opacity: 0; transform: translateY(-4px); }\n    }\n  </style>\n</head>\n<body class=\"bg-gray-950 flex flex-col select-none\">\n\n  <!-- Header -->\n  <header class=\"flex items-center justify-between px-6 py-4 shrink-0\">\n    <div>\n      <h1 class=\"text-white text-xl font-bold tracking-tight\">Color Palette</h1>\n      <p class=\"text-gray-400 text-sm mt-0.5\">Lock swatches you love, reroll the rest</p>\n    </div>\n    <button\n      id=\"generateBtn\"\n      class=\"bg-white text-gray-900 font-semibold text-sm px-5 py-2.5 rounded-full hover:bg-gray-100 active:scale-95 transition-all duration-150 shadow\"\n    >\n      Generate\n    </button>\n  </header>\n\n  <!-- Palette -->\n  <main id=\"palette\" class=\"flex flex-1 gap-2 px-4 pb-4 min-h-0\">\n    <!-- swatches injected by JS -->\n  </main>\n\n  <script>\n    // ─── Color Math ───────────────────────────────────────────────────────────\n\n    function hslToHex(h, s, l) {\n      s /= 100; l /= 100;\n      const a = s * Math.min(l, 1 - l);\n      const f = n => {\n        const k = (n + h / 30) % 12;\n        const color = l - a * Math.max(Math.min(k - 3, 9 - k, 1), -1);\n        return Math.round(255 * color).toString(16).padStart(2, '0');\n      };\n      return '#' + f(0) + f(8) + f(4);\n    }\n\n    function hexToHsl(hex) {\n      let r = parseInt(hex.slice(1,3),16)/255;\n      let g = parseInt(hex.slice(3,5),16)/255;\n      let b = parseInt(hex.slice(5,7),16)/255;\n      const max = Math.max(r,g,b), min = Math.min(r,g,b);\n      let h, s, l = (max+min)/2;\n      if (max === min) { h = s = 0; }\n      else {\n        const d = max - min;\n        s = l > 0.5 ? d/(2-max-min) : d/(max+min);\n        switch(max){\n          case r: h = ((g-b)/d + (g<b?6:0))/6; break;\n          case g: h = ((b-r)/d + 2)/6; break;\n          case b: h = ((r-g)/d + 4)/6; break;\n        }\n      }\n      return [Math.round(h*360), Math.round(s*100), Math.round(l*100)];\n    }\n\n    // Harmony schemes: each returns array of 5 [h,s,l] triples\n    const SCHEMES = [\n      // Analogous\n      (h, s, l) => [\n        [h,               s,        l],\n        [(h + 30)  % 360, s,        clampL(l - 8)],\n        [(h + 60)  % 360, s - 5,    clampL(l + 8)],\n        [(h - 30 + 360) % 360, s,   clampL(l - 5)],\n        [(h - 60 + 360) % 360, s - 5, clampL(l + 5)],\n      ],\n      // Complementary split\n      (h, s, l) => [\n        [h,                    s,        l],\n        [(h + 180) % 360,      s,        l],\n        [(h + 150) % 360,      s - 8,    clampL(l + 10)],\n        [(h + 210) % 360,      s - 8,    clampL(l + 10)],\n        [(h + 30)  % 360,      s - 5,    clampL(l - 10)],\n      ],\n      // Triadic\n      (h, s, l) => [\n        [h,                s,      l],\n        [(h + 120) % 360,  s,      clampL(l - 5)],\n        [(h + 240) % 360,  s,      clampL(l + 8)],\n        [(h + 60)  % 360,  s - 10, clampL(l + 12)],\n        [(h + 180) % 360,  s - 10, clampL(l - 12)],\n      ],\n      // Square (tetradic)\n      (h, s, l) => [\n        [h,                s,      l],\n        [(h + 90)  % 360,  s,      clampL(l + 5)],\n        [(h + 180) % 360,  s - 5,  clampL(l - 5)],\n        [(h + 270) % 360,  s,      clampL(l + 10)],\n        [(h + 45)  % 360,  s - 10, clampL(l - 8)],\n      ],\n      // Monochromatic\n      (h, s, l) => [\n        [h, s,      20],\n        [h, s,      38],\n        [h, s - 5,  55],\n        [h, s - 10, 70],\n        [h, s - 15, 85],\n      ],\n    ];\n\n    function clampL(l) { return Math.min(88, Math.max(18, l)); }\n\n    function randomPalette() {\n      const h = Math.floor(Math.random() * 360);\n      const s = 55 + Math.floor(Math.random() * 30);   // 55–84\n      const l = 38 + Math.floor(Math.random() * 18);   // 38–55\n      const scheme = SCHEMES[Math.floor(Math.random() * SCHEMES.length)];\n      return scheme(h, s, l).map(([hh, ss, ll]) =>\n        hslToHex(\n          (hh + 360) % 360,\n          Math.min(100, Math.max(10, ss)),\n          Math.min(90, Math.max(12, ll))\n        )\n      );\n    }\n\n    // ─── State ────────────────────────────────────────────────────────────────\n\n    let colors  = ['#000000','#000000','#000000','#000000','#000000'];\n    let locked  = [false, false, false, false, false];\n\n    // ─── DOM helpers ─────────────────────────────────────────────────────────\n\n    function contrastColor(hex) {\n      const [,, l] = hexToHsl(hex);\n      return l > 52 ? '#1a1a1a' : '#ffffff';\n    }\n\n    function buildSwatch(index) {\n      const hex   = colors[index];\n      const fg    = contrastColor(hex);\n      const isLocked = locked[index];\n\n      const col = document.createElement('div');\n      col.className = 'relative flex-1 rounded-2xl swatch-transition cursor-pointer flex flex-col justify-between overflow-hidden';\n      col.style.backgroundColor = hex;\n      col.dataset.index = index;\n\n      // Lock button\n      const lockWrap = document.createElement('div');\n      lockWrap.className = 'flex justify-end p-3';\n\n      const lockBtn = document.createElement('button');\n      lockBtn.className = 'lock-btn w-9 h-9 rounded-full flex items-center justify-center text-lg focus:outline-none';\n      lockBtn.style.background = isLocked\n        ? (contrastColor(hex) === '#ffffff' ? 'rgba(255,255,255,0.25)' : 'rgba(0,0,0,0.15)')\n        : 'transparent';\n      lockBtn.title = isLocked ? 'Unlock' : 'Lock';\n      lockBtn.setAttribute('aria-label', isLocked ? 'Unlock color' : 'Lock color');\n      lockBtn.innerHTML = isLocked\n        ? `<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"currentColor\" width=\"18\" height=\"18\" style=\"color:${fg}\"><path fill-rule=\"evenodd\" d=\"M12 1.5a5.25 5.25 0 00-5.25 5.25v3a3 3 0 00-3 3v6.75a3 3 0 003 3h10.5a3 3 0 003-3v-6.75a3 3 0 00-3-3v-3A5.25 5.25 0 0012 1.5zm3.75 8.25v-3a3.75 3.75 0 10-7.5 0v3h7.5z\" clip-rule=\"evenodd\"/></svg>`\n        : `<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"currentColor\" width=\"18\" height=\"18\" style=\"color:${fg};opacity:0.5\"><path d=\"M18 1.5c2.9 0 5.25 2.35 5.25 5.25v3.75a.75.75 0 01-1.5 0V6.75a3.75 3.75 0 00-7.5 0v3h.75a3 3 0 013 3v6.75a3 3 0 01-3 3H3.75a3 3 0 01-3-3v-6.75a3 3 0 013-3H15v-3C15 3.85 16.65 1.5 18 1.5z\"/></svg>`;\n\n      lockBtn.addEventListener('click', e => {\n        e.stopPropagation();\n        locked[index] = !locked[index];\n        renderPalette();\n      });\n\n      lockWrap.appendChild(lockBtn);\n\n      // Hex label + copy feedback\n      const bottom = document.createElement('div');\n      bottom.className = 'p-4 flex flex-col items-center gap-1';\n\n      const toast = document.createElement('span');\n      toast.className = 'text-xs font-semibold tracking-widest pointer-events-none';\n      toast.style.color = fg;\n      toast.style.opacity = '0';\n      toast.style.height = '16px';\n      toast.textContent = 'COPIED!';\n      toast.id = `toast-${index}`;\n\n      const hexLabel = document.createElement('span');\n      hexLabel.className = 'font-mono font-bold text-sm tracking-widest uppercase';\n      hexLabel.style.color = fg;\n      hexLabel.textContent = hex.toUpperCase();\n\n      bottom.appendChild(toast);\n      bottom.appendChild(hexLabel);\n\n      col.appendChild(lockWrap);\n      col.appendChild(bottom);\n\n      // Copy on swatch click\n      col.addEventListener('click', () => copyHex(index, hex));\n\n      return col;\n    }\n\n    function renderPalette() {\n      const palette = document.getElementById('palette');\n      palette.innerHTML = '';\n      for (let i = 0; i < 5; i++) {\n        palette.appendChild(buildSwatch(i));\n      }\n    }\n\n    function generate() {\n      const next = randomPalette();\n      colors = colors.map((c, i) => locked[i] ? c : next[i]);\n      renderPalette();\n    }\n\n    async function copyHex(index, hex) {\n      try {\n        await navigator.clipboard.writeText(hex.toUpperCase());\n      } catch {\n        // fallback for non-secure contexts\n        const ta = document.createElement('textarea');\n        ta.value = hex.toUpperCase();\n        ta.style.position = 'fixed'; ta.style.opacity = '0';\n        document.body.appendChild(ta);\n        ta.select(); document.execCommand('copy');\n        document.body.removeChild(ta);\n      }\n      showToast(index);\n    }\n\n    function showToast(index) {\n      const toast = document.getElementById(`toast-${index}`);\n      if (!toast) return;\n      toast.style.opacity = '';\n      toast.classList.remove('copied-toast');\n      // Force reflow\n      void toast.offsetWidth;\n      toast.classList.add('copied-toast');\n      toast.addEventListener('animationend', () => {\n        toast.style.opacity = '0';\n        toast.classList.remove('copied-toast');\n      }, { once: true });\n    }\n\n    // ─── Init ─────────────────────────────────────────────────────────────────\n\n    document.getElementById('generateBtn').addEventListener('click', generate);\n\n    // Generate on load\n    generate();\n  </script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Color Palette Generator",
    "windowTitle": "Color Palette Generator",
    "bundleId": "com.halisonworks.colorpalette",
    "iconPath": null
  },
  "categoryId": null,
  "source": "import",
  "createdAt": "2026-06-02T12:00:00.000Z",
  "updatedAt": "2026-06-02T12:00:00.000Z",
  "sharedAt": "2026-06-02T12:00:00.000Z"
}
