{
  "schema": "app-studio/canvas@1",
  "id": "example-cap-table-simulator",
  "name": "cap-table-simulator.html",
  "code": "<!DOCTYPE html>\n<!--\n  Cap Table Simulator — Halison App Studio example\n\n  Model funding rounds and option pools and watch ownership dilute across Seed,\n  Series A and beyond. Add shareholders and rounds; saves to your browser.\n\n  From the Halison App Studio public library:\n  https://github.com/halisonworks/public-app-studio\n\n  Permitted use: personal, educational, and other non-commercial use. You may\n  modify it, but keep this header and the source link intact, and do not sell,\n  commercialize, or republish it. Released under the Halison App Studio Examples\n  License — see the LICENSE file in the repository above.\n-->\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Cap Table Simulator</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    body { font-family: 'Inter', system-ui, sans-serif; }\n    .section-card { @apply bg-white rounded-xl shadow border border-gray-100 p-6 mb-6; }\n    input[type=\"number\"]::-webkit-inner-spin-button,\n    input[type=\"number\"]::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }\n    input[type=\"number\"] { -moz-appearance: textfield; }\n    .tab-active { @apply border-b-2 border-indigo-600 text-indigo-700 font-semibold; }\n    .tab-inactive { @apply text-gray-500 hover:text-gray-700; }\n    tr:nth-child(even) td { background: #f9fafb; }\n    .tooltip { position: relative; display: inline-block; }\n    .tooltip .tip-text {\n      visibility: hidden; width: 220px; background: #1e293b; color: #fff;\n      text-align: left; border-radius: 6px; padding: 8px 10px; font-size: 12px;\n      position: absolute; z-index: 99; left: 50%; top: 130%; transform: translateX(-50%);\n      pointer-events: none; opacity: 0; transition: opacity 0.15s;\n    }\n    .tooltip:hover .tip-text { visibility: visible; opacity: 1; }\n    .stacked-bar-label { font-size: 10px; dominant-baseline: middle; }\n  </style>\n</head>\n<body class=\"bg-gray-50 min-h-screen\">\n\n<!-- HEADER -->\n<header class=\"bg-white border-b border-gray-200 sticky top-0 z-30 shadow-sm\">\n  <div class=\"max-w-7xl mx-auto px-4 py-3 flex items-center justify-between\">\n    <div class=\"flex items-center gap-3\">\n      <span class=\"text-2xl font-bold text-indigo-700 tracking-tight\">Cap Table</span>\n      <span class=\"text-xs bg-indigo-100 text-indigo-600 rounded-full px-2 py-0.5 font-medium\">Simulator</span>\n    </div>\n    <div class=\"text-xs text-gray-400 hidden sm:block\">Saves to your browser · No backend</div>\n  </div>\n</header>\n\n<!-- MAIN -->\n<main class=\"max-w-7xl mx-auto px-4 py-6\">\n\n  <!-- SHAREHOLDERS SECTION -->\n  <div class=\"bg-white rounded-xl shadow border border-gray-100 p-6 mb-6\">\n    <div class=\"flex items-center justify-between mb-4\">\n      <div>\n        <h2 class=\"text-lg font-bold text-gray-800\">Shareholders at Founding</h2>\n        <p class=\"text-xs text-gray-500 mt-0.5\">Enter initial shares (absolute) or percentages. Percentages must sum to 100%.</p>\n      </div>\n      <button onclick=\"addShareholder()\" class=\"bg-indigo-600 hover:bg-indigo-700 text-white text-sm px-3 py-1.5 rounded-lg transition font-medium\">+ Add</button>\n    </div>\n    <div class=\"overflow-x-auto\">\n      <table class=\"w-full text-sm\" id=\"shareholders-table\">\n        <thead>\n          <tr class=\"text-left text-gray-500 text-xs border-b border-gray-100\">\n            <th class=\"pb-2 pr-4 font-medium\">Name</th>\n            <th class=\"pb-2 pr-4 font-medium\">Type</th>\n            <th class=\"pb-2 pr-4 font-medium w-40\">Value</th>\n            <th class=\"pb-2 font-medium\">Actions</th>\n          </tr>\n        </thead>\n        <tbody id=\"shareholders-body\"></tbody>\n      </table>\n    </div>\n    <div class=\"mt-3 flex items-center gap-4\">\n      <span class=\"text-xs text-gray-500\">Total founding shares: <strong id=\"total-founding-shares\" class=\"text-gray-700\">—</strong></span>\n      <span class=\"text-xs text-gray-500\">Pre-seed total: <strong id=\"total-founding-pct\" class=\"text-indigo-600\">—</strong></span>\n    </div>\n  </div>\n\n  <!-- FUNDING ROUNDS SECTION -->\n  <div class=\"bg-white rounded-xl shadow border border-gray-100 p-6 mb-6\">\n    <div class=\"flex items-center justify-between mb-4\">\n      <div>\n        <h2 class=\"text-lg font-bold text-gray-800\">Funding Rounds</h2>\n        <p class=\"text-xs text-gray-500 mt-0.5\">Rounds are applied sequentially. Option pool is created <em>pre-money</em> (diluting existing holders before the investor buys in).</p>\n      </div>\n      <button onclick=\"addRound()\" class=\"bg-emerald-600 hover:bg-emerald-700 text-white text-sm px-3 py-1.5 rounded-lg transition font-medium\">+ Add Round</button>\n    </div>\n    <div id=\"rounds-container\"></div>\n  </div>\n\n  <!-- RESULTS TABS -->\n  <div class=\"bg-white rounded-xl shadow border border-gray-100 p-6 mb-6\">\n    <div class=\"flex gap-6 border-b border-gray-100 mb-5\">\n      <button onclick=\"showTab('table')\" id=\"tab-table\" class=\"pb-2 text-sm transition tab-active\">Ownership Table</button>\n      <button onclick=\"showTab('chart')\" id=\"tab-chart\" class=\"pb-2 text-sm transition tab-inactive\">Ownership Chart</button>\n      <button onclick=\"showTab('rounds')\" id=\"tab-rounds\" class=\"pb-2 text-sm transition tab-inactive\">Round Details</button>\n    </div>\n\n    <!-- TAB: TABLE -->\n    <div id=\"panel-table\">\n      <div class=\"overflow-x-auto\">\n        <table class=\"w-full text-xs\" id=\"cap-table-result\">\n          <thead id=\"cap-table-head\"></thead>\n          <tbody id=\"cap-table-body\"></tbody>\n        </table>\n      </div>\n    </div>\n\n    <!-- TAB: CHART -->\n    <div id=\"panel-chart\" class=\"hidden\">\n      <p class=\"text-xs text-gray-500 mb-3\">100% stacked ownership across rounds. Hover bars for values.</p>\n      <div id=\"chart-container\" class=\"overflow-x-auto\"></div>\n    </div>\n\n    <!-- TAB: ROUND DETAILS -->\n    <div id=\"panel-rounds\" class=\"hidden\">\n      <div id=\"round-details-container\"></div>\n    </div>\n  </div>\n\n</main>\n\n<!-- MODAL: Edit Shareholder -->\n<div id=\"sh-modal\" class=\"fixed inset-0 bg-black/40 z-50 flex items-center justify-center hidden\">\n  <div class=\"bg-white rounded-xl shadow-xl p-6 w-full max-w-sm mx-4\">\n    <h3 class=\"font-bold text-gray-800 mb-4\" id=\"sh-modal-title\">Edit Shareholder</h3>\n    <div class=\"space-y-3\">\n      <div>\n        <label class=\"block text-xs text-gray-500 mb-1\">Name</label>\n        <input id=\"sh-name\" type=\"text\" class=\"w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400\" placeholder=\"e.g. Alice Chen\" />\n      </div>\n      <div>\n        <label class=\"block text-xs text-gray-500 mb-1\">Type</label>\n        <select id=\"sh-type\" class=\"w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400\">\n          <option value=\"founder\">Founder</option>\n          <option value=\"employee\">Employee / Option Pool</option>\n          <option value=\"investor\">Investor</option>\n          <option value=\"advisor\">Advisor</option>\n          <option value=\"other\">Other</option>\n        </select>\n      </div>\n      <div>\n        <label class=\"block text-xs text-gray-500 mb-1\">Input mode</label>\n        <select id=\"sh-mode\" onchange=\"toggleShMode()\" class=\"w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400\">\n          <option value=\"shares\">Shares (absolute)</option>\n          <option value=\"pct\">Percentage (%)</option>\n        </select>\n      </div>\n      <div id=\"sh-shares-field\">\n        <label class=\"block text-xs text-gray-500 mb-1\">Number of shares</label>\n        <input id=\"sh-shares\" type=\"number\" min=\"0\" class=\"w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400\" placeholder=\"e.g. 4000000\" />\n      </div>\n      <div id=\"sh-pct-field\" class=\"hidden\">\n        <label class=\"block text-xs text-gray-500 mb-1\">Ownership %</label>\n        <input id=\"sh-pct\" type=\"number\" min=\"0\" max=\"100\" step=\"0.1\" class=\"w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400\" placeholder=\"e.g. 50\" />\n      </div>\n    </div>\n    <div class=\"flex gap-3 mt-5\">\n      <button onclick=\"saveShareholder()\" class=\"flex-1 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg py-2 text-sm font-medium transition\">Save</button>\n      <button onclick=\"closeShModal()\" class=\"flex-1 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg py-2 text-sm font-medium transition\">Cancel</button>\n    </div>\n  </div>\n</div>\n\n<!-- MODAL: Edit Round -->\n<div id=\"round-modal\" class=\"fixed inset-0 bg-black/40 z-50 flex items-center justify-center hidden\">\n  <div class=\"bg-white rounded-xl shadow-xl p-6 w-full max-w-md mx-4\">\n    <h3 class=\"font-bold text-gray-800 mb-4\" id=\"round-modal-title\">Edit Funding Round</h3>\n    <div class=\"space-y-3\">\n      <div>\n        <label class=\"block text-xs text-gray-500 mb-1\">Round name</label>\n        <input id=\"r-name\" type=\"text\" class=\"w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-400\" placeholder=\"e.g. Seed, Series A\" />\n      </div>\n      <div class=\"grid grid-cols-2 gap-3\">\n        <div>\n          <label class=\"block text-xs text-gray-500 mb-1\">\n            Investment ($)\n            <span class=\"tooltip ml-1 cursor-help text-gray-400\">&#9432;<span class=\"tip-text\">Amount the new investor puts in. This buys new shares at the price per share implied by the pre-money valuation.</span></span>\n          </label>\n          <input id=\"r-investment\" type=\"number\" min=\"0\" class=\"w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-400\" placeholder=\"e.g. 1500000\" />\n        </div>\n        <div>\n          <label class=\"block text-xs text-gray-500 mb-1\">\n            Pre-money valuation ($)\n            <span class=\"tooltip ml-1 cursor-help text-gray-400\">&#9432;<span class=\"tip-text\">Value of the company before this investment. Post-money = pre-money + investment.</span></span>\n          </label>\n          <input id=\"r-premoney\" type=\"number\" min=\"0\" class=\"w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-400\" placeholder=\"e.g. 8000000\" />\n        </div>\n      </div>\n      <div>\n        <label class=\"block text-xs text-gray-500 mb-1\">\n          New option pool (% of post-money, created pre-money)\n          <span class=\"tooltip ml-1 cursor-help text-gray-400\">&#9432;<span class=\"tip-text\">Shares reserved for a new option pool, expressed as % of post-money total shares. Created pre-money, so existing holders dilute before the investor price is set.</span></span>\n        </label>\n        <input id=\"r-optpool\" type=\"number\" min=\"0\" max=\"30\" step=\"0.1\" class=\"w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-400\" placeholder=\"e.g. 10 (leave blank for none)\" />\n      </div>\n      <div>\n        <label class=\"block text-xs text-gray-500 mb-1\">Investor name</label>\n        <input id=\"r-investor\" type=\"text\" class=\"w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-400\" placeholder=\"e.g. Benchmark Capital\" />\n      </div>\n    </div>\n    <div class=\"flex gap-3 mt-5\">\n      <button onclick=\"saveRound()\" class=\"flex-1 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg py-2 text-sm font-medium transition\">Save</button>\n      <button onclick=\"closeRoundModal()\" class=\"flex-1 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg py-2 text-sm font-medium transition\">Cancel</button>\n    </div>\n  </div>\n</div>\n\n<script>\n// ─── STATE ───────────────────────────────────────────────────────────────────\nlet state = {\n  shareholders: [],\n  rounds: []\n};\n\nlet shEditIdx = null;\nlet roundEditIdx = null;\n\n// ─── DEFAULTS ────────────────────────────────────────────────────────────────\nconst DEFAULT_STATE = {\n  shareholders: [\n    { id: 's1', name: 'Alice Chen', type: 'founder', mode: 'shares', shares: 4000000, pct: null },\n    { id: 's2', name: 'Bob Martinez', type: 'founder', mode: 'shares', shares: 4000000, pct: null },\n    { id: 's3', name: 'Founding Option Pool', type: 'employee', mode: 'shares', shares: 2000000, pct: null }\n  ],\n  rounds: [\n    {\n      id: 'r1', name: 'Seed', investment: 1500000, preMoney: 8000000,\n      optPoolPct: 0, investor: 'Angel Syndicate'\n    },\n    {\n      id: 'r2', name: 'Series A', investment: 8000000, preMoney: 24000000,\n      optPoolPct: 10, investor: 'Benchmark Capital'\n    }\n  ]\n};\n\n// ─── PERSISTENCE ─────────────────────────────────────────────────────────────\nfunction saveState() {\n  try { localStorage.setItem('cap_table_v2', JSON.stringify(state)); } catch(e) {}\n}\n\nfunction loadState() {\n  try {\n    const raw = localStorage.getItem('cap_table_v2');\n    if (raw) {\n      const parsed = JSON.parse(raw);\n      if (parsed && parsed.shareholders && parsed.rounds) {\n        state = parsed;\n        return;\n      }\n    }\n  } catch(e) {}\n  state = JSON.parse(JSON.stringify(DEFAULT_STATE));\n}\n\n// ─── ID GENERATOR ────────────────────────────────────────────────────────────\nfunction uid() { return Math.random().toString(36).slice(2, 9); }\n\n// ─── COLOR PALETTE ───────────────────────────────────────────────────────────\nconst COLORS = [\n  '#6366f1','#10b981','#f59e0b','#ef4444','#3b82f6','#a855f7','#ec4899',\n  '#14b8a6','#f97316','#84cc16','#06b6d4','#e11d48','#7c3aed','#059669'\n];\nfunction colorFor(idx) { return COLORS[idx % COLORS.length]; }\n\n// ─── MATH ENGINE ─────────────────────────────────────────────────────────────\n/*\n * Standard pre-money dilution with pre-money option pool expansion:\n *\n * 1. Start with current total shares = sum of all existing shares.\n * 2. If optPoolPct > 0: we want option-pool shares = optPoolPct% of POST-money shares.\n *    Let S = current shares, P = option pool %, I = investment, V_pre = pre-money val.\n *    Post-money shares = S + newPool + newInvestorShares\n *    Price per share   = V_pre / (S + newPool)           [pre-money expansion]\n *    newInvestorShares = I / pricePerShare\n *    We solve:  newPool / (S + newPool + I/pricePerShare) = P/100\n *             = newPool / (S + newPool + I*(S+newPool)/V_pre) = P/100\n *    Let T = S + newPool\n *    newPool / (T + I*T/V_pre) = P/100\n *    newPool / (T*(1 + I/V_pre)) = P/100\n *    newPool / (T * postMoneySF) = P/100   where postMoneySF = postMoney/V_pre\n *    → T * postMoneySF * P/100 = newPool * postMoneySF ... simplify:\n *    Actually direct formula:\n *    postMoney = preMoney + investment\n *    newPool   = P/100 * postMoney/preMoney * S  — THIS is the standard VC pre-money expand.\n *    More precisely:\n *      After expansion: pre-money diluted shares = S + newPool\n *      PPS = preMoney / (S + newPool)\n *      investorShares = investment / PPS\n *      postMoneyShares = S + newPool + investorShares\n *      Check: newPool / postMoneyShares should ≈ P/100 (it does if we solve correctly)\n *\n *    Standard formula for pre-money option pool:\n *      newPool = (P/100 * (preMoney + investment) / preMoney) * S\n *    Derivation:\n *      We want: newPool / (S + newPool + investorShares) = P/100\n *      investorShares = investment * (S + newPool) / preMoney\n *      Let X = S + newPool\n *      newPool / (X + investment*X/preMoney) = P/100\n *      newPool / (X * (1 + investment/preMoney)) = P/100\n *      newPool / (X * postMoney/preMoney) = P/100\n *      (X - S) / (X * postMoney/preMoney) = P/100\n *      1 - S/X = P/100 * postMoney/preMoney\n *      S/X = 1 - P*postMoney/(100*preMoney)\n *      X = S / (1 - P*postMoney/(100*preMoney))\n *      newPool = X - S = S * (P*postMoney/(100*preMoney)) / (1 - P*postMoney/(100*preMoney))\n */\n\nfunction computeCapTable() {\n  // Resolve founding shares\n  const founders = state.shareholders.map(sh => ({ ...sh }));\n  let totalPctMode = founders.filter(s => s.mode === 'pct').reduce((a, s) => a + (s.pct || 0), 0);\n  let totalSharesMode = founders.filter(s => s.mode === 'shares').reduce((a, s) => a + (s.shares || 0), 0);\n\n  // If any are pct-mode, we need a base shares count.\n  // Strategy: shares-mode defines absolute shares; pct-mode holders\n  // get their pct of the combined total. We derive total from shares-mode holders\n  // and pct-mode holders' percentages.\n  // total = sharesTotal / (1 - totalPct/100)\n  let baseTotal;\n  if (totalSharesMode === 0 && totalPctMode > 0) {\n    baseTotal = 10000000; // default 10M if all pct-mode\n  } else if (totalPctMode === 0) {\n    baseTotal = totalSharesMode;\n  } else {\n    baseTotal = totalSharesMode / (1 - totalPctMode / 100);\n  }\n  if (!isFinite(baseTotal) || baseTotal <= 0) baseTotal = 10000000;\n\n  // Assign actual founding shares\n  const sharesMap = {}; // id -> shares at each stage\n  founders.forEach(sh => {\n    sharesMap[sh.id] = sh.mode === 'shares'\n      ? (sh.shares || 0)\n      : Math.round((sh.pct || 0) / 100 * baseTotal);\n  });\n\n  // Round stages\n  const stages = []; // { label, sharesMap snapshot, roundInfo? }\n\n  // Stage 0: Founding\n  stages.push({\n    label: 'Founding',\n    shares: { ...sharesMap },\n    roundInfo: null\n  });\n\n  // Process rounds\n  let currentShares = { ...sharesMap };\n  // Option pool tracker (per option-pool item created in rounds)\n  let nextPoolId = 1;\n\n  state.rounds.forEach((round) => {\n    const preMoney = round.preMoney;\n    const investment = round.investment;\n    const optPoolPct = round.optPoolPct || 0;\n    const postMoney = preMoney + investment;\n\n    // Current total shares before this round\n    let totalBefore = Object.values(currentShares).reduce((a, b) => a + b, 0);\n\n    // Compute new option pool (pre-money expansion)\n    let newPoolShares = 0;\n    let poolId = null;\n    if (optPoolPct > 0) {\n      // newPool = S * (P*postMoney/(100*preMoney)) / (1 - P*postMoney/(100*preMoney))\n      const factor = (optPoolPct / 100) * (postMoney / preMoney);\n      if (factor < 1) {\n        newPoolShares = Math.round(totalBefore * factor / (1 - factor));\n      } else {\n        newPoolShares = Math.round(totalBefore * 0.25); // fallback cap\n      }\n      poolId = 'pool_r_' + round.id;\n    }\n\n    // Pre-money diluted total (after adding option pool)\n    const totalPreExpanded = totalBefore + newPoolShares;\n\n    // Price per share\n    const pps = preMoney / totalPreExpanded;\n\n    // New investor shares\n    const investorShares = Math.round(investment / pps);\n\n    // Post-money total\n    const totalPost = totalPreExpanded + investorShares;\n\n    // Assign new option pool\n    if (poolId && newPoolShares > 0) {\n      currentShares[poolId] = (currentShares[poolId] || 0) + newPoolShares;\n    }\n\n    // Assign investor shares\n    const investorId = 'inv_' + round.id;\n    currentShares[investorId] = investorShares;\n\n    stages.push({\n      label: round.name,\n      shares: { ...currentShares },\n      roundInfo: {\n        roundId: round.id,\n        roundName: round.name,\n        investor: round.investor,\n        preMoney,\n        investment,\n        postMoney,\n        optPoolPct,\n        newPoolShares,\n        poolId,\n        pps,\n        investorShares,\n        totalBefore,\n        totalPreExpanded,\n        totalPost\n      }\n    });\n  });\n\n  return { stages, sharesMap };\n}\n\n// All stakeholders across all stages (including pool/investor entries added by rounds)\nfunction getAllStakeholderIds(stages) {\n  const seen = new Set();\n  stages.forEach(st => Object.keys(st.shares).forEach(id => seen.add(id)));\n  return Array.from(seen);\n}\n\nfunction getStakeholderLabel(id) {\n  // Check founders\n  const found = state.shareholders.find(s => s.id === id);\n  if (found) return found.name;\n  // Round investor\n  const invMatch = id.match(/^inv_(.+)$/);\n  if (invMatch) {\n    const r = state.rounds.find(r => r.id === invMatch[1]);\n    return r ? (r.investor || r.name + ' Investor') : 'Investor';\n  }\n  // Option pool\n  const poolMatch = id.match(/^pool_r_(.+)$/);\n  if (poolMatch) {\n    const r = state.rounds.find(r => r.id === poolMatch[1]);\n    return r ? (r.name + ' Option Pool') : 'Option Pool';\n  }\n  return id;\n}\n\nfunction getStakeholderOrder(id) {\n  // founders first, then pools, then investors (by round order)\n  const foundIdx = state.shareholders.findIndex(s => s.id === id);\n  if (foundIdx >= 0) return foundIdx;\n  const invMatch = id.match(/^inv_(.+)$/);\n  if (invMatch) {\n    const rIdx = state.rounds.findIndex(r => r.id === invMatch[1]);\n    return 1000 + rIdx * 2 + 1;\n  }\n  const poolMatch = id.match(/^pool_r_(.+)$/);\n  if (poolMatch) {\n    const rIdx = state.rounds.findIndex(r => r.id === poolMatch[1]);\n    return 1000 + rIdx * 2;\n  }\n  return 9999;\n}\n\n// ─── RENDER SHAREHOLDERS TABLE ───────────────────────────────────────────────\nfunction renderShareholders() {\n  const tbody = document.getElementById('shareholders-body');\n  tbody.innerHTML = '';\n  let totalShares = 0, totalPct = 0;\n  state.shareholders.forEach((sh, idx) => {\n    if (sh.mode === 'shares') totalShares += sh.shares || 0;\n    else totalPct += sh.pct || 0;\n    const tr = document.createElement('tr');\n    tr.className = 'border-b border-gray-50';\n    tr.innerHTML = `\n      <td class=\"py-2 pr-4 font-medium text-gray-800\">${escHtml(sh.name)}</td>\n      <td class=\"py-2 pr-4\">\n        <span class=\"text-xs px-2 py-0.5 rounded-full ${typeColor(sh.type)}\">${capitalize(sh.type)}</span>\n      </td>\n      <td class=\"py-2 pr-4 text-gray-600 text-xs\">\n        ${sh.mode === 'shares'\n          ? fmtNum(sh.shares) + ' shares'\n          : fmtPct(sh.pct) + '%'}\n      </td>\n      <td class=\"py-2\">\n        <button onclick=\"editShareholder(${idx})\" class=\"text-indigo-500 hover:text-indigo-700 text-xs mr-3 transition\">Edit</button>\n        <button onclick=\"removeShareholder(${idx})\" class=\"text-red-400 hover:text-red-600 text-xs transition\">Remove</button>\n      </td>\n    `;\n    tbody.appendChild(tr);\n  });\n\n  // Totals\n  const allShares = state.shareholders.filter(s => s.mode === 'shares');\n  const allPcts   = state.shareholders.filter(s => s.mode === 'pct');\n  document.getElementById('total-founding-shares').textContent =\n    allShares.length ? fmtNum(allShares.reduce((a,s)=>a+(s.shares||0),0)) + ' shares' : '—';\n  document.getElementById('total-founding-pct').textContent =\n    allPcts.length ? fmtPct(allPcts.reduce((a,s)=>a+(s.pct||0),0)) + '%' : '100%';\n}\n\n// ─── RENDER ROUNDS LIST ──────────────────────────────────────────────────────\nfunction renderRounds() {\n  const container = document.getElementById('rounds-container');\n  if (state.rounds.length === 0) {\n    container.innerHTML = '<p class=\"text-sm text-gray-400 italic\">No funding rounds yet. Click \"+ Add Round\" to add one.</p>';\n    return;\n  }\n  container.innerHTML = state.rounds.map((r, idx) => `\n    <div class=\"flex items-start gap-4 p-4 rounded-lg border border-gray-100 mb-3 bg-gray-50\">\n      <div class=\"flex-shrink-0 w-8 h-8 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-700 font-bold text-sm\">${idx+1}</div>\n      <div class=\"flex-1 min-w-0\">\n        <div class=\"flex items-center gap-2 flex-wrap\">\n          <span class=\"font-semibold text-gray-800\">${escHtml(r.name)}</span>\n          ${r.investor ? `<span class=\"text-xs text-gray-400\">· ${escHtml(r.investor)}</span>` : ''}\n        </div>\n        <div class=\"grid grid-cols-2 sm:grid-cols-4 gap-2 mt-2 text-xs text-gray-600\">\n          <div><span class=\"text-gray-400\">Investment</span><br/><strong>$${fmtMoney(r.investment)}</strong></div>\n          <div><span class=\"text-gray-400\">Pre-money</span><br/><strong>$${fmtMoney(r.preMoney)}</strong></div>\n          <div><span class=\"text-gray-400\">Post-money</span><br/><strong>$${fmtMoney(r.preMoney + r.investment)}</strong></div>\n          <div><span class=\"text-gray-400\">New option pool</span><br/><strong>${r.optPoolPct > 0 ? r.optPoolPct + '%' : 'None'}</strong></div>\n        </div>\n      </div>\n      <div class=\"flex gap-2 flex-shrink-0\">\n        <button onclick=\"editRound(${idx})\" class=\"text-emerald-600 hover:text-emerald-800 text-xs transition\">Edit</button>\n        <button onclick=\"removeRound(${idx})\" class=\"text-red-400 hover:text-red-600 text-xs transition\">Remove</button>\n      </div>\n    </div>\n  `).join('');\n}\n\n// ─── RENDER CAP TABLE ────────────────────────────────────────────────────────\nfunction renderCapTable() {\n  const { stages } = computeCapTable();\n  const allIds = getAllStakeholderIds(stages).sort((a,b) => getStakeholderOrder(a) - getStakeholderOrder(b));\n\n  // HEAD\n  const thead = document.getElementById('cap-table-head');\n  thead.innerHTML = `<tr class=\"text-left text-xs text-gray-500 border-b border-gray-200\">\n    <th class=\"pb-2 pr-3 font-medium sticky left-0 bg-white\">Stakeholder</th>\n    ${stages.map(st => `<th class=\"pb-2 pr-3 font-medium text-center whitespace-nowrap\">${escHtml(st.label)}</th>`).join('')}\n  </tr>`;\n\n  // BODY\n  const tbody = document.getElementById('cap-table-body');\n  tbody.innerHTML = '';\n  allIds.forEach((id, rowIdx) => {\n    const tr = document.createElement('tr');\n    tr.className = 'border-b border-gray-50 text-xs';\n    let cells = `<td class=\"py-1.5 pr-3 font-medium text-gray-700 sticky left-0 bg-white whitespace-nowrap\">${escHtml(getStakeholderLabel(id))}</td>`;\n    stages.forEach(st => {\n      const total = Object.values(st.shares).reduce((a,b)=>a+b,0);\n      const sh = st.shares[id] || 0;\n      const pct = total > 0 ? sh / total * 100 : 0;\n      cells += `<td class=\"py-1.5 pr-3 text-center whitespace-nowrap\">\n        ${sh > 0 ? `<span class=\"font-semibold text-gray-800\">${fmtPct(pct)}%</span><br/><span class=\"text-gray-400\">${fmtNum(sh)}</span>` : '<span class=\"text-gray-300\">—</span>'}\n      </td>`;\n    });\n    tr.innerHTML = cells;\n    tbody.appendChild(tr);\n  });\n\n  // Totals row\n  const tfooter = document.createElement('tr');\n  tfooter.className = 'border-t-2 border-gray-200 text-xs font-bold bg-gray-50';\n  let fcells = `<td class=\"py-1.5 pr-3 text-gray-700\">Total</td>`;\n  stages.forEach(st => {\n    const total = Object.values(st.shares).reduce((a,b)=>a+b,0);\n    fcells += `<td class=\"py-1.5 pr-3 text-center text-gray-700\">${fmtNum(total)}</td>`;\n  });\n  tfooter.innerHTML = fcells;\n  tbody.appendChild(tfooter);\n}\n\n// ─── RENDER CHART ─────────────────────────────────────────────────────────────\nfunction renderChart() {\n  const { stages } = computeCapTable();\n  const allIds = getAllStakeholderIds(stages).sort((a,b) => getStakeholderOrder(a) - getStakeholderOrder(b));\n  const container = document.getElementById('chart-container');\n\n  if (stages.length === 0) {\n    container.innerHTML = '<p class=\"text-sm text-gray-400\">No data.</p>';\n    return;\n  }\n\n  const BAR_W = 80;\n  const GAP = 36;\n  const H = 320;\n  const TOP = 20;\n  const BOT = 50;\n  const LEFT = 10;\n  const RIGHT = 20;\n  const chartH = H - TOP - BOT;\n  const totalW = LEFT + stages.length * (BAR_W + GAP) + RIGHT;\n\n  // Build pct arrays per stage per stakeholder\n  const data = stages.map(st => {\n    const total = Object.values(st.shares).reduce((a,b)=>a+b,0);\n    return allIds.map(id => total > 0 ? (st.shares[id] || 0) / total * 100 : 0);\n  });\n\n  // SVG\n  let svg = `<svg width=\"${totalW}\" height=\"${H}\" xmlns=\"http://www.w3.org/2000/svg\" style=\"min-width:${totalW}px\">`;\n\n  // Y-axis lines\n  for (let pct = 0; pct <= 100; pct += 25) {\n    const y = TOP + chartH - (pct / 100 * chartH);\n    svg += `<line x1=\"${LEFT}\" y1=\"${y}\" x2=\"${totalW - RIGHT}\" y2=\"${y}\" stroke=\"#e5e7eb\" stroke-width=\"1\"/>`;\n    svg += `<text x=\"${LEFT}\" y=\"${y - 3}\" font-size=\"9\" fill=\"#9ca3af\">${pct}%</text>`;\n  }\n\n  // Bars\n  stages.forEach((st, sIdx) => {\n    const x = LEFT + sIdx * (BAR_W + GAP) + 20;\n    let yOff = TOP + chartH;\n\n    allIds.forEach((id, iIdx) => {\n      const pct = data[sIdx][iIdx];\n      if (pct < 0.1) return;\n      const barH = (pct / 100) * chartH;\n      yOff -= barH;\n      const color = colorFor(iIdx);\n      svg += `<rect x=\"${x}\" y=\"${yOff}\" width=\"${BAR_W}\" height=\"${barH}\" fill=\"${color}\" rx=\"0\">\n        <title>${escHtml(getStakeholderLabel(id))}: ${fmtPct(pct)}%</title>\n      </rect>`;\n      // Label inside bar if tall enough\n      if (barH > 14) {\n        svg += `<text x=\"${x + BAR_W/2}\" y=\"${yOff + barH/2}\" text-anchor=\"middle\" fill=\"white\" font-size=\"9\" font-weight=\"600\" dominant-baseline=\"middle\">${fmtPct(pct)}%</text>`;\n      }\n    });\n\n    // Stage label\n    svg += `<text x=\"${x + BAR_W/2}\" y=\"${TOP + chartH + 14}\" text-anchor=\"middle\" font-size=\"10\" fill=\"#374151\" font-weight=\"600\">${escHtml(st.label)}</text>`;\n  });\n\n  // Legend\n  const legendY = TOP + chartH + 32;\n  let legendX = LEFT + 20;\n  allIds.forEach((id, iIdx) => {\n    const color = colorFor(iIdx);\n    const label = getStakeholderLabel(id);\n    const labelShort = label.length > 18 ? label.slice(0,16)+'…' : label;\n    svg += `<rect x=\"${legendX}\" y=\"${legendY}\" width=\"10\" height=\"10\" fill=\"${color}\" rx=\"2\"/>`;\n    svg += `<text x=\"${legendX + 13}\" y=\"${legendY + 8}\" font-size=\"9\" fill=\"#6b7280\">${escHtml(labelShort)}</text>`;\n    legendX += Math.max(labelShort.length * 5.5 + 18, 80);\n    if (legendX > totalW - 80) legendX = LEFT + 20; // wrap (simple)\n  });\n\n  svg += '</svg>';\n\n  container.innerHTML = svg;\n}\n\n// ─── RENDER ROUND DETAILS ────────────────────────────────────────────────────\nfunction renderRoundDetails() {\n  const { stages } = computeCapTable();\n  const container = document.getElementById('round-details-container');\n\n  const roundStages = stages.filter(s => s.roundInfo !== null);\n  if (roundStages.length === 0) {\n    container.innerHTML = '<p class=\"text-sm text-gray-400\">No funding rounds yet.</p>';\n    return;\n  }\n\n  container.innerHTML = roundStages.map(st => {\n    const ri = st.roundInfo;\n    return `\n    <div class=\"mb-5 p-4 rounded-xl border border-gray-100 bg-gray-50\">\n      <h3 class=\"font-bold text-gray-800 mb-3 flex items-center gap-2\">\n        <span class=\"text-base\">${escHtml(ri.roundName)}</span>\n        <span class=\"text-xs text-gray-400 font-normal\">${ri.investor ? '· ' + escHtml(ri.investor) : ''}</span>\n      </h3>\n      <div class=\"grid grid-cols-2 sm:grid-cols-3 gap-3 text-sm\">\n        <div class=\"bg-white rounded-lg p-3 border border-gray-100\">\n          <div class=\"text-xs text-gray-400 mb-1\">Pre-money valuation</div>\n          <div class=\"font-bold text-gray-800\">$${fmtMoney(ri.preMoney)}</div>\n        </div>\n        <div class=\"bg-white rounded-lg p-3 border border-gray-100\">\n          <div class=\"text-xs text-gray-400 mb-1\">Investment</div>\n          <div class=\"font-bold text-emerald-700\">$${fmtMoney(ri.investment)}</div>\n        </div>\n        <div class=\"bg-white rounded-lg p-3 border border-gray-100\">\n          <div class=\"text-xs text-gray-400 mb-1\">Post-money valuation</div>\n          <div class=\"font-bold text-gray-800\">$${fmtMoney(ri.postMoney)}</div>\n        </div>\n        <div class=\"bg-white rounded-lg p-3 border border-gray-100\">\n          <div class=\"text-xs text-gray-400 mb-1\">Price per share</div>\n          <div class=\"font-bold text-indigo-700\">$${fmtDecimals(ri.pps)}</div>\n        </div>\n        <div class=\"bg-white rounded-lg p-3 border border-gray-100\">\n          <div class=\"text-xs text-gray-400 mb-1\">New investor shares</div>\n          <div class=\"font-bold text-gray-800\">${fmtNum(ri.investorShares)}</div>\n          <div class=\"text-xs text-gray-400\">${fmtPct(ri.investorShares / ri.totalPost * 100)}% of post</div>\n        </div>\n        ${ri.newPoolShares > 0 ? `\n        <div class=\"bg-white rounded-lg p-3 border border-gray-100\">\n          <div class=\"text-xs text-gray-400 mb-1\">New option pool</div>\n          <div class=\"font-bold text-amber-600\">${fmtNum(ri.newPoolShares)} shares</div>\n          <div class=\"text-xs text-gray-400\">${fmtPct(ri.newPoolShares / ri.totalPost * 100)}% of post</div>\n        </div>` : ''}\n        <div class=\"bg-white rounded-lg p-3 border border-gray-100\">\n          <div class=\"text-xs text-gray-400 mb-1\">Shares before round</div>\n          <div class=\"font-bold text-gray-700\">${fmtNum(ri.totalBefore)}</div>\n        </div>\n        <div class=\"bg-white rounded-lg p-3 border border-gray-100\">\n          <div class=\"text-xs text-gray-400 mb-1\">Pre-money shares (expanded)</div>\n          <div class=\"font-bold text-gray-700\">${fmtNum(ri.totalPreExpanded)}</div>\n        </div>\n        <div class=\"bg-white rounded-lg p-3 border border-gray-100\">\n          <div class=\"text-xs text-gray-400 mb-1\">Post-money shares</div>\n          <div class=\"font-bold text-gray-700\">${fmtNum(ri.totalPost)}</div>\n        </div>\n      </div>\n      <div class=\"mt-3 text-xs text-gray-400\">\n        <strong class=\"text-gray-500\">Math:</strong>\n        PPS = pre-money / pre-expanded shares = $${fmtMoney(ri.preMoney)} / ${fmtNum(ri.totalPreExpanded)} = $${fmtDecimals(ri.pps)} &nbsp;·&nbsp;\n        Investor ownership = investment / post-money = ${fmtPct(ri.investment / ri.postMoney * 100)}%\n      </div>\n    </div>`;\n  }).join('');\n}\n\n// ─── FULL RENDER ─────────────────────────────────────────────────────────────\nfunction render() {\n  renderShareholders();\n  renderRounds();\n  renderCapTable();\n  renderChart();\n  renderRoundDetails();\n}\n\n// ─── TABS ─────────────────────────────────────────────────────────────────────\nfunction showTab(tab) {\n  ['table','chart','rounds'].forEach(t => {\n    document.getElementById('panel-' + t).classList.toggle('hidden', t !== tab);\n    const btn = document.getElementById('tab-' + t);\n    if (t === tab) {\n      btn.classList.add('tab-active'); btn.classList.remove('tab-inactive');\n    } else {\n      btn.classList.remove('tab-active'); btn.classList.add('tab-inactive');\n    }\n  });\n}\n\n// ─── SHAREHOLDER MODAL ───────────────────────────────────────────────────────\nfunction addShareholder() {\n  shEditIdx = null;\n  document.getElementById('sh-modal-title').textContent = 'Add Shareholder';\n  document.getElementById('sh-name').value = '';\n  document.getElementById('sh-type').value = 'founder';\n  document.getElementById('sh-mode').value = 'shares';\n  document.getElementById('sh-shares').value = '';\n  document.getElementById('sh-pct').value = '';\n  toggleShMode();\n  document.getElementById('sh-modal').classList.remove('hidden');\n}\n\nfunction editShareholder(idx) {\n  shEditIdx = idx;\n  const sh = state.shareholders[idx];\n  document.getElementById('sh-modal-title').textContent = 'Edit Shareholder';\n  document.getElementById('sh-name').value = sh.name;\n  document.getElementById('sh-type').value = sh.type;\n  document.getElementById('sh-mode').value = sh.mode;\n  document.getElementById('sh-shares').value = sh.shares || '';\n  document.getElementById('sh-pct').value = sh.pct || '';\n  toggleShMode();\n  document.getElementById('sh-modal').classList.remove('hidden');\n}\n\nfunction removeShareholder(idx) {\n  if (!confirm('Remove this shareholder?')) return;\n  state.shareholders.splice(idx, 1);\n  saveState();\n  render();\n}\n\nfunction saveShareholder() {\n  const name = document.getElementById('sh-name').value.trim();\n  if (!name) { alert('Please enter a name.'); return; }\n  const mode = document.getElementById('sh-mode').value;\n  let shares = parseFloat(document.getElementById('sh-shares').value);\n  let pct = parseFloat(document.getElementById('sh-pct').value);\n  if (mode === 'shares' && (isNaN(shares) || shares < 0)) { alert('Enter a valid number of shares.'); return; }\n  if (mode === 'pct' && (isNaN(pct) || pct <= 0 || pct > 100)) { alert('Enter a valid percentage (0–100).'); return; }\n\n  const sh = {\n    id: shEditIdx !== null ? state.shareholders[shEditIdx].id : uid(),\n    name,\n    type: document.getElementById('sh-type').value,\n    mode,\n    shares: mode === 'shares' ? Math.round(shares) : null,\n    pct: mode === 'pct' ? pct : null\n  };\n\n  if (shEditIdx !== null) {\n    state.shareholders[shEditIdx] = sh;\n  } else {\n    state.shareholders.push(sh);\n  }\n  saveState();\n  closeShModal();\n  render();\n}\n\nfunction closeShModal() {\n  document.getElementById('sh-modal').classList.add('hidden');\n}\n\nfunction toggleShMode() {\n  const mode = document.getElementById('sh-mode').value;\n  document.getElementById('sh-shares-field').classList.toggle('hidden', mode !== 'shares');\n  document.getElementById('sh-pct-field').classList.toggle('hidden', mode !== 'pct');\n}\n\n// ─── ROUND MODAL ─────────────────────────────────────────────────────────────\nfunction addRound() {\n  roundEditIdx = null;\n  document.getElementById('round-modal-title').textContent = 'Add Funding Round';\n  document.getElementById('r-name').value = '';\n  document.getElementById('r-investment').value = '';\n  document.getElementById('r-premoney').value = '';\n  document.getElementById('r-optpool').value = '';\n  document.getElementById('r-investor').value = '';\n  document.getElementById('round-modal').classList.remove('hidden');\n}\n\nfunction editRound(idx) {\n  roundEditIdx = idx;\n  const r = state.rounds[idx];\n  document.getElementById('round-modal-title').textContent = 'Edit Funding Round';\n  document.getElementById('r-name').value = r.name;\n  document.getElementById('r-investment').value = r.investment;\n  document.getElementById('r-premoney').value = r.preMoney;\n  document.getElementById('r-optpool').value = r.optPoolPct > 0 ? r.optPoolPct : '';\n  document.getElementById('r-investor').value = r.investor || '';\n  document.getElementById('round-modal').classList.remove('hidden');\n}\n\nfunction removeRound(idx) {\n  if (!confirm('Remove this funding round?')) return;\n  state.rounds.splice(idx, 1);\n  saveState();\n  render();\n}\n\nfunction saveRound() {\n  const name = document.getElementById('r-name').value.trim();\n  if (!name) { alert('Please enter a round name.'); return; }\n  const investment = parseFloat(document.getElementById('r-investment').value);\n  const preMoney = parseFloat(document.getElementById('r-premoney').value);\n  if (isNaN(investment) || investment <= 0) { alert('Enter a valid investment amount.'); return; }\n  if (isNaN(preMoney) || preMoney <= 0) { alert('Enter a valid pre-money valuation.'); return; }\n  const optRaw = document.getElementById('r-optpool').value.trim();\n  const optPoolPct = optRaw !== '' ? parseFloat(optRaw) : 0;\n  if (optPoolPct < 0 || optPoolPct >= 100) { alert('Option pool % must be between 0 and 99.'); return; }\n  const investor = document.getElementById('r-investor').value.trim();\n\n  const round = {\n    id: roundEditIdx !== null ? state.rounds[roundEditIdx].id : uid(),\n    name, investment, preMoney, optPoolPct, investor\n  };\n\n  if (roundEditIdx !== null) {\n    state.rounds[roundEditIdx] = round;\n  } else {\n    state.rounds.push(round);\n  }\n  saveState();\n  closeRoundModal();\n  render();\n}\n\nfunction closeRoundModal() {\n  document.getElementById('round-modal').classList.add('hidden');\n}\n\n// ─── UTILS ───────────────────────────────────────────────────────────────────\nfunction escHtml(str) {\n  if (!str) return '';\n  return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;');\n}\n\nfunction fmtNum(n) {\n  if (n == null || isNaN(n)) return '0';\n  return Math.round(n).toLocaleString('en-US');\n}\n\nfunction fmtPct(n) {\n  if (n == null || isNaN(n)) return '0.0';\n  return n.toFixed(1);\n}\n\nfunction fmtMoney(n) {\n  if (n == null || isNaN(n)) return '0';\n  if (n >= 1e9) return (n / 1e9).toFixed(1) + 'B';\n  if (n >= 1e6) return (n / 1e6).toFixed(1) + 'M';\n  if (n >= 1e3) return (n / 1e3).toFixed(0) + 'K';\n  return n.toFixed(0);\n}\n\nfunction fmtDecimals(n) {\n  if (n == null || isNaN(n)) return '0.00';\n  if (n < 0.01) return n.toFixed(6);\n  if (n < 1) return n.toFixed(4);\n  if (n < 100) return n.toFixed(2);\n  return n.toFixed(2);\n}\n\nfunction capitalize(s) { return s ? s.charAt(0).toUpperCase() + s.slice(1) : ''; }\n\nfunction typeColor(type) {\n  const map = {\n    founder: 'bg-indigo-100 text-indigo-700',\n    employee: 'bg-emerald-100 text-emerald-700',\n    investor: 'bg-amber-100 text-amber-700',\n    advisor: 'bg-purple-100 text-purple-700',\n    other: 'bg-gray-100 text-gray-600'\n  };\n  return map[type] || map.other;\n}\n\n// Close modals on backdrop click\ndocument.getElementById('sh-modal').addEventListener('click', function(e) {\n  if (e.target === this) closeShModal();\n});\ndocument.getElementById('round-modal').addEventListener('click', function(e) {\n  if (e.target === this) closeRoundModal();\n});\n\n// ─── BOOT ────────────────────────────────────────────────────────────────────\nloadState();\nrender();\n</script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Cap Table Simulator",
    "windowTitle": "Cap Table Simulator",
    "bundleId": "com.halisonworks.captablesimulator",
    "iconPath": null
  },
  "categoryId": null,
  "source": "import",
  "createdAt": "2026-06-02T12:00:00.000Z",
  "updatedAt": "2026-06-02T12:00:00.000Z",
  "sharedAt": "2026-06-02T12:00:00.000Z"
}
