{
  "schema": "app-studio/canvas@1",
  "id": "example-pricing-page",
  "name": "pricing-page.html",
  "code": "<!DOCTYPE html>\n<!--\n  Pricing Page — Halison App Studio example\n\n  A SaaS pricing page: three tiers with a monthly/annual toggle, a highlighted\n  plan, and a feature-comparison table.\n\n  From the Halison App Studio public library:\n  https://github.com/halisonworks/public-app-studio\n\n  Permitted use: personal, educational, and other non-commercial use. You may\n  modify it, but keep this header and the source link intact, and do not sell,\n  commercialize, or republish it. Released under the Halison App Studio Examples\n  License — see the LICENSE file in the repository above.\n-->\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Pricing — Nexus SaaS</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');\n    body { font-family: 'Inter', sans-serif; }\n    .toggle-track { transition: background-color 0.2s ease; }\n    .toggle-thumb { transition: transform 0.2s ease; }\n    .card-hover { transition: transform 0.2s ease, box-shadow 0.2s ease; }\n    .card-hover:hover { transform: translateY(-4px); }\n    .toast {\n      animation: slideIn 0.35s ease, fadeOut 0.4s ease 2.6s forwards;\n    }\n    @keyframes slideIn {\n      from { opacity: 0; transform: translateY(24px); }\n      to   { opacity: 1; transform: translateY(0); }\n    }\n    @keyframes fadeOut {\n      from { opacity: 1; }\n      to   { opacity: 0; pointer-events: none; }\n    }\n    .badge-popular {\n      background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);\n    }\n    .gradient-hero {\n      background: linear-gradient(160deg, #0f172a 0%, #1e1b4b 60%, #0f172a 100%);\n    }\n    .price-transition {\n      transition: opacity 0.2s ease, transform 0.2s ease;\n    }\n  </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 antialiased\">\n\n  <!-- Hero / Header -->\n  <section class=\"gradient-hero py-20 px-4 text-center text-white\">\n    <p class=\"text-indigo-300 text-sm font-semibold tracking-widest uppercase mb-3\">Simple, transparent pricing</p>\n    <h1 class=\"text-4xl sm:text-5xl font-extrabold tracking-tight mb-4\">Plans that scale with you</h1>\n    <p class=\"text-slate-300 text-lg max-w-xl mx-auto mb-10\">\n      Start free. Upgrade when you need to. Cancel anytime — no questions asked.\n    </p>\n\n    <!-- Billing Toggle -->\n    <div class=\"inline-flex items-center gap-3 bg-white/10 backdrop-blur rounded-full px-5 py-2.5\">\n      <span id=\"label-monthly\" class=\"text-sm font-semibold text-white\">Monthly</span>\n      <button\n        id=\"billing-toggle\"\n        role=\"switch\"\n        aria-checked=\"false\"\n        aria-label=\"Toggle annual billing\"\n        onclick=\"toggleBilling()\"\n        class=\"toggle-track relative w-12 h-6 rounded-full bg-slate-600 focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:ring-offset-1 focus:ring-offset-transparent\"\n      >\n        <span id=\"toggle-thumb\" class=\"toggle-thumb absolute top-0.5 left-0.5 w-5 h-5 bg-white rounded-full shadow\"></span>\n      </button>\n      <span id=\"label-annual\" class=\"text-sm font-medium text-slate-300\">\n        Annual <span class=\"ml-1 bg-emerald-500 text-white text-xs font-bold px-1.5 py-0.5 rounded-full\">2 months free</span>\n      </span>\n    </div>\n  </section>\n\n  <!-- Pricing Cards -->\n  <section class=\"max-w-6xl mx-auto px-4 -mt-8 pb-16\">\n    <div class=\"grid grid-cols-1 md:grid-cols-3 gap-6 items-start\">\n\n      <!-- Starter -->\n      <div class=\"card-hover bg-white rounded-2xl shadow-md border border-slate-200 p-8 flex flex-col\">\n        <div class=\"mb-6\">\n          <h2 class=\"text-lg font-bold text-slate-700 mb-1\">Starter</h2>\n          <p class=\"text-slate-500 text-sm\">Perfect for individuals and small side projects.</p>\n        </div>\n        <div class=\"mb-6\">\n          <div class=\"flex items-end gap-1\">\n            <span class=\"text-4xl font-extrabold text-slate-900 price-transition\" id=\"price-starter\">$9</span>\n            <span class=\"text-slate-500 text-sm mb-1.5\">/mo</span>\n          </div>\n          <p class=\"text-slate-400 text-xs mt-1\" id=\"billed-starter\">Billed monthly</p>\n        </div>\n        <ul class=\"space-y-3 text-sm text-slate-700 mb-8 flex-1\">\n          <li class=\"flex items-center gap-2\"><span class=\"text-emerald-500 font-bold text-base\">✓</span> 3 projects</li>\n          <li class=\"flex items-center gap-2\"><span class=\"text-emerald-500 font-bold text-base\">✓</span> 5 GB storage</li>\n          <li class=\"flex items-center gap-2\"><span class=\"text-emerald-500 font-bold text-base\">✓</span> Basic analytics</li>\n          <li class=\"flex items-center gap-2\"><span class=\"text-emerald-500 font-bold text-base\">✓</span> Email support</li>\n          <li class=\"flex items-center gap-2\"><span class=\"text-slate-300 font-bold text-base\">✕</span> <span class=\"text-slate-400\">Custom domain</span></li>\n          <li class=\"flex items-center gap-2\"><span class=\"text-slate-300 font-bold text-base\">✕</span> <span class=\"text-slate-400\">Team seats</span></li>\n          <li class=\"flex items-center gap-2\"><span class=\"text-slate-300 font-bold text-base\">✕</span> <span class=\"text-slate-400\">Priority support</span></li>\n          <li class=\"flex items-center gap-2\"><span class=\"text-slate-300 font-bold text-base\">✕</span> <span class=\"text-slate-400\">API access</span></li>\n        </ul>\n        <button\n          onclick=\"selectPlan('Starter')\"\n          class=\"w-full py-3 rounded-xl border-2 border-indigo-500 text-indigo-600 font-semibold text-sm hover:bg-indigo-50 transition-colors focus:outline-none focus:ring-2 focus:ring-indigo-400\"\n        >\n          Get started free\n        </button>\n      </div>\n\n      <!-- Pro (Most Popular) -->\n      <div class=\"card-hover relative bg-gradient-to-b from-indigo-600 to-violet-700 rounded-2xl shadow-2xl p-8 flex flex-col text-white -mt-2 md:-mt-4\">\n        <div class=\"absolute -top-3.5 left-1/2 -translate-x-1/2\">\n          <span class=\"badge-popular text-white text-xs font-bold px-4 py-1.5 rounded-full shadow-lg tracking-wide uppercase\">Most Popular</span>\n        </div>\n        <div class=\"mb-6 mt-3\">\n          <h2 class=\"text-lg font-bold mb-1\">Pro</h2>\n          <p class=\"text-indigo-200 text-sm\">For growing teams who need more power and collaboration.</p>\n        </div>\n        <div class=\"mb-6\">\n          <div class=\"flex items-end gap-1\">\n            <span class=\"text-4xl font-extrabold price-transition\" id=\"price-pro\">$29</span>\n            <span class=\"text-indigo-200 text-sm mb-1.5\">/mo</span>\n          </div>\n          <p class=\"text-indigo-300 text-xs mt-1\" id=\"billed-pro\">Billed monthly</p>\n        </div>\n        <ul class=\"space-y-3 text-sm text-indigo-100 mb-8 flex-1\">\n          <li class=\"flex items-center gap-2\"><span class=\"text-emerald-300 font-bold text-base\">✓</span> Unlimited projects</li>\n          <li class=\"flex items-center gap-2\"><span class=\"text-emerald-300 font-bold text-base\">✓</span> 50 GB storage</li>\n          <li class=\"flex items-center gap-2\"><span class=\"text-emerald-300 font-bold text-base\">✓</span> Advanced analytics</li>\n          <li class=\"flex items-center gap-2\"><span class=\"text-emerald-300 font-bold text-base\">✓</span> Priority email support</li>\n          <li class=\"flex items-center gap-2\"><span class=\"text-emerald-300 font-bold text-base\">✓</span> Custom domain</li>\n          <li class=\"flex items-center gap-2\"><span class=\"text-emerald-300 font-bold text-base\">✓</span> Up to 5 team seats</li>\n          <li class=\"flex items-center gap-2\"><span class=\"text-slate-400 font-bold text-base\">✕</span> <span class=\"text-indigo-300/70\">Priority support (24 h)</span></li>\n          <li class=\"flex items-center gap-2\"><span class=\"text-slate-400 font-bold text-base\">✕</span> <span class=\"text-indigo-300/70\">API access</span></li>\n        </ul>\n        <button\n          onclick=\"selectPlan('Pro')\"\n          class=\"w-full py-3 rounded-xl bg-white text-indigo-700 font-semibold text-sm hover:bg-indigo-50 transition-colors shadow-lg focus:outline-none focus:ring-2 focus:ring-white\"\n        >\n          Start with Pro\n        </button>\n      </div>\n\n      <!-- Business -->\n      <div class=\"card-hover bg-white rounded-2xl shadow-md border border-slate-200 p-8 flex flex-col\">\n        <div class=\"mb-6\">\n          <h2 class=\"text-lg font-bold text-slate-700 mb-1\">Business</h2>\n          <p class=\"text-slate-500 text-sm\">Enterprise-grade features for larger organisations.</p>\n        </div>\n        <div class=\"mb-6\">\n          <div class=\"flex items-end gap-1\">\n            <span class=\"text-4xl font-extrabold text-slate-900 price-transition\" id=\"price-business\">$79</span>\n            <span class=\"text-slate-500 text-sm mb-1.5\">/mo</span>\n          </div>\n          <p class=\"text-slate-400 text-xs mt-1\" id=\"billed-business\">Billed monthly</p>\n        </div>\n        <ul class=\"space-y-3 text-sm text-slate-700 mb-8 flex-1\">\n          <li class=\"flex items-center gap-2\"><span class=\"text-emerald-500 font-bold text-base\">✓</span> Unlimited projects</li>\n          <li class=\"flex items-center gap-2\"><span class=\"text-emerald-500 font-bold text-base\">✓</span> 500 GB storage</li>\n          <li class=\"flex items-center gap-2\"><span class=\"text-emerald-500 font-bold text-base\">✓</span> Full analytics suite</li>\n          <li class=\"flex items-center gap-2\"><span class=\"text-emerald-500 font-bold text-base\">✓</span> Dedicated account manager</li>\n          <li class=\"flex items-center gap-2\"><span class=\"text-emerald-500 font-bold text-base\">✓</span> Custom domain + SSL</li>\n          <li class=\"flex items-center gap-2\"><span class=\"text-emerald-500 font-bold text-base\">✓</span> Unlimited team seats</li>\n          <li class=\"flex items-center gap-2\"><span class=\"text-emerald-500 font-bold text-base\">✓</span> Priority support (24 h)</li>\n          <li class=\"flex items-center gap-2\"><span class=\"text-emerald-500 font-bold text-base\">✓</span> Full API access</li>\n        </ul>\n        <button\n          onclick=\"selectPlan('Business')\"\n          class=\"w-full py-3 rounded-xl border-2 border-indigo-500 text-indigo-600 font-semibold text-sm hover:bg-indigo-50 transition-colors focus:outline-none focus:ring-2 focus:ring-indigo-400\"\n        >\n          Contact sales\n        </button>\n      </div>\n\n    </div>\n  </section>\n\n  <!-- Feature Comparison Table -->\n  <section class=\"max-w-5xl mx-auto px-4 pb-24\">\n    <h2 class=\"text-2xl font-bold text-center text-slate-800 mb-2\">Compare all features</h2>\n    <p class=\"text-center text-slate-500 text-sm mb-10\">Everything you need to decide which plan is right for you.</p>\n\n    <div class=\"overflow-x-auto rounded-2xl border border-slate-200 shadow-sm\">\n      <table class=\"w-full text-sm text-left\">\n        <thead>\n          <tr class=\"bg-slate-100 border-b border-slate-200\">\n            <th class=\"py-4 px-6 font-semibold text-slate-600 w-1/2\">Feature</th>\n            <th class=\"py-4 px-4 text-center font-semibold text-slate-600\">Starter</th>\n            <th class=\"py-4 px-4 text-center font-bold text-indigo-700 bg-indigo-50\">Pro</th>\n            <th class=\"py-4 px-4 text-center font-semibold text-slate-600\">Business</th>\n          </tr>\n        </thead>\n        <tbody class=\"divide-y divide-slate-100\">\n          <tr class=\"bg-slate-50\">\n            <td class=\"py-3 px-6 font-semibold text-slate-500 text-xs uppercase tracking-wider\" colspan=\"4\">Core</td>\n          </tr>\n          <tr class=\"hover:bg-slate-50 transition-colors\">\n            <td class=\"py-3.5 px-6 text-slate-700\">Projects</td>\n            <td class=\"py-3.5 px-4 text-center text-slate-600\">3</td>\n            <td class=\"py-3.5 px-4 text-center font-medium text-indigo-700 bg-indigo-50/50\">Unlimited</td>\n            <td class=\"py-3.5 px-4 text-center text-slate-600\">Unlimited</td>\n          </tr>\n          <tr class=\"hover:bg-slate-50 transition-colors\">\n            <td class=\"py-3.5 px-6 text-slate-700\">Storage</td>\n            <td class=\"py-3.5 px-4 text-center text-slate-600\">5 GB</td>\n            <td class=\"py-3.5 px-4 text-center font-medium text-indigo-700 bg-indigo-50/50\">50 GB</td>\n            <td class=\"py-3.5 px-4 text-center text-slate-600\">500 GB</td>\n          </tr>\n          <tr class=\"hover:bg-slate-50 transition-colors\">\n            <td class=\"py-3.5 px-6 text-slate-700\">Team seats</td>\n            <td class=\"py-3.5 px-4 text-center\"><span class=\"text-slate-300 text-lg\">✕</span></td>\n            <td class=\"py-3.5 px-4 text-center font-medium text-indigo-700 bg-indigo-50/50\">5</td>\n            <td class=\"py-3.5 px-4 text-center text-slate-600\">Unlimited</td>\n          </tr>\n          <tr class=\"hover:bg-slate-50 transition-colors\">\n            <td class=\"py-3.5 px-6 text-slate-700\">Custom domain</td>\n            <td class=\"py-3.5 px-4 text-center\"><span class=\"text-slate-300 text-lg\">✕</span></td>\n            <td class=\"py-3.5 px-4 text-center bg-indigo-50/50\"><span class=\"text-emerald-500 text-lg font-bold\">✓</span></td>\n            <td class=\"py-3.5 px-4 text-center\"><span class=\"text-emerald-500 text-lg font-bold\">✓</span></td>\n          </tr>\n          <tr class=\"bg-slate-50\">\n            <td class=\"py-3 px-6 font-semibold text-slate-500 text-xs uppercase tracking-wider\" colspan=\"4\">Analytics</td>\n          </tr>\n          <tr class=\"hover:bg-slate-50 transition-colors\">\n            <td class=\"py-3.5 px-6 text-slate-700\">Page views &amp; sessions</td>\n            <td class=\"py-3.5 px-4 text-center\"><span class=\"text-emerald-500 text-lg font-bold\">✓</span></td>\n            <td class=\"py-3.5 px-4 text-center bg-indigo-50/50\"><span class=\"text-emerald-500 text-lg font-bold\">✓</span></td>\n            <td class=\"py-3.5 px-4 text-center\"><span class=\"text-emerald-500 text-lg font-bold\">✓</span></td>\n          </tr>\n          <tr class=\"hover:bg-slate-50 transition-colors\">\n            <td class=\"py-3.5 px-6 text-slate-700\">Funnel analysis</td>\n            <td class=\"py-3.5 px-4 text-center\"><span class=\"text-slate-300 text-lg\">✕</span></td>\n            <td class=\"py-3.5 px-4 text-center bg-indigo-50/50\"><span class=\"text-emerald-500 text-lg font-bold\">✓</span></td>\n            <td class=\"py-3.5 px-4 text-center\"><span class=\"text-emerald-500 text-lg font-bold\">✓</span></td>\n          </tr>\n          <tr class=\"hover:bg-slate-50 transition-colors\">\n            <td class=\"py-3.5 px-6 text-slate-700\">Custom dashboards</td>\n            <td class=\"py-3.5 px-4 text-center\"><span class=\"text-slate-300 text-lg\">✕</span></td>\n            <td class=\"py-3.5 px-4 text-center bg-indigo-50/50\"><span class=\"text-slate-300 text-lg\">✕</span></td>\n            <td class=\"py-3.5 px-4 text-center\"><span class=\"text-emerald-500 text-lg font-bold\">✓</span></td>\n          </tr>\n          <tr class=\"hover:bg-slate-50 transition-colors\">\n            <td class=\"py-3.5 px-6 text-slate-700\">Data export (CSV / JSON)</td>\n            <td class=\"py-3.5 px-4 text-center\"><span class=\"text-slate-300 text-lg\">✕</span></td>\n            <td class=\"py-3.5 px-4 text-center bg-indigo-50/50\"><span class=\"text-emerald-500 text-lg font-bold\">✓</span></td>\n            <td class=\"py-3.5 px-4 text-center\"><span class=\"text-emerald-500 text-lg font-bold\">✓</span></td>\n          </tr>\n          <tr class=\"bg-slate-50\">\n            <td class=\"py-3 px-6 font-semibold text-slate-500 text-xs uppercase tracking-wider\" colspan=\"4\">Integrations &amp; API</td>\n          </tr>\n          <tr class=\"hover:bg-slate-50 transition-colors\">\n            <td class=\"py-3.5 px-6 text-slate-700\">Slack &amp; email webhooks</td>\n            <td class=\"py-3.5 px-4 text-center\"><span class=\"text-slate-300 text-lg\">✕</span></td>\n            <td class=\"py-3.5 px-4 text-center bg-indigo-50/50\"><span class=\"text-emerald-500 text-lg font-bold\">✓</span></td>\n            <td class=\"py-3.5 px-4 text-center\"><span class=\"text-emerald-500 text-lg font-bold\">✓</span></td>\n          </tr>\n          <tr class=\"hover:bg-slate-50 transition-colors\">\n            <td class=\"py-3.5 px-6 text-slate-700\">REST API access</td>\n            <td class=\"py-3.5 px-4 text-center\"><span class=\"text-slate-300 text-lg\">✕</span></td>\n            <td class=\"py-3.5 px-4 text-center bg-indigo-50/50\"><span class=\"text-slate-300 text-lg\">✕</span></td>\n            <td class=\"py-3.5 px-4 text-center\"><span class=\"text-emerald-500 text-lg font-bold\">✓</span></td>\n          </tr>\n          <tr class=\"hover:bg-slate-50 transition-colors\">\n            <td class=\"py-3.5 px-6 text-slate-700\">SSO / SAML</td>\n            <td class=\"py-3.5 px-4 text-center\"><span class=\"text-slate-300 text-lg\">✕</span></td>\n            <td class=\"py-3.5 px-4 text-center bg-indigo-50/50\"><span class=\"text-slate-300 text-lg\">✕</span></td>\n            <td class=\"py-3.5 px-4 text-center\"><span class=\"text-emerald-500 text-lg font-bold\">✓</span></td>\n          </tr>\n          <tr class=\"bg-slate-50\">\n            <td class=\"py-3 px-6 font-semibold text-slate-500 text-xs uppercase tracking-wider\" colspan=\"4\">Support</td>\n          </tr>\n          <tr class=\"hover:bg-slate-50 transition-colors\">\n            <td class=\"py-3.5 px-6 text-slate-700\">Community forum</td>\n            <td class=\"py-3.5 px-4 text-center\"><span class=\"text-emerald-500 text-lg font-bold\">✓</span></td>\n            <td class=\"py-3.5 px-4 text-center bg-indigo-50/50\"><span class=\"text-emerald-500 text-lg font-bold\">✓</span></td>\n            <td class=\"py-3.5 px-4 text-center\"><span class=\"text-emerald-500 text-lg font-bold\">✓</span></td>\n          </tr>\n          <tr class=\"hover:bg-slate-50 transition-colors\">\n            <td class=\"py-3.5 px-6 text-slate-700\">Email support</td>\n            <td class=\"py-3.5 px-4 text-center\"><span class=\"text-emerald-500 text-lg font-bold\">✓</span></td>\n            <td class=\"py-3.5 px-4 text-center bg-indigo-50/50\"><span class=\"text-emerald-500 text-lg font-bold\">✓</span></td>\n            <td class=\"py-3.5 px-4 text-center\"><span class=\"text-emerald-500 text-lg font-bold\">✓</span></td>\n          </tr>\n          <tr class=\"hover:bg-slate-50 transition-colors\">\n            <td class=\"py-3.5 px-6 text-slate-700\">Priority support (24 h SLA)</td>\n            <td class=\"py-3.5 px-4 text-center\"><span class=\"text-slate-300 text-lg\">✕</span></td>\n            <td class=\"py-3.5 px-4 text-center bg-indigo-50/50\"><span class=\"text-slate-300 text-lg\">✕</span></td>\n            <td class=\"py-3.5 px-4 text-center\"><span class=\"text-emerald-500 text-lg font-bold\">✓</span></td>\n          </tr>\n          <tr class=\"hover:bg-slate-50 transition-colors\">\n            <td class=\"py-3.5 px-6 text-slate-700\">Dedicated account manager</td>\n            <td class=\"py-3.5 px-4 text-center\"><span class=\"text-slate-300 text-lg\">✕</span></td>\n            <td class=\"py-3.5 px-4 text-center bg-indigo-50/50\"><span class=\"text-slate-300 text-lg\">✕</span></td>\n            <td class=\"py-3.5 px-4 text-center\"><span class=\"text-emerald-500 text-lg font-bold\">✓</span></td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n  </section>\n\n  <!-- FAQ strip -->\n  <section class=\"bg-white border-t border-slate-100 py-16 px-4\">\n    <div class=\"max-w-2xl mx-auto text-center\">\n      <h2 class=\"text-xl font-bold text-slate-800 mb-2\">Still have questions?</h2>\n      <p class=\"text-slate-500 text-sm mb-6\">Our team is happy to walk you through any plan or help you find the right fit.</p>\n      <button\n        onclick=\"selectPlan('custom quote')\"\n        class=\"inline-block px-8 py-3 rounded-xl bg-indigo-600 text-white font-semibold text-sm hover:bg-indigo-700 transition-colors shadow focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:ring-offset-2\"\n      >\n        Talk to sales\n      </button>\n    </div>\n  </section>\n\n  <!-- Toast container -->\n  <div id=\"toast-container\" class=\"fixed bottom-6 left-1/2 -translate-x-1/2 z-50 flex flex-col items-center gap-3 pointer-events-none\"></div>\n\n  <script>\n    var isAnnual = false;\n\n    var prices = {\n      starter:  { monthly: 9,  annual: 7  },\n      pro:      { monthly: 29, annual: 24 },\n      business: { monthly: 79, annual: 66 }\n    };\n\n    function toggleBilling() {\n      isAnnual = !isAnnual;\n\n      var toggle = document.getElementById('billing-toggle');\n      var thumb  = document.getElementById('toggle-thumb');\n      var labelM = document.getElementById('label-monthly');\n      var labelA = document.getElementById('label-annual');\n\n      toggle.setAttribute('aria-checked', isAnnual ? 'true' : 'false');\n      toggle.classList.toggle('bg-indigo-500', isAnnual);\n      toggle.classList.toggle('bg-slate-600', !isAnnual);\n      thumb.style.transform = isAnnual ? 'translateX(24px)' : 'translateX(0)';\n      labelM.classList.toggle('text-white', !isAnnual);\n      labelM.classList.toggle('text-slate-300', isAnnual);\n      labelA.classList.toggle('text-white', isAnnual);\n      labelA.classList.toggle('text-slate-300', !isAnnual);\n\n      updatePrices();\n    }\n\n    function updatePrices() {\n      var tiers = ['starter', 'pro', 'business'];\n      tiers.forEach(function(tier) {\n        var el     = document.getElementById('price-' + tier);\n        var sub    = document.getElementById('billed-' + tier);\n        var amount = isAnnual ? prices[tier].annual : prices[tier].monthly;\n\n        el.style.opacity = '0';\n        el.style.transform = 'translateY(-6px)';\n        setTimeout(function() {\n          el.textContent = '$' + amount;\n          el.style.opacity = '1';\n          el.style.transform = 'translateY(0)';\n        }, 120);\n\n        sub.textContent = isAnnual\n          ? 'Billed annually — save ' + Math.round((1 - prices[tier].annual / prices[tier].monthly) * 100) + '%'\n          : 'Billed monthly';\n      });\n    }\n\n    function selectPlan(planName) {\n      showToast('Selected <strong>' + planName + '</strong> — we\\'ll be in touch soon!');\n    }\n\n    function showToast(html) {\n      var container = document.getElementById('toast-container');\n\n      var toast = document.createElement('div');\n      toast.className = 'toast pointer-events-auto flex items-center gap-3 bg-slate-900 text-white text-sm font-medium px-5 py-3.5 rounded-2xl shadow-2xl';\n      toast.innerHTML = '<svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-5 h-5 text-emerald-400 flex-shrink-0\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M5 13l4 4L19 7\"/></svg><span>' + html + '</span>';\n\n      container.appendChild(toast);\n\n      setTimeout(function() {\n        if (toast.parentNode) {\n          toast.parentNode.removeChild(toast);\n        }\n      }, 3200);\n    }\n  </script>\n</body>\n</html>\n",
