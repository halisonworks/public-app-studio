{
  "schema": "app-studio/canvas@1",
  "id": "example-flashcards",
  "name": "flashcards.html",
  "code": "<!DOCTYPE html>\n<!--\n  Flashcards — Halison App Studio example\n\n  A flashcard study tool: flip cards, shuffle, mark what you know, and track\n  progress. Edit the deck inline to study any topic. Saves to your browser.\n\n  From the Halison App Studio public library:\n  https://github.com/halisonworks/public-app-studio\n\n  Permitted use: personal, educational, and other non-commercial use. You may\n  modify it, but keep this header and the source link intact, and do not sell,\n  commercialize, or republish it. Released under the Halison App Studio Examples\n  License — see the LICENSE file in the repository above.\n-->\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Flashcards — Marketing Terms</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    .card-scene {\n      perspective: 1000px;\n    }\n    .card-inner {\n      position: relative;\n      width: 100%;\n      height: 100%;\n      transition: transform 0.55s cubic-bezier(0.4, 0.2, 0.2, 1);\n      transform-style: preserve-3d;\n    }\n    .card-inner.flipped {\n      transform: rotateY(180deg);\n    }\n    .card-face {\n      position: absolute;\n      inset: 0;\n      backface-visibility: hidden;\n      -webkit-backface-visibility: hidden;\n      border-radius: 1rem;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      padding: 2rem;\n    }\n    .card-back {\n      transform: rotateY(180deg);\n    }\n    .progress-bar-inner {\n      transition: width 0.3s ease;\n    }\n  </style>\n</head>\n<body class=\"bg-gradient-to-br from-violet-50 to-indigo-100 min-h-screen flex flex-col items-center justify-center p-4 font-sans\">\n\n  <div class=\"w-full max-w-xl flex flex-col gap-5\">\n\n    <!-- Header -->\n    <div class=\"text-center\">\n      <h1 class=\"text-2xl font-bold text-indigo-800 tracking-tight\">Marketing Flashcards</h1>\n      <p class=\"text-sm text-indigo-400 mt-1\">Click the card or press <kbd class=\"bg-indigo-100 text-indigo-600 px-1.5 py-0.5 rounded text-xs font-mono\">Space</kbd> to flip</p>\n    </div>\n\n    <!-- Progress row -->\n    <div class=\"flex items-center justify-between text-sm text-indigo-600 font-medium px-1\">\n      <span id=\"card-counter\">Card 1 / 10</span>\n      <span id=\"known-counter\">0 known</span>\n    </div>\n\n    <!-- Progress bar -->\n    <div class=\"w-full bg-indigo-100 rounded-full h-2\">\n      <div id=\"progress-bar\" class=\"progress-bar-inner bg-indigo-500 h-2 rounded-full\" style=\"width: 0%\"></div>\n    </div>\n\n    <!-- Card -->\n    <div class=\"card-scene w-full\" style=\"height: 260px;\">\n      <div class=\"card-inner\" id=\"card-inner\">\n        <!-- Front -->\n        <div class=\"card-face card-front bg-white shadow-xl border border-indigo-100 cursor-pointer select-none\">\n          <span class=\"text-xs font-semibold uppercase tracking-widest text-indigo-300 mb-4\">Term</span>\n          <p id=\"card-front-text\" class=\"text-2xl font-bold text-indigo-800 text-center leading-snug\"></p>\n        </div>\n        <!-- Back -->\n        <div class=\"card-face card-back bg-indigo-600 shadow-xl cursor-pointer select-none\">\n          <span class=\"text-xs font-semibold uppercase tracking-widest text-indigo-200 mb-4\">Definition</span>\n          <p id=\"card-back-text\" class=\"text-base font-medium text-white text-center leading-relaxed\"></p>\n        </div>\n      </div>\n    </div>\n\n    <!-- Known toggle -->\n    <div class=\"flex justify-center\">\n      <button\n        id=\"btn-known\"\n        class=\"flex items-center gap-2 px-4 py-2 rounded-full text-sm font-semibold border-2 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-400\"\n        aria-pressed=\"false\"\n      >\n        <span id=\"known-icon\">☆</span>\n        <span id=\"known-label\">Mark as known</span>\n      </button>\n    </div>\n\n    <!-- Navigation -->\n    <div class=\"flex items-center justify-between gap-3\">\n      <button id=\"btn-prev\"\n        class=\"flex-1 py-2.5 rounded-xl bg-white border border-indigo-200 text-indigo-700 font-semibold text-sm shadow-sm hover:bg-indigo-50 active:scale-95 transition-all focus:outline-none focus:ring-2 focus:ring-indigo-400\"\n        aria-label=\"Previous card\">\n        ← Prev\n      </button>\n      <button id=\"btn-shuffle\"\n        class=\"flex-1 py-2.5 rounded-xl bg-indigo-100 border border-indigo-200 text-indigo-700 font-semibold text-sm shadow-sm hover:bg-indigo-200 active:scale-95 transition-all focus:outline-none focus:ring-2 focus:ring-indigo-400\"\n        aria-label=\"Shuffle deck\">\n        ⇄ Shuffle\n      </button>\n      <button id=\"btn-next\"\n        class=\"flex-1 py-2.5 rounded-xl bg-white border border-indigo-200 text-indigo-700 font-semibold text-sm shadow-sm hover:bg-indigo-50 active:scale-95 transition-all focus:outline-none focus:ring-2 focus:ring-indigo-400\"\n        aria-label=\"Next card\">\n        Next →\n      </button>\n    </div>\n\n    <!-- Study mode + Reset row -->\n    <div class=\"flex items-center justify-between px-1\">\n      <label class=\"flex items-center gap-2 cursor-pointer select-none text-sm text-indigo-700 font-medium\">\n        <input id=\"toggle-unknown-only\" type=\"checkbox\" class=\"w-4 h-4 accent-indigo-600 rounded\" />\n        Study unknown only\n      </label>\n      <button id=\"btn-reset\"\n        class=\"text-xs text-indigo-400 hover:text-red-500 underline underline-offset-2 transition-colors focus:outline-none\"\n        aria-label=\"Reset progress\">\n        Reset progress\n      </button>\n    </div>\n\n  </div>\n\n  <script>\n    // ── Deck data ──────────────────────────────────────────────────────────────\n    const ORIGINAL_DECK = [\n      {\n        front: \"Brand Equity\",\n        back: \"The commercial value a brand adds to a product beyond its functional benefits, built through consumer perception, loyalty, and associations.\"\n      },\n      {\n        front: \"Conversion Rate\",\n        back: \"The percentage of visitors or leads who complete a desired action (e.g., purchase, sign-up) out of the total number who were exposed to the opportunity.\"\n      },\n      {\n        front: \"Customer Lifetime Value (CLV)\",\n        back: \"The total net profit a business can expect from a customer over the entire duration of their relationship.\"\n      },\n      {\n        front: \"Cost Per Acquisition (CPA)\",\n        back: \"The total marketing cost divided by the number of new customers or conversions acquired in a given period.\"\n      },\n      {\n        front: \"Segmentation\",\n        back: \"Dividing a broad target market into subsets of consumers who share common needs, characteristics, or behaviors to tailor messaging and offers.\"\n      },\n      {\n        front: \"Value Proposition\",\n        back: \"A clear statement that explains how a product solves a customer problem, delivers benefits, and why it is better than the competition.\"\n      },\n      {\n        front: \"Funnel (Marketing Funnel)\",\n        back: \"A model representing the stages a prospect moves through—from awareness to consideration to decision—on the path to becoming a customer.\"\n      },\n      {\n        front: \"Net Promoter Score (NPS)\",\n        back: \"A metric that measures customer loyalty by asking how likely customers are to recommend a product or service on a 0–10 scale.\"\n      },\n      {\n        front: \"Inbound Marketing\",\n        back: \"A strategy that attracts customers by creating valuable content and experiences tailored to them, rather than interrupting them with outbound advertising.\"\n      },\n      {\n        front: \"A/B Testing\",\n        back: \"A controlled experiment comparing two versions of a marketing asset (e.g., email subject line, landing page) to determine which performs better.\"\n      }\n    ];\n\n    // ── State ──────────────────────────────────────────────────────────────────\n    const STORAGE_KEY = \"flashcards_state_v1\";\n\n    function loadState() {\n      try {\n        const raw = localStorage.getItem(STORAGE_KEY);\n        if (raw) return JSON.parse(raw);\n      } catch (_) {}\n      return null;\n    }\n\n    function saveState() {\n      try {\n        localStorage.setItem(STORAGE_KEY, JSON.stringify({\n          order: state.order,\n          currentIndex: state.currentIndex,\n          known: Array.from(state.known),\n          unknownOnlyMode: state.unknownOnlyMode\n        }));\n      } catch (_) {}\n    }\n\n    function buildDefaultState() {\n      return {\n        order: ORIGINAL_DECK.map((_, i) => i),\n        currentIndex: 0,\n        known: new Set(),\n        unknownOnlyMode: false,\n        isFlipped: false\n      };\n    }\n\n    const persisted = loadState();\n    const state = buildDefaultState();\n\n    if (persisted) {\n      if (Array.isArray(persisted.order) && persisted.order.length === ORIGINAL_DECK.length) {\n        state.order = persisted.order;\n      }\n      if (typeof persisted.currentIndex === \"number\") {\n        state.currentIndex = persisted.currentIndex;\n      }\n      if (Array.isArray(persisted.known)) {\n        state.known = new Set(persisted.known);\n      }\n      if (typeof persisted.unknownOnlyMode === \"boolean\") {\n        state.unknownOnlyMode = persisted.unknownOnlyMode;\n      }\n    }\n\n    // ── Helpers ────────────────────────────────────────────────────────────────\n    function getActiveDeck() {\n      if (!state.unknownOnlyMode) return state.order;\n      const unknown = state.order.filter(i => !state.known.has(i));\n      return unknown.length > 0 ? unknown : state.order;\n    }\n\n    function clampIndex(deck) {\n      if (state.currentIndex >= deck.length) state.currentIndex = deck.length - 1;\n      if (state.currentIndex < 0) state.currentIndex = 0;\n    }\n\n    function shuffle(arr) {\n      const a = arr.slice();\n      for (let i = a.length - 1; i > 0; i--) {\n        const j = Math.floor(Math.random() * (i + 1));\n        [a[i], a[j]] = [a[j], a[i]];\n      }\n      return a;\n    }\n\n    // ── DOM refs ───────────────────────────────────────────────────────────────\n    const cardInner        = document.getElementById(\"card-inner\");\n    const cardFrontText    = document.getElementById(\"card-front-text\");\n    const cardBackText     = document.getElementById(\"card-back-text\");\n    const cardCounter      = document.getElementById(\"card-counter\");\n    const knownCounter     = document.getElementById(\"known-counter\");\n    const progressBar      = document.getElementById(\"progress-bar\");\n    const btnKnown         = document.getElementById(\"btn-known\");\n    const knownIcon        = document.getElementById(\"known-icon\");\n    const knownLabel       = document.getElementById(\"known-label\");\n    const btnPrev          = document.getElementById(\"btn-prev\");\n    const btnNext          = document.getElementById(\"btn-next\");\n    const btnShuffle       = document.getElementById(\"btn-shuffle\");\n    const btnReset         = document.getElementById(\"btn-reset\");\n    const toggleUnknown    = document.getElementById(\"toggle-unknown-only\");\n\n    // ── Render ─────────────────────────────────────────────────────────────────\n    function render() {\n      const deck = getActiveDeck();\n      clampIndex(deck);\n\n      const cardIdx = deck[state.currentIndex];\n      const card = ORIGINAL_DECK[cardIdx];\n      const pos = state.currentIndex + 1;\n      const total = deck.length;\n      const knownCount = state.known.size;\n      const isKnown = state.known.has(cardIdx);\n\n      // Text\n      cardFrontText.textContent = card.front;\n      cardBackText.textContent = card.back;\n\n      // Flip state\n      if (state.isFlipped) {\n        cardInner.classList.add(\"flipped\");\n      } else {\n        cardInner.classList.remove(\"flipped\");\n      }\n\n      // Counter\n      cardCounter.textContent = `Card ${pos} / ${total}`;\n      knownCounter.textContent = `${knownCount} known`;\n\n      // Progress bar\n      const pct = total > 0 ? Math.round((knownCount / ORIGINAL_DECK.length) * 100) : 0;\n      progressBar.style.width = pct + \"%\";\n\n      // Known button\n      if (isKnown) {\n        btnKnown.classList.remove(\"border-indigo-200\", \"text-indigo-500\", \"bg-white\");\n        btnKnown.classList.add(\"border-emerald-400\", \"text-emerald-700\", \"bg-emerald-50\");\n        btnKnown.setAttribute(\"aria-pressed\", \"true\");\n        knownIcon.textContent = \"★\";\n        knownLabel.textContent = \"Known!\";\n      } else {\n        btnKnown.classList.remove(\"border-emerald-400\", \"text-emerald-700\", \"bg-emerald-50\");\n        btnKnown.classList.add(\"border-indigo-200\", \"text-indigo-500\", \"bg-white\");\n        btnKnown.setAttribute(\"aria-pressed\", \"false\");\n        knownIcon.textContent = \"☆\";\n        knownLabel.textContent = \"Mark as known\";\n      }\n\n      // Study unknown toggle\n      toggleUnknown.checked = state.unknownOnlyMode;\n\n      // Prev/Next button states\n      btnPrev.disabled = pos <= 1;\n      btnPrev.classList.toggle(\"opacity-40\", pos <= 1);\n      btnNext.disabled = pos >= total;\n      btnNext.classList.toggle(\"opacity-40\", pos >= total);\n\n      saveState();\n    }\n\n    // ── Actions ────────────────────────────────────────────────────────────────\n    function flipCard() {\n      state.isFlipped = !state.isFlipped;\n      render();\n    }\n\n    function goNext() {\n      const deck = getActiveDeck();\n      if (state.currentIndex < deck.length - 1) {\n        state.currentIndex++;\n        state.isFlipped = false;\n        render();\n      }\n    }\n\n    function goPrev() {\n      if (state.currentIndex > 0) {\n        state.currentIndex--;\n        state.isFlipped = false;\n        render();\n      }\n    }\n\n    function doShuffle() {\n      state.order = shuffle(state.order);\n      state.currentIndex = 0;\n      state.isFlipped = false;\n      render();\n    }\n\n    function toggleKnown() {\n      const deck = getActiveDeck();\n      const cardIdx = deck[state.currentIndex];\n      if (state.known.has(cardIdx)) {\n        state.known.delete(cardIdx);\n      } else {\n        state.known.add(cardIdx);\n      }\n      render();\n    }\n\n    function resetProgress() {\n      if (!confirm(\"Reset all progress? This will clear your known cards and restore the original order.\")) return;\n      state.order = ORIGINAL_DECK.map((_, i) => i);\n      state.currentIndex = 0;\n      state.known = new Set();\n      state.isFlipped = false;\n      state.unknownOnlyMode = false;\n      render();\n    }\n\n    // ── Event listeners ────────────────────────────────────────────────────────\n    cardInner.addEventListener(\"click\", flipCard);\n\n    btnNext.addEventListener(\"click\", goNext);\n    btnPrev.addEventListener(\"click\", goPrev);\n    btnShuffle.addEventListener(\"click\", doShuffle);\n    btnKnown.addEventListener(\"click\", toggleKnown);\n    btnReset.addEventListener(\"click\", resetProgress);\n\n    toggleUnknown.addEventListener(\"change\", function () {\n      state.unknownOnlyMode = this.checked;\n      state.currentIndex = 0;\n      state.isFlipped = false;\n      render();\n    });\n\n    document.addEventListener(\"keydown\", function (e) {\n      if (e.target.tagName === \"INPUT\" || e.target.tagName === \"TEXTAREA\") return;\n      switch (e.key) {\n        case \" \":\n        case \"Enter\":\n          e.preventDefault();\n          flipCard();\n          break;\n        case \"ArrowRight\":\n          e.preventDefault();\n          goNext();\n          break;\n        case \"ArrowLeft\":\n          e.preventDefault();\n          goPrev();\n          break;\n        case \"k\":\n        case \"K\":\n          toggleKnown();\n          break;\n      }\n    });\n\n    // ── Init ───────────────────────────────────────────────────────────────────\n    render();\n  </script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Flashcards",
    "windowTitle": "Flashcards",
    "bundleId": "com.halisonworks.flashcards",
    "iconPath": null
  },
  "categoryId": null,
  "source": "import",
  "createdAt": "2026-06-02T12:00:00.000Z",
  "updatedAt": "2026-06-02T12:00:00.000Z",
  "sharedAt": "2026-06-02T12:00:00.000Z"
}
