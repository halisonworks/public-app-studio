{
  "schema": "app-studio/canvas@1",
  "id": "example-rubric-grader",
  "name": "rubric-grader.html",
  "code": "<!DOCTYPE html>\n<!--\n  Rubric Grader — Halison App Studio example\n\n  Build a weighted rubric, pick a level per criterion, and get an instant\n  weighted score, percentage and breakdown. Saves locally; print-friendly.\n\n  From the Halison App Studio public library:\n  https://github.com/halisonworks/public-app-studio\n\n  Permitted use: personal, educational, and other non-commercial use. You may\n  modify it, but keep this header and the source link intact, and do not sell,\n  commercialize, or republish it. Released under the Halison App Studio Examples\n  License — see the LICENSE file in the repository above.\n-->\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Rubric Grader</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    /* ── Print styles ─────────────────────────────────────────────── */\n    @media print {\n      .no-print { display: none !important; }\n      body { background: white !important; }\n      #app { padding: 0 !important; }\n      .print-card {\n        box-shadow: none !important;\n        border: 1px solid #d1d5db !important;\n        break-inside: avoid;\n      }\n      #grading-panel { display: block !important; }\n      #builder-panel { display: none !important; }\n      .tab-bar { display: none !important; }\n    }\n\n    /* ── Misc helpers ─────────────────────────────────────────────── */\n    [x-cloak] { display: none; }\n    .level-btn { transition: all 0.15s ease; }\n    .level-btn.selected-1 { background-color: #fee2e2; border-color: #f87171; color: #991b1b; }\n    .level-btn.selected-2 { background-color: #fef9c3; border-color: #facc15; color: #854d0e; }\n    .level-btn.selected-3 { background-color: #dbeafe; border-color: #60a5fa; color: #1e40af; }\n    .level-btn.selected-4 { background-color: #dcfce7; border-color: #4ade80; color: #166534; }\n    .score-ring {\n      width: 96px; height: 96px;\n      border-radius: 50%;\n      display: flex; align-items: center; justify-content: center;\n      font-size: 1.5rem; font-weight: 700;\n      border: 6px solid;\n    }\n    .ring-F  { border-color: #f87171; color: #dc2626; }\n    .ring-D  { border-color: #fb923c; color: #ea580c; }\n    .ring-C  { border-color: #facc15; color: #ca8a04; }\n    .ring-B  { border-color: #60a5fa; color: #2563eb; }\n    .ring-A  { border-color: #4ade80; color: #16a34a; }\n  </style>\n</head>\n<body class=\"bg-gray-100 min-h-screen\">\n\n<div id=\"app\" class=\"max-w-5xl mx-auto px-4 py-6\">\n\n  <!-- Header -->\n  <header class=\"mb-6\">\n    <h1 class=\"text-3xl font-bold text-gray-800\">Rubric Grader</h1>\n    <p class=\"text-gray-500 text-sm mt-1\">Build a weighted rubric, then grade student work instantly.</p>\n  </header>\n\n  <!-- Tab bar -->\n  <div class=\"tab-bar flex gap-2 mb-5 no-print\">\n    <button id=\"tab-builder\" onclick=\"switchTab('builder')\"\n      class=\"px-5 py-2 rounded-lg font-semibold text-sm transition-colors bg-indigo-600 text-white shadow\">\n      Rubric Builder\n    </button>\n    <button id=\"tab-grader\" onclick=\"switchTab('grader')\"\n      class=\"px-5 py-2 rounded-lg font-semibold text-sm transition-colors bg-white text-gray-600 hover:bg-gray-50 border border-gray-300\">\n      Grade Student\n    </button>\n  </div>\n\n  <!-- ================================================================\n       BUILDER PANEL\n  ================================================================ -->\n  <div id=\"builder-panel\">\n\n    <div class=\"bg-white rounded-2xl shadow p-6 print-card mb-4\">\n      <div class=\"flex items-start justify-between gap-4 flex-wrap\">\n        <div class=\"flex-1 min-w-[220px]\">\n          <label class=\"block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1\">Rubric Title</label>\n          <input id=\"rubric-title\" type=\"text\" placeholder=\"e.g. Argumentative Essay Rubric\"\n            class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-800 font-semibold text-lg focus:outline-none focus:ring-2 focus:ring-indigo-400\"\n            oninput=\"save()\" />\n        </div>\n        <div class=\"flex-1 min-w-[220px]\">\n          <label class=\"block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1\">Assignment / Course</label>\n          <input id=\"rubric-course\" type=\"text\" placeholder=\"e.g. English 10 — Unit 3\"\n            class=\"w-full border border-gray-300 rounded-lg px-3 py-2 text-gray-700 focus:outline-none focus:ring-2 focus:ring-indigo-400\"\n            oninput=\"save()\" />\n        </div>\n      </div>\n    </div>\n\n    <!-- Level header legend -->\n    <div class=\"bg-indigo-50 border border-indigo-200 rounded-xl px-5 py-3 mb-4 hidden md:grid grid-cols-[2fr_80px_1fr_1fr_1fr_1fr_40px] gap-3 items-center text-xs font-semibold text-indigo-700 uppercase tracking-wide no-print\">\n      <span>Criterion</span>\n      <span class=\"text-center\">Weight&nbsp;%</span>\n      <span class=\"text-center px-1\">1 — Beginning</span>\n      <span class=\"text-center px-1\">2 — Developing</span>\n      <span class=\"text-center px-1\">3 — Proficient</span>\n      <span class=\"text-center px-1\">4 — Excellent</span>\n      <span></span>\n    </div>\n\n    <div id=\"criteria-list\"></div>\n\n    <button onclick=\"addCriterion()\"\n      class=\"no-print mt-4 w-full border-2 border-dashed border-indigo-300 text-indigo-500 rounded-xl py-3 font-semibold hover:bg-indigo-50 transition-colors\">\n      + Add Criterion\n    </button>\n\n    <!-- Weight total -->\n    <div id=\"weight-warning\" class=\"mt-3 text-sm font-semibold text-center hidden\"></div>\n\n  </div><!-- /builder-panel -->\n\n  <!-- ================================================================\n       GRADER PANEL\n  ================================================================ -->\n  <div id=\"grading-panel\" class=\"hidden\">\n\n    <!-- Student info -->\n    <div class=\"bg-white rounded-2xl shadow p-6 print-card mb-5\">\n      <h2 id=\"print-rubric-title\" class=\"text-xl font-bold text-gray-800 mb-1\"></h2>\n      <p id=\"print-rubric-course\" class=\"text-sm text-gray-500 mb-4\"></p>\n      <div class=\"flex flex-wrap gap-4\">\n        <div class=\"flex-1 min-w-[200px]\">\n          <label class=\"block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1\">Student Name</label>\n          <input id=\"student-name\" type=\"text\" placeholder=\"Full name\"\n            class=\"w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-400\"\n            oninput=\"computeScore()\" />\n        </div>\n        <div class=\"flex-1 min-w-[200px]\">\n          <label class=\"block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1\">Date</label>\n          <input id=\"grade-date\" type=\"date\"\n            class=\"w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-400\" />\n        </div>\n      </div>\n    </div>\n\n    <!-- Grading rows -->\n    <div id=\"grade-rows\" class=\"space-y-3 mb-5\"></div>\n\n    <!-- Score summary -->\n    <div class=\"bg-white rounded-2xl shadow p-6 print-card mb-5\">\n      <div class=\"flex items-center gap-6 flex-wrap\">\n        <div id=\"score-ring\" class=\"score-ring ring-A shrink-0\">—</div>\n        <div class=\"flex-1\">\n          <div class=\"text-4xl font-extrabold text-gray-800\" id=\"score-pct\">—</div>\n          <div class=\"text-lg font-semibold text-gray-500 mt-1\" id=\"score-label\">Grade your student to see results</div>\n          <div class=\"text-sm text-gray-400 mt-1\" id=\"score-detail\"></div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Per-criterion breakdown -->\n    <div class=\"bg-white rounded-2xl shadow p-6 print-card mb-5\">\n      <h3 class=\"font-bold text-gray-700 mb-3\">Per-Criterion Breakdown</h3>\n      <div id=\"breakdown-table\"></div>\n    </div>\n\n    <!-- Comments -->\n    <div class=\"bg-white rounded-2xl shadow p-6 print-card mb-5\">\n      <label class=\"block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2\">Teacher Comments (optional)</label>\n      <textarea id=\"teacher-comments\" rows=\"4\" placeholder=\"Write any overall feedback here…\"\n        class=\"w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-400 text-gray-700 resize-y\"></textarea>\n    </div>\n\n    <!-- Reset grades button -->\n    <div class=\"no-print flex justify-end\">\n      <button onclick=\"resetGrades()\"\n        class=\"px-4 py-2 text-sm bg-red-50 text-red-600 border border-red-200 rounded-lg hover:bg-red-100 font-semibold transition-colors\">\n        Reset Grades\n      </button>\n    </div>\n\n  </div><!-- /grading-panel -->\n\n</div><!-- /app -->\n\n<script>\n/* ══════════════════════════════════════════════════════════════════════\n   DATA MODEL\n══════════════════════════════════════════════════════════════════════ */\nconst STORAGE_KEY = 'rubric-grader-v1';\n\nconst DEFAULT_RUBRIC = {\n  title: 'Argumentative Essay Rubric',\n  course: 'English 10 — Unit 3',\n  criteria: [\n    {\n      id: uid(), name: 'Thesis & Claim',\n      weight: 20,\n      levels: [\n        'Thesis is absent or unclear; the central claim cannot be identified.',\n        'Thesis is present but vague; the claim is general and lacks focus.',\n        'Thesis is clear and arguable; the claim is stated with reasonable focus.',\n        'Thesis is compelling and specific; sets a precise, insightful direction.'\n      ]\n    },\n    {\n      id: uid(), name: 'Evidence & Support',\n      weight: 25,\n      levels: [\n        'Little or no evidence is used; sources are absent or irrelevant.',\n        'Some evidence is cited but it is insufficient or poorly integrated.',\n        'Adequate evidence from credible sources is cited and mostly integrated.',\n        'Strong, varied evidence is seamlessly integrated and clearly supports the argument.'\n      ]\n    },\n    {\n      id: uid(), name: 'Reasoning & Analysis',\n      weight: 25,\n      levels: [\n        'Reasoning is absent; evidence is listed without any analysis.',\n        'Reasoning is superficial; analysis rarely connects evidence to the claim.',\n        'Reasoning is logical; analysis connects most evidence to the claim.',\n        'Reasoning is thorough and nuanced; every piece of evidence deepens the argument.'\n      ]\n    },\n    {\n      id: uid(), name: 'Counterargument',\n      weight: 15,\n      levels: [\n        'No counterargument is acknowledged.',\n        'A counterargument is mentioned but not addressed.',\n        'A counterargument is acknowledged and briefly refuted.',\n        'A counterargument is acknowledged, refuted effectively, and strengthens the essay.'\n      ]\n    },\n    {\n      id: uid(), name: 'Organization & Structure',\n      weight: 10,\n      levels: [\n        'Essay lacks clear structure; paragraphs are disorganized and hard to follow.',\n        'Basic structure is present but transitions and flow are weak.',\n        'Essay is well-organized with clear introduction, body, and conclusion.',\n        'Essay flows seamlessly; structure enhances the persuasive impact throughout.'\n      ]\n    },\n    {\n      id: uid(), name: 'Language, Style & Mechanics',\n      weight: 5,\n      levels: [\n        'Frequent errors in grammar, spelling, or punctuation severely impede clarity.',\n        'Several errors are present; vocabulary is limited or imprecise.',\n        'Prose is mostly clear with minor errors; vocabulary is appropriate.',\n        'Prose is polished and precise; vocabulary is sophisticated and error-free.'\n      ]\n    }\n  ]\n};\n\nlet state = { rubric: null, grades: {} }; // grades: { criterionId: level (1-4) }\n\nfunction uid() {\n  return Math.random().toString(36).slice(2, 10);\n}\n\n/* ══════════════════════════════════════════════════════════════════════\n   PERSISTENCE\n══════════════════════════════════════════════════════════════════════ */\nfunction load() {\n  try {\n    const raw = localStorage.getItem(STORAGE_KEY);\n    if (raw) {\n      const parsed = JSON.parse(raw);\n      state.rubric = parsed.rubric || DEFAULT_RUBRIC;\n      state.grades = parsed.grades || {};\n    } else {\n      state.rubric = JSON.parse(JSON.stringify(DEFAULT_RUBRIC));\n      state.grades = {};\n    }\n  } catch (e) {\n    state.rubric = JSON.parse(JSON.stringify(DEFAULT_RUBRIC));\n    state.grades = {};\n  }\n}\n\nfunction save() {\n  // Collect current title/course from inputs if builder is active\n  const titleEl = document.getElementById('rubric-title');\n  const courseEl = document.getElementById('rubric-course');\n  if (titleEl) state.rubric.title = titleEl.value;\n  if (courseEl) state.rubric.course = courseEl.value;\n  localStorage.setItem(STORAGE_KEY, JSON.stringify({ rubric: state.rubric, grades: state.grades }));\n  updateWeightWarning();\n}\n\n/* ══════════════════════════════════════════════════════════════════════\n   TAB SWITCHING\n══════════════════════════════════════════════════════════════════════ */\nlet activeTab = 'builder';\n\nfunction switchTab(tab) {\n  activeTab = tab;\n  document.getElementById('builder-panel').classList.toggle('hidden', tab !== 'builder');\n  document.getElementById('grading-panel').classList.toggle('hidden', tab !== 'grader');\n  document.getElementById('tab-builder').className = tab === 'builder'\n    ? 'px-5 py-2 rounded-lg font-semibold text-sm transition-colors bg-indigo-600 text-white shadow'\n    : 'px-5 py-2 rounded-lg font-semibold text-sm transition-colors bg-white text-gray-600 hover:bg-gray-50 border border-gray-300';\n  document.getElementById('tab-grader').className = tab === 'grader'\n    ? 'px-5 py-2 rounded-lg font-semibold text-sm transition-colors bg-indigo-600 text-white shadow'\n    : 'px-5 py-2 rounded-lg font-semibold text-sm transition-colors bg-white text-gray-600 hover:bg-gray-50 border border-gray-300';\n  if (tab === 'grader') renderGrader();\n}\n\n/* ══════════════════════════════════════════════════════════════════════\n   BUILDER\n══════════════════════════════════════════════════════════════════════ */\nfunction renderBuilder() {\n  document.getElementById('rubric-title').value = state.rubric.title || '';\n  document.getElementById('rubric-course').value = state.rubric.course || '';\n  renderCriteriaList();\n  updateWeightWarning();\n}\n\nfunction renderCriteriaList() {\n  const list = document.getElementById('criteria-list');\n  list.innerHTML = '';\n  state.rubric.criteria.forEach((c, idx) => {\n    list.appendChild(buildCriterionRow(c, idx));\n  });\n}\n\nfunction buildCriterionRow(c, idx) {\n  const wrap = document.createElement('div');\n  wrap.className = 'bg-white rounded-2xl shadow print-card mb-3 p-4';\n  wrap.id = 'crit-' + c.id;\n\n  // Row 1: name + weight + delete\n  const topRow = document.createElement('div');\n  topRow.className = 'flex items-center gap-3 mb-3 flex-wrap';\n\n  const nameInput = document.createElement('input');\n  nameInput.type = 'text';\n  nameInput.value = c.name;\n  nameInput.placeholder = 'Criterion name';\n  nameInput.className = 'flex-1 min-w-[160px] border border-gray-300 rounded-lg px-3 py-1.5 font-semibold text-gray-800 focus:outline-none focus:ring-2 focus:ring-indigo-400';\n  nameInput.oninput = () => { c.name = nameInput.value; save(); };\n\n  const weightWrap = document.createElement('div');\n  weightWrap.className = 'flex items-center gap-1';\n  const wLabel = document.createElement('span');\n  wLabel.textContent = 'Weight:';\n  wLabel.className = 'text-xs font-semibold text-gray-500';\n  const weightInput = document.createElement('input');\n  weightInput.type = 'number';\n  weightInput.min = '1'; weightInput.max = '100';\n  weightInput.value = c.weight;\n  weightInput.className = 'w-16 border border-gray-300 rounded-lg px-2 py-1.5 text-center font-semibold text-gray-800 focus:outline-none focus:ring-2 focus:ring-indigo-400';\n  weightInput.oninput = () => { c.weight = parseInt(weightInput.value) || 0; save(); };\n  const wPct = document.createElement('span');\n  wPct.textContent = '%';\n  wPct.className = 'text-xs text-gray-400';\n  weightWrap.append(wLabel, weightInput, wPct);\n\n  const delBtn = document.createElement('button');\n  delBtn.innerHTML = '&#x2715;';\n  delBtn.title = 'Remove criterion';\n  delBtn.className = 'no-print text-red-400 hover:text-red-600 font-bold text-lg leading-none px-1';\n  delBtn.onclick = () => {\n    state.rubric.criteria.splice(idx, 1);\n    delete state.grades[c.id];\n    save();\n    renderCriteriaList();\n  };\n\n  topRow.append(nameInput, weightWrap, delBtn);\n\n  // Row 2: level descriptors\n  const levelsRow = document.createElement('div');\n  levelsRow.className = 'grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-2';\n\n  const levelLabels = ['1 — Beginning', '2 — Developing', '3 — Proficient', '4 — Excellent'];\n  const levelColors = ['border-red-200 bg-red-50', 'border-yellow-200 bg-yellow-50', 'border-blue-200 bg-blue-50', 'border-green-200 bg-green-50'];\n  const labelColors = ['text-red-600', 'text-yellow-700', 'text-blue-700', 'text-green-700'];\n\n  c.levels.forEach((desc, li) => {\n    const cell = document.createElement('div');\n    cell.className = 'rounded-lg border p-2 ' + levelColors[li];\n\n    const lbl = document.createElement('div');\n    lbl.textContent = levelLabels[li];\n    lbl.className = 'text-xs font-bold mb-1 ' + labelColors[li];\n\n    const ta = document.createElement('textarea');\n    ta.value = desc;\n    ta.rows = 3;\n    ta.placeholder = 'Describe this level…';\n    ta.className = 'w-full text-xs text-gray-700 bg-transparent border-none resize-none focus:outline-none focus:ring-0 leading-snug';\n    ta.oninput = () => { c.levels[li] = ta.value; save(); };\n\n    cell.append(lbl, ta);\n    levelsRow.appendChild(cell);\n  });\n\n  wrap.append(topRow, levelsRow);\n  return wrap;\n}\n\nfunction addCriterion() {\n  state.rubric.criteria.push({\n    id: uid(),\n    name: 'New Criterion',\n    weight: 10,\n    levels: [\n      'Does not meet expectations.',\n      'Partially meets expectations.',\n      'Meets expectations.',\n      'Exceeds expectations.'\n    ]\n  });\n  save();\n  renderCriteriaList();\n  // Scroll to new item\n  const list = document.getElementById('criteria-list');\n  list.lastElementChild && list.lastElementChild.scrollIntoView({ behavior: 'smooth', block: 'center' });\n}\n\nfunction updateWeightWarning() {\n  const total = state.rubric.criteria.reduce((s, c) => s + (parseInt(c.weight) || 0), 0);\n  const el = document.getElementById('weight-warning');\n  if (!el) return;\n  if (total === 100) {\n    el.className = 'mt-3 text-sm font-semibold text-center text-green-600';\n    el.textContent = 'Weights total: 100% ✓';\n    el.classList.remove('hidden');\n  } else {\n    el.className = 'mt-3 text-sm font-semibold text-center text-amber-600';\n    el.textContent = `Weights total: ${total}% — adjust to reach 100% for correct scoring.`;\n    el.classList.remove('hidden');\n  }\n}\n\n/* ══════════════════════════════════════════════════════════════════════\n   GRADER\n══════════════════════════════════════════════════════════════════════ */\nfunction renderGrader() {\n  // Header info\n  document.getElementById('print-rubric-title').textContent = state.rubric.title || 'Untitled Rubric';\n  document.getElementById('print-rubric-course').textContent = state.rubric.course || '';\n\n  // Set today's date if empty\n  const dateEl = document.getElementById('grade-date');\n  if (!dateEl.value) dateEl.value = new Date().toISOString().slice(0, 10);\n\n  const container = document.getElementById('grade-rows');\n  container.innerHTML = '';\n\n  state.rubric.criteria.forEach(c => {\n    const card = document.createElement('div');\n    card.className = 'bg-white rounded-2xl shadow print-card p-4';\n\n    const header = document.createElement('div');\n    header.className = 'flex items-baseline gap-2 mb-3 flex-wrap';\n    const nameSpan = document.createElement('span');\n    nameSpan.className = 'font-bold text-gray-800';\n    nameSpan.textContent = c.name;\n    const wtSpan = document.createElement('span');\n    wtSpan.className = 'text-xs text-gray-400 font-medium';\n    wtSpan.textContent = `(${c.weight}%)`;\n    header.append(nameSpan, wtSpan);\n\n    const levels = document.createElement('div');\n    levels.className = 'grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-2';\n\n    const levelLabels = ['1 — Beginning', '2 — Developing', '3 — Proficient', '4 — Excellent'];\n\n    c.levels.forEach((desc, li) => {\n      const levelNum = li + 1;\n      const btn = document.createElement('button');\n      btn.id = `level-btn-${c.id}-${levelNum}`;\n      btn.className = 'level-btn text-left rounded-lg border-2 border-gray-200 bg-gray-50 px-3 py-2 hover:border-gray-400 transition-all';\n      if (state.grades[c.id] === levelNum) {\n        btn.classList.add('selected-' + levelNum);\n        btn.classList.remove('bg-gray-50');\n      }\n\n      const lbl = document.createElement('div');\n      lbl.className = 'text-xs font-bold mb-1 text-gray-500';\n      lbl.textContent = levelLabels[li];\n\n      const descEl = document.createElement('p');\n      descEl.className = 'text-xs text-gray-600 leading-snug';\n      descEl.textContent = desc;\n\n      btn.append(lbl, descEl);\n      btn.onclick = () => selectLevel(c.id, levelNum);\n      levels.appendChild(btn);\n    });\n\n    card.append(header, levels);\n    container.appendChild(card);\n  });\n\n  computeScore();\n}\n\nfunction selectLevel(criterionId, level) {\n  // Toggle off if already selected\n  if (state.grades[criterionId] === level) {\n    delete state.grades[criterionId];\n  } else {\n    state.grades[criterionId] = level;\n  }\n  save();\n\n  // Update button appearances for this criterion\n  for (let i = 1; i <= 4; i++) {\n    const btn = document.getElementById(`level-btn-${criterionId}-${i}`);\n    if (!btn) continue;\n    btn.className = 'level-btn text-left rounded-lg border-2 border-gray-200 bg-gray-50 px-3 py-2 hover:border-gray-400 transition-all';\n    if (state.grades[criterionId] === i) {\n      btn.classList.add('selected-' + i);\n      btn.classList.remove('bg-gray-50');\n    }\n    // preserve children layout\n    const lbl = btn.children[0];\n    const descEl = btn.children[1];\n    if (lbl) lbl.className = 'text-xs font-bold mb-1 text-gray-500';\n    if (descEl) descEl.className = 'text-xs text-gray-600 leading-snug';\n  }\n\n  computeScore();\n}\n\nfunction computeScore() {\n  const criteria = state.rubric.criteria;\n  const totalWeight = criteria.reduce((s, c) => s + (parseInt(c.weight) || 0), 0) || 100;\n\n  let weightedSum = 0;\n  let gradedWeight = 0;\n\n  criteria.forEach(c => {\n    const lvl = state.grades[c.id];\n    if (lvl != null) {\n      weightedSum += ((lvl / 4) * (parseInt(c.weight) || 0));\n      gradedWeight += (parseInt(c.weight) || 0);\n    }\n  });\n\n  const gradedCount = Object.keys(state.grades).length;\n  const allGraded = gradedCount === criteria.length && criteria.length > 0;\n\n  const pct = totalWeight > 0 ? Math.round((weightedSum / totalWeight) * 100) : 0;\n\n  // Letter / band\n  let letter, feedback, ringClass;\n  if (!allGraded) {\n    letter = '—';\n    feedback = `${gradedCount} of ${criteria.length} criteria graded`;\n    ringClass = 'ring-A';\n  } else if (pct >= 90) {\n    letter = 'A'; feedback = 'Excellent work — outstanding performance across all criteria.'; ringClass = 'ring-A';\n  } else if (pct >= 80) {\n    letter = 'B'; feedback = 'Good work — solid performance with minor areas for growth.'; ringClass = 'ring-B';\n  } else if (pct >= 70) {\n    letter = 'C'; feedback = 'Satisfactory — meets basic expectations but needs improvement.'; ringClass = 'ring-C';\n  } else if (pct >= 60) {\n    letter = 'D'; feedback = 'Below average — several significant areas need attention.'; ringClass = 'ring-D';\n  } else {\n    letter = 'F'; feedback = 'Does not yet meet expectations — major revision required.'; ringClass = 'ring-F';\n  }\n\n  const ring = document.getElementById('score-ring');\n  ring.textContent = letter;\n  ring.className = 'score-ring shrink-0 ' + ringClass;\n\n  document.getElementById('score-pct').textContent = allGraded ? pct + '%' : (gradedCount > 0 ? 'In progress…' : '—');\n  document.getElementById('score-label').textContent = feedback;\n  document.getElementById('score-detail').textContent = allGraded\n    ? `Weighted points: ${weightedSum.toFixed(1)} / ${totalWeight}`\n    : '';\n\n  renderBreakdown(weightedSum, totalWeight);\n}\n\nfunction renderBreakdown(weightedSum, totalWeight) {\n  const container = document.getElementById('breakdown-table');\n  container.innerHTML = '';\n\n  const table = document.createElement('table');\n  table.className = 'w-full text-sm border-collapse';\n\n  const thead = document.createElement('thead');\n  thead.innerHTML = `<tr class=\"border-b border-gray-200 text-xs text-gray-500 uppercase\">\n    <th class=\"text-left py-2 pr-3 font-semibold\">Criterion</th>\n    <th class=\"text-center py-2 px-2 font-semibold\">Weight</th>\n    <th class=\"text-center py-2 px-2 font-semibold\">Level</th>\n    <th class=\"text-right py-2 pl-2 font-semibold\">Contribution</th>\n  </tr>`;\n  table.appendChild(thead);\n\n  const tbody = document.createElement('tbody');\n  state.rubric.criteria.forEach(c => {\n    const lvl = state.grades[c.id];\n    const w = parseInt(c.weight) || 0;\n    const contrib = lvl != null ? ((lvl / 4) * w).toFixed(1) : '—';\n\n    const levelNames = ['—', 'Beginning', 'Developing', 'Proficient', 'Excellent'];\n    const levelColors = ['text-gray-400', 'text-red-600', 'text-yellow-700', 'text-blue-700', 'text-green-700'];\n    const lColor = lvl != null ? levelColors[lvl] : levelColors[0];\n\n    const tr = document.createElement('tr');\n    tr.className = 'border-b border-gray-100 last:border-0';\n    tr.innerHTML = `\n      <td class=\"py-2 pr-3 font-medium text-gray-700\">${escHtml(c.name)}</td>\n      <td class=\"py-2 px-2 text-center text-gray-500\">${w}%</td>\n      <td class=\"py-2 px-2 text-center font-semibold ${lColor}\">${lvl != null ? lvl + ' — ' + levelNames[lvl] : '—'}</td>\n      <td class=\"py-2 pl-2 text-right font-semibold text-gray-700\">${contrib !== '—' ? contrib + ' pts' : '—'}</td>\n    `;\n    tbody.appendChild(tr);\n  });\n\n  // Total row\n  const totalGraded = Object.keys(state.grades).length === state.rubric.criteria.length && state.rubric.criteria.length > 0;\n  const trTotal = document.createElement('tr');\n  trTotal.className = 'font-bold bg-gray-50';\n  const pctDisplay = totalGraded ? Math.round((weightedSum / totalWeight) * 100) + '%' : '—';\n  trTotal.innerHTML = `\n    <td class=\"py-2 pr-3 text-gray-800\" colspan=\"1\">Total</td>\n    <td class=\"py-2 px-2 text-center text-gray-600\">${totalWeight}%</td>\n    <td class=\"py-2 px-2 text-center text-gray-600\">${pctDisplay}</td>\n    <td class=\"py-2 pl-2 text-right text-gray-800\">${totalGraded ? weightedSum.toFixed(1) + ' pts' : '—'}</td>\n  `;\n  tbody.appendChild(trTotal);\n\n  table.appendChild(tbody);\n  container.appendChild(table);\n}\n\nfunction resetGrades() {\n  if (!confirm('Clear all selected levels for this student?')) return;\n  state.grades = {};\n  document.getElementById('student-name').value = '';\n  document.getElementById('teacher-comments').value = '';\n  save();\n  renderGrader();\n}\n\n/* ══════════════════════════════════════════════════════════════════════\n   UTILITIES\n══════════════════════════════════════════════════════════════════════ */\nfunction escHtml(str) {\n  return String(str)\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .replace(/\"/g, '&quot;');\n}\n\n/* ══════════════════════════════════════════════════════════════════════\n   INIT\n══════════════════════════════════════════════════════════════════════ */\n(function init() {\n  load();\n  renderBuilder();\n})();\n</script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Rubric Grader",
    "windowTitle": "Rubric Grader",
    "bundleId": "com.halisonworks.rubricgrader",
    "iconPath": null
  },
