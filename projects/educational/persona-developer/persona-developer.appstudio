{
  "schema": "app-studio/canvas@1",
  "id": "example-persona-developer",
  "name": "persona-developer.html",
  "code": "<!DOCTYPE html>\n<!--\n  Persona Developer — Halison App Studio example\n\n  A method tool for building customer personas: demographics, geography,\n  psychographics, and behavior. Three modes — Learn, Practice, and Present —\n  with audience templates, an inspiration generator, and a clean persona card\n  for a projector or print.\n\n  From the Halison App Studio public library:\n  https://github.com/halisonworks/public-app-studio\n\n  Permitted use: personal, educational, and other non-commercial use. You may\n  modify it, but keep this header and the source link intact, and do not sell,\n  commercialize, or republish it. Released under the Halison App Studio Examples\n  License — see the LICENSE file in the repository above.\n-->\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Persona Developer</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n\n    <style>\n        body {\n            font-family: 'Inter', sans-serif;\n            background-color: #f8fafc;\n        }\n        ::-webkit-scrollbar {\n            width: 8px;\n        }\n        ::-webkit-scrollbar-track {\n            background: #f1f5f9;\n        }\n        ::-webkit-scrollbar-thumb {\n            background: #cbd5e1;\n            border-radius: 9999px;\n        }\n        ::-webkit-scrollbar-thumb:hover {\n            background: #94a3b8;\n        }\n\n        /* Print optimization: strip the noise and isolate just the card */\n        @media print {\n            body {\n                background: #ffffff !important;\n            }\n            .no-print {\n                display: none !important;\n            }\n            .print-container {\n                display: block !important;\n                width: 100% !important;\n            }\n            .print-bg-primary {\n                background-color: #1e293b !important;\n                -webkit-print-color-adjust: exact;\n                print-color-adjust: exact;\n            }\n            .print-bg-card {\n                background-color: #ffffff !important;\n                border: 1px solid #e2e8f0 !important;\n                -webkit-print-color-adjust: exact;\n                print-color-adjust: exact;\n            }\n            .print-text-white {\n                color: #ffffff !important;\n                -webkit-print-color-adjust: exact;\n                print-color-adjust: exact;\n            }\n        }\n        .template-btn {\n            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);\n        }\n        .template-btn:hover {\n            transform: translateY(-2px);\n        }\n    </style>\n</head>\n<body class=\"min-h-screen text-slate-800 antialiased flex flex-col justify-between pb-12\">\n\n    <div class=\"max-w-6xl w-full mx-auto px-4 sm:px-6 lg:px-8 mt-6 flex-grow\">\n\n        <!-- GLOBAL HEADER (hidden in presentation mode) -->\n        <header id=\"global-header\" class=\"mb-8 no-print flex flex-col sm:flex-row items-center justify-between gap-4 border-b border-slate-200 pb-6\">\n            <div>\n                <div class=\"flex items-center gap-2 mb-1\">\n                    <span class=\"p-1.5 bg-slate-900 text-white rounded-lg inline-flex items-center justify-center\">\n                        <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\">\n                            <path d=\"M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z\"></path>\n                        </svg>\n                    </span>\n                    <span class=\"text-xs font-bold uppercase tracking-wider text-slate-500\">Teaching tool</span>\n                </div>\n                <h1 class=\"text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight\">Persona Developer</h1>\n            </div>\n            <div class=\"flex items-center gap-3\">\n                <button onclick=\"openResetModal()\" class=\"px-3.5 py-2 text-xs font-semibold text-rose-600 hover:bg-rose-50 border border-rose-200 rounded-lg transition-all flex items-center gap-1.5 shadow-sm bg-white\">\n                    <svg class=\"w-3.5 h-3.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" viewBox=\"0 0 24 24\">\n                        <path d=\"M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16\"></path>\n                    </svg>\n                    Reset fields\n                </button>\n            </div>\n        </header>\n\n        <!-- GLOBAL TWO-LEVEL NAV (hidden in presentation and print) -->\n        <nav id=\"global-nav\" class=\"no-print bg-slate-100 p-1.5 rounded-xl mb-8 flex flex-wrap gap-1 border border-slate-200/60 shadow-inner\">\n            <button id=\"btn-learn\" onclick=\"switchTab('learn')\" class=\"flex-1 min-w-[120px] flex items-center justify-center gap-2 px-4 py-3 rounded-lg text-sm font-semibold transition-all duration-200 bg-white text-slate-900 shadow-sm border border-slate-200/50\">\n                1. Learn mode\n            </button>\n            <button id=\"btn-practice\" onclick=\"switchTab('practice')\" class=\"flex-1 min-w-[120px] flex items-center justify-center gap-2 px-4 py-3 rounded-lg text-sm font-semibold transition-all duration-200 text-slate-600 hover:text-slate-900\">\n                2. Practice mode\n            </button>\n            <button id=\"btn-present\" onclick=\"switchTab('present')\" class=\"flex-1 min-w-[120px] flex items-center justify-center gap-2 px-4 py-3 rounded-lg text-sm font-semibold transition-all duration-200 text-slate-600 hover:text-slate-900 bg-indigo-50/50 text-indigo-700 hover:bg-indigo-50\">\n                3. Present\n            </button>\n        </nav>\n\n        <!-- QUICK START AND TEMPLATES (hidden in presentation mode) -->\n        <div id=\"template-section\" class=\"no-print mb-8 space-y-3\">\n            <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2\">\n                <h3 class=\"text-xs font-bold text-slate-500 uppercase tracking-widest flex items-center gap-2\">\n                    <svg class=\"w-4 h-4 text-indigo-600\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\">\n                        <path d=\"M13 10V3L4 14h7v7l9-11h-7z\"></path>\n                    </svg>\n                    Quick start: pick an audience template or get inspired\n                </h3>\n                <button onclick=\"generateRandomPersona()\" class=\"text-xs font-bold text-indigo-700 hover:text-indigo-800 flex items-center justify-center gap-1.5 bg-indigo-100 hover:bg-indigo-200 px-3.5 py-2 rounded-lg transition-all shadow-sm\">\n                    <span>🎲</span> Inspiration generator\n                </button>\n            </div>\n            <div class=\"grid grid-cols-2 md:grid-cols-4 gap-3\">\n                <button onclick=\"loadTemplate('student')\" class=\"template-btn p-3 bg-white border border-slate-200 rounded-xl text-left hover:border-indigo-400 hover:shadow-md group transition-all\">\n                    <div class=\"text-xl mb-1\">🧑‍🎓</div>\n                    <div class=\"text-[11px] font-bold text-slate-900 uppercase\">Student</div>\n                    <div class=\"text-[10px] text-slate-500 line-clamp-1\">Youth enterprise / digital trends</div>\n                </button>\n                <button onclick=\"loadTemplate('parent')\" class=\"template-btn p-3 bg-white border border-slate-200 rounded-xl text-left hover:border-emerald-400 hover:shadow-md group transition-all\">\n                    <div class=\"text-xl mb-1\">🌱</div>\n                    <div class=\"text-[11px] font-bold text-slate-900 uppercase\">Eco parent</div>\n                    <div class=\"text-[10px] text-slate-500 line-clamp-1\">Sustainability & everyday life</div>\n                </button>\n                <button onclick=\"loadTemplate('senior')\" class=\"template-btn p-3 bg-white border border-slate-200 rounded-xl text-left hover:border-amber-400 hover:shadow-md group transition-all\">\n                    <div class=\"text-xl mb-1\">👴</div>\n                    <div class=\"text-[11px] font-bold text-slate-900 uppercase\">Digital senior</div>\n                    <div class=\"text-[10px] text-slate-500 line-clamp-1\">Simplicity & personal service</div>\n                </button>\n                <button onclick=\"loadTemplate('b2b')\" class=\"template-btn p-3 bg-white border border-slate-200 rounded-xl text-left hover:border-slate-400 hover:shadow-md group transition-all\">\n                    <div class=\"text-xl mb-1\">💼</div>\n                    <div class=\"text-[11px] font-bold text-slate-900 uppercase\">Business leader</div>\n                    <div class=\"text-[10px] text-slate-500 line-clamp-1\">Targeted B2B sales & ROI</div>\n                </button>\n            </div>\n        </div>\n\n        <!-- PART 1: LEARN MODE -->\n        <div id=\"panel-learn\" class=\"tab-panel space-y-8\">\n            <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-8\">\n\n                <!-- Demographics, geography & urbanity -->\n                <div class=\"bg-white rounded-2xl border border-slate-200 p-6 shadow-sm space-y-6\">\n                    <div class=\"border-b border-slate-100 pb-4\">\n                        <span class=\"text-xs font-bold text-indigo-600 uppercase tracking-widest\">Part A</span>\n                        <h2 class=\"text-lg font-bold text-slate-950 mt-1\">Demographics & Geography</h2>\n                    </div>\n                    <div class=\"bg-indigo-50/50 border-l-4 border-indigo-500 p-4 rounded-r-xl\">\n                        <p class=\"text-xs text-indigo-800 leading-relaxed\"><strong>What is this?</strong> Demographics and geography map the outer, measurable facts about your customer. They make the market size easier to estimate.</p>\n                    </div>\n                    <div class=\"space-y-4\">\n                        <div class=\"space-y-1.5\">\n                            <label class=\"text-xs font-bold text-slate-700 uppercase\">Full name</label>\n                            <input type=\"text\" data-bind=\"name\" placeholder=\"e.g. Camilla Career\" class=\"w-full px-3.5 py-2.5 rounded-lg border border-slate-200 focus:border-indigo-500 text-sm outline-none transition-all\">\n                        </div>\n                        <div class=\"grid grid-cols-2 gap-4\">\n                            <div class=\"space-y-1.5\">\n                                <label class=\"text-xs font-bold text-slate-700 uppercase\">Age</label>\n                                <input type=\"number\" data-bind=\"age\" placeholder=\"e.g. 34\" class=\"w-full px-3.5 py-2.5 rounded-lg border border-slate-200 focus:border-indigo-500 text-sm outline-none transition-all\">\n                            </div>\n                            <div class=\"space-y-1.5\">\n                                <label class=\"text-xs font-bold text-slate-700 uppercase\">Marital status</label>\n                                <input type=\"text\" data-bind=\"civil\" placeholder=\"e.g. Partner, 1 child\" class=\"w-full px-3.5 py-2.5 rounded-lg border border-slate-200 focus:border-indigo-500 text-sm outline-none transition-all\">\n                            </div>\n                        </div>\n                        <div class=\"grid grid-cols-2 gap-4\">\n                            <div class=\"space-y-1.5\">\n                                <label class=\"text-xs font-bold text-slate-700 uppercase\">Occupation / title</label>\n                                <input type=\"text\" data-bind=\"occupation\" placeholder=\"e.g. Project manager\" class=\"w-full px-3.5 py-2.5 rounded-lg border border-slate-200 focus:border-indigo-500 text-sm outline-none transition-all\">\n                            </div>\n                            <div class=\"space-y-1.5\">\n                                <label class=\"text-xs font-bold text-slate-700 uppercase\">Income / resources</label>\n                                <input type=\"text\" data-bind=\"income\" placeholder=\"e.g. 650,000 kr\" class=\"w-full px-3.5 py-2.5 rounded-lg border border-slate-200 focus:border-indigo-500 text-sm outline-none transition-all\">\n                            </div>\n                        </div>\n                        <div class=\"grid grid-cols-2 gap-4\">\n                            <div class=\"space-y-1.5\">\n                                <label class=\"text-xs font-bold text-slate-700 uppercase\">Location</label>\n                                <input type=\"text\" data-bind=\"location\" placeholder=\"e.g. Oslo\" class=\"w-full px-3.5 py-2.5 rounded-lg border border-slate-200 focus:border-indigo-500 text-sm outline-none transition-all\">\n                            </div>\n                            <div class=\"space-y-1.5\">\n                                <label class=\"text-xs font-bold text-slate-700 uppercase\">Urbanity / setting</label>\n                                <input type=\"text\" data-bind=\"urbanity\" placeholder=\"e.g. City / Suburb / Rural\" class=\"w-full px-3.5 py-2.5 rounded-lg border border-slate-200 focus:border-indigo-500 text-sm outline-none transition-all\">\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Psychographics & behavior -->\n                <div class=\"bg-white rounded-2xl border border-slate-200 p-6 shadow-sm space-y-6\">\n                    <div class=\"border-b border-slate-100 pb-4\">\n                        <span class=\"text-xs font-bold text-emerald-600 uppercase tracking-widest\">Part B</span>\n                        <h2 class=\"text-lg font-bold text-slate-950 mt-1\">Psychographics & Behavior</h2>\n                    </div>\n                    <div class=\"bg-emerald-50/50 border-l-4 border-emerald-500 p-4 rounded-r-xl\">\n                        <p class=\"text-xs text-emerald-800 leading-relaxed\"><strong>What is this?</strong> Goes deeper into *why* the customer buys. Map values, attitudes, interests, and the real challenges they meet day to day.</p>\n                    </div>\n                    <div class=\"space-y-4\">\n                        <div class=\"space-y-1.5\">\n                            <label class=\"text-xs font-bold text-slate-700 uppercase\">Values, lifestyle & sustainability</label>\n                            <textarea data-bind=\"values\" placeholder=\"e.g. Cares about organic ingredients, quality over quantity, and an active life...\" class=\"w-full h-24 px-3.5 py-2 rounded-lg border border-slate-200 focus:border-emerald-500 text-sm outline-none resize-none transition-all\"></textarea>\n                            <span class=\"text-[11px] text-slate-400 block italic\">What is the persona's view on eco-friendly products or ethical trade?</span>\n                        </div>\n                        <div class=\"space-y-1.5\">\n                            <label class=\"text-xs font-bold text-slate-700 uppercase\">Buying goals & motivation</label>\n                            <textarea data-bind=\"motivation\" placeholder=\"e.g. Wants a faster, healthier, less stressful dinner solution for the whole family...\" class=\"w-full h-24 px-3.5 py-2 rounded-lg border border-slate-200 focus:border-emerald-500 text-sm outline-none resize-none transition-all\"></textarea>\n                        </div>\n                        <div class=\"space-y-1.5\">\n                            <label class=\"text-xs font-bold text-slate-700 uppercase\">Challenges (pain points)</label>\n                            <textarea data-bind=\"painpoints\" placeholder=\"e.g. Feels constant guilt about the time squeeze and high grocery prices...\" class=\"w-full h-24 px-3.5 py-2 rounded-lg border border-slate-200 focus:border-emerald-500 text-sm outline-none resize-none transition-all\"></textarea>\n                        </div>\n                    </div>\n                </div>\n\n            </div>\n        </div>\n\n        <!-- PART 2: PRACTICE MODE (efficient, no extra text) -->\n        <div id=\"panel-practice\" class=\"tab-panel hidden space-y-6\">\n            <div class=\"bg-white rounded-2xl border border-slate-200 p-6 shadow-sm grid grid-cols-1 md:grid-cols-2 gap-6\">\n                <div class=\"space-y-4\">\n                    <h3 class=\"text-xs font-extrabold text-slate-400 uppercase tracking-widest border-b pb-2\">Compact background data</h3>\n                    <div class=\"space-y-1.5\">\n                        <label class=\"text-xs font-bold text-slate-600\">Name</label>\n                        <input type=\"text\" data-bind=\"name\" class=\"w-full px-3 py-2 rounded-lg border border-slate-200 text-sm outline-none focus:border-indigo-500\">\n                    </div>\n                    <div class=\"grid grid-cols-2 gap-4\">\n                        <div class=\"space-y-1.5\">\n                            <label class=\"text-xs font-bold text-slate-600\">Age</label>\n                            <input type=\"number\" data-bind=\"age\" class=\"w-full px-3 py-2 rounded-lg border border-slate-200 text-sm outline-none focus:border-indigo-500\">\n                        </div>\n                        <div class=\"space-y-1.5\">\n                            <label class=\"text-xs font-bold text-slate-600\">Marital status</label>\n                            <input type=\"text\" data-bind=\"civil\" class=\"w-full px-3 py-2 rounded-lg border border-slate-200 text-sm outline-none focus:border-indigo-500\">\n                        </div>\n                    </div>\n                    <div class=\"grid grid-cols-2 gap-4\">\n                        <div class=\"space-y-1.5\">\n                            <label class=\"text-xs font-bold text-slate-600\">Occupation</label>\n                            <input type=\"text\" data-bind=\"occupation\" class=\"w-full px-3 py-2 rounded-lg border border-slate-200 text-sm outline-none focus:border-indigo-500\">\n                        </div>\n                        <div class=\"space-y-1.5\">\n                            <label class=\"text-xs font-bold text-slate-600\">Income</label>\n                            <input type=\"text\" data-bind=\"income\" class=\"w-full px-3 py-2 rounded-lg border border-slate-200 text-sm outline-none focus:border-indigo-500\">\n                        </div>\n                    </div>\n                    <div class=\"grid grid-cols-2 gap-4\">\n                        <div class=\"space-y-1.5\">\n                            <label class=\"text-xs font-bold text-slate-600\">Location</label>\n                            <input type=\"text\" data-bind=\"location\" class=\"w-full px-3 py-2 rounded-lg border border-slate-200 text-sm outline-none focus:border-indigo-500\">\n                        </div>\n                        <div class=\"space-y-1.5\">\n                            <label class=\"text-xs font-bold text-slate-600\">Urbanity</label>\n                            <input type=\"text\" data-bind=\"urbanity\" class=\"w-full px-3 py-2 rounded-lg border border-slate-200 text-sm outline-none focus:border-indigo-500\">\n                        </div>\n                    </div>\n                </div>\n                <div class=\"space-y-4\">\n                    <h3 class=\"text-xs font-extrabold text-slate-400 uppercase tracking-widest border-b pb-2\">Customer mindset & behavior</h3>\n                    <div class=\"space-y-1.5\">\n                        <label class=\"text-xs font-bold text-slate-600\">Values & lifestyle</label>\n                        <textarea data-bind=\"values\" rows=\"3\" class=\"w-full px-3 py-2 rounded-lg border border-slate-200 text-sm outline-none focus:border-indigo-500 resize-none\"></textarea>\n                    </div>\n                    <div class=\"space-y-1.5\">\n                        <label class=\"text-xs font-bold text-slate-600\">Buying goals & motivation</label>\n                        <textarea data-bind=\"motivation\" rows=\"3\" class=\"w-full px-3 py-2 rounded-lg border border-slate-200 text-sm outline-none focus:border-indigo-500 resize-none\"></textarea>\n                    </div>\n                    <div class=\"space-y-1.5\">\n                        <label class=\"text-xs font-bold text-slate-600\">Challenges (pain points)</label>\n                        <textarea data-bind=\"painpoints\" rows=\"3\" class=\"w-full px-3 py-2 rounded-lg border border-slate-200 text-sm outline-none focus:border-indigo-500 resize-none\"></textarea>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- PART 3: PRESENTATION MODE (a clean, standalone graphic card) -->\n        <div id=\"panel-present\" class=\"tab-panel hidden\">\n            <div class=\"print-container flex justify-center py-6\">\n                <div class=\"print-bg-card bg-white w-full max-w-4xl rounded-2xl border border-slate-200 shadow-xl overflow-hidden grid grid-cols-1 md:grid-cols-12\">\n\n                    <!-- Left side (colored background, personal details) -->\n                    <div class=\"print-bg-primary md:col-span-4 bg-slate-900 text-white p-8 flex flex-col items-center text-center justify-between gap-6 relative\">\n                        <div class=\"w-full space-y-4 z-10\">\n                            <!-- Profile symbol -->\n                            <div class=\"w-24 h-24 print-bg-card bg-slate-800 rounded-2xl mx-auto flex items-center justify-center text-4xl border border-slate-700 shadow-inner select-none font-bold\" id=\"card-avatar\">👤</div>\n                            <div>\n                                <h2 class=\"text-2xl font-extrabold text-white tracking-tight\" id=\"card-name\">Camilla Career</h2>\n                                <p class=\"text-indigo-400 text-[10px] font-bold uppercase tracking-widest mt-1.5\" id=\"card-occupation\">Project manager</p>\n                            </div>\n                        </div>\n\n                        <!-- Demographic data -->\n                        <div class=\"w-full bg-slate-800/40 rounded-xl p-4 border border-slate-800/60 text-left text-[11px] space-y-2\">\n                            <div class=\"flex justify-between border-b border-slate-700/50 pb-1.5\">\n                                <span class=\"text-slate-400\">Age</span>\n                                <span class=\"font-bold text-white\" id=\"card-age\">34 yrs</span>\n                            </div>\n                            <div class=\"flex justify-between border-b border-slate-700/50 pb-1.5\">\n                                <span class=\"text-slate-400\">Marital status</span>\n                                <span class=\"font-bold text-white\" id=\"card-civil\">Partner</span>\n                            </div>\n                            <div class=\"flex justify-between border-b border-slate-700/50 pb-1.5\">\n                                <span class=\"text-slate-400\">Income</span>\n                                <span class=\"font-bold text-white\" id=\"card-income\">650k</span>\n                            </div>\n                            <div class=\"flex justify-between border-b border-slate-700/50 pb-1.5\">\n                                <span class=\"text-slate-400\">Location</span>\n                                <span class=\"font-bold text-white\" id=\"card-location\">Oslo</span>\n                            </div>\n                            <div class=\"flex justify-between\">\n                                <span class=\"text-slate-400\">Urbanity</span>\n                                <span class=\"font-bold text-white\" id=\"card-urbanity\">City</span>\n                            </div>\n                        </div>\n\n                        <span class=\"text-[9px] text-slate-500 uppercase tracking-widest block\">Method tool • Canvas</span>\n                    </div>\n\n                    <!-- Right side (content sections, white background) -->\n                    <div class=\"md:col-span-8 p-8 space-y-6 bg-white text-slate-800 flex flex-col justify-between\">\n                        <div class=\"space-y-6\">\n                            <div class=\"space-y-1.5\">\n                                <h3 class=\"text-[10px] font-bold uppercase tracking-wider text-slate-400 border-b border-slate-100 pb-1\">Values & lifestyle</h3>\n                                <p class=\"text-sm leading-relaxed text-slate-600 whitespace-pre-line\" id=\"card-values\"></p>\n                            </div>\n                            <div class=\"space-y-1.5\">\n                                <h3 class=\"text-[10px] font-bold uppercase tracking-wider text-slate-400 border-b border-slate-100 pb-1\">Motivation & buying goals</h3>\n                                <p class=\"text-sm leading-relaxed text-slate-600 whitespace-pre-line\" id=\"card-motivation\"></p>\n                            </div>\n                            <div class=\"space-y-1.5\">\n                                <h3 class=\"text-[10px] font-bold uppercase tracking-wider text-slate-400 border-b border-slate-100 pb-1\">Challenges (pain points)</h3>\n                                <p class=\"text-sm leading-relaxed text-slate-600 whitespace-pre-line\" id=\"card-painpoints\"></p>\n                            </div>\n                        </div>\n                    </div>\n\n                </div>\n            </div>\n        </div>\n\n    </div>\n\n    <!-- RESET MODAL (a safeguard instead of alert) -->\n    <div id=\"reset-modal\" class=\"no-print fixed inset-0 bg-slate-950/40 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden\">\n        <div class=\"bg-white rounded-2xl max-w-sm w-full p-6 border shadow-2xl space-y-4\">\n            <div class=\"w-12 h-12 bg-rose-50 border border-rose-200 rounded-xl flex items-center justify-center text-xl text-rose-600\">⚠️</div>\n            <div>\n                <h3 class=\"font-bold text-slate-900 text-base\">Reset all data?</h3>\n                <p class=\"text-xs text-slate-500 mt-1\">This clears all text, saved progress, and any selected template. This can't be undone.</p>\n            </div>\n            <div class=\"flex gap-2\">\n                <button onclick=\"closeResetModal()\" class=\"flex-1 py-2 text-xs font-semibold bg-slate-100 hover:bg-slate-200 rounded-lg text-slate-700 transition-all\">Cancel</button>\n                <button onclick=\"confirmReset()\" class=\"flex-1 py-2 text-xs font-semibold text-white bg-rose-600 hover:bg-rose-700 rounded-lg transition-all\">Delete all</button>\n            </div>\n        </div>\n    </div>\n\n    <script>\n        const personaFields = {\n            name: \"\",\n            age: \"\",\n            civil: \"\",\n            occupation: \"\",\n            income: \"\",\n            location: \"\",\n            urbanity: \"\",\n            values: \"\",\n            motivation: \"\",\n            painpoints: \"\",\n            avatar: \"👤\"\n        };\n\n        const templates = {\n            student: {\n                name: \"Marcus Master\",\n                age: \"22\",\n                civil: \"Single\",\n                occupation: \"Student / retail assistant\",\n                income: \"1,100 / mo (loan/grant)\",\n                location: \"Trondheim\",\n                urbanity: \"Student town / city\",\n                values: \"Into the latest TikTok trends, social gatherings, and cheap coffee. Shops mostly secondhand or at discount sales.\",\n                motivation: \"Looks for solutions that save time and money in a busy study schedule. Likes easy, digital communication.\",\n                painpoints: \"Tight budget, deadline stress, and a constant fear of missing out (FOMO).\"\n            },\n            parent: {\n                name: \"Eco-conscious Beth\",\n                age: \"38\",\n                civil: \"Married, 3 kids\",\n                occupation: \"Teacher\",\n                income: \"580,000 kr / yr\",\n                location: \"Lillehammer\",\n                urbanity: \"Small town / suburb\",\n                values: \"Prioritizes organic options, recycling, and reuse. Spends a lot of time on local sports and outdoor activities with the kids.\",\n                motivation: \"Wants a safe, sustainable future for the family. Looks for durable, quality products that handle rough use.\",\n                painpoints: \"The infamous 'time squeeze', high grocery prices, and the struggle to find quick, healthy dinners.\"\n            },\n            senior: {\n                name: \"Gordon Spark\",\n                age: \"72\",\n                civil: \"Widower\",\n                occupation: \"Retired engineer\",\n                income: \"Pension (comfortable)\",\n                location: \"Stavanger\",\n                urbanity: \"Center / city\",\n                values: \"Values reliability, punctuality, and local service. Reads news on a tablet but prefers the weekend paper in print.\",\n                motivation: \"Wants to stay close with the grandchildren and likes smart aids that simplify daily life without getting too complicated.\",\n                painpoints: \"Lack of in-person service, far-too-small text on screens, and a fear of scams / misclicks in new apps.\"\n            },\n            b2b: {\n                name: \"Eric Efficient\",\n                age: \"45\",\n                civil: \"Partner\",\n                occupation: \"Managing director\",\n                income: \"1.2M / yr\",\n                location: \"Bærum / Oslo\",\n                urbanity: \"Urban\",\n                values: \"Values fast, direct communication, time savings, ROI, and networking. Focused on continuous growth.\",\n                motivation: \"Looks for tools and software that automate routines, cut needless admin, and produce results.\",\n                painpoints: \"Inefficient, long meetings, a lack of skilled labor, and clunky, opaque reporting systems.\"\n            }\n        };\n\n        const randomPool = {\n            names: [\"Lisa Ledger\", \"Pete Post\", \"Sara Smart\", \"Tom Timely\", \"Emma Energy\", \"Daniel Driven\", \"Nora Curious\"],\n            occupations: [\"Freelance designer\", \"Nurse\", \"Frontend developer\", \"Carpenter\", \"Marketing consultant\", \"Plumber\"],\n            locations: [\"Bergen\", \"Tromsø\", \"Kristiansand\", \"Hamar\", \"Molde\", \"Bodø\", \"Tønsberg\"],\n            urbanities: [\"Urban / center\", \"Rural / countryside\", \"Suburb / housing estate\", \"Small town\", \"Regional hub\"],\n            values: [\n                \"Prioritizes locally sourced products and ethical production. Saving up for a home.\",\n                \"Cares about personal growth, mental health, and quality time with friends.\",\n                \"Passionate about technology, gaming, and smart-home gear. Always after the latest gadget.\",\n                \"Loves the outdoors and mountain hikes, and is trying to cut down on meat.\",\n                \"Focused on career, status, and luxury experiences. Enjoys good food and wine.\"\n            ],\n            motivations: [\n                \"Looks for inspiration and simple, seamless digital solutions in daily life.\",\n                \"Wants to minimize everyday stress and maximize free time.\",\n                \"Keen to save money and find the very best deals on the market.\",\n                \"Wants to learn new skills and strengthen their own competence.\",\n                \"Needs a product that just works right away, with no training.\"\n            ],\n            painpoints: [\n                \"Struggles with cluttered, poorly designed websites.\",\n                \"Finds it hard to compare prices and products fairly.\",\n                \"Feels the time squeeze and is overwhelmed by too many choices.\",\n                \"Feels guilty for not living healthily or sustainably enough.\",\n                \"Gets annoyed by hidden fees and long delivery times.\"\n            ]\n        };\n\n        document.addEventListener(\"DOMContentLoaded\", () => {\n            loadFromLocalStorage();\n            applyStateToUI();\n            setupInteractivity();\n        });\n\n        function switchTab(tabId) {\n            // Hide all tab panels\n            document.querySelectorAll('.tab-panel').forEach(p => p.classList.add('hidden'));\n\n            // Show the selected panel\n            document.getElementById(`panel-${tabId}`).classList.remove('hidden');\n\n            // Update the active nav buttons\n            const navButtons = document.querySelectorAll('#global-nav button');\n            navButtons.forEach(btn => {\n                btn.classList.remove('bg-white', 'text-slate-900', 'shadow-sm', 'border', 'border-slate-200/50');\n                btn.classList.add('text-slate-600', 'hover:text-slate-900');\n            });\n\n            const activeBtn = document.getElementById(`btn-${tabId}`);\n            if (activeBtn) {\n                activeBtn.classList.add('bg-white', 'text-slate-900', 'shadow-sm', 'border', 'border-slate-200/50');\n                activeBtn.classList.remove('text-slate-600', 'hover:text-slate-900');\n            }\n\n            const header = document.getElementById('global-header');\n            const nav = document.getElementById('global-nav');\n            const templatesSec = document.getElementById('template-section');\n\n            // Special handling for Presentation mode (100% clean view)\n            if (tabId === 'present') {\n                if (header) header.classList.add('hidden');\n                if (nav) nav.classList.add('hidden');\n                if (templatesSec) templatesSec.classList.add('hidden');\n                showEscToast();\n            } else {\n                if (header) header.classList.remove('hidden');\n                if (nav) nav.classList.remove('hidden');\n                if (templatesSec) templatesSec.classList.remove('hidden');\n            }\n            updatePresentationCard();\n        }\n\n        function setupInteractivity() {\n            // Listen for changes on every field with a data-bind attribute\n            document.querySelectorAll('[data-bind]').forEach(input => {\n                input.addEventListener('input', e => {\n                    const key = e.target.getAttribute('data-bind');\n                    const val = e.target.value;\n\n                    // Update the local variable\n                    personaFields[key] = val;\n\n                    // Save to localStorage\n                    localStorage.setItem(`persona_dev_${key}`, val);\n\n                    // Sync the value across modes (Learn <=> Practice)\n                    document.querySelectorAll(`[data-bind=\"${key}\"]`).forEach(el => {\n                        if (el !== e.target) {\n                            el.value = val;\n                        }\n                    });\n\n                    updatePresentationCard();\n                });\n            });\n        }\n\n        function loadTemplate(key) {\n            const data = templates[key];\n            if (!data) return;\n\n            Object.keys(data).forEach(k => {\n                personaFields[k] = data[k];\n                localStorage.setItem(`persona_dev_${k}`, data[k]);\n            });\n\n            // Set the emoji avatar based on the template\n            let avatarEmoji = \"👤\";\n            if (key === 'student') avatarEmoji = \"🧑‍🎓\";\n            if (key === 'parent') avatarEmoji = \"🌱\";\n            if (key === 'senior') avatarEmoji = \"👴\";\n            if (key === 'b2b') avatarEmoji = \"💼\";\n\n            personaFields.avatar = avatarEmoji;\n            localStorage.setItem(`persona_dev_avatar`, avatarEmoji);\n\n            applyStateToUI();\n        }\n\n        function generateRandomPersona() {\n            // Pick random values from the pool\n            const rName = randomPool.names[Math.floor(Math.random() * randomPool.names.length)];\n            const rAge = Math.floor(Math.random() * 60) + 18; // 18 - 78\n            const rOccupation = randomPool.occupations[Math.floor(Math.random() * randomPool.occupations.length)];\n            const rLocation = randomPool.locations[Math.floor(Math.random() * randomPool.locations.length)];\n            const rUrbanity = randomPool.urbanities[Math.floor(Math.random() * randomPool.urbanities.length)];\n            const rValues = randomPool.values[Math.floor(Math.random() * randomPool.values.length)];\n            const rMotivation = randomPool.motivations[Math.floor(Math.random() * randomPool.motivations.length)];\n            const rPainpoints = randomPool.painpoints[Math.floor(Math.random() * randomPool.painpoints.length)];\n\n            personaFields.name = rName;\n            personaFields.age = rAge.toString();\n            personaFields.civil = Math.random() > 0.5 ? \"Partner\" : \"Single\";\n            personaFields.occupation = rOccupation;\n            personaFields.income = (Math.floor(Math.random() * 400) + 350) + \",000 kr / yr\";\n            personaFields.location = rLocation;\n            personaFields.urbanity = rUrbanity;\n            personaFields.values = rValues;\n            personaFields.motivation = rMotivation;\n            personaFields.painpoints = rPainpoints;\n            personaFields.avatar = \"🎲\";\n\n            // Save everything to localStorage\n            Object.keys(personaFields).forEach(k => {\n                localStorage.setItem(`persona_dev_${k}`, personaFields[k]);\n            });\n\n            applyStateToUI();\n        }\n\n        function applyStateToUI() {\n            Object.keys(personaFields).forEach(key => {\n                document.querySelectorAll(`[data-bind=\"${key}\"]`).forEach(el => {\n                    el.value = personaFields[key];\n                });\n            });\n            updatePresentationCard();\n        }\n\n        function updatePresentationCard() {\n            Object.keys(personaFields).forEach(key => {\n                const el = document.getElementById(`card-${key}`);\n                if (el) {\n                    if (personaFields[key] && personaFields[key].trim() !== \"\") {\n                        el.textContent = personaFields[key];\n                        el.classList.remove('text-slate-400', 'italic');\n                    } else {\n                        // Default fallbacks when the field is empty\n                        if (key === 'name') el.textContent = \"Camilla Career\";\n                        else if (key === 'occupation') el.textContent = \"Project manager\";\n                        else if (key === 'age') el.textContent = \"34 yrs\";\n                        else if (key === 'civil') el.textContent = \"Partner\";\n                        else if (key === 'income') el.textContent = \"650,000 kr\";\n                        else if (key === 'location') el.textContent = \"Oslo\";\n                        else if (key === 'urbanity') el.textContent = \"City\";\n                        else {\n                            el.textContent = \"Not defined yet. Go to Learn or Practice mode to fill this in.\";\n                            el.classList.add('text-slate-400', 'italic');\n                        }\n                    }\n                }\n            });\n\n            // Update the avatar\n            const avatarEl = document.getElementById('card-avatar');\n            if (avatarEl) {\n                avatarEl.textContent = personaFields.avatar || \"👤\";\n            }\n        }\n\n        function loadFromLocalStorage() {\n            Object.keys(personaFields).forEach(key => {\n                const val = localStorage.getItem(`persona_dev_${key}`);\n                if (val !== null) {\n                    personaFields[key] = val;\n                }\n            });\n        }\n\n        function showEscToast() {\n            // Remove any existing toasts\n            const oldToast = document.getElementById('esc-toast');\n            if (oldToast) oldToast.remove();\n\n            const toast = document.createElement('div');\n            toast.id = 'esc-toast';\n            toast.className = 'no-print fixed bottom-6 left-1/2 -translate-x-1/2 bg-slate-900/95 text-slate-200 px-5 py-3 rounded-xl text-xs font-semibold z-50 shadow-xl border border-slate-700/50 flex items-center gap-2 transition-all duration-300';\n            toast.innerHTML = '<span>⌨️</span> Press <kbd class=\"bg-slate-800 text-white px-1.5 py-0.5 rounded border border-slate-700 font-mono text-[10px]\">ESC</kbd> on your keyboard to exit presentation';\n            document.body.appendChild(toast);\n\n            // Fade out after 3.5 seconds\n            setTimeout(() => {\n                toast.style.opacity = '0';\n                toast.style.transform = 'translate(-50%, 20px)';\n                setTimeout(() => {\n                    if (toast.parentNode) toast.remove();\n                }, 300);\n            }, 3500);\n        }\n\n        // Listen for ESC to return to Learn mode\n        document.addEventListener('keydown', e => {\n            if (e.key === 'Escape') {\n                switchTab('learn');\n                const toast = document.getElementById('esc-toast');\n                if (toast) toast.remove();\n            }\n        });\n\n        // Modal-based reset handling\n        function openResetModal() {\n            document.getElementById('reset-modal').classList.remove('hidden');\n        }\n\n        function closeResetModal() {\n            document.getElementById('reset-modal').classList.add('hidden');\n        }\n\n        function confirmReset() {\n            localStorage.clear();\n            Object.keys(personaFields).forEach(k => {\n                personaFields[k] = \"\";\n            });\n            personaFields.avatar = \"👤\";\n            applyStateToUI();\n            closeResetModal();\n        }\n    </script>\n</body>\n</html>\n",
  "packaging": {
    "appName": "Persona Developer",
    "windowTitle": "Persona Developer",
    "bundleId": "com.halisonworks.personadeveloper",
    "iconPath": null
  },
  "categoryId": null,
  "source": "import",
  "createdAt": "2026-06-02T12:00:00.000Z",
  "updatedAt": "2026-06-02T12:00:00.000Z",
  "sharedAt": "2026-06-02T12:00:00.000Z"
}
